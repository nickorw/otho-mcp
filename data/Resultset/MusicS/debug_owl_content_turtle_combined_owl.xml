@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix FestS: <http://FestS.org/ontology#> .

FestS:FestS rdf:type owl:Ontology ;
    rdfs:comment "A comprehensive OWL ontology for music, performances, people, and geographical entities, integrating various aspects of a story, with reification patterns." .

#################################################################
#    Classes
#################################################################

FestS:Cl_Entity rdf:type owl:Class .

FestS:Cl_AbstractConcept rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Entity .

FestS:Cl_ConcreteEntity rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Entity .

FestS:Cl_Thing rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_AbstractConcept .

FestS:Cl_Being rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Thing .

FestS:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Being .

FestS:Cl_Critic rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Person .

FestS:Cl_Object rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Thing .

FestS:Cl_Instrument rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Object .

FestS:Cl_Role rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_AbstractConcept .

FestS:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_ConcreteEntity .

FestS:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_CreativeWork .

FestS:Cl_SongComposition rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_MusicalWork .

FestS:Cl_Record rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_CreativeWork .

FestS:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Record .

FestS:Cl_Manifestation rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_ConcreteEntity .

FestS:Cl_AudioTrack rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Manifestation .

FestS:Cl_Band rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_ConcreteEntity .

FestS:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_ConcreteEntity .

FestS:Cl_Activity rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_PlayingActivity rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Activity .

FestS:Cl_PerformanceType rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_AbstractConcept .

FestS:Cl_PerformanceEventOccurrence rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_ReleaseEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_AlbumReleaseEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_ReleaseEvent .

FestS:Cl_CompositionEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_RecordingEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_AlbumRecordingEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_RecordingEvent .

FestS:Cl_TrackRecordingEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_RecordingEvent .

FestS:Cl_AlbumTrackMembership rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_BandMembership rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_BandRoleAssignment rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_PerformanceSongPlay rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_Review rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

FestS:Cl_SpatialEntity rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_ConcreteEntity .

FestS:Cl_Location rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_SpatialEntity .

FestS:Cl_Venue rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Location .

FestS:Cl_Building rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Venue .

FestS:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_SpatialEntity .

FestS:Cl_PoliticalDivision rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_GeographicalEntity .

FestS:Cl_Country rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_PoliticalDivision .

FestS:Cl_Region rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_PoliticalDivision .

FestS:Cl_City rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_GeographicalEntity .

FestS:Cl_RegionLocationEvent rdf:type owl:Class ;
    rdfs:subClassOf FestS:Cl_Event .

#################################################################
#    Object Properties
#################################################################

FestS:performerOf rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_PlayingActivity ;
    rdfs:range FestS:Cl_Person .

FestS:instrumentUsed rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_PlayingActivity ;
    rdfs:range FestS:Cl_Instrument .

FestS:hasPlayingActivity rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Person ;
    rdfs:range FestS:Cl_PlayingActivity ;
    owl:inverseOf FestS:performerOf .

FestS:isInstrumentInActivity rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Instrument ;
    rdfs:range FestS:Cl_PlayingActivity ;
    owl:inverseOf FestS:instrumentUsed .

FestS:hasMembershipPeriod rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Band ;
    rdfs:range FestS:Cl_BandMembership .

FestS:isMemberDuringPeriod rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Person ;
    rdfs:range FestS:Cl_BandMembership .

FestS:relatesToBand rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_BandMembership ;
    rdfs:range FestS:Cl_Band ;
    owl:inverseOf FestS:hasMembershipPeriod .

FestS:relatesToPerson rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_BandMembership ;
    rdfs:range FestS:Cl_Person ;
    owl:inverseOf FestS:isMemberDuringPeriod .

FestS:assignedPerson rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_BandRoleAssignment ;
    rdfs:range FestS:Cl_Person .

FestS:assignedToBand rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_BandRoleAssignment ;
    rdfs:range FestS:Cl_Band .

FestS:hasRole rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_BandRoleAssignment ;
    rdfs:range FestS:Cl_Role .

FestS:hasBandRoleAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Person ;
    rdfs:range FestS:Cl_BandRoleAssignment ;
    owl:inverseOf FestS:assignedPerson .

FestS:includesRoleAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Band ;
    rdfs:range FestS:Cl_BandRoleAssignment ;
    owl:inverseOf FestS:assignedToBand .

FestS:roleIsAssignedIn rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Role ;
    rdfs:range FestS:Cl_BandRoleAssignment ;
    owl:inverseOf FestS:hasRole .

FestS:hasAlbumRecordingEvent rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Album ;
    rdfs:range FestS:Cl_AlbumRecordingEvent .

FestS:isAlbumRecordingOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_AlbumRecordingEvent ;
    rdfs:range FestS:Cl_Album ;
    owl:inverseOf FestS:hasAlbumRecordingEvent .

FestS:includesTrackMembership rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Album ;
    rdfs:range FestS:Cl_AlbumTrackMembership .

FestS:isMembershipOfAlbum rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_AlbumTrackMembership ;
    rdfs:range FestS:Cl_Album ;
    owl:inverseOf FestS:includesTrackMembership .

FestS:pointsToTrack rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_AlbumTrackMembership ;
    rdfs:range FestS:Cl_AudioTrack .

FestS:hasMembershipForTrack rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_AudioTrack ;
    rdfs:range FestS:Cl_AlbumTrackMembership ;
    owl:inverseOf FestS:pointsToTrack .

FestS:occursAsEvent rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Album ;
    rdfs:range FestS:Cl_AlbumReleaseEvent .

FestS:relatesToAlbum rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_AlbumReleaseEvent ;
    rdfs:range FestS:Cl_Album ;
    owl:inverseOf FestS:occursAsEvent .

FestS:pr_realizes rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_AudioTrack ;
    rdfs:range FestS:Cl_TrackRecordingEvent ;
    owl:inverseOf FestS:pr_resultedIn .

FestS:pr_resultedIn rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_TrackRecordingEvent ;
    rdfs:range FestS:Cl_AudioTrack .

FestS:pr_recordsWork rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_TrackRecordingEvent ;
    rdfs:range FestS:Cl_SongComposition .

FestS:pr_isRecordingOf rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_AudioTrack ;
    rdfs:range FestS:Cl_SongComposition ;
    owl:propertyChainAxiom ( FestS:pr_realizes FestS:pr_recordsWork ) .

FestS:hasCompositionEvent rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_SongComposition ;
    rdfs:range FestS:Cl_CompositionEvent .

FestS:isEventForSong rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_CompositionEvent ;
    rdfs:range FestS:Cl_SongComposition ;
    owl:inverseOf FestS:hasCompositionEvent .

FestS:reviewByCritic rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_Review ;
    rdfs:range FestS:Cl_Critic ;
    owl:inverseOf FestS:hasReview .

FestS:reviewAboutRecord rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_Review ;
    rdfs:range FestS:Cl_Record ;
    owl:inverseOf FestS:isReviewedBy .

FestS:hasReview rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Critic ;
    rdfs:range FestS:Cl_Review .

FestS:isReviewedBy rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Record ;
    rdfs:range FestS:Cl_Review .

FestS:hasPerformanceType rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_PerformanceEventOccurrence ;
    rdfs:range FestS:Cl_PerformanceType .

FestS:occursAtLocation rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_PerformanceEventOccurrence ;
    rdfs:range FestS:Cl_Location .

FestS:playedInPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_PerformanceSongPlay ;
    rdfs:range FestS:Cl_PerformanceEventOccurrence .

FestS:playsSong rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_PerformanceSongPlay ;
    rdfs:range FestS:Cl_SongComposition .

FestS:locatedInCity rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Location ;
    rdfs:range FestS:Cl_City .

FestS:locatedInRegion rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_City ;
    rdfs:range FestS:Cl_Region ;
    owl:inverseOf FestS:hasCityInRegion .

FestS:hasCityInRegion rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Region ;
    rdfs:range FestS:Cl_City .

FestS:hasLocatedRegion rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_RegionLocationEvent ;
    rdfs:range FestS:Cl_Region ;
    owl:inverseOf FestS:isLocationAssertionForRegion .

FestS:isLocationAssertionForRegion rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Region ;
    rdfs:range FestS:Cl_RegionLocationEvent .

FestS:locatedInCountry rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_RegionLocationEvent ;
    rdfs:range FestS:Cl_Country ;
    owl:inverseOf FestS:hasLocationAssertionInCountry .

FestS:hasLocationAssertionInCountry rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Country ;
    rdfs:range FestS:Cl_RegionLocationEvent .

FestS:hasTrack rdf:type owl:ObjectProperty ;
    rdfs:domain FestS:Cl_Record ;
    rdfs:range FestS:Cl_AudioTrack .

#################################################################
#    Data Properties
#################################################################

FestS:hasTitle rdf:type owl:DatatypeProperty .

FestS:hasAlbumTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Album ;
    rdfs:range xsd:string .

FestS:hasAudioTrackTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_AudioTrack ;
    rdfs:range xsd:string .

FestS:hasSongCompositionTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_SongComposition ;
    rdfs:range xsd:string .

FestS:hasPerformanceTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_PerformanceType ;
    rdfs:range xsd:string .

FestS:performanceName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_PerformanceEventOccurrence ;
    rdfs:range xsd:string .

FestS:personName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Person ;
    rdfs:range xsd:string .

FestS:instrumentName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Instrument ;
    rdfs:range xsd:string .

FestS:activityId rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_PlayingActivity ;
    rdfs:range xsd:string .

FestS:hasSkillLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain FestS:Cl_PlayingActivity ;
    rdfs:range xsd:string .

FestS:hasDurationSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain FestS:Cl_AudioTrack ;
    rdfs:range xsd:integer .

FestS:hasTrackOrder rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_AlbumTrackMembership ;
    rdfs:range xsd:integer .

FestS:bandName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Band ;
    rdfs:range xsd:string .

FestS:roleTitle rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Role ;
    rdfs:range xsd:string .

FestS:criticName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:personName ;
    rdfs:domain FestS:Cl_Critic ;
    rdfs:range xsd:string .

FestS:recordTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Record ;
    rdfs:range xsd:string .

FestS:recordArtist rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_Record ;
    rdfs:range xsd:string .

FestS:reviewContent rdf:type owl:DatatypeProperty ;
    rdfs:domain FestS:Cl_Review ;
    rdfs:range xsd:string .

FestS:reviewRating rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain FestS:Cl_Review ;
    rdfs:range xsd:decimal .

FestS:hasVenueName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasTitle ;
    rdfs:domain FestS:Cl_Venue ;
    rdfs:range xsd:string .

FestS:hasDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain FestS:Cl_Event ;
    rdfs:range xsd:dateTime .

FestS:performanceDateTime rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_PerformanceEventOccurrence ;
    rdfs:range xsd:dateTime .

FestS:albumRecordingStartTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_AlbumRecordingEvent ;
    rdfs:range xsd:dateTime .

FestS:albumRecordingEndTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_AlbumRecordingEvent ;
    rdfs:range xsd:dateTime .

FestS:bandMembershipStartTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_BandMembership ;
    rdfs:range xsd:date .

FestS:bandMembershipEndTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_BandMembership ;
    rdfs:range xsd:date .

FestS:bandRoleAssignmentDateTime rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_BandRoleAssignment ;
    rdfs:range xsd:dateTime .

FestS:songCompositionDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_CompositionEvent ;
    rdfs:range xsd:date .

FestS:albumReleaseDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_AlbumReleaseEvent ;
    rdfs:range xsd:date .

FestS:regionLocationValidFromDate rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf FestS:hasDateTime ;
    rdfs:domain FestS:Cl_RegionLocationEvent ;
    rdfs:range xsd:date .

#################################################################
#    Axioms and Restrictions
#################################################################

FestS:Cl_Critic owl:disjointWith FestS:Cl_Record .
FestS:Cl_Review owl:disjointWith FestS:Cl_Critic .
FestS:Cl_Review owl:disjointWith FestS:Cl_Record .
FestS:Cl_Person owl:disjointWith FestS:Cl_CreativeWork .
FestS:Cl_Country owl:disjointWith FestS:Cl_Region .
FestS:Cl_PerformanceEventOccurrence owl:disjointWith FestS:Cl_SongComposition .
FestS:Cl_PerformanceEventOccurrence owl:disjointWith FestS:Cl_MusicalWork .
FestS:Cl_PerformanceEventOccurrence owl:disjointWith FestS:Cl_CreativeWork .
FestS:Cl_SongComposition owl:disjointWith FestS:Cl_Event .
FestS:Cl_MusicalWork owl:disjointWith FestS:Cl_Event .
FestS:Cl_CreativeWork owl:disjointWith FestS:Cl_Event .

FestS:Cl_PlayingActivity rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:performerOf ;
    owl:someValuesFrom FestS:Cl_Person
] .
FestS:Cl_PlayingActivity rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:instrumentUsed ;
    owl:someValuesFrom FestS:Cl_Instrument
] .
FestS:Cl_Person rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:personName ;
    owl:someValuesFrom xsd:string
] .
FestS:Cl_Instrument rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:instrumentName ;
    owl:someValuesFrom xsd:string
] .

FestS:Cl_BandMembership owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:relatesToBand ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:relatesToPerson ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:bandMembershipStartTime ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .

FestS:Cl_BandRoleAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:assignedPerson ;
            owl:someValuesFrom FestS:Cl_Person
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:assignedToBand ;
            owl:someValuesFrom FestS:Cl_Band
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:hasRole ;
            owl:someValuesFrom FestS:Cl_Role
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:bandRoleAssignmentDateTime ;
            owl:someValuesFrom xsd:dateTime
        ]
    )
] .

FestS:Cl_Album rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:hasAlbumRecordingEvent ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .
FestS:Cl_AlbumRecordingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:isAlbumRecordingOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
FestS:Cl_AlbumRecordingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:albumRecordingStartTime ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .
FestS:Cl_AlbumRecordingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:albumRecordingEndTime ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

FestS:Cl_AlbumTrackMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:isMembershipOfAlbum ;
    owl:someValuesFrom FestS:Cl_Album
] .
FestS:Cl_AlbumTrackMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:pointsToTrack ;
    owl:someValuesFrom FestS:Cl_AudioTrack
] .
FestS:Cl_AlbumTrackMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:hasTrackOrder ;
    owl:someValuesFrom xsd:integer
] .

FestS:Cl_AlbumReleaseEvent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:relatesToAlbum ;
            owl:someValuesFrom FestS:Cl_Album
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty FestS:albumReleaseDate ;
            owl:someValuesFrom xsd:date
        ]
    )
] .

FestS:Cl_SongComposition rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:pr_recordsWork ;
    owl:someValuesFrom FestS:Cl_TrackRecordingEvent
] .

FestS:Cl_SongComposition rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:hasCompositionEvent ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .
FestS:Cl_CompositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:isEventForSong ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass FestS:Cl_SongComposition
] .
FestS:Cl_CompositionEvent owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty FestS:songCompositionDate ;
