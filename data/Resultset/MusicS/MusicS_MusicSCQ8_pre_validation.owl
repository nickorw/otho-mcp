@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Work rdf:type owl:Class ;
    rdfs:comment "A general category for any creative or artistic endeavor." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Work ;
    rdfs:comment "A specific type of work that is a creative output, such as a book, song, or film." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "A specific type of creative work related to music." .

:Cl_Song rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:comment "A specific musical composition, typically with lyrics and/or melody, intended to be performed or recorded." .

# Reification Class for Composition Event
# This pivot class captures the 'when' aspect of a song's creation, linking the song to the specific date of composition.
:Cl_CompositionEvent rdf:type owl:Class ;
    rdfs:comment "A pivot class representing the event of a musical work or song being composed, capturing the relationship between a song and its composition date." .

# Properties

# Object Properties
:hasCompositionEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Song ;
    rdfs:range :Cl_CompositionEvent ;
    rdfs:comment "Links a song to a specific event when it was composed." .

:isEventForSong rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasCompositionEvent ;
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range :Cl_Song ;
    rdfs:comment "Links a composition event back to the song that was composed during this event." .

# Data Properties
:compositionDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range xsd:date ;
    owl:functionalProperty true ; # Each composition event has one specific date
    rdfs:comment "The specific date on which the composition event occurred." .

:songTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Song ;
    rdfs:range xsd:string ;
    rdfs:comment "The title or name of the song." .

# Restrictions and Axioms

# A Cl_Song must have at least one composition event associated with it.
:Cl_Song rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasCompositionEvent ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every song must have at least one associated composition event."
] .

# A Cl_CompositionEvent must be an event for exactly one Cl_Song.
:Cl_CompositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isEventForSong ;
    owl:onClass :Cl_Song ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every composition event must be for exactly one song."
] .

# A Cl_CompositionEvent is defined as something that has a composition date.
# This ensures that any instance of Cl_CompositionEvent always includes its crucial date information.
:Cl_CompositionEvent owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :compositionDate ;
    owl:someValuesFrom xsd:date ;
    rdfs:comment "A Composition Event is characterized by having a composition date."
] .