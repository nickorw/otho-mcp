@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/music-ontology#> .

# Ontology Declaration
:musicOntology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for representing musical performances and the songs played within them, specifically designed to answer the competency question 'What songs were played in a certain performance?' using a reification pattern." .

# Classes
# Hierarchical categorization of concepts
:Cl_Concept rdf:type owl:Class ;
    rdfs:label "Concept" ;
    rdfs:comment "A foundational superclass for all high-level abstract or concrete entities in the ontology." .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Concept ;
    rdfs:label "Event" ;
    rdfs:comment "Represents any occurring event, happening at a specific time and place." .

:Cl_Performance rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Performance" ;
    rdfs:comment "A specific instance of a live musical or artistic presentation." .

:Cl_Composition rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Concept ;
    rdfs:label "Composition" ;
    rdfs:comment "A general class for any created artistic work, especially musical or literary." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Composition ;
    rdfs:label "Musical Work" ;
    rdfs:comment "A specific type of composition, characterized by musical notation or sound." .

:Cl_Song rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:label "Song" ;
    rdfs:comment "A vocal or instrumental musical composition, typically with a lyrical component." .

# Reification Class for the relationship "Song played in Performance"
:Cl_PerformanceSongPlay rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ; # An instance of a song being played is itself an event within a performance.
    rdfs:label "Performance Song Play" ;
    rdfs:comment "A pivot class representing the explicit event or relationship of a specific song being played during a particular performance." .

# Class Axioms: Disjointness to prevent illogical classifications
:Cl_Performance owl:disjointWith :Cl_Song ;
    owl:disjointWith :Cl_MusicalWork ;
    owl:disjointWith :Cl_Composition .

:Cl_Song owl:disjointWith :Cl_Event .
:Cl_MusicalWork owl:disjointWith :Cl_Event .
:Cl_Composition owl:disjointWith :Cl_Event .


# Properties

# Data Properties
:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:string ;
    rdfs:label "has name" ;
    rdfs:comment "The designated name or title for a performance." .

:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Song ;
    rdfs:range xsd:string ;
    rdfs:label "has title" ;
    rdfs:comment "The official title of a song." .

:hasDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:date ;
    rdfs:label "has date" ;
    rdfs:comment "The calendar date on which a performance took place." .

# Object Properties
# Properties specific to the reification class: Cl_PerformanceSongPlay
:playedInPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PerformanceSongPlay ;
    rdfs:range :Cl_Performance ;
    rdfs:label "played in performance" ;
    rdfs:comment "Connects an instance of a song being played to the specific performance where it occurred." .

:playsSong rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PerformanceSongPlay ;
    rdfs:range :Cl_Song ;
    rdfs:label "plays song" ;
    rdfs:comment "Connects an instance of a song being played to the specific song that was performed." .

# Restrictions on Classes to ensure data integrity and model consistency

# Every Cl_Performance must have exactly one name.
:Cl_Performance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

# Every Cl_Song must have exactly one title.
:Cl_Song rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTitle ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

# Restrictions for Cl_PerformanceSongPlay to ensure it correctly models the relationship.
# Each instance of Cl_PerformanceSongPlay must be linked to exactly one Cl_Performance.
:Cl_PerformanceSongPlay rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :playedInPerformance ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Performance
] .

# Each instance of Cl_PerformanceSongPlay must be linked to exactly one Cl_Song.
:Cl_PerformanceSongPlay rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :playsSong ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Song
] .