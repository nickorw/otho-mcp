@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:comment "A superclass for all geographical entities like cities, regions, countries, etc." .

:Cl_City rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity ;
    rdfs:comment "Represents a city as a geographical entity." .

:Cl_Region rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity ;
    rdfs:comment "Represents a geographical region." .

:locatedInRegion rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_City ;
    rdfs:range :Cl_Region ;
    owl:inverseOf :hasCityInRegion ;
    rdf:type owl:FunctionalProperty ; # A city is typically located in one specific region for this type of query
    rdfs:comment "Connects a city to the region it is located within." .

:hasCityInRegion rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_City ;
    rdfs:comment "Connects a region to a city located within it." .

# General Class Axiom: A City must be located in some Region
:Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :locatedInRegion ;
    owl:someValuesFrom :Cl_Region
] .

# Restriction: A City can only be locatedInRegion with an instance of Cl_Region
:Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :locatedInRegion ;
    owl:allValuesFrom :Cl_Region
] .