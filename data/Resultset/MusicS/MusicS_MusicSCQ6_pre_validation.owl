@prefix : <http://example.com/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:Ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for music information, focusing on album release details." .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "A top-level class for all entities in the ontology." .

:Cl_MusicEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A class for all entities related to music." .

:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicEntity ;
    rdfs:comment "Represents a music album." .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A class for any event that occurs." .

:Cl_ReleaseEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:comment "A general class for any type of release event." .

:Cl_AlbumReleaseEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_ReleaseEvent ;
    rdfs:comment "A specific event of an album being released, serving as a reification pivot." ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :relatesToAlbum ;
        owl:someValuesFrom :Cl_Album
    ] ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasReleaseDate ;
        owl:someValuesFrom xsd:date
    ] .

#################################################################
#    Properties
#################################################################

# Object Properties

:occursAsEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_AlbumReleaseEvent ;
    rdfs:comment "Links an album to its specific release event." .

:relatesToAlbum rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain :Cl_AlbumReleaseEvent ;
    rdfs:range :Cl_Album ;
    rdf:type owl:FunctionalProperty ;
    owl:inverseOf :occursAsEvent ;
    rdfs:comment "Links an album release event to the album it refers to." .

# Data Properties

:hasDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range xsd:date ;
    rdfs:comment "A general property to specify the date of an event." .

:hasReleaseDate rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasDate ;
    rdfs:domain :Cl_AlbumReleaseEvent ;
    rdfs:range xsd:date ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "Specifies the release date of a specific album release event." .

#################################################################
#    General Class Axioms / Restrictions (Example)
#################################################################

[ rdf:type owl:Restriction ;
    owl:onProperty :relatesToAlbum ;
    owl:allValuesFrom :Cl_Album ;
    rdfs:subClassOf :Cl_AlbumReleaseEvent
] .

[ rdf:type owl:Restriction ;
    owl:onProperty :hasReleaseDate ;
    owl:allValuesFrom xsd:date ;
    rdfs:subClassOf :Cl_AlbumReleaseEvent
] .