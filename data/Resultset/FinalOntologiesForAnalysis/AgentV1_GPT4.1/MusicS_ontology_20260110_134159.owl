@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production> a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "Ontology representing bands, musicians, albums, performances, and related entities for music production." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human being involved in music production, such as a musician or critic." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical group or band." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A musical or organizational role in a band (e.g., vocals, guitarist, drummer)." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of tracks released together." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A single track or recording on an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who critiques music albums." ;
    rdfs:subClassOf :Person .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live performance event." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances may occur." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

### Pivot Classes for Reification
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "Reifies a person's membership in a band with time interval." .

:BandRoleAssignment a owl:Class ;
    rdfs:label "Band Role Assignment" ;
    rdfs:comment "Reifies a person's role in a band at a given time." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "Reifies the recording of an album with time interval." .

:TrackSongRelation a owl:Class ;
    rdfs:label "Track-Song Relation" ;
    rdfs:comment "Reifies the relationship between a track and the song it records." .

:SongComposition a owl:Class ;
    rdfs:label "Song Composition" ;
    rdfs:comment "Reifies the composition of a song with composition date." .

:AlbumCritique a owl:Class ;
    rdfs:label "Album Critique" ;
    rdfs:comment "Reifies a critic's statement about an album." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "Reifies the performance of a song at an event." .

:PerformanceLocation a owl:Class ;
    rdfs:label "Performance Location" ;
    rdfs:comment "Reifies the location of a performance." .

### Object Properties with Inverses
:playsInstrument a owl:ObjectProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :playedBy .
:playedBy a owl:ObjectProperty ;
    rdfs:label "played by" ;
    rdfs:comment "Relates an instrument to a person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasBandMembership a owl:ObjectProperty ;
    rdfs:label "has band membership" ;
    rdfs:comment "Relates a person to a band membership instance." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :bandMembershipOf .
:bandMembershipOf a owl:ObjectProperty ;
    rdfs:label "band membership of" ;
    rdfs:comment "Relates a band membership to the person." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasBandMembership .

:memberOfBand a owl:ObjectProperty ;
    rdfs:label "member of band" ;
    rdfs:comment "Relates a band membership to the band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasBandMember .
:hasBandMember a owl:ObjectProperty ;
    rdfs:label "has band member" ;
    rdfs:comment "Relates a band to a band membership instance." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberOfBand .

:hasBandRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has band role assignment" ;
    rdfs:comment "Relates a person to a band role assignment instance." ;
    rdfs:domain :Person ;
    rdfs:range :BandRoleAssignment ;
    owl:inverseOf :bandRoleAssignmentOf .
:bandRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:label "band role assignment of" ;
    rdfs:comment "Relates a band role assignment to the person." ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range :Person ;
    owl:inverseOf :hasBandRoleAssignment .

:roleInBand a owl:ObjectProperty ;
    rdfs:label "role in band" ;
    rdfs:comment "Relates a band role assignment to a role." ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range :Role ;
    owl:inverseOf :bandRoleOf .
:bandRoleOf a owl:ObjectProperty ;
    rdfs:label "band role of" ;
    rdfs:comment "Relates a role to band role assignments." ;
    rdfs:domain :Role ;
    rdfs:range :BandRoleAssignment ;
    owl:inverseOf :roleInBand .

:roleBand a owl:ObjectProperty ;
    rdfs:label "role band" ;
    rdfs:comment "Relates a band role assignment to a band." ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range :Band ;
    owl:inverseOf :hasRoleAssignment .
:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Relates a band to band role assignments." ;
    rdfs:domain :Band ;
    rdfs:range :BandRoleAssignment ;
    owl:inverseOf :roleBand .

:recordedAlbum a owl:ObjectProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates a band to an album recording instance." ;
    rdfs:domain :Band ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :albumRecordedBy .
:albumRecordedBy a owl:ObjectProperty ;
    rdfs:label "album recorded by" ;
    rdfs:comment "Relates an album recording to the band." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Band ;
    owl:inverseOf :recordedAlbum .

:albumRecorded a owl:ObjectProperty ;
    rdfs:label "album recorded" ;
    rdfs:comment "Relates an album recording instance to an album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :hasAlbumRecording .
:hasAlbumRecording a owl:ObjectProperty ;
    rdfs:label "has album recording" ;
    rdfs:comment "Relates an album to album recording instances." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :albumRecorded .

:hasTrack a owl:ObjectProperty ;
    rdfs:label "has track" ;
    rdfs:comment "Relates an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfAlbum .
:trackOfAlbum a owl:ObjectProperty ;
    rdfs:label "track of album" ;
    rdfs:comment "Relates a track to the album it belongs to." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :hasTrack .

:trackSong a owl:ObjectProperty ;
    rdfs:label "track song" ;
    rdfs:comment "Relates a track-song relation to a track." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Track ;
    owl:inverseOf :trackSongRelationOf .
:trackSongRelationOf a owl:ObjectProperty ;
    rdfs:label "track song relation of" ;
    rdfs:comment "Relates a track to track-song relation." ;
    rdfs:domain :Track ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :trackSong .

:isRecordingOf a owl:ObjectProperty ;
    rdfs:label "is recording of" ;
    rdfs:comment "Relates a track-song relation to a song." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Song ;
    owl:inverseOf :recordedInTrack .
:recordedInTrack a owl:ObjectProperty ;
    rdfs:label "recorded in track" ;
    rdfs:comment "Relates a song to a track-song relation." ;
    rdfs:domain :Song ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :isRecordingOf .

:composedSong a owl:ObjectProperty ;
    rdfs:label "composed song" ;
    rdfs:comment "Relates a song composition to a song." ;
    rdfs:domain :SongComposition ;
    rdfs:range :Song ;
    owl:inverseOf :songCompositionOf .
:songCompositionOf a owl:ObjectProperty ;
    rdfs:label "song composition of" ;
    rdfs:comment "Relates a song to song composition." ;
    rdfs:domain :Song ;
    rdfs:range :SongComposition ;
    owl:inverseOf :composedSong .

:hasCritique a owl:ObjectProperty ;
    rdfs:label "has critique" ;
    rdfs:comment "Relates an album to a critique instance." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumCritique ;
    owl:inverseOf :critiqueOf .
:critiqueOf a owl:ObjectProperty ;
    rdfs:label "critique of" ;
    rdfs:comment "Relates a critique to the album." ;
    rdfs:domain :AlbumCritique ;
    rdfs:range :Album ;
    owl:inverseOf :hasCritique .

:critiqueBy a owl:ObjectProperty ;
    rdfs:label "critique by" ;
    rdfs:comment "Relates a critique to a critic." ;
    rdfs:domain :AlbumCritique ;
    rdfs:range :Critic ;
    owl:inverseOf :hasCritiqueBy .
:hasCritiqueBy a owl:ObjectProperty ;
    rdfs:label "has critique by" ;
    rdfs:comment "Relates a critic to a critique." ;
    rdfs:domain :Critic ;
    rdfs:range :AlbumCritique ;
    owl:inverseOf :critiqueBy .

:performanceSong a owl:ObjectProperty ;
    rdfs:label "performance song" ;
    rdfs:comment "Relates a performance song instance to a performance." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceSongOf .
:performanceSongOf a owl:ObjectProperty ;
    rdfs:label "performance song of" ;
    rdfs:comment "Relates a performance to performance song instance." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceSong .

:performanceOf a owl:ObjectProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Relates a performance song instance to a song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :performedAt .
:performedAt a owl:ObjectProperty ;
    rdfs:label "performed at" ;
    rdfs:comment "Relates a song to a performance song instance." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceOf .

:performanceLocation a owl:ObjectProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "Relates a performance location instance to a city." ;
    rdfs:domain :PerformanceLocation ;
    rdfs:range :City ;
    owl:inverseOf :cityPerformanceLocation .
:cityPerformanceLocation a owl:ObjectProperty ;
    rdfs:label "city performance location" ;
    rdfs:comment "Relates a city to a performance location." ;
    rdfs:domain :City ;
    rdfs:range :PerformanceLocation ;
    owl:inverseOf :performanceLocation .

:locationPerformance a owl:ObjectProperty ;
    rdfs:label "location performance" ;
    rdfs:comment "Relates a performance location instance to a performance." ;
    rdfs:domain :PerformanceLocation ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocationOf .
:performanceLocationOf a owl:ObjectProperty ;
    rdfs:label "performance location of" ;
    rdfs:comment "Relates a performance to a performance location." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceLocation ;
    owl:inverseOf :locationPerformance .

:inRegion a owl:ObjectProperty ;
    rdfs:label "in region" ;
    rdfs:comment "Relates a city to a region." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionOf .
:regionOf a owl:ObjectProperty ;
    rdfs:label "region of" ;
    rdfs:comment "Relates a region to a city." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :inRegion .

:inCountry a owl:ObjectProperty ;
    rdfs:label "in country" ;
    rdfs:comment "Relates a region to a country." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryOf .
:countryOf a owl:ObjectProperty ;
    rdfs:label "country of" ;
    rdfs:comment "Relates a country to a region." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :inCountry .

### Data Properties
:membershipStart a owl:DatatypeProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "Start date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:date .

:membershipEnd a owl:DatatypeProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "End date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:date .

:roleStart a owl:DatatypeProperty ;
    rdfs:label "role start" ;
    rdfs:comment "Start date of a band role assignment." ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range xsd:date .

:roleEnd a owl:DatatypeProperty ;
    rdfs:label "role end" ;
    rdfs:comment "End date of a band role assignment." ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range xsd:date .

:recordingStart a owl:DatatypeProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:date .

:recordingEnd a owl:DatatypeProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "End date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:date .

:trackNumber a owl:DatatypeProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track on an album." ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer .
:trackNumber a owl:FunctionalProperty .

:compositionDate a owl:DatatypeProperty ;
    rdfs:label "composition date" ;
    rdfs:comment "Date a song was composed." ;
    rdfs:domain :SongComposition ;
    rdfs:range xsd:date .

:critiqueText a owl:DatatypeProperty ;
    rdfs:label "critique text" ;
    rdfs:comment "The text of a critique." ;
    rdfs:domain :AlbumCritique ;
    rdfs:range xsd:string .

:performanceDate a owl:DatatypeProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "The date of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:date .

:releaseDate a owl:DatatypeProperty ;
    rdfs:label "release date" ;
    rdfs:comment "The release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:date .

### Disjointness
:Person owl:disjointWith :Band, :Instrument, :Role, :Track, :Album, :Performance, :City, :Region, :Country .
:Band owl:disjointWith :Instrument, :Role, :Track, :Song, :Album, :Performance, :City, :Region, :Country .
:Instrument owl:disjointWith :Role, :Track, :Song, :Album, :Performance, :City, :Region, :Country .
:Track owl:disjointWith :Song, :Album, :Performance, :City, :Region, :Country .
:Album owl:disjointWith :Song, :Performance, :City, :Region, :Country .
:Performance owl:disjointWith :City, :Region, :Country .
:City owl:disjointWith :Region, :Country .
:Region owl:disjointWith :Country .

### Restrictions and GCAs
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .

### End of Ontology