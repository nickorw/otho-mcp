@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#theatre-productions-ontology>
    a owl:Ontology ;
    rdfs:label "Theatre Productions Ontology" ;
    rdfs:comment "Ontology for representing theatre festivals, productions, plays, actors, and related events in Italy, based on the provided story and competency questions." .

### Classes

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general event, such as a festival or a production." ;
    rdfs:subClassOf owl:Thing .

:TheatreFestival a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Theatre Festival" ;
    rdfs:comment "A festival in which theatre productions are performed." .

:Production a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Production" ;
    rdfs:comment "A specific instance of a play being performed." .

:Theatre a owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:comment "A venue where productions are staged." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city in which theatres and festivals are located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing cities." .

:Play a owl:Class ;
    rdfs:label "Play" ;
    rdfs:comment "A written theatrical work." .

:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:comment "A person who writes plays." .

:Ensemble a owl:Class ;
    rdfs:label "Ensemble" ;
    rdfs:comment "A group of people performing together in a production." .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual." .

:Actor a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Actor" ;
    rdfs:comment "A person who acts in a play or production." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A character or function performed by a person in a production." .

:Newspaper a owl:Class ;
    rdfs:label "Newspaper" ;
    rdfs:comment "A publication that reviews productions." .

:Review a owl:Class ;
    rdfs:label "Review" ;
    rdfs:comment "A review of a production by a newspaper." .

:Act a owl:Class ;
    rdfs:label "Act" ;
    rdfs:comment "A major division of a play." ;
    rdfs:subClassOf :Event .

# StarRating as value range

# Pivot Classes for Reification

:ProductionPremiere a owl:Class ;
    rdfs:label "Production Premiere" ;
    rdfs:comment "A reified event representing the premiere of a production." ;
    rdfs:subClassOf :Event .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A reified relationship representing employment of a person at a theatre." ;
    rdfs:subClassOf :Event .

:Participation a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Participation" ;
    rdfs:comment "A reified event representing a person's participation in a production or ensemble." .

:RoleAssignment a owl:Class ;
    rdfs:subClassOf :Participation ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "A reified relation for assigning a role to a person within a production for a time span." .

### Properties

:hasFestivalLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :City ;
    rdfs:label "has festival location" ;
    rdfs:comment "The city where a festival is held." .

:festivalLocationOf a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :TheatreFestival ;
    rdfs:label "festival location of" ;
    rdfs:comment "Theatre festival that takes place in this city." ;
    owl:inverseOf :hasFestivalLocation .

:takesPlaceDuring a owl:DatatypeProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range xsd:gYearMonth ;
    rdfs:label "takes place during" ;
    rdfs:comment "The time period during which a festival takes place." .

:featuresPlay a owl:ObjectProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :Play ;
    rdfs:label "features play" ;
    rdfs:comment "A play featured in a festival." .

:featuredInFestival a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :TheatreFestival ;
    rdfs:label "featured in festival" ;
    rdfs:comment "The festival in which this play is featured." ;
    owl:inverseOf :featuresPlay .

:locatedInCity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Theatre ;
    rdfs:range :City ;
    rdfs:label "located in city" ;
    rdfs:comment "The city where a theatre is located." .

:cityHasTheatre a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :Theatre ;
    rdfs:label "city has theatre" ;
    rdfs:comment "Theatre located in this city." ;
    owl:inverseOf :locatedInCity .

:locatedInCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    rdfs:label "located in country" ;
    rdfs:comment "The country in which a city is located." .

:countryHasCity a owl:ObjectProperty ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    rdfs:label "country has city" ;
    rdfs:comment "City located in this country." ;
    owl:inverseOf :locatedInCountry .

:hasBasisPlay a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Production ;
    rdfs:range :Play ;
    rdfs:label "has basis play" ;
    rdfs:comment "The play on which a production is based." .

:isBasisOfProduction a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :Production ;
    rdfs:label "is basis of production" ;
    rdfs:comment "Production based on this play." ;
    owl:inverseOf :hasBasisPlay .

:hasEnsemble a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Production ;
    rdfs:range :Ensemble ;
    rdfs:label "has ensemble" ;
    rdfs:comment "The ensemble performing a production." .

:ensembleOfProduction a owl:ObjectProperty ;
    rdfs:domain :Ensemble ;
    rdfs:range :Production ;
    rdfs:label "ensemble of production" ;
    rdfs:comment "Production for which this is the ensemble." ;
    owl:inverseOf :hasEnsemble .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :Ensemble ;
    rdfs:range :Person ;
    rdfs:label "has member" ;
    rdfs:comment "A person who is a member of an ensemble." .

:isMemberOfEnsemble a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Ensemble ;
    rdfs:label "is member of ensemble" ;
    rdfs:comment "Ensemble to which this person belongs." ;
    owl:inverseOf :hasMember .

:writtenBy a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :Author ;
    rdfs:label "written by" ;
    rdfs:comment "The author of a play." .

:authorOfPlay a owl:ObjectProperty ;
    rdfs:domain :Author ;
    rdfs:range :Play ;
    rdfs:label "author of play" ;
    rdfs:comment "Play written by this author." ;
    owl:inverseOf :writtenBy .

:writtenDuring a owl:DatatypeProperty ;
    rdfs:domain :Play ;
    rdfs:range xsd:string ;
    rdfs:label "written during" ;
    rdfs:comment "The period in which a play was written." .

:hasNumberOfActs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Play ;
    rdfs:range xsd:integer ;
    rdfs:label "has number of acts" ;
    rdfs:comment "The number of acts in a play." .

:hasAct a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :Act ;
    rdfs:label "has act" ;
    rdfs:comment "Associates a play with its acts." .

:isActOfPlay a owl:ObjectProperty ;
    rdfs:domain :Act ;
    rdfs:range :Play ;
    rdfs:label "is act of play" ;
    rdfs:comment "Play to which this act belongs." ;
    owl:inverseOf :hasAct .

:hasPremiere a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Production ;
    rdfs:range :ProductionPremiere ;
    rdfs:label "has premiere" ;
    rdfs:comment "The premiere event of a production." .

:premiereOfProduction a owl:ObjectProperty ;
    rdfs:domain :ProductionPremiere ;
    rdfs:range :Production ;
    rdfs:label "premiere of production" ;
    rdfs:comment "Production for which this is the premiere." ;
    owl:inverseOf :hasPremiere .

:premiereDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :ProductionPremiere ;
    rdfs:range xsd:date ;
    rdfs:label "premiere date" ;
    rdfs:comment "The date of a production's premiere." .

:reviewedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Review ;
    rdfs:range :Newspaper ;
    rdfs:label "reviewed by" ;
    rdfs:comment "The newspaper that published a review." .

:reviews a owl:ObjectProperty ;
    rdfs:domain :Newspaper ;
    rdfs:range :Review ;
    rdfs:label "reviews" ;
    rdfs:comment "Review published by this newspaper." ;
    owl:inverseOf :reviewedBy .

:reviewOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Review ;
    rdfs:range :Production ;
    rdfs:label "review of" ;
    rdfs:comment "The production being reviewed." .

:hasReview a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :Review ;
    rdfs:label "has review" ;
    rdfs:comment "Review of this production." ;
    owl:inverseOf :reviewOf .

:hasStarRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Review ;
    rdfs:range xsd:integer ;
    rdfs:label "has star rating" ;
    rdfs:comment "The star rating given by a review (1-5)." .

:employs a owl:ObjectProperty ;
    rdfs:domain :Theatre ;
    rdfs:range :Employment ;
    rdfs:label "employs" ;
    rdfs:comment "Employment relationships at a theatre." .

:employedAt a owl:ObjectProperty ;
    rdfs:domain :Employment ;
    rdfs:range :Theatre ;
    rdfs:label "employed at" ;
    rdfs:comment "Theatre where this employment occurs." ;
    owl:inverseOf :employs .

:employmentPerson a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Employment ;
    rdfs:range :Person ;
    rdfs:label "employment person" ;
    rdfs:comment "The person employed in an employment relationship." .

:personEmployment a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Employment ;
    rdfs:label "person employment" ;
    rdfs:comment "Employment of this person." ;
    owl:inverseOf :employmentPerson .

:employmentStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Employment ;
    rdfs:range xsd:date ;
    rdfs:label "employment start date" ;
    rdfs:comment "The start date of an employment relationship." .

:participationIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Participation ;
    rdfs:range :Production ;
    rdfs:label "participation in" ;
    rdfs:comment "The production in which a participation event occurs." .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :Participation ;
    rdfs:label "has participant" ;
    rdfs:comment "Participation event of this production." ;
    owl:inverseOf :participationIn .

:participant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Participation ;
    rdfs:range :Person ;
    rdfs:label "participant" ;
    rdfs:comment "The person participating in a participation event." .

:participatesIn a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Participation ;
    rdfs:label "participates in" ;
    rdfs:comment "Participation event for this person." ;
    owl:inverseOf :participant .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Participation ;
    rdfs:range :RoleAssignment ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Role assignments within a participation event." .

:roleAssignmentOf a owl:ObjectProperty ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Participation ;
    rdfs:label "role assignment of" ;
    rdfs:comment "Participation event for this role assignment." ;
    owl:inverseOf :hasRoleAssignment .

:role a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Role ;
    rdfs:label "role" ;
    rdfs:comment "The role assigned in a role assignment." .

:roleOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Role ;
    rdfs:range :RoleAssignment ;
    rdfs:label "role of assignment" ;
    rdfs:comment "Role assignment associated with this role." ;
    owl:inverseOf :role .

:roleTimeSpan a owl:DatatypeProperty ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:gYearMonth ;
    rdfs:label "role time span" ;
    rdfs:comment "The time span for which a role is assigned." .

### Disjointness and Equivalence

:Actor owl:disjointWith :Theatre, :Play .
:TheatreFestival owl:disjointWith :Theatre .

:Person owl:disjointWith :Theatre, :Play .

# General Class Axiom: Person is the union of Actor (example, could be expanded)
:Person owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf ( :Actor )
] .

### Restrictions & GCAs
# A Production has exactly one premiere
:Production rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasPremiere ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .
