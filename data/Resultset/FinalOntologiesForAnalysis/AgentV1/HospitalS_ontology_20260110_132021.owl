@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/hospital-story-1> a owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "An ontology modeling hospital staff, unions, evaluations, academic activities, and events based on a narrative scenario." .

#################################################################
# Classes
#################################################################

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, such as staff or authors." .

:Nurse a owl:Class ;
    rdfs:label "Nurse" ;
    rdfs:comment "A person who is a nurse." ;
    rdfs:subClassOf :Person .

:Doctor a owl:Class ;
    rdfs:label "Doctor" ;
    rdfs:comment "A person who is a medical doctor." ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Nurse .

:NursingAssistant a owl:Class ;
    rdfs:label "Nursing Assistant" ;
    rdfs:comment "A nurse who is a nursing assistant." ;
    rdfs:subClassOf :Nurse .

:CertifiedNurse a owl:Class ;
    rdfs:label "Certified Nurse" ;
    rdfs:comment "A nurse who is certified." ;
    rdfs:subClassOf :Nurse .

:Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "A person who is employed at a hospital." ;
    rdfs:subClassOf :Person .

:Degree a owl:Class ;
    rdfs:label "Degree" ;
    rdfs:comment "A formal qualification awarded to a person." .

:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:comment "A medical institution." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where a hospital may be located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country in which a city is located." .

:Union a owl:Class ;
    rdfs:label "Union" ;
    rdfs:comment "A union organizing hospital staff." .

:UnionMembership a owl:Class ;
    rdfs:label "Union Membership" ;
    rdfs:comment "A reified membership of a person in a union, possibly with a role and time period." .

:UnionRole a owl:Class ;
    rdfs:label "Union Role" ;
    rdfs:comment "A role a person can have within a union (e.g., representative)." .

:StudyPeriod a owl:Class ;
    rdfs:label "Study Period" ;
    rdfs:comment "A period during which a person studies for a degree." .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A reified employment relation between a person and a hospital, with start date." .

:Evaluation a owl:Class ;
    rdfs:label "Evaluation" ;
    rdfs:comment "A written evaluation statement provided by a doctor for an employee." .

:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A research article." .

:ArticleCollection a owl:Class ;
    rdfs:label "Article Collection" ;
    rdfs:comment "A collection of research articles, as a book or CD." .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A book version of an article collection." ;
    rdfs:subClassOf :ArticleCollection ;
    owl:disjointWith :CD .

:CD a owl:Class ;
    rdfs:label "CD" ;
    rdfs:comment "A CD version of an article collection." ;
    rdfs:subClassOf :ArticleCollection ;
    owl:disjointWith :Book .

:Seminar a owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A seminar event held at a hospital to present articles." .

:SeminarPresentation a owl:Class ;
    rdfs:label "Seminar Presentation" ;
    rdfs:comment "A reified presentation of an article at a seminar." .

#################################################################
# Object Properties (with inverses)
#################################################################

:hasDegree a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range :Degree ;
    rdfs:label "has degree" ;
    rdfs:comment "Links a person to a medical degree they hold." ;
    owl:inverseOf :degreeOf .
:degreeOf a owl:ObjectProperty ;
    rdfs:domain :Degree ;
    rdfs:range :Person ;
    rdfs:label "degree of" ;
    rdfs:comment "Links a degree to the person who holds it." ;
    owl:inverseOf :hasDegree .

:studiedFor a owl:ObjectProperty ;
    rdfs:domain :StudyPeriod ;
    rdfs:range :Degree ;
    rdfs:label "studied for" ;
    rdfs:comment "Links a study period to the degree being studied." ;
    owl:inverseOf :studiedDuring .
:studiedDuring a owl:ObjectProperty ;
    rdfs:domain :Degree ;
    rdfs:range :StudyPeriod ;
    rdfs:label "studied during" ;
    rdfs:comment "Links a degree to the study period." ;
    owl:inverseOf :studiedFor .

:hasStudyPeriod a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :StudyPeriod ;
    rdfs:label "has study period" ;
    rdfs:comment "Links a person to their study periods." ;
    owl:inverseOf :studyPeriodOf .
:studyPeriodOf a owl:ObjectProperty ;
    rdfs:domain :StudyPeriod ;
    rdfs:range :Person ;
    rdfs:label "study period of" ;
    rdfs:comment "Links a study period to the person." ;
    owl:inverseOf :hasStudyPeriod .

:employedAt a owl:ObjectProperty ;
    rdfs:domain :Employment ;
    rdfs:range :Hospital ;
    rdfs:label "employed at" ;
    rdfs:comment "Links an employment record to a hospital." ;
    owl:inverseOf :employmentOf .
:employmentOf a owl:ObjectProperty ;
    rdfs:domain :Hospital ;
    rdfs:range :Employment ;
    rdfs:label "employment of" ;
    rdfs:comment "Links a hospital to an employment record." ;
    owl:inverseOf :employedAt .

:hasEmployment a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Employment ;
    rdfs:label "has employment" ;
    rdfs:comment "Links a person to their employment records." ;
    owl:inverseOf :employmentOfPerson .
:employmentOfPerson a owl:ObjectProperty ;
    rdfs:domain :Employment ;
    rdfs:range :Person ;
    rdfs:label "employment of person" ;
    rdfs:comment "Links an employment record to the person." ;
    owl:inverseOf :hasEmployment .

:locatedIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Hospital ;
    rdfs:range :City ;
    rdfs:label "located in" ;
    rdfs:comment "Links a hospital to the city where it is located." ;
    owl:inverseOf :hasHospital .
:hasHospital a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :Hospital ;
    rdfs:label "has hospital" ;
    rdfs:comment "Links a city to a hospital located within it." ;
    owl:inverseOf :locatedIn .

:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    rdfs:label "in country" ;
    rdfs:comment "Links a city to the country where it is located." ;
    owl:inverseOf :hasCity .
:hasCity a owl:ObjectProperty ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    rdfs:label "has city" ;
    rdfs:comment "Links a country to its cities." ;
    owl:inverseOf :inCountry .

:memberOf a owl:ObjectProperty ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Union ;
    rdfs:label "member of" ;
    rdfs:comment "Links a union membership to a union." ;
    owl:inverseOf :hasMember .
:hasMember a owl:ObjectProperty ;
    rdfs:domain :Union ;
    rdfs:range :UnionMembership ;
    rdfs:label "has member" ;
    rdfs:comment "Links a union to a union membership." ;
    owl:inverseOf :memberOf .

:hasUnionMembership a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :UnionMembership ;
    rdfs:label "has union membership" ;
    rdfs:comment "Links a person to their union memberships." ;
    owl:inverseOf :unionMembershipOf .
:unionMembershipOf a owl:ObjectProperty ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Person ;
    rdfs:label "union membership of" ;
    rdfs:comment "Links a union membership to the person." ;
    owl:inverseOf :hasUnionMembership .

:hasUnionRole a owl:ObjectProperty ;
    rdfs:domain :UnionMembership ;
    rdfs:range :UnionRole ;
    rdfs:label "has union role" ;
    rdfs:comment "Links a union membership to a role." ;
    owl:inverseOf :unionRoleOf .
:unionRoleOf a owl:ObjectProperty ;
    rdfs:domain :UnionRole ;
    rdfs:range :UnionMembership ;
    rdfs:label "union role of" ;
    rdfs:comment "Links a union role to the union membership." ;
    owl:inverseOf :hasUnionRole .

:evaluatedBy a owl:ObjectProperty ;
    rdfs:domain :Evaluation ;
    rdfs:range :Doctor ;
    rdfs:label "evaluated by" ;
    rdfs:comment "Links an evaluation to the doctor who performed it." ;
    owl:inverseOf :evaluates .
:evaluates a owl:ObjectProperty ;
    rdfs:domain :Doctor ;
    rdfs:range :Evaluation ;
    rdfs:label "evaluates" ;
    rdfs:comment "Links a doctor to the evaluations they have performed." ;
    owl:inverseOf :evaluatedBy .

:evaluatedEmployee a owl:ObjectProperty ;
    rdfs:domain :Evaluation ;
    rdfs:range :Employee ;
    rdfs:label "evaluated employee" ;
    rdfs:comment "Links an evaluation to the employee being evaluated." ;
    owl:inverseOf :evaluationOf .
:evaluationOf a owl:ObjectProperty ;
    rdfs:domain :Employee ;
    rdfs:range :Evaluation ;
    rdfs:label "evaluation of" ;
    rdfs:comment "Links an employee to their evaluation." ;
    owl:inverseOf :evaluatedEmployee .

:hasEvaluation a owl:ObjectProperty ;
    rdfs:domain :Employee ;
    rdfs:range :Evaluation ;
    rdfs:label "has evaluation" ;
    rdfs:comment "Links an employee to their evaluations." ;
    owl:inverseOf :evaluationOfEmployee .
:evaluationOfEmployee a owl:ObjectProperty ;
    rdfs:domain :Evaluation ;
    rdfs:range :Employee ;
    rdfs:label "evaluation of employee" ;
    rdfs:comment "Links an evaluation to the employee." ;
    owl:inverseOf :hasEvaluation .

:composedOf a owl:ObjectProperty ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Article ;
    rdfs:label "composed of" ;
    rdfs:comment "Links an article collection to the articles it contains." ;
    owl:inverseOf :partOfCollection .
:partOfCollection a owl:ObjectProperty ;
    rdfs:domain :Article ;
    rdfs:range :ArticleCollection ;
    rdfs:label "part of collection" ;
    rdfs:comment "Links an article to the collection it is in." ;
    owl:inverseOf :composedOf .

:presentedIn a owl:ObjectProperty ;
    rdfs:domain :SeminarPresentation ;
    rdfs:range :Seminar ;
    rdfs:label "presented in" ;
    rdfs:comment "Links a seminar presentation to the seminar where it occurred." ;
    owl:inverseOf :hasPresentation .
:hasPresentation a owl:ObjectProperty ;
    rdfs:domain :Seminar ;
    rdfs:range :SeminarPresentation ;
    rdfs:label "has presentation" ;
    rdfs:comment "Links a seminar to its presentations." ;
    owl:inverseOf :presentedIn .

:presentsArticle a owl:ObjectProperty ;
    rdfs:domain :SeminarPresentation ;
    rdfs:range :Article ;
    rdfs:label "presents article" ;
    rdfs:comment "Links a seminar presentation to the article presented." ;
    owl:inverseOf :presentedAt .
:presentedAt a owl:ObjectProperty ;
    rdfs:domain :Article ;
    rdfs:range :SeminarPresentation ;
    rdfs:label "presented at" ;
    rdfs:comment "Links an article to a seminar presentation." ;
    owl:inverseOf :presentsArticle .

:heldAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Seminar ;
    rdfs:range :Hospital ;
    rdfs:label "held at" ;
    rdfs:comment "Links a seminar to the hospital where it is held." ;
    owl:inverseOf :hasSeminar .
:hasSeminar a owl:ObjectProperty ;
    rdfs:domain :Hospital ;
    rdfs:range :Seminar ;
    rdfs:label "has seminar" ;
    rdfs:comment "Links a hospital to the seminars held there." ;
    owl:inverseOf :heldAt .

#################################################################
# Data Properties
#################################################################

:startDate a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :StudyPeriod :Employment :UnionMembership :Seminar ) ] ;
    rdfs:range xsd:date ;
    rdfs:label "start date" ;
    rdfs:comment "The start date of a period or event." .

:endDate a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :StudyPeriod :Employment :UnionMembership ) ] ;
    rdfs:range xsd:date ;
    rdfs:label "end date" ;
    rdfs:comment "The end date of a period or event." .

:evaluationStatement a owl:DatatypeProperty ;
    rdfs:domain :Evaluation ;
    rdfs:range xsd:string ;
    rdfs:label "evaluation statement" ;
    rdfs:comment "The content of an evaluation statement." .

:pageCount a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer ;
    rdfs:label "page count" ;
    rdfs:comment "The number of pages in a book." .

:publicationDate a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :Book :CD ) ] ;
    rdfs:range xsd:date ;
    rdfs:label "publication date" ;
    rdfs:comment "The publication date of a book or CD." .

:title a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :Article :ArticleCollection :Book :CD :Seminar ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "title" ;
    rdfs:comment "The title of an article, article collection, book, CD, or seminar." .

#################################################################
# General Class Axioms and Restrictions
#################################################################

# At least one article must be presented at each seminar (CQ15)
:Seminar rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty :hasPresentation ;
    owl:someValuesFrom [ a owl:Restriction ; owl:onProperty :presentsArticle ; owl:someValuesFrom :Article ] ] .
