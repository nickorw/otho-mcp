@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://www.example.org/ontology#>.

# Ontology Metadata (Optional, but good practice)
:universityStudyOntology rdf:type owl:Ontology ;
    rdfs:comment "An ontology for representing study periods of individuals pursuing degrees, addressing the competency question: 'During what time period did a certain person study for a specific degree?'" ;
    owl:versionIRI <http://www.example.org/ontology/1.0> .

# Classes
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "A top-level class for all entities in the ontology, providing a common superclass." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a person, typically a student who undertakes study." .

:Cl_Degree rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents an academic qualification or degree." .

:Cl_BachelorDegree rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Degree ;
    rdfs:comment "A specific type of academic degree, typically an undergraduate degree." .

:Cl_MasterDegree rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Degree ;
    rdfs:comment "A specific type of academic degree, typically a postgraduate master's degree." .

:Cl_DoctoralDegree rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Degree ;
    rdfs:comment "A specific type of academic degree, typically a postgraduate doctoral degree (e.g., PhD)." .

:Cl_TimePeriod rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a defined duration of time with a distinct start and end." .

# Reification Class: Cl_StudyEnrollment
# This pivot class captures the complex relationship between a person, a degree, and the time period of study.
:Cl_StudyEnrollment rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a specific instance of a person's enrollment and study for a degree during a particular time period. This class is crucial for answering the competency question by linking the person, degree, and time." .

# Properties

# Object Properties (connecting classes)

# Properties for Reification (linking Cl_StudyEnrollment to other core classes)
:hasStudent rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_StudyEnrollment ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Connects a study enrollment instance to the specific person (student) involved." .

:hasDegree rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_StudyEnrollment ;
    rdfs:range :Cl_Degree ;
    rdfs:comment "Connects a study enrollment instance to the specific academic degree being pursued." .

:duringPeriod rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_StudyEnrollment ;
    rdfs:range :Cl_TimePeriod ;
    rdfs:comment "Connects a study enrollment instance to the specific time period during which the study occurred." .

# Data Properties (connecting classes to literal values)

:personName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdfs:comment "The full name of the person." .

:degreeName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Degree ;
    rdfs:range xsd:string ;
    rdfs:comment "The formal name of the degree (e.g., 'Bachelor of Science in Computer Science'). This property is inherited by all subclasses of Cl_Degree." .

:degreeLevel rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Degree ;
    rdfs:range xsd:string ;
    rdfs:comment "The general academic level of the degree (e.g., 'Undergraduate', 'Postgraduate', 'Doctorate')." .

:startDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date ;
    rdfs:comment "The calendar start date of the time period." .

:endDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date ;
    rdfs:comment "The calendar end date of the time period." .

# Restrictions and General Class Axioms

# Every Cl_StudyEnrollment must be fully defined by having exactly one student, one degree, and one time period.
:Cl_StudyEnrollment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasStudent ;
    owl:cardinality 1 ;
    rdfs:comment "Each study enrollment must be associated with exactly one student."
] .

:Cl_StudyEnrollment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasDegree ;
    owl:cardinality 1 ;
    rdfs:comment "Each study enrollment must be associated with exactly one degree."
] .

:Cl_StudyEnrollment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :duringPeriod ;
    owl:cardinality 1 ;
    rdfs:comment "Each study enrollment must occur during exactly one time period."
] .

# Every Cl_TimePeriod must have both a start and an end date defined.
:Cl_TimePeriod rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :startDate ;
    owl:someValuesFrom xsd:date ;
    rdfs:comment "A time period must have a defined start date."
] .

:Cl_TimePeriod rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :endDate ;
    owl:someValuesFrom xsd:date ;
    rdfs:comment "A time period must have a defined end date."
] .

# General axiom: All instances of Cl_Person must have a name.
[ rdf:type owl:Restriction ;
  owl:onProperty :personName ;
  owl:someValuesFrom xsd:string ;
  rdfs:subClassOf :Cl_Person ;
  rdfs:comment "It is a requirement that every person in the ontology has a name."
] .

# General axiom: All instances of Cl_Degree must have a name.
[ rdf:type owl:Restriction ;
  owl:onProperty :degreeName ;
  owl:someValuesFrom xsd:string ;
  rdfs:subClassOf :Cl_Degree ;
  rdfs:comment "It is a requirement that every degree in the ontology has a name."
] .