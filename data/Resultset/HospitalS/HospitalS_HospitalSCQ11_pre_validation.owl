@prefix : <http://www.ontology.org/example#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ontology rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

:Cl_Publication rdf:type owl:Class ;
    rdfs:comment "Represents any item that can be published, serving as a superclass for various types of published works." .

:Cl_Book rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Publication ;
    rdfs:comment "Represents a physical or digital book." .

:Cl_CD rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Publication ;
    rdfs:comment "Represents a Compact Disc, typically for music or data." .

#################################################################
#    Properties
#################################################################

:Pr_hasPublicationDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Publication ;
    rdfs:range xsd:date ;
    rdfs:comment "Specifies the date when a publication item was first published." .

#################################################################
#    Restrictions (Optional, but good for completeness)
#################################################################

# All Cl_Publication instances must have a publication date
:Cl_Publication rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :Pr_hasPublicationDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every publication must have exactly one publication date."
] .