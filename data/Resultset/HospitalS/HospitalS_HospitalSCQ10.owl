@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/book-ontology#> .

# Classes
:Cl_Document rdf:type owl:Class ;
    rdfs:label "Document" .

:Cl_Publication rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Publication" .

:Cl_Book rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Publication ;
    rdfs:label "Book" .

# Properties
:hasPageCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Book ;
    rdfs:range xsd:integer ;
    owl:functional true ;
    rdfs:label "has page count" ;
    rdfs:comment "Indicates the number of pages a book contains." .