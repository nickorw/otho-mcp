@prefix : <http://example.org/hospital-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Cl_Person rdf:type owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Represents an individual person." .

:Cl_Organization rdf:type owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Represents a general organization." .

:Cl_Hospital rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Hospital" ;
    rdfs:comment "Represents a specific type of organization, a hospital." .

:Cl_EmploymentEvent rdf:type owl:Class ;
    rdfs:label "Employment Event" ;
    rdfs:comment "A reification class representing a specific instance of a person's employment at a hospital, capturing the start date of this employment." ;
    # Restrictions to ensure an Employment Event always has a person, a hospital, and a start date
    rdfs:subClassOf
        [ rdf:type owl:Restriction ;
            owl:onProperty :relatesToPerson ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:allValuesFrom :Cl_Person
        ] ,
        [ rdf:type owl:Restriction ;
            owl:onProperty :relatesToHospital ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:allValuesFrom :Cl_Hospital
        ] ,
        [ rdf:type owl:Restriction ;
            owl:onProperty :employmentStartDate ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:allValuesFrom xsd:date
        ] .

:relatesToPerson rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EmploymentEvent ;
    rdfs:range :Cl_Person ;
    rdfs:label "relates to person" ;
    rdfs:comment "Links an employment event to the person involved in that event." .

:relatesToHospital rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EmploymentEvent ;
    rdfs:range :Cl_Hospital ;
    rdfs:label "relates to hospital" ;
    rdfs:comment "Links an employment event to the hospital where the employment took place." .

:hasEmploymentEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_EmploymentEvent ;
    rdfs:label "has employment event" ;
    rdfs:comment "Links a person to an employment event they are involved in." ;
    owl:inverseOf :relatesToPerson .

:hostsEmploymentEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Hospital ;
    rdfs:range :Cl_EmploymentEvent ;
    rdfs:label "hosts employment event" ;
    rdfs:comment "Links a hospital to an employment event that occurred there." ;
    owl:inverseOf :relatesToHospital .

:personName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdfs:label "person name" ;
    rdfs:comment "The full name of the person." .

:hospitalName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Hospital ;
    rdfs:range xsd:string ;
    rdfs:label "hospital name" ;
    rdfs:comment "The official name of the hospital." .

:employmentStartDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_EmploymentEvent ;
    rdfs:range xsd:date ;
    rdfs:label "employment start date" ;
    rdfs:comment "The date when the employment relationship for a specific event began." .