@prefix : <http://example.org/hospital-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:hospital-ontology a owl:Ontology ;
    rdfs:comment "Ontology for representing hospital locations, designed to answer the competency question 'In what city is a certain hospital located?' using reification." ;
    owl:versionIRI <http://example.org/hospital-ontology/1.0> .

# Classes
:Cl_Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "The most general class representing anything in the domain." .

:Cl_Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:subClassOf :Cl_Thing ;
    rdfs:comment "A geographical location or abstract concept of a place." .

:Cl_GeographicalFeature a owl:Class ;
    rdfs:label "Geographical Feature" ;
    rdfs:subClassOf :Cl_Place ;
    rdfs:comment "A specific type of place with distinct geographical characteristics." .

:Cl_City a owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf :Cl_GeographicalFeature ;
    rdfs:comment "A densely populated urban area, typically with defined administrative boundaries." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf :Cl_Thing ;
    rdfs:comment "A structured group of people with a particular purpose, such as a business, institution, or association." .

:Cl_HealthcareProvider a owl:Class ;
    rdfs:label "Healthcare Provider" ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "An organization primarily focused on delivering medical or health services." .

:Cl_Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:subClassOf :Cl_HealthcareProvider ;
    rdfs:comment "A medical institution specialized in providing inpatient and outpatient healthcare services, typically equipped with advanced medical facilities and staff." .

# Reification Pivot Class
:Cl_LocationAssertion a owl:Class ;
    rdfs:label "Location Assertion" ;
    rdfs:subClassOf :Cl_Thing ;
    rdfs:comment "A pivot class that reifies the relationship of an entity being located at a particular place, allowing for additional attributes like coordinates or timeframes to be associated with that specific location instance." .

# Disjoint Classes
:Cl_City owl:disjointWith :Cl_Hospital ;
    rdfs:comment "A City cannot be a Hospital, and vice-versa." .

:Cl_Organization owl:disjointWith :Cl_GeographicalFeature ;
    rdfs:comment "An Organization cannot be a Geographical Feature, and vice-versa." .

# Properties

# Object Properties
:hasRelationship a owl:ObjectProperty ;
    rdfs:label "has relationship" ;
    rdfs:comment "A general property indicating a relationship between two entities." .

:assertsLocation a owl:ObjectProperty ;
    rdfs:label "asserts location" ;
    rdfs:subPropertyOf :hasRelationship ;
    rdfs:domain :Cl_Hospital ;
    rdfs:range :Cl_LocationAssertion ;
    rdfs:comment "Links a hospital to a specific assertion about its location, enabling the inclusion of detailed location attributes." .

:isLocationAssertionOf a owl:ObjectProperty ;
    rdfs:label "is location assertion of" ;
    owl:inverseOf :assertsLocation ;
    rdfs:domain :Cl_LocationAssertion ;
    rdfs:range :Cl_Hospital ;
    a owl:FunctionalProperty ; # A specific location assertion pertains to one hospital.
    rdfs:comment "The inverse property of 'asserts location', indicating which hospital a particular location assertion refers to." .

:locatedInCity a owl:ObjectProperty ;
    rdfs:label "located in city" ;
    rdfs:domain :Cl_LocationAssertion ;
    rdfs:range :Cl_City ;
    rdfs:comment "Connects a location assertion instance to the specific city where the entity (e.g., hospital) is located." .

# Data Properties
:hasName a owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:domain :Cl_Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "A general property for the primary name of any entity." .

:hasCityName a owl:DatatypeProperty ;
    rdfs:label "has city name" ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_City ;
    rdfs:range xsd:string ;
    a owl:FunctionalProperty ; # A city typically has one primary name.
    rdfs:comment "The official or common name of the city." .

:hasLatitude a owl:DatatypeProperty ;
    rdfs:label "has latitude" ;
    rdfs:domain :Cl_LocationAssertion ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The geographical latitude coordinate associated with a specific location assertion." .

:hasLongitude a owl:DatatypeProperty ;
    rdfs:label "has longitude" ;
    rdfs:domain :Cl_LocationAssertion ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The geographical longitude coordinate associated with a specific location assertion." .

# General Class Axioms / Restrictions
# Every Hospital must have at least one location assertion.
:Cl_Hospital rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :assertsLocation ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every instance of Cl_Hospital has at least one associated location assertion."
] .

# Every Location Assertion must be associated with a Hospital.
:Cl_LocationAssertion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocationAssertionOf ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every instance of Cl_LocationAssertion describes the location of at least one Cl_Hospital."
] .

# Every Location Assertion must specify the city it is located in.
:Cl_LocationAssertion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :locatedInCity ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every instance of Cl_LocationAssertion explicitly states the city where the entity is located."
] .