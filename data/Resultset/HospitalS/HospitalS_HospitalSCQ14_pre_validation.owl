@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology Declaration
<http://example.org/ontology> rdf:type owl:Ontology ;
    rdfs:comment "Ontology designed to answer the competency question 'Where did a certain seminar take place?'" ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# Classes
:Cl_Place rdf:type owl:Class ;
    rdfs:label "Place" .

:Cl_Location rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Place ;
    rdfs:label "Location" .

:Cl_Building rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:label "Building" .

:Cl_Room rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:label "Room" .

:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" .

:Cl_Seminar rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Seminar" .

# General Class Axioms / Disjointness
:Cl_Building owl:disjointWith :Cl_Room ;
    owl:disjointWith :Cl_Event .

:Cl_Room owl:disjointWith :Cl_Event .

# Properties

# Object Property: Indicates where an event (like a seminar) takes place.
:hasLocation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range :Cl_Location ;
    rdfs:label "has location" .

# Object Property: Specifies that a room is located within a building.
:locatedIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ; # A room is typically located in exactly one building.
    rdfs:domain :Cl_Room ;
    rdfs:range :Cl_Building ;
    rdfs:label "located in" .

# Data Property: Represents the specific room number.
:hasRoomNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; # A room has one specific identifier/number.
    rdfs:domain :Cl_Room ;
    rdfs:range xsd:string ; # Room numbers can be alphanumeric (e.g., "101A", "B205").
    rdfs:label "has room number" .

# Data Property: Represents the name of the building.
:hasBuildingName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; # A building has one official name.
    rdfs:domain :Cl_Building ;
    rdfs:range xsd:string ;
    rdfs:label "has building name" .

# Restrictions
# Every Seminar must have at least one location.
:Cl_Seminar rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasLocation ;
    owl:someValuesFrom :Cl_Location
] .

# Every Room must be located in at least one Building.
:Cl_Room rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :locatedIn ;
    owl:someValuesFrom :Cl_Building
] .