@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general class representing any type of event." .

:Cl_Seminar rdf:type owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A specific type of event, typically an academic or professional presentation." ;
    rdfs:subClassOf :Cl_Event .

# Reification/Pivot Class for Seminar Occurrence
# This class is introduced to capture the specific instance of a seminar taking place at a particular time,
# addressing the complex scenario of linking a seminar to its temporal information.
:Cl_SeminarOccurrence rdf:type owl:Class ;
    rdfs:label "Seminar Occurrence" ;
    rdfs:comment "A pivot class representing a specific instance or a single occurrence of a seminar, linking it to the exact time it takes place." .

# Properties

# Object Property: Links a seminar to its specific occurrences.
:hasSeminarOccurrence rdf:type owl:ObjectProperty ;
    rdfs:label "has seminar occurrence" ;
    rdfs:domain :Cl_Seminar ;
    rdfs:range :Cl_SeminarOccurrence ;
    rdfs:comment "Connects a seminar to an instance representing one of its specific occurrences." .

# Object Property: Links a seminar occurrence back to the seminar it belongs to.
:isOccurrenceOfSeminar rdf:type owl:ObjectProperty ;
    rdfs:label "is occurrence of seminar" ;
    rdfs:domain :Cl_SeminarOccurrence ;
    rdfs:range :Cl_Seminar ;
    owl:inverseOf :hasSeminarOccurrence ;
    rdfs:comment "Connects a seminar occurrence to the specific seminar it is an instance of." .

# Data Property: Specifies the exact date and time of a seminar occurrence.
:hasTimeOfOccurrence rdf:type owl:DatatypeProperty ;
    rdfs:label "has time of occurrence" ;
    rdfs:domain :Cl_SeminarOccurrence ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Records the precise date and time when a seminar occurrence happened." .

# Restrictions
# Every SeminarOccurrence must be an occurrence of exactly one Cl_Seminar.
:Cl_SeminarOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isOccurrenceOfSeminar ;
    owl:cardinality 1 ;
    rdfs:comment "Each 'Cl_SeminarOccurrence' must be an occurrence of exactly one 'Cl_Seminar'."
] .

# Every SeminarOccurrence must have exactly one time of occurrence.
:Cl_SeminarOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTimeOfOccurrence ;
    owl:cardinality 1 ;
    rdfs:comment "Each 'Cl_SeminarOccurrence' must have exactly one specific time of occurrence."
] .