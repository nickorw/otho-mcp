@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology definition
:ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for musical instruments and performers, designed to answer 'What instruments does a certain person play?' using reification for the 'playing' relationship." ;
    owl:versionIRI <http://example.org/ontology/1.0.0> ;
    owl:imports <http://www.w3.org/2002/07/owl> .

# ---------------------------------------------------
# Classes
# ---------------------------------------------------

# Top-level general classes for hierarchy
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "The most general class for all entities in the ontology." .

:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A class for active entities that can perform actions." .

:Cl_Object rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A class for tangible or intangible objects." .

:Cl_Relation rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A class for reified relationships or statements between entities." .

# Specific domain classes
:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents a human being." .

:Cl_Musician rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:comment "A person who plays one or more musical instruments." .

:Cl_MusicalInstrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Object ;
    rdfs:comment "A device created or adapted to make musical sounds." .

# Hierarchical classification for musical instruments
:Cl_StringInstrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalInstrument ;
    rdfs:comment "A musical instrument that produces sound from vibrating strings (e.g., guitar, violin)." .
:Cl_WindInstrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalInstrument ;
    rdfs:comment "A musical instrument that produces sound from a vibrating air column (e.g., flute, trumpet)." .
:Cl_PercussionInstrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalInstrument ;
    rdfs:comment "A musical instrument sounded by being struck, scraped, or rubbed (e.g., drums, xylophone)." .
:Cl_KeyboardInstrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalInstrument ;
    rdfs:comment "A musical instrument played using a musical keyboard (e.g., piano, organ)." .
:Cl_ElectronicInstrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalInstrument ;
    rdfs:comment "A musical instrument that produces sound using electronic circuitry (e.g., synthesizer, electric guitar)." .

# Reification Pivot Class for the "plays" relationship
:Cl_InstrumentPlayingRelation rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Relation ;
    rdfs:comment "A pivot class representing the relationship instance where a specific person plays a specific musical instrument. This reifies the 'plays' association to allow for additional details or complex queries about this skill/capability." .

# ---------------------------------------------------
# Properties
# ---------------------------------------------------

# Object Properties (relations between classes)

# Property linking a Person to their instrument playing relationship instance
:playsInstrumentRelation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_InstrumentPlayingRelation ;
    rdfs:comment "Connects a person to an instance of their playing an instrument. This property initiates the reified relationship." .

# Properties linking the Cl_InstrumentPlayingRelation pivot to the Cl_Person and Cl_MusicalInstrument
:hasPlayer rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InstrumentPlayingRelation ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Connects an instrument playing relation to the person who is the player in this relation." ;
    owl:inverseOf :playsInstrumentRelation .

:hasInstrument rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InstrumentPlayingRelation ;
    rdfs:range :Cl_MusicalInstrument ;
    rdfs:comment "Connects an instrument playing relation to the specific musical instrument involved." .

# Inverse property for convenience (e.g., to query which relations involve a particular instrument)
:instrumentIsPlayedInRelation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_MusicalInstrument ;
    rdfs:range :Cl_InstrumentPlayingRelation ;
    rdfs:comment "Connects a musical instrument to the specific playing relations in which it is involved." ;
    owl:inverseOf :hasInstrument .

# Data Properties (relations between classes and datatypes)

:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Entity ; # General name property for any entity
    rdfs:range xsd:string ;
    rdfs:comment "The common name of an entity (e.g., person's name, instrument's name)." .

:playsSinceYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InstrumentPlayingRelation ;
    rdfs:range xsd:gYear ;
    rdfs:comment "The approximate year when the person started playing the specific instrument in this relation. This exemplifies additional details that can be attached to the reified relation." .

# ---------------------------------------------------
# Restrictions and Axioms
# ---------------------------------------------------

# Every Cl_InstrumentPlayingRelation instance must involve a player and a musical instrument
:Cl_InstrumentPlayingRelation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasPlayer ;
    owl:someValuesFrom :Cl_Person
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInstrument ;
    owl:someValuesFrom :Cl_MusicalInstrument
] .

# Definition of a Cl_Musician: a Person who has at least one Cl_InstrumentPlayingRelation.
# This makes Cl_Musician an equivalent class to a Person who plays an instrument.
:Cl_Musician owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Person
        [ rdf:type owl:Restriction ;
          owl:onProperty :playsInstrumentRelation ;
          owl:someValuesFrom :Cl_InstrumentPlayingRelation
        ]
    )
] .

# Every Person must have a name
:Cl_Person rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:someValuesFrom xsd:string
] .

# Every MusicalInstrument must have a name
:Cl_MusicalInstrument rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:someValuesFrom xsd:string
] .

# Disjoint Classes: Ensure instrument categories are mutually exclusive
owl:AllDisjointClasses rdf:type owl:AllDisjointClasses ;
    owl:members ( :Cl_StringInstrument :Cl_WindInstrument :Cl_PercussionInstrument :Cl_KeyboardInstrument :Cl_ElectronicInstrument ) .
@prefix : <http://www.semanticweb.org/ontology/band-membership#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/ontology/band-membership> rdf:type owl:Ontology ;
                                                     owl:versionIRI <http://www.semanticweb.org/ontology/band-membership/1.0.0> ;
                                                     rdfs:comment "Ontology for representing band membership information to answer the competency question: 'What are the members of a certain band at a certain point in time?'" .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
           rdfs:comment "The most general class representing anything in the domain." .

:Cl_Agent rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Entity ;
          rdfs:comment "Represents an entity that can perform actions or has a role." .

:Cl_Organization rdf:type owl:Class ;
                 rdfs:subClassOf :Cl_Agent ;
                 rdfs:comment "Represents a group or organized body." .

:Cl_Band rdf:type owl:Class ;
         rdfs:subClassOf :Cl_Organization ;
         rdfs:comment "Represents a musical band." .

:Cl_Person rdf:type owl:Class ;
           rdfs:subClassOf :Cl_Agent ;
           rdfs:comment "Represents an individual person." .

:Cl_TemporalEntity rdf:type owl:Class ;
                   rdfs:subClassOf :Cl_Entity ;
                   rdfs:comment "Represents any entity related to time." .

:Cl_DateTime rdf:type owl:Class ;
             rdfs:subClassOf :Cl_TemporalEntity ;
             rdfs:comment "Represents a specific point in time or a date and time." .

# Pivot class for reifying the 'member of a band at a certain time' relationship
:Cl_BandMembership rdf:type owl:Class ;
                   rdfs:subClassOf :Cl_Entity ;
                   rdfs:comment "Represents the specific event or state of a person being a member of a band, including the temporal context." .

#################################################################
#    Object Properties
#################################################################

:hasMembershipEvent rdf:type owl:ObjectProperty ;
                    rdfs:domain :Cl_Band ;
                    rdfs:range :Cl_BandMembership ;
                    rdfs:comment "Links a band to a specific membership event involving one of its members." .

:forBand rdf:type owl:ObjectProperty ;
         owl:inverseOf :hasMembershipEvent ;
         rdfs:domain :Cl_BandMembership ;
         rdfs:range :Cl_Band ;
         rdfs:comment "Links a band membership event to the specific band it pertains to." .

:involvesPerson rdf:type owl:ObjectProperty ;
                rdfs:domain :Cl_BandMembership ;
                rdfs:range :Cl_Person ;
                rdfs:comment "Links a band membership event to the person who is the member." .

:hasBandMembership rdf:type owl:ObjectProperty ;
                   owl:inverseOf :involvesPerson ;
                   rdfs:domain :Cl_Person ;
                   rdfs:range :Cl_BandMembership ;
                   rdfs:comment "Links a person to a specific band membership event they are involved in." .

#################################################################
#    Data Properties
#################################################################

:bandName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Cl_Band ;
          rdfs:range xsd:string ;
          owl:functional true ;
          rdfs:comment "The official or common name of the band." .

:personName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Cl_Person ;
            rdfs:range xsd:string ;
            owl:functional true ;
            rdfs:comment "The primary name of the person." .

:hasMembershipStartTime rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Cl_BandMembership ;
                        rdfs:range xsd:dateTime ;
                        owl:functional true ;
                        rdfs:comment "The date and time when the person's membership in the band began." .

:hasMembershipEndTime rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Cl_BandMembership ;
                      rdfs:range xsd:dateTime ;
                      owl:functional true ;
                      rdfs:comment "The date and time when the person's membership in the band ended. This property might be absent if the membership is ongoing." .

#################################################################
#    General Class Axioms / Restrictions
#################################################################

# A Cl_BandMembership must involve exactly one person.
:Cl_BandMembership rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :involvesPerson ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                      rdfs:comment "Each band membership event must link to exactly one person."
                                    ] .

# A Cl_BandMembership must be for exactly one band.
:Cl_BandMembership rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :forBand ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                      rdfs:comment "Each band membership event must link to exactly one band."
                                    ] .

# A Cl_BandMembership must have a start time.
:Cl_BandMembership rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasMembershipStartTime ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                      rdfs:comment "Each band membership event must have a defined start date and time."
                                    ] .

# If a band has members, it implies there are membership events.
:Cl_Band rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasMembershipEvent ;
                            owl:someValuesFrom :Cl_BandMembership ;
                            rdfs:comment "A band must be associated with at least one band membership event if it has members."
                          ] .

# If a person is a band member, they must be involved in at least one band membership event.
:Cl_Person rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :hasBandMembership ;
                              owl:someValuesFrom :Cl_BandMembership ;
                              rdfs:comment "A person identified as a band member must be associated with at least one band membership event."
                            ] .
@prefix : <http://www.example.org/band-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:bandOntology a owl:Ontology ;
    owl:versionIRI <http://www.example.org/band-ontology/1.0> ;
    rdfs:comment "Ontology for modeling roles of people in bands at specific points in time, addressing the competency question: 'What role does a certain person have in a certain band at a certain point in time?'" .

#
# Classes
#
:Cl_Entity a owl:Class ;
    rdfs:comment "The most general class, representing anything in the domain." .

:Cl_Agent a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A subclass of Entity representing active entities or actors." .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents an individual person." .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A subclass of Entity representing an organized body of people." .

:Cl_Band a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "Represents a musical group or band." .

:Cl_Role a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a specific function, position, or part played by someone." .

:Cl_TemporalEntity a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A subclass of Entity representing concepts related to time." .

:Cl_TimePoint a owl:Class ;
    rdfs:subClassOf :Cl_TemporalEntity ;
    rdfs:comment "Represents a specific, instantaneous moment in time." .

# Reification Class for Band Membership
:Cl_BandMembership a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A pivot class that reifies the relationship between a person, a band, a role, and a specific time point. It captures 'who played what in which band when'." .

#
# Properties
#

# Data Properties
:dp_name a owl:DatatypeProperty ;
    rdfs:domain :Cl_Entity ;
    rdfs:range xsd:string ;
    rdfs:comment "A generic property to capture the name of any entity." .

:dp_timeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePoint ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The specific date and time value for a Cl_TimePoint instance." ;
    owl:maxCardinality 1 ; # Each time point has at most one specific value
    owl:minCardinality 1 . # Each time point must have exactly one specific value

# Object Properties for Reification
:op_hasPerson a owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Connects a Cl_BandMembership instance to the Cl_Person who holds the role." ;
    owl:cardinality 1 . # Each membership must involve exactly one person

:op_inBand a owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Band ;
    rdfs:comment "Connects a Cl_BandMembership instance to the Cl_Band in which the role is held." ;
    owl:cardinality 1 . # Each membership must be in exactly one band

:op_hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Role ;
    rdfs:comment "Connects a Cl_BandMembership instance to the Cl_Role held by the person." ;
    owl:cardinality 1 . # Each membership must define exactly one role

:op_atTimePoint a owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_TimePoint ;
    rdfs:comment "Connects a Cl_BandMembership instance to the Cl_TimePoint when the role is valid or starts." ;
    owl:cardinality 1 . # Each membership is tied to exactly one specific point in time

#
# General Class Axioms / Restrictions
#
# Ensuring Cl_BandMembership instances are properly formed by requiring
# all their essential relations to be present.
:Cl_BandMembership rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :op_hasPerson ;
      owl:someValuesFrom :Cl_Person
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :op_inBand ;
      owl:someValuesFrom :Cl_Band
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :op_hasRole ;
      owl:someValuesFrom :Cl_Role
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :op_atTimePoint ;
      owl:someValuesFrom :Cl_TimePoint
    ] .
@prefix : <http://www.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Creative Work" .

:Cl_TemporalEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Temporal Entity" .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Event" .

:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:label "Album" .

:Cl_TimePeriod rdf:type owl:Class ;
    rdfs:subClassOf :Cl_TemporalEntity ;
    rdfs:label "Time Period" .

# Reification class for the recording event
:Cl_RecordingEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Recording Event" ;
    # Restrictions for Cl_RecordingEvent
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Cl_Event
            [ rdf:type owl:Restriction ;
              owl:onProperty :recordedAlbum ;
              owl:someValuesFrom :Cl_Album
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :occursDuring ;
              owl:someValuesFrom :Cl_TimePeriod
            ]
        )
    ] .

#################################################################
#    Properties
#################################################################

# Object Properties

:hasRecordingEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_RecordingEvent ;
    rdfs:label "has recording event" .

:recordedAlbum rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_RecordingEvent ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :hasRecordingEvent ;
    rdfs:label "recorded album" .

:occursDuring rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_RecordingEvent ;
    rdfs:range :Cl_TimePeriod ;
    rdfs:label "occurs during" .

:isTimePeriodOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range :Cl_RecordingEvent ;
    owl:inverseOf :occursDuring ;
    rdfs:label "is time period of" .

# Data Properties

:albumTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Album ;
    rdfs:range xsd:string ;
    rdfs:label "album title" .

:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date ;
    rdfs:label "has start time" .

:hasEndTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date ;
    rdfs:label "has end time" .

#################################################################
#    Individuals (Example to demonstrate usage)
#################################################################

:TheDarkSideOfTheMoon rdf:type :Cl_Album ;
    :albumTitle "The Dark Side of the Moon" .

:DSOTM_RecordingPeriod rdf:type :Cl_TimePeriod ;
    :hasStartTime "1972-06-01"^^xsd:date ;
    :hasEndTime "1973-01-31"^^xsd:date .

:DSOTM_RecordingEvent_Instance rdf:type :Cl_RecordingEvent ;
    :recordedAlbum :TheDarkSideOfTheMoon ;
    :occursDuring :DSOTM_RecordingPeriod .

# Competency Question: "During what time period was a certain album recorded?"
# Example Query (SPARQL):
# SELECT ?albumTitle ?startTime ?endTime
# WHERE {
#   ?album rdf:type :Cl_Album ;
#          :albumTitle ?albumTitle .
#   ?recordingEvent :recordedAlbum ?album ;
#                   :occursDuring ?timePeriod .
#   ?timePeriod :hasStartTime ?startTime ;
#               :hasEndTime ?endTime .
# }
# This query would return: "The Dark Side of the Moon", "1972-06-01", "1973-01-31"
# If the question was for a specific album, e.g., "The Dark Side of the Moon":
# SELECT ?startTime ?endTime
# WHERE {
#   :TheDarkSideOfTheMoon :albumTitle "The Dark Side of the Moon" .
#   ?recordingEvent :recordedAlbum :TheDarkSideOfTheMoon ;
#                   :occursDuring ?timePeriod .
#   ?timePeriod :hasStartTime ?startTime ;
#               :hasEndTime ?endTime .
# }
@prefix : <http://www.semanticweb.org/music-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/music-ontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://www.semanticweb.org/music-ontology/1.0.0> ;
    rdfs:comment "Ontology for representing musical albums and their tracks, designed to answer the competency question: 'How many tracks does a particular album contain?'" .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "A very general top-level class representing any conceptual entity within the ontology." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A general class for intellectual or artistic creations, such as books, films, or music." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "A specific type of creative work related to music, encompassing compositions, recordings, and performances." .

:Cl_Collection rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A generic class for any collection of items or entities." .

:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork , :Cl_Collection ;
    rdfs:comment "Represents a distinct collection of musical recordings, typically released together as a single product." .

:Cl_Item rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A generic class for an individual piece or component." .

:Cl_Track rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork , :Cl_Item ;
    rdfs:comment "Represents an individual musical recording or song, which can be part of an album or released independently." .

:Cl_RelationshipEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A general class for reified events or instances that represent a specific relationship or interaction between other entities." .

:Cl_AlbumTrackInclusion rdf:type owl:Class ;
    rdfs:subClassOf :Cl_RelationshipEvent ;
    rdfs:comment "A pivot class representing the specific instance of a track being included in a particular album, capturing details like its position within that album. This reifies the 'contains' relationship to allow for additional properties." .

#################################################################
#    Object Properties
#################################################################

:hasRelationshipEvent rdf:type owl:ObjectProperty ;
    rdfs:comment "A generic property to link an entity to a relationship event it participates in." .

:includesTrackPlacement rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasRelationshipEvent ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_AlbumTrackInclusion ;
    rdfs:comment "Connects an album to an instance describing a track's inclusion within it." .

:isPlacementForTrack rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range :Cl_Track ;
    rdfs:comment "Connects an album track inclusion instance to the specific musical track that is being included." .

:relatesToAlbum rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range :Cl_Album ;
    rdfs:comment "Connects an album track inclusion instance back to the album it is part of." ;
    owl:inverseOf :includesTrackPlacement .

#################################################################
#    Datatype Properties
#################################################################

:albumTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Album ;
    rdfs:range xsd:string ;
    rdfs:comment "The primary textual title of an album." .

:trackTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Track ;
    rdfs:range xsd:string ;
    rdfs:comment "The primary textual title of an individual track." .

:hasTrackNumber rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range xsd:integer ;
    rdfs:comment "The sequential number or position of a track within a specific album, as defined by the Cl_AlbumTrackInclusion instance." .

#################################################################
#    Restrictions
#################################################################

# An Album must have at least one track inclusion to be considered a 'musical album' in this context.
:Cl_Album rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :includesTrackPlacement ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_AlbumTrackInclusion ;
    rdfs:comment "Every album must include at least one track placement."
] .

# Each Cl_AlbumTrackInclusion must refer to exactly one specific Cl_Track.
:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isPlacementForTrack ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Track ;
    rdfs:comment "An album track inclusion event must specify exactly one track."
] .

# Each Cl_AlbumTrackInclusion must relate to exactly one Cl_Album.
:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :relatesToAlbum ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Album ;
    rdfs:comment "An album track inclusion event must relate to exactly one album."
] .

# Each Cl_AlbumTrackInclusion must have exactly one track number.
:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTrackNumber ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:integer ;
    rdfs:comment "An album track inclusion event must have exactly one track number."
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Creative Work" .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:label "Musical Work" .

:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:label "Album" .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Event" .

:Cl_ReleaseEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Release Event" .

# Object Properties
:hasReleaseEvent rdf:type owl:ObjectProperty ;
    rdfs:label "has release event" ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_ReleaseEvent ;
    rdf:type owl:FunctionalProperty . # An album is considered to have one primary release event in this context.

:concernsAlbum rdf:type owl:ObjectProperty ;
    rdfs:label "concerns album" ;
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :hasReleaseEvent ;
    rdf:type owl:FunctionalProperty . # A release event refers to exactly one album.

# Data Properties
:hasReleaseDate rdf:type owl:DatatypeProperty ;
    rdfs:label "has release date" ;
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range xsd:date ;
    rdf:type owl:FunctionalProperty . # A release event has exactly one release date.

# General Class Axioms / Restrictions
# An Album must have exactly one primary Release Event based on the 'hasReleaseEvent' property being functional.
:Cl_Album owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Album
        [
            rdf:type owl:Restriction ;
            owl:onProperty :hasReleaseEvent ;
            owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .

# A ReleaseEvent must concern exactly one Album and have exactly one Release Date.
:Cl_ReleaseEvent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_ReleaseEvent
        [
            rdf:type owl:Restriction ;
            owl:onProperty :concernsAlbum ;
            owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty :hasReleaseDate ;
            owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.com/ontology#> .

<http://example.com/ontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://example.com/ontology/1.0> ;
    rdfs:comment "Ontology for music tracks and musical works, focusing on reification for recording relationships." .

#################################################################
#    Classes
#################################################################

ex:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:label "Creative Work" ;
    rdfs:comment "A generic class for any creative work, such as a musical composition or an artistic performance." .

ex:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf ex:Cl_CreativeWork ;
    rdfs:label "Musical Work" ;
    rdfs:comment "Represents an abstract musical composition or song, distinct from any specific recording of it." .

ex:Cl_AudioRecording rdf:type owl:Class ;
    rdfs:subClassOf ex:Cl_CreativeWork ;
    rdfs:label "Audio Recording" ;
    rdfs:comment "Represents a specific recorded audio track, an instance of a musical work." .

ex:Cl_RecordingInstance rdf:type owl:Class ;
    rdfs:comment "A pivot class representing a specific instance of an Audio Recording being a recording of a Musical Work. This reifies the 'is a recording of' relationship, allowing for additional properties about the recording event itself." ;
    rdfs:label "Recording Instance" .

#################################################################
#    Object Properties
#################################################################

ex:hasRecordingInstance rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cl_AudioRecording ;
    rdfs:range ex:Cl_RecordingInstance ;
    rdfs:label "has recording instance" ;
    rdfs:comment "Connects an Audio Recording to its specific Recording Instance (the reified relationship)." .

ex:isInstanceOfMusicalWork rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cl_RecordingInstance ;
    rdfs:range ex:Cl_MusicalWork ;
    rdfs:label "is instance of musical work" ;
    rdfs:comment "Connects a Recording Instance to the Musical Work it documents or represents." .

ex:isRecordingOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cl_AudioRecording ;
    rdfs:range ex:Cl_MusicalWork ;
    rdfs:label "is recording of" ;
    rdfs:comment "Directly relates an Audio Recording to the Musical Work it records. This property's semantics are captured by the property chain involving Cl_RecordingInstance." ;
    owl:propertyChainAxiom ( ex:hasRecordingInstance ex:isInstanceOfMusicalWork ) . # This axiom enables direct querying for the competency question using the reified structure.

#################################################################
#    Data Properties
#################################################################

ex:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Cl_CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:label "has title" ;
    rdfs:comment "The title of a creative work." .

ex:hasDurationSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Cl_AudioRecording ;
    rdfs:range xsd:integer ;
    rdfs:label "has duration in seconds" ;
    rdfs:comment "The duration of an audio recording in seconds." .

#################################################################
#    Restrictions and Axioms
#################################################################

# Every AudioRecording must have at least one RecordingInstance.
ex:Cl_AudioRecording rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:hasRecordingInstance ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "An Audio Recording must be associated with at least one Recording Instance."
] .

# Every RecordingInstance must be an instance of exactly one Musical Work.
ex:Cl_RecordingInstance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:isInstanceOfMusicalWork ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "A Recording Instance must refer to exactly one Musical Work."
] .

# An Audio Recording must be a recording of some Musical Work. This is a soft restriction, ensured by the property chain.
ex:Cl_AudioRecording rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:isRecordingOf ;
    owl:someValuesFrom ex:Cl_MusicalWork ;
    rdfs:comment "Every Audio Recording is a recording of at least one Musical Work."
] .
@prefix : <http://example.org/song-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/song-ontology> rdf:type owl:Ontology ;
                                   owl:versionIRI <http://example.org/song-ontology/1.0> ;
                                   rdfs:comment "Ontology for representing song composition information, addressing the competency question 'When was a certain song composed?'" .

### Classes ###

:Cl_Entity rdf:type owl:Class ;
           rdfs:comment "A top-level class representing any fundamental entity in the ontology." .

:Cl_CreativeWork rdf:type owl:Class ;
                 rdfs:subClassOf :Cl_Entity ;
                 rdfs:comment "A class representing any intellectual or artistic creation." .

:Cl_Song rdf:type owl:Class ;
         rdfs:subClassOf :Cl_CreativeWork ;
         rdfs:comment "A specific type of creative work, embodying a musical composition meant to be performed or heard." .

:Cl_Event rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Entity ;
          rdfs:comment "A class representing any action, occurrence, or happening in time." .

:Cl_CompositionEvent rdf:type owl:Class ;
                     rdfs:subClassOf :Cl_Event ;
                     rdfs:comment "A pivot class representing the specific event of a song being composed. This reifies the act of composition to link the song, composer, and the exact time of composition." .

:Cl_Agent rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Entity ;
          rdfs:comment "A class representing an entity that has the capacity to act, such as a person or an organization." .

:Cl_Composer rdf:type owl:Class ;
             rdfs:subClassOf :Cl_Agent ;
             rdfs:comment "An agent specifically responsible for creating musical compositions." .

### Properties ###

# Object Properties

:hasComposition rdf:type owl:ObjectProperty ;
                rdfs:domain :Cl_Song ;
                rdfs:range :Cl_CompositionEvent ;
                rdfs:comment "Links a song to the specific event of its composition." .

:composesWorkEvent rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasComposition ;
                   rdfs:domain :Cl_CompositionEvent ;
                   rdfs:range :Cl_Song ;
                   rdfs:comment "Links a composition event to the specific song that was composed during that event." .

:performedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Cl_CompositionEvent ;
             rdfs:range :Cl_Composer ;
             rdfs:comment "Links a composition event to the composer who carried out the composition." .

:composedEventOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :performedBy ;
                 rdfs:domain :Cl_Composer ;
                 rdfs:range :Cl_CompositionEvent ;
                 rdfs:comment "Links a composer to a composition event they were involved in." .

# Data Properties

:title rdf:type owl:DatatypeProperty ;
       rdfs:domain :Cl_Song ;
       rdfs:range xsd:string ;
       rdfs:comment "The official or common title of a song." .

:compositionDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Cl_CompositionEvent ;
                 rdfs:range xsd:date ;
                 rdfs:comment "The specific date when a composition event took place." .

:composerName rdf:type owl:DatatypeProperty ;
              rdfs:domain :Cl_Composer ;
              rdfs:range xsd:string ;
              rdfs:comment "The full name of the composer." .

### Class Axioms and Restrictions ###

# A Cl_Song must be associated with at least one composition event.
:Cl_Song rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasComposition ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every song must be associated with at least one composition event."
] .

# A Cl_CompositionEvent must relate to exactly one Cl_Song.
:Cl_CompositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :composesWorkEvent ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every composition event must be associated with exactly one song that was composed."
] .

# A Cl_CompositionEvent must have exactly one composition date.
:Cl_CompositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :compositionDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every composition event must have exactly one date specifying when it occurred."
] .

# A Cl_CompositionEvent is typically performed by at most one Cl_Composer for simplicity, but can be none if composer is unknown or collective.
:Cl_CompositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :performedBy ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "A composition event is typically performed by at most one composer, though specific scenarios might allow for zero or more."
] .

# Disjointness for fundamental top-level classes (example)
:Cl_CreativeWork owl:disjointWith :Cl_Event .
:Cl_CreativeWork owl:disjointWith :Cl_Agent .
:Cl_Event owl:disjointWith :Cl_Agent .
@prefix : <http://example.org/record-critic-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/record-critic-ontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/record-critic-ontology/1.0> ;
    rdfs:label "Record Critic Ontology" ;
    rdfs:comment "Ontology for representing critics' reviews of musical records." .

#################################################################
#    Classes
#################################################################

# Core top-level classes to establish a hierarchy
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class for all concepts in the ontology." .

:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Agent" ;
    rdfs:comment "An entity capable of action." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Creative Work" ;
    rdfs:comment "A product of intellectual or creative effort." .

:Cl_EventOrInteraction rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Event or Interaction" ;
    rdfs:comment "A happening or an interaction between entities." .

# Specific classes derived from the story and competency question

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:label "Person" ;
    rdfs:comment "A human being." .

:Cl_Critic rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who publishes an evaluation or analysis of creative works." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:label "Musical Work" ;
    rdfs:comment "A composition of music." .

:Cl_Record rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:label "Record" ;
    rdfs:comment "A specific released instance of a musical work, e.g., an album or single." .

# Pivot Class for reification - Cl_Review captures the 'saying' part
:Cl_Review rdf:type owl:Class ;
    rdfs:subClassOf :Cl_EventOrInteraction ;
    rdfs:label "Review" ;
    rdfs:comment "Represents a critic's evaluation or commentary on a record. This serves as a pivot class to connect a critic, a record, and the actual content of the review." .

#################################################################
#    Object Properties
#################################################################

# Properties connecting Cl_Critic, Cl_Review, and Cl_Record to answer the competency question

:writesReview rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Critic ;
    rdfs:range :Cl_Review ;
    rdfs:label "writes review" ;
    rdfs:comment "Connects a critic to a specific review they have authored." .

:reviewedBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :writesReview ;
    rdfs:domain :Cl_Review ;
    rdfs:range :Cl_Critic ;
    rdfs:label "reviewed by" ;
    rdfs:comment "Connects a review to the critic who wrote it." ;
    owl:propertyCharacteristic owl:Functional . # A review is written by one critic.

:reviewsRecord rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Review ;
    rdfs:range :Cl_Record ;
    rdfs:label "reviews record" ;
    rdfs:comment "Connects a review to the musical record it evaluates." ;
    owl:propertyCharacteristic owl:Functional . # A review is about one record.

:isReviewedIn rdf:type owl:ObjectProperty ;
    owl:inverseOf :reviewsRecord ;
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_Review ;
    rdfs:label "is reviewed in" ;
    rdfs:comment "Connects a record to a review written about it." .

#################################################################
#    Data Properties
#################################################################

# Data properties for Cl_Critic
:criticName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Critic ;
    rdfs:range xsd:string ;
    rdfs:label "critic name" ;
    rdfs:comment "The full name of the critic." ;
    owl:propertyCharacteristic owl:Functional .

:criticAffiliation rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Critic ;
    rdfs:range xsd:string ;
    rdfs:label "critic affiliation" ;
    rdfs:comment "The organization or publication the critic is associated with." .

# Data properties for Cl_Record
:recordTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range xsd:string ;
    rdfs:label "record title" ;
    rdfs:comment "The official title of the musical record." ;
    owl:propertyCharacteristic owl:Functional .

:recordArtist rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range xsd:string ; # Could be a class Cl_Artist if more complex artist modeling is needed
    rdfs:label "record artist" ;
    rdfs:comment "The primary artist(s) associated with the record." .

:releaseDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range xsd:date ;
    rdfs:label "release date" ;
    rdfs:comment "The official release date of the record." ;
    owl:propertyCharacteristic owl:Functional .

# Data properties for Cl_Review (pivot class)
:reviewContent rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Review ;
    rdfs:range xsd:string ;
    rdfs:label "review content" ;
    rdfs:comment "The actual textual body of the critic's review." ;
    owl:propertyCharacteristic owl:Functional .

:reviewRating rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Review ;
    rdfs:range xsd:decimal ;
    rdfs:label "review rating" ;
    rdfs:comment "A numerical or categorical rating assigned in the review (e.g., 8.5/10, 4/5 stars)." ;
    owl:propertyCharacteristic owl:Functional .

:reviewDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Review ;
    rdfs:range xsd:date ;
    rdfs:label "review date" ;
    rdfs:comment "The date when the review was published." ;
    owl:propertyCharacteristic owl:Functional .

#################################################################
#    Restrictions / General Class Axioms
#################################################################

# Restrictions for Cl_Review to ensure valid reification
:Cl_Review rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :reviewedBy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every review must be written by exactly one critic."
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :reviewsRecord ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every review must be about exactly one record."
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :reviewContent ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every review must have content."
    ] .

# Restrictions for Cl_Critic
:Cl_Critic rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :criticName ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every critic must have a name."
    ] .

# Restrictions for Cl_Record
:Cl_Record rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :recordTitle ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every record must have a title."
    ] .
@prefix : <http://example.org/performance-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology URI
<http://example.org/performance-ontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/performance-ontology/1.0> ;
    rdfs:comment "Ontology for representing performance events and their timings, focusing on the competency question 'When did a certain performance take place?'" .

#################################################################
#    Classes
#################################################################

# Top-level abstract class for all entities
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A top-level class for all conceptual entities in the ontology, serving as a root for classification." .

# Classes related to temporal concepts
:Cl_TemporalEntity rdf:type owl:Class ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "Represents any entity that has a temporal dimension, such as points in time or intervals." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_DateTime rdf:type owl:Class ;
    rdfs:label "Date Time" ;
    rdfs:comment "Represents a specific point in time, including both date and time components, mapping to xsd:dateTime." ;
    rdfs:subClassOf :Cl_TemporalEntity .

# Classes related to activities and events
:Cl_Activity rdf:type owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "Represents any action, process, or task that can be performed." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Performance rdf:type owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "Represents a specific act of performing, such as a musical concert, theatrical play, or an exhibition." ;
    rdfs:subClassOf :Cl_Activity .

:Cl_Occurrence rdf:type owl:Class ;
    rdfs:label "Occurrence" ;
    rdfs:comment "A general class for any event or happening that takes place at a specific time or over an interval." ;
    rdfs:subClassOf :Cl_Entity .

# Reification Class: Cl_PerformanceOccurrence
# This pivot class captures the event of a specific performance taking place at a certain time.
:Cl_PerformanceOccurrence rdf:type owl:Class ;
    rdfs:label "Performance Occurrence" ;
    rdfs:comment "Represents a specific instance or scheduled event of a Cl_Performance taking place at a particular date and time. This class reifies the 'takes place at' relationship." ;
    rdfs:subClassOf :Cl_Occurrence ;
    # Definition of Cl_PerformanceOccurrence using an equivalent class axiom:
    # A Performance Occurrence is an Occurrence that must concern a Performance and must have a date/time.
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Cl_Occurrence
            [ rdf:type owl:Restriction ;
              owl:onProperty :op_concernsPerformance ;
              owl:someValuesFrom :Cl_Performance ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :dp_atDateTime ;
              owl:someValuesFrom xsd:dateTime ]
        )
    ] .

# General Class Axioms (Additional restrictions for Cl_PerformanceOccurrence)
# Every Cl_PerformanceOccurrence must concern exactly one Cl_Performance.
:Cl_PerformanceOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :op_concernsPerformance ;
    owl:cardinality 1 ;
    rdfs:comment "Every Performance Occurrence must be associated with exactly one specific Performance."
] .

# Every Cl_PerformanceOccurrence must have exactly one dp_atDateTime.
:Cl_PerformanceOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :dp_atDateTime ;
    owl:cardinality 1 ;
    rdfs:comment "Every Performance Occurrence must have exactly one date and time specified for its occurrence."
] .

#################################################################
#    Object Properties
#################################################################

:op_concernsPerformance rdf:type owl:ObjectProperty ;
    rdfs:label "concerns performance" ;
    rdfs:comment "Links an instance of Cl_PerformanceOccurrence to the specific Cl_Performance that is taking place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Performance .

#################################################################
#    Data Properties
#################################################################

:dp_atDateTime rdf:type owl:DatatypeProperty ;
    rdfs:label "at date time" ;
    rdfs:comment "Specifies the precise date and time at which a Cl_PerformanceOccurrence takes place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range xsd:dateTime .
@prefix : <http://www.example.org/musicontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Event" .

:Cl_Performance rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Performance" ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasPerformanceEvent ;
        owl:someValuesFrom :Cl_PerformanceSongEvent
    ] .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Musical Work" .

:Cl_Song rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:label "Song" ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :isFeaturedInEvent ;
        owl:someValuesFrom :Cl_PerformanceSongEvent
    ] .

# Reification/Pivot Class for "What songs were played in a certain performance?"
:Cl_PerformanceSongEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Performance Song Event" ;
    rdfs:comment "Represents a specific instance of a song being played within a performance, acting as a pivot between a performance and a song." ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :referencesPerformance ;
        owl:allValuesFrom :Cl_Performance
    ] ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :featuresSong ;
        owl:allValuesFrom :Cl_Song
    ] .

#################################################################
#    Properties
#################################################################

### Object Properties ###

:hasPerformanceEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceSongEvent ;
    rdfs:label "has performance event" ;
    rdfs:comment "Connects a performance to a specific event of a song being played within it." .

:referencesPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PerformanceSongEvent ;
    rdfs:range :Cl_Performance ;
    rdfs:label "references performance" ;
    rdfs:comment "Links a PerformanceSongEvent to the specific Performance it is part of." ;
    owl:inverseOf :hasPerformanceEvent .

:featuresSong rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PerformanceSongEvent ;
    rdfs:range :Cl_Song ;
    rdfs:label "features song" ;
    rdfs:comment "Indicates which song was played in a particular PerformanceSongEvent." .

:isFeaturedInEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Song ;
    rdfs:range :Cl_PerformanceSongEvent ;
    rdfs:label "is featured in event" ;
    rdfs:comment "Indicates the PerformanceSongEvent(s) a song was played in." ;
    owl:inverseOf :featuresSong .

### Data Properties ###

:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_MusicalWork ;
    rdfs:range xsd:string ;
    rdfs:label "has title" .

:hasDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range xsd:date ;
    rdfs:label "has date" .

:hasLocation rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range xsd:string ;
    rdfs:label "has location" .
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology Declaration
:performanceOntology a owl:Ontology ;
    rdfs:comment "Ontology for representing performances and their locations, structured to answer 'Where did a certain performance take place?' using reification." ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# ---------------------------------------------------
# Classes
# ---------------------------------------------------

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class for anything in the ontology." .

:Cl_Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general class for any happening or occurrence." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A type of event involving action or performance." ;
    rdfs:subClassOf :Cl_Event .

:Cl_Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A class representing an artistic or public presentation, e.g., a concert, play, or dance." ;
    rdfs:subClassOf :Cl_Activity .

:Cl_Concert a owl:Class ;
    rdfs:label "Concert" ;
    rdfs:comment "A live musical performance." ;
    rdfs:subClassOf :Cl_Performance .

:Cl_Play a owl:Class ;
    rdfs:label "Play" ;
    rdfs:comment "A theatrical performance." ;
    rdfs:subClassOf :Cl_Performance .

:Cl_DancePerformance a owl:Class ;
    rdfs:label "Dance Performance" ;
    rdfs:comment "A performance featuring dance." ;
    rdfs:subClassOf :Cl_Performance .

:Cl_Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A general class for any physical location." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A class representing a physical place or venue where events can occur." ;
    rdfs:subClassOf :Cl_Place .

:Cl_Venue a owl:Class ;
    rdfs:label "Venue" ;
    rdfs:comment "A place where a public event or meeting is held." ;
    rdfs:subClassOf :Cl_Location .

:Cl_Theatre a owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:comment "A building or outdoor area in which plays and other dramatic performances are given." ;
    rdfs:subClassOf :Cl_Venue .

:Cl_ConcertHall a owl:Class ;
    rdfs:label "Concert Hall" ;
    rdfs:comment "A building or part of a building specifically designed for musical concerts." ;
    rdfs:subClassOf :Cl_Venue .

:Cl_OutdoorVenue a owl:Class ;
    rdfs:label "Outdoor Venue" ;
    rdfs:comment "A venue situated outdoors." ;
    rdfs:subClassOf :Cl_Location .

# Pivot Class for reification: Cl_PerformanceOccurrence
# This class acts as an intermediary for the "performance took place at location" relationship.
:Cl_PerformanceOccurrence a owl:Class ;
    rdfs:label "Performance Occurrence" ;
    rdfs:comment "Represents a specific instance of a performance happening at a particular location and potentially at a specific time. This reifies the 'takes place' action, allowing for additional details about the event itself." ;
    rdfs:subClassOf :Cl_Event .

# General Class Axioms / Restrictions for Cl_PerformanceOccurrence
# Every Performance Occurrence must be associated with a Performance
:Cl_PerformanceOccurrence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :op_hasPerformance ;
    owl:someValuesFrom :Cl_Performance ;
    rdfs:comment "Ensures every Cl_PerformanceOccurrence is linked to at least one Cl_Performance."
] .

# Every Performance Occurrence must be associated with a Location
:Cl_PerformanceOccurrence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :op_atLocation ;
    owl:someValuesFrom :Cl_Location ;
    rdfs:comment "Ensures every Cl_PerformanceOccurrence is linked to at least one Cl_Location."
] .

# Disjointness axioms for classes
:Cl_Concert owl:disjointWith :Cl_Play .
:Cl_Concert owl:disjointWith :Cl_DancePerformance .
:Cl_Play owl:disjointWith :Cl_DancePerformance .
:Cl_Theatre owl:disjointWith :Cl_ConcertHall .

# ---------------------------------------------------
# Properties
# ---------------------------------------------------

# Object Properties

:op_hasPerformance a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has performance" ;
    rdfs:comment "Connects a Performance Occurrence to the specific Performance (the work/concept) that was presented." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Performance .

:op_atLocation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "at location" ;
    rdfs:comment "Connects a Performance Occurrence to the Location (venue) where it took place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Location .

# Inverse Property for op_atLocation
:op_featuresOccurrence a owl:ObjectProperty ;
    rdfs:label "features occurrence" ;
    rdfs:comment "Connects a Location to a Performance Occurrence that happened there." ;
    rdfs:domain :Cl_Location ;
    rdfs:range :Cl_PerformanceOccurrence ;
    owl:inverseOf :op_atLocation .

# Inverse Property for op_hasPerformance
:op_isInstanceOfPerformance a owl:ObjectProperty ;
    rdfs:label "is instance of performance" ;
    rdfs:comment "Connects a Performance (the conceptual work) to the specific Performance Occurrence instances (its showings) it has." ;
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceOccurrence ;
    owl:inverseOf :op_hasPerformance .

# Data Properties

:dp_performanceName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "performance name" ;
    rdfs:comment "The official name or title of the performance." ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:string .

:dp_locationName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "location name" ;
    rdfs:comment "The common name of the location or venue." ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:dp_locationAddress a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "location address" ;
    rdfs:comment "The physical address of the location or venue." ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:dp_occurrenceDateTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "occurrence date and time" ;
    rdfs:comment "The specific date and time when this particular performance occurrence took place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range xsd:dateTime .

@prefix : <http://www.semanticweb.org/ontology/geography#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/ontology/geography#> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/ontology/geography#Cl_City
:Cl_City rdf:type owl:Class ;
         rdfs:subClassOf :Cl_PopulatedPlace .

###  http://www.semanticweb.org/ontology/geography#Cl_GeographicalEntity
:Cl_GeographicalEntity rdf:type owl:Class ;
                       rdfs:comment "A general class for any entity that has a geographical location or extent." .

###  http://www.semanticweb.org/ontology/geography#Cl_Location
:Cl_Location rdf:type owl:Class ;
             rdfs:subClassOf :Cl_GeographicalEntity ;
             rdfs:comment "A class representing a specific point or area on Earth." .

###  http://www.semanticweb.org/ontology/geography#Cl_Place
:Cl_Place rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Location .

###  http://www.semanticweb.org/ontology/geography#Cl_PopulatedPlace
:Cl_PopulatedPlace rdf:type owl:Class ;
                   rdfs:subClassOf :Cl_Place ;
                   owl:disjointWith :Cl_Region .

###  http://www.semanticweb.org/ontology/geography#Cl_Region
:Cl_Region rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Location ;
          rdfs:comment "A class representing a larger geographical area, often encompassing multiple cities or other places." .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/ontology/geography#isLocatedInRegion
:isLocatedInRegion rdf:type owl:ObjectProperty ;
                   rdfs:domain :Cl_City ;
                   rdfs:range :Cl_Region ;
                   rdfs:comment "Relates a city to the region it is geographically located within." .

###  http://www.semanticweb.org/ontology/geography#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :Cl_Region ;
         rdfs:range :Cl_Location ;
         owl:inverseOf :isPartOf .

###  http://www.semanticweb.org/ontology/geography#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Cl_Location ;
          rdfs:range :Cl_Region ;
          rdfs:subPropertyOf :isLocatedInRegion ; # A city being in a region implies it's part of it.
          rdfs:comment "Relates a geographical entity to a larger region it is part of." .

#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/ontology/geography#hasCityName
:hasCityName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Cl_City ;
             rdfs:range xsd:string ;
             rdfs:comment "The name of a city." .

###  http://www.semanticweb.org/ontology/geography#hasRegionName
:hasRegionName rdf:type owl:DatatypeProperty ;
                rdfs:domain :Cl_Region ;
                rdfs:range xsd:string ;
                rdfs:comment "The name of a region." .
@prefix : <http://www.semanticweb.org/myontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/myontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://www.semanticweb.org/myontology/1.0.0> ;
    rdfs:comment "Ontology for geographical regions and countries to answer 'In what country is a certain region located?'" .

#################################################################
#    Classes
#################################################################

:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:label "Geographical Entity" ;
    rdfs:comment "The most general class for any entity with a geographical presence." .

:Cl_Location rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity ;
    rdfs:label "Location" ;
    rdfs:comment "A class representing any identifiable location or place." .

:Cl_AdministrativeDivision rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:label "Administrative Division" ;
    rdfs:comment "A class representing an area of a country or other region delineated for the purpose of administration." .

:Cl_Country rdf:type owl:Class ;
    rdfs:subClassOf :Cl_AdministrativeDivision ;
    rdfs:label "Country" ;
    rdfs:comment "A sovereign state or nation, often comprising several administrative divisions." .

:Cl_Region rdf:type owl:Class ;
    rdfs:subClassOf :Cl_AdministrativeDivision ;
    rdfs:label "Region" ;
    rdfs:comment "A specific area within a country or larger geographical entity, often with distinct characteristics or administration." .

#################################################################
#    Object Properties
#################################################################

:hasAdministrativeDivision rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Country ;
    rdfs:range :Cl_AdministrativeDivision ;
    rdfs:label "has administrative division" ;
    rdfs:comment "Relates a country to its administrative divisions." .

:isAdministrativeDivisionOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasAdministrativeDivision ;
    rdfs:domain :Cl_AdministrativeDivision ;
    rdfs:range :Cl_Country ;
    rdfs:label "is administrative division of" ;
    rdfs:comment "Relates an administrative division to its parent country." .

:isLocatedInCountry rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :isAdministrativeDivisionOf ;
    rdf:type owl:FunctionalProperty ; # A region is typically located in one country
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_Country ;
    rdfs:label "is located in country" ;
    rdfs:comment "Explicitly links a region to the country it is located within, answering the competency question." .

#################################################################
#    Data Properties
#################################################################

:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_GeographicalEntity ;
    rdfs:range xsd:string ;
    rdfs:label "has name" ;
    rdfs:comment "Provides the common name for a geographical entity." .

:hasCode rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_AdministrativeDivision ;
    rdfs:range xsd:string ;
    rdfs:label "has code" ;
    rdfs:comment "Provides a short code or identifier for an administrative division (e.g., ISO code)." .

#################################################################
#    Restrictions and Axioms
#################################################################

# Every Cl_Region must be located in exactly one Cl_Country.
:Cl_Region rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedInCountry ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Country ;
    rdfs:comment "Ensures that every region is associated with one and only one country."
] .

# A Cl_Country must have at least one name.
:Cl_Country rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every country has a name."
] .

# A Cl_Region must have at least one name.
:Cl_Region rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every region has a name."
] .
@prefix : <http://www.semanticweb.org/ontology/records#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/ontology/records> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

:Cl_Record rdf:type owl:Class ;
    rdfs:comment "Represents a musical record or album." .

:Cl_Track rdf:type owl:Class ;
    rdfs:comment "Represents an individual track or song on a record." .

#################################################################
#    Object Properties
#################################################################

:hasTrack rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_Track ;
    rdfs:comment "Connects a record to its constituent tracks." .

#################################################################
#    Restrictions
#################################################################

:Cl_Record rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTrack ;
                              owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                              rdfs:comment "A record must contain at least one track."
                            ] .