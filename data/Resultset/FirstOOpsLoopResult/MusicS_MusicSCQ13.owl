@prefix : <http://www.semanticweb.org/ontology/geography#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/ontology/geography#> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/ontology/geography#Cl_City
:Cl_City rdf:type owl:Class ;
         rdfs:subClassOf :Cl_PopulatedPlace .

###  http://www.semanticweb.org/ontology/geography#Cl_GeographicalEntity
:Cl_GeographicalEntity rdf:type owl:Class ;
                       rdfs:comment "A general class for any entity that has a geographical location or extent." .

###  http://www.semanticweb.org/ontology/geography#Cl_Location
:Cl_Location rdf:type owl:Class ;
             rdfs:subClassOf :Cl_GeographicalEntity ;
             rdfs:comment "A class representing a specific point or area on Earth." .

###  http://www.semanticweb.org/ontology/geography#Cl_Place
:Cl_Place rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Location .

###  http://www.semanticweb.org/ontology/geography#Cl_PopulatedPlace
:Cl_PopulatedPlace rdf:type owl:Class ;
                   rdfs:subClassOf :Cl_Place ;
                   owl:disjointWith :Cl_Region .

###  http://www.semanticweb.org/ontology/geography#Cl_Region
:Cl_Region rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Location ;
          rdfs:comment "A class representing a larger geographical area, often encompassing multiple cities or other places." .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/ontology/geography#isLocatedInRegion
:isLocatedInRegion rdf:type owl:ObjectProperty ;
                   rdfs:domain :Cl_City ;
                   rdfs:range :Cl_Region ;
                   rdfs:comment "Relates a city to the region it is geographically located within." .

###  http://www.semanticweb.org/ontology/geography#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :Cl_Region ;
         rdfs:range :Cl_Location ;
         owl:inverseOf :isPartOf .

###  http://www.semanticweb.org/ontology/geography#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Cl_Location ;
          rdfs:range :Cl_Region ;
          rdfs:subPropertyOf :isLocatedInRegion ; # A city being in a region implies it's part of it.
          rdfs:comment "Relates a geographical entity to a larger region it is part of." .

#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/ontology/geography#hasCityName
:hasCityName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Cl_City ;
             rdfs:range xsd:string ;
             rdfs:comment "The name of a city." .

###  http://www.semanticweb.org/ontology/geography#hasRegionName
:hasRegionName rdf:type owl:DatatypeProperty ;
                rdfs:domain :Cl_Region ;
                rdfs:range xsd:string ;
                rdfs:comment "The name of a region." .