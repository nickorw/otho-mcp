@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.com/ontology#> .

<http://example.com/ontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://example.com/ontology/1.0> ;
    rdfs:comment "Ontology for music tracks and musical works, focusing on reification for recording relationships." .

#################################################################
#    Classes
#################################################################

ex:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:label "Creative Work" ;
    rdfs:comment "A generic class for any creative work, such as a musical composition or an artistic performance." .

ex:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf ex:Cl_CreativeWork ;
    rdfs:label "Musical Work" ;
    rdfs:comment "Represents an abstract musical composition or song, distinct from any specific recording of it." .

ex:Cl_AudioRecording rdf:type owl:Class ;
    rdfs:subClassOf ex:Cl_CreativeWork ;
    rdfs:label "Audio Recording" ;
    rdfs:comment "Represents a specific recorded audio track, an instance of a musical work." .

ex:Cl_RecordingInstance rdf:type owl:Class ;
    rdfs:comment "A pivot class representing a specific instance of an Audio Recording being a recording of a Musical Work. This reifies the 'is a recording of' relationship, allowing for additional properties about the recording event itself." ;
    rdfs:label "Recording Instance" .

#################################################################
#    Object Properties
#################################################################

ex:hasRecordingInstance rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cl_AudioRecording ;
    rdfs:range ex:Cl_RecordingInstance ;
    rdfs:label "has recording instance" ;
    rdfs:comment "Connects an Audio Recording to its specific Recording Instance (the reified relationship)." .

ex:isInstanceOfMusicalWork rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cl_RecordingInstance ;
    rdfs:range ex:Cl_MusicalWork ;
    rdfs:label "is instance of musical work" ;
    rdfs:comment "Connects a Recording Instance to the Musical Work it documents or represents." .

ex:isRecordingOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cl_AudioRecording ;
    rdfs:range ex:Cl_MusicalWork ;
    rdfs:label "is recording of" ;
    rdfs:comment "Directly relates an Audio Recording to the Musical Work it records. This property's semantics are captured by the property chain involving Cl_RecordingInstance." ;
    owl:propertyChainAxiom ( ex:hasRecordingInstance ex:isInstanceOfMusicalWork ) . # This axiom enables direct querying for the competency question using the reified structure.

#################################################################
#    Data Properties
#################################################################

ex:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Cl_CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:label "has title" ;
    rdfs:comment "The title of a creative work." .

ex:hasDurationSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Cl_AudioRecording ;
    rdfs:range xsd:integer ;
    rdfs:label "has duration in seconds" ;
    rdfs:comment "The duration of an audio recording in seconds." .

#################################################################
#    Restrictions and Axioms
#################################################################

# Every AudioRecording must have at least one RecordingInstance.
ex:Cl_AudioRecording rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:hasRecordingInstance ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "An Audio Recording must be associated with at least one Recording Instance."
] .

# Every RecordingInstance must be an instance of exactly one Musical Work.
ex:Cl_RecordingInstance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:isInstanceOfMusicalWork ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "A Recording Instance must refer to exactly one Musical Work."
] .

# An Audio Recording must be a recording of some Musical Work. This is a soft restriction, ensured by the property chain.
ex:Cl_AudioRecording rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:isRecordingOf ;
    owl:someValuesFrom ex:Cl_MusicalWork ;
    rdfs:comment "Every Audio Recording is a recording of at least one Musical Work."
] .