@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology Declaration
:ontology rdf:type owl:Ontology ;
    owl:imports <http://www.w3.org/2002/07/owl> .

# Classes
Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" .

Cl_City rdf:type owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf Cl_Location .

Cl_GeographicalFeature rdf:type owl:Class ;
    rdfs:label "Geographical Feature" ;
    rdfs:subClassOf Cl_Location .

Cl_ManMadeStructure rdf:type owl:Class ;
    rdfs:label "Man-made Structure" .

Cl_Building rdf:type owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf Cl_ManMadeStructure .

Cl_CulturalVenue rdf:type owl:Class ;
    rdfs:label "Cultural Venue" ;
    rdfs:subClassOf Cl_Building .

Cl_Theatre rdf:type owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:subClassOf Cl_CulturalVenue .

# Disjoint Classes
Cl_GeographicalFeature owl:disjointWith Cl_ManMadeStructure .
Cl_City owl:disjointWith Cl_ManMadeStructure . # A city is a location, not a single man-made structure.

# Properties

# Object Property: isLocatedIn
# Connects a Cl_ManMadeStructure (like a Cl_Theatre or Cl_Building) to a Cl_City.
isLocatedIn rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "is located in" ;
    rdfs:domain Cl_ManMadeStructure ;
    rdfs:range Cl_City .

# Data Property: cityName
# Provides the name of a city.
cityName rdf:type owl:DatatypeProperty ;
    rdfs:label "city name" ;
    rdfs:domain Cl_City ;
    rdfs:range xsd:string .

# Data Property: hasAddress
# Provides the street address for a building.
hasAddress rdf:type owl:DatatypeProperty ;
    rdfs:label "has address" ;
    rdfs:domain Cl_Building ;
    rdfs:range xsd:string .

# Inverse Property: hostsStructure
# A city hosts a man-made structure (inverse of isLocatedIn)
hostsStructure rdf:type owl:ObjectProperty ;
    rdfs:label "hosts structure" ;
    rdfs:domain Cl_City ;
    rdfs:range Cl_ManMadeStructure ;
    owl:inverseOf :isLocatedIn .

# General Class Axiom: Every Cl_Theatre must be located in at least one Cl_City.
Cl_Theatre rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedIn ;
    owl:someValuesFrom Cl_City
] .

# General Class Axiom: Every Cl_City must host at least one Cl_ManMadeStructure.
Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hostsStructure ;
    owl:someValuesFrom Cl_ManMadeStructure
] .