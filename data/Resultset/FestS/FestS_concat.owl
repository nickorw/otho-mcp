@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Event rdf:type owl:Class ;
    rdfs:comment "Represents any general event or happening." .

:Cl_Festival rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:comment "Represents a collection of events or performances, typically celebrated periodically." .

:Cl_TheatreFestival rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Festival ;
    rdfs:comment "Represents a specific type of festival focused on theatrical performances and related activities." .

:Cl_FestivalOccurrence rdf:type owl:Class ;
    rdfs:comment "A pivot class representing a specific instance or period during which a festival took place, used for reification to capture temporal details." .

# Properties

# Object Property: Linking a festival to its occurrence(s)
:hasOccurrence rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_TheatreFestival ;
    rdfs:range :Cl_FestivalOccurrence ;
    rdfs:comment "Links a theatre festival (concept) to a specific instance of its taking place." .

# Object Property: Linking an occurrence back to its festival
:isOccurrenceOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FestivalOccurrence ;
    rdfs:range :Cl_TheatreFestival ;
    owl:inverseOf :hasOccurrence ;
    owl:functional true ; # Each specific occurrence belongs to one unique theatre festival concept.
    rdfs:comment "Links a specific festival occurrence instance back to the theatre festival it represents." .

# Data Property: Specifying the start date of an occurrence
:hasStartDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_FestivalOccurrence ;
    rdfs:range xsd:date ;
    owl:functional true ; # Each occurrence has exactly one start date.
    rdfs:comment "Specifies the calendar start date of a festival occurrence." .

# Data Property: Specifying the end date of an occurrence
:hasEndDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_FestivalOccurrence ;
    rdfs:range xsd:date ;
    owl:functional true ; # Each occurrence has exactly one end date.
    rdfs:comment "Specifies the calendar end date of a festival occurrence." .

# General Class Axioms (Restrictions)

# Every Cl_FestivalOccurrence must be an occurrence of some Cl_TheatreFestival
[ rdf:type owl:Restriction ;
  owl:onProperty :isOccurrenceOf ;
  owl:someValuesFrom :Cl_TheatreFestival ;
  rdfs:subClassOf :Cl_FestivalOccurrence
] .

# Every Cl_FestivalOccurrence must have a start date
[ rdf:type owl:Restriction ;
  owl:onProperty :hasStartDate ;
  owl:someValuesFrom xsd:date ;
  rdfs:subClassOf :Cl_FestivalOccurrence
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/festival-ontology#> .

# Ontology Metadata
:festival-ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for representing festivals and their occurrences." ;
    owl:versionIRI <http://example.org/festival-ontology/1.0> .

# Classes
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A top-level class for all conceptual entities in the ontology." .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Event" ;
    rdfs:comment "A class representing any type of event." .

:Cl_Festival rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Festival" ;
    rdfs:comment "Represents a specific type of cultural or celebratory event, typically recurring." ;
    # A festival must have at least one occurrence
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasOccurrence ;
        owl:someValuesFrom :Cl_FestivalOccurrence
    ] .

:Cl_Location rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Location" ;
    rdfs:comment "Represents a geographical place or venue." .

# Reification/Pivot Class for Festival Occurrence
:Cl_FestivalOccurrence rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ; # An occurrence is a specific instance of an event
    rdfs:label "Festival Occurrence" ;
    rdfs:comment "A pivot class representing a specific instance of a festival taking place at a particular location and time." ;
    # Definition of a FestivalOccurrence: it must occur at a location and be an occurrence of a festival.
    # Note: These equivalentClass axioms define Cl_FestivalOccurrence as exactly those things that fulfill these properties.
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :occursAtLocation ;
        owl:someValuesFrom :Cl_Location
    ] ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :isOccurrenceOf ;
        owl:someValuesFrom :Cl_Festival
    ] ;
    # An occurrence must be of a specific festival
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :isOccurrenceOf ;
        owl:someValuesFrom :Cl_Festival
    ] ;
    # An occurrence must have a location
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :occursAtLocation ;
        owl:someValuesFrom :Cl_Location
    ] .

# Properties

# Object Properties
:hasOccurrence rdf:type owl:ObjectProperty ;
    rdfs:label "has occurrence" ;
    rdfs:domain :Cl_Festival ;
    rdfs:range :Cl_FestivalOccurrence ;
    rdfs:comment "Links a festival to its specific occurrences." .

:isOccurrenceOf rdf:type owl:ObjectProperty ;
    rdfs:label "is occurrence of" ;
    rdfs:domain :Cl_FestivalOccurrence ;
    rdfs:range :Cl_Festival ;
    owl:inverseOf :hasOccurrence ;
    owl:propertyCharacteristic owl:FunctionalProperty ; # Each occurrence belongs to one specific festival
    rdfs:comment "Links a festival occurrence back to the festival it is an instance of." .

:occursAtLocation rdf:type owl:ObjectProperty ;
    rdfs:label "occurs at location" ;
    rdfs:domain :Cl_FestivalOccurrence ;
    rdfs:range :Cl_Location ;
    owl:propertyCharacteristic owl:FunctionalProperty ; # Each occurrence happens at one primary location
    rdfs:comment "Links a festival occurrence to the location where it takes place." .

:locationOfOccurrence rdf:type owl:ObjectProperty ;
    rdfs:label "location of occurrence" ;
    rdfs:domain :Cl_Location ;
    rdfs:range :Cl_FestivalOccurrence ;
    owl:inverseOf :occursAtLocation ;
    rdfs:comment "Links a location to festival occurrences that happen there." .

# Data Properties
:festivalName rdf:type owl:DatatypeProperty ;
    rdfs:label "festival name" ;
    rdfs:domain :Cl_Festival ;
    rdfs:range xsd:string ;
    owl:propertyCharacteristic owl:FunctionalProperty ; # Each festival has one primary name
    rdfs:comment "The official name of the festival." .

:locationName rdf:type owl:DatatypeProperty ;
    rdfs:label "location name" ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string ;
    owl:propertyCharacteristic owl:FunctionalProperty ; # Each location has one primary name
    rdfs:comment "The common name of the location." .

:locationAddress rdf:type owl:DatatypeProperty ;
    rdfs:label "location address" ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string ;
    owl:propertyCharacteristic owl:FunctionalProperty ; # Each location has one primary address
    rdfs:comment "The street address of the location." .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/theatre_ontology#> .

# Classes
:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general category for any organized occurrence or happening." .

:Cl_Festival rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Festival" ;
    rdfs:comment "A specific type of event, often recurring annually, celebrating a particular theme." .

:Cl_TheatreFestival rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Festival ;
    rdfs:label "Theatre Festival" ;
    rdfs:comment "A festival specifically dedicated to theatrical performances." .

:Cl_ArtisticWork rdf:type owl:Class ;
    rdfs:label "Artistic Work" ;
    rdfs:comment "A creative product or endeavor." .

:Cl_Performance rdf:type owl:Class ;
    rdfs:subClassOf :Cl_ArtisticWork ;
    rdfs:label "Performance" ;
    rdfs:comment "An artistic work that is presented or acted out." .

:Cl_Play rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Performance ;
    rdfs:label "Play" ;
    rdfs:comment "A dramatic work for the stage." .

:Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A specific place or venue where events or performances occur." .

# Reification Class for 'What plays could be seen during a certain theatre festival?'
# This class acts as a pivot to link a specific play with a specific festival instance,
# capturing the nuanced relationship of a play being presented/seen as part of a festival.
:Cl_FestivalPerformance rdf:type owl:Class ;
    rdfs:label "Festival Performance" ;
    rdfs:comment "Represents a specific instance of a play being performed as part of a theatre festival, capturing the relationship between a play and a festival at a particular time or event slot." .

# Object Properties
:hasPart rdf:type owl:ObjectProperty ;
    rdfs:label "has part" ;
    rdfs:comment "A general property indicating that one entity is composed of or contains another." .

:includesPerformance rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasPart ;
    rdfs:domain :Cl_TheatreFestival ;
    rdfs:range :Cl_FestivalPerformance ;
    rdfs:label "includes performance" ;
    rdfs:comment "Connects a theatre festival to a specific performance instance within it." ;
    owl:inverseOf :isPerformanceIncludedIn .

:isPerformanceIncludedIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FestivalPerformance ;
    rdfs:range :Cl_TheatreFestival ;
    rdfs:label "is performance included in" ;
    rdfs:comment "The inverse property of 'includes performance'." .

:refersToPlay rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FestivalPerformance ;
    rdfs:range :Cl_Play ;
    rdfs:label "refers to play" ;
    rdfs:comment "Links a festival performance instance to the specific play that is being performed." ;
    owl:inverseOf :isSubjectOfPerformance .

:isSubjectOfPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Play ;
    rdfs:range :Cl_FestivalPerformance ;
    rdfs:label "is subject of performance" ;
    rdfs:comment "The inverse property of 'refers to play'." .

:occursDuringFestival rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FestivalPerformance ;
    rdfs:range :Cl_TheatreFestival ;
    rdfs:label "occurs during festival" ;
    rdfs:comment "Connects a specific performance at a festival to the theatre festival it belongs to." ;
    owl:inverseOf :hostsPerformance .

:hostsPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_TheatreFestival ;
    rdfs:range :Cl_FestivalPerformance ;
    rdfs:label "hosts performance" ;
    rdfs:comment "The inverse property of 'occurs during festival'." .

:takesPlaceAt rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range :Cl_Location ;
    rdfs:label "takes place at" ;
    rdfs:comment "Indicates the physical location where an event or performance occurs." .

# Data Properties
:festivalName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Festival ;
    rdfs:range xsd:string ;
    rdfs:label "festival name" ;
    rdfs:comment "The official name of the festival." ;
    owl:functionalProperty true .

:festivalStartDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Festival ;
    rdfs:range xsd:date ;
    rdfs:label "festival start date" ;
    rdfs:comment "The date when the festival begins." ;
    owl:functionalProperty true .

:festivalEndDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Festival ;
    rdfs:range xsd:date ;
    rdfs:label "festival end date" ;
    rdfs:comment "The date when the festival concludes." ;
    owl:functionalProperty true .

:playTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Play ;
    rdfs:range xsd:string ;
    rdfs:label "play title" ;
    rdfs:comment "The title of the play." ;
    owl:functionalProperty true .

:playDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Play ;
    rdfs:range xsd:duration ;
    rdfs:label "play duration" ;
    rdfs:comment "The typical running time of the play." .

:locationName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string ;
    rdfs:label "location name" ;
    rdfs:comment "The name of the location or venue." ;
    owl:functionalProperty true .

:performanceDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_FestivalPerformance ;
    rdfs:range xsd:date ;
    rdfs:label "performance date" ;
    rdfs:comment "The specific date on which a play is performed at the festival." .

:performanceTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_FestivalPerformance ;
    rdfs:range xsd:time ;
    rdfs:label "performance time" ;
    rdfs:comment "The specific time at which a play performance begins at the festival." .

# General Class Axioms / Restrictions
# Every TheatreFestival must have a name
:Cl_TheatreFestival rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :festivalName ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Every Play must have a title
:Cl_Play rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :playTitle ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# A FestivalPerformance must always refer to a specific Play
:Cl_FestivalPerformance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToPlay ;
    owl:someValuesFrom :Cl_Play
] .

# A FestivalPerformance must always occur during a specific TheatreFestival
:Cl_FestivalPerformance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :occursDuringFestival ;
    owl:someValuesFrom :Cl_TheatreFestival
] .
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/ontology> rdf:type owl:Ontology ;
                                owl:imports <http://www.w3.org/2002/07/owl> .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

:Cl_Location rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Location" .

:Cl_City rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:label "City" .

:Cl_Structure rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Structure" .

:Cl_Building rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Structure ;
    rdfs:label "Building" .

:Cl_Theatre rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Building ;
    rdfs:label "Theatre" .

#################################################################
#    Properties
#################################################################

:hasName rdf:type owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:domain :Cl_Entity ;
    rdfs:range xsd:string .

:cityName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_City ;
    rdfs:range xsd:string ;
    rdfs:label "city name" .

:theatreName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Theatre ;
    rdfs:range xsd:string ;
    rdfs:label "theatre name" .

:isLocatedIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Structure ;
    rdfs:range :Cl_Location ;
    rdfs:label "is located in" .

:locatedInCity rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :isLocatedIn ;
    rdfs:domain :Cl_Theatre ;
    rdfs:range :Cl_City ;
    rdfs:label "located in city" .

#################################################################
#    Restrictions
#################################################################

:Cl_City rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :cityName ;
                              owl:someValuesFrom xsd:string
                            ] .

:Cl_Theatre rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :theatreName ;
                                owl:someValuesFrom xsd:string
                              ] ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :locatedInCity ;
                                owl:someValuesFrom :Cl_City
                              ] .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Place rdf:type owl:Class .

:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Place .

:Cl_Settlement rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity .

:Cl_City rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Settlement .

:Cl_PoliticalEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity .

:Cl_Country rdf:type owl:Class ;
    rdfs:subClassOf :Cl_PoliticalEntity .

# Disjointness axioms
:Cl_Settlement owl:disjointWith :Cl_PoliticalEntity .
:Cl_City owl:disjointWith :Cl_Country .

# Properties
:hasLocationCountry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_City ;
    rdfs:range :Cl_Country ;
    owl:inverseOf :isLocationOfCity ;
    rdf:type owl:FunctionalProperty .

:isLocationOfCity rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Country ;
    rdfs:range :Cl_City .

# General Class Axioms / Restrictions
# Every Cl_City must be located in at least one Cl_Country.
:Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasLocationCountry ;
    owl:someValuesFrom :Cl_Country
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Work rdf:type owl:Class ;
    rdfs:label "Work" .

:Cl_Play rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Work ;
    rdfs:label "Play" .

:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" .

:Cl_Production rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Production" .

# Properties
:hasBasisPlay rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Production ;
    rdfs:range :Cl_Play ;
    rdfs:label "has basis play" .

# No reification is applied here as the competency question "What play is the basis of this production?"
# involves a direct binary relationship between Cl_Production and Cl_Play, without additional entities or datatypes
# requiring an intermediary class.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.ontology.org/example#> .

####################
# Classes
####################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class for anything that exists." .

:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Agent" ;
    rdfs:comment "An entity capable of action or participation." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:label "Person" ;
    rdfs:comment "A human being." .

:Cl_Group rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Group" ;
    rdfs:comment "A collection of individuals." .

:Cl_Ensemble rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Group ;
    rdfs:label "Ensemble" ;
    rdfs:comment "A group of individuals performing together, typically in music or theater." ;
    owl:disjointWith :Cl_Person .

# Pivot Class for Reification: Cl_Membership
:Cl_Membership rdf:type owl:Class ;
    rdfs:label "Membership" ;
    rdfs:comment "A reified class representing a person's temporal association or role within an ensemble." .

####################
# Object Properties
####################

:hasParticipant rdf:type owl:ObjectProperty ;
    rdfs:label "has participant" ;
    rdfs:comment "A general property indicating that something has a participant." .

:hasMember rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParticipant ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_Person ;
    rdfs:label "has member" ;
    rdfs:comment "Connects a Membership instance to the Person who is the member." .

:isMemberOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasMember ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_Membership ;
    rdfs:label "is member of" ;
    rdfs:comment "Inverse of hasMember, connecting a Person to their Membership instance." .

:relatedToGroup rdf:type owl:ObjectProperty ;
    rdfs:label "related to group" ;
    rdfs:comment "A general property indicating an association with a group." .

:ofEnsemble rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :relatedToGroup ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_Ensemble ;
    rdfs:label "of ensemble" ;
    rdfs:comment "Connects a Membership instance to the Ensemble to which the membership applies." .

:hasMembership rdf:type owl:ObjectProperty ;
    owl:inverseOf :ofEnsemble ;
    rdfs:domain :Cl_Ensemble ;
    rdfs:range :Cl_Membership ;
    rdfs:label "has membership" ;
    rdfs:comment "Inverse of ofEnsemble, connecting an Ensemble to its Membership instance(s)." .

####################
# Data Properties
####################

:hasTime rdf:type owl:DatatypeProperty ;
    rdfs:label "has time" ;
    rdfs:comment "A general property indicating a temporal attribute." .

:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasTime ;
    rdfs:domain :Cl_Membership ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has start time" ;
    rdfs:comment "The specific date and time when the membership began." ;
    a owl:FunctionalProperty .

:hasEndTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasTime ;
    rdfs:domain :Cl_Membership ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has end time" ;
    rdfs:comment "The specific date and time when the membership ended (optional)." ;
    a owl:FunctionalProperty .

####################
# General Class Axioms / Restrictions
####################

# Every Cl_Membership instance must be associated with a Cl_Person (member).
:Cl_Membership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMember ;
    owl:someValuesFrom :Cl_Person
] .

# Every Cl_Membership instance must be associated with a Cl_Ensemble.
:Cl_Membership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :ofEnsemble ;
    owl:someValuesFrom :Cl_Ensemble
] .

# Every Cl_Membership instance must have a start time.
:Cl_Membership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasStartTime ;
    owl:someValuesFrom xsd:dateTime
] .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology Metadata (Optional but good practice)
:ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for authors and their plays, addressing the competency question 'What plays did a certain author write?'" ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# Classes
:Cl_Person rdf:type owl:Class ;
    rdfs:label "Person" .

:Cl_Author rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Author" .

:Cl_LiteraryWork rdf:type owl:Class ;
    rdfs:label "Literary Work" .

:Cl_Play rdf:type owl:Class ;
    rdfs:subClassOf :Cl_LiteraryWork ;
    rdfs:label "Play" .

# Properties
# Object Properties
:hasWritten rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Author ;
    rdfs:range :Cl_Play ;
    rdfs:label "has written" .

:isWrittenBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasWritten ;
    rdfs:domain :Cl_Play ;
    rdfs:range :Cl_Author ;
    rdfs:label "is written by" ;
    owl:inverseFunctionalProperty true . # A play is typically written by a single primary author.

# Data Properties
:name rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    owl:functionalProperty true . # A person has one name.

:title rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_LiteraryWork ;
    rdfs:range xsd:string ;
    rdfs:label "title" ;
    owl:functionalProperty true . # A literary work has one title.

:birthYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Author ;
    rdfs:range xsd:integer ;
    rdfs:label "birth year" ;
    owl:functionalProperty true . # An author has one birth year.

:deathYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Author ;
    rdfs:range xsd:integer ;
    rdfs:label "death year" ;
    owl:functionalProperty true . # An author has one death year.

:publicationYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_LiteraryWork ;
    rdfs:range xsd:integer ;
    rdfs:label "publication year" ;
    owl:functionalProperty true . # A literary work has one publication year.

:genre rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Play ;
    rdfs:range xsd:string ;
    rdfs:label "genre" . # A play can belong to multiple genres.

# General Class Axioms and Restrictions
# A Play must have a title.
:Cl_Play rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :title ;
    owl:someValuesFrom xsd:string
] .

# A Play must be written by at least one Author.
:Cl_Play rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isWrittenBy ;
    owl:someValuesFrom :Cl_Author
] .

# An Author must have a name.
:Cl_Author rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :name ;
    owl:someValuesFrom xsd:string
] .

# An Author must have written at least one Literary Work (e.g., a Play).
:Cl_Author rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasWritten ;
    owl:someValuesFrom :Cl_LiteraryWork
] .
@prefix : <http://www.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ontology rdf:type owl:Ontology ;
    owl:versionIRI <http://www.example.org/ontology/1.0> ;
    rdfs:comment "Ontology for literary works, specifically addressing the time period when plays were written, employing reification for the writing event." .

# Classes
# Hierarchy: Cl_Work -> Cl_LiteraryWork -> Cl_Play

:Cl_Work rdf:type owl:Class ;
    rdfs:label "Work" ;
    rdfs:comment "A general class representing any intellectual or creative work." .

:Cl_LiteraryWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Work ;
    rdfs:label "Literary Work" ;
    rdfs:comment "A type of work that is literary in nature, such as novels, poems, or plays." .

:Cl_Play rdf:type owl:Class ;
    rdfs:subClassOf :Cl_LiteraryWork ;
    rdfs:label "Play" ;
    rdfs:comment "A specific type of literary work intended for theatrical performance." .

:Cl_TimePeriod rdf:type owl:Class ;
    rdfs:label "Time Period" ;
    rdfs:comment "A defined duration of time, possibly with a start and end date." .

# Reification Class for the Writing Event
:Cl_WritingEvent rdf:type owl:Class ;
    rdfs:label "Writing Event" ;
    rdfs:comment "A reification class representing the specific event of a literary work being written. It connects the work itself to the time period of its creation, allowing for detailed attribute modeling of the writing process." .

# Properties

# Data Properties for Cl_TimePeriod
:hasStartDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date ;
    rdfs:label "has start date" ;
    rdfs:comment "The specific start date of a time period." .

:hasEndDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date ;
    rdfs:label "has end date" ;
    rdfs:comment "The specific end date of a time period." .

# Object Properties related to Reification (Cl_WritingEvent)

:concernsWork rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_WritingEvent ;
    rdfs:range :Cl_LiteraryWork ;
    rdfs:label "concerns work" ;
    rdfs:comment "Connects a writing event to the literary work that was created or worked upon during that event." .

:occursDuring rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_WritingEvent ;
    rdfs:range :Cl_TimePeriod ;
    rdfs:label "occurs during" ;
    rdfs:comment "Connects a writing event to the time period in which it took place." .

# Direct Object Property to answer the Competency Question

:wasWrittenDuring rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Play ;
    rdfs:range :Cl_TimePeriod ;
    rdfs:label "was written during" ;
    rdfs:comment "Indicates the time period during which a play was written. This property can be understood as being reified by instances of Cl_WritingEvent." .

# Auxiliary property to link Cl_Play directly to its Cl_WritingEvent
:hasWritingEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Play ;
    rdfs:range :Cl_WritingEvent ;
    rdfs:label "has writing event" ;
    rdfs:comment "Links a play to the specific event instance of its creation (writing)." .

# Property Chain Axiom to relate the direct property to the reified event
# This axiom states that if a Play (P) has a Writing Event (E), and that Writing Event (E) occurs during a Time Period (T),
# then the Play (P) was written during that Time Period (T).
:wasWrittenDuring owl:propertyChainAxiom ( :hasWritingEvent :occursDuring ) .

# Restrictions
# Every Cl_WritingEvent must concern a literary work and occur during a time period.
:Cl_WritingEvent rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :concernsWork ;
      owl:someValuesFrom :Cl_LiteraryWork
    ] .

:Cl_WritingEvent rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :occursDuring ;
      owl:someValuesFrom :Cl_TimePeriod
    ] .
@prefix : <http://example.com/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ontology rdf:type owl:Ontology ;
    owl:versionIRI <http://example.com/ontology/1.0> ;
    rdfs:comment "Ontology for theatrical works, focusing on plays and acts, with reification to model the composition and order of acts within a play. Designed to answer the competency question: 'How many acts does a particular play contain?'." .

# Classes
# Top-level general classes to establish hierarchies
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class for anything that exists or is conceptualized in the ontology." .

:Cl_AbstractConcept rdf:type owl:Class ;
    rdfs:label "Abstract Concept" ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A class for concepts that are not physical objects, such as creative works or relationships." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:label "Creative Work" ;
    rdfs:subClassOf :Cl_AbstractConcept ;
    rdfs:comment "Represents any form of creative intellectual work, such as literature, music, or art." .

:Cl_Component rdf:type owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A general class for any distinguishable part or element of a larger whole." .

:Cl_RelationshipEvent rdf:type owl:Class ;
    rdfs:label "Relationship Event" ;
    rdfs:subClassOf :Cl_AbstractConcept ;
    rdfs:comment "A general class for reification instances that capture complex relationships or events involving multiple entities and/or datatypes." .

# Specific classes within the hierarchy
:Cl_Play rdf:type owl:Class ;
    rdfs:label "Play" ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "A dramatic work written for performance by actors, typically on a stage." .

:Cl_Act rdf:type owl:Class ;
    rdfs:label "Act" ;
    rdfs:subClassOf :Cl_Component ;
    rdfs:comment "A major division or unit of a play or opera, usually comprising several scenes." .

# Reification/Pivot Class for "How many acts does a particular play contain?"
# This class captures the specific instance of an Act being part of a Play and its order.
:Cl_PlayActComposition rdf:type owl:Class ;
    rdfs:label "Play Act Composition" ;
    rdfs:subClassOf :Cl_RelationshipEvent ;
    rdfs:comment "A pivot class representing the specific instance of an Act being composed within a Play, capturing its sequential order." .

# Class Axioms/Restrictions
# Every Play must have at least one composition entry for an Act, ensuring it's not an empty play in terms of acts.
:Cl_Play rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasCompositionEntry ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Every Play must have at least one PlayActComposition entry, indicating it contains at least one act."
] .

# Properties

# Data Properties
:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:label "has title" ;
    rdfs:domain :Cl_CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:comment "The title or name of a creative work." .

:hasActOrder rdf:type owl:DatatypeProperty ;
    rdfs:label "has act order" ;
    rdfs:domain :Cl_PlayActComposition ;
    rdfs:range xsd:integer ;
    owl:functionalProperty true ; # Each composition entry has a unique order number within its play
    rdfs:comment "The sequential order (e.g., 1 for Act I, 2 for Act II) of an Act within a specific Play composition." .

# Object Properties

# General Part-Whole Relationship Properties (for hierarchy)
:hasPart rdf:type owl:ObjectProperty ;
    rdfs:label "has part" ;
    rdfs:domain :Cl_Entity ;
    rdfs:range :Cl_Component ;
    rdfs:comment "A general property indicating that an entity comprises a component part." .

:isPartOf rdf:type owl:ObjectProperty ;
    rdfs:label "is part of" ;
    rdfs:domain :Cl_Component ;
    rdfs:range :Cl_Entity ;
    owl:inverseOf :hasPart ;
    rdfs:comment "A general property indicating that a component is part of a larger entity." .

# Properties related to reification for Play-Act relationship
:hasCompositionEntry rdf:type owl:ObjectProperty ;
    rdfs:label "has composition entry" ;
    rdfs:domain :Cl_Play ;
    rdfs:range :Cl_PlayActComposition ;
    rdfs:subPropertyOf :hasPart ; # A Play has a PlayActComposition entry as part of its structure
    rdfs:comment "Relates a Play to an instance of its PlayActComposition, detailing how an Act is included and ordered." .

:composesAct rdf:type owl:ObjectProperty ;
    rdfs:label "composes act" ;
    rdfs:domain :Cl_PlayActComposition ;
    rdfs:range :Cl_Act ;
    rdfs:comment "Relates a PlayActComposition entry to the specific Act (e.g., Act I, Act II) it describes." .

:isCompositionEntryForPlay rdf:type owl:ObjectProperty ;
    rdfs:label "is composition entry for play" ;
    rdfs:domain :Cl_PlayActComposition ;
    rdfs:range :Cl_Play ;
    owl:inverseOf :hasCompositionEntry ;
    rdfs:subPropertyOf :isPartOf ; # A PlayActComposition entry is part of a Play
    rdfs:comment "The inverse property of :hasCompositionEntry, linking a PlayActComposition entry back to its parent Play." .

:isComposedInPlayActComposition rdf:type owl:ObjectProperty ;
    rdfs:label "is composed in play act composition" ;
    rdfs:domain :Cl_Act ;
    rdfs:range :Cl_PlayActComposition ;
    owl:inverseOf :composesAct ;
    rdfs:comment "The inverse property of :composesAct, linking an Act to the PlayActComposition entry where it is specifically detailed." .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Occurrence a owl:Class ;
    rdfs:label "Occurrence" .

:Cl_Event a owl:Class ;
    rdfs:subClassOf :Cl_Occurrence ;
    rdfs:label "Event" .

:Cl_Work a owl:Class ;
    rdfs:label "Work" .

:Cl_Production a owl:Class ;
    rdfs:subClassOf :Cl_Work ;
    rdfs:label "Production" .

# Reification/Pivot Class for Premier event
:Cl_Premier a owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Premier" .

# Properties

# Object Properties
:isPremierOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Premier ;
    rdfs:range :Cl_Production ;
    rdfs:label "is premier of" ;
    owl:inverseOf :hasPremier .

:hasPremier a owl:ObjectProperty ;
    rdfs:domain :Cl_Production ;
    rdfs:range :Cl_Premier ;
    rdfs:label "has premier" ;
    a owl:FunctionalProperty . # A production typically has one primary premier event.

# Data Properties
:premieredOnDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Premier ;
    rdfs:range xsd:date ;
    rdfs:label "premiered on date" .

:productionTitle a owl:DatatypeProperty ;
    rdfs:domain :Cl_Production ;
    rdfs:range xsd:string ;
    rdfs:label "production title" .

# Restrictions

# Every Cl_Premier instance must be linked to a Cl_Production.
[ rdf:type owl:Restriction ;
  owl:onProperty :isPremierOf ;
  owl:someValuesFrom :Cl_Production ;
  rdfs:subClassOf :Cl_Premier
] .

# Every Cl_Premier instance must have a premieredOnDate.
[ rdf:type owl:Restriction ;
  owl:onProperty :premieredOnDate ;
  owl:someValuesFrom xsd:date ;
  rdfs:subClassOf :Cl_Premier
] .

# A Cl_Production must have at least one premier event.
[ rdf:type owl:Restriction ;
  owl:onProperty :hasPremier ;
  owl:someValuesFrom :Cl_Premier ;
  rdfs:subClassOf :Cl_Production
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Classes
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "A superclass for all primary entities in the domain." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A superclass for all creative works, such as productions, books, movies, etc." .

:Cl_Production rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "Represents a specific production, such as a play, film, or musical." .

:Cl_Organization rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A superclass for any organization." .

:Cl_Newspaper rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "Represents a newspaper organization that provides reviews and ratings." .

# Reification Class for the rating event
:Cl_RatingEvent rdf:type owl:Class ;
    rdfs:comment "A pivot class representing a specific instance of a newspaper giving a rating to a production." .

# Properties

# Data properties for basic entities
:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:comment "Links an organization to its name." .

:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:comment "Links a creative work to its title." .

# Properties for the reification class Cl_RatingEvent
:reviewsProduction rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_RatingEvent ;
    rdfs:range :Cl_Production ;
    rdfs:comment "Links a specific rating event to the production that was reviewed." .

:givenByNewspaper rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_RatingEvent ;
    rdfs:range :Cl_Newspaper ;
    rdfs:comment "Links a specific rating event to the newspaper that provided the rating." .

:hasStarRatingValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_RatingEvent ;
    rdfs:range xsd:decimal ;
    owl:functionalProperty true ; # A rating event should have one specific star rating value.
    rdfs:comment "The numeric star rating value (e.g., 1.0 to 5.0) given by the newspaper for the production." .

# General Class Axioms (Restrictions)
# Ensure that a Cl_RatingEvent instance is always associated with a production it reviews.
:Cl_RatingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :reviewsProduction ;
    owl:someValuesFrom :Cl_Production
] .

# Ensure that a Cl_RatingEvent instance is always associated with a newspaper that gave the rating.
:Cl_RatingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :givenByNewspaper ;
    owl:someValuesFrom :Cl_Newspaper
] .

# Ensure that a Cl_RatingEvent instance always has a star rating value.
:Cl_RatingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasStarRatingValue ;
    owl:someValuesFrom xsd:decimal
] .
@prefix : <http://www.example.org/theatre-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class for all concepts in the ontology." .

:Cl_Agent rdf:type owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A superclass for entities that can act or have actions performed on them." .

:Cl_Person rdf:type owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "A human being." .

:Cl_Organization rdf:type owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "A structured body of people with a particular purpose, such as a business or government department." .

:Cl_Actor rdf:type owl:Class ;
    rdfs:label "Actor" ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:comment "A person who performs in a play, film, or television program." .

:Cl_Theatre rdf:type owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "An organization that stages dramatic presentations or a building where plays, operas, etc., are performed." .

# Reification pivot class to answer the competency question
:Cl_Employment rdf:type owl:Class ;
    rdfs:label "Employment" ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A reification class representing the specific instance of an actor's employment at a theatre, including its start time." .

#################################################################
#    Properties
#################################################################

# Data Properties
:hasName rdf:type owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:domain :Cl_Agent ; # More general domain
    rdfs:range xsd:string ;
    owl:functional true ;
    rdfs:comment "The common name of an agent (person or organization)." .

:hasActorName rdf:type owl:DatatypeProperty ;
    rdfs:label "has actor name" ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Actor ;
    rdfs:range xsd:string ;
    owl:functional true ;
    rdfs:comment "The name of an actor." .

:hasTheatreName rdf:type owl:DatatypeProperty ;
    rdfs:label "has theatre name" ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Theatre ;
    rdfs:range xsd:string ;
    owl:functional true ;
    rdfs:comment "The name of a theatre." .

:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:label "has start time" ;
    rdfs:domain :Cl_Employment ;
    rdfs:range xsd:dateTime ;
    owl:functional true ;
    rdfs:comment "The exact date and time when an employment period began." .

# Object Properties
:involvesAgent rdf:type owl:ObjectProperty ;
    rdfs:label "involves agent" ;
    rdfs:domain :Cl_Employment ;
    rdfs:range :Cl_Agent ;
    rdfs:comment "Connects an employment instance to a generic agent involved." .

:involvesActor rdf:type owl:ObjectProperty ;
    rdfs:label "involves actor" ;
    rdfs:subPropertyOf :involvesAgent ;
    rdfs:domain :Cl_Employment ;
    rdfs:range :Cl_Actor ;
    rdfs:comment "Connects an employment instance to the specific actor involved." .

:involvesTheatre rdf:type owl:ObjectProperty ;
    rdfs:label "involves theatre" ;
    rdfs:subPropertyOf :involvesAgent ;
    rdfs:domain :Cl_Employment ;
    rdfs:range :Cl_Theatre ;
    rdfs:comment "Connects an employment instance to the theatre where the employment takes place." .

:hasEmployment rdf:type owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:domain :Cl_Actor ;
    rdfs:range :Cl_Employment ;
    owl:inverseOf :involvesActor ;
    rdfs:comment "Indicates an actor has a specific employment record." .

:providesEmployment rdf:type owl:ObjectProperty ;
    rdfs:label "provides employment" ;
    rdfs:domain :Cl_Theatre ;
    rdfs:range :Cl_Employment ;
    owl:inverseOf :involvesTheatre ;
    rdfs:comment "Indicates a theatre provides a specific employment record." .

:worksFor rdf:type owl:ObjectProperty ;
    rdfs:label "works for" ;
    rdfs:domain :Cl_Actor ;
    rdfs:range :Cl_Theatre ;
    rdfs:comment "A direct, simplified relation indicating an actor works for a theatre, without detailed temporal information. This property is less precise than using Cl_Employment for answering the competency question." .

#################################################################
#    Class Axioms (Restrictions)
#################################################################

# Every Cl_Actor must have an actor name
:Cl_Actor rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasActorName ;
    owl:someValuesFrom xsd:string
] .

# Every Cl_Theatre must have a theatre name
:Cl_Theatre rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTheatreName ;
    owl:someValuesFrom xsd:string
] .

# An Cl_Employment instance must involve an actor
:Cl_Employment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesActor ;
    owl:someValuesFrom :Cl_Actor
] .

# An Cl_Employment instance must involve a theatre
:Cl_Employment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesTheatre ;
    owl:someValuesFrom :Cl_Theatre
] .

# An Cl_Employment instance must have a start time
:Cl_Employment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasStartTime ;
    owl:someValuesFrom xsd:dateTime
] .

# General class axiom: Any entity that 'hasEmployment' must be an 'Cl_Actor'
[ rdf:type owl:Restriction ;
  owl:onProperty :hasEmployment ;
  owl:someValuesFrom :Cl_Employment ;
  rdfs:subClassOf :Cl_Actor
] .

# General class axiom: Any entity that 'providesEmployment' must be an 'Cl_Theatre'
[ rdf:type owl:Restriction ;
  owl:onProperty :providesEmployment ;
  owl:someValuesFrom :Cl_Employment ;
  rdfs:subClassOf :Cl_Theatre
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology Declaration
:productionRolesOntology a owl:Ontology ;
    rdfs:comment "Ontology for modeling person roles within productions over time, specifically addressing the competency question: What roles does a certain person have within a certain production at a certain point in time?" ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# ---------------------------------------------------
# Classes
# ---------------------------------------------------

# Core Entity Classes
:Cl_Agent a owl:Class ;
    rdfs:comment "A general class for any entity capable of action or having attributes." .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents a human individual involved in a production." .

:Cl_Production a owl:Class ;
    rdfs:comment "Represents a creative work or project, such as a film, theatrical play, or television series." .

:Cl_Role a owl:Class ;
    rdfs:comment "Represents a specific function, title, or position a person holds within a production." .

# Hierarchies for Cl_Production
:Cl_FilmProduction a owl:Class ;
    rdfs:subClassOf :Cl_Production ;
    rdfs:comment "A production typically created for cinematic release." .

:Cl_StageProduction a owl:Class ;
    rdfs:subClassOf :Cl_Production ;
    rdfs:comment "A production designed for live performance on a stage." .

:Cl_TVProduction a owl:Class ;
    rdfs:subClassOf :Cl_Production ;
    rdfs:comment "A production created specifically for television broadcast or streaming." .

# Hierarchies for Cl_Role
:Cl_CreativeRole a owl:Class ;
    rdfs:subClassOf :Cl_Role ;
    rdfs:comment "A role primarily involved in the artistic and creative direction or performance of a production (e.g., Director, Actor, Writer)." .

:Cl_TechnicalRole a owl:Class ;
    rdfs:subClassOf :Cl_Role ;
    rdfs:comment "A role primarily involved in the technical execution of a production (e.g., Cinematographer, Editor, Sound Engineer)." .

:Cl_AdministrativeRole a owl:Class ;
    rdfs:subClassOf :Cl_Role ;
    rdfs:comment "A role primarily involved in the management, organization, or financial aspects of a production (e.g., Producer, Production Manager, Executive)." .

# Reification (Pivot) Class for the Competency Question
:Cl_PersonRoleInProduction a owl:Class ;
    rdfs:comment "A reification class (pivot class) that captures the nuanced relationship of a specific person holding a specific role within a specific production at a particular point in time. This class is central to answering the competency question." .

# ---------------------------------------------------
# Properties
# ---------------------------------------------------

# Data Properties
:personName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdfs:comment "The full name of the person." .

:productionTitle a owl:DatatypeProperty ;
    rdfs:domain :Cl_Production ;
    rdfs:range xsd:string ;
    rdfs:comment "The primary title of the production." .

:productionYear a owl:DatatypeProperty ;
    rdfs:domain :Cl_Production ;
    rdfs:range xsd:gYear ;
    rdfs:comment "The year in which the production was released or first publicly presented." .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range xsd:string ;
    rdfs:comment "The descriptive name or title of the role (e.g., 'Lead Actor', 'Film Director', 'Executive Producer')." .

:assignedAtTime a owl:DatatypeProperty ;
    rdfs:domain :Cl_PersonRoleInProduction ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The specific date and time when the person was assigned to this role in this production, or when this assignment was effective." ;
    owl:functionalProperty true . # A single role assignment instance occurs at one specific time.

# Object Properties (primarily for Reification Class)

:hasAssignedPerson a owl:ObjectProperty ;
    rdfs:domain :Cl_PersonRoleInProduction ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Links a specific role assignment to the person who holds that role." ;
    owl:functionalProperty true . # Each instance of Cl_PersonRoleInProduction refers to exactly one person.

:hasAssignedRole a owl:ObjectProperty ;
    rdfs:domain :Cl_PersonRoleInProduction ;
    rdfs:range :Cl_Role ;
    rdfs:comment "Links a specific role assignment to the role being assigned." ;
    owl:functionalProperty true . # Each instance of Cl_PersonRoleInProduction refers to exactly one role.

:isRoleInProduction a owl:ObjectProperty ;
    rdfs:domain :Cl_PersonRoleInProduction ;
    rdfs:range :Cl_Production ;
    rdfs:comment "Links a specific role assignment to the production in which the role is held." ;
    owl:functionalProperty true . # Each instance of Cl_PersonRoleInProduction refers to exactly one production.

# ---------------------------------------------------
# Restrictions and General Class Axioms
# ---------------------------------------------------

# Cardinality Restrictions for the Reification Class: Cl_PersonRoleInProduction
# Ensure that every instance of Cl_PersonRoleInProduction is fully defined with its key components.
:Cl_PersonRoleInProduction rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasAssignedPerson ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every role assignment (instance of Cl_PersonRoleInProduction) must be associated with exactly one person."
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasAssignedRole ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every role assignment must involve exactly one specific role."
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :isRoleInProduction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every role assignment must be part of exactly one production."
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :assignedAtTime ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "Every role assignment must have exactly one defined time point."
    ] .

# Disjointness Axioms for Class Hierarchies
# Ensure that sub-classes within a hierarchy are mutually exclusive.
:Cl_FilmProduction owl:disjointWith :Cl_StageProduction , :Cl_TVProduction .
:Cl_StageProduction owl:disjointWith :Cl_TVProduction .

:Cl_CreativeRole owl:disjointWith :Cl_TechnicalRole , :Cl_AdministrativeRole .
:Cl_TechnicalRole owl:disjointWith :Cl_AdministrativeRole .
@prefix : <http://example.org/production-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Classes
:Cl_Production rdf:type owl:Class ;
    rdfs:label "Production" ;
    rdfs:comment "Represents a distinct theatrical, cinematic, or musical work or performance." .

:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general class for occurrences or happenings." .

:Cl_PremierEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Premier Event" ;
    rdfs:comment "A specific type of event that marks the first public performance or showing of a production. This class serves as a pivot to link a production to its specific premier time and reinforce the unique relationship." .

# Object Properties
:hasPremierEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Production ;
    rdfs:range :Cl_PremierEvent ;
    rdfs:label "has premier event" ;
    rdfs:comment "Connects a production to its specific premier event." ;
    owl:inverseOf :isPremierOf ;
    owl:propertyChainAxiom ( :hasPremierEvent ) . # Added for consistency, though cardinality already enforces uniqueness

:isPremierOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PremierEvent ;
    rdfs:range :Cl_Production ;
    rdfs:label "is premier of" ;
    rdfs:comment "Connects a premier event to the production it is the first showing of." .

# Data Properties
:premierDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_PremierEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "premier date time" ;
    rdfs:comment "The exact date and time when the premier event took place." .

# Restrictions based on Competency Question: "A production has exactly one premier."
# This restriction is applied to the Cl_Production class, ensuring every instance
# of Cl_Production is associated with exactly one Cl_PremierEvent via :hasPremierEvent.
:Cl_Production rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasPremierEvent ;
    owl:cardinality 1 ;
] .

# To further enforce constraints and capture specific characteristics of properties:

# A production can have at most one premier event.
:hasPremierEvent rdf:type owl:FunctionalProperty ;
    rdfs:comment "Ensures that a production cannot have more than one premier event." .

# A premier event is the premier for exactly one production.
:isPremierOf rdf:type owl:FunctionalProperty ;
    rdfs:comment "Ensures that a premier event is associated with only one production." .

:Cl_PremierEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isPremierOf ;
    owl:cardinality 1 ;
    rdfs:comment "Every PremierEvent must be the premier of exactly one Production."
] .

:Cl_PremierEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :premierDateTime ;
    owl:maxCardinality 1 ;
    rdfs:comment "A PremierEvent can have at most one premier date and time."
] .