@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology Declaration
:ontology rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/ontology/1.0> ;
    owl:imports <http://www.w3.org/2002/07/owl> .

# Classes
Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

Cl_GeographicalConcept rdf:type owl:Class ;
    rdfs:label "Geographical Concept" ;
    rdfs:subClassOf Cl_Entity .

Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf Cl_GeographicalConcept .

Cl_GeographicalArea rdf:type owl:Class ;
    rdfs:label "Geographical Area" ;
    rdfs:subClassOf Cl_Location .

Cl_City rdf:type owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf Cl_GeographicalArea .

Cl_PhysicalObject rdf:type owl:Class ;
    rdfs:label "Physical Object" ;
    rdfs:subClassOf Cl_Entity .

Cl_Structure rdf:type owl:Class ;
    rdfs:label "Structure" ;
    rdfs:subClassOf Cl_PhysicalObject .

Cl_Building rdf:type owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf Cl_Structure .

Cl_Venue rdf:type owl:Class ;
    rdfs:label "Venue" ;
    rdfs:subClassOf Cl_Building .

Cl_Theatre rdf:type owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:subClassOf Cl_Venue .

# Class Axioms (Disjointness)
Cl_PhysicalObject owl:disjointWith Cl_GeographicalConcept .

# Properties

# Object Properties
hasLocation rdf:type owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:domain Cl_Structure ;
    rdfs:range Cl_Location .

isLocatedIn rdf:type owl:ObjectProperty ;
    rdfs:label "is located in" ;
    rdfs:subPropertyOf hasLocation ;
    rdfs:domain Cl_Building ; # A building is located in a city
    rdfs:range Cl_City .

# Data Properties
cityName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "city name" ;
    rdfs:domain Cl_City ;
    rdfs:range xsd:string .

theatreName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "theatre name" ;
    rdfs:domain Cl_Theatre ;
    rdfs:range xsd:string .

# Restrictions
# Every Theatre must be located in some City
Cl_Theatre rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedIn ;
    owl:someValuesFrom Cl_City
] .

# Every City must have a name
Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :cityName ;
    owl:someValuesFrom xsd:string
] .

# Every Theatre must have a name
Cl_Theatre rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :theatreName ;
    owl:someValuesFrom xsd:string
] .