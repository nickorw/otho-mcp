@prefix : <http://www.example.org/theatre-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:theatre-ontology rdf:type owl:Ontology ;
    owl:versionIRI <http://www.example.org/theatre-ontology/1.0> ;
    owl:imports <http://www.w3.org/2002/07/owl> .

# Classes
Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" .

Cl_Establishment rdf:type owl:Class ;
    rdfs:label "Establishment" .

Cl_Building rdf:type owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf Cl_Establishment .

Cl_City rdf:type owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf Cl_Location .

Cl_Theatre rdf:type owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:subClassOf Cl_Building ;
    rdfs:subClassOf Cl_Establishment .

# Object Properties
isLocatedInCity rdf:type owl:ObjectProperty ;
    rdfs:label "is located in city" ;
    rdfs:domain Cl_Theatre ;
    rdfs:range Cl_City ;
    rdf:type owl:FunctionalProperty .

hasTheatre rdf:type owl:ObjectProperty ;
    rdfs:label "has theatre" ;
    rdfs:domain Cl_City ;
    rdfs:range Cl_Theatre ;
    owl:inverseOf :isLocatedInCity .

# General Class Axioms / Restrictions
Cl_Theatre rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedInCity ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:label "A theatre must be located in at least one city."
] .

Cl_Theatre rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedInCity ;
    owl:allValuesFrom Cl_City ;
    rdfs:label "A theatre is located only in a City."
] .