@prefix : <http://www.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ontology rdf:type owl:Ontology ;
    owl:imports <http://www.w3.org/2002/07/owl> .

# Classes
Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf Cl_Entity .

Cl_City rdf:type owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf Cl_Location .

Cl_Building rdf:type owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf Cl_Entity .

Cl_Theatre rdf:type owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:subClassOf Cl_Building .

# Properties
locatedInCity rdf:type owl:ObjectProperty ;
    rdfs:label "located in city" ;
    rdfs:domain Cl_Theatre ;
    rdfs:range Cl_City .