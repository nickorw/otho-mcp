@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/theatre-productions>
    a owl:Ontology ;
    rdfs:label "Theatre Productions Ontology" ;
    rdfs:comment "Ontology describing theatre festivals, productions, plays, ensembles, roles, actors, and related entities in Italy." .

### Classes

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where theatres and festivals are located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing cities." .

:Theatre a owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:comment "A building or institution where productions are held." .

:TheatreFestival a owl:Class ;
    rdfs:label "Theatre Festival" ;
    rdfs:comment "An event featuring theatre productions, held in a city." .

:Play a owl:Class ;
    rdfs:label "Play" ;
    rdfs:comment "A dramatic composition performed in a theatre." .

:Production a owl:Class ;
    rdfs:label "Production" ;
    rdfs:comment "A specific staging of a play at a theatre." .

:Ensemble a owl:Class ;
    rdfs:label "Ensemble" ;
    rdfs:comment "A group of people performing in a production." .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in theatre productions." .

:Actor a owl:Class ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Author ;
    rdfs:label "Actor" ;
    rdfs:comment "A person who performs roles in productions." .

:Author a owl:Class ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Actor ;
    rdfs:label "Author" ;
    rdfs:comment "A person who writes plays." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A character or part played in a production." .

:Review a owl:Class ;
    rdfs:label "Review" ;
    rdfs:comment "A published review of a production." .

:Newspaper a owl:Class ;
    rdfs:label "Newspaper" ;
    rdfs:comment "A newspaper that publishes reviews." .

:Act a owl:Class ;
    rdfs:label "Act" ;
    rdfs:comment "An act within a play." .

:ProductionRoleAssignment a owl:Class ;
    rdfs:label "Production Role Assignment" ;
    rdfs:comment "A reified relation linking a production, actor, and role, possibly with a date." .

:EnsembleMembership a owl:Class ;
    rdfs:label "Ensemble Membership" ;
    rdfs:comment "A reified relation linking a person, ensemble, and membership period." .

### Object Properties

:festivalLocation a owl:ObjectProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :City ;
    rdfs:label "festival location" ;
    rdfs:comment "Links a festival to the city where it takes place." ;
    owl:inverseOf :locationOfFestival .

:locationOfFestival a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :TheatreFestival ;
    rdfs:label "location of festival" ;
    rdfs:comment "Inverse: links a city to the festivals held there." ;
    owl:inverseOf :festivalLocation .

:theatreLocation a owl:ObjectProperty ;
    rdfs:domain :Theatre ;
    rdfs:range :City ;
    rdfs:label "theatre location" ;
    rdfs:comment "Links a theatre to the city where it is located." ;
    owl:inverseOf :locationOfTheatre .

:locationOfTheatre a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :Theatre ;
    rdfs:label "location of theatre" ;
    rdfs:comment "Inverse: links a city to the theatres located there." ;
    owl:inverseOf :theatreLocation .

:takesPlaceInCountry a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    rdfs:label "takes place in country" ;
    rdfs:comment "Links a city to the country it is located in." ;
    owl:inverseOf :countryHasCity .

:countryHasCity a owl:ObjectProperty ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    rdfs:label "country has city" ;
    rdfs:comment "Inverse: links a country to its cities." ;
    owl:inverseOf :takesPlaceInCountry .

:featuresPlay a owl:ObjectProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :Play ;
    rdfs:label "features play" ;
    rdfs:comment "Links a festival to the plays performed." ;
    owl:inverseOf :isFeaturedInFestival .

:isFeaturedInFestival a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :TheatreFestival ;
    rdfs:label "is featured in festival" ;
    rdfs:comment "Inverse: links a play to the festivals where it is performed." ;
    owl:inverseOf :featuresPlay .

:hasTheatre a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :Theatre ;
    rdfs:label "has theatre" ;
    rdfs:comment "Links a production to the theatre where it is performed." ;
    owl:inverseOf :isTheatreOfProduction .

:isTheatreOfProduction a owl:ObjectProperty ;
    rdfs:domain :Theatre ;
    rdfs:range :Production ;
    rdfs:label "is theatre of production" ;
    rdfs:comment "Inverse: links a theatre to its productions." ;
    owl:inverseOf :hasTheatre .

:hasEnsemble a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :Ensemble ;
    rdfs:label "has ensemble" ;
    rdfs:comment "Links a production to the ensemble performing." ;
    owl:inverseOf :isEnsembleOfProduction .

:isEnsembleOfProduction a owl:ObjectProperty ;
    rdfs:domain :Ensemble ;
    rdfs:range :Production ;
    rdfs:label "is ensemble of production" ;
    rdfs:comment "Inverse: links an ensemble to the productions it performs in." ;
    owl:inverseOf :hasEnsemble .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :Ensemble ;
    rdfs:range :Person ;
    rdfs:label "has member" ;
    rdfs:comment "Links an ensemble to its members." ;
    owl:inverseOf :isMemberOfEnsemble .

:isMemberOfEnsemble a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Ensemble ;
    rdfs:label "is member of ensemble" ;
    rdfs:comment "Inverse: links a person to the ensembles they belong to." ;
    owl:inverseOf :hasMember .

:wrotePlay a owl:ObjectProperty ;
    rdfs:domain :Author ;
    rdfs:range :Play ;
    rdfs:label "wrote play" ;
    rdfs:comment "Links an author to plays they wrote." ;
    owl:inverseOf :isWrittenBy .

:isWrittenBy a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :Author ;
    rdfs:label "is written by" ;
    rdfs:comment "Inverse: links a play to its author." ;
    owl:inverseOf :wrotePlay .

:hasAct a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :Act ;
    rdfs:label "has act" ;
    rdfs:comment "Links a play to its acts." ;
    owl:inverseOf :isActOfPlay .

:isActOfPlay a owl:ObjectProperty ;
    rdfs:domain :Act ;
    rdfs:range :Play ;
    rdfs:label "is act of play" ;
    rdfs:comment "Inverse: links an act to the play it belongs to." ;
    owl:inverseOf :hasAct .

:hasProduction a owl:ObjectProperty ;
    rdfs:domain :Play ;
    rdfs:range :Production ;
    rdfs:label "has production" ;
    rdfs:comment "Links a play to its productions." ;
    owl:inverseOf :isProductionOfPlay .

:isProductionOfPlay a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :Play ;
    rdfs:label "is production of play" ;
    rdfs:comment "Inverse: links a production to its play." ;
    owl:inverseOf :hasProduction .

:hasReview a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :Review ;
    rdfs:label "has review" ;
    rdfs:comment "Links a production to its reviews." ;
    owl:inverseOf :isReviewOfProduction .

:isReviewOfProduction a owl:ObjectProperty ;
    rdfs:domain :Review ;
    rdfs:range :Production ;
    rdfs:label "is review of production" ;
    rdfs:comment "Inverse: links a review to the production it reviews." ;
    owl:inverseOf :hasReview .

:reviewedBy a owl:ObjectProperty ;
    rdfs:domain :Review ;
    rdfs:range :Newspaper ;
    rdfs:label "reviewed by" ;
    rdfs:comment "Links a review to the newspaper that published it." ;
    owl:inverseOf :reviews .

:reviews a owl:ObjectProperty ;
    rdfs:domain :Newspaper ;
    rdfs:range :Review ;
    rdfs:label "reviews" ;
    rdfs:comment "Inverse: links a newspaper to the reviews it publishes." ;
    owl:inverseOf :reviewedBy .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Production ;
    rdfs:range :ProductionRoleAssignment ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Links a production to its role assignments." ;
    owl:inverseOf :roleAssignmentOfProduction .

:roleAssignmentOfProduction a owl:ObjectProperty ;
    rdfs:domain :ProductionRoleAssignment ;
    rdfs:range :Production ;
    rdfs:label "role assignment of production" ;
    rdfs:comment "Inverse: links a role assignment to its production." ;
    owl:inverseOf :hasRoleAssignment .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :ProductionRoleAssignment ;
    rdfs:range :Role ;
    rdfs:label "has role" ;
    rdfs:comment "Links a role assignment to the role." ;
    owl:inverseOf :isRoleOfAssignment .

:isRoleOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Role ;
    rdfs:range :ProductionRoleAssignment ;
    rdfs:label "is role of assignment" ;
    rdfs:comment "Inverse: links a role to its assignment." ;
    owl:inverseOf :hasRole .

:hasActor a owl:ObjectProperty ;
    rdfs:domain :ProductionRoleAssignment ;
    rdfs:range :Actor ;
    rdfs:label "has actor" ;
    rdfs:comment "Links a role assignment to the actor." ;
    owl:inverseOf :isActorOfAssignment .

:isActorOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Actor ;
    rdfs:range :ProductionRoleAssignment ;
    rdfs:label "is actor of assignment" ;
    rdfs:comment "Inverse: links an actor to their role assignments." ;
    owl:inverseOf :hasActor .

:membershipInEnsemble a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :EnsembleMembership ;
    rdfs:label "membership in ensemble" ;
    rdfs:comment "Links a person to their ensemble membership." ;
    owl:inverseOf :hasEnsembleMembership .

:hasEnsembleMembership a owl:ObjectProperty ;
    rdfs:domain :EnsembleMembership ;
    rdfs:range :Person ;
    rdfs:label "has ensemble membership" ;
    rdfs:comment "Inverse: links an ensemble membership to the person." ;
    owl:inverseOf :membershipInEnsemble .

:memberOfEnsemble a owl:ObjectProperty ;
    rdfs:domain :EnsembleMembership ;
    rdfs:range :Ensemble ;
    rdfs:label "member of ensemble" ;
    rdfs:comment "Links an ensemble membership to the ensemble." ;
    owl:inverseOf :hasEnsembleMember .

:hasEnsembleMember a owl:ObjectProperty ;
    rdfs:domain :Ensemble ;
    rdfs:range :EnsembleMembership ;
    rdfs:label "has ensemble member" ;
    rdfs:comment "Inverse: links an ensemble to its ensemble memberships." ;
    owl:inverseOf :memberOfEnsemble .

### Data Properties

:festivalStartDate a owl:DatatypeProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range xsd:dateTime ;
    rdfs:label "festival start date" ;
    rdfs:comment "Start date of a festival." .

:festivalEndDate a owl:DatatypeProperty ;
    rdfs:domain :TheatreFestival ;
    rdfs:range xsd:dateTime ;
    rdfs:label "festival end date" ;
    rdfs:comment "End date of a festival." .

:productionStartDate a owl:DatatypeProperty ;
    rdfs:domain :Production ;
    rdfs:range xsd:dateTime ;
    rdfs:label "production start date" ;
    rdfs:comment "Start date of a production." .

:productionEndDate a owl:DatatypeProperty ;
    rdfs:domain :Production ;
    rdfs:range xsd:dateTime ;
    rdfs:label "production end date" ;
    rdfs:comment "End date of a production." .

:premierDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Production ;
    rdfs:range xsd:dateTime ;
    rdfs:label "premier date" ;
    rdfs:comment "Date of the premier of a production." .

:starRating a owl:DatatypeProperty ;
    rdfs:domain :Review ;
    rdfs:range xsd:integer ;
    rdfs:label "star rating" ;
    rdfs:comment "Star rating given in a review." .

:employmentStartDate a owl:DatatypeProperty ;
    rdfs:domain :Actor ;
    rdfs:range xsd:dateTime ;
    rdfs:label "employment start date" ;
    rdfs:comment "Date when an actor started working at a theatre." .

:numberOfActs a owl:DatatypeProperty ;
    rdfs:domain :Play ;
    rdfs:range xsd:integer ;
    rdfs:label "number of acts" ;
    rdfs:comment "Number of acts in a play." .

:writtenStartDate a owl:DatatypeProperty ;
    rdfs:domain :Play ;
    rdfs:range xsd:dateTime ;
    rdfs:label "written start date" ;
    rdfs:comment "Start date of writing a play." .

:writtenEndDate a owl:DatatypeProperty ;
    rdfs:domain :Play ;
    rdfs:range xsd:dateTime ;
    rdfs:label "written end date" ;
    rdfs:comment "End date of writing a play." .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :ProductionRoleAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "Date of the role assignment." .

:membershipStartDate a owl:DatatypeProperty ;
    rdfs:domain :EnsembleMembership ;
    rdfs:range xsd:dateTime ;
    rdfs:label "membership start date" ;
    rdfs:comment "Start date of ensemble membership." .

:membershipEndDate a owl:DatatypeProperty ;
    rdfs:domain :EnsembleMembership ;
    rdfs:range xsd:dateTime ;
    rdfs:label "membership end date" ;
    rdfs:comment "End date of ensemble membership." .

### Disjointness

:TheatreFestival owl:disjointWith :Production .
:Theatre owl:disjointWith :City .
:Play owl:disjointWith :Production .

### Restrictions & Axioms

:Production rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasRoleAssignment ;
    owl:allValuesFrom :ProductionRoleAssignment
] .
:Ensemble rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasMember ;
    owl:allValuesFrom :Person
] .
:Play rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasAct ;
    owl:allValuesFrom :Act
] .
:Production owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasProduction ; owl:someValuesFrom :Play ]
        [ a owl:Restriction ; owl:onProperty :hasTheatre ; owl:someValuesFrom :Theatre ]
    )
] .
