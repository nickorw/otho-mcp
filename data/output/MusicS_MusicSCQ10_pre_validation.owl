@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

### Classes
:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" .

:Cl_Performance rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Performance" .

# Reification class for a specific instance of a performance taking place
:Cl_PerformanceEvent rdf:type owl:Class ;
    rdfs:label "Performance Event" ;
    rdfs:comment "Represents a specific occurrence of a performance, linking a performance with its time of occurrence." ;
    # General class axiom: A PerformanceEvent must refer to a Performance and have a DateTime.
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty :occursForPerformance ;
                      owl:someValuesFrom :Cl_Performance ] ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty :hasDateTime ;
                      owl:someValuesFrom xsd:dateTime ] .

### Properties

# Object Property: Links a Performance Event to the specific Performance it refers to
:occursForPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PerformanceEvent ;
    rdfs:range :Cl_Performance ;
    rdfs:label "occurs for performance" .

# Object Property: Links a Performance to its specific Performance Event(s)
:hasPerformanceEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceEvent ;
    owl:inverseOf :occursForPerformance ;
    rdfs:label "has performance event" .

# Data Property: Specifies the date and time of a Performance Event
:hasDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_PerformanceEvent ;
    rdfs:range xsd:dateTime ;
    owl:functional true ; # A specific performance event typically has one exact date/time
    rdfs:label "has date time" .

# General Class Axiom Example (Optional, demonstrating restriction usage)
# :Cl_PerformanceEvent is the only class that uses the 'hasDateTime' property for its domain.
:Cl_PerformanceEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasDateTime ;
    owl:allValuesFrom xsd:dateTime
] .