@prefix : <http://example.org/edifact#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

:Cl_EDIFACTMessage rdf:type owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured message following the EDIFACT standard." .

:Cl_Invoice rdf:type owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice document, possibly contained within an EDIFACT message." .

:Cl_Document rdf:type owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A general document class, superclass for Invoice." .

:Cl_EDIFACTMessageDocumentListing rdf:type owl:Class ;
    rdfs:label "EDIFACT Message Document Listing" ;
    rdfs:comment "A pivot class representing the listing of documents (e.g., invoices) within an EDIFACT message." .

#################################################################
# Class Hierarchies
#################################################################

:Cl_Invoice rdfs:subClassOf :Cl_Document .

#################################################################
# Properties
#################################################################

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Relates an EDIFACT message to an invoice." .

:listsDocument rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageDocumentListing ;
    rdfs:range :Cl_Document ;
    rdfs:label "lists document" ;
    rdfs:comment "Relates an EDIFACT message document listing to a document (e.g., invoice) listed in the message." .

:forEDIFACTMessage rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageDocumentListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "for EDIFACT message" ;
    rdfs:comment "Indicates the EDIFACT message for which the document listing applies." .

:documentNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "document number" ;
    rdfs:comment "The identifier for an invoice." .

:issueDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "issue date" ;
    rdfs:comment "The date the invoice was issued." .

#################################################################
# Reification (Pivot Class for Complex Relation)
#################################################################

# The relationship "What invoices are all listed in an EDIFACT message?" involves an EDIFACT message and potentially multiple invoices.
# To support further extension (e.g., listing multiple types of documents, or additional attributes about the listing), we use a pivot class.

# For each EDIFACT message, there can exist one or more Cl_EDIFACTMessageDocumentListing instances,
# each of which connects the message to a Cl_Document (e.g., Cl_Invoice).

#################################################################
# Restrictions
#################################################################

:Cl_EDIFACTMessageDocumentListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :forEDIFACTMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ rdf:type owl:Restriction ; owl:onProperty :listsDocument ; owl:someValuesFrom :Cl_Document ]
    )
] .

#################################################################
# Disjointness
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_Document, :Cl_EDIFACTMessageDocumentListing .
:Cl_Invoice owl:disjointWith :Cl_EDIFACTMessageDocumentListing .

#################################################################
# Example Query Explanation
#################################################################

# To answer "What invoices are all listed in an EDIFACT message?"
# 1. Find all :Cl_EDIFACTMessageDocumentListing where :forEDIFACTMessage points to the message of interest.
# 2. For each such listing, retrieve :listsDocument, filter for those where the document is a :Cl_Invoice.

#################################################################
# End of Ontology
#################################################################