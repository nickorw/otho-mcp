@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/EDIFACTScenario> a owl:Ontology ;
  rdfs:label "EDIFACT Invoice Ontology" ;
  rdfs:comment "An ontology modeling EDIFACT invoice messages, organizations, items, and related business processes." .

#################################################################
# Classes
#################################################################

:EDIFACTMessage a owl:Class ;
  rdfs:label "EDIFACT Message" ;
  rdfs:comment "A structured EDIFACT message containing one or more invoices." .

:Invoice a owl:Class ;
  rdfs:label "Invoice" ;
  rdfs:comment "A commercial document issued by a seller to a buyer." .

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "An organization involved in the invoice process." .

:OrganizationRole a owl:Class ;
  rdfs:label "Organization Role" ;
  rdfs:comment "A role played by an organization in an invoice (e.g., buyer, seller)." .

:Address a owl:Class ;
  rdfs:label "Address" ;
  rdfs:comment "A postal address for an organization." .

:Item a owl:Class ;
  rdfs:label "Item" ;
  rdfs:comment "A product or service being sold in the invoice." .

:InvoiceItem a owl:Class ;
  rdfs:label "Invoice Item" ;
  rdfs:comment "A line item in the invoice referring to an item." .

:BusinessProcess a owl:Class ;
  rdfs:label "Business Process" ;
  rdfs:comment "A business process to which an invoice can be assigned." .

:InvoiceParticipation a owl:Class ;
  rdfs:label "Invoice Participation" ;
  rdfs:comment "A reified participation of an organization in an invoice, with a specific role." .

#################################################################
# Object Properties and Inverses
#################################################################

:containsInvoice a owl:ObjectProperty ;
  rdfs:domain :EDIFACTMessage ;
  rdfs:range :Invoice ;
  owl:IrreflexiveProperty true ;
  owl:inverseOf :isContainedInMessage ;
  rdfs:label "contains invoice" ;
  rdfs:comment "Associates an EDIFACT message with the invoices it contains." .

:isContainedInMessage a owl:ObjectProperty ;
  rdfs:domain :Invoice ;
  rdfs:range :EDIFACTMessage ;
  owl:IrreflexiveProperty true ;
  owl:inverseOf :containsInvoice ;
  rdfs:label "is contained in message" ;
  rdfs:comment "Indicates the EDIFACT message in which an invoice is listed." .

:involvesParticipation a owl:ObjectProperty ;
  rdfs:domain :Invoice ;
  rdfs:range :InvoiceParticipation ;
  owl:inverseOf :isParticipationIn ;
  rdfs:label "involves participation" ;
  rdfs:comment "Associates an invoice with the participations (roles played by organizations in the invoice)." .

:isParticipationIn a owl:ObjectProperty ;
  rdfs:domain :InvoiceParticipation ;
  rdfs:range :Invoice ;
  owl:inverseOf :involvesParticipation ;
  rdfs:label "is participation in" ;
  rdfs:comment "Indicates the invoice in which this participation occurs." .

:hasParticipant a owl:ObjectProperty ;
  rdfs:domain :InvoiceParticipation ;
  rdfs:range :Organization ;
  owl:FunctionalProperty true ;
  owl:inverseOf :participatesAs ;
  rdfs:label "has participant" ;
  rdfs:comment "Specifies which organization participates in an invoice." .

:participatesAs a owl:ObjectProperty ;
  rdfs:domain :Organization ;
  rdfs:range :InvoiceParticipation ;
  owl:inverseOf :hasParticipant ;
  rdfs:label "participates as" ;
  rdfs:comment "Indicates the participations of an organization in invoices." .

:hasRole a owl:ObjectProperty ;
  rdfs:domain :InvoiceParticipation ;
  rdfs:range :OrganizationRole ;
  owl:FunctionalProperty true ;
  owl:inverseOf :isRoleOfParticipation ;
  rdfs:label "has role" ;
  rdfs:comment "Specifies the role of the organization in the invoice." .

:isRoleOfParticipation a owl:ObjectProperty ;
  rdfs:domain :OrganizationRole ;
  rdfs:range :InvoiceParticipation ;
  owl:inverseOf :hasRole ;
  rdfs:label "is role of participation" ;
  rdfs:comment "Indicates participations for which this is the role." .

:hasAddress a owl:ObjectProperty ;
  rdfs:domain :Organization ;
  rdfs:range :Address ;
  owl:FunctionalProperty true ;
  owl:inverseOf :isAddressOf ;
  rdfs:label "has address" ;
  rdfs:comment "Links an organization to its address." .

:isAddressOf a owl:ObjectProperty ;
  rdfs:domain :Address ;
  rdfs:range :Organization ;
  owl:inverseOf :hasAddress ;
  rdfs:label "is address of" ;
  rdfs:comment "Indicates the organization for which this is the address." .

:includesItem a owl:ObjectProperty ;
  rdfs:domain :Invoice ;
  rdfs:range :InvoiceItem ;
  owl:inverseOf :isIncludedInInvoice ;
  rdfs:label "includes item" ;
  rdfs:comment "Associates an invoice with the items it includes." .

:isIncludedInInvoice a owl:ObjectProperty ;
  rdfs:domain :InvoiceItem ;
  rdfs:range :Invoice ;
  owl:inverseOf :includesItem ;
  rdfs:label "is included in invoice" ;
  rdfs:comment "Indicates the invoice in which this item is included." .

:refersToItem a owl:ObjectProperty ;
  rdfs:domain :InvoiceItem ;
  rdfs:range :Item ;
  owl:FunctionalProperty true ;
  owl:inverseOf :isItemOf ;
  rdfs:label "refers to item" ;
  rdfs:comment "Links an invoice item to the item being sold." .

:isItemOf a owl:ObjectProperty ;
  rdfs:domain :Item ;
  rdfs:range :InvoiceItem ;
  owl:inverseOf :refersToItem ;
  rdfs:label "is item of" ;
  rdfs:comment "Indicates the invoice items that refer to this item." .

:assignedToProcess a owl:ObjectProperty ;
  rdfs:domain :Invoice ;
  rdfs:range :BusinessProcess ;
  owl:inverseOf :processHasInvoice ;
  rdfs:label "assigned to process" ;
  rdfs:comment "Associates an invoice to a business process." .

:processHasInvoice a owl:ObjectProperty ;
  rdfs:domain :BusinessProcess ;
  rdfs:range :Invoice ;
  owl:inverseOf :assignedToProcess ;
  rdfs:label "process has invoice" ;
  rdfs:comment "Indicates invoices assigned to this business process." .

#################################################################
# Data Properties
#################################################################

:netPrice a owl:DatatypeProperty ;
  rdfs:domain :InvoiceItem ;
  rdfs:range xsd:decimal ;
  rdfs:label "net price" ;
  rdfs:comment "Net price of the invoice item." .

:invoiceAmount a owl:DatatypeProperty ;
  rdfs:domain :Invoice ;
  rdfs:range xsd:decimal ;
  rdfs:label "invoice amount" ;
  rdfs:comment "Total amount of the invoice." .

:invoiceNumber a owl:DatatypeProperty ;
  rdfs:domain :Invoice ;
  rdfs:range xsd:string ;
  owl:FunctionalProperty true ;
  rdfs:label "invoice number" ;
  rdfs:comment "Unique number of the invoice." .

:orgName a owl:DatatypeProperty ;
  rdfs:domain :Organization ;
  rdfs:range xsd:string ;
  owl:FunctionalProperty true ;
  rdfs:label "organization name" ;
  rdfs:comment "The name of the organization." .

:street a owl:DatatypeProperty ;
  rdfs:domain :Address ;
  rdfs:range xsd:string ;
  rdfs:label "street" ;
  rdfs:comment "Street name of the address." .

:city a owl:DatatypeProperty ;
  rdfs:domain :Address ;
  rdfs:range xsd:string ;
  rdfs:label "city" ;
  rdfs:comment "City of the address." .

:country a owl:DatatypeProperty ;
  rdfs:domain :Address ;
  rdfs:range xsd:string ;
  rdfs:label "country" ;
  rdfs:comment "Country of the address." .

:itemDescription a owl:DatatypeProperty ;
  rdfs:domain :Item ;
  rdfs:range xsd:string ;
  rdfs:label "item description" ;
  rdfs:comment "Description of the item." .

#################################################################
# Hierarchy & Disjointness
#################################################################

:EDIFACTMessage owl:disjointWith :Invoice .
:Organization owl:disjointWith :Item, :Address .
:Address owl:disjointWith :Organization .
:Item owl:disjointWith :Organization .

#################################################################
# Complex Axioms & Restrictions
#################################################################

:BuyerParticipation a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      :InvoiceParticipation
      [ a owl:Restriction ;
        owl:onProperty :hasRole ;
        owl:hasValue :Buyer
      ]
    )
  ] ;
  rdfs:label "Buyer Participation" ;
  rdfs:comment "Defines buyer participation as an invoice participation with role 'Buyer'." .

:InvoiceParticipation rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty :hasParticipant ;
  owl:allValuesFrom :Organization
] , [
  a owl:Restriction ;
  owl:onProperty :hasRole ;
  owl:allValuesFrom :OrganizationRole
] .
