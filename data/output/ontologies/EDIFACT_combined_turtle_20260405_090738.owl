:assignmentDate a owl:DatatypeProperty ; rdfs:domain :Cl_Assignment ; rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "Date of the assignment." .
:providedValue a owl:DatatypeProperty ; rdfs:domain :Cl_ProvidedInformation ; rdfs:range xsd:string ;
    rdfs:label "provided value" ;
    rdfs:comment "Value of provided information." .
:informationItemName a owl:DatatypeProperty ; rdfs:domain :Cl_InformationItem ; rdfs:range xsd:string ;
    rdfs:label "information item name" ;
    rdfs:comment "Name of the information item." .
:isMandatory a owl:DatatypeProperty ; rdfs:domain :Cl_InformationItem ; rdfs:range xsd:boolean ;
    rdfs:label "is mandatory" ;
    rdfs:comment "Whether the information item is mandatory." .
:validationResult a owl:DatatypeProperty ; rdfs:domain :Cl_ValidityAssessment ; rdfs:range xsd:boolean ;
    rdfs:label "validation result" ;
    rdfs:comment "Result of the validation." .
:validationMessage a owl:DatatypeProperty ; rdfs:domain :Cl_ValidityAssessment ; rdfs:range xsd:string ;
    rdfs:label "validation message" ;
    rdfs:comment "Message of the validation assessment." .
:hasAssessmentResult a owl:DatatypeProperty ; rdfs:domain :Cl_FileFormatValidityAssessment ; rdfs:range xsd:boolean ;
    rdfs:label "has assessment result" ;
    rdfs:comment "Assessment result for file format validity." .
:invoiceAmountValue a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceAmountReification ; rdfs:range xsd:decimal ;
    rdfs:label "invoice amount value" ;
    rdfs:comment "Value of invoice amount." .
:invoiceAmountCurrency a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceAmountReification ; rdfs:range xsd:string ;
    rdfs:label "invoice amount currency" ;
    rdfs:comment "Currency of invoice amount." .

#################################################################
# General Class Axioms
#################################################################

:Cl_EDIFACTDocumentListing rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :listsDocument ; owl:allValuesFrom :Cl_Invoice
] .
:Cl_EDIFACTDocumentListing rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :listsDocument ; owl:someValuesFrom :Cl_Invoice
] .
:Cl_EDIFACTDocumentListing owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :listsDocument ; owl:allValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :listedInMessage ; owl:allValuesFrom :Cl_EDIFACTMessage ]
    )
] .
:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :hasParticipant ; owl:someValuesFrom :Cl_Organization
] .
:Cl_OrgInfoDisplay rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :displayedOrgAttribute ; owl:someValuesFrom :Cl_OrgInfoAttribute
] .
:Cl_Buyer rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :isBuyerInAssignment ; owl:someValuesFrom :Cl_BuyerAddressAssignment
] .
:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :inv_hasLine ; owl:someValuesFrom :Cl_InvoiceLine
] .
:Cl_InvoiceLine rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :il_item ; owl:someValuesFrom :Cl_Item
] .

#################################################################
# Additional Restrictions and Notes
#################################################################

:Cl_PriceComponent owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :priceComponentType ; owl:hasValue "net" ]
    )
] .

#################################################################
# Connections for previously unconnected classes
#################################################################

:Cl_ValidationEntity rdfs:subClassOf :Cl_Entity .
:Cl_ValidationActivity rdfs:subClassOf :Cl_ValidationEntity .
:Cl_Requirement rdfs:subClassOf :Cl_Entity .

#################################################################
# End of FestS Ontology
#################################################################