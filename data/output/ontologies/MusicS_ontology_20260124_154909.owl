@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music_production> a owl:Ontology .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, e.g., musician, critic, etc." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A group of musicians performing together." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or part (e.g., vocals, guitar, drums) a person has in a band." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A published collection of tracks." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] . # CQ15

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A recorded item on an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live musical event." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where a performance takes place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Pivot Classes for Reification
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reification of a person's membership in a band at a given time, possibly with a role." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "A reification of an album's recording period." .

:TrackSongRelation a owl:Class ;
    rdfs:label "Track-Song Relation" ;
    rdfs:comment "A reification linking a track to the song it is a recording of." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "A reification linking a performance to a song performed." .

### Object Properties (with inverses)
:playsInstrument a owl:ObjectProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Links a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :isPlayedBy .

:isPlayedBy a owl:ObjectProperty ;
    rdfs:label "is played by" ;
    rdfs:comment "Links an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Links a band membership to a role." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :isRoleOf .

:isRoleOf a owl:ObjectProperty ;
    rdfs:label "is role of" ;
    rdfs:comment "Links a role to the band membership it is associated with." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :hasRole .

:member a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "member" ;
    rdfs:comment "Links a band membership to the person who is a member." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :isMemberOfMembership .

:isMemberOfMembership a owl:ObjectProperty ;
    rdfs:label "is member of membership" ;
    rdfs:comment "Links a person to their band membership." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :member .

:inBand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in band" ;
    rdfs:comment "Links a band membership to the band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMembership .

:hasMembership a owl:ObjectProperty ;
    rdfs:label "has membership" ;
    rdfs:comment "Links a band to a band membership." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :inBand .

:recordingOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recording of" ;
    rdfs:comment "Links an album recording event to an album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :hasRecording .

:hasRecording a owl:ObjectProperty ;
    rdfs:label "has recording" ;
    rdfs:comment "Links an album to its recording event." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordingOf .

:containsTrack a owl:ObjectProperty ;
    rdfs:label "contains track" ;
    rdfs:comment "Links an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :isTrackOf .

:isTrackOf a owl:ObjectProperty ;
    rdfs:label "is track of" ;
    rdfs:comment "Links a track to the album it is contained in." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :containsTrack .

:track a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track" ;
    rdfs:comment "Links a track-song relation to a track." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Track ;
    owl:inverseOf :isTrackInRelation .

:isTrackInRelation a owl:ObjectProperty ;
    rdfs:label "is track in relation" ;
    rdfs:comment "Links a track to its track-song relation." ;
    rdfs:domain :Track ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :track .

:isRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "is recording of" ;
    rdfs:comment "Links a track-song relation to a song." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Song ;
    owl:inverseOf :hasRecordingRelation .

:hasRecordingRelation a owl:ObjectProperty ;
    rdfs:label "has recording relation" ;
    rdfs:comment "Links a song to its track-song relation." ;
    rdfs:domain :Song ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :isRecordingOf .

:performanceOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Links a performance-song relation to a performance." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceSong .

:hasPerformanceSong a owl:ObjectProperty ;
    rdfs:label "has performance song" ;
    rdfs:comment "Links a performance to its performance-song relation." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceOf .

:performedSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Links a performance-song relation to a song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :isPerformedIn .

:isPerformedIn a owl:ObjectProperty ;
    rdfs:label "is performed in" ;
    rdfs:comment "Links a song to its performance-song relation." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performedSong .

:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "Links a performance to the city where it takes place." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :isLocationOfPerformance .

:isLocationOfPerformance a owl:ObjectProperty ;
    rdfs:label "is location of performance" ;
    rdfs:comment "Links a city to the performances located there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation .

:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in region" ;
    rdfs:comment "Links a city to the region it is in." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :hasCity .

:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Links a region to its cities." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :inRegion .

:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in country" ;
    rdfs:comment "Links a region to the country it is in." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :hasRegion .

:hasRegion a owl:ObjectProperty ;
    rdfs:label "has region" ;
    rdfs:comment "Links a country to its regions." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :inCountry .

:reviewedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reviewed album" ;
    rdfs:comment "Links a critic to the album they reviewed." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :isReviewedBy .

:isReviewedBy a owl:ObjectProperty ;
    rdfs:label "is reviewed by" ;
    rdfs:comment "Links an album to the critic who reviewed it." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :reviewedAlbum .

:critic a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "critic" ;
    rdfs:comment "Links a critic instance to the person who is the critic." ;
    rdfs:domain :Critic ;
    rdfs:range :Person ;
    owl:inverseOf :isCriticOf .

:isCriticOf a owl:ObjectProperty ;
    rdfs:label "is critic of" ;
    rdfs:comment "Links a person to the critic instance." ;
    rdfs:domain :Person ;
    rdfs:range :Critic ;
    owl:inverseOf :critic .

### Data Properties
:membershipStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "Start date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:membershipEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "End date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "End date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:trackNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track within an album." ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer .

:releaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "release date" ;
    rdfs:comment "Release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "composed on" ;
    rdfs:comment "Date when a song was composed." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:reviewText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review text" ;
    rdfs:comment "Text of a critic's review." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "Date of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

### Disjointness Axioms
:Person owl:disjointWith :Band , :Critic .
:Instrument owl:disjointWith :Role .
:Album owl:disjointWith :Performance .
:Song owl:disjointWith :Track .
:City owl:disjointWith :Region .
:Region owl:disjointWith :Country .

### End of Ontology