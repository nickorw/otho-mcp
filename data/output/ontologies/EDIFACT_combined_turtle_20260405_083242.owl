:hasInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "has involvement" ;
    rdfs:comment "Involvement in the invoice." ;
    owl:inverseOf :involvementOfInvoice .

:involvementOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "involvement of invoice" ;
    rdfs:comment "Inverse of hasInvolvement." ;
    owl:inverseOf :hasInvolvement .

:involves a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves" ;
    rdfs:comment "Organization involved in invoice organization involvement." ;
    owl:inverseOf :involvementOf .

:involvementOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "involvement of" ;
    rdfs:comment "Inverse of involves." ;
    owl:inverseOf :involves .

:hasRoleInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Role ;
    rdfs:label "has role (involvement)" ;
    rdfs:comment "Role in invoice organization involvement." ;
    owl:inverseOf :roleOfInvolvement .

:roleOfInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "role of involvement" ;
    rdfs:comment "Inverse of hasRoleInvolvement." ;
    owl:inverseOf :hasRoleInvolvement .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" ;
    rdfs:comment "Organization in the invoice organization role." ;
    owl:inverseOf :organizationOfRole .

:organizationOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceOrganizationRole ;
    rdfs:label "organization of role" ;
    rdfs:comment "Inverse of hasOrganization." ;
    owl:inverseOf :hasOrganization .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationRole ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Invoice in the invoice organization role." ;
    owl:inverseOf :invoiceOfRole .

:invoiceOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationRole ;
    rdfs:label "invoice of role" ;
    rdfs:comment "Inverse of hasInvoice." ;
    owl:inverseOf :hasInvoice .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationRole ;
    rdfs:range :Cl_Role ;
    rdfs:label "has role" ;
    rdfs:comment "Role in the invoice organization role." ;
    owl:inverseOf :roleOfOrganizationRole .

:roleOfOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_InvoiceOrganizationRole ;
    rdfs:label "role of organization role" ;
    rdfs:comment "Inverse of hasRole." ;
    owl:inverseOf :hasRole .

:hasParty a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Organization ;
    rdfs:subPropertyOf :hasOrganization ;
    rdfs:label "has party" ;
    rdfs:comment "Party in the invoice." ;
    owl:inverseOf :partyOf .

:partyOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "party of" ;
    rdfs:comment "Inverse of hasParty." ;
    owl:inverseOf :hasParty .

#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_InvoiceLine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Item owl:equivalentClass [
    owl:unionOf ( :Cl_Product :Cl_Service )
] .

:Cl_InvoiceParticipant rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :participantRole ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    a owl:Restriction ;
    owl:onProperty :participantOrganization ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceParticipant ;
    owl:someValuesFrom :Cl_InvoiceParticipant
] .

:Cl_Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasOrganizationType ;
    owl:someValuesFrom :Cl_OrganizationType
] .

:Cl_InvoiceAmountReification owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :refersToAmount ;
    owl:allValuesFrom :Cl_MonetaryAmount
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceAmountReification ;
    owl:someValuesFrom :Cl_InvoiceAmountReification
] .

:Cl_FileFormatValidityRequirement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :validityRequiresElement ;
          owl:someValuesFrom :Cl_RequiredElement ]
        [ a owl:Restriction ;
          owl:onProperty :validityRequiresDataType ;
          owl:someValuesFrom :Cl_ElementDataType ]
        [ a owl:Restriction ;
          owl:onProperty :validityRequiresValueConstraint ;
          owl:someValuesFrom :Cl_ElementValueConstraint ]
    )
] .

:Cl_ElementValueConstraint owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_ValidationRequirement
        [ a owl:Restriction ;
          owl:onProperty :constraintDescription ;
          owl:someValuesFrom xsd:string ]
    )
] .

:Cl_ElementDataType owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_ValidationRequirement
        [ a owl:Restriction ;
          owl:onProperty :dataTypeName ;
          owl:someValuesFrom xsd:string ]
    )
] .

:Cl_InvoiceOrganizationInvolvement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involves ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasRoleInvolvement ; owl:someValuesFrom :Cl_Role ]
    )
] .

:Cl_EDIFACTInvoiceListing owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :listedInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :inEDIFACTMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :invoice_number ;
    owl:allValuesFrom xsd:string
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:allValuesFrom :Cl_InvoiceDetailReification ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceDate ; owl:allValuesFrom :Cl_InvoiceDate ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:allValuesFrom :Cl_InvoiceNumber ]
    )
] .

:Cl_InvoiceDetailReification owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :relatesToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasProductOrService ; owl:someValuesFrom :Cl_ProductOrService ]
        [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom :Cl_Quantity ]
        [ a owl:Restriction ; owl:onProperty :hasUnitPrice ; owl:someValuesFrom :Cl_UnitPrice ]
        [ a owl:Restriction ; owl:onProperty :hasAmount ; owl:someValuesFrom :Cl_Amount ]
        [ a owl:Restriction ; owl:onProperty :hasCurrency ; owl:someValuesFrom :Cl_Currency ]
    )
] .

:Cl_BuyerAddressRelation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_InvoiceOrganizationRole owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasOrganization ;
    owl:allValuesFrom :Cl_Organization
] .

:Cl_InvoiceOrganizationRole owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_InvoiceOrganizationRole owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasRole ;
    owl:allValuesFrom :Cl_Role
] .

:Cl_Item owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasItemInformation ;
    owl:allValuesFrom :Cl_ItemInformation
] .

:Cl_ItemInformation owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        :Cl_Description
        :Cl_Price
        :Cl_Image
        :Cl_Category
        :Cl_ItemTitle
        :Cl_Seller
        :Cl_ContactInformation
    )
] .

:Cl_Assignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignedDocument ;
    owl:allValuesFrom :Cl_Document
] , [
    a owl:Restriction ;
    owl:onProperty :assignedToBusinessProcess ;
    owl:allValuesFrom :Cl_BusinessProcess
] .

#################################################################
# Disjointness
#################################################################

:Cl_Invoice owl:disjointWith :Cl_Item, :Cl_InvoiceLine, :Cl_Price, :Cl_Amount, :Cl_Currency, :Cl_MonetaryAmount, :Cl_InvoiceAmountReification, :Cl_Assignment, :Cl_BusinessProcess, :Cl_Organization, :Cl_InvoiceParticipant, :Cl_InvoiceOrganizationRole, :Cl_OrganizationParticipation, :Cl_ContactDetail, :Cl_EDIFACTMessage, :Cl_EDIFACTInvoiceListing, :Cl_InvoiceDetail, :Cl_InvoiceDetailReification, :Cl_RequiredElement, :Cl_FileFormat, :Cl_FileFormatSpecification, :Cl_ValidationRule, :Cl_ElementValueConstraint, :Cl_ElementDataType, :Cl_ValidationRequirement, :Cl_FileFormatValidity, :Cl_FileFormatValidityRequirement .

:Cl_Item owl:disjointWith :Cl_InvoiceLine, :Cl_Price, :Cl_Amount, :Cl_Currency, :Cl_InvoiceParticipant, :Cl_InvoiceOrganizationRole .

:Cl_InvoiceLine owl:disjointWith :Cl_Price, :Cl_Amount, :Cl_Currency .

:Cl_Price owl:disjointWith :Cl_Amount, :Cl_Currency .

:Cl_Amount owl:disjointWith :Cl_Currency .

:Cl_OrganizationType owl:disjointWith :Cl_OrganizationRole .

:Cl_OrganizationContactInfo owl:disjointWith :Cl_OrganizationIdentifier, :Cl_OrganizationLocation, :Cl_OrganizationLogo, :Cl_OrganizationWebsite .

:Cl_OrganizationDescription owl:disjointWith :Cl_OrganizationIdentifier .

:Cl_OrganizationWebsite owl:disjointWith :Cl_OrganizationLogo .

:Cl_Organization owl:disjointWith :Cl_Invoice, :Cl_Role, :Cl_InvoiceOrganizationRole, :Cl_InvoiceParticipant, :Cl_InvoiceAmountReification .

:Cl_Invoice owl:disjointWith :Cl_InvoiceParticipant, :Cl_InvoiceOrganizationRole, :Cl_InvoiceAmountReification .

:Cl_InvoiceParticipant owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_InvoiceRole .

:Cl_InvoiceOrganizationRole owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_Role .

:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .

:Cl_Vendor owl:disjointWith :Cl_Customer .
:Cl_Company owl:disjointWith :Cl_Vendor, :Cl_Customer .

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_EDIFACTInvoiceListing .
:Cl_EDIFACTDocument owl:disjointWith :Cl_Invoice, :Cl_EDIFACTInvoiceListing .

:Cl_Buyer owl:disjointWith :Cl_Address, :Cl_BuyerAddressRelation .
:Cl_Address owl:disjointWith :Cl_BuyerAddressRelation .

:Cl_Product owl:disjointWith :Cl_Service .

:Cl_Invoice owl:disjointWith :Cl_InvoiceDetail .
:Cl_ProductOrService owl:disjointWith :Cl_Invoice .
:Cl_Amount owl:disjointWith :Cl_Quantity .

:Cl_InvoiceAmountReification owl:disjointWith :Cl_Invoice, :Cl_MonetaryAmount .

:Cl_FileFormat owl:disjointWith :Cl_RequiredElement, :Cl_FileFormatSpecification, :Cl_ValidationRule, :Cl_ElementValueConstraint, :Cl_ElementDataType, :Cl_ValidationRequirement, :Cl_FileFormatValidity, :Cl_FileFormatValidityRequirement .

:Cl_RequiredElement owl:disjointWith :Cl_ElementDataType, :Cl_ElementValueConstraint, :Cl_ValidationRule .

:Cl_FileFormatSpecification owl:disjointWith :Cl_FileFormatValidityRequirement .

:Cl_Description owl:disjointWith :Cl_Price, :Cl_Image, :Cl_Seller, :Cl_Category, :Cl_ContactInformation, :Cl_ItemTitle .
:Cl_Price owl:disjointWith :Cl_Image, :Cl_Seller, :Cl_Category, :Cl_ContactInformation, :Cl_ItemTitle .
:Cl_Image owl:disjointWith :Cl_Seller, :Cl_Category, :Cl_ContactInformation, :Cl_ItemTitle .
:Cl_Seller owl:disjointWith :Cl_Category, :Cl_ContactInformation, :Cl_ItemTitle .
:Cl_Category owl:disjointWith :Cl_ContactInformation, :Cl_ItemTitle .
:Cl_ContactInformation owl:disjointWith :Cl_ItemTitle .

:Cl_Assignment owl:disjointWith :Cl_Document, :Cl_BusinessProcess .

#################################################################
# End of FestS Ontology
#################################################################
