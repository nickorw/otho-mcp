@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests> a owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document class." .

:Cl_FinancialDocument a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Financial Document" ;
    rdfs:comment "A document related to financial transactions." .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued to indicate a sale transaction and request for payment." ;
    rdfs:subClassOf :Cl_FinancialDocument, :Cl_Document .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item or detail entry within an invoice, specifying products/services, quantity, price, etc." .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Represents an item that is sold in the marketplace." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Product" ;
    rdfs:comment "A tangible product sold in the marketplace." .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Service" ;
    rdfs:comment "A service offered in the marketplace." .

:Cl_Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value for an item." .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "Monetary amount." ;
    rdfs:subClassOf :Cl_Price .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "A currency used in transactions." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, institution, or group involved in an event or process." .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:comment "The type of an organization." .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "A role played by an organization." .

:Cl_OrganizationParticipation a owl:Class ;
    rdfs:label "Organization Participation" ;
    rdfs:comment "Participation of an organization in an event or process." .

:Cl_OrganizationContactInfo a owl:Class ;
    rdfs:label "Organization Contact Info" ;
    rdfs:comment "Contact information for an organization." ;
    rdfs:subClassOf :Cl_ContactDetail .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "An identifier for an organization." ;
    rdfs:subClassOf :Cl_ContactDetail .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A description of an organization." .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "Location of an organization." ;
    rdfs:subClassOf :Cl_ContactDetail .

:Cl_OrganizationLogo a owl:Class ;
    rdfs:label "Organization Logo" ;
    rdfs:comment "Logo of an organization." ;
    rdfs:subClassOf :Cl_ContactDetail .

:Cl_OrganizationWebsite a owl:Class ;
    rdfs:label "Organization Website" ;
    rdfs:comment "Website of an organization." ;
    rdfs:subClassOf :Cl_ContactDetail .

:Cl_OrganizationMember a owl:Class ;
    rdfs:label "Organization Member" ;
    rdfs:comment "A member of an organization." .

:Cl_ContactDetail a owl:Class ;
    rdfs:label "Contact Detail" ;
    rdfs:comment "Contact details for an entity." .

:Cl_InvoiceParticipant a owl:Class ;
    rdfs:label "Invoice Participant" ;
    rdfs:comment "A participant in an invoice transaction." .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A specific role in an invoice." .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "Role of a buyer in an invoice." .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller Role" ;
    rdfs:comment "Role of a seller in an invoice." .

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A generic entity." ;
    rdfs:subClassOf :Cl_Stakeholder .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Company" ;
    rdfs:comment "A company organization." .

:Cl_Vendor a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Vendor" ;
    rdfs:comment "A vendor organization." .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer organization." .

:Cl_InvoiceOrganizationInvolvement a owl:Class ;
    rdfs:label "Invoice Organization Involvement" ;
    rdfs:comment "Involvement of an organization in an invoice." .

:Cl_Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A generic role." .

:Cl_InvoiceOrganizationRole a owl:Class ;
    rdfs:label "Invoice Organization Role" ;
    rdfs:comment "Role of an organization in an invoice." .

:Cl_EDIFACTDocument a owl:Class ;
    rdfs:label "EDIFACT Document" ;
    rdfs:comment "A document in EDIFACT format." ;
    rdfs:subClassOf :Cl_Document .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message in EDIFACT format." ;
    rdfs:subClassOf :Cl_EDIFACTDocument .

:Cl_EDIFACTInvoiceListing a owl:Class ;
    rdfs:label "EDIFACT Invoice Listing" ;
    rdfs:comment "A listing of invoices in an EDIFACT message." ;
    rdfs:subClassOf :Cl_EDIFACTDocument .

:Cl_Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person." ;
    rdfs:subClassOf :Cl_Stakeholder .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person or entity who buys goods or services." .

:Cl_Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address." .

:Cl_BuyerAddressRelation a owl:Class ;
    rdfs:label "Buyer Address Relation" ;
    rdfs:comment "A relation between a buyer and an address." .

:Cl_Stakeholder a owl:Class ;
    rdfs:label "Stakeholder" ;
    rdfs:comment "A stakeholder in a process." ;
    rdfs:subClassOf owl:Thing .

:Cl_ProductOrService a owl:Class ;
    rdfs:label "Product Or Service" ;
    rdfs:comment "A product or service." .

:Cl_Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity of an item." .

:Cl_UnitPrice a owl:Class ;
    rdfs:label "Unit Price" ;
    rdfs:comment "Unit price of an item." .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Details of an invoice." ;
    rdfs:subClassOf :Cl_Invoice .

:Cl_InvoiceDate a owl:Class ;
    rdfs:label "Invoice Date" ;
    rdfs:comment "Date of an invoice." .

:Cl_InvoiceNumber a owl:Class ;
    rdfs:label "Invoice Number" ;
    rdfs:comment "Number of an invoice." .

:Cl_InvoiceDetailReification a owl:Class ;
    rdfs:label "Invoice Detail Reification" ;
    rdfs:comment "Reification of invoice details." .

:Cl_MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount" ;
    rdfs:comment "A monetary amount." .

:Cl_InvoiceAmountReification a owl:Class ;
    rdfs:label "Invoice Amount Reification" ;
    rdfs:comment "Reification of invoice amount." .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process." .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment" ;
    rdfs:comment "An assignment of a document or process." .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format specification." .

:Cl_FileFormatSpecification a owl:Class ;
    rdfs:label "File Format Specification" ;
    rdfs:comment "Specification for a file format." .

:Cl_RequiredElement a owl:Class ;
    rdfs:label "Required Element" ;
    rdfs:comment "A required element in a file format." .

:Cl_ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule for validating data." .

:Cl_ElementValueConstraint a owl:Class ;
    rdfs:label "Element Value Constraint" ;
    rdfs:comment "A constraint on the value of an element." .

:Cl_ElementDataType a owl:Class ;
    rdfs:label "Element Data Type" ;
    rdfs:comment "The data type of an element." .

:Cl_ValidationRequirement a owl:Class ;
    rdfs:label "Validation Requirement" ;
    rdfs:comment "A requirement for validation." ;
    rdfs:subClassOf :Cl_ValidationRule .

:Cl_FileFormatValidity a owl:Class ;
    rdfs:label "File Format Validity" ;
    rdfs:comment "Validity of a file format." ;
    rdfs:subClassOf :Cl_FileFormat .

:Cl_FileFormatValidityRequirement a owl:Class ;
    rdfs:label "File Format Validity Requirement" ;
    rdfs:comment "A requirement for file format validity." ;
    rdfs:subClassOf :Cl_FileFormatValidity .

:Cl_ItemInformation a owl:Class ;
    rdfs:label "Item Information" ;
    rdfs:comment "Information about an item." .

:Cl_Description a owl:Class ;
    rdfs:label "Description" ;
    rdfs:comment "A textual description." .

:Cl_Image a owl:Class ;
    rdfs:label "Image" ;
    rdfs:comment "An image resource." .

:Cl_Seller a owl:Class ;
    rdfs:label "Seller" ;
    rdfs:comment "A seller of items." .

:Cl_Category a owl:Class ;
    rdfs:label "Category" ;
    rdfs:comment "A category for items." .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact information for an item or person." .

:Cl_ItemTitle a owl:Class ;
    rdfs:label "Item Title" ;
    rdfs:comment "The title of an item." .

#################################################################
# Hierarchies
#################################################################

:Cl_Invoice rdfs:subClassOf :Cl_Document, :Cl_FinancialDocument .
:Cl_Product rdfs:subClassOf :Cl_Item .
:Cl_Service rdfs:subClassOf :Cl_Item .
:Cl_Amount rdfs:subClassOf :Cl_Price .
:Cl_OrganizationContactInfo rdfs:subClassOf :Cl_ContactDetail .
:Cl_OrganizationIdentifier rdfs:subClassOf :Cl_ContactDetail .
:Cl_OrganizationLocation rdfs:subClassOf :Cl_ContactDetail .
:Cl_OrganizationLogo rdfs:subClassOf :Cl_ContactDetail .
:Cl_OrganizationWebsite rdfs:subClassOf :Cl_ContactDetail .
:Cl_Buyer rdfs:subClassOf :Cl_Person .
:Cl_Person rdfs:subClassOf :Cl_Stakeholder .
:Cl_ValidationRequirement rdfs:subClassOf :Cl_ValidationRule .
:Cl_ElementValueConstraint rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_ElementDataType rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_RequiredElement rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_ItemInformation rdfs:subClassOf owl:Thing .
:Cl_Description rdfs:subClassOf :Cl_ItemInformation .
:Cl_Price rdfs:subClassOf :Cl_ItemInformation .
:Cl_Image rdfs:subClassOf :Cl_ItemInformation .
:Cl_ItemTitle rdfs:subClassOf :Cl_ItemInformation .
:Cl_Category rdfs:subClassOf :Cl_ItemInformation .
:Cl_ContactInformation rdfs:subClassOf :Cl_ItemInformation .

#################################################################
# Properties
#################################################################

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "has invoice line" ;
    rdfs:comment "Relates an invoice to its invoice lines." ;
    owl:inverseOf :isLineOfInvoice .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "refers to item" ;
    rdfs:comment "Refers an invoice line to an item." ;
    owl:inverseOf :isItemOfLine .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product ;
    rdfs:subPropertyOf :refersToItem ;
    rdfs:label "has product" ;
    rdfs:comment "Refers to a product in an invoice line." ;
    owl:inverseOf :isProductOfLine .

:isProductOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "is product of line" ;
    rdfs:comment "Inverse of hasProduct." ;
    owl:inverseOf :hasProduct .

:hasService a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Service ;
    rdfs:subPropertyOf :refersToItem ;
    rdfs:label "has service" ;
    rdfs:comment "Refers to a service in an invoice line." ;
    owl:inverseOf :isServiceOfLine .

:isServiceOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Service ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "is service of line" ;
    rdfs:comment "Inverse of hasService." ;
    owl:inverseOf :hasService .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal ;
    rdfs:label "quantity" ;
    rdfs:comment "Quantity of the item or service." .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal ;
    rdfs:label "unit price" ;
    rdfs:comment "Unit price for the item or service." .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal ;
    rdfs:label "line total" ;
    rdfs:comment "Total amount for the line." .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The invoice number." ;
    owl:equivalentProperty :invoice_number .

:invoice_number a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number (alt)" ;
    rdfs:comment "Alternative property for invoice number." ;
    owl:equivalentProperty :invoiceNumber .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" ;
    rdfs:comment "The date of the invoice." .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string ;
    rdfs:label "item description" ;
    rdfs:comment "Description of the item." .

:isLineOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is line of invoice" ;
    rdfs:comment "Inverse of hasInvoiceLine." ;
    owl:inverseOf :hasInvoiceLine .

:isItemOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "is item of line" ;
    rdfs:comment "Inverse of refersToItem." ;
    owl:inverseOf :refersToItem .

:hasInvoiceParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipant ;
    rdfs:label "has invoice participant" ;
    rdfs:comment "Relates an invoice to its participants." ;
    owl:inverseOf :isParticipantOfInvoice .

:isParticipantOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipant ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is participant of invoice" ;
    rdfs:comment "Inverse of hasInvoiceParticipant." ;
    owl:inverseOf :hasInvoiceParticipant .

:participantOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipant ;
    rdfs:range :Cl_Organization ;
    rdfs:label "participant organization" ;
    rdfs:comment "Organization participating in the invoice." ;
    owl:inverseOf :organizationParticipant .

:organizationParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipant ;
    rdfs:label "organization participant" ;
    rdfs:comment "Inverse of participantOrganization." ;
    owl:inverseOf :participantOrganization .

:participantRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipant ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "participant role" ;
    rdfs:comment "Role of the participant in the invoice." ;
    owl:inverseOf :hasParticipant .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParticipant ;
    rdfs:label "has participant" ;
    rdfs:comment "Inverse of participantRole." ;
    owl:inverseOf :participantRole .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationType ;
    rdfs:label "has organization type" ;
    rdfs:comment "Type of the organization." ;
    owl:inverseOf :organizationTypeOf .

:organizationTypeOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization type of" ;
    rdfs:comment "Inverse of hasOrganizationType." ;
    owl:inverseOf :hasOrganizationType .

:hasOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationParticipation ;
    rdfs:range :Cl_OrganizationRole ;
    rdfs:label "has organization role" ;
    rdfs:comment "Role of the organization in participation." ;
    owl:inverseOf :organizationRoleOf .

:organizationRoleOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range :Cl_OrganizationParticipation ;
    rdfs:label "organization role of" ;
    rdfs:comment "Inverse of hasOrganizationRole." ;
    owl:inverseOf :hasOrganizationRole .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Organization involved in participation." ;
    owl:inverseOf :organizationInvolvementOf .

:organizationInvolvementOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationParticipation ;
    rdfs:label "organization involvement of" ;
    rdfs:comment "Inverse of involvesOrganization." ;
    owl:inverseOf :involvesOrganization .

:hasOrganizationDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationDescription ;
    rdfs:label "has organization description" ;
    rdfs:comment "Description of the organization." ;
    owl:inverseOf :organizationDescriptionOf .

:organizationDescriptionOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization description of" ;
    rdfs:comment "Inverse of hasOrganizationDescription." ;
    owl:inverseOf :hasOrganizationDescription .

:hasOrganizationIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationIdentifier ;
    rdfs:label "has organization identifier" ;
    rdfs:comment "Identifier for the organization." ;
    owl:inverseOf :organizationIdentifierOf .

:organizationIdentifierOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization identifier of" ;
    rdfs:comment "Inverse of hasOrganizationIdentifier." ;
    owl:inverseOf :hasOrganizationIdentifier .

:hasOrganizationContactInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationContactInfo ;
    rdfs:label "has organization contact info" ;
    rdfs:comment "Contact info for the organization." ;
    owl:inverseOf :organizationContactInfoOf .

:organizationContactInfoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization contact info of" ;
    rdfs:comment "Inverse of hasOrganizationContactInfo." ;
    owl:inverseOf :hasOrganizationContactInfo .

:hasOrganizationLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationLocation ;
    rdfs:label "has organization location" ;
    rdfs:comment "Location of the organization." ;
    owl:inverseOf :organizationLocationOf .

:organizationLocationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization location of" ;
    rdfs:comment "Inverse of hasOrganizationLocation." ;
    owl:inverseOf :hasOrganizationLocation .

:hasOrganizationLogo a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationLogo ;
    rdfs:label "has organization logo" ;
    rdfs:comment "Logo of the organization." ;
    owl:inverseOf :organizationLogoOf .

:organizationLogoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationLogo ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization logo of" ;
    rdfs:comment "Inverse of hasOrganizationLogo." ;
    owl:inverseOf :hasOrganizationLogo .

:hasOrganizationWebsite a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationWebsite ;
    rdfs:label "has organization website" ;
    rdfs:comment "Website of the organization." ;
    owl:inverseOf :organizationWebsiteOf .

:organizationWebsiteOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationWebsite ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization website of" ;
    rdfs:comment "Inverse of hasOrganizationWebsite." ;
    owl:inverseOf :hasOrganizationWebsite .

:hasOrganizationMember a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationMember ;
    rdfs:label "has organization member" ;
    rdfs:comment "A member of the organization." ;
    owl:inverseOf :organizationMemberOf .

:organizationMemberOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationMember ;
    rdfs:range :Cl_Organization ;
    rdfs:label "organization member of" ;
    rdfs:comment "Inverse of hasOrganizationMember." ;
    owl:inverseOf :hasOrganizationMember .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" ;
    rdfs:comment "Name of the organization." .

:organizationShortName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization short name" ;
    rdfs:comment "Short name of the organization." .

:organizationFoundedDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:date ;
    rdfs:label "organization founded date" ;
    rdfs:comment "Date the organization was founded." .

:organizationDissolvedDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:date ;
    rdfs:label "organization dissolved date" ;
    rdfs:comment "Date the organization was dissolved." .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" ;
    rdfs:comment "Value of the identifier." .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range xsd:string ;
    rdfs:label "description text" ;
    rdfs:comment "Textual description." .

:descriptionText_Description a owl:DatatypeProperty ;
    rdfs:domain :Cl_Description ;
    rdfs:range xsd:string ;
    rdfs:label "description text" ;
    rdfs:comment "Textual description." .

:locationAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "location address" ;
    rdfs:comment "Address of the location." .

:logoURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLogo ;
    rdfs:range xsd:anyURI ;
    rdfs:label "logo URL" ;
    rdfs:comment "URL of the organization's logo." .

:websiteURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationWebsite ;
    rdfs:range xsd:anyURI ;
    rdfs:label "website URL" ;
    rdfs:comment "URL of the organization's website." .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact email" ;
    rdfs:comment "Contact email address." .

:contactEmail_ContactInformation a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact email" ;
    rdfs:comment "Contact email address." .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact phone" ;
    rdfs:comment "Contact phone number." .

:contactPhone_ContactInformation a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact phone" ;
