@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/edifact-ontology>
    a owl:Ontology ;
    rdfs:label "EDIFACT Ontology" ;
    rdfs:comment "A deeply structured OWL ontology for modeling EDIFACT business documents, message structures, organizations, roles, and validation constraints." .

#################################################################
# Classes
#################################################################
:EDIFACTInterchange a owl:Class ;
    rdfs:label "EDIFACT Interchange" ;
    rdfs:comment "The envelope containing one or more EDIFACT messages." .

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message within an EDIFACT interchange, such as an Invoice (INVOIC)." ;
    rdfs:subClassOf :EDIFACTInterchange .

:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An INVOIC message in EDIFACT, representing a global trade invoice." ;
    rdfs:subClassOf :EDIFACTMessage .

:EDIFACTSegment a owl:Class ;
    rdfs:label "EDIFACT Segment" ;
    rdfs:comment "A segment within an EDIFACT message, such as BGM or NAD." .

:EDIFACTCompositeDataElement a owl:Class ;
    rdfs:label "EDIFACT Composite Data Element" ;
    rdfs:comment "A composite data element in an EDIFACT segment." .

:EDIFACTSimpleDataElement a owl:Class ;
    rdfs:label "EDIFACT Simple Data Element" ;
    rdfs:comment "A simple data element in a composite or segment." .

:EDIFACTHeaderSection a owl:Class ;
    rdfs:label "EDIFACT Header Section" ;
    rdfs:comment "Header section of an EDIFACT message, containing document dates and reference numbers." .

:EDIFACTDetailSection a owl:Class ;
    rdfs:label "EDIFACT Detail Section" ;
    rdfs:comment "Detail section listing line items, prices, and quantities." .

:EDIFACTSummarySection a owl:Class ;
    rdfs:label "EDIFACT Summary Section" ;
    rdfs:comment "Summary section providing totals such as tax and invoice amounts." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity involved in an invoice, such as buyer or delivery party." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in a business process or invoice (e.g., Buyer, Seller, Delivery Party)." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal or physical address associated with an organization or role." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item or product listed in the invoice." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A monetary value assigned to an item, such as net price." .

:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity of an item in the invoice." .

:Tax a owl:Class ;
    rdfs:label "Tax" ;
    rdfs:comment "A tax amount applied to the invoice." .

:ReferenceNumber a owl:Class ;
    rdfs:label "Reference Number" ;
    rdfs:comment "A reference number in the invoice header, such as invoice number or order reference." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which an invoice can be assigned, such as procurement or payment." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "An identifier for an organization, such as a GLN or DUNS number." .

:ValidationConstraint a owl:Class ;
    rdfs:label "Validation Constraint" ;
    rdfs:comment "A constraint or rule (e.g., SHACL) for validating document consistency and completeness." .

:RoleAssignment a owl:Class ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "A pivot class reifying the relationship of an organization playing a specific role in an invoice." .

#################################################################
# Disjointness and Unions
#################################################################
:EDIFACTInterchange owl:disjointWith :Organization, :Item, :Address, :BusinessProcess, :RoleAssignment, :ValidationConstraint, :Identifier .
:EDIFACTHeaderSection owl:disjointWith :EDIFACTDetailSection, :EDIFACTSummarySection .
:EDIFACTDetailSection owl:disjointWith :EDIFACTSummarySection .

[ owl:disjointUnionOf ( :EDIFACTHeaderSection :EDIFACTDetailSection :EDIFACTSummarySection ) ] .

#################################################################
# Object Properties and Inverses
#################################################################
:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains message" ;
    rdfs:comment "Relates an interchange to the messages it contains." ;
    rdfs:domain :EDIFACTInterchange ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :isContainedInInterchange .

:isContainedInInterchange a owl:ObjectProperty ;
    rdfs:label "is contained in interchange" ;
    rdfs:comment "Inverse of containsMessage: relates a message to its containing interchange." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :EDIFACTInterchange .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has section" ;
    rdfs:comment "Relates a message to one of its sections (header, detail, summary)." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range owl:Thing ;
    owl:inverseOf :isSectionOf .

:isSectionOf a owl:ObjectProperty ;
    rdfs:label "is section of" ;
    rdfs:comment "Inverse of hasSection: relates a section to its message." ;
    rdfs:domain owl:Thing ;
    rdfs:range :EDIFACTMessage .

:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:comment "Relates a message to its segments." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :EDIFACTSegment ;
    owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
    rdfs:label "is segment of" ;
    rdfs:comment "Inverse of hasSegment: relates a segment to its message." ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :EDIFACTMessage .

:hasCompositeElement a owl:ObjectProperty ;
    rdfs:label "has composite element" ;
    rdfs:comment "Relates a segment to its composite data elements." ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :EDIFACTCompositeDataElement ;
    owl:inverseOf :isCompositeElementOf .

:isCompositeElementOf a owl:ObjectProperty ;
    rdfs:label "is composite element of" ;
    rdfs:comment "Inverse of hasCompositeElement: relates a composite element to its segment." ;
    rdfs:domain :EDIFACTCompositeDataElement ;
    rdfs:range :EDIFACTSegment .

:hasSimpleElement a owl:ObjectProperty ;
    rdfs:label "has simple element" ;
    rdfs:comment "Relates a composite element to its simple data elements." ;
    rdfs:domain :EDIFACTCompositeDataElement ;
    rdfs:range :EDIFACTSimpleDataElement ;
    owl:inverseOf :isSimpleElementOf .

:isSimpleElementOf a owl:ObjectProperty ;
    rdfs:label "is simple element of" ;
    rdfs:comment "Inverse of hasSimpleElement: relates a simple element to its composite." ;
    rdfs:domain :EDIFACTSimpleDataElement ;
    rdfs:range :EDIFACTCompositeDataElement .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Relates an invoice message to a role assignment (organization + role)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :isRoleAssignmentOf .

:isRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:label "is role assignment of" ;
    rdfs:comment "Inverse of hasRoleAssignment: relates a role assignment to its invoice message." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :InvoiceMessage .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:label "involves organization" ;
    rdfs:comment "Relates a role assignment to the involved organization." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Inverse of involvesOrganization: relates an organization to its role assignments." ;
    rdfs:domain :Organization ;
    rdfs:range :RoleAssignment .

:hasAgentRole a owl:ObjectProperty ;
    rdfs:label "has agent role" ;
    rdfs:comment "Relates a role assignment to the agent role." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :AgentRole ;
    owl:inverseOf :isAgentRoleOf .

:isAgentRoleOf a owl:ObjectProperty ;
    rdfs:label "is agent role of" ;
    rdfs:comment "Inverse of hasAgentRole: relates an agent role to its role assignments." ;
    rdfs:domain :AgentRole ;
    rdfs:range :RoleAssignment .

:relatesToInvoice a owl:ObjectProperty ;
    rdfs:label "relates to invoice" ;
    rdfs:comment "Relates a role assignment to a specific invoice message." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasRoleAssignmentRelation .

:hasRoleAssignmentRelation a owl:ObjectProperty ;
    rdfs:label "has role assignment relation" ;
    rdfs:comment "Inverse of relatesToInvoice: relates an invoice message to its role assignments." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :RoleAssignment .

:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an organization to its address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse of hasAddress: relates an address to its organization." ;
    rdfs:domain :Address ;
    rdfs:range :Organization .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "has identifier" ;
    rdfs:comment "Relates an organization to its identifier (GLN, DUNS, etc.)." ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier ;
    owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Inverse of hasIdentifier: relates an identifier to its organization." ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization .

:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Relates a detail section to its items." ;
    rdfs:domain :EDIFACTDetailSection ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOf .

:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:comment "Inverse of hasItem: relates an item to its detail section." ;
    rdfs:domain :Item ;
    rdfs:range :EDIFACTDetailSection .

:hasPrice a owl:ObjectProperty ;
    rdfs:label "has price" ;
    rdfs:comment "Relates an item to its price." ;
    rdfs:domain :Item ;
    rdfs:range :Price ;
    owl:inverseOf :isPriceOf .

:isPriceOf a owl:ObjectProperty ;
    rdfs:label "is price of" ;
    rdfs:comment "Inverse of hasPrice: relates a price to its item." ;
    rdfs:domain :Price ;
    rdfs:range :Item .

:hasQuantity a owl:ObjectProperty ;
    rdfs:label "has quantity" ;
    rdfs:comment "Relates an item to its quantity." ;
    rdfs:domain :Item ;
    rdfs:range :Quantity ;
    owl:inverseOf :isQuantityOf .

:isQuantityOf a owl:ObjectProperty ;
    rdfs:label "is quantity of" ;
    rdfs:comment "Inverse of hasQuantity: relates a quantity to its item." ;
    rdfs:domain :Quantity ;
    rdfs:range :Item .

:hasTax a owl:ObjectProperty ;
    rdfs:label "has tax" ;
    rdfs:comment "Relates a summary section to taxes." ;
    rdfs:domain :EDIFACTSummarySection ;
    rdfs:range :Tax ;
    owl:inverseOf :isTaxOf .

:isTaxOf a owl:ObjectProperty ;
    rdfs:label "is tax of" ;
    rdfs:comment "Inverse of hasTax: relates a tax to its summary section." ;
    rdfs:domain :Tax ;
    rdfs:range :EDIFACTSummarySection .

:hasReferenceNumber a owl:ObjectProperty ;
    rdfs:label "has reference number" ;
    rdfs:comment "Relates a header section to its reference numbers." ;
    rdfs:domain :EDIFACTHeaderSection ;
    rdfs:range :ReferenceNumber ;
    owl:inverseOf :isReferenceNumberOf .

:isReferenceNumberOf a owl:ObjectProperty ;
    rdfs:label "is reference number of" ;
    rdfs:comment "Inverse of hasReferenceNumber: relates a reference number to its header section." ;
    rdfs:domain :ReferenceNumber ;
    rdfs:range :EDIFACTHeaderSection .

:assignedToBusinessProcess a owl:ObjectProperty ;
    rdfs:label "assigned to business process" ;
    rdfs:comment "Relates an invoice message to a business process." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :isBusinessProcessOf .

:isBusinessProcessOf a owl:ObjectProperty ;
    rdfs:label "is business process of" ;
    rdfs:comment "Inverse of assignedToBusinessProcess: relates a business process to its invoice messages." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage .

:satisfiesConstraint a owl:ObjectProperty ;
    rdfs:label "satisfies constraint" ;
    rdfs:comment "Relates an invoice message to validation constraints." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ValidationConstraint ;
    owl:inverseOf :isConstraintSatisfiedBy .

:isConstraintSatisfiedBy a owl:ObjectProperty ;
    rdfs:label "is constraint satisfied by" ;
    rdfs:comment "Inverse of satisfiesConstraint: relates a validation constraint to the invoice(s) it validates." ;
    rdfs:domain :ValidationConstraint ;
    rdfs:range :InvoiceMessage .

#################################################################
# Data Properties
#################################################################
:segmentCode a owl:DatatypeProperty ;
    rdfs:label "segment code" ;
    rdfs:comment "The code for a segment, such as 'BGM' or 'NAD'." ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range xsd:string .

:elementValue a owl:DatatypeProperty ;
    rdfs:label "element value" ;
    rdfs:comment "The value of a simple data element." ;
    rdfs:domain :EDIFACTSimpleDataElement ;
    rdfs:range xsd:string .

:organizationName a owl:DatatypeProperty ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of an organization." ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .

:roleCode a owl:DatatypeProperty ;
    rdfs:label "role code" ;
    rdfs:comment "A code representing the agent role (e.g., 'BY' for buyer)." ;
    rdfs:domain :AgentRole ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:label "address line" ;
    rdfs:comment "A line of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "A postal code for an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "The city in an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code" ;
    rdfs:comment "The country code for an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:identifierValue a owl:DatatypeProperty ;
    rdfs:label "identifier value" ;
    rdfs:comment "The value of an identifier such as a GLN number." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:identifierType a owl:DatatypeProperty ;
    rdfs:label "identifier type" ;
    rdfs:comment "The type of identifier (e.g., GLN, DUNS)." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:label "item description" ;
    rdfs:comment "A description of an item in the invoice." ;
    rdfs:domain :Item ;
    rdfs:range xsd:string .

:priceAmount a owl:DatatypeProperty ;
    rdfs:label "price amount" ;
    rdfs:comment "The net price of an item." ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal .

:currencyCode a owl:DatatypeProperty ;
    rdfs:label "currency code" ;
    rdfs:comment "The currency code for a price (e.g., EUR, USD)." ;
    rdfs:domain :Price ;
    rdfs:range xsd:string .

:quantityValue a owl:DatatypeProperty ;
    rdfs:label "quantity value" ;
    rdfs:comment "The quantity value for an item." ;
    rdfs:domain :Quantity ;
    rdfs:range xsd:decimal .

:taxAmount a owl:DatatypeProperty ;
    rdfs:label "tax amount" ;
    rdfs:comment "The amount of tax applied." ;
    rdfs:domain :Tax ;
    rdfs:range xsd:decimal .

:taxType a owl:DatatypeProperty ;
    rdfs:label "tax type" ;
    rdfs:comment "The type or category of tax." ;
    rdfs:domain :Tax ;
    rdfs:range xsd:string .

:referenceNumberValue a owl:DatatypeProperty ;
    rdfs:label "reference number value" ;
    rdfs:comment "The value of a reference number." ;
    rdfs:domain :ReferenceNumber ;
    rdfs:range xsd:string .

:issueDate a owl:DatatypeProperty ;
    rdfs:label "issue date" ;
    rdfs:comment "The date the invoice was issued (string for OWL2 DL compliance)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:label "invoice number" ;
    rdfs:comment "The unique invoice number." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string .

:totalAmount a owl:DatatypeProperty ;
    rdfs:label "total amount" ;
    rdfs:comment "The total invoice amount in the summary section." ;
    rdfs:domain :EDIFACTSummarySection ;
    rdfs:range xsd:decimal .

#################################################################
# Property Characteristics and Complex Axioms
#################################################################
# All properties have been annotated and domains/ranges specified.
# RoleAssignment is used for reification of organization-role-invoice relationships.
# ValidationConstraint is a pivot for SHACL/mandatory checks.

# Additional complex axioms (GCAs and equivalence) can be added as restrictions as needed.
