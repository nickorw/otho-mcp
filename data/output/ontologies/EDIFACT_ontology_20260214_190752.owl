@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/EDIFACT> a owl:Ontology ;
    rdfs:label "EDIFACT Ontology" ;
    rdfs:comment "An ontology for modeling EDIFACT messages, invoices, organizations, roles, items, and related business processes." .

#################################################################
# Classes
#################################################################
:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message in the EDIFACT standard, which may contain one or more invoices." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice contained in an EDIFACT message." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity involved in the invoice, such as a buyer or seller." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role played by an organization in an invoice context." .

:BuyerRole a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "A role indicating the organization is the buyer in the invoice." .

:SellerRole a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Seller Role" ;
    rdfs:comment "A role indicating the organization is the seller in the invoice." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "The address of an organization involved in the invoice." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed in the invoice." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Details about the invoice, such as amount and number." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which the invoice may be assigned." .

:InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "A pivot class representing the association between an invoice and an item, including quantity and price." .

:InvoiceParticipant a owl:Class ;
    rdfs:label "Invoice Participant" ;
    rdfs:comment "A pivot class representing the participation of an organization in an invoice with a specific role." .

#################################################################
# Disjointness
#################################################################
:Organization owl:disjointWith :Role, :Invoice, :Item, :Address .
:Role owl:disjointWith :Invoice, :Item, :Address .
:Invoice owl:disjointWith :Item, :Address .
:Item owl:disjointWith :Address .

#################################################################
# Object Properties and Inverses
#################################################################
:hasInvoice a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Invoice ;
    owl:inverseOf :isInvoiceInMessage ;
    rdfs:label "has invoice" ;
    rdfs:comment "Relates an EDIFACT message to an invoice it contains." .

:isInvoiceInMessage a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessage ;
    rdfs:label "is invoice in message" ;
    rdfs:comment "Inverse of hasInvoice; relates an invoice to the EDIFACT message containing it." .

:involvesParticipant a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceParticipant ;
    owl:inverseOf :isParticipantInvolvedIn ;
    rdfs:label "involves participant" ;
    rdfs:comment "Associates an invoice with its participants (organizations in roles)." .

:isParticipantInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :InvoiceParticipant ;
    rdfs:range :Invoice ;
    rdfs:label "is participant involved in" ;
    rdfs:comment "Inverse of involvesParticipant; relates a participant to the invoice." .

:participantOrganization a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :InvoiceParticipant ;
    rdfs:range :Organization ;
    owl:inverseOf :organizationHasParticipant ;
    rdfs:label "participant organization" ;
    rdfs:comment "The organization involved as a participant in the invoice." .

:organizationHasParticipant a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceParticipant ;
    rdfs:label "organization has participant" ;
    rdfs:comment "Inverse of participantOrganization; relates organization to participant role in invoice." .

:participantRole a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :InvoiceParticipant ;
    rdfs:range :Role ;
    owl:inverseOf :roleIsForParticipant ;
    rdfs:label "participant role" ;
    rdfs:comment "The role played by the participant organization in the invoice." .

:roleIsForParticipant a owl:ObjectProperty ;
    rdfs:domain :Role ;
    rdfs:range :InvoiceParticipant ;
    rdfs:label "role is for participant" ;
    rdfs:comment "Inverse of participantRole; relates a role to the participants it is assigned to." .

:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf ;
    rdfs:label "has address" ;
    rdfs:comment "The address of the organization." .

:isAddressOf a owl:ObjectProperty ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse of hasAddress; relates an address to the organization it belongs to." .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceItem ;
    owl:inverseOf :isInvoiceItemOf ;
    rdfs:label "has invoice item" ;
    rdfs:comment "Associates an invoice with its invoice items (pivot class)." .

:isInvoiceItemOf a owl:ObjectProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range :Invoice ;
    rdfs:label "is invoice item of" ;
    rdfs:comment "Inverse of hasInvoiceItem; relates invoice item to its invoice." .

:itemOf a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range :Item ;
    owl:inverseOf :isItemForInvoiceItem ;
    rdfs:label "item of" ;
    rdfs:comment "The item described by the invoice item." .

:isItemForInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceItem ;
    rdfs:label "is item for invoice item" ;
    rdfs:comment "Inverse of itemOf; relates item to invoice item." .

:assignedToBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :businessProcessHasInvoice ;
    rdfs:label "assigned to business process" ;
    rdfs:comment "Associates an invoice with a business process." .

:businessProcessHasInvoice a owl:ObjectProperty ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Invoice ;
    rdfs:label "business process has invoice" ;
    rdfs:comment "Inverse of assignedToBusinessProcess; relates a business process to its invoice." .

:hasInvoiceDetail a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceDetail ;
    owl:inverseOf :isDetailOfInvoice ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Associates an invoice with its detail information." .

:isDetailOfInvoice a owl:ObjectProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Invoice ;
    rdfs:label "is detail of invoice" ;
    rdfs:comment "Inverse of hasInvoiceDetail; relates invoice detail to the invoice." .

#################################################################
# Data Properties
#################################################################
:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization." .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:label "address line" ;
    rdfs:comment "The address line of the address." .

:city a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:label "city" ;
    rdfs:comment "The city of the address." .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:label "postal code" ;
    rdfs:comment "The postal code of the address." .

:country a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:label "country" ;
    rdfs:comment "The country of the address." .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Item ;
    rdfs:range xsd:string ;
    rdfs:label "item description" ;
    rdfs:comment "A description of the item." .

:itemQuantity a owl:DatatypeProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range xsd:integer ;
    rdfs:label "item quantity" ;
    rdfs:comment "The quantity of the item in the invoice item." .

:netPrice a owl:DatatypeProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "net price" ;
    rdfs:comment "The net price of the item in the invoice item." .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range xsd:decimal ;
    rdfs:label "invoice amount" ;
    rdfs:comment "The total amount of the invoice." .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The unique invoice number." .

#################################################################
# Complex Axioms and Restrictions
#################################################################
:InvoiceParticipant owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :participantOrganization ; owl:allValuesFrom :Organization ]
        [ a owl:Restriction ; owl:onProperty :participantRole ; owl:allValuesFrom :Role ]
    )
] .

:InvoiceItem owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :itemOf ; owl:allValuesFrom :Item ]
        [ a owl:Restriction ; owl:onProperty :itemQuantity ; owl:allValuesFrom xsd:integer ]
        [ a owl:Restriction ; owl:onProperty :netPrice ; owl:allValuesFrom xsd:decimal ]
    )
] .
