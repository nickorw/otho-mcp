@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#EDIFACTInvoiceStory> a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Story Ontology" ;
    rdfs:comment "Ontology modeling the structure and semantics of EDIFACT invoice messages, roles, and validation as described in the procurement scenario." .

#################################################################
# Classes
#################################################################
:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The root envelope for EDIFACT messages, containing one or more messages." .
:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A generic EDIFACT message, such as INVOIC." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasSegment ; owl:someValuesFrom :Segment ] .
:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An EDIFACT message representing an invoice." ;
    rdfs:subClassOf :EDIFACTMessage, [ a owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :Section ] .
:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "A segment of an EDIFACT message, e.g., BGM or NAD." .
:BGMSegment a owl:Class ;
    rdfs:label "BGM Segment" ;
    rdfs:comment "Beginning of Message segment for document identification." ;
    rdfs:subClassOf :Segment .
:NADSegment a owl:Class ;
    rdfs:label "NAD Segment" ;
    rdfs:comment "Name and Address segment for participant details." ;
    rdfs:subClassOf :Segment .
:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite data element within a segment, containing multiple simple elements." .
:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A simple data element within a segment or composite element." .
:Section a owl:Class ;
    rdfs:label "Section" ;
    rdfs:comment "A section of the invoice message (header, detail, summary)." .
:HeaderSection a owl:Class ;
    rdfs:label "Header Section" ;
    rdfs:comment "Header section containing document dates and reference numbers." ;
    rdfs:subClassOf :Section .
:DetailSection a owl:Class ;
    rdfs:label "Detail Section" ;
    rdfs:comment "Detail section listing line items." ;
    rdfs:subClassOf :Section .
:SummarySection a owl:Class ;
    rdfs:label "Summary Section" ;
    rdfs:comment "Summary section providing totals and taxes." ;
    rdfs:subClassOf :Section .
:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization involved in the invoice (buyer, seller, delivery party, etc.)." .
:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in the context of an invoice (e.g., Buyer, Seller)." .
:RoleAssignment a owl:Class ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "Reified assignment of a role to an organization in a specific invoice context." .
:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "Postal address details for an organization." .
:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A generic identifier for an organization or item." .
:GlobalLocationNumber a owl:Class ;
    rdfs:label "Global Location Number" ;
    rdfs:comment "A global location identifier as used in EDIFACT messages." ;
    rdfs:subClassOf :Identifier .
:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed on the invoice." .
:InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item in the detail section of the invoice." .
:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "The price of an item on the invoice." .
:Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A monetary amount (total, line, or tax)." .
:Tax a owl:Class ;
    rdfs:label "Tax" ;
    rdfs:comment "A tax amount applied to the invoice or its lines." .
:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which the invoice can be assigned." .
:EN16931Alignment a owl:Class ;
    rdfs:label "EN 16931 Alignment" ;
    rdfs:comment "Represents alignment with the European Standard EN 16931-1." .
:P2POAlignment a owl:Class ;
    rdfs:label "P2P-O Alignment" ;
    rdfs:comment "Represents alignment with the Purchase-to-Pay Ontology (P2P-O)." .
:SHACLConstraint a owl:Class ;
    rdfs:label "SHACL Constraint" ;
    rdfs:comment "A SHACL constraint for automated validation of invoice data." .

#################################################################
# Disjoint Unions and Disjointness
#################################################################
:Section owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .
:Organization owl:disjointWith :Item, :Segment, :Section, :BusinessProcess .

#################################################################
# Object Properties
#################################################################
:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains message" ;
    rdfs:comment "Links an Interchange Envelope to its contained EDIFACT message(s)." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :isContainedInEnvelope .
:isContainedInEnvelope a owl:ObjectProperty ;
    rdfs:label "is contained in envelope" ;
    rdfs:comment "Inverse: links an EDIFACT message to its containing InterchangeEnvelope." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :InterchangeEnvelope ;
    owl:inverseOf :containsMessage .
:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:comment "Links an EDIFACT message to its segments." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Segment ;
    owl:inverseOf :isSegmentOf .
:isSegmentOf a owl:ObjectProperty ;
    rdfs:label "is segment of" ;
    rdfs:comment "Inverse: links a Segment to its containing EDIFACT message." ;
    rdfs:domain :Segment ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :hasSegment .
:hasSection a owl:ObjectProperty ;
    rdfs:label "has section" ;
    rdfs:comment "Links an Invoice Message to its sections (header, detail, summary)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Section ;
    owl:inverseOf :isSectionOf .
:isSectionOf a owl:ObjectProperty ;
    rdfs:label "is section of" ;
    rdfs:comment "Inverse: links a Section to its Invoice Message." ;
    rdfs:domain :Section ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasSection .
:hasLine a owl:ObjectProperty ;
    rdfs:label "has line" ;
    rdfs:comment "Links a Detail Section to its invoice lines." ;
    rdfs:domain :DetailSection ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :isLineOf .
:isLineOf a owl:ObjectProperty ;
    rdfs:label "is line of" ;
    rdfs:comment "Inverse: links an Invoice Line to its Detail Section." ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :DetailSection ;
    owl:inverseOf :hasLine .
:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Links an Invoice Line to the item being sold." ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOf .
:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:comment "Inverse: links an Item to its Invoice Line." ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :hasItem .
:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has price" ;
    rdfs:comment "Links an Invoice Line to its price." ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :Price ;
    owl:inverseOf :isPriceOf .
:isPriceOf a owl:ObjectProperty ;
    rdfs:label "is price of" ;
    rdfs:comment "Inverse: links a Price to its Invoice Line." ;
    rdfs:domain :Price ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :hasPrice .
:hasAmount a owl:ObjectProperty ;
    rdfs:label "has amount" ;
    rdfs:comment "Links an Invoice Message to a monetary amount (total, etc.)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Amount ;
    owl:inverseOf :isAmountOf .
:isAmountOf a owl:ObjectProperty ;
    rdfs:label "is amount of" ;
    rdfs:comment "Inverse: links an Amount to its Invoice Message." ;
    rdfs:domain :Amount ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasAmount .
:hasTax a owl:ObjectProperty ;
    rdfs:label "has tax" ;
    rdfs:comment "Links an Invoice Message to tax details." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Tax ;
    owl:inverseOf :isTaxOf .
:isTaxOf a owl:ObjectProperty ;
    rdfs:label "is tax of" ;
    rdfs:comment "Inverse: links a Tax to its Invoice Message." ;
    rdfs:domain :Tax ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasTax .
:hasOrganizationRole a owl:ObjectProperty ;
    rdfs:label "has organization role" ;
    rdfs:comment "Links an Invoice Message to a role assignment for an organization." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :isOrganizationRoleOf .
:isOrganizationRoleOf a owl:ObjectProperty ;
    rdfs:label "is organization role of" ;
    rdfs:comment "Inverse: links a RoleAssignment to its Invoice Message." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasOrganizationRole .
:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role" ;
    rdfs:comment "Links an Organization to its role assignments." ;
    rdfs:domain :Organization ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :isRolePlayedBy .
:isRolePlayedBy a owl:ObjectProperty ;
    rdfs:label "is role played by" ;
    rdfs:comment "Inverse: links a RoleAssignment to the Organization playing the role." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :playsRole .
:hasAgentRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has agent role" ;
    rdfs:comment "Links a RoleAssignment to the AgentRole played (e.g., Buyer)." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :AgentRole ;
    owl:inverseOf :isAgentRoleOf .
:isAgentRoleOf a owl:ObjectProperty ;
    rdfs:label "is agent role of" ;
    rdfs:comment "Inverse: links an AgentRole to the RoleAssignment where it is played." ;
    rdfs:domain :AgentRole ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :hasAgentRole .
:involvesOrganization a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links a RoleAssignment to the Organization involved." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :isOrganizationInvolvedIn .
:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Inverse: links an Organization to the RoleAssignment where it is involved." ;
    rdfs:domain :Organization ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :involvesOrganization .
:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Links an Organization to its address(es)." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .
:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse: links an Address to the Organization it belongs to." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .
:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "has identifier" ;
    rdfs:comment "Links an Organization to its identifiers." ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier ;
    owl:inverseOf :isIdentifierOf .
:isIdentifierOf a owl:ObjectProperty ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Inverse: links an Identifier to the Organization it identifies." ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization ;
    owl:inverseOf :hasIdentifier .
:hasGlobalLocationNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has global location number" ;
    rdfs:comment "Links an Organization to a global location number." ;
    rdfs:domain :Organization ;
    rdfs:range :GlobalLocationNumber ;
    owl:inverseOf :isGlobalLocationNumberOf .
:isGlobalLocationNumberOf a owl:ObjectProperty ;
    rdfs:label "is global location number of" ;
    rdfs:comment "Inverse: links a Global Location Number to the Organization it belongs to." ;
    rdfs:domain :GlobalLocationNumber ;
    rdfs:range :Organization ;
    owl:inverseOf :hasGlobalLocationNumber .
:alignsWithEN16931 a owl:ObjectProperty ;
    rdfs:label "aligns with EN 16931" ;
    rdfs:comment "Links an Invoice Message to an EN 16931 Alignment instance." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :EN16931Alignment ;
    owl:inverseOf :isEN16931AlignmentOf .
:isEN16931AlignmentOf a owl:ObjectProperty ;
    rdfs:label "is EN 16931 alignment of" ;
    rdfs:comment "Inverse: links EN16931Alignment to Invoice Message." ;
    rdfs:domain :EN16931Alignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :alignsWithEN16931 .
:alignsWithP2PO a owl:ObjectProperty ;
    rdfs:label "aligns with P2P-O" ;
    rdfs:comment "Links an Invoice Message to a P2P-O Alignment instance." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :P2POAlignment ;
    owl:inverseOf :isP2POAlignmentOf .
:isP2POAlignmentOf a owl:ObjectProperty ;
    rdfs:label "is P2P-O alignment of" ;
    rdfs:comment "Inverse: links P2POAlignment to Invoice Message." ;
    rdfs:domain :P2POAlignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :alignsWithP2PO .
:validatedBySHACL a owl:ObjectProperty ;
    rdfs:label "validated by SHACL" ;
    rdfs:comment "Links an Invoice Message to a SHACL constraint." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :SHACLConstraint ;
    owl:inverseOf :isSHACLConstraintOf .
:isSHACLConstraintOf a owl:ObjectProperty ;
    rdfs:label "is SHACL constraint of" ;
    rdfs:comment "Inverse: links SHACLConstraint to Invoice Message." ;
    rdfs:domain :SHACLConstraint ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :validatedBySHACL .
:assignedToProcess a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to process" ;
    rdfs:comment "Links an Invoice Message to a business process." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :isProcessOf .
:isProcessOf a owl:ObjectProperty ;
    rdfs:label "is process of" ;
    rdfs:comment "Inverse: links a BusinessProcess to its Invoice Message." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :assignedToProcess .
# CompositeDataElement connections
:hasCompositeElement a owl:ObjectProperty ;
    rdfs:label "has composite data element" ;
    rdfs:comment "Links a Segment to its composite data elements." ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :isCompositeElementOf .
:isCompositeElementOf a owl:ObjectProperty ;
    rdfs:label "is composite element of" ;
    rdfs:comment "Inverse: links a CompositeDataElement to its Segment." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment ;
    owl:inverseOf :hasCompositeElement .
:hasSimpleElement a owl:ObjectProperty ;
    rdfs:label "has simple data element" ;
    rdfs:comment "Links a CompositeDataElement to its simple data elements." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    owl:inverseOf :isSimpleElementOf .
:isSimpleElementOf a owl:ObjectProperty ;
    rdfs:label "is simple element of" ;
    rdfs:comment "Inverse: links a SimpleDataElement to its CompositeDataElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :hasSimpleElement .

#################################################################
# Data Properties
#################################################################
:hasInvoiceNumber a owl:DatatypeProperty ;
    rdfs:label "has invoice number" ;
    rdfs:comment "The invoice number for the invoice message." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string .
:hasDocumentDate a owl:DatatypeProperty ;
    rdfs:label "has document date" ;
    rdfs:comment "The date of the document in the header section (as string)." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .
:hasReferenceNumber a owl:DatatypeProperty ;
    rdfs:label "has reference number" ;
    rdfs:comment "A reference number in the header section." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .
:hasNetPrice a owl:DatatypeProperty ;
    rdfs:label "has net price" ;
    rdfs:comment "The net price for an item in the invoice." ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal .
:hasQuantity a owl:DatatypeProperty ;
    rdfs:label "has quantity" ;
    rdfs:comment "The quantity of items sold in a line." ;
    rdfs:domain :InvoiceLine ;
    rdfs:range xsd:decimal .
:hasTotalAmount a owl:DatatypeProperty ;
    rdfs:label "has total amount" ;
    rdfs:comment "The total amount for the invoice." ;
    rdfs:domain :Amount ;
    rdfs:range xsd:decimal .
:hasTaxAmount a owl:DatatypeProperty ;
    rdfs:label "has tax amount" ;
    rdfs:comment "The tax amount for the invoice or a line." ;
    rdfs:domain :Tax ;
    rdfs:range xsd:decimal .
:hasName a owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:comment "The name of an organization or item." ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .
:hasRoleName a owl:DatatypeProperty ;
    rdfs:label "has role name" ;
    rdfs:comment "The name of an agent role (e.g., Buyer, Seller)." ;
    rdfs:domain :AgentRole ;
    rdfs:range xsd:string .
:hasStreet a owl:DatatypeProperty ;
    rdfs:label "has street" ;
    rdfs:comment "Street component of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .
:hasCity a owl:DatatypeProperty ;
    rdfs:label "has city" ;
    rdfs:comment "City component of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .
:hasPostalCode a owl:DatatypeProperty ;
    rdfs:label "has postal code" ;
    rdfs:comment "Postal code component of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .
:hasCountry a owl:DatatypeProperty ;
    rdfs:label "has country" ;
    rdfs:comment "Country component of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .
:hasIdentifierValue a owl:DatatypeProperty ;
    rdfs:label "has identifier value" ;
    rdfs:comment "Identifier value (string)." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .
:hasSegmentCode a owl:DatatypeProperty ;
    rdfs:label "has segment code" ;
    rdfs:comment "The EDIFACT code of a segment (e.g., 'BGM', 'NAD')." ;
    rdfs:domain :Segment ;
    rdfs:range xsd:string .
:hasElementValue a owl:DatatypeProperty ;
    rdfs:label "has element value" ;
    rdfs:comment "Value of a simple data element." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string .

#################################################################
# Complex Axioms & Restrictions
#################################################################
:BuyerRoleAssignment a owl:Class ;
    rdfs:label "Buyer Role Assignment" ;
    rdfs:comment "A role assignment where the agent role is Buyer." ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RoleAssignment [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:hasValue :Buyer ] ) ] .

:DetailSection rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasLine ; owl:allValuesFrom :InvoiceLine ] .
:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOrganizationRole ; owl:someValuesFrom :RoleAssignment ] .

#################################################################
# Individuals (for EDIFACT codes and roles)
#################################################################
:Buyer a :AgentRole ;
    rdfs:label "Buyer" ;
    rdfs:comment "The role of buyer in an invoice context." ;
    :hasRoleName "Buyer" .
:Seller a :AgentRole ;
    rdfs:label "Seller" ;
    rdfs:comment "The role of seller in an invoice context." ;
    :hasRoleName "Seller" .
:DeliveryParty a :AgentRole ;
    rdfs:label "Delivery Party" ;
    rdfs:comment "The role of delivery party in an invoice context." ;
    :hasRoleName "Delivery Party" .

#################################################################
# Alignment & Validation Individuals
#################################################################
:EN16931AlignmentInstance a :EN16931Alignment ;
    rdfs:label "EN 16931 Alignment Instance" ;
    rdfs:comment "Instance representing EN 16931-1 alignment." .
:P2POAlignmentInstance a :P2POAlignment ;
    rdfs:label "P2P-O Alignment Instance" ;
    rdfs:comment "Instance representing P2P-O alignment." .
:SHACLConstraintInstance a :SHACLConstraint ;
    rdfs:label "SHACL Constraint Instance" ;
    rdfs:comment "Instance representing SHACL-based validation." .
