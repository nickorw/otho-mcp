@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/edifact-invoice-ontology>
    a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Ontology" ;
    rdfs:comment "Ontology for representing UN/EDIFACT digital business documents, invoice messages, organizational roles, and technical validation structures." .

#################################################################
# Classes
#################################################################

:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The root envelope of an EDIFACT interchange, containing one or more messages." .

:Message a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A generic message within an EDIFACT interchange." .

:InvoiceMessage a owl:Class ;
    rdfs:subClassOf :Message ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An EDIFACT message of type INVOIC representing a business invoice." .

:EDIFACTSegment a owl:Class ;
    rdfs:label "EDIFACT Segment" ;
    rdfs:comment "A segment within an EDIFACT message, such as BGM or NAD." .

:BGM a owl:Class ;
    rdfs:subClassOf :EDIFACTSegment ;
    rdfs:label "BGM Segment" ;
    rdfs:comment "Beginning of Message segment, identifies the document type and number." .

:NAD a owl:Class ;
    rdfs:subClassOf :EDIFACTSegment ;
    rdfs:label "NAD Segment" ;
    rdfs:comment "Name and Address segment, provides party identification details." .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite data element within a segment, grouping several simple elements." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A simple data element within a composite or segment." .

:Delimiter a owl:Class ;
    rdfs:label "Delimiter" ;
    rdfs:comment "A character used to separate segments, composites, and elements in EDIFACT syntax." .

:MessageSection a owl:Class ;
    rdfs:label "Message Section" ;
    rdfs:comment "A logical section of a message (header, detail, summary)." .

:HeaderSection a owl:Class ;
    rdfs:subClassOf :MessageSection ;
    rdfs:label "Header Section" ;
    rdfs:comment "The header section of an invoice message, containing meta-information such as dates and references." .

:DetailSection a owl:Class ;
    rdfs:subClassOf :MessageSection ;
    rdfs:label "Detail Section" ;
    rdfs:comment "The detail section of an invoice message, listing line items." .

:SummarySection a owl:Class ;
    rdfs:subClassOf :MessageSection ;
    rdfs:label "Summary Section" ;
    rdfs:comment "The summary section of an invoice message, providing totals and tax information." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity involved in a transaction, such as buyer or delivery party." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in a transaction (e.g., Buyer, Delivery Party)." .

:BuyerRole a owl:Class ;
    rdfs:subClassOf :AgentRole ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "The role of buyer in a transaction." .

:DeliveryPartyRole a owl:Class ;
    rdfs:subClassOf :AgentRole ;
    rdfs:label "Delivery Party Role" ;
    rdfs:comment "The role of delivery party in a transaction." .

:OrganizationRoleParticipation a owl:Class ;
    rdfs:label "Organization Role Participation" ;
    rdfs:comment "Reification class for linking an organization, its role, and associated data in a transaction." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A physical or legal address for an organization." .

:HeadquartersAddress a owl:Class ;
    rdfs:subClassOf :Address ;
    rdfs:label "Headquarters Address" ;
    rdfs:comment "The headquarters address of an organization." .

:WarehouseAddress a owl:Class ;
    rdfs:subClassOf :Address ;
    rdfs:label "Warehouse Address" ;
    rdfs:comment "A warehouse address of an organization." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A unique identifier for an organization or document, such as a GLN or invoice number." .

:GlobalLocationNumber a owl:Class ;
    rdfs:subClassOf :Identifier ;
    rdfs:label "Global Location Number" ;
    rdfs:comment "A global location number (GLN) used for identifying organizations and locations." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed in an invoice." .

:ItemLine a owl:Class ;
    rdfs:label "Item Line" ;
    rdfs:comment "Reification class linking an item, its quantity, and price as a line in the invoice." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value, such as net price or invoice total." .

:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity of items in an invoice line." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Reification class for invoice-level details such as number, date, and total amount." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process, such as procurement, to which an invoice can be assigned." .

:Standard a owl:Class ;
    rdfs:label "Standard" ;
    rdfs:comment "A standard (e.g., EN 16931-1) to which a document conforms." .

:ValidationConstraint a owl:Class ;
    rdfs:label "Validation Constraint" ;
    rdfs:comment "A constraint, such as a SHACL shape, used for automated validation." .

:KnowledgeGraph a owl:Class ;
    rdfs:label "Knowledge Graph" ;
    rdfs:comment "A knowledge graph representing the extracted and validated business information." .

#################################################################
# Object Properties (with inverses and revised annotations)
#################################################################

:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :Message ;
    rdfs:label "contains message" ;
    rdfs:comment "Links an interchange envelope to its contained message(s)." ;
    owl:inverseOf :isContainedInEnvelope .

:isContainedInEnvelope a owl:ObjectProperty ;
    rdfs:domain :Message ;
    rdfs:range :InterchangeEnvelope ;
    rdfs:label "is contained in envelope" ;
    rdfs:comment "Relates a message to the envelope that contains it." ;
    owl:inverseOf :containsMessage .

:hasSection a owl:ObjectProperty ;
    rdfs:domain :Message ;
    rdfs:range :MessageSection ;
    rdfs:label "has section" ;
    rdfs:comment "Links a message to its logical sections (header, detail, summary)." ;
    owl:inverseOf :isSectionOf .

:isSectionOf a owl:ObjectProperty ;
    rdfs:domain :MessageSection ;
    rdfs:range :Message ;
    rdfs:label "is section of" ;
    rdfs:comment "Relates a message section to the message it is part of." ;
    owl:inverseOf :hasSection .

:hasSegment a owl:ObjectProperty ;
    rdfs:domain :MessageSection ;
    rdfs:range :EDIFACTSegment ;
    rdfs:label "has segment" ;
    rdfs:comment "Links a message section to its EDIFACT segments." ;
    owl:inverseOf :isSegmentOfSection .

:isSegmentOfSection a owl:ObjectProperty ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :MessageSection ;
    rdfs:label "is segment of section" ;
    rdfs:comment "Relates a segment to the message section it belongs to." ;
    owl:inverseOf :hasSegment .

:hasCompositeElement a owl:ObjectProperty ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :CompositeDataElement ;
    rdfs:label "has composite element" ;
    rdfs:comment "Links a segment to its composite data elements." ;
    owl:inverseOf :isCompositeElementOf .

:isCompositeElementOf a owl:ObjectProperty ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :EDIFACTSegment ;
    rdfs:label "is composite element of" ;
    rdfs:comment "Relates a composite data element to the segment it is part of." ;
    owl:inverseOf :hasCompositeElement .

:hasSimpleElement a owl:ObjectProperty ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    rdfs:label "has simple element" ;
    rdfs:comment "Links a composite data element to its simple elements." ;
    owl:inverseOf :isSimpleElementOf .

:isSimpleElementOf a owl:ObjectProperty ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement ;
    rdfs:label "is simple element of" ;
    rdfs:comment "Relates a simple data element to its parent composite data element." ;
    owl:inverseOf :hasSimpleElement .

:usesDelimiter a owl:ObjectProperty ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :Delimiter ;
    rdfs:label "uses delimiter" ;
    rdfs:comment "Indicates the delimiter used in a segment." ;
    owl:inverseOf :isDelimiterForSegment .

:isDelimiterForSegment a owl:ObjectProperty ;
    rdfs:domain :Delimiter ;
    rdfs:range :EDIFACTSegment ;
    rdfs:label "is delimiter for segment" ;
    rdfs:comment "Relates a delimiter to the segment it separates." ;
    owl:inverseOf :usesDelimiter .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links an invoice message to organizations involved in the transaction." ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Relates an organization to the invoice message it is involved in." ;
    owl:inverseOf :involvesOrganization .

:hasRoleParticipation a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleParticipation ;
    rdfs:label "has role participation" ;
    rdfs:comment "Links an invoice message to a reified participation of an organization in a specific role." ;
    owl:inverseOf :isParticipationOfInvoice .

:isParticipationOfInvoice a owl:ObjectProperty ;
    rdfs:domain :OrganizationRoleParticipation ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is participation of invoice" ;
    rdfs:comment "Relates a role participation to the invoice message it is part of." ;
    owl:inverseOf :hasRoleParticipation .

:playsRole a owl:ObjectProperty ;
    rdfs:domain :OrganizationRoleParticipation ;
    rdfs:range :AgentRole ;
    rdfs:label "plays role" ;
    rdfs:comment "Indicates the role played by an organization in a participation context." ;
    owl:inverseOf :isRolePlayedBy .

:isRolePlayedBy a owl:ObjectProperty ;
    rdfs:domain :AgentRole ;
    rdfs:range :OrganizationRoleParticipation ;
    rdfs:label "is role played by" ;
    rdfs:comment "Relates an agent role to the participation where it is played." ;
    owl:inverseOf :playsRole .

:hasParticipant a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:domain :OrganizationRoleParticipation ;
    rdfs:range :Organization ;
    rdfs:label "has participant" ;
    rdfs:comment "Indicates the organization participating in a role." ;
    owl:inverseOf :isParticipantIn .

:isParticipantIn a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationRoleParticipation ;
    rdfs:label "is participant in" ;
    rdfs:comment "Relates an organization to the role participation it is involved in." ;
    owl:inverseOf :hasParticipant .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :OrganizationRoleParticipation ;
    rdfs:range :Address ;
    rdfs:label "has address" ;
    rdfs:comment "Links a role participation to an address (e.g., headquarters, warehouse)." ;
    owl:inverseOf :isAddressOfParticipation .

:isAddressOfParticipation a owl:ObjectProperty ;
    rdfs:domain :Address ;
    rdfs:range :OrganizationRoleParticipation ;
    rdfs:label "is address of participation" ;
    rdfs:comment "Relates an address to the role participation it is linked to." ;
    owl:inverseOf :hasAddress .

:hasIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :OrganizationRoleParticipation ;
    rdfs:range :Identifier ;
    rdfs:label "has identifier" ;
    rdfs:comment "Links a role participation to an identifier such as GLN." ;
    owl:inverseOf :isIdentifierOfParticipation .

:isIdentifierOfParticipation a owl:ObjectProperty ;
    rdfs:domain :Identifier ;
    rdfs:range :OrganizationRoleParticipation ;
    rdfs:label "is identifier of participation" ;
    rdfs:comment "Relates an identifier to the role participation it is assigned to." ;
    owl:inverseOf :hasIdentifier .

:hasItemLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ItemLine ;
    rdfs:label "has item line" ;
    rdfs:comment "Links an invoice message to an item line." ;
    owl:inverseOf :isItemLineOfInvoice .

:isItemLineOfInvoice a owl:ObjectProperty ;
    rdfs:domain :ItemLine ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is item line of invoice" ;
    rdfs:comment "Relates an item line to the invoice message it is part of." ;
    owl:inverseOf :hasItemLine .

:describesItem a owl:ObjectProperty ;
    rdfs:domain :ItemLine ;
    rdfs:range :Item ;
    rdfs:label "describes item" ;
    rdfs:comment "Links an item line to the item it describes." ;
    owl:inverseOf :isItemDescribedByLine .

:isItemDescribedByLine a owl:ObjectProperty ;
    rdfs:domain :Item ;
    rdfs:range :ItemLine ;
    rdfs:label "is item described by line" ;
    rdfs:comment "Relates an item to the item line that describes it." ;
    owl:inverseOf :describesItem .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :ItemLine ;
    rdfs:range :Quantity ;
    rdfs:label "has quantity" ;
    rdfs:comment "Links an item line to the quantity of the item." ;
    owl:inverseOf :isQuantityOfLine .

:isQuantityOfLine a owl:ObjectProperty ;
    rdfs:domain :Quantity ;
    rdfs:range :ItemLine ;
    rdfs:label "is quantity of line" ;
    rdfs:comment "Relates a quantity to the item line it is part of." ;
    owl:inverseOf :hasQuantity .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :ItemLine ;
    rdfs:range :Price ;
    rdfs:label "has net price" ;
    rdfs:comment "Links an item line to the net price." ;
    owl:inverseOf :isNetPriceOfLine .

:isNetPriceOfLine a owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:range :ItemLine ;
    rdfs:label "is net price of line" ;
    rdfs:comment "Relates a price to the item line it is the net price for." ;
    owl:inverseOf :hasNetPrice .

:hasInvoiceDetail a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :InvoiceDetail ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Links an invoice message to its invoice-level details." ;
    owl:inverseOf :isInvoiceDetailOf .

:isInvoiceDetailOf a owl:ObjectProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is invoice detail of" ;
    rdfs:comment "Relates invoice details to the invoice message they belong to." ;
    owl:inverseOf :hasInvoiceDetail .

:hasInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Price ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "Links invoice details to the total invoice amount." ;
    owl:inverseOf :isInvoiceAmountOf .

:isInvoiceAmountOf a owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:range :InvoiceDetail ;
    rdfs:label "is invoice amount of" ;
    rdfs:comment "Relates a price to the invoice detail it is the total for." ;
    owl:inverseOf :hasInvoiceAmount .

:hasInvoiceNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Identifier ;
    rdfs:label "has invoice number" ;
    rdfs:comment "Links invoice details to the invoice number." ;
    owl:inverseOf :isInvoiceNumberOf .

:isInvoiceNumberOf a owl:ObjectProperty ;
    rdfs:domain :Identifier ;
    rdfs:range :InvoiceDetail ;
    rdfs:label "is invoice number of" ;
    rdfs:comment "Relates an identifier (e.g., invoice number) to the invoice detail it is assigned to." ;
    owl:inverseOf :hasInvoiceNumber .

:conformsToStandard a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Standard ;
    rdfs:label "conforms to standard" ;
    rdfs:comment "Indicates the standard to which an invoice message conforms." ;
    owl:inverseOf :isStandardForInvoice .

:isStandardForInvoice a owl:ObjectProperty ;
    rdfs:domain :Standard ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is standard for invoice" ;
    rdfs:comment "Relates a standard to the invoice message it is applied to." ;
    owl:inverseOf :conformsToStandard .

:validatedBy a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ValidationConstraint ;
    rdfs:label "validated by" ;
    rdfs:comment "Indicates a validation constraint used to validate the invoice message." ;
    owl:inverseOf :validatesInvoice .

:validatesInvoice a owl:ObjectProperty ;
    rdfs:domain :ValidationConstraint ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "validates invoice" ;
    rdfs:comment "Relates a validation constraint to the invoice message it validates." ;
    owl:inverseOf :validatedBy .

:partOfProcess a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    rdfs:label "part of process" ;
    rdfs:comment "Indicates the business process to which the invoice message belongs." ;
    owl:inverseOf :hasInvoiceInProcess .

:hasInvoiceInProcess a owl:ObjectProperty ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "has invoice in process" ;
    rdfs:comment "Relates a business process to the invoice messages it contains." ;
    owl:inverseOf :partOfProcess .

# Connect KnowledgeGraph to InvoiceMessage
:representsKnowledgeGraph a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :KnowledgeGraph ;
    rdfs:label "represents knowledge graph" ;
    rdfs:comment "Links an invoice message to the knowledge graph it generates." ;
    owl:inverseOf :isKnowledgeGraphOf .

:isKnowledgeGraphOf a owl:ObjectProperty ;
    rdfs:domain :KnowledgeGraph ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is knowledge graph of" ;
    rdfs:comment "Relates a knowledge graph to the invoice message it represents." ;
    owl:inverseOf :representsKnowledgeGraph .

#################################################################
# Data Properties
#################################################################

:elementValue a owl:DatatypeProperty ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string ;
    rdfs:label "element value" ;
    rdfs:comment "The string value of a simple data element." .

:segmentTag a owl:DatatypeProperty ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment tag" ;
    rdfs:comment "The tag (e.g., 'BGM', 'NAD') of an EDIFACT segment." .

:compositeCode a owl:DatatypeProperty ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range xsd:string ;
    rdfs:label "composite code" ;
    rdfs:comment "The code identifying a composite data element." .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" ;
    rdfs:comment "The string value of an identifier (e.g., GLN, invoice number)." .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:label "address line" ;
    rdfs:comment "A line of an address." .

:priceValue a owl:DatatypeProperty ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal ;
    rdfs:label "price value" ;
    rdfs:comment "The decimal value of a price." .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Quantity ;
    rdfs:range xsd:decimal ;
    rdfs:label "quantity value" ;
    rdfs:comment "The decimal value of a quantity." .

:dateValue a owl:DatatypeProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range xsd:string ;
    rdfs:label "date value" ;
    rdfs:comment "A string representation of a date (custom format, e.g., 'YYYYMMDD')." .

:sectionType a owl:DatatypeProperty ;
    rdfs:domain :MessageSection ;
    rdfs:range xsd:string ;
    rdfs:label "section type" ;
    rdfs:comment "The type of message section (header, detail, summary)." .

#################################################################
# Disjointness and DisjointUnion
#################################################################

:Organization owl:disjointWith :Item, :Address .
:EDIFACTSegment owl:disjointWith :CompositeDataElement .
:HeaderSection owl:disjointWith :DetailSection, :SummarySection .
:DetailSection owl:disjointWith :SummarySection .

:MessageSection owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .
:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .

#################################################################
# Property Characteristics
#################################################################

:containsMessage a owl:FunctionalProperty .
:hasParticipant a owl:InverseFunctionalProperty .
:hasAddress a owl:FunctionalProperty .
:hasIdentifier a owl:FunctionalProperty .
:hasItemLine a owl:FunctionalProperty .
:hasInvoiceDetail a owl:FunctionalProperty .
:hasInvoiceAmount a owl:FunctionalProperty .
:hasInvoiceNumber a owl:FunctionalProperty .

#################################################################
# Complex Axioms & Restrictions
#################################################################

:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRoleParticipation ; owl:someValuesFrom :OrganizationRoleParticipation ] .
:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItemLine ; owl:someValuesFrom :ItemLine ] .
:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:someValuesFrom :InvoiceDetail ] .
:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ] .
:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasParticipant ; owl:someValuesFrom :Organization ] .
:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:allValuesFrom :Address ] .
:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasIdentifier ; owl:allValuesFrom :Identifier ] .
:ItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ] .
:ItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:allValuesFrom :Quantity ] .
:ItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom :Price ] .

#################################################################
# Annotations for EDIFACT-specific technical vocabulary
#################################################################
:BGM rdfs:label "BGM Segment" ; rdfs:comment "Beginning of Message segment for document identification." .
:NAD rdfs:label "NAD Segment" ; rdfs:comment "Name and Address segment for participant details." .
:GlobalLocationNumber rdfs:label "Global Location Number (GLN)" ; rdfs:comment "GLN for identifying organizations and locations." .

#################################################################
# Alignment with Standards and Validation
#################################################################
:InvoiceMessage rdfs:seeAlso <https://www.en16931.eu/> , <https://w3id.org/p2p-o/> .
:ValidationConstraint rdfs:comment "SHACL constraints for validation, e.g., itemized prices summing to totals, mandatory identifiers present." .

#################################################################
# End of Ontology
#################################################################
