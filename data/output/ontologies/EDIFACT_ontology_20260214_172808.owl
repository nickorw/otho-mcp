@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/edifact-scenario>
    a owl:Ontology ;
    rdfs:label "EDIFACT Scenario Ontology" ;
    rdfs:comment "Ontology for representing EDIFACT invoice messaging scenarios." .

#################################################################
#    Classes
#################################################################

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "An EDIFACT message containing one or more invoices." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity involved in the invoice, such as buyer or seller." .

:OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "A role that an organization can play in an invoice, e.g., Buyer, Seller." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address for an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed in an invoice." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed information about an invoice, e.g., terms, dates." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which an invoice can be assigned." .

:EDIFACTFileFormat a owl:Class ;
    rdfs:label "EDIFACT File Format" ;
    rdfs:comment "A file format specification for EDIFACT messages." .

:InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "A reified relation linking an organization with its role in an invoice." .

#################################################################
#    Object Properties + Inverses
#################################################################

:listsInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Relates an EDIFACT message to the invoices it contains." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Invoice ;
    owl:inverseOf :isListedInMessage .

:isListedInMessage a owl:ObjectProperty ;
    rdfs:label "is listed in message" ;
    rdfs:comment "Inverse of listsInvoice; relates an invoice to the EDIFACT message it is listed in." ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :listsInvoice .

:involvesParticipation a owl:ObjectProperty ;
    rdfs:label "involves participation" ;
    rdfs:comment "Relates an invoice to a participation instance (organization-role pair)." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceParticipation ;
    owl:inverseOf :isParticipationInInvoice .

:isParticipationInInvoice a owl:ObjectProperty ;
    rdfs:label "is participation in invoice" ;
    rdfs:comment "Inverse of involvesParticipation; relates a participation instance to its invoice." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Invoice ;
    owl:inverseOf :involvesParticipation .

:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates an invoice participation to the role played." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :OrganizationRole ;
    owl:inverseOf :isRoleOfParticipation .

:isRoleOfParticipation a owl:ObjectProperty ;
    rdfs:label "is role of participation" ;
    rdfs:comment "Inverse of hasRole; relates a role to the participation instance." ;
    rdfs:domain :OrganizationRole ;
    rdfs:range :InvoiceParticipation ;
    owl:inverseOf :hasRole .

:playedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "played by" ;
    rdfs:comment "Relates an invoice participation to the participating organization." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Organization ;
    owl:inverseOf :participatesIn .

:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    rdfs:comment "Inverse of playedBy; relates an organization to its participation instances." ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceParticipation ;
    owl:inverseOf :playedBy .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an organization to its address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOfOrganization .

:isAddressOfOrganization a owl:ObjectProperty ;
    rdfs:label "is address of organization" ;
    rdfs:comment "Inverse of hasAddress; relates an address to its organization." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .

:sellsItem a owl:ObjectProperty ;
    rdfs:label "sells item" ;
    rdfs:comment "Relates an invoice to the items sold." ;
    rdfs:domain :Invoice ;
    rdfs:range :Item ;
    owl:inverseOf :isSoldInInvoice .

:isSoldInInvoice a owl:ObjectProperty ;
    rdfs:label "is sold in invoice" ;
    rdfs:comment "Inverse of sellsItem; relates an item to the invoice it is sold in." ;
    rdfs:domain :Item ;
    rdfs:range :Invoice ;
    owl:inverseOf :sellsItem .

:hasInvoiceDetail a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Relates an invoice to its detail information." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceDetail ;
    owl:inverseOf :isDetailOfInvoice .

:isDetailOfInvoice a owl:ObjectProperty ;
    rdfs:label "is detail of invoice" ;
    rdfs:comment "Inverse of hasInvoiceDetail; relates an invoice detail to its invoice." ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Invoice ;
    owl:inverseOf :hasInvoiceDetail .

:hasFileFormat a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has file format" ;
    rdfs:comment "Relates an EDIFACT message to its file format specification." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :EDIFACTFileFormat ;
    owl:inverseOf :isFileFormatOfMessage .

:isFileFormatOfMessage a owl:ObjectProperty ;
    rdfs:label "is file format of message" ;
    rdfs:comment "Inverse of hasFileFormat; relates a file format to the EDIFACT message." ;
    rdfs:domain :EDIFACTFileFormat ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :hasFileFormat .

:assignedToProcess a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to process" ;
    rdfs:comment "Relates an invoice to the business process it is assigned to." ;
    rdfs:domain :Invoice ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :hasAssignedInvoice .

:hasAssignedInvoice a owl:ObjectProperty ;
    rdfs:label "has assigned invoice" ;
    rdfs:comment "Inverse of assignedToProcess; relates a business process to the invoices assigned to it." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Invoice ;
    owl:inverseOf :assignedToProcess .

#################################################################
#    Data Properties
#################################################################

:itemNetPrice a owl:DatatypeProperty ;
    rdfs:label "item net price" ;
    rdfs:comment "The net price of an item sold in the invoice." ;
    rdfs:domain :Item ;
    rdfs:range xsd:decimal .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:label "invoice amount" ;
    rdfs:comment "The total amount of the invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:decimal .

:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice number" ;
    rdfs:comment "The unique identifier for the invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:string .

:organizationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of an organization involved in the invoice." ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:label "address line" ;
    rdfs:comment "The street address or PO box." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "The city of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "The postal code of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "The country of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:label "item description" ;
    rdfs:comment "A description of the item sold in the invoice." ;
    rdfs:domain :Item ;
    rdfs:range xsd:string .

#################################################################
#    Restrictions and Axioms
#################################################################

:Invoice
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :involvesParticipation ; owl:someValuesFrom :InvoiceParticipation ] ,
                    [ a owl:Restriction ; owl:onProperty :sellsItem ; owl:someValuesFrom :Item ] ,
                    [ a owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:someValuesFrom :InvoiceDetail ] ,
                    [ a owl:Restriction ; owl:onProperty :assignedToProcess ; owl:allValuesFrom :BusinessProcess ] .

:EDIFACTMessage
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :listsInvoice ; owl:someValuesFrom :Invoice ] ,
                    [ a owl:Restriction ; owl:onProperty :hasFileFormat ; owl:allValuesFrom :EDIFACTFileFormat ] .

#################################################################
#    Disjointness
#################################################################

:Organization owl:disjointWith :Invoice , :Item , :EDIFACTMessage , :Address .
:Invoice owl:disjointWith :Item , :EDIFACTMessage , :Address .
:Item owl:disjointWith :EDIFACTMessage , :Address .
:EDIFACTMessage owl:disjointWith :Address .
