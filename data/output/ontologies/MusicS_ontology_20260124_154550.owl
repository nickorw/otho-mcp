@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production> a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "An ontology capturing music production, band membership, albums, performances, and critiques as described in the Red Hot Chili Peppers scenario." .

# Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, such as a band member or critic." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical group, such as the Red Hot Chili Peppers." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or position held by a person in a band (e.g., vocals, drums)." .

:Membership a owl:Class ;
    rdfs:label "Membership" ;
    rdfs:comment "A reified relationship capturing a person's role in a band during a time period." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of tracks released by a band." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A distinct recording on an album, possibly a song." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition, possibly recorded as a track." .

:Critic a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who makes critiques of albums." .

:Critique a owl:Class ;
    rdfs:label "Critique" ;
    rdfs:comment "A reified critique by a critic about an album." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live music event by a band." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances can take place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Disjointness axioms
:Person owl:disjointWith :Band .
:Instrument owl:disjointWith :Role .
:Album owl:disjointWith :Song .
:Track owl:disjointWith :Song .
:Critic owl:disjointWith :Band .
:City owl:disjointWith :Region .
:Region owl:disjointWith :Country .

# Properties and Inverses
:playsInstrument a owl:ObjectProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :instrumentPlayedBy .

:instrumentPlayedBy a owl:ObjectProperty ;
    rdfs:label "instrument played by" ;
    rdfs:comment "Relates an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMembership a owl:ObjectProperty ;
    rdfs:label "has membership" ;
    rdfs:comment "Relates a band to a membership instance." ;
    rdfs:domain :Band ;
    rdfs:range :Membership ;
    owl:inverseOf :membershipOf .

:membershipOf a owl:ObjectProperty ;
    rdfs:label "membership of" ;
    rdfs:comment "Relates a membership to the band." ;
    rdfs:domain :Membership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMembership .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Relates a membership to the person who is a member." ;
    rdfs:domain :Membership ;
    rdfs:range :Person ;
    owl:inverseOf :memberOfMembership .

:memberOfMembership a owl:ObjectProperty ;
    rdfs:label "member of membership" ;
    rdfs:comment "Relates a person to a membership they belong to." ;
    rdfs:domain :Person ;
    rdfs:range :Membership ;
    owl:inverseOf :hasMember .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates a membership to the role held by the member." ;
    rdfs:domain :Membership ;
    rdfs:range :Role ;
    owl:inverseOf :roleOfMembership .

:roleOfMembership a owl:ObjectProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Relates a role to the membership holding it." ;
    rdfs:domain :Role ;
    rdfs:range :Membership ;
    owl:inverseOf :hasRole .

:membershipStart a owl:DatatypeProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "The start date of a person's membership in a band (as string)." ;
    rdfs:domain :Membership ;
    rdfs:range xsd:string .

:membershipEnd a owl:DatatypeProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "The end date of a person's membership in a band (as string)." ;
    rdfs:domain :Membership ;
    rdfs:range xsd:string .

:recordedAlbum a owl:ObjectProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates a band to an album it recorded." ;
    rdfs:domain :Band ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecordedBy .

:albumRecordedBy a owl:ObjectProperty ;
    rdfs:label "album recorded by" ;
    rdfs:comment "Relates an album to the band that recorded it." ;
    rdfs:domain :Album ;
    rdfs:range :Band ;
    owl:inverseOf :recordedAlbum .

:recordingStart a owl:DatatypeProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "The start date for an album's recording (as string)." ;
    rdfs:domain :Album ;
    rdfs:range xsd:string .

:recordingEnd a owl:DatatypeProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "The end date for an album's recording (as string)." ;
    rdfs:domain :Album ;
    rdfs:range xsd:string .

:containsTrack a owl:ObjectProperty ;
    rdfs:label "contains track" ;
    rdfs:comment "Relates an album to a track it contains." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackContainedIn .

:trackContainedIn a owl:ObjectProperty ;
    rdfs:label "track contained in" ;
    rdfs:comment "Relates a track to the album it is contained in." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :containsTrack .

:trackCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "track count" ;
    rdfs:comment "The number of tracks in an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:nonNegativeInteger .

:releaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "release date" ;
    rdfs:comment "The release date of an album (as string)." ;
    rdfs:domain :Album ;
    rdfs:range xsd:string .

:trackOfSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track of song" ;
    rdfs:comment "Relates a track to the song it records." ;
    rdfs:domain :Track ;
    rdfs:range :Song ;
    owl:inverseOf :songRecordedAsTrack .

:songRecordedAsTrack a owl:ObjectProperty ;
    rdfs:label "song recorded as track" ;
    rdfs:comment "Relates a song to a track recording it." ;
    rdfs:domain :Song ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfSong .

:compositionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "composition date" ;
    rdfs:comment "The date a song was composed (as string)." ;
    rdfs:domain :Song ;
    rdfs:range xsd:string .

:hasCritique a owl:ObjectProperty ;
    rdfs:label "has critique" ;
    rdfs:comment "Relates an album to a critique." ;
    rdfs:domain :Album ;
    rdfs:range :Critique ;
    owl:inverseOf :critiqueOfAlbum .

:critiqueOfAlbum a owl:ObjectProperty ;
    rdfs:label "critique of album" ;
    rdfs:comment "Relates a critique to the album it is about." ;
    rdfs:domain :Critique ;
    rdfs:range :Album ;
    owl:inverseOf :hasCritique .

:critic a owl:ObjectProperty ;
    rdfs:label "critic" ;
    rdfs:comment "Relates a critique to the critic who made it." ;
    rdfs:domain :Critique ;
    rdfs:range :Critic ;
    owl:inverseOf :madeCritique .

:madeCritique a owl:ObjectProperty ;
    rdfs:label "made critique" ;
    rdfs:comment "Relates a critic to the critique they made." ;
    rdfs:domain :Critic ;
    rdfs:range :Critique ;
    owl:inverseOf :critic .

:critiqueStatement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critique statement" ;
    rdfs:comment "The statement made by a critic about an album." ;
    rdfs:domain :Critique ;
    rdfs:range xsd:string .

:performanceOf a owl:ObjectProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Relates a performance to the band performing." ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :bandPerformedAt .

:bandPerformedAt a owl:ObjectProperty ;
    rdfs:label "band performed at" ;
    rdfs:comment "Relates a band to a performance it gave." ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceOf .

:performedSong a owl:ObjectProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Relates a performance to a song performed." ;
    rdfs:domain :Performance ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformedAt .

:songPerformedAt a owl:ObjectProperty ;
    rdfs:label "song performed at" ;
    rdfs:comment "Relates a song to a performance it was played at." ;
    rdfs:domain :Song ;
    rdfs:range :Performance ;
    owl:inverseOf :performedSong .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "The date of a performance (as string)." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:string .

:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "The city where a performance took place." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :locationOfPerformance .

:locationOfPerformance a owl:ObjectProperty ;
    rdfs:label "location of performance" ;
    rdfs:comment "Relates a city to performances that took place there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation .

:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in region" ;
    rdfs:comment "Relates a city to the region it is in." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Relates a region to a city it contains." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :inRegion .

:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in country" ;
    rdfs:comment "Relates a region to the country it is in." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Relates a country to a region it contains." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :inCountry .

# Restrictions and General Class Axioms
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] .
