@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/EDIFACTScenario> a owl:Ontology ;
    rdfs:label "EDIFACT Scenario Ontology" ;
    rdfs:comment "An ontology modeling EDIFACT messages, invoices, organizations, roles, and related business concepts." .

#################################################################
# Classes
#################################################################
:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message in the EDIFACT format containing invoices." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, indicating products, quantities, and agreed prices for products or services." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A company or entity involved in an invoice, either as buyer or seller." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or part played by an organization in an invoice (e.g., buyer, seller)." .

:BuyerRole a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "A role indicating an organization is a buyer in the invoice." .

:SellerRole a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Seller Role" ;
    rdfs:comment "A role indicating an organization is a seller in the invoice." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "The address details of an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item or product sold in the invoice." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed information about the invoice (e.g., terms, payment information)." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which the invoice can be assigned." .

:InvoiceOrganizationInvolvement a owl:Class ;
    rdfs:label "Invoice Organization Involvement" ;
    rdfs:comment "A pivot class representing the involvement of an organization in an invoice with a specific role." .

:InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "A pivot class representing the sale of an item in an invoice with its net price." .

#################################################################
# Disjointness and DisjointUnion
#################################################################
:Organization owl:disjointWith :Item .
:Role owl:disjointWith :Address .
:Invoice owl:disjointWith :BusinessProcess .
:BuyerRole owl:disjointWith :SellerRole .
:Role owl:disjointUnionOf ( :BuyerRole :SellerRole ) .

#################################################################
# Object Properties (with inverses)
#################################################################
:hasInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Relates an EDIFACT message to an invoice it contains." ;
    owl:inverseOf :isInvoiceOf .

:isInvoiceOf a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessage ;
    rdfs:label "is invoice of" ;
    rdfs:comment "Inverse: relates an invoice to the EDIFACT message containing it." ;
    owl:inverseOf :hasInvoice .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceOrganizationInvolvement ;
    rdfs:label "involves organization" ;
    rdfs:comment "Relates an invoice to an involvement of an organization (with a specific role)." ;
    owl:inverseOf :isInvolvementOfInvoice .

:isInvolvementOfInvoice a owl:ObjectProperty ;
    rdfs:domain :InvoiceOrganizationInvolvement ;
    rdfs:range :Invoice ;
    rdfs:label "is involvement of invoice" ;
    rdfs:comment "Inverse: relates an InvoiceOrganizationInvolvement to its invoice." ;
    owl:inverseOf :involvesOrganization .

:organization a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceOrganizationInvolvement ;
    rdfs:range :Organization ;
    rdfs:label "organization" ;
    rdfs:comment "Relates an InvoiceOrganizationInvolvement to the involved organization." ;
    owl:inverseOf :isOrganizationInvolvementOf .

:isOrganizationInvolvementOf a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceOrganizationInvolvement ;
    rdfs:label "is organization involvement of" ;
    rdfs:comment "Inverse: relates an organization to its InvoiceOrganizationInvolvement." ;
    owl:inverseOf :organization .

:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceOrganizationInvolvement ;
    rdfs:range :Role ;
    rdfs:label "has role" ;
    rdfs:comment "Relates an InvoiceOrganizationInvolvement to the role played by the organization." ;
    owl:inverseOf :isRoleInvolvementOf .

:isRoleInvolvementOf a owl:ObjectProperty ;
    rdfs:domain :Role ;
    rdfs:range :InvoiceOrganizationInvolvement ;
    rdfs:label "is role involvement of" ;
    rdfs:comment "Inverse: relates a Role to its InvoiceOrganizationInvolvement." ;
    owl:inverseOf :hasRole .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an organization to its address." ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse: relates an address to its organization." ;
    owl:inverseOf :hasAddress .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceItem ;
    rdfs:label "has item" ;
    rdfs:comment "Relates an invoice to an item entry (with price, quantity, etc.)." ;
    owl:inverseOf :isItemOf .

:isItemOf a owl:ObjectProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range :Invoice ;
    rdfs:label "is item of" ;
    rdfs:comment "Inverse: relates an InvoiceItem to its invoice." ;
    owl:inverseOf :hasItem .

:item a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range :Item ;
    rdfs:label "item" ;
    rdfs:comment "Relates an InvoiceItem to the item being sold." ;
    owl:inverseOf :isInvoiceEntryOf .

:isInvoiceEntryOf a owl:ObjectProperty ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceItem ;
    rdfs:label "is invoice entry of" ;
    rdfs:comment "Inverse: relates an Item to its InvoiceItem entry." ;
    owl:inverseOf :item .

:hasInvoiceDetail a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceDetail ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Relates an invoice to its detail information." ;
    owl:inverseOf :isInvoiceDetailOf .

:isInvoiceDetailOf a owl:ObjectProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Invoice ;
    rdfs:label "is invoice detail of" ;
    rdfs:comment "Inverse: relates InvoiceDetail to its invoice." ;
    owl:inverseOf :hasInvoiceDetail .

:assignedToBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :BusinessProcess ;
    rdfs:label "assigned to business process" ;
    rdfs:comment "Assigns an invoice to a business process." ;
    owl:inverseOf :hasAssignedInvoice .

:hasAssignedInvoice a owl:ObjectProperty ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Invoice ;
    rdfs:label "has assigned invoice" ;
    rdfs:comment "Inverse: relates a business process to its assigned invoice." ;
    owl:inverseOf :assignedToBusinessProcess .

#################################################################
# Data Properties
#################################################################
:netPrice a owl:DatatypeProperty ;
    rdfs:domain :InvoiceItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "net price" ;
    rdfs:comment "The net price of an item in an invoice." .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:decimal ;
    rdfs:label "invoice amount" ;
    rdfs:comment "The total amount of the invoice." .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The unique number identifying the invoice." .

:organizationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization." .

:addressLine a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:label "address line" ;
    rdfs:comment "The address line of an organization." .

:itemDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Item ;
    rdfs:range xsd:string ;
    rdfs:label "item description" ;
    rdfs:comment "The description of an item." .

:detailDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range xsd:string ;
    rdfs:label "detail description" ;
    rdfs:comment "The description of invoice details (terms, payment, etc.)." .

#################################################################
# General Class Axioms & Restrictions
#################################################################
[ rdf:type owl:Restriction ;
  owl:onProperty :hasRole ;
  owl:someValuesFrom :BuyerRole ;
  rdfs:subClassOf :InvoiceOrganizationInvolvement
] .
