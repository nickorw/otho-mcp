@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/EDIFACTScenario> a owl:Ontology ;
    rdfs:label "EDIFACT Scenario Ontology" ;
    rdfs:comment "An ontology modeling EDIFACT messages, invoices, organizations, and related business concepts." .

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message formatted according to the EDIFACT standard, which may list one or more invoices." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, relating to a sale transaction and indicating the products, quantities, and agreed prices." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A company or entity involved in the invoice, such as buyer or seller." .

:OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "A role that an organization can play in an invoice, such as buyer or seller." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "The address associated with an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed in an invoice." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which an invoice can be assigned." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Details associated with an invoice, such as payment terms or delivery information." .

:ItemDetail a owl:Class ;
    rdfs:label "Item Detail" ;
    rdfs:comment "Additional information about an item, such as description or specification." .

:InvoiceOrganizationRole a owl:Class ;
    rdfs:label "Invoice Organization Role" ;
    rdfs:comment "A pivot class representing the role of an organization in a specific invoice, enabling reification of the relationship between invoices, organizations, and their roles." .

# Object Properties
:listsInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Relates an EDIFACT message to the invoices it lists." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Invoice ;
    owl:inverseOf :isListedInMessage .

:isListedInMessage a owl:ObjectProperty ;
    rdfs:label "is listed in message" ;
    rdfs:comment "Inverse of listsInvoice: relates an Invoice to the EDIFACT message it is listed in." ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :listsInvoice .

:involvesOrganizationRole a owl:ObjectProperty ;
    rdfs:label "involves organization role" ;
    rdfs:comment "Relates an invoice to a role played by an organization in that invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceOrganizationRole ;
    owl:inverseOf :isOrganizationRoleInvolvedIn .

:isOrganizationRoleInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is organization role involved in" ;
    rdfs:comment "Inverse of involvesOrganizationRole: relates an InvoiceOrganizationRole to the Invoice it is part of." ;
    rdfs:domain :InvoiceOrganizationRole ;
    rdfs:range :Invoice ;
    owl:inverseOf :involvesOrganizationRole .

:hasOrganization a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has organization" ;
    rdfs:comment "Relates an InvoiceOrganizationRole to the involved organization." ;
    rdfs:domain :InvoiceOrganizationRole ;
    rdfs:range :Organization ;
    owl:inverseOf :isOrganizationOfRole .

:isOrganizationOfRole a owl:ObjectProperty ;
    rdfs:label "is organization of role" ;
    rdfs:comment "Inverse of hasOrganization: relates an Organization to the InvoiceOrganizationRole it participates in." ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceOrganizationRole ;
    owl:inverseOf :hasOrganization .

:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates an InvoiceOrganizationRole to the role played by the organization." ;
    rdfs:domain :InvoiceOrganizationRole ;
    rdfs:range :OrganizationRole ;
    owl:inverseOf :isRoleOfOrganization .

:isRoleOfOrganization a owl:ObjectProperty ;
    rdfs:label "is role of organization" ;
    rdfs:comment "Inverse of hasRole: relates an OrganizationRole to the InvoiceOrganizationRole it is assigned in." ;
    rdfs:domain :OrganizationRole ;
    rdfs:range :InvoiceOrganizationRole ;
    owl:inverseOf :hasRole .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an organization to its address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse of hasAddress: relates an Address to the Organization it belongs to." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .

:hasBuyer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has buyer" ;
    rdfs:comment "Relates an invoice to its buyer organization." ;
    rdfs:domain :Invoice ;
    rdfs:range :Organization ;
    owl:inverseOf :isBuyerOf .

:isBuyerOf a owl:ObjectProperty ;
    rdfs:label "is buyer of" ;
    rdfs:comment "Inverse of hasBuyer: relates an Organization to the Invoice it buys from." ;
    rdfs:domain :Organization ;
    rdfs:range :Invoice ;
    owl:inverseOf :hasBuyer .

:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Relates an invoice to the items it includes." ;
    rdfs:domain :Invoice ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOf .

:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:comment "Inverse of hasItem: relates an Item to the Invoice it is included in." ;
    rdfs:domain :Item ;
    rdfs:range :Invoice ;
    owl:inverseOf :hasItem .

:hasItemDetail a owl:ObjectProperty ;
    rdfs:label "has item detail" ;
    rdfs:comment "Relates an item to its detailed information." ;
    rdfs:domain :Item ;
    rdfs:range :ItemDetail ;
    owl:inverseOf :isDetailOfItem .

:isDetailOfItem a owl:ObjectProperty ;
    rdfs:label "is detail of item" ;
    rdfs:comment "Inverse of hasItemDetail: relates an ItemDetail to the Item it details." ;
    rdfs:domain :ItemDetail ;
    rdfs:range :Item ;
    owl:inverseOf :hasItemDetail .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Relates an invoice to its detailed information." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceDetail ;
    owl:inverseOf :isDetailOfInvoice .

:isDetailOfInvoice a owl:ObjectProperty ;
    rdfs:label "is detail of invoice" ;
    rdfs:comment "Inverse of hasInvoiceDetail: relates an InvoiceDetail to the Invoice it details." ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Invoice ;
    owl:inverseOf :hasInvoiceDetail .

:isInBusinessProcess a owl:ObjectProperty ;
    rdfs:label "is in business process" ;
    rdfs:comment "Relates an invoice to the business process it is assigned to." ;
    rdfs:domain :Invoice ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :hasInvoiceInProcess .

:hasInvoiceInProcess a owl:ObjectProperty ;
    rdfs:label "has invoice in process" ;
    rdfs:comment "Inverse of isInBusinessProcess: relates a BusinessProcess to the Invoices assigned to it." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Invoice ;
    owl:inverseOf :isInBusinessProcess .

# Data Properties
:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice number" ;
    rdfs:comment "The unique identifier for an invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:string .

:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "The total amount of the invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:decimal .

:hasNetPrice a owl:DatatypeProperty ;
    rdfs:label "has net price" ;
    rdfs:comment "The net price of an item in the invoice." ;
    rdfs:domain :Item ;
    rdfs:range xsd:decimal .

# Disjointness axioms
:EDIFACTMessage owl:disjointWith :Organization, :Invoice, :BusinessProcess .
:Invoice owl:disjointWith :Organization, :Item, :BusinessProcess .
:Organization owl:disjointWith :Item, :BusinessProcess .
:Item owl:disjointWith :BusinessProcess .
:InvoiceDetail owl:disjointWith :ItemDetail .
:OrganizationRole owl:disjointWith :Item .

# Example restrictions and equivalence axioms
:Invoice owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [ owl:onProperty :hasInvoiceNumber ; owl:allValuesFrom xsd:string ] ;
    owl:Restriction [ owl:onProperty :hasInvoiceAmount ; owl:allValuesFrom xsd:decimal ]
] .

:Item owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [ owl:onProperty :hasNetPrice ; owl:allValuesFrom xsd:decimal ]
] .