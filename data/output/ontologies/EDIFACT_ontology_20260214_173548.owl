@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/EDIFACTScenario> a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Ontology" ;
    rdfs:comment "Ontology modeling invoices, organizations, items, and roles in EDIFACT messages." .

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message in the EDIFACT standard that contains invoices." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice as represented in an EDIFACT message." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization involved in an invoice, either as buyer, seller, or other role." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role played by an organization in an invoice (e.g., buyer, seller)." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A physical or postal address of an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item sold in the invoice." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed text or information about an invoice." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which an invoice may be assigned." .

:InvoiceOrganizationRoleAssignment a owl:Class ;
    rdfs:label "Invoice Organization Role Assignment" ;
    rdfs:comment "Pivot class for reifying the assignment of an organization to a role in an invoice." .

:InvoiceItemAssignment a owl:Class ;
    rdfs:label "Invoice Item Assignment" ;
    rdfs:comment "Pivot class for reifying the assignment of an item to an invoice." .

#################################################################
# Object Properties (with inverses)
#################################################################

:hasInvoice a owl:ObjectProperty ;
    rdfs:label "has invoice" ;
    rdfs:comment "Relates an EDIFACT message to an invoice." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Invoice ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :isInvoiceInMessage .

:isInvoiceInMessage a owl:ObjectProperty ;
    rdfs:label "is invoice in message" ;
    rdfs:comment "Relates an invoice to the EDIFACT message it is contained in." ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessage ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasInvoice .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:label "involves organization" ;
    rdfs:comment "Relates an invoice to an involved organization." ;
    rdfs:domain :Invoice ;
    rdfs:range :Organization ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Relates an organization to invoices it is involved in." ;
    rdfs:domain :Organization ;
    rdfs:range :Invoice ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :involvesOrganization .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Relates an invoice to an InvoiceOrganizationRoleAssignment pivot class." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceOrganizationRoleAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :isRoleAssignmentOfInvoice .

:isRoleAssignmentOfInvoice a owl:ObjectProperty ;
    rdfs:label "is role assignment of invoice" ;
    rdfs:comment "Relates an InvoiceOrganizationRoleAssignment to its invoice." ;
    rdfs:domain :InvoiceOrganizationRoleAssignment ;
    rdfs:range :Invoice ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasRoleAssignment .

:hasItemAssignment a owl:ObjectProperty ;
    rdfs:label "has item assignment" ;
    rdfs:comment "Relates an invoice to an InvoiceItemAssignment pivot class." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceItemAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :isItemAssignmentOfInvoice .

:isItemAssignmentOfInvoice a owl:ObjectProperty ;
    rdfs:label "is item assignment of invoice" ;
    rdfs:comment "Relates an InvoiceItemAssignment to its invoice." ;
    rdfs:domain :InvoiceItemAssignment ;
    rdfs:range :Invoice ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasItemAssignment .

:roleAssignmentForOrganization a owl:ObjectProperty ;
    rdfs:label "role assignment for organization" ;
    rdfs:comment "Relates an InvoiceOrganizationRoleAssignment to the assigned Organization." ;
    rdfs:domain :InvoiceOrganizationRoleAssignment ;
    rdfs:range :Organization ;
    owl:functionalProperty true ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasRoleAssignmentOrganization .

:hasRoleAssignmentOrganization a owl:ObjectProperty ;
    rdfs:label "has role assignment organization" ;
    rdfs:comment "Relates an Organization to its InvoiceOrganizationRoleAssignments." ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceOrganizationRoleAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :roleAssignmentForOrganization .

:roleAssignmentHasRole a owl:ObjectProperty ;
    rdfs:label "role assignment has role" ;
    rdfs:comment "Relates an InvoiceOrganizationRoleAssignment to the assigned Role." ;
    rdfs:domain :InvoiceOrganizationRoleAssignment ;
    rdfs:range :Role ;
    owl:functionalProperty true ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasRoleAssignmentRole .

:hasRoleAssignmentRole a owl:ObjectProperty ;
    rdfs:label "has role assignment role" ;
    rdfs:comment "Relates a Role to InvoiceOrganizationRoleAssignments." ;
    rdfs:domain :Role ;
    rdfs:range :InvoiceOrganizationRoleAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :roleAssignmentHasRole .

:roleAssignmentForInvoice a owl:ObjectProperty ;
    rdfs:label "role assignment for invoice" ;
    rdfs:comment "Relates an InvoiceOrganizationRoleAssignment to the Invoice." ;
    rdfs:domain :InvoiceOrganizationRoleAssignment ;
    rdfs:range :Invoice ;
    owl:functionalProperty true ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasRoleAssignmentInvoice .

:hasRoleAssignmentInvoice a owl:ObjectProperty ;
    rdfs:label "has role assignment invoice" ;
    rdfs:comment "Relates an Invoice to its InvoiceOrganizationRoleAssignments." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceOrganizationRoleAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :roleAssignmentForInvoice .

:itemAssignmentForItem a owl:ObjectProperty ;
    rdfs:label "item assignment for item" ;
    rdfs:comment "Relates an InvoiceItemAssignment to the assigned Item." ;
    rdfs:domain :InvoiceItemAssignment ;
    rdfs:range :Item ;
    owl:functionalProperty true ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasItemAssignmentItem .

:hasItemAssignmentItem a owl:ObjectProperty ;
    rdfs:label "has item assignment item" ;
    rdfs:comment "Relates an Item to its InvoiceItemAssignments." ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceItemAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :itemAssignmentForItem .

:itemAssignmentForInvoice a owl:ObjectProperty ;
    rdfs:label "item assignment for invoice" ;
    rdfs:comment "Relates an InvoiceItemAssignment to the Invoice." ;
    rdfs:domain :InvoiceItemAssignment ;
    rdfs:range :Invoice ;
    owl:functionalProperty true ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasItemAssignmentInvoice .

:hasItemAssignmentInvoice a owl:ObjectProperty ;
    rdfs:label "has item assignment invoice" ;
    rdfs:comment "Relates an Invoice to its InvoiceItemAssignments." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceItemAssignment ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :itemAssignmentForInvoice .

:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an organization to its address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:functionalProperty true ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :isAddressOfOrganization .

:isAddressOfOrganization a owl:ObjectProperty ;
    rdfs:label "is address of organization" ;
    rdfs:comment "Relates an address to the organization it belongs to." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :hasAddress .

:assignedToProcess a owl:ObjectProperty ;
    rdfs:label "assigned to process" ;
    rdfs:comment "Relates an invoice to a business process." ;
    rdfs:domain :Invoice ;
    rdfs:range :BusinessProcess ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :isProcessAssignedToInvoice .

:isProcessAssignedToInvoice a owl:ObjectProperty ;
    rdfs:label "is process assigned to invoice" ;
    rdfs:comment "Relates a business process to invoices assigned to it." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Invoice ;
    owl:asymmetricProperty true ;
    owl:irreflexiveProperty true ;
    owl:inverseOf :assignedToProcess .

#################################################################
# Data Properties
#################################################################

:organizationName a owl:DatatypeProperty ;
    rdfs:label "organization name" ;
    rdfs:comment "Name of the organization." ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:label "address line" ;
    rdfs:comment "Address line of the address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "City of the address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code of the address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "Country of the address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:itemName a owl:DatatypeProperty ;
    rdfs:label "item name" ;
    rdfs:comment "Name of the item." ;
    rdfs:domain :Item ;
    rdfs:range xsd:string .

:netPrice a owl:DatatypeProperty ;
    rdfs:label "net price" ;
    rdfs:comment "Net price of the item." ;
    rdfs:domain :Item ;
    rdfs:range xsd:decimal .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:label "invoice amount" ;
    rdfs:comment "Total amount of the invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:decimal .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:label "invoice number" ;
    rdfs:comment "Number of the invoice." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:string .

:invoiceDetailText a owl:DatatypeProperty ;
    rdfs:label "invoice detail text" ;
    rdfs:comment "Textual details about the invoice." ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range xsd:string .

#################################################################
# Restrictions and Axioms
#################################################################

# An EDIFACTMessage must have at least one Invoice
:EDIFACTMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Invoice ] .

# Invoice must have at least one role assignment
:Invoice rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRoleAssignment ; owl:someValuesFrom :InvoiceOrganizationRoleAssignment ] .

# Invoice must have at least one item assignment
:Invoice rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItemAssignment ; owl:someValuesFrom :InvoiceItemAssignment ] .

# Organization must have an address
:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Address ] .

# Invoice has an invoice number
:Invoice rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :invoiceNumber ; owl:someValuesFrom xsd:string ] .

# Invoice has an invoice amount
:Invoice rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :invoiceAmount ; owl:someValuesFrom xsd:decimal ] .

# Invoice has at least one organization involved
:Invoice rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Organization ] .

# Disjointness
:Organization owl:disjointWith :Role, :Item, :Address, :Invoice .
:Invoice owl:disjointWith :Role, :Item, :Address, :BusinessProcess .
:Role owl:disjointWith :Item, :Address .
:Item owl:disjointWith :Address .

