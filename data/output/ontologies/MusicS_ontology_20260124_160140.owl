@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "An ontology modeling music production, bands, albums, performances, and related entities." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person, such as a musician or critic." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical group or band." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role a person can have in a band, such as vocalist or drummer." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A music album." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A track on an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live performance event." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances take place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographical region." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country." .

### Pivot/Reification Classes
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reification class for a person's membership in a band, possibly with a role and time period." .

:TrackRecording a owl:Class ;
    rdfs:label "Track Recording" ;
    rdfs:comment "A reification class for the recording of a track as a song." .

:AlbumRecordingPeriod a owl:Class ;
    rdfs:label "Album Recording Period" ;
    rdfs:comment "A reification class for the period a band records an album." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "A reification class for the performance of a song during a performance event." .

### Disjointness
:Person owl:disjointWith :Band, :Instrument .
:Album owl:disjointWith :Track, :Song, :Performance .
:Track owl:disjointWith :Song .

### Object Properties and Inverses
:playsInstrument a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Links a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :instrumentPlayedBy .

:instrumentPlayedBy a owl:ObjectProperty ;
    rdfs:label "instrument played by" ;
    rdfs:comment "Inverse: links an instrument to a person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Links a band to its band membership instance." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberOfBand .

:memberOfBand a owl:ObjectProperty ;
    rdfs:label "member of band" ;
    rdfs:comment "Inverse: links a band membership to the band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember .

:memberPerson a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "member person" ;
    rdfs:comment "Links a band membership to the person." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :personMembership .

:personMembership a owl:ObjectProperty ;
    rdfs:label "person membership" ;
    rdfs:comment "Inverse: links a person to their band memberships." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberPerson .

:memberRole a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "member role" ;
    rdfs:comment "Links a band membership to the role." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleMembership .

:roleMembership a owl:ObjectProperty ;
    rdfs:label "role membership" ;
    rdfs:comment "Inverse: links a role to band memberships with that role." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberRole .

:recordsAlbum a owl:ObjectProperty ;
    rdfs:label "records album" ;
    rdfs:comment "Links a band to an album recording period." ;
    rdfs:domain :Band ;
    rdfs:range :AlbumRecordingPeriod ;
    owl:inverseOf :recordedByBand .

:recordedByBand a owl:ObjectProperty ;
    rdfs:label "recorded by band" ;
    rdfs:comment "Inverse: links an album recording period to the band." ;
    rdfs:domain :AlbumRecordingPeriod ;
    rdfs:range :Band ;
    owl:inverseOf :recordsAlbum .

:albumRecorded a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "album recorded" ;
    rdfs:comment "Links an album recording period to the album." ;
    rdfs:domain :AlbumRecordingPeriod ;
    rdfs:range :Album ;
    owl:inverseOf :recordedInPeriod .

:recordedInPeriod a owl:ObjectProperty ;
    rdfs:label "recorded in period" ;
    rdfs:comment "Inverse: links an album to its recording period." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecordingPeriod ;
    owl:inverseOf :albumRecorded .

:hasTrack a owl:ObjectProperty ;
    rdfs:label "has track" ;
    rdfs:comment "Links an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfAlbum .

:trackOfAlbum a owl:ObjectProperty ;
    rdfs:label "track of album" ;
    rdfs:comment "Inverse: links a track to the album it is on." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :hasTrack .

:trackRecording a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "track recording" ;
    rdfs:comment "Links a track to its recording event." ;
    rdfs:domain :Track ;
    rdfs:range :TrackRecording ;
    owl:inverseOf :recordingOfTrack .

:recordingOfTrack a owl:ObjectProperty ;
    rdfs:label "recording of track" ;
    rdfs:comment "Inverse: links a track recording to the track." ;
    rdfs:domain :TrackRecording ;
    rdfs:range :Track ;
    owl:inverseOf :trackRecording .

:recordedSong a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "recorded song" ;
    rdfs:comment "Links a track recording to the recorded song." ;
    rdfs:domain :TrackRecording ;
    rdfs:range :Song ;
    owl:inverseOf :songRecordedIn .

:songRecordedIn a owl:ObjectProperty ;
    rdfs:label "song recorded in" ;
    rdfs:comment "Inverse: links a song to its track recording." ;
    rdfs:domain :Song ;
    rdfs:range :TrackRecording ;
    owl:inverseOf :recordedSong .

:criticReview a owl:ObjectProperty ;
    rdfs:label "critic review" ;
    rdfs:comment "Links a critic to an album they reviewed." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :reviewedByCritic .

:reviewedByCritic a owl:ObjectProperty ;
    rdfs:label "reviewed by critic" ;
    rdfs:comment "Inverse: links an album to its critic(s)." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :criticReview .

:performanceOf a owl:ObjectProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Links a performance to the album it features." ;
    rdfs:domain :Performance ;
    rdfs:range :Album ;
    owl:inverseOf :albumPerformedAt .

:albumPerformedAt a owl:ObjectProperty ;
    rdfs:label "album performed at" ;
    rdfs:comment "Inverse: links an album to performances that feature it." ;
    rdfs:domain :Album ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceOf .

:performanceLocation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "City where a performance took place." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :locationOfPerformance .

:locationOfPerformance a owl:ObjectProperty ;
    rdfs:label "location of performance" ;
    rdfs:comment "Inverse: links a city to performances held there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation .

:performedSong a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Links a performance song to the performed song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformedAt .

:songPerformedAt a owl:ObjectProperty ;
    rdfs:label "song performed at" ;
    rdfs:comment "Inverse: links a song to its performance song instance." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performedSong .

:performanceInstance a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "performance instance" ;
    rdfs:comment "Links a performance song to the performance event." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceSong .

:hasPerformanceSong a owl:ObjectProperty ;
    rdfs:label "has performance song" ;
    rdfs:comment "Inverse: links a performance to its performance song instance(s)." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceInstance .

:cityInRegion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "city in region" ;
    rdfs:comment "Links a city to its region." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Inverse: links a region to its cities." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :cityInRegion .

:regionInCountry a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "region in country" ;
    rdfs:comment "Links a region to its country." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Inverse: links a country to its regions." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :regionInCountry .

### Data Properties
:trackNumber a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track on an album." ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer .

:membershipStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "Start date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:membershipEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "End date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date of an album recording period." ;
    rdfs:domain :AlbumRecordingPeriod ;
    rdfs:range xsd:dateTime .

:recordingEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "End date of an album recording period." ;
    rdfs:domain :AlbumRecordingPeriod ;
    rdfs:range xsd:dateTime .

:songComposedOn a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "song composed on" ;
    rdfs:comment "Date a song was composed." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:reviewText a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "review text" ;
    rdfs:comment "Text of a critic's review." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:albumReleaseDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "album release date" ;
    rdfs:comment "Release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:performanceDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "Date of a performance event." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

### Restrictions
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:someValuesFrom :Track ] .
