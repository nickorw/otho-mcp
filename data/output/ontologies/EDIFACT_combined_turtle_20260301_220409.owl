@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests>
    a owl:Ontology ;
    owl:versionIRI <http://example.org/fests/1.0> .

#################################################################
# Core Document and Invoice Classes
#################################################################

:Cl_Entity a owl:Class .

:Cl_Document a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FinancialDocument a owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_FinancialDocument, :Cl_Document, :Cl_Entity ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued by a seller to a buyer indicating quantities, products, and agreed prices for products or services." .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:subClassOf :Cl_DocumentIdentifier .

:Cl_DocumentIdentifier a owl:Class .

#################################################################
# Invoice Listing, EDIFACT, and Message Content
#################################################################

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_MessageContent a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceListing a owl:Class ;
    rdfs:subClassOf :Cl_MessageContent, :Cl_Entity .

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_InvoiceListing owl:disjointWith :Cl_EDIFACTMessage, :Cl_Invoice .

:Cl_MessageContent owl:equivalentClass :Cl_InvoiceListing .

:hasMessageContent a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_MessageContent .

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    owl:inverseOf :isInvoiceListingOf .

:isInvoiceListingOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :isListedIn .

:isListedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceListing .

:Cl_InvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :listsInvoice ;
        owl:allValuesFrom :Cl_Invoice
    ]
] .

:Cl_EDIFACTMessage rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceListing ;
    owl:someValuesFrom :Cl_InvoiceListing
] .

#################################################################
# Invoice Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "Unique identifier for the invoice" .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "Date of the invoice" .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal ;
    rdfs:label "Total amount of the invoice" .

#################################################################
# Organization, Party, and Roles
#################################################################

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Organization" ;
    rdfs:comment "A generic organization, could be a company, institution, etc." .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_NonProfit a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_GovernmentAgency a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Supplier a owl:Class ;
    rdfs:subClassOf :Cl_Organization, :Cl_Party .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization, :Cl_Party .

:Cl_Party a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A reification class linking an organization to an invoice with a specific role (e.g., buyer, seller)." .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "A specific invoice role representing the buyer in an invoice." .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller Role" ;
    rdfs:comment "A specific invoice role representing the seller in an invoice." .

:Cl_InvoiceRoleType a owl:Class .

:Cl_InvoiceInvolvement a owl:Class .

:Cl_InvoiceParticipant a owl:Class .

:Cl_Organization rdfs:subClassOf :Cl_InvoiceParticipant .

#################################################################
# Organization Info Display
#################################################################

:Cl_OrganizationInfoDisplay a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Organization .

:displayedAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Address .

:displayedContactInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_ContactInfo .

:displayedLogo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Logo .

:displayedDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Description .

:displayedWebsite a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Website .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

#################################################################
# Address, Contact, and Buyer
#################################################################

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_Address a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ContactInfo a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Logo a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Description a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Website a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BuyerAddress a owl:Class .

:buyerAddress_buyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddress ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "associates the BuyerAddress relation to the Buyer" .

:buyerAddress_address a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddress ;
    rdfs:range :Cl_Address ;
    rdfs:label "associates the BuyerAddress relation to the Address" .

:address_street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:phoneNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string .

:email a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string .

:logoURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Logo ;
    rdfs:range xsd:anyURI .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_Description ;
    rdfs:range xsd:string .

:websiteURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Website ;
    rdfs:range xsd:anyURI .

:Cl_BuyerAddress owl:equivalentClass [
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerAddress_buyer ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerAddress_address ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

#################################################################
# Invoice Items, Products, and Sale Display
#################################################################

:Cl_Item a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Item" ;
    rdfs:comment "An item that is sold." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceItem a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceLine a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_PriceComponent a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_MonetaryAmount a owl:Class ;
    rdfs:subClassOf :Cl_PriceComponent, :Cl_Entity .

:Cl_NetPriceComputation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Amount a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Currency a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Date a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_SaleDisplay a owl:Class ;
    rdfs:label "Sale Display" ;
    rdfs:comment "The display of information about an item sold." .

:Cl_InformationType a owl:Class ;
    rdfs:label "Information Type" ;
    rdfs:comment "A type of information that can be displayed about an item sold." .

:Cl_ItemInformationDisplay a owl:Class ;
    rdfs:label "Item Information Display" ;
    rdfs:comment "A reification class representing the display of a specific information type about an item in a sale display." .

:Cl_DescriptiveInformation a owl:Class ;
    rdfs:subClassOf :Cl_InformationType ;
    rdfs:label "Descriptive Information" ;
    rdfs:comment "Descriptive information about an item, such as name or description." .

:Cl_PriceInformation a owl:Class ;
    rdfs:subClassOf :Cl_InformationType ;
    rdfs:label "Price Information" ;
    rdfs:comment "Price-related information about an item." .

:Cl_StockInformation a owl:Class ;
    rdfs:subClassOf :Cl_InformationType ;
    rdfs:label "Stock Information" ;
    rdfs:comment "Stock or availability information about an item." .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformationDisplay ;
    rdfs:range :Cl_Item .

:hasSaleDisplay a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformationDisplay ;
    rdfs:range :Cl_SaleDisplay .

:hasInformationType a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformationDisplay ;
    rdfs:range :Cl_InformationType .

:itemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:decimal .

:itemStockLevel a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:integer .

:displayedValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformationDisplay ;
    rdfs:range xsd:string .

:Cl_ItemInformationDisplay owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasItem ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasSaleDisplay ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInformationType ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_DescriptiveInformation owl:disjointWith :Cl_PriceInformation, :Cl_StockInformation .
:Cl_PriceInformation owl:disjointWith :Cl_StockInformation .

#################################################################
# Invoice Items, Products, and Net Price Computation
#################################################################

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Item .

:refersToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product .

:hasNetPriceComputation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPriceComputation .

:includesInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceComputation ;
    rdfs:range :Cl_InvoiceItem ;
    owl:inverseOf :isIncludedInNetPriceComputation .

:isIncludedInNetPriceComputation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_NetPriceComputation .

:hasTotalNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceComputation ;
    rdfs:range :Cl_MonetaryAmount .

:hasSoldItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Item ;
    owl:inverseOf :isSoldInInvoice .

:isSoldInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_Invoice .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:currency a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:string .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal .

#################################################################
# Invoice Details, Tax, Payment Terms
#################################################################

:Cl_InvoiceDetails a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_PaymentTerms a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Tax a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:hasInvoiceDetails a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetails .

:detailsOfInvoice a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceDetails .

:involvesSupplier a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Supplier .

:involvesCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Customer .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_InvoiceLine .

:hasPaymentTerms a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_PaymentTerms .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Currency .

:hasTax a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Tax .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Amount .

:hasIssueDate a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Date .

:hasDueDate a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Date .

:description a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:string .

:taxRate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Tax ;
    rdfs:range xsd:decimal .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

:paymentTermsDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_PaymentTerms ;
    rdfs:range xsd:string .

:dateValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Date ;
    rdfs:range xsd:date .

#################################################################
# Invoice Amount Assignment (Reification)
#################################################################

:Cl_InvoiceAmount a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "The monetary value associated with an invoice." .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Invoice Amount Assignment" ;
    rdfs:comment "A reification class representing the assignment of an amount to an invoice." .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links an InvoiceAmountAssignment to the Invoice." .

:hasInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "Links an InvoiceAmountAssignment to the InvoiceAmount." .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string ;
    rdfs:label "amount currency" ;
    rdfs:comment "The currency of the invoice amount (e.g., USD, EUR)." .

#################################################################
# Invoice Document Identifier
#################################################################

:hasDocumentIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_DocumentIdentifier .

:hasInvoiceIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentifier ;
    rdfs:subPropertyOf :hasDocumentIdentifier .

:invoiceIdentifierValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string .

#################################################################
# File Format, Validation, and Requirements
#################################################################

:Cl_FileFormat a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_File a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ValidationRequirement a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_MetadataRequirement a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement .

:Cl_StructureRequirement a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement .

:Cl_ContentRequirement a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement .

:Cl_Field a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FieldType a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FieldConstraint a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ValidFileFormatInformation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FileFormatValidation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:hasValidationRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_ValidationRequirement .

:requiresMetadata a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_MetadataRequirement ;
    rdfs:subPropertyOf :hasValidationRequirement .

:requiresStructure a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_StructureRequirement ;
    rdfs:subPropertyOf :hasValidationRequirement .

:requiresContent a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_ContentRequirement ;
    rdfs:subPropertyOf :hasValidationRequirement .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_Field .

:fieldType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldType .

:fieldConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldConstraint .

:isRequirementOf a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range :Cl_FileFormat ;
    owl:inverseOf :hasValidationRequirement .

:aboutFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidFileFormatInformation ;
    rdfs:range :Cl_FileFormat .

:describesRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidFileFormatInformation ;
    rdfs:range :Cl_ValidationRequirement .

:hasFileFormatValidation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatValidation .

:validatedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_File ;
    rdfs:range :Cl_FileFormatValidation .

:validatesFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range :Cl_FileFormat .

:validatesFile a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range :Cl_File .

:validationRequirementMet a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range :Cl_ValidationRequirement .

:fieldName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:string .

:fieldRequired a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:boolean .

:fieldTypeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldType ;
    rdfs:range xsd:string .

:constraintExpression a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range xsd:string .

:metadataKey a owl:DatatypeProperty ;
    rdfs:domain :Cl_MetadataRequirement ;
    rdfs:range xsd:string .

:metadataRequired a owl:DatatypeProperty ;
    rdfs:domain :Cl_MetadataRequirement ;
    rdfs:range xsd:boolean .

:structureDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_StructureRequirement ;
    rdfs:range xsd:string .

:contentDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContentRequirement ;
    rdfs:range xsd:string .

:validationStatus a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range xsd:boolean .

:validationMessage a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range xsd:string .

#################################################################
# Business Process Assignment to Invoice
#################################################################

:Cl_BusinessProcess a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ProcessAssignment a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:hasProcessAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_ProcessAssignment .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_ProcessAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasProcessAssignment .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_ProcessAssignment ;
    rdfs:range :Cl_BusinessProcess .

:hasAssignedInvoiceProcessAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_ProcessAssignment ;
    owl:inverseOf :assignedBusinessProcess .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_ProcessAssignment ;
    rdfs:range xsd:dateTime .

:businessProcessName a owl:DatatypeProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range xsd:string .

#################################################################
# Invoice Role Properties
#################################################################

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization .

:isRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceRole .

:roleType a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRoleType .

:roleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRoleType ;
    rdfs:range xsd:string .

#################################################################
# Invoice Involvement Properties
#################################################################

:involvesOrganizationInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceInvolvement ;
    rdfs:range :Cl_Organization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceInvolvement ;
    rdfs:range :Cl_Invoice .

:hasInvoiceInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceInvolvement .

:organizationRole a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceInvolvement ;
    rdfs:range xsd:string .

#################################################################
# Restrictions and Axioms
#################################################################

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceDetails ; owl:allValuesFrom :Cl_InvoiceDetails ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceInvolvement ; owl:someValuesFrom :Cl_InvoiceInvolvement ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceIdentifier ; owl:allValuesFrom :Cl_InvoiceIdentifier ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceItem ; owl:minCardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_InvoiceDetails owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesSupplier ; owl:someValuesFrom :Cl_Supplier ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesCustomer ; owl:someValuesFrom :Cl_Customer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasCurrency ; owl:someValuesFrom :Cl_Currency ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasIssueDate ; owl:someValuesFrom :Cl_Date ]
    )
] .

:Cl_InvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :roleType ; owl:someValuesFrom :Cl_InvoiceRoleType ]
        [ rdf:type owl:Restriction ; owl:onProperty :isRoleInInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceRole owl:disjointUnionOf ( :Cl_BuyerRole :Cl_SellerRole ) .

:Cl_BuyerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:allValuesFrom :Cl_Organization
        ]
        [ a owl:Restriction ;
          owl:onProperty :isRoleInInvoice ;
          owl:allValuesFrom :Cl_Invoice
        ]
    )
] .

:Cl_InvoiceInvolvement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganizationInvolvement ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :organizationRole ; owl:someValuesFrom xsd:string ]
    )
] .

:Cl_InvoiceIdentifier owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceIdentifierValue ;
    owl:allValuesFrom xsd:string
] .

:Cl_InvoiceAmountAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasInvoice ;
              owl:cardinality "1"^^xsd:nonNegativeInteger ;
              owl:allValuesFrom :Cl_Invoice ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasInvoiceAmount ;
              owl:cardinality "1"^^xsd:nonNegativeInteger ;
              owl:allValuesFrom :Cl_InvoiceAmount ]
        )
    ] .

:Cl_InvoiceItem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_NetPriceComputation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :includesInvoiceItem ;
          owl:someValuesFrom :Cl_InvoiceItem
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasTotalNetPrice ;
          owl:someValuesFrom :Cl_MonetaryAmount
        ]
    )
] .

:Cl_FileFormat owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasValidationRequirement ; owl:someValuesFrom :Cl_ValidationRequirement ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasField ; owl:someValuesFrom :Cl_Field ]
    )
] .

:Cl_Field owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :fieldType ; owl:someValuesFrom :Cl_FieldType ]
        [ rdf:type owl:Restriction ; owl:onProperty :fieldConstraint ; owl:someValuesFrom :Cl_FieldConstraint ]
    )
] .

:Cl_ValidFileFormatInformation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasValidationRequirement ; owl:someValuesFrom :Cl_ValidationRequirement ]
        [ rdf:type owl:Restriction ; owl:onProperty :aboutFileFormat ; owl:someValuesFrom :Cl_FileFormat ]
    )
] .

:Cl_ProcessAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ; owl:onProperty :assignedInvoice ; owl:someValuesFrom :Cl_Invoice ]
            [ rdf:type owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
        )
    ] .

#################################################################
# Disjointness
#################################################################

:Cl_Company owl:disjointWith :Cl_NonProfit, :Cl_GovernmentAgency, :Cl_Supplier, :Cl_Customer .
:Cl_NonProfit owl:disjointWith :Cl_GovernmentAgency .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Invoice owl:disjointWith :Cl_InvoiceLine, :Cl_Product, :Cl_Currency, :Cl_PaymentTerms, :Cl_Tax, :Cl_Amount, :Cl_Date, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_BusinessProcess, :Cl_ProcessAssignment, :Cl_InvoiceItem, :Cl_Item, :Cl_InvoiceRole, :Cl_InvoiceListing, :Cl_EDIFACTMessage, :Cl_PriceComponent, :Cl_MonetaryAmount, :Cl_NetPriceComputation, :Cl_File, :Cl_FileFormat .
:Cl_InvoiceLine owl:disjointWith :Cl_PaymentTerms, :Cl_Amount, :Cl_Date, :Cl_InvoiceItem, :Cl_Item .
:Cl_InvoiceItem owl:disjointWith :Cl_Item, :Cl_MonetaryAmount, :Cl_NetPriceComputation .
:Cl_Item owl:disjointWith :Cl_Invoice, :Cl_InvoiceItem, :Cl_InvoiceLine, :Cl_Product, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment .
:Cl_InvoiceRole owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_Item, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment .
:Cl_InvoiceRoleType owl:disjointWith :Cl_Organization, :Cl_Invoice .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_DescriptiveInformation owl:disjointWith :Cl_PriceInformation, :Cl_StockInformation .
:Cl_PriceInformation owl:disjointWith :Cl_StockInformation .
:Cl_ValidationRequirement owl:disjointWith :Cl_Field .
:Cl_FieldType owl:disjointWith :Cl_FieldConstraint .
:Cl_FileFormat owl:disjointWith :Cl_File .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_BusinessProcess owl:disjointWith :Cl_ProcessAssignment .
:Cl_InvoiceAmount owl:disjointWith :Cl_InvoiceAmountAssignment .
:Cl_InvoiceIdentifier owl:disjointWith :Cl_DocumentIdentifier .

#################################################################
# Additional Equivalent Classes
#################################################################

:Cl_Company owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Organization
        [ rdf:type owl:Restriction ; owl:onProperty :organizationName ; owl:someValuesFrom xsd:string ]
    )
] .

:Cl_NonProfit owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Organization
        [ rdf:type owl:Restriction ; owl:onProperty :organizationName ; owl:someValuesFrom xsd:string ]
    )
] .

:Cl_GovernmentAgency owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Organization
        [ rdf:type owl:Restriction ; owl:onProperty :organizationName ; owl:someValuesFrom xsd:string ]
    )
] .
