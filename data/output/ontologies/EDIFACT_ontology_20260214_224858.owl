@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#edifact_invoice_story>
    a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Ontology"@en ;
    rdfs:comment "A deep and richly structured ontology modeling the UN/EDIFACT invoice message structure, organization roles, and semantic interoperability requirements."@en .

#################################################################
# CLASSES
#################################################################

:EdifactInterchange a owl:Class ;
    rdfs:label "EDIFACT Interchange"@en ;
    rdfs:comment "An envelope that contains one or more EDIFACT messages as part of a digital business document exchange."@en .

:EdifactMessage a owl:Class ;
    rdfs:label "EDIFACT Message"@en ;
    rdfs:comment "A message contained within an EDIFACT Interchange, such as INVOIC."@en .

:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message (INVOIC)"@en ;
    rdfs:comment "An EDIFACT message representing an invoice, composed of segments and sections."@en ;
    rdfs:subClassOf :EdifactMessage .

:EdifactSegment a owl:Class ;
    rdfs:label "EDIFACT Segment"@en ;
    rdfs:comment "A segment within an EDIFACT message, such as BGM or NAD."@en .

:BgmSegment a owl:Class ;
    rdfs:label "BGM Segment"@en ;
    rdfs:comment "Beginning of Message segment for document identification in EDIFACT."@en ;
    rdfs:subClassOf :EdifactSegment .

:NadSegment a owl:Class ;
    rdfs:label "NAD Segment"@en ;
    rdfs:comment "Name and Address segment for participant details in EDIFACT."@en ;
    rdfs:subClassOf :EdifactSegment .

:EdifactCompositeElement a owl:Class ;
    rdfs:label "EDIFACT Composite Element"@en ;
    rdfs:comment "A composite data element in an EDIFACT segment."@en .

:EdifactSimpleElement a owl:Class ;
    rdfs:label "EDIFACT Simple Element"@en ;
    rdfs:comment "A simple data element in an EDIFACT composite element."@en .

:EdifactDelimiter a owl:Class ;
    rdfs:label "EDIFACT Delimiter"@en ;
    rdfs:comment "A symbol used to separate segments and elements in EDIFACT messages."@en .

:InvoiceSection a owl:Class ;
    rdfs:label "Invoice Section"@en ;
    rdfs:comment "A logical section of an invoice message (header, detail, summary)."@en .

:HeaderSection a owl:Class ;
    rdfs:label "Header Section"@en ;
    rdfs:comment "The header section of an invoice, containing document dates and reference numbers."@en ;
    rdfs:subClassOf :InvoiceSection .

:DetailSection a owl:Class ;
    rdfs:label "Detail Section"@en ;
    rdfs:comment "The detail section of an invoice, listing line items."@en ;
    rdfs:subClassOf :InvoiceSection .

:SummarySection a owl:Class ;
    rdfs:label "Summary Section"@en ;
    rdfs:comment "The summary section of an invoice, providing totals and taxes."@en ;
    rdfs:subClassOf :InvoiceSection .

:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "A legal entity such as a buyer or delivery party involved in a transaction."@en .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role"@en ;
    rdfs:comment "A role played by an organization in the context of an invoice."@en .

:BuyerRole a owl:Class ;
    rdfs:label "Buyer Role"@en ;
    rdfs:comment "The role of buyer in an invoice transaction."@en ;
    rdfs:subClassOf :AgentRole .

:DeliveryPartyRole a owl:Class ;
    rdfs:label "Delivery Party Role"@en ;
    rdfs:comment "The role of delivery party in an invoice transaction."@en ;
    rdfs:subClassOf :AgentRole .

:OrganizationRoleAssignment a owl:Class ;
    rdfs:label "Organization Role Assignment"@en ;
    rdfs:comment "A reified relationship associating an Organization with a specific AgentRole within an invoice context."@en .

:Address a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "A postal address associated with an organization."@en .

:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "A generic identifier for organizations or documents."@en .

:GlobalLocationNumber a owl:Class ;
    rdfs:label "Global Location Number"@en ;
    rdfs:comment "A global identifier for locations, as defined by GS1."@en ;
    rdfs:subClassOf :Identifier .

:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "A product or service listed in the invoice."@en .

:InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line"@en ;
    rdfs:comment "A line item in the invoice, referencing an item, quantity, and price."@en .

:InvoiceLineItemAssignment a owl:Class ;
    rdfs:label "Invoice Line Item Assignment"@en ;
    rdfs:comment "A pivot class reifying the assignment of an item to an invoice line."@en .

:Price a owl:Class ;
    rdfs:label "Price"@en ;
    rdfs:comment "The price of an item or line in the invoice."@en .

:Tax a owl:Class ;
    rdfs:label "Tax"@en ;
    rdfs:comment "A tax amount associated with an invoice or line item."@en .

:Amount a owl:Class ;
    rdfs:label "Amount"@en ;
    rdfs:comment "A monetary amount in the invoice context."@en .

:ReferenceNumber a owl:Class ;
    rdfs:label "Reference Number"@en ;
    rdfs:comment "A reference number, such as an invoice number."@en .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process"@en ;
    rdfs:comment "A business process to which the invoice is assigned."@en .

:Standard a owl:Class ;
    rdfs:label "Standard (EN16931-1)"@en ;
    rdfs:comment "A standard such as EN16931-1 for invoice data interoperability."@en .

:OntologyAlignmentPivot a owl:Class ;
    rdfs:label "Ontology Alignment Pivot"@en ;
    rdfs:comment "A pivot class for aligning with external ontologies such as P2P-O."@en .

:SHACLConstraint a owl:Class ;
    rdfs:label "SHACL Constraint"@en ;
    rdfs:comment "A SHACL constraint for validating invoice data consistency."@en .

#################################################################
# OBJECT PROPERTIES (with inverses)
#################################################################

:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains message"@en ;
    rdfs:comment "Links an EDIFACT Interchange to its contained EDIFACT Message(s)."@en ;
    rdfs:domain :EdifactInterchange ;
    rdfs:range :EdifactMessage ;
    owl:inverseOf :isContainedInInterchange .

:isContainedInInterchange a owl:ObjectProperty ;
    rdfs:label "is contained in EDIFACT Interchange"@en ;
    rdfs:comment "Indicates the EDIFACT Interchange in which this message is contained."@en ;
    rdfs:domain :EdifactMessage ;
    rdfs:range :EdifactInterchange ;
    owl:inverseOf :containsMessage .

:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment"@en ;
    rdfs:comment "Associates an EDIFACT Message with its segments."@en ;
    rdfs:domain :EdifactMessage ;
    rdfs:range :EdifactSegment ;
    owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
    rdfs:label "is segment of EDIFACT Message"@en ;
    rdfs:comment "Indicates the EDIFACT Message of which this segment is a part."@en ;
    rdfs:domain :EdifactSegment ;
    rdfs:range :EdifactMessage ;
    owl:inverseOf :hasSegment .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has section"@en ;
    rdfs:comment "Associates an invoice message with its sections (header, detail, summary)."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :InvoiceSection ;
    owl:inverseOf :isSectionOf .

:isSectionOf a owl:ObjectProperty ;
    rdfs:label "is section of Invoice Message"@en ;
    rdfs:comment "Indicates the Invoice Message of which this section is a part."@en ;
    rdfs:domain :InvoiceSection ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasSection .

:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has header"@en ;
    rdfs:comment "Links an invoice message to its header section."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :HeaderSection ;
    owl:inverseOf :isHeaderOf .

:isHeaderOf a owl:ObjectProperty ;
    rdfs:label "is header of Invoice Message"@en ;
    rdfs:comment "Indicates the Invoice Message for which this section is the header."@en ;
    rdfs:domain :HeaderSection ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasHeader .

:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has detail"@en ;
    rdfs:comment "Links an invoice message to its detail section."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :DetailSection ;
    owl:inverseOf :isDetailOf .

:isDetailOf a owl:ObjectProperty ;
    rdfs:label "is detail of Invoice Message"@en ;
    rdfs:comment "Indicates the Invoice Message for which this section is the detail."@en ;
    rdfs:domain :DetailSection ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasDetail .

:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has summary"@en ;
    rdfs:comment "Links an invoice message to its summary section."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :SummarySection ;
    owl:inverseOf :isSummaryOf .

:isSummaryOf a owl:ObjectProperty ;
    rdfs:label "is summary of Invoice Message"@en ;
    rdfs:comment "Indicates the Invoice Message for which this section is the summary."@en ;
    rdfs:domain :SummarySection ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasSummary .

:hasCompositeElement a owl:ObjectProperty ;
    rdfs:label "has composite element"@en ;
    rdfs:comment "Associates an EDIFACT segment with its composite elements."@en ;
    rdfs:domain :EdifactSegment ;
    rdfs:range :EdifactCompositeElement ;
    owl:inverseOf :isCompositeElementOf .

:isCompositeElementOf a owl:ObjectProperty ;
    rdfs:label "is composite element of EDIFACT Segment"@en ;
    rdfs:comment "Indicates the EDIFACT Segment of which this composite element is a part."@en ;
    rdfs:domain :EdifactCompositeElement ;
    rdfs:range :EdifactSegment ;
    owl:inverseOf :hasCompositeElement .

:hasSimpleElement a owl:ObjectProperty ;
    rdfs:label "has simple element"@en ;
    rdfs:comment "Associates a composite element with its simple elements."@en ;
    rdfs:domain :EdifactCompositeElement ;
    rdfs:range :EdifactSimpleElement ;
    owl:inverseOf :isSimpleElementOf .

:isSimpleElementOf a owl:ObjectProperty ;
    rdfs:label "is simple element of EDIFACT Composite Element"@en ;
    rdfs:comment "Indicates the EDIFACT Composite Element to which this simple element belongs."@en ;
    rdfs:domain :EdifactSimpleElement ;
    rdfs:range :EdifactCompositeElement ;
    owl:inverseOf :hasSimpleElement .

:hasDelimiter a owl:ObjectProperty ;
    rdfs:label "has delimiter"@en ;
    rdfs:comment "Associates an EDIFACT message with its delimiters."@en ;
    rdfs:domain :EdifactMessage ;
    rdfs:range :EdifactDelimiter ;
    owl:inverseOf :isDelimiterOf .

:isDelimiterOf a owl:ObjectProperty ;
    rdfs:label "is delimiter of EDIFACT Message"@en ;
    rdfs:comment "Indicates the EDIFACT Message to which this delimiter applies."@en ;
    rdfs:domain :EdifactDelimiter ;
    rdfs:range :EdifactMessage ;
    owl:inverseOf :hasDelimiter .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment"@en ;
    rdfs:comment "Links an organization to its role assignment(s) in a transaction."@en ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :isRoleAssignmentOf .

:isRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:label "is role assignment of Organization"@en ;
    rdfs:comment "Indicates the Organization to which this role assignment applies."@en ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :hasRoleAssignment .

:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned role"@en ;
    rdfs:comment "Indicates the agent role assigned in a role assignment."@en ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :AgentRole ;
    owl:inverseOf :isAssignedRoleOf .

:isAssignedRoleOf a owl:ObjectProperty ;
    rdfs:label "is assigned role of OrganizationRoleAssignment"@en ;
    rdfs:comment "Indicates the OrganizationRoleAssignment that assigned this AgentRole."@en ;
    rdfs:domain :AgentRole ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :assignedRole .

:assignedToInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to invoice"@en ;
    rdfs:comment "Links a role assignment to the relevant invoice message."@en ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasRoleAssignmentForInvoice .

:hasRoleAssignmentForInvoice a owl:ObjectProperty ;
    rdfs:label "has role assignment for Invoice Message"@en ;
    rdfs:comment "Indicates the OrganizationRoleAssignment associated with this Invoice Message."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :assignedToInvoice .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address"@en ;
    rdfs:comment "Links an organization to its address."@en ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of Organization"@en ;
    rdfs:comment "Indicates the Organization to which this address belongs."@en ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .

:hasIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has identifier"@en ;
    rdfs:comment "Links an organization to its identifier."@en ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier ;
    owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:label "is identifier of Organization"@en ;
    rdfs:comment "Indicates the Organization to which this identifier applies."@en ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization ;
    owl:inverseOf :hasIdentifier .

:hasInvoiceLineAssignment a owl:ObjectProperty ;
    rdfs:label "has invoice line assignment"@en ;
    rdfs:comment "Links an invoice message to its invoice line item assignments."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :InvoiceLineItemAssignment ;
    owl:inverseOf :isInvoiceLineAssignmentOf .

:isInvoiceLineAssignmentOf a owl:ObjectProperty ;
    rdfs:label "is invoice line assignment of Invoice Message"@en ;
    rdfs:comment "Indicates the Invoice Message to which this InvoiceLineItemAssignment applies."@en ;
    rdfs:domain :InvoiceLineItemAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasInvoiceLineAssignment .

:assignedItem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned item"@en ;
    rdfs:comment "Links an invoice line item assignment to the item."@en ;
    rdfs:domain :InvoiceLineItemAssignment ;
    rdfs:range :Item ;
    owl:inverseOf :isItemAssignmentOf .

:isItemAssignmentOf a owl:ObjectProperty ;
    rdfs:label "is item assignment of InvoiceLineItemAssignment"@en ;
    rdfs:comment "Indicates the InvoiceLineItemAssignment that assigned this Item."@en ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceLineItemAssignment ;
    owl:inverseOf :assignedItem .

:assignedInvoiceLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned invoice line"@en ;
    rdfs:comment "Links an invoice line item assignment to the invoice line."@en ;
    rdfs:domain :InvoiceLineItemAssignment ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :isInvoiceLineAssignmentFor .

:isInvoiceLineAssignmentFor a owl:ObjectProperty ;
    rdfs:label "is invoice line assignment for InvoiceLine"@en ;
    rdfs:comment "Indicates the InvoiceLine to which this InvoiceLineItemAssignment applies."@en ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :InvoiceLineItemAssignment ;
    owl:inverseOf :assignedInvoiceLine .

:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has price"@en ;
    rdfs:comment "Links an invoice line to its price."@en ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :Price ;
    owl:inverseOf :isPriceOf .

:isPriceOf a owl:ObjectProperty ;
    rdfs:label "is price of InvoiceLine"@en ;
    rdfs:comment "Indicates the InvoiceLine to which this price applies."@en ;
    rdfs:domain :Price ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :hasPrice .

:hasTax a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has tax"@en ;
    rdfs:comment "Links an invoice line to its tax."@en ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :Tax ;
    owl:inverseOf :isTaxOf .

:isTaxOf a owl:ObjectProperty ;
    rdfs:label "is tax of InvoiceLine"@en ;
    rdfs:comment "Indicates the InvoiceLine to which this tax applies."@en ;
    rdfs:domain :Tax ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :hasTax .

:hasAmount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has amount"@en ;
    rdfs:comment "Links an invoice line to its amount."@en ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :Amount ;
    owl:inverseOf :isAmountOf .

:isAmountOf a owl:ObjectProperty ;
    rdfs:label "is amount of InvoiceLine"@en ;
    rdfs:comment "Indicates the InvoiceLine to which this amount applies."@en ;
    rdfs:domain :Amount ;
    rdfs:range :InvoiceLine ;
    owl:inverseOf :hasAmount .

:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has reference number"@en ;
    rdfs:comment "Links an invoice message to its reference number."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ReferenceNumber ;
    owl:inverseOf :isReferenceNumberOf .

:isReferenceNumberOf a owl:ObjectProperty ;
    rdfs:label "is reference number of InvoiceMessage"@en ;
    rdfs:comment "Indicates the InvoiceMessage to which this reference number applies."@en ;
    rdfs:domain :ReferenceNumber ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasReferenceNumber .

:assignedToBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to business process"@en ;
    rdfs:comment "Links an invoice message to a business process."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :hasInvoiceForBusinessProcess .

:hasInvoiceForBusinessProcess a owl:ObjectProperty ;
    rdfs:label "has invoice for Business Process"@en ;
    rdfs:comment "Indicates the BusinessProcess for which this InvoiceMessage is assigned."@en ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :assignedToBusinessProcess .

:alignedWithStandard a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "aligned with standard"@en ;
    rdfs:comment "Links an invoice message to the standard it conforms to (e.g., EN16931-1)."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Standard ;
    owl:inverseOf :isStandardFor .

:isStandardFor a owl:ObjectProperty ;
    rdfs:label "is standard for InvoiceMessage"@en ;
    rdfs:comment "Indicates the InvoiceMessage for which this standard applies."@en ;
    rdfs:domain :Standard ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :alignedWithStandard .

:alignsWithP2PO a owl:ObjectProperty ;
    rdfs:label "aligns with P2P-O"@en ;
    rdfs:comment "Aligns ontology elements with the Purchase-to-Pay Ontology (P2P-O)."@en ;
    rdfs:domain :OntologyAlignmentPivot ;
    rdfs:range owl:Thing ;
    owl:inverseOf :isAlignedWithByP2PO .

:isAlignedWithByP2PO a owl:ObjectProperty ;
    rdfs:label "is aligned with by P2P-O"@en ;
    rdfs:comment "Indicates the OntologyAlignmentPivot with which this element is aligned by P2P-O."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range :OntologyAlignmentPivot ;
    owl:inverseOf :alignsWithP2PO .

:hasSHACLConstraint a owl:ObjectProperty ;
    rdfs:label "has SHACL constraint"@en ;
    rdfs:comment "Links an invoice message to its SHACL constraints for validation."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :SHACLConstraint ;
    owl:inverseOf :isSHACLConstraintOf .

:isSHACLConstraintOf a owl:ObjectProperty ;
    rdfs:label "is SHACL constraint of InvoiceMessage"@en ;
    rdfs:comment "Indicates the InvoiceMessage to which this SHACL constraint applies."@en ;
    rdfs:domain :SHACLConstraint ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasSHACLConstraint .

#################################################################
# DATA PROPERTIES
#################################################################

:segmentCode a owl:DatatypeProperty ;
    rdfs:label "segment code"@en ;
    rdfs:comment "The segment code (e.g., 'BGM', 'NAD') for EDIFACT segments."@en ;
    rdfs:domain :EdifactSegment ;
    rdfs:range xsd:string .

:elementValue a owl:DatatypeProperty ;
    rdfs:label "element value"@en ;
    rdfs:comment "The value of a simple element in an EDIFACT composite."@en ;
    rdfs:domain :EdifactSimpleElement ;
    rdfs:range xsd:string .

:delimiterSymbol a owl:DatatypeProperty ;
    rdfs:label "delimiter symbol"@en ;
    rdfs:comment "The delimiter symbol for EDIFACT messages (e.g., '+', ':')."@en ;
    rdfs:domain :EdifactDelimiter ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:label "address line"@en ;
    rdfs:comment "A line of a postal address."@en ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code"@en ;
    rdfs:comment "The postal code of an address."@en ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:label "city"@en ;
    rdfs:comment "The city of an address."@en ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:label "country"@en ;
    rdfs:comment "The country of an address."@en ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:identifierValue a owl:DatatypeProperty ;
    rdfs:label "identifier value"@en ;
    rdfs:comment "The string value of an identifier."@en ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:label "item description"@en ;
    rdfs:comment "A description of an item in the invoice."@en ;
    rdfs:domain :Item ;
    rdfs:range xsd:string .

:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "The quantity of an item in an invoice line."@en ;
    rdfs:domain :InvoiceLine ;
    rdfs:range xsd:decimal .

:netPrice a owl:DatatypeProperty ;
    rdfs:label "net price"@en ;
    rdfs:comment "The net price for an item or invoice line."@en ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal .

:taxAmount a owl:DatatypeProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "The tax amount for an invoice or line item."@en ;
    rdfs:domain :Tax ;
    rdfs:range xsd:decimal .

:totalAmount a owl:DatatypeProperty ;
    rdfs:label "total amount"@en ;
    rdfs:comment "The total monetary amount for an invoice."@en ;
    rdfs:domain :Amount ;
    rdfs:range xsd:decimal .

:referenceNumberValue a owl:DatatypeProperty ;
    rdfs:label "reference number value"@en ;
    rdfs:comment "The value of a reference number such as an invoice number."@en ;
    rdfs:domain :ReferenceNumber ;
    rdfs:range xsd:string .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:label "invoice date"@en ;
    rdfs:comment "The invoice date as a string (use ISO 8601 format)."@en ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .

:mandatoryIdentifier a owl:DatatypeProperty ;
    rdfs:label "mandatory identifier"@en ;
    rdfs:comment "A mandatory identifier required by the D96A directory."@en ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string .

#################################################################
# ANNOTATION AXIOMS
#################################################################
# All classes and properties are annotated with rdfs:label and rdfs:comment.

#################################################################
# HIERARCHY AXIOMS
#################################################################
:HeaderSection owl:disjointWith :DetailSection, :SummarySection .
:DetailSection owl:disjointWith :SummarySection .
:BuyerRole owl:disjointWith :DeliveryPartyRole .
:Organization owl:disjointWith :Item, :InvoiceLine, :EdifactMessage, :Address .
:InvoiceSection owl:disjointWith :Organization, :EdifactSegment .
:Amount owl:disjointWith :Price, :Tax .
:Identifier owl:disjointWith :Address .
:Standard owl:disjointWith :BusinessProcess .

#################################################################
# EQUIVALENCE AND GCAs (EXAMPLES)
#################################################################
:InvoiceMessage owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :InvoiceSection ] .

#################################################################
# GENERAL CLASS AXIOMS (GCAs)
#################################################################
[ a owl:Restriction ; owl:onProperty :hasInvoiceLineAssignment ; owl:someValuesFrom :InvoiceLineItemAssignment ; rdfs:subClassOf :InvoiceMessage ] .
[ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ; rdfs:subClassOf :OrganizationRoleAssignment ] .

#################################################################
# PROPERTY CHARACTERISTICS
#################################################################
:containsMessage a owl:FunctionalProperty .
:hasHeader a owl:FunctionalProperty .
:hasDetail a owl:FunctionalProperty .
:hasSummary a owl:FunctionalProperty .
:assignedRole a owl:FunctionalProperty .
:assignedToInvoice a owl:FunctionalProperty .
:hasAddress a owl:FunctionalProperty .
:hasIdentifier a owl:FunctionalProperty .
:assignedItem a owl:FunctionalProperty .
:assignedInvoiceLine a owl:FunctionalProperty .
:hasPrice a owl:FunctionalProperty .
:hasTax a owl:FunctionalProperty .
:hasAmount a owl:FunctionalProperty .
:hasReferenceNumber a owl:FunctionalProperty .
:assignedToBusinessProcess a owl:FunctionalProperty .
:alignedWithStandard a owl:FunctionalProperty .

#################################################################
# END OF ONTOLOGY
#################################################################
