:validationStatus a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range xsd:boolean ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Status of the file format validation."@en .

#################################################################
# Restrictions & General Class Axioms
#################################################################

:Cl_EDIFACTMessage rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceListing ;
    owl:allValuesFrom :Cl_InvoiceListing
] .
:Cl_InvoiceListing rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :listsInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .
:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasRoleInInvoice ;
          owl:allValuesFrom :Cl_InvoiceRole ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :forInvoice ;
          owl:allValuesFrom :Cl_Invoice ]
    )
] .
:Cl_OrganizationInvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:allValuesFrom :Cl_InvoiceRole ]
    )
] .
:Cl_InvoiceRoleAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf ( 
            [ rdf:type owl:Class ; owl:intersectionOf (
                [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
            ) ]
            [ rdf:type owl:Class ; owl:intersectionOf (
                [ rdf:type owl:Restriction ; owl:onProperty :involvesPerson ; owl:someValuesFrom :Cl_Person ]
            ) ]
        )
    ] .
:Cl_BuyerAssignment a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleAssignment ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:hasValue :BuyerRole ]
            [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        )
    ] .
:Cl_BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .
:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Item
] .
:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_InvoiceLine
] .
:Cl_InvoiceItemPricing rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasGrossPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
:Cl_InvoiceItem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceItemPricing ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
:Cl_NetPrice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasAmount ;
    owl:someValuesFrom xsd:decimal
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasCurrency ;
    owl:someValuesFrom :Cl_Currency
] .
:Cl_InvoiceDetail owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceItem ;
          owl:someValuesFrom :Cl_InvoiceItem
        ]
    )
] .
:Cl_InvoiceDetail rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceItem ;
    owl:someValuesFrom :Cl_InvoiceItem
] .
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:someValuesFrom :Cl_InvoiceDetail
] .
:Cl_InvoiceAmount owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasAmount ;
          owl:someValuesFrom :Cl_Amount ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasCurrency ;
          owl:someValuesFrom :Cl_Currency ]
    )
] .
:Cl_InvoiceIdentification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceIdentifier ;
          owl:allValuesFrom :Cl_InvoiceIdentifier
        ]
    )
] .
:Cl_InvoiceIdentifier owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :invoiceNumber ;
          owl:allValuesFrom xsd:string
        ]
    )
] .
:Cl_InformationDisplay rdfs:subClassOf owl:Thing .
:Cl_Organization rdfs:subClassOf owl:Thing .
:Cl_Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInformationDisplay ;
    owl:allValuesFrom :Cl_InformationDisplay
] .
:Cl_ItemDisplayInfo owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :displayedItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasDisplayAttribute ; owl:someValuesFrom :Cl_DisplayAttribute ]
    )
] .
:Cl_FileFormat owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasFormatSpecification ;
    owl:someValuesFrom :Cl_FormatSpecification
] .
:Cl_FormatSpecification owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ; owl:onProperty :specifiesRequiredElement ; owl:someValuesFrom :Cl_RequiredElement ]
        [ a owl:Restriction ; owl:onProperty :specifiesRequiredAttribute ; owl:someValuesFrom :Cl_RequiredAttribute ]
        [ a owl:Restriction ; owl:onProperty :specifiesValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
    )
] .
:Cl_RequiredElement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasElementType ;
    owl:someValuesFrom :Cl_ElementType
] .
:Cl_RequiredAttribute owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasAttributeType ;
    owl:someValuesFrom :Cl_AttributeType
] .
:Cl_SpecificationComponent rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty [ owl:inverseOf :requiresSpecificationComponent ] ;
    owl:someValuesFrom :Cl_FileFormatSpecificationRequirement
] .
:Cl_InvoiceAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:someValuesFrom :Cl_Invoice
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasBusinessProcess ;
    owl:someValuesFrom :Cl_BusinessProcess
] .

#################################################################
# Named Individuals (example roles)
#################################################################

:BuyerRole a owl:NamedIndividual, :Cl_InvoiceRole ;
    rdfs:label "Buyer Role"@en ;
    rdfs:comment "Role for buyer in invoice."@en .

:SellerRole a owl:NamedIndividual, :Cl_InvoiceRole ;
    rdfs:label "Seller Role"@en ;
    rdfs:comment "Role for seller in invoice."@en .
