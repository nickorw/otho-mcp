:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "city"@en ;
    rdfs:comment "City of the address."@en .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "postal code"@en ;
    rdfs:comment "Postal code of the address."@en .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "country"@en ;
    rdfs:comment "Country of the address."@en .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date"@en ;
    rdfs:comment "The date and time when the invoice was assigned to the business process."@en .

:elementName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredElement ;
    rdfs:range xsd:string ;
    rdfs:label "element name"@en ;
    rdfs:comment "Name of the required element."@en .

:attributeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "attribute name"@en ;
    rdfs:comment "Name of the required attribute."@en .

:elementTypeName a owl:DatatypeProperty ;
