:organizationTypeLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string ;
    rdfs:label "organization type label"@en ;
    rdfs:comment "Label for the organization type."@en .

:organizationRoleLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
