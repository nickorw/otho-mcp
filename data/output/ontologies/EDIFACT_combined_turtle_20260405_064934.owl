@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A general entity, superclass for agents and other entities." ;
    rdfs:subClassOf owl:Thing ;
    rdfs:seeAlso :Cl_Attribute ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasAttribute ;
        owl:allValuesFrom :Cl_Attribute
    ] .

:Cl_Attribute a owl:Class ;
    rdfs:label "Attribute" ;
    rdfs:comment "A general attribute of an item, such as color, size, etc." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An agent, such as a person or organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Person a owl:Class ; 
    rdfs:subClassOf :Cl_Agent, :Cl_Entity ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual." .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, institution, or group involved in the scenario." .

:Cl_Company a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Company" ;
    rdfs:comment "A company organization." .

:Cl_NonProfit a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Non-Profit Organization" ;
    rdfs:comment "A non-profit organization." .

:Cl_GovernmentAgency a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Government Agency" ;
    rdfs:comment "A government agency organization." .

:Cl_Customer a owl:Class ; 
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Customer" ;
    rdfs:comment "A person who is a customer." .

:Cl_InvoiceIssuer a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Invoice Issuer" ;
    rdfs:comment "An organization that issues invoices." .

:Cl_InvoiceRecipient a owl:Class ;
    rdfs:label "Invoice Recipient" ;
    rdfs:comment "A person or organization receiving an invoice." .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued to indicate a transaction and request for payment." .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document class." .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured message in the EDIFACT standard." .

:Cl_InvoiceListing a owl:Class ;
    rdfs:label "Invoice Listing" ;
    rdfs:comment "A reification class representing the listing of an invoice within an EDIFACT message." .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed information about an invoice." .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "An item listed on an invoice." .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or good that is sold." .

:Cl_Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A tangible product." .

:Cl_Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A provided service." .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item in an invoice." .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A monetary value associated with an invoice or transaction." .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "A unit of currency in which an amount is denominated." .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "A pivot class representing the association of an invoice with its amount and currency." .

:Cl_InvoiceIdentification a owl:Class ;
    rdfs:label "Invoice Identification" ;
    rdfs:comment "Identification information for an invoice." ;
    rdfs:subClassOf :Cl_Invoice .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "A unique identifier for an invoice." ;
    rdfs:subClassOf :Cl_InvoiceIdentification .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Participation of an organization or person in an invoice." .

:Cl_InvoiceRole a owl:Class ; 
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A role played in the context of an invoice." .

:Cl_Seller a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller" ;
    rdfs:comment "A seller role in an invoice." .

:Cl_Buyer a owl:Class ; 
    rdfs:subClassOf :Cl_Person, :Cl_InvoiceRole ;
    rdfs:label "Buyer" ;
    rdfs:comment "A buyer role in an invoice." .

:Cl_Issuer a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Issuer" ;
    rdfs:comment "An issuer role in an invoice." .

:Cl_Recipient a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Recipient" ;
    rdfs:comment "A recipient role in an invoice." .

:Cl_OrganizationInvoiceRole a owl:Class ;
    rdfs:label "Organization Invoice Role" ;
    rdfs:comment "A role played by an organization in an invoice." .

:Cl_InvoiceRoleAssignment a owl:Class ; 
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Invoice Role Assignment" ;
    rdfs:comment "Assignment of an invoice role to an organization or person." .

:Cl_BuyerAssignment a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRoleAssignment ;
    rdfs:label "Buyer Assignment" ;
    rdfs:comment "Assignment of a buyer role." .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of an address to a buyer." .

:Cl_Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address." .

:Cl_InformationDisplay a owl:Class ;
    rdfs:label "Information Display" ;
    rdfs:comment "A reification class representing information displayed about an organization." .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact details of an organization." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:comment "The type or category of the organization." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "The role played by the organization in the scenario." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_OrganizationProfile a owl:Class ;
    rdfs:label "Organization Profile" ;
    rdfs:comment "A summary or description of the organization." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "The location of the organization." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "A unique identifier for the organization." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_OrganizationInvolvement a owl:Class ;
    rdfs:label "Organization Involvement" ;
    rdfs:comment "A reification class representing the involvement of an organization in an event or scenario." ;
    rdfs:subClassOf owl:Thing .

:Cl_OrganizationInformationDisplay a owl:Class ;
    rdfs:label "Organization Information Display" ;
    rdfs:comment "Reification class for the information displayed about an organization's involvement." ;
    rdfs:subClassOf :Cl_InformationDisplay .

:Cl_ItemDisplayInfo a owl:Class ;
    rdfs:label "Item Display Information" ;
    rdfs:comment "Reification class to capture information displayed about an item in a sale context." .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" ;
    rdfs:comment "A transaction in which an item is sold." .

:Cl_DisplayAttribute a owl:Class ;
    rdfs:subClassOf :Cl_Attribute ;
    rdfs:label "Display Attribute" ;
    rdfs:comment "Specific attributes that are displayed about an item." .

:Cl_Description a owl:Class ;
    rdfs:subClassOf :Cl_DisplayAttribute ;
    rdfs:label "Description" ;
    rdfs:comment "A textual description of an item." .

:Cl_Price a owl:Class ;
    rdfs:subClassOf :Cl_Amount, :Cl_DisplayAttribute ;
    rdfs:label "Price" ;
    rdfs:comment "The price of an item." .

:Cl_NetPrice a owl:Class ; 
    rdfs:subClassOf :Cl_Price ;
    rdfs:label "Net Price" ;
    rdfs:comment "The net price of an item." .

:Cl_GrossPrice a owl:Class ; 
    rdfs:subClassOf :Cl_Price ;
    rdfs:label "Gross Price" ;
    rdfs:comment "The gross price of an item." .

:Cl_Quantity a owl:Class ; 
    rdfs:subClassOf :Cl_DisplayAttribute ;
    rdfs:label "Quantity" ;
    rdfs:comment "The quantity of an item sold or available." .

:Cl_Image a owl:Class ; 
    rdfs:subClassOf :Cl_DisplayAttribute ;
    rdfs:label "Image" ;
    rdfs:comment "An image associated with an item." .

:Cl_SKU a owl:Class ; 
    rdfs:subClassOf :Cl_DisplayAttribute ;
    rdfs:label "SKU" ;
    rdfs:comment "Stock Keeping Unit identifier for the item." .

:Cl_InvoiceItemPricing a owl:Class ;
    rdfs:label "Invoice Item Pricing" ;
    rdfs:comment "Pricing details for an invoice item." .

:Cl_InvoiceItemDetail a owl:Class ;
    rdfs:label "Invoice Item Detail" ;
    rdfs:comment "Detail for an invoice item." .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format definition." .

:Cl_FormatSpecification a owl:Class ;
    rdfs:label "Format Specification" ;
    rdfs:comment "A format specification for a file format." .

:Cl_RequiredElement a owl:Class ;
    rdfs:label "Required Element" ;
    rdfs:comment "A required element in a format specification." .

:Cl_ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule for validating a file format." .

:Cl_ElementConstraint a owl:Class ;
    rdfs:label "Element Constraint" ;
    rdfs:comment "A constraint on an element." .

:Cl_ElementType a owl:Class ;
    rdfs:label "Element Type" ;
    rdfs:comment "A type for an element." .

:Cl_RequiredAttribute a owl:Class ;
    rdfs:label "Required Attribute" ;
    rdfs:comment "A required attribute in a format specification." .

:Cl_AttributeConstraint a owl:Class ;
    rdfs:label "Attribute Constraint" ;
    rdfs:comment "A constraint on an attribute." .

:Cl_AttributeType a owl:Class ;
    rdfs:label "Attribute Type" ;
    rdfs:comment "A type for an attribute." .

:Cl_FileFormatValidation a owl:Class ;
    rdfs:label "File Format Validation" ;
    rdfs:comment "A validation instance for a file format." .

:Cl_SpecificationComponent a owl:Class ;
    rdfs:label "Specification Component" ;
    rdfs:comment "A component of a format specification." .

:Cl_Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A general constraint." .

:Cl_FileFormatSpecificationRequirement a owl:Class ;
    rdfs:label "File Format Specification Requirement" ;
    rdfs:comment "A requirement for a file format specification." .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process within an organization." .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:label "Invoice Assignment" ;
    rdfs:comment "A reification class representing the assignment of an invoice to a business process." .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing"@en ;
    rdfs:comment "Connects an EDIFACT message to its invoice listing (reification node)."@en ;
    owl:inverseOf :listedInMessage .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice"@en ;
    rdfs:comment "Connects an invoice listing to the invoice being listed."@en ;
    owl:inverseOf :invoiceListedBy .

:listedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "listed in message"@en ;
    rdfs:comment "Inverse property to hasInvoiceListing, connects invoice listing to the EDIFACT message."@en .

:invoiceListedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "invoice listed by"@en ;
    rdfs:comment "Inverse property to listsInvoice, connects invoice to the invoice listing."@en .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "has participant"@en ;
    rdfs:comment "Relates an invoice to its participants."@en ;
    owl:inverseOf :participantOfInvoice .

:participantOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "participant of invoice"@en ;
    rdfs:comment "Inverse of hasParticipant."@en .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_InvoiceParticipation :Cl_OrganizationInvolvement :Cl_InvoiceRoleAssignment ) ] ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization"@en ;
    rdfs:comment "Relates a participation or involvement to an organization."@en ;
    owl:inverseOf :organizationInvolvedIn .

:organizationInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_InvoiceParticipation :Cl_OrganizationInvolvement :Cl_InvoiceRoleAssignment ) ] ;
    rdfs:label "organization involved in"@en ;
    rdfs:comment "Inverse of involvesOrganization."@en .

:hasRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has role in invoice"@en ;
    rdfs:comment "Relates a participation to an invoice role."@en ;
    owl:inverseOf :roleInInvoiceOf .

:roleInInvoiceOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "role in invoice of"@en ;
    rdfs:comment "Inverse of hasRoleInInvoice."@en .

:forInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "for invoice"@en ;
    rdfs:comment "Relates a participation to the invoice."@en ;
    owl:inverseOf :hasParticipation .

:hasParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "has participation"@en ;
    rdfs:comment "Inverse of forInvoice."@en .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization"@en ;
    rdfs:comment "Relates an organization invoice role to the organization."@en ;
    owl:inverseOf :organizationOfInvoiceRole .

:organizationOfInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvoiceRole ;
    rdfs:label "organization of invoice role"@en ;
    rdfs:comment "Inverse of hasOrganization."@en .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_OrganizationInvoiceRole :Cl_InvoiceAssignment :Cl_InvoiceAmount ) ] ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice"@en ;
    rdfs:comment "Relates to an invoice."@en ;
    owl:inverseOf :isInvoiceOf .

:isInvoiceOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_OrganizationInvoiceRole :Cl_InvoiceAssignment :Cl_InvoiceAmount ) ] ;
    rdfs:label "is invoice of"@en ;
    rdfs:comment "Inverse of hasInvoice."@en .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_OrganizationInvoiceRole :Cl_InvoiceRoleAssignment ) ] ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role"@en ;
    rdfs:comment "Relates to an invoice role."@en ;
    owl:inverseOf :isInvoiceRoleOf .

:isInvoiceRoleOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_OrganizationInvoiceRole :Cl_InvoiceRoleAssignment ) ] ;
    rdfs:label "is invoice role of"@en ;
    rdfs:comment "Inverse of hasInvoiceRole."@en .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "involves invoice"@en ;
    rdfs:comment "Relates a role assignment to an invoice."@en ;
    owl:inverseOf :isInvolvedInByRoleAssignment .

:isInvolvedInByRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "is involved in by role assignment"@en ;
    rdfs:comment "Inverse of involvesInvoice."@en .

:involvesPerson a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Person ;
    rdfs:label "involves person"@en ;
    rdfs:comment "Relates a role assignment to a person."@en ;
    owl:inverseOf :personInvolvedInRoleAssignment .

:personInvolvedInRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "person involved in role assignment"@en ;
    rdfs:comment "Inverse of involvesPerson."@en .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "has buyer"@en ;
    rdfs:comment "Relates a buyer address assignment to a buyer."@en ;
    owl:inverseOf :buyerOfAssignment .

:buyerOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "buyer of assignment"@en ;
    rdfs:comment "Inverse of hasBuyer."@en .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "has address"@en ;
    rdfs:comment "Relates a buyer address assignment to an address."@en ;
    owl:inverseOf :addressOfAssignment .

:addressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "address of assignment"@en ;
    rdfs:comment "Inverse of hasAddress."@en .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "has invoice line"@en ;
    rdfs:comment "Relates an invoice to its invoice lines."@en ;
    owl:inverseOf :invoiceOfInvoiceLine .

:invoiceOfInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice of invoice line"@en ;
    rdfs:comment "Inverse of hasInvoiceLine."@en .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "refers to item"@en ;
    rdfs:comment "Relates an invoice line to the item."@en ;
    owl:inverseOf :itemReferredByInvoiceLine .

:itemReferredByInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "item referred by invoice line"@en ;
    rdfs:comment "Inverse of refersToItem."@en .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Amount ;
    rdfs:label "has amount"@en ;
    rdfs:comment "Relates an invoice line to an amount."@en ;
    owl:inverseOf :amountOfInvoiceLine .

:amountOfInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Amount ;
    rdfs:label "amount of invoice line"@en ;
    rdfs:comment "Inverse of hasAmount."@en .

:refersToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product ;
    rdfs:label "refers to product"@en ;
    rdfs:comment "Relates an invoice item to a product."@en ;
    owl:inverseOf :productReferredByInvoiceItem .

:productReferredByInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product ;
    rdfs:label "product referred by invoice item"@en ;
    rdfs:comment "Inverse of refersToProduct."@en .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "has invoice item"@en ;
    rdfs:comment "Relates an invoice to its invoice items."@en ;
    owl:inverseOf :invoiceOfInvoiceItem .

:invoiceOfInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice of invoice item"@en ;
    rdfs:comment "Inverse of hasInvoiceItem."@en .

:hasInvoiceItemPricing a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_InvoiceItemPricing ;
    rdfs:label "has invoice item pricing"@en ;
    rdfs:comment "Relates an invoice item to its pricing."@en ;
    owl:inverseOf :invoiceItemOfPricing .

:invoiceItemOfPricing a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "invoice item of pricing"@en ;
    rdfs:comment "Inverse of hasInvoiceItemPricing."@en .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_NetPrice ;
    rdfs:subPropertyOf :hasPrice ;
    rdfs:label "has net price"@en ;
    rdfs:comment "Relates item pricing to net price."@en ;
    owl:inverseOf :netPriceOfPricing .

:netPriceOfPricing a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_NetPrice ;
    rdfs:label "net price of pricing"@en ;
    rdfs:comment "Inverse of hasNetPrice."@en .

:hasGrossPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_GrossPrice ;
    rdfs:subPropertyOf :hasPrice ;
    rdfs:label "has gross price"@en ;
    rdfs:comment "Relates item pricing to gross price."@en ;
    owl:inverseOf :grossPriceOfPricing .

:grossPriceOfPricing a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_GrossPrice ;
    rdfs:label "gross price of pricing"@en ;
    rdfs:comment "Inverse of hasGrossPrice."@en .

:hasPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_Price ;
    rdfs:label "has price"@en ;
    rdfs:comment "Relates item pricing to price."@en ;
    owl:inverseOf :priceOfPricing .

:priceOfPricing a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItemPricing ;
    rdfs:range :Cl_Price ;
    rdfs:label "price of pricing"@en ;
    rdfs:comment "Inverse of hasPrice."@en .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_Amount :Cl_InvoiceAmount ) ] ;
    rdfs:range :Cl_Currency ;
    rdfs:label "has currency"@en ;
    rdfs:comment "Relates an amount or invoice amount to a currency."@en ;
    owl:inverseOf :currencyOfAmountOrInvoiceAmount .

:currencyOfAmountOrInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_Amount :Cl_InvoiceAmount ) ] ;
    rdfs:label "currency of amount or invoice amount"@en ;
    rdfs:comment "Inverse of hasCurrency."@en .

:hasNetPriceOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
