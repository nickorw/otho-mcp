    rdfs:label "requires attribute constraint"@en ;
    rdfs:comment "Relates a file format specification requirement to a required attribute constraint."@en ;
    owl:inverseOf :attributeConstraintOfRequirement .

:attributeConstraintOfRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecificationRequirement ;
    rdfs:range :Cl_AttributeConstraint ;
    rdfs:label "attribute constraint of requirement"@en ;
    rdfs:comment "Inverse of requiresAttributeConstraint."@en .

:hasBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "has business process"@en ;
    rdfs:comment "Relates an InvoiceAssignment to the Business Process to which the invoice is assigned."@en ;
    owl:inverseOf :businessProcessOfAssignment .

:businessProcessOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "business process of assignment"@en ;
    rdfs:comment "Inverse of hasBusinessProcess."@en .

:hasAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_Entity ;
    rdfs:range :Cl_Attribute ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "Relates an entity to its attribute."@en .

