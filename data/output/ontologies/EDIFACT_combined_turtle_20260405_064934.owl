    rdfs:label "organization address"@en ;
    rdfs:comment "Address of the organization location."@en .

:organizationContactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "organization contact email"@en ;
    rdfs:comment "Contact email for the organization."@en .

:organizationContactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "organization contact phone"@en ;
    rdfs:comment "Contact phone for the organization."@en .

:organizationIdentifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "organization identifier value"@en ;
    rdfs:comment "Identifier value for the organization."@en .

:street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "street"@en ;
