#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_EDIFACTMessageInvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasEDIFACTMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceOrganizationInvolvement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesInvoice ; owl:allValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceOrganizationRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_InvoiceOrganizationAssociation
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
            [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
            [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        )
    ] .

:Cl_BuyerAddressRelation
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
            [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
        )
    ] .

:Cl_InvoiceSoldItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Invoice
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceLine ;
          owl:someValuesFrom [
            rdf:type owl:Restriction ;
            owl:onProperty :refersToItem ;
            owl:someValuesFrom :Cl_Item
          ]
        ]
    )
] ;
    rdfs:label "Invoices that sell items"@en ;
    rdfs:comment "Invoices that have lines referring to sold items."@en .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasMonetaryAmount ;
          owl:allValuesFrom :Cl_MonetaryAmount
        ]
        [ a owl:Restriction ;
          owl:onProperty :refersToItem ;
          owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasProduct ;
          owl:someValuesFrom :Cl_Product
        ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasNetTotal ;
          owl:allValuesFrom :Cl_MonetaryAmount
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceLine ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .

:Cl_InvoiceDetails owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

:Cl_InvoiceAmountReification a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
            [ a owl:Restriction ; owl:onProperty :hasMonetaryAmount ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        )
    ] .

:Cl_InvoiceIdentification
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ; owl:onProperty :identifiesInvoice ; owl:someValuesFrom :Cl_Invoice ]
            [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom :Cl_InvoiceNumber ]
        )
    ] .

:Cl_InvoiceNumber owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Identifier
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceNumberValue ; owl:allValuesFrom xsd:string ]
    )
] .

:Cl_FileFormatValidation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :validatesFormat ; owl:someValuesFrom :Cl_FileFormat ]
        [ rdf:type owl:Restriction ; owl:onProperty :usesSpecification ; owl:someValuesFrom :Cl_FileFormatSpecification ]
        [ rdf:type owl:Restriction ; owl:onProperty :requiresInformation ; owl:someValuesFrom :Cl_RequiredInformation ]
    )
] .

:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :isAssignmentOf ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :assignedToBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_OrganizationInfoDisplay owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :displaysInfoData ; owl:someValuesFrom :Cl_OrganizationInfoData ]
    )
] .

#################################################################
# General Class Axioms
#################################################################

[ rdf:type owl:Restriction ;
  owl:onProperty :hasRequirement ;
  owl:someValuesFrom :Cl_FormatRequirement ;
  rdfs:subClassOf :Cl_FileFormatSpecification
] .

[ rdf:type owl:Restriction ;
  owl:onProperty :issuedTo ;
  owl:someValuesFrom :Cl_InvoiceRecipient ;
  rdfs:subClassOf :Cl_Invoice
] .

:Cl_Entity owl:disjointUnionOf (
    :Cl_Invoice
    :Cl_Item
    :Cl_InvoiceLine
) .

:Cl_InvoiceRecipient owl:disjointUnionOf ( :Cl_Customer :Cl_Organization ) .

#################################################################
# Annotation Consistency
#################################################################

:isMonetaryAmountOf rdfs:label "is monetary amount of"@en ;
    rdfs:comment "Inverse of hasMonetaryAmount."@en .

:isCurrencyOfMonetaryAmount rdfs:label "is currency of monetary amount"@en ;
    rdfs:comment "Inverse of hasCurrency."@en .

:isDueDateOf rdfs:label "is due date of"@en ;
    rdfs:comment "Inverse of hasDueDate."@en .

:hasInvoiceRole rdfs:label "has invoice role"@en ;
    rdfs:comment "Relates an invoice organization association to a role."@en .

:hasInvoiceDetails rdfs:label "has invoice details"@en ;
    rdfs:comment "Relates an invoice to its details."@en .

:isDetailOfInvoice rdfs:label "is detail of invoice"@en ;
    rdfs:comment "Inverse of hasInvoiceDetails."@en .

:isLineOfDetails rdfs:label "is line of details"@en ;
    rdfs:comment "Inverse of hasLine."@en .

:isProductOfLine rdfs:label "is product of line"@en ;
    rdfs:comment "Inverse of hasProduct."@en .

:isRequiredByValidation rdfs:label "is required by validation"@en ;
    rdfs:comment "Inverse of requiresInformation."@en .

:isSpecificationUsedBy rdfs:label "is specification used by"@en ;
    rdfs:comment "Inverse of usesSpecification."@en .

:hasAssignmentForBusinessProcess rdfs:label "has assignment for business process"@en ;
    rdfs:comment "Inverse of assignedToBusinessProcess."@en .

:isOrganizationOfDisplay rdfs:label "is organization of display"@en ;
    rdfs:comment "Inverse of hasOrganization."@en .

:isMetadataRequirementOf rdfs:label "is metadata requirement of"@en ;
    rdfs:comment "Inverse of hasMetadataRequirement."@en .

:isDataFieldOf rdfs:label "is data field of"@en ;
    rdfs:comment "Inverse of hasDataField."@en .

:isValidationRuleOf rdfs:label "is validation rule of"@en ;
    rdfs:comment "Inverse of hasValidationRule."@en .

:isInformationTypeSpecifiedBy rdfs:label "is information type specified by"@en ;
    rdfs:comment "Inverse of specifiesInformationType."@en .

:isFormatValidatedBy rdfs:label "is format validated by"@en ;
    rdfs:comment "Inverse of validatesFormat."@en .

:isAssignmentOf rdfs:label "is assignment of"@en ;
    rdfs:comment "Inverse of hasAssignment."@en .

#################################################################
# Naming convention fix
#################################################################

:isRequiredByValidation rdfs:label "is required by validation"@en ;
    rdfs:comment "Inverse of requiresInformation."@en .

#################################################################
# P04: Connect Cl_Entity to the ontology
#################################################################

:Cl_Entity :hasSubEntity :Cl_Entity .

#################################################################
# End of ontology
#################################################################