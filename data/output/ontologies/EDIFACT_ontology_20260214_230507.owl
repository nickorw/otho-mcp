@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#EDIFACTInvoiceStory>
    a owl:Ontology ;
    rdfs:label "EDIFACT Invoice & Procurement Ontology" ;
    rdfs:comment "A comprehensive ontology for UN/EDIFACT invoice messages, procurement scenarios, and semantic validation, aligned with EN 16931-1 and P2P-O." .

#################################################################
# Classes
#################################################################
:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The envelope that contains EDIFACT messages." .

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message within the EDIFACT standard." .

:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message (INVOIC)" ;
    rdfs:comment "A message representing an invoice (INVOIC) in EDIFACT." ;
    rdfs:subClassOf :EDIFACTMessage .

:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "A segment in an EDIFACT message." .

:BGMSegment a owl:Class ;
    rdfs:label "BGM Segment" ;
    rdfs:comment "The Beginning of Message segment (BGM) for document identification." ;
    rdfs:subClassOf :Segment .

:NADSegment a owl:Class ;
    rdfs:label "NAD Segment" ;
    rdfs:comment "The Name and Address segment (NAD) for participant details." ;
    rdfs:subClassOf :Segment .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "Composite data element in a segment." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "Simple data element in a segment." .

:Section a owl:Class ;
    rdfs:label "Document Section" ;
    rdfs:comment "A section of the invoice document (header, detail, summary)." .

:HeaderSection a owl:Class ;
    rdfs:label "Header Section" ;
    rdfs:comment "Header section of the invoice containing document-level information." ;
    rdfs:subClassOf :Section .

:DetailSection a owl:Class ;
    rdfs:label "Detail Section" ;
    rdfs:comment "Detail section listing line items." ;
    rdfs:subClassOf :Section .

:SummarySection a owl:Class ;
    rdfs:label "Summary Section" ;
    rdfs:comment "Summary section with totals and taxes." ;
    rdfs:subClassOf :Section .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization involved in the invoice process." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in the invoice (e.g., Buyer, Delivery Party)." .

:BuyerRole a owl:Class ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "The role of buyer in the invoice." ;
    rdfs:subClassOf :AgentRole .

:DeliveryPartyRole a owl:Class ;
    rdfs:label "Delivery Party Role" ;
    rdfs:comment "The role of delivery party in the invoice." ;
    rdfs:subClassOf :AgentRole .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "An address associated with an organization." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A generic identifier." .

:GlobalLocationNumber a owl:Class ;
    rdfs:label "Global Location Number" ;
    rdfs:comment "A global location number (GLN) for identifying organizations." ;
    rdfs:subClassOf :Identifier .

:InvoiceLineItem a owl:Class ;
    rdfs:label "Invoice Line Item" ;
    rdfs:comment "A line item in the invoice." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item being traded in the invoice." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "Net price of an item." .

:Tax a owl:Class ;
    rdfs:label "Tax" ;
    rdfs:comment "Tax information for the invoice." .

:ReferenceNumber a owl:Class ;
    rdfs:label "Reference Number" ;
    rdfs:comment "A reference number for the invoice." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process context for the invoice." .

:ValidationConstraint a owl:Class ;
    rdfs:label "Validation Constraint" ;
    rdfs:comment "A constraint for validating invoice data." .

:EN16931Alignment a owl:Class ;
    rdfs:label "EN 16931 Alignment" ;
    rdfs:comment "Alignment with the European Standard EN 16931-1." .

:P2POAlignment a owl:Class ;
    rdfs:label "P2P-O Alignment" ;
    rdfs:comment "Alignment with the Purchase-to-Pay Ontology (P2P-O)." .

:SHACLConstraint a owl:Class ;
    rdfs:label "SHACL Constraint" ;
    rdfs:comment "A SHACL constraint for invoice validation." .

:OrganizationRoleAssignment a owl:Class ;
    rdfs:label "Organization Role Assignment" ;
    rdfs:comment "Reified assignment of a role to an organization in a specific context (pivot class)." .

#################################################################
# Disjointness & DisjointUnion (outside class blocks)
#################################################################
:Segment owl:disjointWith :Section .
:AgentRole owl:disjointWith :Organization .
:Address owl:disjointWith :Organization .
:InvoiceLineItem owl:disjointWith :Segment .
:Price owl:disjointWith :Tax .
:ValidationConstraint owl:disjointWith :SHACLConstraint .
:Section owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .
:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .

#################################################################
# Object Properties (with inverses)
#################################################################
:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains message" ;
    rdfs:comment "Relates an Interchange Envelope to its EDIFACT Message." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :EDIFACTMessage ;
    owl:inverseOf :isContainedInEnvelope .

:isContainedInEnvelope a owl:ObjectProperty ;
    rdfs:label "is contained in envelope" ;
    rdfs:comment "Inverse of containsMessage: relates an EDIFACT Message to its Interchange Envelope." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :InterchangeEnvelope .

:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:comment "Relates an EDIFACT Message to its Segments." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Segment ;
    owl:inverseOf :segmentOf .

:segmentOf a owl:ObjectProperty ;
    rdfs:label "segment of" ;
    rdfs:comment "Inverse of hasSegment: relates a Segment to its EDIFACT Message." ;
    rdfs:domain :Segment ;
    rdfs:range :EDIFACTMessage .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has section" ;
    rdfs:comment "Relates an Invoice Message to its Sections." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Section ;
    owl:inverseOf :sectionOf .

:sectionOf a owl:ObjectProperty ;
    rdfs:label "section of" ;
    rdfs:comment "Inverse of hasSection: relates a Section to its Invoice Message." ;
    rdfs:domain :Section ;
    rdfs:range :InvoiceMessage .

:hasLineItem a owl:ObjectProperty ;
    rdfs:label "has line item" ;
    rdfs:comment "Relates a Detail Section to its Invoice Line Items." ;
    rdfs:domain :DetailSection ;
    rdfs:range :InvoiceLineItem ;
    owl:inverseOf :lineItemOf .

:lineItemOf a owl:ObjectProperty ;
    rdfs:label "line item of" ;
    rdfs:comment "Inverse of hasLineItem: relates an Invoice Line Item to its Detail Section." ;
    rdfs:domain :InvoiceLineItem ;
    rdfs:range :DetailSection .

:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Relates an Invoice Line Item to an Item." ;
    rdfs:domain :InvoiceLineItem ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOf .

:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:comment "Inverse of hasItem: relates an Item to its Invoice Line Item." ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceLineItem .

:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has price" ;
    rdfs:comment "Relates an Invoice Line Item to its Price." ;
    rdfs:domain :InvoiceLineItem ;
    rdfs:range :Price ;
    owl:inverseOf :isPriceOf .

:isPriceOf a owl:ObjectProperty ;
    rdfs:label "is price of" ;
    rdfs:comment "Inverse of hasPrice: relates a Price to its Invoice Line Item." ;
    rdfs:domain :Price ;
    rdfs:range :InvoiceLineItem .

:hasTax a owl:ObjectProperty ;
    rdfs:label "has tax" ;
    rdfs:comment "Relates a Summary Section to its Tax." ;
    rdfs:domain :SummarySection ;
    rdfs:range :Tax ;
    owl:inverseOf :taxOf .

:taxOf a owl:ObjectProperty ;
    rdfs:label "tax of" ;
    rdfs:comment "Inverse of hasTax: relates a Tax to its Summary Section." ;
    rdfs:domain :Tax ;
    rdfs:range :SummarySection .

:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has reference number" ;
    rdfs:comment "Relates a Header Section to its Reference Number." ;
    rdfs:domain :HeaderSection ;
    rdfs:range :ReferenceNumber ;
    owl:inverseOf :referenceNumberOf .

:referenceNumberOf a owl:ObjectProperty ;
    rdfs:label "reference number of" ;
    rdfs:comment "Inverse of hasReferenceNumber: relates a Reference Number to its Header Section." ;
    rdfs:domain :ReferenceNumber ;
    rdfs:range :HeaderSection .

:hasOrganizationRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has organization role assignment" ;
    rdfs:comment "Relates an Invoice Message to OrganizationRoleAssignment (pivot class for reified roles)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :organizationRoleAssignmentOf .

:organizationRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:label "organization role assignment of" ;
    rdfs:comment "Inverse of hasOrganizationRoleAssignment: relates an OrganizationRoleAssignment to its Invoice Message." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage .

:assignsRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigns role" ;
    rdfs:comment "Relates an OrganizationRoleAssignment to an AgentRole." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :AgentRole ;
    owl:inverseOf :roleAssignedIn .

:roleAssignedIn a owl:ObjectProperty ;
    rdfs:label "role assigned in" ;
    rdfs:comment "Inverse of assignsRole: relates an AgentRole to its OrganizationRoleAssignment." ;
    rdfs:domain :AgentRole ;
    rdfs:range :OrganizationRoleAssignment .

:assignedToOrganization a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to organization" ;
    rdfs:comment "Relates an OrganizationRoleAssignment to the Organization." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :organizationAssignedRole .

:organizationAssignedRole a owl:ObjectProperty ;
    rdfs:label "organization assigned role" ;
    rdfs:comment "Inverse of assignedToOrganization: relates an Organization to its OrganizationRoleAssignment." ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationRoleAssignment .

:inContextOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in context of" ;
    rdfs:comment "Relates an OrganizationRoleAssignment to the InvoiceMessage context." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :contextHasOrganizationRoleAssignment .

:contextHasOrganizationRoleAssignment a owl:ObjectProperty ;
    rdfs:label "context has organization role assignment" ;
    rdfs:comment "Inverse of inContextOf: relates an InvoiceMessage to its OrganizationRoleAssignment." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an Organization to its Address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :addressOf .

:addressOf a owl:ObjectProperty ;
    rdfs:label "address of" ;
    rdfs:comment "Inverse of hasAddress: relates an Address to its Organization." ;
    rdfs:domain :Address ;
    rdfs:range :Organization .

:hasGlobalLocationNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has global location number" ;
    rdfs:comment "Relates an Organization to its GLN." ;
    rdfs:domain :Organization ;
    rdfs:range :GlobalLocationNumber ;
    owl:inverseOf :globalLocationNumberOf .

:globalLocationNumberOf a owl:ObjectProperty ;
    rdfs:label "global location number of" ;
    rdfs:comment "Inverse of hasGlobalLocationNumber: relates a GLN to its Organization." ;
    rdfs:domain :GlobalLocationNumber ;
    rdfs:range :Organization .

:alignsWithEN16931 a owl:ObjectProperty ;
    rdfs:label "aligns with EN16931" ;
    rdfs:comment "Relates an InvoiceMessage to its EN16931 alignment." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :EN16931Alignment ;
    owl:inverseOf :EN16931AlignmentOf .

:EN16931AlignmentOf a owl:ObjectProperty ;
    rdfs:label "EN16931 alignment of" ;
    rdfs:comment "Inverse of alignsWithEN16931: relates EN16931Alignment to InvoiceMessage." ;
    rdfs:domain :EN16931Alignment ;
    rdfs:range :InvoiceMessage .

:alignsWithP2PO a owl:ObjectProperty ;
    rdfs:label "aligns with P2P-O" ;
    rdfs:comment "Relates an InvoiceMessage to its P2P-O alignment." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :P2POAlignment ;
    owl:inverseOf :P2POAlignmentOf .

:P2POAlignmentOf a owl:ObjectProperty ;
    rdfs:label "P2P-O alignment of" ;
    rdfs:comment "Inverse of alignsWithP2PO: relates P2POAlignment to InvoiceMessage." ;
    rdfs:domain :P2POAlignment ;
    rdfs:range :InvoiceMessage .

:hasValidationConstraint a owl:ObjectProperty ;
    rdfs:label "has validation constraint" ;
    rdfs:comment "Relates an InvoiceMessage to a ValidationConstraint." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ValidationConstraint ;
    owl:inverseOf :validationConstraintOf .

:validationConstraintOf a owl:ObjectProperty ;
    rdfs:label "validation constraint of" ;
    rdfs:comment "Inverse of hasValidationConstraint: relates a ValidationConstraint to its InvoiceMessage." ;
    rdfs:domain :ValidationConstraint ;
    rdfs:range :InvoiceMessage .

:hasSHACLConstraint a owl:ObjectProperty ;
    rdfs:label "has SHACL constraint" ;
    rdfs:comment "Relates an InvoiceMessage to SHACL constraints." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :SHACLConstraint ;
    owl:inverseOf :SHACLConstraintOf .

:SHACLConstraintOf a owl:ObjectProperty ;
    rdfs:label "SHACL constraint of" ;
    rdfs:comment "Inverse of hasSHACLConstraint: relates a SHACLConstraint to its InvoiceMessage." ;
    rdfs:domain :SHACLConstraint ;
    rdfs:range :InvoiceMessage .

:partOfBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "part of business process" ;
    rdfs:comment "Relates an InvoiceMessage to its business process context." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :businessProcessHasInvoice .

:businessProcessHasInvoice a owl:ObjectProperty ;
    rdfs:label "business process has invoice" ;
    rdfs:comment "Inverse of partOfBusinessProcess: relates a BusinessProcess to its InvoiceMessage." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage .

# --- EDIFACT Segment Structure Additions ---
:hasCompositeDataElement a owl:ObjectProperty ;
    rdfs:label "has composite data element" ;
    rdfs:comment "Relates a Segment to its Composite Data Elements." ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :compositeDataElementOf .

:compositeDataElementOf a owl:ObjectProperty ;
    rdfs:label "composite data element of" ;
    rdfs:comment "Inverse of hasCompositeDataElement: relates a Composite Data Element to its Segment." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment .

:hasSimpleDataElement a owl:ObjectProperty ;
    rdfs:label "has simple data element" ;
    rdfs:comment "Relates a Composite Data Element to its Simple Data Elements." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    owl:inverseOf :simpleDataElementOf .

:simpleDataElementOf a owl:ObjectProperty ;
    rdfs:label "simple data element of" ;
    rdfs:comment "Inverse of hasSimpleDataElement: relates a Simple Data Element to its Composite Data Element." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement .

#################################################################
# Data Properties
#################################################################
:segmentCode a owl:DatatypeProperty ;
    rdfs:label "segment code" ;
    rdfs:comment "The code of a segment." ;
    rdfs:domain :Segment ;
    rdfs:range xsd:string .

:dataElementCode a owl:DatatypeProperty ;
    rdfs:label "data element code" ;
    rdfs:comment "The code of a simple data element." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string .

:elementValue a owl:DatatypeProperty ;
    rdfs:label "element value" ;
    rdfs:comment "The value of a simple data element." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:label "invoice amount" ;
    rdfs:comment "Total invoice amount." ;
    rdfs:domain :SummarySection ;
    rdfs:range xsd:decimal .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:label "invoice number" ;
    rdfs:comment "The invoice number." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .

:issueDate a owl:DatatypeProperty ;
    rdfs:label "issue date" ;
    rdfs:comment "The issue date of the invoice." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .

:netPrice a owl:DatatypeProperty ;
    rdfs:label "net price" ;
    rdfs:comment "The net price of an item." ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal .

:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity" ;
    rdfs:comment "Quantity of items in a line item." ;
    rdfs:domain :InvoiceLineItem ;
    rdfs:range xsd:decimal .

:taxAmount a owl:DatatypeProperty ;
    rdfs:label "tax amount" ;
    rdfs:comment "Tax amount for the invoice." ;
    rdfs:domain :Tax ;
    rdfs:range xsd:decimal .

:addressLine a owl:DatatypeProperty ;
    rdfs:label "address line" ;
    rdfs:comment "Line of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "City of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code" ;
    rdfs:comment "Country code of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:identifierValue a owl:DatatypeProperty ;
    rdfs:label "identifier value" ;
    rdfs:comment "Value of an identifier." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

#################################################################
# Complex Axioms & Restrictions
#################################################################
:BuyerRole rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignedToOrganization ; owl:someValuesFrom :Organization ] .

:InvoiceLineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItem ; owl:allValuesFrom :Item ] .

:OrganizationRoleAssignment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignsRole ; owl:someValuesFrom :AgentRole ] ,
    [ a owl:Restriction ; owl:onProperty :assignedToOrganization ; owl:someValuesFrom :Organization ] ,
    [ a owl:Restriction ; owl:onProperty :inContextOf ; owl:someValuesFrom :InvoiceMessage ] .
