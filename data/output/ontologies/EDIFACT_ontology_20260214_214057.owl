@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#edifact-invoice> a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Ontology" ;
    rdfs:comment "Ontology for modeling UN/EDIFACT invoice messages, segments, items, organizations, roles, and validation constraints, supporting EN 16931-1 and P2P-O alignment." .

#################################################################
# CLASSES
#################################################################
:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The top-level UN/EDIFACT envelope containing messages." .

:Message a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message within an interchange envelope, e.g., INVOIC." .

:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An EDIFACT INVOIC message representing an invoice." ;
    rdfs:subClassOf :Message .

:Segment a owl:Class ;
    rdfs:label "EDIFACT Segment" ;
    rdfs:comment "A segment in an EDIFACT message, e.g., BGM or NAD." .

:BgmSegment a owl:Class ;
    rdfs:label "BGM Segment" ;
    rdfs:comment "The Beginning of Message segment for document identification." ;
    rdfs:subClassOf :Segment .

:NadSegment a owl:Class ;
    rdfs:label "NAD Segment" ;
    rdfs:comment "The Name and Address segment for organization and address details." ;
    rdfs:subClassOf :Segment .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite data element in a segment, containing multiple simple elements." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A simple data element in a segment or composite element." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A party involved in the invoice process (buyer, seller, delivery party, etc.)." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A functional or business role played by an organization in a transaction (e.g., buyer, seller)." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal or physical address for an organization." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "An identifier such as a Global Location Number (GLN) or D96A code." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or good referenced in the invoice." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A monetary price for an item or invoice." .

:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A measured amount of an item (e.g., number of units)." .

:LineItem a owl:Class ;
    rdfs:label "Line Item" ;
    rdfs:comment "A line in the invoice's detail section, referencing item, price, and quantity." .

:HeaderSection a owl:Class ;
    rdfs:label "Header Section" ;
    rdfs:comment "The header of an invoice message, containing reference numbers, dates, etc." ;
    rdfs:subClassOf :InvoiceMessage .

:DetailSection a owl:Class ;
    rdfs:label "Detail Section" ;
    rdfs:comment "The detail section of an invoice, containing line items." ;
    rdfs:subClassOf :InvoiceMessage .

:SummarySection a owl:Class ;
    rdfs:label "Summary Section" ;
    rdfs:comment "The summary section of an invoice, containing totals and taxes." ;
    rdfs:subClassOf :InvoiceMessage .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A process to which the invoice can be assigned (e.g., procurement, order-to-cash)." .

:ValidationConstraint a owl:Class ;
    rdfs:label "Validation Constraint" ;
    rdfs:comment "A constraint or rule (e.g., SHACL shape) for validating invoice data." .

:EDIFACTDelimiter a owl:Class ;
    rdfs:label "EDIFACT Delimiter" ;
    rdfs:comment "A character or symbol used to separate data elements or segments in EDIFACT." .

# Pivot Classes for Reification
:InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "A reified relation linking an Organization, its Role, and a specific Invoice." .

:LineItemDetail a owl:Class ;
    rdfs:label "Line Item Detail" ;
    rdfs:comment "A reified relation linking a LineItem, Item, Price, and Quantity." .

:SegmentElementAssignment a owl:Class ;
    rdfs:label "Segment Element Assignment" ;
    rdfs:comment "A reified relation linking a Segment to its Composite or Simple Data Elements." .

#################################################################
# OBJECT PROPERTIES
#################################################################
:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains message" ;
    rdfs:comment "Links an InterchangeEnvelope to its contained Message(s)." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :Message .

:containedInEnvelope a owl:ObjectProperty ;
    rdfs:label "contained in envelope" ;
    rdfs:comment "Inverse of containsMessage." ;
    rdfs:domain :Message ;
    rdfs:range :InterchangeEnvelope ;
    owl:inverseOf :containsMessage .

:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:comment "Links a Message to its Segments." ;
    rdfs:domain :Message ;
    rdfs:range :Segment .

:segmentOf a owl:ObjectProperty ;
    rdfs:label "segment of" ;
    rdfs:comment "Inverse of hasSegment." ;
    rdfs:domain :Segment ;
    rdfs:range :Message ;
    owl:inverseOf :hasSegment .

:containsSection a owl:ObjectProperty ;
    rdfs:label "contains section" ;
    rdfs:comment "Links an InvoiceMessage to one of its sections (header, detail, summary)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range owl:Thing .

:sectionOf a owl:ObjectProperty ;
    rdfs:label "section of" ;
    rdfs:comment "Inverse of containsSection." ;
    rdfs:domain owl:Thing ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :containsSection .

:hasDataElement a owl:ObjectProperty ;
    rdfs:label "has data element" ;
    rdfs:comment "Links a Segment to its CompositeDataElements." ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement .

:dataElementOf a owl:ObjectProperty ;
    rdfs:label "data element of" ;
    rdfs:comment "Inverse of hasDataElement." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment ;
    owl:inverseOf :hasDataElement .

:hasSimpleElement a owl:ObjectProperty ;
    rdfs:label "has simple element" ;
    rdfs:comment "Links a CompositeDataElement to its SimpleDataElements." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement .

:simpleElementOf a owl:ObjectProperty ;
    rdfs:label "simple element of" ;
    rdfs:comment "Inverse of hasSimpleElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :hasSimpleElement .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Links an Organization to the AgentRole(s) it plays." ;
    rdfs:domain :Organization ;
    rdfs:range :AgentRole .

:roleOf a owl:ObjectProperty ;
    rdfs:label "role of" ;
    rdfs:comment "Inverse of hasRole." ;
    rdfs:domain :AgentRole ;
    rdfs:range :Organization ;
    owl:inverseOf :hasRole .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Links an Organization to its Address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address .

:addressOf a owl:ObjectProperty ;
    rdfs:label "address of" ;
    rdfs:comment "Inverse of hasAddress." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .

:identifiedBy a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;
    rdfs:label "identified by" ;
    rdfs:comment "Links an Organization to its Identifier(s)." ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier .

:identifierOf a owl:ObjectProperty ;
    rdfs:label "identifier of" ;
    rdfs:comment "Inverse of identifiedBy." ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization ;
    owl:inverseOf :identifiedBy .

:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    rdfs:comment "Links an Organization to an InvoiceParticipation instance." ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceParticipation .

:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant" ;
    rdfs:comment "Inverse of participatesIn." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Organization ;
    owl:inverseOf :participatesIn .

:hasLineItem a owl:ObjectProperty ;
    rdfs:label "has line item" ;
    rdfs:comment "Links an InvoiceMessage to its LineItems." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :LineItem .

:lineItemOf a owl:ObjectProperty ;
    rdfs:label "line item of" ;
    rdfs:comment "Inverse of hasLineItem." ;
    rdfs:domain :LineItem ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasLineItem .

:describesItem a owl:ObjectProperty ;
    rdfs:label "describes item" ;
    rdfs:comment "Links a LineItem to its LineItemDetail (reified details)." ;
    rdfs:domain :LineItem ;
    rdfs:range :LineItemDetail .

:itemDescribedBy a owl:ObjectProperty ;
    rdfs:label "item described by" ;
    rdfs:comment "Inverse of describesItem." ;
    rdfs:domain :LineItemDetail ;
    rdfs:range :LineItem ;
    owl:inverseOf :describesItem .

:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Links a LineItemDetail to an Item." ;
    rdfs:domain :LineItemDetail ;
    rdfs:range :Item .

:itemOf a owl:ObjectProperty ;
    rdfs:label "item of" ;
    rdfs:comment "Inverse of hasItem." ;
    rdfs:domain :Item ;
    rdfs:range :LineItemDetail ;
    owl:inverseOf :hasItem .

:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has price" ;
    rdfs:comment "Links a LineItemDetail to its Price." ;
    rdfs:domain :LineItemDetail ;
    rdfs:range :Price .

:priceOf a owl:ObjectProperty ;
    rdfs:label "price of" ;
    rdfs:comment "Inverse of hasPrice." ;
    rdfs:domain :Price ;
    rdfs:range :LineItemDetail ;
    owl:inverseOf :hasPrice .

:hasQuantity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has quantity" ;
    rdfs:comment "Links a LineItemDetail to its Quantity." ;
    rdfs:domain :LineItemDetail ;
    rdfs:range :Quantity .

:quantityOf a owl:ObjectProperty ;
    rdfs:label "quantity of" ;
    rdfs:comment "Inverse of hasQuantity." ;
    rdfs:domain :Quantity ;
    rdfs:range :LineItemDetail ;
    owl:inverseOf :hasQuantity .

:hasBusinessProcess a owl:ObjectProperty ;
    rdfs:label "has business process" ;
    rdfs:comment "Links an InvoiceMessage to a business process." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess .

:businessProcessOf a owl:ObjectProperty ;
    rdfs:label "business process of" ;
    rdfs:comment "Inverse of hasBusinessProcess." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasBusinessProcess .

:usesDelimiter a owl:ObjectProperty ;
    rdfs:label "uses delimiter" ;
    rdfs:comment "Links an InterchangeEnvelope to the EDIFACTDelimiter(s) it uses." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :EDIFACTDelimiter .

:delimiterUsedBy a owl:ObjectProperty ;
    rdfs:label "delimiter used by" ;
    rdfs:comment "Inverse of usesDelimiter." ;
    rdfs:domain :EDIFACTDelimiter ;
    rdfs:range :InterchangeEnvelope ;
    owl:inverseOf :usesDelimiter .

:appliesConstraint a owl:ObjectProperty ;
    rdfs:label "applies constraint" ;
    rdfs:comment "Links a ValidationConstraint to the InvoiceMessage(s) it validates." ;
    rdfs:domain :ValidationConstraint ;
    rdfs:range :InvoiceMessage .

:constraintAppliedBy a owl:ObjectProperty ;
    rdfs:label "constraint applied by" ;
    rdfs:comment "Inverse of appliesConstraint." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ValidationConstraint ;
    owl:inverseOf :appliesConstraint .

:segmentHasAssignment a owl:ObjectProperty ;
    rdfs:label "segment has assignment" ;
    rdfs:comment "Links a Segment to a SegmentElementAssignment." ;
    rdfs:domain :Segment ;
    rdfs:range :SegmentElementAssignment .

:assignmentOfSegment a owl:ObjectProperty ;
    rdfs:label "assignment of segment" ;
    rdfs:comment "Inverse of segmentHasAssignment." ;
    rdfs:domain :SegmentElementAssignment ;
    rdfs:range :Segment ;
    owl:inverseOf :segmentHasAssignment .

#################################################################
# DATA PROPERTIES
#################################################################
:elementValue a owl:DatatypeProperty ;
    rdfs:label "element value" ;
    rdfs:comment "The value of a SimpleDataElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string .

:segmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment code" ;
    rdfs:comment "The EDIFACT code for a segment (e.g., 'BGM', 'NAD')." ;
    rdfs:domain :Segment ;
    rdfs:range xsd:string .

:roleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "role code" ;
    rdfs:comment "The code for an AgentRole (e.g., 'BY' for buyer)." ;
    rdfs:domain :AgentRole ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:label "address line" ;
    rdfs:comment "A line of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "The city in an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "The postal code in an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code" ;
    rdfs:comment "The country code in an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:identifierValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "identifier value" ;
    rdfs:comment "The value of an identifier for an organization." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:label "item description" ;
    rdfs:comment "A textual description of an item." ;
    rdfs:domain :Item ;
    rdfs:range xsd:string .

:netPrice a owl:DatatypeProperty ;
    rdfs:label "net price" ;
    rdfs:comment "The net price of an item or invoice." ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal .

:quantityValue a owl:DatatypeProperty ;
    rdfs:label "quantity value" ;
    rdfs:comment "The quantity of an item." ;
    rdfs:domain :Quantity ;
    rdfs:range xsd:decimal .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:label "invoice amount" ;
    rdfs:comment "The total amount of an invoice." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:decimal .

:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice number" ;
    rdfs:comment "The unique number identifying an invoice." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string .

:sectionType a owl:DatatypeProperty ;
    rdfs:label "section type" ;
    rdfs:comment "The type of section: header, detail, or summary." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:delimiterSymbol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delimiter symbol" ;
    rdfs:comment "The character or symbol of an EDIFACT delimiter (e.g., '+', ':')." ;
    rdfs:domain :EDIFACTDelimiter ;
    rdfs:range xsd:string .

#################################################################
# CLASS AXIOMS & RESTRICTIONS
#################################################################
:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :identifiedBy ; owl:someValuesFrom :Identifier ] .

:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasLineItem ; owl:someValuesFrom :LineItem ] .

:LineItemDetail rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItem ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:Segment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasDataElement ; owl:someValuesFrom :CompositeDataElement ] .

:InvoiceParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ] ,
    [ a owl:Restriction ; owl:onProperty :participatesIn ; owl:someValuesFrom :InvoiceMessage ] .

#################################################################
# DISJOINTNESS AXIOMS
#################################################################
:Organization owl:disjointWith :Item .
:Segment owl:disjointWith :LineItem .
:HeaderSection owl:disjointWith :DetailSection , :SummarySection .
:DetailSection owl:disjointWith :SummarySection .
:CompositeDataElement owl:disjointWith :SimpleDataElement .
