@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document class, superclass for all document types." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FinancialDocument a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Financial Document" ;
    rdfs:comment "A document related to financial transactions." .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document, :Cl_FinancialDocument, :Cl_Entity ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued by a seller to a buyer indicating quantities, products, and agreed prices for products or services." .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message formatted according to the EDIFACT standard." .

:Cl_EDIFACTMessageInvoiceListing a owl:Class ;
    rdfs:label "EDIFACT Message Invoice Listing" ;
    rdfs:comment "A reification class representing the listing of invoices within an EDIFACT message." .

:Cl_InvoiceAmountReification a owl:Class ;
    rdfs:label "Invoice Amount Reification" ;
    rdfs:comment "A class to reify the amount associated with an invoice." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity involved in the event or story." .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Company" ;
    rdfs:comment "A business organization." .

:Cl_NGO a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Non-Governmental Organization" ;
    rdfs:comment "A non-governmental organization." .

:Cl_GovernmentAgency a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Government Agency" ;
    rdfs:comment "A public sector organization." .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Customer" ;
    rdfs:comment "An organization that purchases goods or services." .

:Cl_Supplier a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Supplier" ;
    rdfs:comment "An organization that provides goods or services." .

:Cl_Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event in which organizations are involved." .

:Cl_OrganizationInvolvement a owl:Class ;
    rdfs:label "Organization Involvement" ;
    rdfs:comment "A reification/pivot class to represent the involvement of an organization in an event, capturing additional information displayed about the organization in that context." .

:Cl_OrganizationInfo a owl:Class ;
    rdfs:label "Organization Information" ;
    rdfs:comment "A reification class to capture detailed information displayed about an organization (e.g., name, type, role, description, location, etc.)." .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Participation of an organization in an invoice, with a specific role." .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A role that an organization can play in an invoice." .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "Role of buyer in an invoice." .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller Role" ;
    rdfs:comment "Role of seller in an invoice." .

:Cl_BuyerParticipation a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceParticipation ;
    rdfs:label "Buyer Participation" ;
    rdfs:comment "Participation of the buyer in an invoice." .

:Cl_SellerParticipation a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceParticipation ;
    rdfs:label "Seller Participation" ;
    rdfs:comment "Participation of the seller in an invoice." .

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A generic entity." ;
    rdfs:subClassOf owl:Thing .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Person" ;
    rdfs:comment "A human being." .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person or organization that buys goods or services." .

:Cl_Address a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address." .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of a buyer to an address." .

:Cl_Item a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Item" ;
    rdfs:comment "Entity representing an item that is sold." .

:Cl_SoldItem a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Sold Item" ;
    rdfs:comment "An item that has been sold." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Product" ;
    rdfs:comment "A product item." .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Service" ;
    rdfs:comment "A service item." .

:Cl_InvoiceLine a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in an invoice indicating a specific item or service." .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A class representing an amount of money or quantity." .

:Cl_Price a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Price" ;
    rdfs:comment "A price for a product or service." .

:Cl_NetPrice a owl:Class ;
    rdfs:subClassOf :Cl_Price ;
    rdfs:label "Net Price" ;
    rdfs:comment "The net price for an item or service." .

:Cl_GrossPrice a owl:Class ;
    rdfs:subClassOf :Cl_Price ;
    rdfs:label "Gross Price" ;
    rdfs:comment "The gross price for an item or service." .

:Cl_ItemDisplayInformation a owl:Class ;
    rdfs:label "Item Display Information" ;
    rdfs:comment "Reification class for information displayed about an item sold." .

:Cl_ItemCharacteristic a owl:Class ;
    rdfs:label "Item Characteristic" ;
    rdfs:comment "Superclass for different characteristics of an item." .

:Cl_ItemName a owl:Class ;
    rdfs:subClassOf :Cl_ItemCharacteristic ;
    rdfs:label "Item Name" ;
    rdfs:comment "The name of an item." .

:Cl_ItemPrice a owl:Class ;
    rdfs:subClassOf :Cl_ItemCharacteristic ;
    rdfs:label "Item Price" ;
    rdfs:comment "The price of an item." .

:Cl_ItemDescription a owl:Class ;
    rdfs:subClassOf :Cl_ItemCharacteristic ;
    rdfs:label "Item Description" ;
    rdfs:comment "The description of an item." .

:Cl_ItemCategory a owl:Class ;
    rdfs:subClassOf :Cl_ItemCharacteristic ;
    rdfs:label "Item Category" ;
    rdfs:comment "The category of an item." .

:Cl_ItemImage a owl:Class ;
    rdfs:subClassOf :Cl_ItemCharacteristic ;
    rdfs:label "Item Image" ;
    rdfs:comment "An image of the item." .

:Cl_Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A generic identifier class." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:subClassOf :Cl_Identifier ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "An identifier for an invoice." .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A class representing a file format." .

:Cl_FileFormatSpecification a owl:Class ;
    rdfs:subClassOf :Cl_FileFormat ;
    rdfs:label "File Format Specification" ;
    rdfs:comment "A specification for a file format." .

:Cl_FileFormatElement a owl:Class ;
    rdfs:subClassOf :Cl_FileFormatSpecification ;
    rdfs:label "File Format Element" ;
    rdfs:comment "An element of a file format specification." .

:Cl_ValidationRequirement a owl:Class ;
    rdfs:subClassOf :Cl_FileFormatSpecification ;
    rdfs:label "Validation Requirement" ;
    rdfs:comment "A requirement for file format validation." .

:Cl_RequiredField a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement ;
    rdfs:label "Required Field" ;
    rdfs:comment "A required field in a file format." .

:Cl_FieldOrder a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement ;
    rdfs:label "Field Order" ;
    rdfs:comment "Order of a field in a file format." .

:Cl_FieldLength a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement ;
    rdfs:label "Field Length" ;
    rdfs:comment "Length of a field in a file format." .

:Cl_Encoding a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement ;
    rdfs:label "Encoding" ;
    rdfs:comment "Encoding used in a file format." .

:Cl_ValidationRule a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule for file format validation." .

:Cl_DataType a owl:Class ;
    rdfs:subClassOf :Cl_FileFormatElement ;
    rdfs:label "Data Type" ;
    rdfs:comment "A data type for file format elements." .

:Cl_ValueConstraint a owl:Class ;
    rdfs:subClassOf :Cl_FileFormatElement ;
    rdfs:label "Value Constraint" ;
    rdfs:comment "A constraint on the value of a file format element." .

:Cl_FileFormatValidity a owl:Class ;
    rdfs:label "File Format Validity" ;
    rdfs:comment "Indicates whether a file format is valid." .

:Cl_ProvidedInformation a owl:Class ;
    rdfs:label "Provided Information" ;
    rdfs:comment "Information provided during file format validation." .

:Cl_FileFormatValidationSituation a owl:Class ;
    rdfs:label "File Format Validation Situation" ;
    rdfs:comment "A situation describing the validation of a file format." .

:Cl_Process a owl:Class ;
    rdfs:label "Process" ;
    rdfs:comment "A process, such as a business process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BusinessProcess a owl:Class ;
    rdfs:subClassOf :Cl_Process ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process." .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment" ;
    rdfs:comment "An assignment of an invoice to a business process." .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact information for an entity." .

:Cl_MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount" ;
    rdfs:comment "A monetary amount." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_DateTime a owl:Class ;
    rdfs:label "Date Time" ;
    rdfs:comment "A date and time value." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "A detail in an invoice, such as a line, product, or service." .

#################################################################
# Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Connects an EDIFACT message to its invoice listing reification class." ;
    owl:inverseOf :isInvoiceListingOf .

:isInvoiceListingOf a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "is invoice listing of" ;
    rdfs:comment "Inverse property for hasInvoiceListing." ;
    owl:inverseOf :hasInvoiceListing .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Associates the invoice listing with the invoices it lists." ;
    owl:inverseOf :isListedInInvoiceListing .

:isListedInInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:label "is listed in invoice listing" ;
    rdfs:comment "Inverse property for listsInvoice." ;
    owl:inverseOf :listsInvoice .

:edifactMessageId a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "EDIFACT message ID" ;
    rdfs:comment "The unique identifier for an EDIFACT message." .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links an invoice amount reification to an invoice." ;
    owl:inverseOf :isInvoiceOfInvoiceAmountReification .

:isInvoiceOfInvoiceAmountReification a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountReification ;
    rdfs:label "is invoice of invoice amount reification" ;
    rdfs:comment "Inverse property for hasInvoice." ;
    owl:inverseOf :hasInvoice .

:hasInvoiceAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range xsd:decimal ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "The monetary value of the invoice." .

:hasInvoiceIdentifier a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentifier ;
    rdfs:label "has invoice identifier" ;
    rdfs:comment "Links an invoice to its identifier." ;
    owl:inverseOf :isInvoiceIdentifierOf .

:isInvoiceIdentifierOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice identifier of" ;
    rdfs:comment "Inverse property for hasInvoiceIdentifier." ;
    owl:inverseOf :hasInvoiceIdentifier .

:identifierValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" ;
    rdfs:comment "The string value of an identifier." .

:hasInvolvedOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range :Cl_OrganizationInvolvement ;
    rdfs:label "has involved organization" ;
    rdfs:comment "Links an event to an organization involvement instance." ;
    owl:inverseOf :isInvolvedOrganizationOf .

:isInvolvedOrganizationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Event ;
    rdfs:label "is involved organization of" ;
    rdfs:comment "Inverse property for hasInvolvedOrganization." ;
    owl:inverseOf :hasInvolvedOrganization .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links the organization involvement to the organization entity." ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvolvement ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Inverse property for involvesOrganization." ;
    owl:inverseOf :involvesOrganization .

:hasOrganizationInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_OrganizationInfo ;
    rdfs:label "has organization info" ;
    rdfs:comment "Links an organization involvement to the detailed information displayed about the organization." ;
    owl:inverseOf :isOrganizationInfoOf .

:isOrganizationInfoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_OrganizationInvolvement ;
    rdfs:label "is organization info of" ;
    rdfs:comment "Inverse property for hasOrganizationInfo." ;
    owl:inverseOf :hasOrganizationInfo .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization." .

:organizationType a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range xsd:string ;
    rdfs:label "organization type" ;
    rdfs:comment "Type of the organization (e.g., company, NGO, government agency, etc.)." .

:organizationRole a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range xsd:string ;
    rdfs:label "organization role" ;
    rdfs:comment "Role of the organization in the event (e.g., sponsor, organizer, participant, etc.)." .

:organizationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range xsd:string ;
    rdfs:label "organization description" ;
    rdfs:comment "Description of the organization." .

:organizationLocation a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range xsd:string ;
    rdfs:label "organization location" ;
    rdfs:comment "Location of the organization." .

:organizationContact a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range xsd:string ;
    rdfs:label "organization contact" ;
    rdfs:comment "Contact information for the organization." .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer name" ;
    rdfs:comment "The name of the customer." .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "has invoice participation" ;
    rdfs:comment "Links an invoice to a participation instance." ;
    owl:inverseOf :isInvoiceParticipationOf .

:isInvoiceParticipationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice participation of" ;
    rdfs:comment "Inverse property for hasInvoiceParticipation." ;
    owl:inverseOf :hasInvoiceParticipation .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" ;
    rdfs:comment "Links an invoice participation to an organization." ;
    owl:inverseOf :isOrganizationOfInvoiceParticipation .

:isOrganizationOfInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is organization of invoice participation" ;
    rdfs:comment "Inverse property for hasOrganization." ;
    owl:inverseOf :hasOrganization .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has participant" ;
    rdfs:comment "Links an invoice participation to a participant organization." ;
    owl:inverseOf :participatesInInvoice .

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "participates in invoice" ;
    rdfs:comment "Inverse property for hasParticipant." ;
    owl:inverseOf :hasParticipant .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has role" ;
    rdfs:comment "Links an invoice participation to a role." ;
    owl:inverseOf :isRoleOfInvoiceParticipation .

:isRoleOfInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is role of invoice participation" ;
    rdfs:comment "Inverse property for hasRole." ;
    owl:inverseOf :hasRole .

:roleLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role label" ;
    rdfs:comment "Label for the invoice role." .

:inInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "in invoice" ;
    rdfs:comment "Links a participation to the invoice." ;
    owl:inverseOf :hasParticipation .

:hasParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "has participation" ;
    rdfs:comment "Inverse property for inInvoice." ;
    owl:inverseOf :inInvoice .

:buyerParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_BuyerParticipation ;
    rdfs:label "buyer participation" ;
    rdfs:comment "Links an invoice to buyer participation." ;
    owl:inverseOf :isBuyerParticipationOf .

:isBuyerParticipationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is buyer participation of" ;
    rdfs:comment "Inverse property for buyerParticipation." ;
    owl:inverseOf :buyerParticipation .

:sellerParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_SellerParticipation ;
    rdfs:label "seller participation" ;
    rdfs:comment "Links an invoice to seller participation." ;
    owl:inverseOf :isSellerParticipationOf .

:isSellerParticipationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_SellerParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is seller participation of" ;
    rdfs:comment "Inverse property for sellerParticipation." ;
    owl:inverseOf :sellerParticipation .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "has buyer" ;
    rdfs:comment "Links a buyer address assignment to a buyer." ;
    owl:inverseOf :isBuyerOfAssignment .

:isBuyerOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "is buyer of assignment" ;
    rdfs:comment "Inverse property for hasBuyer." ;
    owl:inverseOf :hasBuyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    rdfs:label "has address" ;
    rdfs:comment "Links a buyer address assignment to an address." ;
    owl:inverseOf :isAddressOfAssignment .

:isAddressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "is address of assignment" ;
    rdfs:comment "Inverse property for hasAddress." ;
    owl:inverseOf :hasAddress .

:street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "street" ;
    rdfs:comment "Street name of the address." .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "city" ;
    rdfs:comment "City of the address." .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code of the address." .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "country" ;
    rdfs:comment "Country of the address." .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "invoice line" ;
    rdfs:comment "Links an invoice to its invoice lines." ;
    owl:inverseOf :isInvoiceLineOf .

:isInvoiceLineOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice line of" ;
    rdfs:comment "Inverse property for hasInvoiceLine." ;
    owl:inverseOf :hasInvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "refers to item" ;
    rdfs:comment "Links an invoice line to an item." ;
    owl:inverseOf :isItemReferredByInvoiceLine .

:isItemReferredByInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "is item referred by invoice line" ;
    rdfs:comment "Inverse property for refersToItem." ;
    owl:inverseOf :refersToItem .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "has item" ;
    rdfs:comment "Links an invoice line to the item (product or service) being sold." ;
    owl:inverseOf :isItemOfInvoiceLine .

:isItemOfInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "is item of invoice line" ;
    rdfs:comment "Inverse property for hasItem." ;
    owl:inverseOf :hasItem .

:hasProduct a owl:ObjectProperty ;
