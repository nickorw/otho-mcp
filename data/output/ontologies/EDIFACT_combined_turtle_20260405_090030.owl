    owl:inverseOf :assignedBusinessProcess .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "The date of the assignment." .

#################################################################
# Restrictions & Axioms
#################################################################

:Cl_EDIFACTMessageInvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :listsInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :isInvoiceListingOf ;
          owl:someValuesFrom :Cl_EDIFACTMessage ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasParticipant ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Cl_InvoiceRole ]
        [ rdf:type owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_BuyerParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceParticipation
        [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:allValuesFrom :Cl_BuyerRole ]
    )
] .

:Cl_SellerParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceParticipation
        [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:allValuesFrom :Cl_SellerRole ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceNetTotal ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_ItemDisplayInformation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :displayedCharacteristic ;
        owl:allValuesFrom :Cl_ItemCharacteristic
    ]
] .

:Cl_SoldItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasDisplayInformation ;
        owl:someValuesFrom :Cl_ItemDisplayInformation
    ]
] .

:Cl_ItemCharacteristic owl:disjointUnionOf (
    :Cl_ItemName
    :Cl_ItemPrice
    :Cl_ItemDescription
    :Cl_ItemCategory
    :Cl_ItemImage
) .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToProduct ; owl:someValuesFrom :Cl_Product ]
        [ rdf:type owl:Restriction ; owl:onProperty :refersToService ; owl:someValuesFrom :Cl_Service ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine
    ]
] .

:Cl_InvoiceDetail owl:disjointUnionOf ( :Cl_InvoiceLine :Cl_Product :Cl_Service ) .

:Cl_InvoiceDetail owl:equivalentClass [
    owl:unionOf ( :Cl_InvoiceLine :Cl_Product :Cl_Service )
] .

:Cl_InvoiceAmountReification owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceIdentifier ;
        owl:allValuesFrom :Cl_InvoiceIdentifier
    ]
] .

:Cl_InvoiceIdentifier owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :identifierValue ;
        owl:allValuesFrom xsd:string
    ]
] .

:Cl_FileFormatValidity owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :validityStatus ;
          owl:hasValue true ]
        [ a owl:Restriction ;
          owl:onProperty :isValidFormat ;
          owl:someValuesFrom :Cl_FileFormatValidationSituation ]
    )
] .

:Cl_FileFormatValidationSituation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :validatesFileFormat ;
          owl:someValuesFrom :Cl_FileFormat ]
        [ a owl:Restriction ;
          owl:onProperty :providedInformation ;
          owl:someValuesFrom :Cl_ProvidedInformation ]
    )
] .

:Cl_ProvidedInformation owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
      owl:onProperty :relatesToRequirement ;
      owl:someValuesFrom :Cl_ValidationRequirement
    ]
] .

:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:allValuesFrom :Cl_Organization
] .

:Cl_OrganizationInvolvement rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasOrganizationInfo ;
    owl:someValuesFrom :Cl_OrganizationInfo
] .

:Cl_Event rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvolvedOrganization ;
    owl:someValuesFrom :Cl_OrganizationInvolvement
] .

:Cl_OrganizationInfo rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty [ owl:inverseOf :hasOrganizationInfo ] ;
    owl:someValuesFrom :Cl_OrganizationInvolvement
] .

#################################################################
# Disjointness
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_EDIFACTMessageInvoiceListing owl:disjointWith :Cl_EDIFACTMessage, :Cl_Invoice .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Company owl:disjointWith :Cl_Supplier, :Cl_Customer, :Cl_NGO, :Cl_GovernmentAgency .
:Cl_NGO owl:disjointWith :Cl_GovernmentAgency .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_BuyerParticipation owl:disjointWith :Cl_SellerParticipation .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_BuyerAddressAssignment owl:disjointWith :Cl_Buyer, :Cl_Address .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_NetPrice owl:disjointWith :Cl_GrossPrice .
:Cl_Invoice owl:disjointWith :Cl_FinancialDocument, :Cl_Identifier, :Cl_BusinessProcess, :Cl_Assignment .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment .
:Cl_FileFormatSpecification owl:disjointWith :Cl_FileFormatValidity .
:Cl_ValidationRequirement owl:disjointWith :Cl_ProvidedInformation .
:Cl_FileFormatElement owl:disjointWith :Cl_ValidationRequirement .
:Cl_ItemName owl:disjointWith :Cl_ItemPrice, :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage .
:Cl_ItemPrice owl:disjointWith :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage .
:Cl_ItemDescription owl:disjointWith :Cl_ItemCategory, :Cl_ItemImage .
:Cl_ItemCategory owl:disjointWith :Cl_ItemImage .

#################################################################
# Hierarchies (repeated for clarity)
#################################################################

:Cl_Company rdfs:subClassOf :Cl_Organization .
:Cl_NGO rdfs:subClassOf :Cl_Organization .
:Cl_GovernmentAgency rdfs:subClassOf :Cl_Organization .
:Cl_Customer rdfs:subClassOf :Cl_Organization .
:Cl_Supplier rdfs:subClassOf :Cl_Organization .
:Cl_Buyer rdfs:subClassOf :Cl_Person .
:Cl_Person rdfs:subClassOf :Cl_Entity .
:Cl_Address rdfs:subClassOf :Cl_Entity .
:Cl_BuyerAddressAssignment rdfs:subClassOf :Cl_Entity .
:Cl_Invoice rdfs:subClassOf :Cl_Document, :Cl_FinancialDocument, :Cl_Entity .
:Cl_FinancialDocument rdfs:subClassOf :Cl_Document .
:Cl_InvoiceLine rdfs:subClassOf :Cl_Entity .
:Cl_Product rdfs:subClassOf :Cl_Item .
:Cl_Service rdfs:subClassOf :Cl_Item .
:Cl_SoldItem rdfs:subClassOf :Cl_Item .
:Cl_ItemName rdfs:subClassOf :Cl_ItemCharacteristic .
:Cl_ItemPrice rdfs:subClassOf :Cl_ItemCharacteristic .
:Cl_ItemDescription rdfs:subClassOf :Cl_ItemCharacteristic .
:Cl_ItemCategory rdfs:subClassOf :Cl_ItemCharacteristic .
:Cl_ItemImage rdfs:subClassOf :Cl_ItemCharacteristic .
:Cl_Price rdfs:subClassOf :Cl_Entity .
:Cl_NetPrice rdfs:subClassOf :Cl_Price .
:Cl_GrossPrice rdfs:subClassOf :Cl_Price .
:Cl_FileFormatSpecification rdfs:subClassOf :Cl_FileFormat .
:Cl_FileFormatElement rdfs:subClassOf :Cl_FileFormatSpecification .
:Cl_ValidationRequirement rdfs:subClassOf :Cl_FileFormatSpecification .
:Cl_RequiredField rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_FieldOrder rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_FieldLength rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_Encoding rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_ValidationRule rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_DataType rdfs:subClassOf :Cl_FileFormatElement .
:Cl_ValueConstraint rdfs:subClassOf :Cl_FileFormatElement .
:Cl_BusinessProcess rdfs:subClassOf :Cl_Process .
:Cl_Assignment rdfs:subClassOf owl:Thing .
:Cl_InvoiceDetail rdfs:subClassOf owl:Thing .
:Cl_InvoiceLine rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_Product rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_Service rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_ContactInformation rdfs:subClassOf owl:Thing .
:Cl_MonetaryAmount rdfs:subClassOf :Cl_Entity .
:Cl_DateTime rdfs:subClassOf :Cl_Entity .

#################################################################
# Connections for Previously Unconnected Classes (P04)
#################################################################

:Cl_Process rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A process, such as a business process." .

:Cl_Entity rdfs:subClassOf owl:Thing ;
    rdfs:comment "A generic entity, superclass for most domain objects." .

:Cl_Identifier rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A generic identifier class, used for identifying entities." .

:Cl_Document rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A document is an entity." .

:Cl_DateTime rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A date and time value, considered an entity." .

#################################################################
# End of FestS ontology
#################################################################
