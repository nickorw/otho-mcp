@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#UNEDIFACTInvoiceStory>
    a owl:Ontology ;
    rdfs:label "UN/EDIFACT Invoice Story Ontology" ;
    rdfs:comment "Ontology modeling the structure and semantics of UN/EDIFACT invoice messages, roles, segments, and data elements in accordance with EN 16931-1 and P2P-O." .

#################################################################
# CLASSES
#################################################################

:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The top-level envelope for an EDIFACT interchange, containing one or more messages." .

:Message a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "A business message within an interchange envelope, such as an invoice." .

:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An invoice message conforming to UN/EDIFACT, typically INVOIC." ;
    rdfs:subClassOf :Message ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :Section ] .

:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "A segment within a message, such as BGM or NAD." .

:BGMSegment a owl:Class ;
    rdfs:label "BGM Segment" ;
    rdfs:comment "Beginning of Message segment, provides document identification." ;
    rdfs:subClassOf :Segment .

:NADSegment a owl:Class ;
    rdfs:label "NAD Segment" ;
    rdfs:comment "Name and Address segment, provides participant details." ;
    rdfs:subClassOf :Segment .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite data element within a segment, containing multiple simple elements." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A simple (atomic) data element within a composite or segment." .

:Section a owl:Class ;
    rdfs:label "Section" ;
    rdfs:comment "A section of an invoice message (header, detail, summary)." ;
    owl:disjointUnionOf (:HeaderSection :DetailSection :SummarySection) .

:HeaderSection a owl:Class ;
    rdfs:label "Header Section" ;
    rdfs:comment "The header section of an invoice, containing document dates and reference numbers." ;
    rdfs:subClassOf :Section .

:DetailSection a owl:Class ;
    rdfs:label "Detail Section" ;
    rdfs:comment "The detail section of an invoice, listing individual line items." ;
    rdfs:subClassOf :Section .

:SummarySection a owl:Class ;
    rdfs:label "Summary Section" ;
    rdfs:comment "The summary section of an invoice, providing totals and taxes." ;
    rdfs:subClassOf :Section .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity involved in the transaction, such as buyer or seller." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization within a business process." .

:BuyerRole a owl:Class ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "The organization acting as the buyer." ;
    rdfs:subClassOf :AgentRole .

:DeliveryPartyRole a owl:Class ;
    rdfs:label "Delivery Party Role" ;
    rdfs:comment "The organization acting as the delivery party." ;
    rdfs:subClassOf :AgentRole .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal or physical address associated with an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed in the invoice." .

:LineItem a owl:Class ;
    rdfs:label "Line Item" ;
    rdfs:comment "An itemized line within the invoice detail section." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A monetary value for an item or the invoice total." .

:Tax a owl:Class ;
    rdfs:label "Tax" ;
    rdfs:comment "A tax amount applicable to the invoice." .

:ReferenceNumber a owl:Class ;
    rdfs:label "Reference Number" ;
    rdfs:comment "A unique reference number for the invoice or related documents." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A generic identifier for organizations, items, or documents." .

:GlobalLocationNumber a owl:Class ;
    rdfs:label "Global Location Number" ;
    rdfs:comment "A standardized identifier for organizational locations." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which the invoice is assigned." .

:ValidationConstraint a owl:Class ;
    rdfs:label "Validation Constraint" ;
    rdfs:comment "A constraint for automated validation, e.g., SHACL shapes." .

:Standard a owl:Class ;
    rdfs:label "Standard" ;
    rdfs:comment "A technical or business standard relevant to the message." .

:EDIFACTDirectory a owl:Class ;
    rdfs:label "EDIFACT Directory" ;
    rdfs:comment "The official EDIFACT directory (e.g., D96A)." ;
    rdfs:subClassOf :Standard .

:EN16931Standard a owl:Class ;
    rdfs:label "EN 16931 Standard" ;
    rdfs:comment "The European Standard EN 16931-1 for electronic invoicing." ;
    rdfs:subClassOf :Standard .

:P2POntology a owl:Class ;
    rdfs:label "P2P-O Ontology" ;
    rdfs:comment "The Purchase-to-Pay Ontology for procurement processes." ;
    rdfs:subClassOf :Standard .

#################################################################
# PIVOT CLASSES (REIFICATION)
#################################################################

:OrganizationRoleAssignment a owl:Class ;
    rdfs:label "Organization Role Assignment" ;
    rdfs:comment "Reifies the assignment of an AgentRole to an Organization within a specific context (e.g., invoice)." .

:InvoiceItemAssignment a owl:Class ;
    rdfs:label "Invoice Item Assignment" ;
    rdfs:comment "Reifies the association of a LineItem with an InvoiceMessage." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignedLineItem ; owl:someValuesFrom :LineItem ] ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignmentOfInvoice ; owl:someValuesFrom :InvoiceMessage ] .

:InvoiceSectionAssignment a owl:Class ;
    rdfs:label "Invoice Section Assignment" ;
    rdfs:comment "Reifies the association of a Section with an InvoiceMessage." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignedSection ; owl:someValuesFrom :Section ] ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignmentOfInvoice ; owl:someValuesFrom :InvoiceMessage ] .

#################################################################
# OBJECT PROPERTIES (with inverses)
#################################################################

:hasMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has message" ;
    rdfs:comment "Relates an InterchangeEnvelope to a Message." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :Message ;
    owl:inverseOf :isMessageOf .

:isMessageOf a owl:ObjectProperty ;
    rdfs:label "is message of" ;
    rdfs:comment "Inverse of hasMessage; relates a Message to its InterchangeEnvelope." ;
    rdfs:domain :Message ;
    rdfs:range :InterchangeEnvelope .

:containsSegment a owl:ObjectProperty ;
    rdfs:label "contains segment" ;
    rdfs:comment "Relates a Message to its constituent Segments." ;
    rdfs:domain :Message ;
    rdfs:range :Segment ;
    owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
    rdfs:label "is segment of" ;
    rdfs:comment "Inverse of containsSegment; relates a Segment to its Message." ;
    rdfs:domain :Segment ;
    rdfs:range :Message .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has section" ;
    rdfs:comment "Relates an InvoiceMessage to its Sections." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Section ;
    owl:inverseOf :isSectionOf .

:isSectionOf a owl:ObjectProperty ;
    rdfs:label "is section of" ;
    rdfs:comment "Inverse of hasSection; relates a Section to its InvoiceMessage." ;
    rdfs:domain :Section ;
    rdfs:range :InvoiceMessage .

:hasLineItem a owl:ObjectProperty ;
    rdfs:label "has line item" ;
    rdfs:comment "Relates a DetailSection to its LineItems." ;
    rdfs:domain :DetailSection ;
    rdfs:range :LineItem ;
    owl:inverseOf :isLineItemOf .

:isLineItemOf a owl:ObjectProperty ;
    rdfs:label "is line item of" ;
    rdfs:comment "Inverse of hasLineItem; relates a LineItem to its DetailSection." ;
    rdfs:domain :LineItem ;
    rdfs:range :DetailSection .

:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Relates a LineItem to an Item." ;
    rdfs:domain :LineItem ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOf .

:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:comment "Inverse of hasItem; relates an Item to its LineItem." ;
    rdfs:domain :Item ;
    rdfs:range :LineItem .

:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has net price" ;
    rdfs:comment "Relates a LineItem to its net Price." ;
    rdfs:domain :LineItem ;
    rdfs:range :Price ;
    owl:inverseOf :isNetPriceOf .

:isNetPriceOf a owl:ObjectProperty ;
    rdfs:label "is net price of" ;
    rdfs:comment "Inverse of hasNetPrice; relates a Price to its LineItem." ;
    rdfs:domain :Price ;
    rdfs:range :LineItem .

:hasTax a owl:ObjectProperty ;
    rdfs:label "has tax" ;
    rdfs:comment "Relates a SummarySection to its Tax." ;
    rdfs:domain :SummarySection ;
    rdfs:range :Tax ;
    owl:inverseOf :isTaxOf .

:isTaxOf a owl:ObjectProperty ;
    rdfs:label "is tax of" ;
    rdfs:comment "Inverse of hasTax; relates a Tax to its SummarySection." ;
    rdfs:domain :Tax ;
    rdfs:range :SummarySection .

:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has reference number" ;
    rdfs:comment "Relates a HeaderSection to its ReferenceNumber." ;
    rdfs:domain :HeaderSection ;
    rdfs:range :ReferenceNumber ;
    owl:inverseOf :isReferenceNumberOf .

:isReferenceNumberOf a owl:ObjectProperty ;
    rdfs:label "is reference number of" ;
    rdfs:comment "Inverse of hasReferenceNumber; relates a ReferenceNumber to its HeaderSection." ;
    rdfs:domain :ReferenceNumber ;
    rdfs:range :HeaderSection .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:label "involves organization" ;
    rdfs:comment "Relates an InvoiceMessage to an OrganizationRoleAssignment (reified role)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Inverse of involvesOrganization; relates an OrganizationRoleAssignment to its InvoiceMessage." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage .

:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates an OrganizationRoleAssignment to an AgentRole." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :AgentRole ;
    owl:inverseOf :isRoleOfAssignment .

:isRoleOfAssignment a owl:ObjectProperty ;
    rdfs:label "is role of assignment" ;
    rdfs:comment "Inverse of hasRole; relates an AgentRole to an OrganizationRoleAssignment." ;
    rdfs:domain :AgentRole ;
    rdfs:range :OrganizationRoleAssignment .

:hasOrganization a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has organization" ;
    rdfs:comment "Relates an OrganizationRoleAssignment to an Organization." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :isOrganizationOfAssignment .

:isOrganizationOfAssignment a owl:ObjectProperty ;
    rdfs:label "is organization of assignment" ;
    rdfs:comment "Inverse of hasOrganization; relates an Organization to an OrganizationRoleAssignment." ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationRoleAssignment .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an Organization to its Address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse of hasAddress; relates an Address to its Organization." ;
    rdfs:domain :Address ;
    rdfs:range :Organization .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "has identifier" ;
    rdfs:comment "Relates an Organization to its Identifier(s)." ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier ;
    owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Inverse of hasIdentifier; relates an Identifier to its Organization." ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization .

:hasGlobalLocationNumber a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has GLN" ;
    rdfs:comment "Relates an Organization to its Global Location Number." ;
    rdfs:domain :Organization ;
    rdfs:range :GlobalLocationNumber ;
    owl:inverseOf :isGLNOf .

:isGLNOf a owl:ObjectProperty ;
    rdfs:label "is GLN of" ;
    rdfs:comment "Inverse of hasGlobalLocationNumber; relates a GlobalLocationNumber to its Organization." ;
    rdfs:domain :GlobalLocationNumber ;
    rdfs:range :Organization .

:hasBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has business process" ;
    rdfs:comment "Relates an InvoiceMessage to a BusinessProcess." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :isBusinessProcessOf .

:isBusinessProcessOf a owl:ObjectProperty ;
    rdfs:label "is business process of" ;
    rdfs:comment "Inverse of hasBusinessProcess; relates a BusinessProcess to its InvoiceMessage." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage .

:conformsToStandard a owl:ObjectProperty ;
    rdfs:label "conforms to standard" ;
    rdfs:comment "Relates an InvoiceMessage to a Standard (e.g., EN 16931-1, EDIFACT)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Standard ;
    owl:inverseOf :isStandardFor .

:isStandardFor a owl:ObjectProperty ;
    rdfs:label "is standard for" ;
    rdfs:comment "Inverse of conformsToStandard; relates a Standard to its InvoiceMessage." ;
    rdfs:domain :Standard ;
    rdfs:range :InvoiceMessage .

:isValidatedBy a owl:ObjectProperty ;
    rdfs:label "is validated by" ;
    rdfs:comment "Relates an InvoiceMessage to a ValidationConstraint (e.g., SHACL)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :ValidationConstraint ;
    owl:inverseOf :validates .

:validates a owl:ObjectProperty ;
    rdfs:label "validates" ;
    rdfs:comment "Inverse of isValidatedBy; relates a ValidationConstraint to its InvoiceMessage." ;
    rdfs:domain :ValidationConstraint ;
    rdfs:range :InvoiceMessage .

:segmentHasCompositeElement a owl:ObjectProperty ;
    rdfs:label "segment has composite element" ;
    rdfs:comment "Relates a Segment to its CompositeDataElements." ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :isCompositeElementOfSegment .

:isCompositeElementOfSegment a owl:ObjectProperty ;
    rdfs:label "is composite element of segment" ;
    rdfs:comment "Inverse of segmentHasCompositeElement; relates a CompositeDataElement to its Segment." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment .

:compositeHasSimpleElement a owl:ObjectProperty ;
    rdfs:label "composite has simple element" ;
    rdfs:comment "Relates a CompositeDataElement to its SimpleDataElements." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    owl:inverseOf :isSimpleElementOfComposite .

:isSimpleElementOfComposite a owl:ObjectProperty ;
    rdfs:label "is simple element of composite" ;
    rdfs:comment "Inverse of compositeHasSimpleElement; relates a SimpleDataElement to its CompositeDataElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement .

# New properties for pivot class connections
:assignedLineItem a owl:ObjectProperty ;
    rdfs:label "assigned line item" ;
    rdfs:comment "Relates an InvoiceItemAssignment to a LineItem." ;
    rdfs:domain :InvoiceItemAssignment ;
    rdfs:range :LineItem ;
    owl:inverseOf :isAssignedLineItemOf .

:isAssignedLineItemOf a owl:ObjectProperty ;
    rdfs:label "is assigned line item of" ;
    rdfs:comment "Inverse of assignedLineItem; relates a LineItem to its InvoiceItemAssignment." ;
    rdfs:domain :LineItem ;
    rdfs:range :InvoiceItemAssignment .

:assignmentOfInvoice a owl:ObjectProperty ;
    rdfs:label "assignment of invoice" ;
    rdfs:comment "Relates an InvoiceItemAssignment or InvoiceSectionAssignment to an InvoiceMessage." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (:InvoiceItemAssignment :InvoiceSectionAssignment) ] ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasAssignment .

:hasAssignment a owl:ObjectProperty ;
    rdfs:label "has assignment" ;
    rdfs:comment "Inverse of assignmentOfInvoice; relates an InvoiceMessage to its InvoiceItemAssignment or InvoiceSectionAssignment." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range [ a owl:Class ; owl:unionOf (:InvoiceItemAssignment :InvoiceSectionAssignment) ] .

:assignedSection a owl:ObjectProperty ;
    rdfs:label "assigned section" ;
    rdfs:comment "Relates an InvoiceSectionAssignment to a Section." ;
    rdfs:domain :InvoiceSectionAssignment ;
    rdfs:range :Section ;
    owl:inverseOf :isAssignedSectionOf .

:isAssignedSectionOf a owl:ObjectProperty ;
    rdfs:label "is assigned section of" ;
    rdfs:comment "Inverse of assignedSection; relates a Section to its InvoiceSectionAssignment." ;
    rdfs:domain :Section ;
    rdfs:range :InvoiceSectionAssignment .

#################################################################
# DATA PROPERTIES
#################################################################

:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has quantity" ;
    rdfs:comment "The quantity of items in a LineItem." ;
    rdfs:domain :LineItem ;
    rdfs:range xsd:decimal .

:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "The total invoice amount in the SummarySection." ;
    rdfs:domain :SummarySection ;
    rdfs:range xsd:decimal .

:hasDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has date" ;
    rdfs:comment "A date value in the HeaderSection (custom format, string)." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .

:hasCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has code" ;
    rdfs:comment "A code value for a SimpleDataElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string .

:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value" ;
    rdfs:comment "A value for a SimpleDataElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range xsd:string .

#################################################################
# PROPERTY CHARACTERISTICS
#################################################################

# Functional and other characteristics already declared inline above.

#################################################################
# DISJOINT CLASSES
#################################################################

:BGMSegment owl:disjointWith :NADSegment .
:HeaderSection owl:disjointWith :DetailSection .
:HeaderSection owl:disjointWith :SummarySection .
:DetailSection owl:disjointWith :SummarySection .
:BuyerRole owl:disjointWith :DeliveryPartyRole .
