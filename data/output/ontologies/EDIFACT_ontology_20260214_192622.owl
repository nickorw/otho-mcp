@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/EDIFACTScenario>
    a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Scenario Ontology" ;
    rdfs:comment "A deep and profoundly structured ontology for representing EDIFACT invoice messages, organizations, roles, items, technical vocabulary, and business processes." .

#################################################################
# Classes
#################################################################

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "An EDIFACT message containing segments and invoices." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, relating to a sale transaction in the EDIFACT context." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity involved in an invoice, such as buyer or seller." .

:OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "A role that an organization may play in the context of an invoice (e.g., buyer, seller)." .

:BuyerRole a owl:Class ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "The role of an organization as a buyer in an invoice." ;
    rdfs:subClassOf :OrganizationRole .

:SellerRole a owl:Class ;
    rdfs:label "Seller Role" ;
    rdfs:comment "The role of an organization as a seller in an invoice." ;
    rdfs:subClassOf :OrganizationRole .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address associated with an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service listed in an invoice." .

:InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "An itemized entry in an invoice." .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed information about an invoice, such as payment terms or references." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process with which an invoice can be associated." .

:EDIFACTSegment a owl:Class ;
    rdfs:label "EDIFACT Segment" ;
    rdfs:comment "A structural unit of an EDIFACT message, consisting of elements." .

:EDIFACTElement a owl:Class ;
    rdfs:label "EDIFACT Element" ;
    rdfs:comment "A data element within an EDIFACT segment." .

:EDIFACTCode a owl:Class ;
    rdfs:label "EDIFACT Code" ;
    rdfs:comment "A code used in EDIFACT elements for standardized values." .

:FileFormatRequirement a owl:Class ;
    rdfs:label "File Format Requirement" ;
    rdfs:comment "A requirement that must be fulfilled for the EDIFACT file format to be valid." .

:InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "A pivot class reifying the participation of an organization in an invoice with a specific role." .

:InvoiceItemDetail a owl:Class ;
    rdfs:label "Invoice Item Detail" ;
    rdfs:comment "A pivot class reifying details about an item in an invoice, such as net price." .

#################################################################
# Disjoint Unions
#################################################################

:OrganizationRole owl:disjointUnionOf ( :BuyerRole :SellerRole ) .

#################################################################
# Object Properties (with inverses)
#################################################################

:hasInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice" ;
    rdfs:comment "Relates an EDIFACT message to an invoice." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :Invoice ;
    owl:inverseOf :isInvoiceInMessage .

:isInvoiceInMessage a owl:ObjectProperty ;
    rdfs:label "is invoice in message" ;
    rdfs:comment "Inverse: Relates an invoice to the EDIFACT message containing it." ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessage .

:hasParticipation a owl:ObjectProperty ;
    rdfs:label "has participation" ;
    rdfs:comment "Relates an invoice to an invoice participation (organization in a role)." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceParticipation ;
    owl:inverseOf :isParticipationOfInvoice .

:isParticipationOfInvoice a owl:ObjectProperty ;
    rdfs:label "is participation of invoice" ;
    rdfs:comment "Inverse: Relates an invoice participation to the invoice it belongs to." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Invoice .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:label "involves organization" ;
    rdfs:comment "Relates an invoice participation to the involved organization." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Organization ;
    owl:inverseOf :isOrganizationInParticipation .

:isOrganizationInParticipation a owl:ObjectProperty ;
    rdfs:label "is organization in participation" ;
    rdfs:comment "Inverse: Relates an organization to an invoice participation." ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceParticipation .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates an invoice participation to an organization role." ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :OrganizationRole ;
    owl:inverseOf :isRoleOfParticipation .

:isRoleOfParticipation a owl:ObjectProperty ;
    rdfs:label "is role of participation" ;
    rdfs:comment "Inverse: Relates an organization role to an invoice participation." ;
    rdfs:domain :OrganizationRole ;
    rdfs:range :InvoiceParticipation .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an organization to its postal address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOfOrganization .

:isAddressOfOrganization a owl:ObjectProperty ;
    rdfs:label "is address of organization" ;
    rdfs:comment "Inverse: Relates an address to the organization it belongs to." ;
    rdfs:domain :Address ;
    rdfs:range :Organization .

:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Relates an invoice to its invoice items." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceItem ;
    owl:inverseOf :isItemOfInvoice .

:isItemOfInvoice a owl:ObjectProperty ;
    rdfs:label "is item of invoice" ;
    rdfs:comment "Inverse: Relates an invoice item to the invoice it is part of." ;
    rdfs:domain :InvoiceItem ;
    rdfs:range :Invoice .

:itemDetails a owl:ObjectProperty ;
    rdfs:label "item details" ;
    rdfs:comment "Relates an invoice item to its details (pivot class)." ;
    rdfs:domain :InvoiceItem ;
    rdfs:range :InvoiceItemDetail ;
    owl:inverseOf :isDetailOfItem .

:isDetailOfItem a owl:ObjectProperty ;
    rdfs:label "is detail of item" ;
    rdfs:comment "Inverse: Relates an invoice item detail to the invoice item." ;
    rdfs:domain :InvoiceItemDetail ;
    rdfs:range :InvoiceItem .

:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "describes item" ;
    rdfs:comment "Relates invoice item detail to the described item." ;
    rdfs:domain :InvoiceItemDetail ;
    rdfs:range :Item ;
    owl:inverseOf :isDescribedByDetail .

:isDescribedByDetail a owl:ObjectProperty ;
    rdfs:label "is described by detail" ;
    rdfs:comment "Inverse: Relates an item to the invoice item detail describing it." ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceItemDetail .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Relates an invoice to its detail information." ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceDetail ;
    owl:inverseOf :isDetailOfInvoice .

:isDetailOfInvoice a owl:ObjectProperty ;
    rdfs:label "is detail of invoice" ;
    rdfs:comment "Inverse: Relates an invoice detail to its invoice." ;
    rdfs:domain :InvoiceDetail ;
    rdfs:range :Invoice .

:hasBusinessProcess a owl:ObjectProperty ;
    rdfs:label "has business process" ;
    rdfs:comment "Relates an invoice to a business process." ;
    rdfs:domain :Invoice ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :isBusinessProcessOfInvoice .

:isBusinessProcessOfInvoice a owl:ObjectProperty ;
    rdfs:label "is business process of invoice" ;
    rdfs:comment "Inverse: Relates a business process to its invoice." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Invoice .

:hasEDIFACTSegment a owl:ObjectProperty ;
    rdfs:label "has EDIFACT segment" ;
    rdfs:comment "Relates an EDIFACT message to its segments." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :EDIFACTSegment ;
    owl:inverseOf :isSegmentOfMessage .

:isSegmentOfMessage a owl:ObjectProperty ;
    rdfs:label "is segment of message" ;
    rdfs:comment "Inverse: Relates an EDIFACT segment to the message it is part of." ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :EDIFACTMessage .

:hasEDIFACTElement a owl:ObjectProperty ;
    rdfs:label "has EDIFACT element" ;
    rdfs:comment "Relates an EDIFACT segment to its elements." ;
    rdfs:domain :EDIFACTSegment ;
    rdfs:range :EDIFACTElement ;
    owl:inverseOf :isElementOfSegment .

:isElementOfSegment a owl:ObjectProperty ;
    rdfs:label "is element of segment" ;
    rdfs:comment "Inverse: Relates an EDIFACT element to its segment." ;
    rdfs:domain :EDIFACTElement ;
    rdfs:range :EDIFACTSegment .

:hasEDIFACTCode a owl:ObjectProperty ;
    rdfs:label "has EDIFACT code" ;
    rdfs:comment "Relates an EDIFACT element to its code." ;
    rdfs:domain :EDIFACTElement ;
    rdfs:range :EDIFACTCode ;
    owl:inverseOf :isCodeOfElement .

:isCodeOfElement a owl:ObjectProperty ;
    rdfs:label "is code of element" ;
    rdfs:comment "Inverse: Relates a code to its EDIFACT element." ;
    rdfs:domain :EDIFACTCode ;
    rdfs:range :EDIFACTElement .

:hasFileFormatRequirement a owl:ObjectProperty ;
    rdfs:label "has file format requirement" ;
    rdfs:comment "Relates an EDIFACT message to its file format requirements." ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :FileFormatRequirement ;
    owl:inverseOf :isFileFormatRequirementOfMessage .

:isFileFormatRequirementOfMessage a owl:ObjectProperty ;
    rdfs:label "is file format requirement of message" ;
    rdfs:comment "Inverse: Relates a file format requirement to the EDIFACT message." ;
    rdfs:domain :FileFormatRequirement ;
    rdfs:range :EDIFACTMessage .

#################################################################
# Data Properties
#################################################################

:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has net price" ;
    rdfs:comment "Relates invoice item detail to its net price." ;
    rdfs:domain :InvoiceItemDetail ;
    rdfs:range xsd:decimal .

:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "Relates an invoice to its amount." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:decimal .

:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice number" ;
    rdfs:comment "Relates an invoice to its invoice number." ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:string .

#################################################################
# Restrictions and GCAs (refactored)
#################################################################
# Removed recursive equivalentClass definitions for BuyerRole and SellerRole to avoid P24.

#################################################################
# Annotations for EDIFACT Technical Vocabulary
#################################################################

# Example: UNH segment, BGM segment, etc. (add more as needed)
:UNH a :EDIFACTSegment ;
    rdfs:label "UNH Segment" ;
    rdfs:comment "Message header segment in EDIFACT." .

:BGM a :EDIFACTSegment ;
    rdfs:label "BGM Segment" ;
    rdfs:comment "Beginning of message segment in EDIFACT." .

:LIN a :EDIFACTSegment ;
    rdfs:label "LIN Segment" ;
    rdfs:comment "Line item segment in EDIFACT." .

:DTM a :EDIFACTSegment ;
    rdfs:label "DTM Segment" ;
    rdfs:comment "Date/time/period segment in EDIFACT." .

# Example EDIFACT element and code
:D_1001 a :EDIFACTElement ;
    rdfs:label "Document name code" ;
    rdfs:comment "EDIFACT element 1001: Document name code." .

:C_0020 a :EDIFACTElement ;
    rdfs:label "Document/message number" ;
    rdfs:comment "EDIFACT element 0020: Document/message number." .

:Code_380 a :EDIFACTCode ;
    rdfs:label "Invoice code 380" ;
    rdfs:comment "EDIFACT code 380: Commercial invoice." .

#################################################################
# File Format Requirements (example)
#################################################################
:MandatoryUNH a :FileFormatRequirement ;
    rdfs:label "Mandatory UNH Segment" ;
    rdfs:comment "The UNH segment is mandatory in a valid EDIFACT file." .
