ource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology for representing UN/EDIFACT invoice messages and participant roles, aligned with EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Header Section</rdfs:label>    <rdfs:comment>Header section of an invoice, contains dates and references.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasOrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has organization role assignment</rdfs:label>    <rdfs:comment>Links an invoice message to organization role assignments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>Composite element in a segment.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>Represents an invoice message in EDIFACT.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifierValue">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has identifier value</rdfs:label>    <rdfs:comment>Value of an identifier.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has message</rdfs:label>    <rdfs:comment>Links an interchange to its messages.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Interchange"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#partOfBusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>part of business process</rdfs:label>    <rdfs:comment>Links an invoice message to a business process.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has section</rdfs:label>    <rdfs:comment>Links an invoice message to its sections.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>Price information for an item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTaxAmount">    <