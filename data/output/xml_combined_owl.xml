 rdf:resource="http://www.example.org/ontology#Country"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#songRecordedBy">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>song recorded by</rdfs:label>    <rdfs:comment>Inverse: Relates a song to the track recording.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Song"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#TrackRecording"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#recordingOfSong"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#PerformanceSong">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Performance Song</rdfs:label>    <rdfs:comment>A reified relation linking a performance to songs performed.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#criticOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>critic of</rdfs:label>    <rdfs:comment>Relates a critic to an album they review.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Critic"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Album"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#albumCritic"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Role">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Role</rdfs:label>    <rdfs:comment>A function or position held by a person within a band.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Country">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Country</rdfs:label>    <rdfs:comment>A country containing regions.</rdfs:comment>  </rdf:Description></rdf:RDF>