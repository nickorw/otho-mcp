://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has reference number</rdfs:label>    <rdfs:comment>A reference number in the header section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>    <rdfs:label>has invoice date</rdfs:label>    <rdfs:comment>The date the invoice was issued.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a composite data element to its simple data elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A structured grouping of data elements in a message.</rdfs:comment>    <owl:disjointUnionOf rdf:nodeID="n7e1486bc09cf46ba83b289bf2e48ead5b1"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationInRoleInstance">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleInInvoice"/>    <rdfs:label>is organization in role instance</rdfs:label>    <rdfs:comment>Inverse of involvesOrganization: relates an organization to its role instances.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationRoleOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleInInvoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is organization role of</rdfs:label>    <rdfs:comment>Inverse of hasOrganizationRole: relates an organization role instance to its invoice message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#UNEDIFACTStory">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>An ontology representing the structure and semantics of UN/EDIFACT invoice messages for industrial procurement scenarios, aligned with EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an interchange envelope to its contained message(s).</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>    <rdfs:label>has document date</rdfs:label>    <rdfs:comment>The document date in the header section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Detail Section</rdfs:label>    <rdfs:comment>The segment listing individual line items with prices and quantities.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>The net price of an item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Summary Section</rdfs:label>    <rdfs:comment>The segment providing total tax and invoice amounts.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSimpleElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:label>is simple element of</rdfs:label>    <rdfs:comment>Inverse of hasSimpleElement: relates a simple element to its composite data element.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a message to its constituent segments.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse of hasSegment: relates a segment to its message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemOfDetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdfs:label>is item of detail section</rdfs:label>    <rdfs:comment>Inverse of hasItem: relates an item to its detail section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOfItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:label>is price of item</rdfs:label>    <rdfs:comment>Inverse of hasPrice: relates a price to its item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal or physical address associated with an organization in a specific role