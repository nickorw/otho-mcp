em">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:label>has item</rdfs:label>    <rdfs:comment>Relates a detail section to its items.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOfDetailSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>An atomic value in a segment or composite data element.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in the context of an invoice (e.g., Buyer, Seller, Delivery Party).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>An entity (company, partner, etc.) involved in a transaction.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>A monetary value assigned to an item in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOfRoleInstance">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleInInvoice"/>    <rdfs:label>is address of role instance</rdfs:label>    <rdfs:comment>Inverse of hasAddress: relates an address to its organization role instance.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n7e1486bc09cf46ba83b289bf2e48ead5b1">    <rdf:first rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdf:rest rdf:nodeID="n7e1486bc09cf46ba83b289bf2e48ead5b2"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleInInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role In Invoice</rdfs:label>    <rdfs:comment>A pivot class reifying the relationship between an organization, its role, and address in an invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The top-level envelope in an EDIFACT transmission, containing messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAssignedToBusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:label>is assigned to business process</rdfs:label>    <rdfs:comment>Assigns an invoice to a business process.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasAssignedInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasGLN">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has GLN</rdfs:label>    <rdfs:comment>The Global Location Number (GLN) for the organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service listed in an invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n7e1486bc09cf46ba83b289bf2e48ead5b2">    <rdf:first rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdf:rest rdf:nodeID="n7e1486bc09cf46ba83b289bf2e48ead5b3"/>  </rdf:Description></rdf:RDF>