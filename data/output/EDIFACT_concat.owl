@prefix : <http://example.org/edifact#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

:Cl_EDIFACTMessage rdf:type owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured message following the EDIFACT standard." .

:Cl_Invoice rdf:type owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice document, possibly contained within an EDIFACT message." .

:Cl_Document rdf:type owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A general document class, superclass for Invoice." .

:Cl_EDIFACTMessageDocumentListing rdf:type owl:Class ;
    rdfs:label "EDIFACT Message Document Listing" ;
    rdfs:comment "A pivot class representing the listing of documents (e.g., invoices) within an EDIFACT message." .

#################################################################
# Class Hierarchies
#################################################################

:Cl_Invoice rdfs:subClassOf :Cl_Document .

#################################################################
# Properties
#################################################################

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Relates an EDIFACT message to an invoice." .

:listsDocument rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageDocumentListing ;
    rdfs:range :Cl_Document ;
    rdfs:label "lists document" ;
    rdfs:comment "Relates an EDIFACT message document listing to a document (e.g., invoice) listed in the message." .

:forEDIFACTMessage rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageDocumentListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "for EDIFACT message" ;
    rdfs:comment "Indicates the EDIFACT message for which the document listing applies." .

:documentNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "document number" ;
    rdfs:comment "The identifier for an invoice." .

:issueDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "issue date" ;
    rdfs:comment "The date the invoice was issued." .

#################################################################
# Reification (Pivot Class for Complex Relation)
#################################################################

# The relationship "What invoices are all listed in an EDIFACT message?" involves an EDIFACT message and potentially multiple invoices.
# To support further extension (e.g., listing multiple types of documents, or additional attributes about the listing), we use a pivot class.

# For each EDIFACT message, there can exist one or more Cl_EDIFACTMessageDocumentListing instances,
# each of which connects the message to a Cl_Document (e.g., Cl_Invoice).

#################################################################
# Restrictions
#################################################################

:Cl_EDIFACTMessageDocumentListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :forEDIFACTMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ rdf:type owl:Restriction ; owl:onProperty :listsDocument ; owl:someValuesFrom :Cl_Document ]
    )
] .

#################################################################
# Disjointness
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_Document, :Cl_EDIFACTMessageDocumentListing .
:Cl_Invoice owl:disjointWith :Cl_EDIFACTMessageDocumentListing .

#################################################################
# Example Query Explanation
#################################################################

# To answer "What invoices are all listed in an EDIFACT message?"
# 1. Find all :Cl_EDIFACTMessageDocumentListing where :forEDIFACTMessage points to the message of interest.
# 2. For each such listing, retrieve :listsDocument, filter for those where the document is a :Cl_Invoice.

#################################################################
# End of Ontology
#################################################################
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Entity a owl:Class .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

### Hierarchies

# Cl_InvoiceParticipation as a pivot class for reification of the relationship between Cl_Invoice and Cl_Organization.

### Object Properties

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

### Inverse Properties

:hasInvoiceParticipation a owl:ObjectProperty ;
    owl:inverseOf :participatesInInvoice ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

### Restrictions

# Each Cl_InvoiceParticipation must involve exactly one Cl_Invoice and one Cl_Organization
:Cl_InvoiceParticipation a owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :involvesInvoice ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
              owl:onClass :Cl_Invoice
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :involvesOrganization ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
              owl:onClass :Cl_Organization
            ]
        )
    ] .

### Disjointness

:Cl_Organization owl:disjointWith :Cl_Invoice .
:Cl_Organization owl:disjointWith :Cl_InvoiceParticipation .
:Cl_Invoice owl:disjointWith :Cl_InvoiceParticipation .

### Example Individual (for illustration)

# :AcmeCorp a :Cl_Organization .
# :Invoice123 a :Cl_Invoice .
# :Participation1 a :Cl_InvoiceParticipation ;
#     :involvesOrganization :AcmeCorp ;
#     :involvesInvoice :Invoice123 .

### Query Explanation

# To answer "Which organizations are involved in the invoice?", query for all :Cl_Organization that are linked via :involvesOrganization from a :Cl_InvoiceParticipation, which in turn is linked to the target :Cl_Invoice via :involvesInvoice.
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Organization rdf:type owl:Class .
:Cl_Invoice rdf:type owl:Class .
:Cl_InvoiceRole rdf:type owl:Class .
:Cl_OrganizationInvoiceRole rdf:type owl:Class .

### Hierarchies

:Cl_OrganizationInvoiceRole rdfs:subClassOf owl:Thing .
:Cl_Organization rdfs:subClassOf owl:Thing .
:Cl_Invoice rdfs:subClassOf owl:Thing .
:Cl_InvoiceRole rdfs:subClassOf owl:Thing .

### Equivalent Classes, Disjointness, and General Class Axioms

# OrganizationInvoiceRole is a reification class for linking Organization, Invoice, and Role
:Cl_OrganizationInvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasOrganization ;
          owl:someValuesFrom :Cl_Organization
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoice ;
          owl:someValuesFrom :Cl_Invoice
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceRole ;
          owl:someValuesFrom :Cl_InvoiceRole
        ]
    )
] .

### Properties

# Object Properties
:hasOrganization rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_Organization .

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_Invoice .

:hasInvoiceRole rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_InvoiceRole .

# Inverse Properties
:isOrganizationInInvoiceRole rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvoiceRole .

:isInvoiceInOrganizationRole rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_OrganizationInvoiceRole .

:isRoleOfOrganizationInInvoice rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceRole ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_OrganizationInvoiceRole .

### Data Properties

:organizationName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:invoiceNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:roleName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string .

### Example Individuals (for illustration)

:OrgS rdf:type :Cl_Organization ;
    :organizationName "Organization S" .

:Invoice123 rdf:type :Cl_Invoice ;
    :invoiceNumber "INV-123" .

:SupplierRole rdf:type :Cl_InvoiceRole ;
    :roleName "Supplier" .

:OrgS_Supplier_Invoice123 rdf:type :Cl_OrganizationInvoiceRole ;
    :hasOrganization :OrgS ;
    :hasInvoice :Invoice123 ;
    :hasInvoiceRole :SupplierRole .

### Disjointness

:Cl_Organization owl:disjointWith :Cl_Invoice .
:Cl_Organization owl:disjointWith :Cl_InvoiceRole .
:Cl_Invoice owl:disjointWith :Cl_InvoiceRole .
:Cl_OrganizationInvoiceRole owl:disjointWith :Cl_Organization .
:Cl_OrganizationInvoiceRole owl:disjointWith :Cl_Invoice .
:Cl_OrganizationInvoiceRole owl:disjointWith :Cl_InvoiceRole .
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity such as a company, institution, or group." .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued by a seller to a buyer indicating products, quantities, and agreed prices." .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A reification class to represent the role of an organization in the context of an invoice." .

:Cl_InvoiceRoleType a owl:Class ;
    rdfs:label "Invoice Role Type" ;
    rdfs:comment "Types of roles that an organization can play in the context of an invoice." .

:Cl_BuyerRoleType a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Buyer Role Type" ;
    rdfs:comment "Role type indicating the buyer in an invoice." .

:Cl_SellerRoleType a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Seller Role Type" ;
    rdfs:comment "Role type indicating the seller in an invoice." .

:Cl_BuyerInvoiceRole a owl:Class ;
    rdfs:label "Buyer Invoice Role" ;
    rdfs:comment "The role instance representing the buyer in an invoice." .

#################################################################
# Class Hierarchies
#################################################################

:Cl_InvoiceRole rdfs:subClassOf owl:Thing .

:Cl_BuyerRoleType owl:disjointWith :Cl_SellerRoleType .

#################################################################
# Object Properties
#################################################################

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Links an invoice to a role played by an organization in the invoice." .

:roleOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "role organization" ;
    rdfs:comment "Links the invoice role to the organization playing the role." .

:roleType a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRoleType ;
    rdfs:label "role type" ;
    rdfs:comment "Specifies the type of the role (e.g., buyer, seller) in the invoice." .

#################################################################
# Restrictions
#################################################################

# Only organizations can play roles in invoices
:Cl_InvoiceRole rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :roleOrganization ;
    owl:allValuesFrom :Cl_Organization
] .

# An InvoiceRole with roleType BuyerRoleType is a BuyerInvoiceRole
:Cl_BuyerInvoiceRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ;
          owl:onProperty :roleType ;
          owl:hasValue :Cl_BuyerRoleType
        ]
    )
] .

#################################################################
# Disjointness
#################################################################

:Cl_BuyerRoleType owl:disjointWith :Cl_SellerRoleType .

#################################################################
# Example Query Pattern for the Competency Question
#################################################################

# To answer: "Which organization is the buyer in the invoice?"
# Find ?org where:
#   ?invoice :hasInvoiceRole ?role .
#   ?role :roleType :Cl_BuyerRoleType .
#   ?role :roleOrganization ?org .

#################################################################
# End of Ontology
#################################################################
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, institution, or group involved in the scenario." .

:Cl_OrganizationInformation a owl:Class ;
    rdfs:label "Organization Information" ;
    rdfs:comment "A reification class that represents information displayed about an organization." .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact details for an organization, such as email, phone, or address." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "The role played by an organization in the scenario (e.g., sponsor, partner, host)." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "A unique identifier for the organization (e.g., registration number, tax ID)." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "The geographical location or address of the organization." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A description or summary of the organization." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationDisplay a owl:Class ;
    rdfs:label "Organization Display" ;
    rdfs:comment "A reification class connecting an organization to the information displayed about it." .

### Class Hierarchies

:Cl_OrganizationInformation rdfs:subClassOf owl:Thing .
:Cl_OrganizationDisplay rdfs:subClassOf owl:Thing .

### Object Properties

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplay ;
    rdfs:range :Cl_Organization .

:displaysInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplay ;
    rdfs:range :Cl_OrganizationInformation .

:hasContactInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_ContactInformation ;
    rdfs:subPropertyOf :displaysInformation .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationRole ;
    rdfs:subPropertyOf :displaysInformation .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationIdentifier ;
    rdfs:subPropertyOf :displaysInformation .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationLocation ;
    rdfs:subPropertyOf :displaysInformation .

:hasDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationDescription ;
    rdfs:subPropertyOf :displaysInformation .

### Data Properties

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:contactAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string .

:locationAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range xsd:string .

### Restrictions

:Cl_OrganizationDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasOrganization ;
          owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ;
          owl:onProperty :displaysInformation ;
          owl:someValuesFrom :Cl_OrganizationInformation ]
    )
] .

### Disjointness

:Cl_ContactInformation owl:disjointWith :Cl_OrganizationRole, :Cl_OrganizationIdentifier, :Cl_OrganizationLocation, :Cl_OrganizationDescription .

:Cl_OrganizationInformation owl:disjointUnionOf (
    :Cl_ContactInformation
    :Cl_OrganizationRole
    :Cl_OrganizationIdentifier
    :Cl_OrganizationLocation
    :Cl_OrganizationDescription
) .
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes

:Cl_Entity a owl:Class .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_Address a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

### Disjointness

:Cl_Buyer owl:disjointWith :Cl_Address .

### Object Properties

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :isBuyerOfAssignment .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:inverseOf :isAddressOfAssignment .

:isBuyerOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:isAddressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment .

### Data Properties

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

### Restrictions

:Cl_BuyerAddressAssignment
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ;
              owl:onProperty :hasBuyer ;
              owl:cardinality "1"^^xsd:nonNegativeInteger ;
              owl:allValuesFrom :Cl_Buyer
            ]
            [ a owl:Restriction ;
              owl:onProperty :hasAddress ;
              owl:cardinality "1"^^xsd:nonNegativeInteger ;
              owl:allValuesFrom :Cl_Address
            ]
        )
    ] .

### Notes

# This ontology answers "What is the address of the buyer?" by using the pivot class Cl_BuyerAddressAssignment
# to associate each Cl_Buyer with a Cl_Address, allowing for extensibility and precise modeling.
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes

:Cl_Document a owl:Class .
:Cl_Invoice a owl:Class ; rdfs:subClassOf :Cl_Document .
:Cl_Item a owl:Class .
:Cl_Product a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_Service a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_InvoiceLine a owl:Class .   # Pivot class for reification of items on invoice

### Class Hierarchies

:Cl_Item rdfs:subClassOf owl:Thing .
:Cl_InvoiceLine rdfs:subClassOf owl:Thing .

### Disjointness

:Cl_Product owl:disjointWith :Cl_Service .

### Properties

# Object Properties

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:invoiceLineOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceLine .

# Data Properties

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

### Restrictions

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
    )
] .

# General Class Axiom: Invoice has some InvoiceLine

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

### Answering the Competency Question

# To answer "What items are sold in the invoice?", 
# traverse from :Cl_Invoice via :hasInvoiceLine to :Cl_InvoiceLine,
# then via :refersToItem to :Cl_Item (either :Cl_Product or :Cl_Service).
@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Item rdf:type owl:Class ;
    rdfs:label "Item" .

:Cl_Sale rdf:type owl:Class ;
    rdfs:label "Sale" .

:Cl_ItemInformation rdf:type owl:Class ;
    rdfs:label "Item Information" .

:Cl_DisplayInformation rdf:type owl:Class ;
    rdfs:label "Display Information" .

# Hierarchy: Information as superclass
:Cl_Information rdf:type owl:Class ;
    rdfs:label "Information" .

:Cl_ItemInformation rdfs:subClassOf :Cl_Information .
:Cl_DisplayInformation rdfs:subClassOf :Cl_Information .

### Reification / Pivot class for Displaying Item Information

:Cl_ItemDisplay rdf:type owl:Class ;
    rdfs:label "Item Display" .

### Disjointness
:Cl_Item owl:disjointWith :Cl_Information .
:Cl_Sale owl:disjointWith :Cl_Information .

### Properties

# Object Properties

:hasItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplay ;
    rdfs:range :Cl_Item ;
    rdfs:label "has item" .

:displaysInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplay ;
    rdfs:range :Cl_DisplayInformation ;
    rdfs:label "displays information" .

:hasDisplay rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemDisplay ;
    rdfs:label "has display" .

# Data Properties for Item Information

:itemName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item name" .

:itemDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item description" .

:itemPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price" .

:itemCategory rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item category" .

:itemSKU rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item SKU" .

:itemImageURL rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:anyURI ;
    rdfs:label "item image URL" .

# Data Properties for Display Information

:displayedField rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range xsd:string ;
    rdfs:label "displayed field" .

:displayOrder rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range xsd:integer ;
    rdfs:label "display order" .

:displayFormat rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range xsd:string ;
    rdfs:label "display format" .

### Relations between Item and Item Information

:hasItemInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemInformation ;
    rdfs:label "has item information" .

### Example Restriction: All displaysInformation must refer to Cl_DisplayInformation
:Cl_ItemDisplay rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :displaysInformation ;
    owl:allValuesFrom :Cl_DisplayInformation
] .

### General Class Axiom: If something hasItemInformation, it is an Item
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasItemInformation ;
    owl:someValuesFrom :Cl_ItemInformation ;
    rdfs:subClassOf :Cl_Item
] .

### Disjoint Union of Information subclasses
:Cl_Information owl:disjointUnionOf ( :Cl_ItemInformation :Cl_DisplayInformation ) .

@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Invoice rdf:type owl:Class .

:Cl_Item rdf:type owl:Class .

:Cl_InvoiceLine rdf:type owl:Class ;
    rdfs:subClassOf owl:Thing .

:Cl_NetPriceComputation rdf:type owl:Class ;
    rdfs:subClassOf owl:Thing .

### Class Hierarchies and Superclasses

:Cl_InvoiceEntity rdf:type owl:Class .

:Cl_Invoice rdfs:subClassOf :Cl_InvoiceEntity .
:Cl_Item rdfs:subClassOf :Cl_InvoiceEntity .
:Cl_InvoiceLine rdfs:subClassOf :Cl_InvoiceEntity .

### Reification / Pivot Class

# Cl_InvoiceLine acts as a pivot class to relate an Invoice, an Item, and the price/quantity details.

### Properties

# Object Properties

:hasInvoiceLine rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasNetPriceComputation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPriceComputation .

# Data Properties

:quantity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:lineNetPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:invoiceNetPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPriceComputation ;
    rdfs:range xsd:decimal .

# The net price of the invoice is computed via the Cl_NetPriceComputation pivot class, which aggregates the line net prices.

### Restrictions

# Each Cl_Invoice has only Cl_InvoiceLine as its hasInvoiceLine
:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:allValuesFrom :Cl_InvoiceLine
] .

# Each Cl_InvoiceLine refers only to Cl_Item
:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] .

# Each Cl_Invoice has only Cl_NetPriceComputation as its hasNetPriceComputation
:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPriceComputation ;
    owl:allValuesFrom :Cl_NetPriceComputation
] .

### Disjointness

:Cl_Invoice owl:disjointWith :Cl_Item, :Cl_InvoiceLine, :Cl_NetPriceComputation .
:Cl_Item owl:disjointWith :Cl_InvoiceLine, :Cl_NetPriceComputation .
:Cl_InvoiceLine owl:disjointWith :Cl_NetPriceComputation .

### Comments

# To answer "What is the net price of the items sold in the invoice?", query for :invoiceNetPrice via the :hasNetPriceComputation pivot from the relevant :Cl_Invoice. The net price at the invoice level is computed as the sum of :lineNetPrice for all :Cl_InvoiceLine entries associated with the invoice. Each :Cl_InvoiceLine also records its own :lineNetPrice (typically quantity * unitPrice).
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Invoice rdf:type owl:Class .
:Cl_InvoiceDetail rdf:type owl:Class .
:Cl_Product rdf:type owl:Class .
:Cl_Customer rdf:type owl:Class .
:Cl_Employee rdf:type owl:Class .
:Cl_InvoiceDetailEntry rdf:type owl:Class . # Pivot for reification: links Invoice, InvoiceDetail, Product, quantity, price

# Hierarchies
:Cl_Person rdf:type owl:Class .
:Cl_Customer rdfs:subClassOf :Cl_Person .
:Cl_Employee rdfs:subClassOf :Cl_Person .

### Properties

# Object Properties
:hasInvoiceDetail rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetailEntry .

:forInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailEntry ;
    rdfs:range :Cl_Invoice .

:hasProduct rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailEntry ;
    rdfs:range :Cl_Product .

:hasCustomer rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer .

:hasEmployee rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Employee .

# Data Properties
:invoiceNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:invoiceDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:totalAmount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal .

:detailQuantity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetailEntry ;
    rdfs:range xsd:integer .

:detailUnitPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetailEntry ;
    rdfs:range xsd:decimal .

:productName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:customerName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:employeeName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Employee ;
    rdfs:range xsd:string .

### Restrictions

# Cl_Invoice has only Cl_InvoiceDetailEntry as its invoice details
:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:allValuesFrom :Cl_InvoiceDetailEntry
] .

# Cl_InvoiceDetailEntry must be related to exactly one Cl_Invoice and one Cl_Product
:Cl_InvoiceDetailEntry owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :forInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasProduct ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :detailQuantity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :detailUnitPrice ; owl:minCardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

### Disjointness

:Cl_Customer owl:disjointWith :Cl_Employee .
:Cl_Product owl:disjointWith :Cl_Customer, :Cl_Employee .

### Inverse Properties

:hasInvoiceDetail owl:inverseOf :forInvoice .

### Comments

# :Cl_InvoiceDetailEntry acts as a pivot to capture the relation between Invoice, Product, quantity, and unit price for each entry in the invoice detail.
# Querying all :Cl_InvoiceDetailEntry for a given :Cl_Invoice provides the invoice details.
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes ###
:Cl_Document rdf:type owl:Class .
:Cl_Invoice rdf:type owl:Class ; rdfs:subClassOf :Cl_Document .
:Cl_InvoiceAmount rdf:type owl:Class .

### Hierarchies ###
:Cl_InvoiceData rdf:type owl:Class .
:Cl_InvoiceAmount rdfs:subClassOf :Cl_InvoiceData .

### Reification (Pivot Class) ###
:Cl_InvoiceAmountAssignment rdf:type owl:Class .
:Cl_InvoiceAmountAssignment rdfs:subClassOf :Cl_InvoiceData .

### Properties ###
:hasInvoiceAmountAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountAssignment .

:refersToInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice .

:refersToAmount rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount .

:amountValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal ;
    rdfs:label "The actual value of the invoice amount" .

### Restrictions ###
:Cl_InvoiceAmountAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :refersToAmount ; owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

### Disjointness ###
:Cl_Invoice owl:disjointWith :Cl_InvoiceAmount .
:Cl_InvoiceAmountAssignment owl:disjointWith :Cl_InvoiceAmount .

### Example Individual (optional, for illustration) ###
# :invoice123 a :Cl_Invoice .
# :amountAssignment123 a :Cl_InvoiceAmountAssignment ;
#     :refersToInvoice :invoice123 ;
#     :refersToAmount :amount456 .
# :amount456 a :Cl_InvoiceAmount ;
#     :amountValue "1000.00"^^xsd:decimal .
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes (with hierarchy)

:Cl_Document rdf:type owl:Class .

:Cl_Invoice rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_InvoiceIdentifier rdf:type owl:Class .

:Cl_InvoiceNumberAssignment rdf:type owl:Class .

### Disjointness

:Cl_InvoiceIdentifier owl:disjointWith :Cl_Invoice .
:Cl_InvoiceNumberAssignment owl:disjointWith :Cl_Invoice .
:Cl_InvoiceNumberAssignment owl:disjointWith :Cl_InvoiceIdentifier .

### Properties

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :isInvoiceNumberAssignmentOf .

:isInvoiceNumberAssignmentOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumberAssignment .

:hasInvoiceNumber rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_InvoiceIdentifier ;
    owl:inverseOf :isInvoiceNumberOfAssignment .

:isInvoiceNumberOfAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range :Cl_InvoiceNumberAssignment .

:invoiceNumberValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

### Restrictions and Class Axioms

# Every Invoice has at least one InvoiceNumberAssignment
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isInvoiceNumberAssignmentOf ;
    owl:someValuesFrom :Cl_InvoiceNumberAssignment
] .

# Every InvoiceNumberAssignment relates exactly one Invoice and one InvoiceIdentifier
:Cl_InvoiceNumberAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Every InvoiceNumberAssignment must have an Invoice and an InvoiceIdentifier
:Cl_InvoiceNumberAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:allValuesFrom :Cl_Invoice
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:allValuesFrom :Cl_InvoiceIdentifier
] .

# Optional: Equivalence for pivot class (not strictly necessary for answering the competency question)
#:Cl_InvoiceNumberAssignment owl:equivalentClass [
#    rdf:type owl:Class ;
#    owl:intersectionOf (
#        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
#        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
#    )
#] .

### Comment

# This ontology structure allows answering "What is the invoice number?" by traversing from a :Cl_Invoice to its :Cl_InvoiceNumberAssignment, then to the :Cl_InvoiceIdentifier, and finally retrieving the :invoiceNumberValue.
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#################################################################
# Classes
#################################################################

:Cl_FileFormat a owl:Class .
:Cl_FileComponent a owl:Class .
:Cl_ValidationRule a owl:Class .
:Cl_RequiredInformation a owl:Class .
:Cl_DataType a owl:Class .
:Cl_Constraint a owl:Class .
:Cl_ValidationRequirement a owl:Class . # Pivot class for reification
:Cl_InformationItem a owl:Class .
:Cl_FormatSpecification a owl:Class .
:Cl_ValueDomain a owl:Class .

# Hierarchies
:Cl_ValidationRule rdfs:subClassOf :Cl_FormatSpecification .
:Cl_RequiredInformation rdfs:subClassOf :Cl_FormatSpecification .
:Cl_Constraint rdfs:subClassOf :Cl_ValidationRule .
:Cl_DataType rdfs:subClassOf :Cl_FormatSpecification .
:Cl_InformationItem rdfs:subClassOf :Cl_RequiredInformation .
:Cl_ValueDomain rdfs:subClassOf :Cl_Constraint .

# Disjointness
:Cl_FileFormat owl:disjointWith :Cl_FileComponent, :Cl_ValidationRule, :Cl_RequiredInformation, :Cl_DataType, :Cl_Constraint, :Cl_ValidationRequirement, :Cl_InformationItem, :Cl_FormatSpecification, :Cl_ValueDomain .

#################################################################
# Object Properties
#################################################################

:hasComponent a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileComponent .

:hasValidationRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_ValidationRequirement .

:requiresInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_RequiredInformation .

:hasValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range :Cl_ValidationRule .

:requiresInformationItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range :Cl_InformationItem .

:constrains a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range :Cl_Constraint .

:appliesToComponent a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range :Cl_FileComponent .

:informationItemHasDataType a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationItem ;
    rdfs:range :Cl_DataType .

:informationItemHasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationItem ;
    rdfs:range :Cl_Constraint .

:constraintHasValueDomain a owl:ObjectProperty ;
    rdfs:domain :Cl_Constraint ;
    rdfs:range :Cl_ValueDomain .

#################################################################
# Data Properties
#################################################################

:componentName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileComponent ;
    rdfs:range xsd:string .

:informationItemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InformationItem ;
    rdfs:range xsd:string .

:datatypeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_DataType ;
    rdfs:range xsd:string .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Constraint ;
    rdfs:range xsd:string .

:valueDomainDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueDomain ;
    rdfs:range xsd:string .

:formatSpecificationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_FormatSpecification ;
    rdfs:range xsd:string .

#################################################################
# Restrictions and Axioms
#################################################################

# A file format is valid if all required information items are present and satisfy their constraints and data types.
:Cl_ValidationRequirement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
        [ rdf:type owl:Restriction ; owl:onProperty :requiresInformationItem ; owl:someValuesFrom :Cl_InformationItem ]
        [ rdf:type owl:Restriction ; owl:onProperty :appliesToComponent ; owl:someValuesFrom :Cl_FileComponent ]
    )
] .

:Cl_InformationItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :informationItemHasDataType ; owl:someValuesFrom :Cl_DataType ]
        [ rdf:type owl:Restriction ; owl:onProperty :informationItemHasConstraint ; owl:someValuesFrom :Cl_Constraint ]
    )
] .

#################################################################
# Example Individuals (optional, for illustration)
#################################################################

# :MyFileFormat a :Cl_FileFormat ;
#     :hasComponent :Header, :Body ;
#     :hasValidationRequirement :Req1 .

# :Header a :Cl_FileComponent ; :componentName "Header" .
# :Body a :Cl_FileComponent ; :componentName "Body" .

# :Req1 a :Cl_ValidationRequirement ;
#     :hasValidationRule :Rule1 ;
#     :requiresInformationItem :Info1 ;
#     :appliesToComponent :Header .

# :Rule1 a :Cl_ValidationRule ; :constrains :Constraint1 .
# :Info1 a :Cl_InformationItem ; :informationItemName "Version" ; :informationItemHasDataType :StringType ; :informationItemHasConstraint :Constraint1 .
# :StringType a :Cl_DataType ; :datatypeName "string" .
# :Constraint1 a :Cl_Constraint ; :constraintDescription "Must be non-empty" ; :constraintHasValueDomain :NonEmptyString .
# :NonEmptyString a :Cl_ValueDomain ; :valueDomainDescription "Any non-empty string" .

@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

:Cl_BusinessProcess rdf:type owl:Class .
:Cl_Invoice rdf:type owl:Class .
:Cl_Document rdf:type owl:Class .
:Cl_Assignment rdf:type owl:Class . # Reification class for assignment of invoice to business process

# Hierarchies
:Cl_Invoice rdfs:subClassOf :Cl_Document .
:Cl_Assignment rdfs:subClassOf owl:Thing .

# Disjointness
:Cl_Invoice owl:disjointWith :Cl_BusinessProcess .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment .
:Cl_Invoice owl:disjointWith :Cl_Assignment .
:Cl_Document owl:disjointWith :Cl_BusinessProcess .

#################################################################
# Properties
#################################################################

# Object Properties
:hasBusinessProcess rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_BusinessProcess .

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_Invoice .

:assignsInvoiceToBusinessProcess rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:subPropertyOf :hasBusinessProcess .

# Inverse Properties
:isAssignedToBusinessProcess rdf:type owl:ObjectProperty ;
    owl:inverseOf :assignsInvoiceToBusinessProcess ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Assignment .

:isAssignmentOfInvoice rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Assignment .

# Data Properties (for assignment metadata)
:assignmentDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime .

:assignmentStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:string .

#################################################################
# Restrictions and Axioms
#################################################################

# Every Cl_Assignment must be about one Cl_Invoice and one Cl_BusinessProcess
:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoice ;
          owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasBusinessProcess ;
          owl:allValuesFrom :Cl_BusinessProcess ]
    )
] .

# General class axiom: Every invoice can be assigned to at least one business process via assignment
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isAssignmentOfInvoice ;
    owl:someValuesFrom :Cl_Assignment
] .

# General class axiom: Every business process can have at least one invoice assigned via assignment
:Cl_BusinessProcess rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isAssignedToBusinessProcess ;
    owl:someValuesFrom :Cl_Assignment
] .

#################################################################
# Example Query Pattern (not part of ontology, just a note)
#################################################################
