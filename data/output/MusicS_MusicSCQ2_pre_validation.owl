@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology Metadata
:ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for modeling band memberships at specific points in time, addressing the competency question: 'What are the members of a certain band at a certain point in time?'" ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# Classes
# Top-level entity class
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "The most general class, representing any entity in the domain." .

# Hierarchies for Agent/Person
:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents any agent, living or otherwise, capable of action." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents a human individual." .

# Hierarchies for Organizations/Groups
:Cl_Organization rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a structured group of people." .

:Cl_MusicalGroup rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "Represents any group formed for musical performance." .

:Cl_Band rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalGroup ;
    rdfs:comment "Represents a specific type of musical group, typically playing contemporary music." .

# Class for Time Points
:Cl_TimePoint rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a specific, instantaneous point in time." .

# Reification Class: Cl_Membership
:Cl_Membership rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A pivot class representing the specific event or state of a person being a member of a band at a particular point in time." .

# Properties

# Data Properties
:hasName rdf:type owl:DatatypeProperty ;
    rdfs:comment "A general property for the name of an entity." .

:bandName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Band ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "The official name of the band." .

:personName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "The full name of the person." .

:dateTimeValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePoint ;
    rdfs:range xsd:dateTime ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "The precise date and time value for a Cl_TimePoint instance." .

# Object Properties (for Reification)
:hasMembershipEntry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Band ;
    rdfs:range :Cl_Membership ;
    rdfs:comment "Links a band to its individual membership entries." .

:memberOfBandEntry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_Band ;
    owl:inverseOf :hasMembershipEntry ;
    rdfs:comment "Links a membership entry to the band it pertains to." .

:memberIsPerson rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Links a membership entry to the specific person who is the member." .

:personIsMemberOfEntry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_Membership ;
    owl:inverseOf :memberIsPerson ;
    rdfs:comment "Links a person to the membership entries they are part of." .

:membershipValidAtTime rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_TimePoint ;
    rdfs:comment "Links a membership entry to the specific point in time at which it is valid." .

:timeValidatesMembership rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_TimePoint ;
    rdfs:range :Cl_Membership ;
    owl:inverseOf :membershipValidAtTime ;
    rdfs:comment "Links a time point to the membership entries that are valid at that time." .

# Restrictions/Axioms for Cl_Membership
# A Cl_Membership instance is defined by its association with a band, a person, and a time point.
# This ensures that every membership entry precisely captures these three aspects.
:Cl_Membership owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :memberOfBandEntry ;
          owl:someValuesFrom :Cl_Band
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :memberIsPerson ;
          owl:someValuesFrom :Cl_Person
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :membershipValidAtTime ;
          owl:someValuesFrom :Cl_TimePoint
        ]
    )
] .