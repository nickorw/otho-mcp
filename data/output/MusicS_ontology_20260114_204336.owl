@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "Ontology describing music production, band membership, albums, performances, and related entities as per the Red Hot Chili Peppers story." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in music production, performance, or criticism." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical group consisting of multiple persons." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by persons in performances or recordings." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or part played by a person in a band (e.g., vocalist, drummer)." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A published collection of tracks recorded by a band." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "An individual track that is part of an album and is a recording of a song." ;
    rdfs:subClassOf :Song .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition, which may be recorded as a track." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews or comments on albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live event where a band performs songs at a specific location and time." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances take place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographic region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reification class representing a person's membership in a band, with role and time interval." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "A reification class representing the recording of an album over a time interval." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "A reification class representing the performance of a song during a specific performance event." .

### Object Properties
:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Links a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :instrumentPlayedBy .

:instrumentPlayedBy a owl:ObjectProperty ;
    rdfs:label "instrument played by" ;
    rdfs:comment "Inverse property linking an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Relates a band to its band membership instances." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :membershipOfBand .

:membershipOfBand a owl:ObjectProperty ;
    rdfs:label "membership of band" ;
    rdfs:comment "Inverse property linking a band membership to the band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember .

:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "member person" ;
    rdfs:comment "Links a band membership to the person who is a member." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :personMembership .

:personMembership a owl:ObjectProperty ;
    rdfs:label "person membership" ;
    rdfs:comment "Inverse property linking a person to their band membership." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberPerson .

:memberRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "member role" ;
    rdfs:comment "Links a band membership to the role played by the person." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleOfMembership .

:roleOfMembership a owl:ObjectProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Inverse property linking a role to the band membership where it is played." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberRole .

:recordsAlbum a owl:ObjectProperty ;
    rdfs:label "records album" ;
    rdfs:comment "Relates a band to its album recording events." ;
    rdfs:domain :Band ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :albumRecordedBy .

:albumRecordedBy a owl:ObjectProperty ;
    rdfs:label "album recorded by" ;
    rdfs:comment "Inverse property linking an album recording to the band that recorded it." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Band ;
    owl:inverseOf :recordsAlbum .

:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Links an album recording event to the album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecording .

:albumRecording a owl:ObjectProperty ;
    rdfs:label "album recording" ;
    rdfs:comment "Inverse property linking an album to its recording events." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedAlbum .

:performanceOfBand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance of band" ;
    rdfs:comment "Links a performance event to the band performing." ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :bandPerformance .

:bandPerformance a owl:ObjectProperty ;
    rdfs:label "band performance" ;
    rdfs:comment "Inverse property linking a band to its performances." ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceOfBand .

:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "Links a performance to the city where it took place." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :locationOfPerformance .

:locationOfPerformance a owl:ObjectProperty ;
    rdfs:label "location of performance" ;
    rdfs:comment "Inverse property linking a city to performances held there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation .

:performanceSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance song" ;
    rdfs:comment "Links a performance song instance to the song performed." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformance .

:songPerformance a owl:ObjectProperty ;
    rdfs:label "song performance" ;
    rdfs:comment "Inverse property linking a song to its performance song events." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceSong .

:performanceEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance event" ;
    rdfs:comment "Links a performance song instance to the performance event." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :eventPerformanceSong .

:eventPerformanceSong a owl:ObjectProperty ;
    rdfs:label "event performance song" ;
    rdfs:comment "Inverse property linking a performance to its performance song instances." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceEvent .

:trackOfAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track of album" ;
    rdfs:comment "Links a track to the album it is part of." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :albumHasTrack .

:albumHasTrack a owl:ObjectProperty ;
    rdfs:label "album has track" ;
    rdfs:comment "Links an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfAlbum .

:trackIsRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track is recording of" ;
    rdfs:comment "Links a track to the song it is a recording of." ;
    rdfs:domain :Track ;
    rdfs:range :Song ;
    owl:inverseOf :recordedAsTrack .

:recordedAsTrack a owl:ObjectProperty ;
    rdfs:label "recorded as track" ;
    rdfs:comment "Inverse property linking a song to its track recordings." ;
    rdfs:domain :Song ;
    rdfs:range :Track ;
    owl:inverseOf :trackIsRecordingOf .

:criticSaysAbout a owl:ObjectProperty ;
    rdfs:label "critic says about" ;
    rdfs:comment "Links a critic to the album they comment on." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :albumCritic .

:albumCritic a owl:ObjectProperty ;
    rdfs:label "album critic" ;
    rdfs:comment "Inverse property linking an album to its critics." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :criticSaysAbout .

:cityInRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "city in region" ;
    rdfs:comment "Links a city to the region it is located in." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Inverse property linking a region to its cities." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :cityInRegion .

:regionInCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "region in country" ;
    rdfs:comment "Links a region to the country it is located in." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Inverse property linking a country to its regions." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :regionInCountry .

### Data Properties
:albumReleaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "album release date" ;
    rdfs:comment "The release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:albumTrackCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "album track count" ;
    rdfs:comment "The number of tracks in an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:integer .

:membershipStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "membership start date" ;
    rdfs:comment "The start date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:membershipEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "membership end date" ;
    rdfs:comment "The end date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording start date" ;
    rdfs:comment "Start date of an album recording event." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:recordingEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording end date" ;
    rdfs:comment "End date of an album recording event." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:songComposedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "song composed date" ;
    rdfs:comment "The date a song was composed." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "The date a performance took place." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

:criticStatement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critic statement" ;
    rdfs:comment "The statement a critic made about an album." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

### Restrictions and Axioms
# Album must have at least one track
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumHasTrack ; owl:someValuesFrom :Track ] .

# Disjointness axioms
:Person owl:disjointWith :Band, :Instrument, :Album, :Critic, :Performance, :City, :Region, :Country .
:Band owl:disjointWith :Instrument, :Album, :Critic, :Performance, :City, :Region, :Country .
:Instrument owl:disjointWith :Album, :Critic, :Performance, :City, :Region, :Country .
:Album owl:disjointWith :Critic, :Performance, :City, :Region, :Country .
:Critic owl:disjointWith :Performance, :City, :Region, :Country .
:Performance owl:disjointWith :City, :Region, :Country .
:City owl:disjointWith :Region, :Country .
:Region owl:disjointWith :Country .
