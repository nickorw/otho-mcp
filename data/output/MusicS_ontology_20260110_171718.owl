@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production> a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "An ontology describing music production, band membership, albums, tracks, performances, and related entities." .

#################################################################
# CLASSES
#################################################################
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in music production, performance, or critique." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A group of musicians performing together." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A musical or organizational role held by a person in a band." .

:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reified relation representing a person's membership and role in a band at a certain time." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A music album released by a band." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A track on a music album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition that may be recorded as a track." .

:CompositionEvent a owl:Class ;
    rdfs:label "Composition Event" ;
    rdfs:comment "An event representing the composition of a song at a specific date." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews or critiques music albums." .

:Critique a owl:Class ;
    rdfs:label "Critique" ;
    rdfs:comment "A reified relation representing a critic's textual review of an album." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live musical performance by a band at a specific place and time." .

:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A location where an event such as a performance takes place." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where a place is located." ;
    rdfs:subClassOf :Place .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A region containing cities and located in a country." ;
    rdfs:subClassOf :Place .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." ;
    rdfs:subClassOf :Place .

#################################################################
# OBJECT PROPERTIES
#################################################################
:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :playedBy .

:playedBy a owl:ObjectProperty ;
    rdfs:label "played by" ;
    rdfs:comment "Inverse property: Relates an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMember a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Relates a band to a band membership instance." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberOfBand .

:memberOfBand a owl:ObjectProperty ;
    rdfs:label "member of band" ;
    rdfs:comment "Inverse property: Relates a band membership to the band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember .

:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "member person" ;
    rdfs:comment "Relates a band membership to the person who is a member." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :personMembership .

:personMembership a owl:ObjectProperty ;
    rdfs:label "person membership" ;
    rdfs:comment "Inverse property: Relates a person to their band memberships." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberPerson .

:memberRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "member role" ;
    rdfs:comment "Relates a band membership to the role held by the member." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleMembership .

:roleMembership a owl:ObjectProperty ;
    rdfs:label "role membership" ;
    rdfs:comment "Inverse property: Relates a role to the band memberships in which it is held." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberRole .

:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates a band to an album they recorded." ;
    rdfs:domain :Band ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecordedBy .

:albumRecordedBy a owl:ObjectProperty ;
    rdfs:label "album recorded by" ;
    rdfs:comment "Inverse property: Relates an album to the band that recorded it." ;
    rdfs:domain :Album ;
    rdfs:range :Band ;
    owl:inverseOf :recordedAlbum .

:hasTrack a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has track" ;
    rdfs:comment "Relates an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfAlbum .

:trackOfAlbum a owl:ObjectProperty ;
    rdfs:label "track of album" ;
    rdfs:comment "Inverse property: Relates a track to the album it is part of." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :hasTrack .

:trackSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track song" ;
    rdfs:comment "Relates a track to the song it records." ;
    rdfs:domain :Track ;
    rdfs:range :Song ;
    owl:inverseOf :songRecordedAsTrack .

:songRecordedAsTrack a owl:ObjectProperty ;
    rdfs:label "song recorded as track" ;
    rdfs:comment "Inverse property: Relates a song to tracks that record it." ;
    rdfs:domain :Song ;
    rdfs:range :Track ;
    owl:inverseOf :trackSong .

:compositionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "composition of" ;
    rdfs:comment "Relates a composition event to the song composed." ;
    rdfs:domain :CompositionEvent ;
    rdfs:range :Song ;
    owl:inverseOf :composedThroughEvent .

:composedThroughEvent a owl:ObjectProperty ;
    rdfs:label "composed through event" ;
    rdfs:comment "Inverse property: Relates a song to its composition event." ;
    rdfs:domain :Song ;
    rdfs:range :CompositionEvent ;
    owl:inverseOf :compositionOf .

:hasCritique a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has critique" ;
    rdfs:comment "Relates an album to a critique instance." ;
    rdfs:domain :Album ;
    rdfs:range :Critique ;
    owl:inverseOf :critiqueOfAlbum .

:critiqueOfAlbum a owl:ObjectProperty ;
    rdfs:label "critique of album" ;
    rdfs:comment "Inverse property: Relates a critique to the album it critiques." ;
    rdfs:domain :Critique ;
    rdfs:range :Album ;
    owl:inverseOf :hasCritique .

:critiqueBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "critique by" ;
    rdfs:comment "Relates a critique to the critic who authored it." ;
    rdfs:domain :Critique ;
    rdfs:range :Critic ;
    owl:inverseOf :authorOfCritique .

:authorOfCritique a owl:ObjectProperty ;
    rdfs:label "author of critique" ;
    rdfs:comment "Inverse property: Relates a critic to critiques they authored." ;
    rdfs:domain :Critic ;
    rdfs:range :Critique ;
    owl:inverseOf :critiqueBy .

:performanceOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Relates a performance to the band performing." ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :bandPerformance .

:bandPerformance a owl:ObjectProperty ;
    rdfs:label "band performance" ;
    rdfs:comment "Inverse property: Relates a band to its performances." ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceOf .

:performedSong a owl:ObjectProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Relates a performance to songs performed." ;
    rdfs:domain :Performance ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformedIn .

:songPerformedIn a owl:ObjectProperty ;
    rdfs:label "song performed in" ;
    rdfs:comment "Inverse property: Relates a song to performances it was performed in." ;
    rdfs:domain :Song ;
    rdfs:range :Performance ;
    owl:inverseOf :performedSong .

:performancePlace a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance place" ;
    rdfs:comment "Relates a performance to the place it occurs." ;
    rdfs:domain :Performance ;
    rdfs:range :Place ;
    owl:inverseOf :placeOfPerformance .

:placeOfPerformance a owl:ObjectProperty ;
    rdfs:label "place of performance" ;
    rdfs:comment "Inverse property: Relates a place to performances that occurred there." ;
    rdfs:domain :Place ;
    rdfs:range :Performance ;
    owl:inverseOf :performancePlace .

:locatedInRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "located in region" ;
    rdfs:comment "Relates a city to the region it is located in." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Inverse property: Relates a region to cities it contains." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :locatedInRegion .

:locatedInCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "located in country" ;
    rdfs:comment "Relates a region to the country it is located in." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Inverse property: Relates a country to regions it contains." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :locatedInCountry .

#################################################################
# DATA PROPERTIES
#################################################################
:membershipTime a owl:DatatypeProperty ;
    rdfs:label "membership time" ;
    rdfs:comment "The time period of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStart a owl:DatatypeProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "The date when recording of an album started." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:recordingEnd a owl:DatatypeProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "The date when recording of an album ended." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:releaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "release date" ;
    rdfs:comment "The release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:date .

:trackCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "track count" ;
    rdfs:comment "The number of tracks on an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:integer .

:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "composed on" ;
    rdfs:comment "The date a song was composed." ;
    rdfs:domain :CompositionEvent ;
    rdfs:range xsd:date .

:critiqueText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critique text" ;
    rdfs:comment "The textual content of a critique." ;
    rdfs:domain :Critique ;
    rdfs:range xsd:string .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "The date of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:date .

#################################################################
# AXIOMS & RESTRICTIONS
#################################################################
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:someValuesFrom :Track ] .
:Album owl:equivalentClass [ a owl:Restriction ; owl:onProperty :trackCount ; owl:allValuesFrom xsd:integer ] .

:City owl:disjointWith :Region .
:Region owl:disjointWith :Country .
:Person owl:disjointWith :Band .
:Instrument owl:disjointWith :Role .
:Album owl:disjointWith :Track .
:Song owl:disjointWith :Track .
:Critic owl:disjointWith :Person .
:Place owl:disjointWith :Performance .
