@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Document a owl:Class .
:Cl_Invoice a owl:Class ; rdfs:subClassOf :Cl_Document .
:Cl_Item a owl:Class .
:Cl_Product a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_Service a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_InvoiceLine a owl:Class .   # Pivot class for reification of items on invoice

### Class Hierarchies

:Cl_Item rdfs:subClassOf owl:Thing .
:Cl_InvoiceLine rdfs:subClassOf owl:Thing .

### Disjointness

:Cl_Product owl:disjointWith :Cl_Service .

### Properties

# Object Properties

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:invoiceLineOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceLine .

# Data Properties

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

# Restrictions

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
    )
] .

# General Class Axiom: Invoice has some InvoiceLine

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

### Answering the Competency Question

# To answer "What items are sold in the invoice?", 
# traverse from :Cl_Invoice via :hasInvoiceLine to :Cl_InvoiceLine,
# then via :refersToItem to :Cl_Item (either :Cl_Product or :Cl_Service).

# Example (not requested, but for clarity):
# ?invoice :hasInvoiceLine ?line .
# ?line :refersToItem ?item .
# ?item a :Cl_Item .
