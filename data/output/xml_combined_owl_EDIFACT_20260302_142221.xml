<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns="http://www.example.org/ontology#"   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>An itemized entry in the invoice detail section.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or good referenced in the invoice.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail</rdfs:label>    <rdfs:comment>Detail section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#EN16931Alignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>EN 16931 Alignment</rdfs:label>    <rdfs:comment>Alignment to EN 16931-1 semantic model.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#P2POAlignment"/>    <alignsWith rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceSummary">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Summary</rdfs:label>    <rdfs:comment>Summary section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment within an EDIFACT message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BGMSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>BGM Segment</rdfs:label>    <rdfs:comment>Beginning of Message segment for document identification.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#TAXSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>TAX Segment</rdfs:label>    <rdfs:comment>Tax segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>A legal entity involved in the transaction.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#ValidationConstraint"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#RoleAssignment"/>    <hasAddress rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The top-level envelope containing one or more EDIFACT messages.</rdfs:comment>    <containsMessage rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LINSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>LIN Segment</rdfs:label>    <rdfs:comment>Line Item segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#ReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Reference Number</rdfs:label>    <rdfs:comment>A reference number for the invoice or related documents.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#PRISegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>PRI Segment</rdfs:label>    <rdfs:comment>Price segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CUXSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>CUX Segment</rdfs:label>    <rdfs:comment>Currency segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#MOASegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>MOA Segment</rdfs:label>    <rdfs:comment>Monetary Amount segment. Contains qualifier and amount value.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element within a composite or segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#NADSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>NAD Segment</rdfs:label>    <rdfs:comment>Name and Address segment for participant details.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#RFFSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>RFF Segment</rdfs:label>    <rdfs:comment>Reference segment for reference numbers.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DTMSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>DTM Segment</rdfs:label>    <rdfs:comment>Date/Time/Period segment. Contains qualifier and value.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#UNSSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>UNS Segment</rdfs:label>    <rdfs:comment>Section control segment (header/detail/summary separator).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#RoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Role Assignment</rdfs:label>    <rdfs:comment>A reified relationship linking an organization to a role in the invoice context.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>    <hasAgentRole rdf:resource="http://www.example.org/ontology#AgentRole"/>    <hasParticipant rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#ValidationConstraint">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Validation Constraint</rdfs:label>    <rdfs:comment>A constraint for validation, e.g., SHACL shape.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>    <validates rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Header</rdfs:label>    <rdfs:comment>Header section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#QTYSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>QTY Segment</rdfs:label>    <rdfs:comment>Quantity segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#storyid">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT D96A Invoice Ontology</rdfs:label>    <rdfs:comment>A profoundly structured OWL2 ontology for UN/EDIFACT D96A Invoice (INVOIC) messages, supporting EN 16931-1 and P2P-O alignment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A generic EDIFACT message.</rdfs:comment>    <hasSegment rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal or physical address.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization (e.g., Buyer, Supplier, Delivery Party).</rdfs:comment>    <assignedTo rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>A price associated with an item or invoice.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#P2POAlignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>P2P-O Alignment</rdfs:label>    <rdfs:comment>Alignment to Purchase-to-Pay Ontology (P2P-O).</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#EN16931Alignment"/>    <alignsWith rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#GLNIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>GLN Identifier</rdfs:label>    <rdfs:comment>A Global Location Number identifier.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>An EDIFACT INVOIC message, a subclass of Message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LOCSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>LOC Segment</rdfs:label>    <rdfs:comment>Location segment for delivery or other locations.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process such as Purchase-to-Pay.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>    <processes rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Tax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Tax</rdfs:label>    <rdfs:comment>A tax applied to the invoice or line item.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description></rdf:RDF>