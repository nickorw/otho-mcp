@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/recordontology#> .

# Ontology Declaration
:recordOntology rdf:type owl:Ontology ;
    owl:versionIRI :recordOntology-1.0 ;
    rdfs:comment "An ontology for modeling musical records and tracks, focusing on their composition."@en .

# Classes
:Cl_Record rdf:type owl:Class ;
    rdfs:label "Record" ;
    rdfs:comment "Represents a musical record, album, or compilation." .

:Cl_Track rdf:type owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "Represents an individual musical track or song." .

# Properties
:hasTrack rdf:type owl:ObjectProperty ;
    rdfs:label "has track" ;
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_Track ;
    rdfs:comment "Relates a record to its constituent tracks." .

# Competency Question: "A record always contains at least one track."
# This is modeled by asserting that Cl_Record is a subclass of a restriction
# stating that every instance of Cl_Record must have at least one value for the hasTrack property.
:Cl_Record rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTrack ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:label "Every record must have at least one track" ;
    rdfs:comment "This restriction ensures that any instance classified as Cl_Record must be associated with at least one Cl_Track via the hasTrack property."
] .