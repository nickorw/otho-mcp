@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production-story>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "Ontology describing music production, band membership, album recording, and related entities as per the Red Hot Chili Peppers story." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in music production." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical band or group." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role or function a person can have in a band (e.g. vocalist, guitarist)." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A music album released by a band." ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :containsTrack ;
        owl:someValuesFrom :Track
    ] .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A track contained in an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews or critiques music albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live music performance event." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances can take place." ;
    rdfs:subClassOf :Place .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A region containing cities." ;
    rdfs:subClassOf :Place .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." ;
    rdfs:subClassOf :Place .

:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A general location class for places such as City, Region, Country." ;
    owl:disjointUnionOf ( :City :Region :Country ) .

### Pivot Classes (Reification)
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A membership of a person in a band, with role and time information." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "The recording of an album with start and end dates." .

:TrackSongRelation a owl:Class ;
    rdfs:label "Track Song Relation" ;
    rdfs:comment "Reifies the relation between a track and the song it is a recording of." .

:AlbumCritique a owl:Class ;
    rdfs:label "Album Critique" ;
    rdfs:comment "A critique by a critic about an album, including the statement." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "Reifies the relation between a performance and a song played." .

:PerformanceLocation a owl:Class ;
    rdfs:label "Performance Location" ;
    rdfs:comment "Reifies the relation between a performance and its city location." .

### Disjointness
:Person owl:disjointWith :Instrument, :Band, :Critic .
:Band owl:disjointWith :Instrument, :Critic .
:Instrument owl:disjointWith :Role .
:Role owl:disjointWith :Instrument .
:Album owl:disjointWith :Track, :Song, :Performance .
:Track owl:disjointWith :Album, :Song .
:Song owl:disjointWith :Track, :Album .
:Performance owl:disjointWith :Album .
:City owl:disjointWith :Region, :Country .
:Region owl:disjointWith :Country .

### Object Properties and Inverses
:playsInstrument a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to the instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :playedBy .
:playedBy a owl:ObjectProperty ;
    rdfs:label "played by" ;
    rdfs:comment "Inverse of playsInstrument: relates instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMembership a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label "has membership" ;
    rdfs:comment "Links a person to their band membership (BandMembership pivot)." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :membershipOf .
:membershipOf a owl:ObjectProperty ;
    rdfs:label "membership of" ;
    rdfs:comment "Inverse of hasMembership: links BandMembership to the Person." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasMembership .

:membershipInBand a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "membership in band" ;
    rdfs:comment "Links a BandMembership to the Band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember .
:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Inverse of membershipInBand: links Band to BandMembership." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :membershipInBand .

:hasRole a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Links a BandMembership to a Role." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleOf .
:roleOf a owl:ObjectProperty ;
    rdfs:label "role of" ;
    rdfs:comment "Inverse of hasRole: links Role to BandMembership." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :hasRole .

:recordsAlbum a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label "records album" ;
    rdfs:comment "Links a Band to the AlbumRecording." ;
    rdfs:domain :Band ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedBy .
:recordedBy a owl:ObjectProperty ;
    rdfs:label "recorded by" ;
    rdfs:comment "Inverse of recordsAlbum: links AlbumRecording to Band." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Band ;
    owl:inverseOf :recordsAlbum .

:recordedAlbum a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Links AlbumRecording to the Album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecording .
:albumRecording a owl:ObjectProperty ;
    rdfs:label "album recording" ;
    rdfs:comment "Inverse of recordedAlbum: links Album to AlbumRecording." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedAlbum .

:containsTrack a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label "contains track" ;
    rdfs:comment "Links Album to Track." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOf .
:trackOf a owl:ObjectProperty ;
    rdfs:label "track of" ;
    rdfs:comment "Inverse of containsTrack: links Track to Album." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :containsTrack .

:isRecordingOf a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "is recording of" ;
    rdfs:comment "Links TrackSongRelation to the Song." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Song ;
    owl:inverseOf :hasRecording .
:hasRecording a owl:ObjectProperty ;
    rdfs:label "has recording" ;
    rdfs:comment "Inverse of isRecordingOf: links Song to TrackSongRelation." ;
    rdfs:domain :Song ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :isRecordingOf .

:track a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "track" ;
    rdfs:comment "Links TrackSongRelation to the Track." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Track ;
    owl:inverseOf :isTrackRelationOf .
:isTrackRelationOf a owl:ObjectProperty ;
    rdfs:label "is track relation of" ;
    rdfs:comment "Inverse of track: links Track to TrackSongRelation." ;
    rdfs:domain :Track ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :track .

:criticizesAlbum a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "criticizes album" ;
    rdfs:comment "Links AlbumCritique to the Album." ;
    rdfs:domain :AlbumCritique ;
    rdfs:range :Album ;
    owl:inverseOf :hasCritique .
:hasCritique a owl:ObjectProperty ;
    rdfs:label "has critique" ;
    rdfs:comment "Inverse of criticizesAlbum: links Album to AlbumCritique." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumCritique ;
    owl:inverseOf :criticizesAlbum .

:byCritic a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "by critic" ;
    rdfs:comment "Links AlbumCritique to the Critic." ;
    rdfs:domain :AlbumCritique ;
    rdfs:range :Critic ;
    owl:inverseOf :hasCritiqueBy .
:hasCritiqueBy a owl:ObjectProperty ;
    rdfs:label "has critique by" ;
    rdfs:comment "Inverse of byCritic: links Critic to AlbumCritique." ;
    rdfs:domain :Critic ;
    rdfs:range :AlbumCritique ;
    owl:inverseOf :byCritic .

:performanceSong a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "performance song" ;
    rdfs:comment "Links PerformanceSong to the Song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :isPerformanceSongOf .
:isPerformanceSongOf a owl:ObjectProperty ;
    rdfs:label "is performance song of" ;
    rdfs:comment "Inverse of performanceSong: links Song to PerformanceSong." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceSong .

:performance a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "performance" ;
    rdfs:comment "Links PerformanceSong to the Performance." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceSong .
:hasPerformanceSong a owl:ObjectProperty ;
    rdfs:label "has performance song" ;
    rdfs:comment "Inverse of performance: links Performance to PerformanceSong." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performance .

:performedIn a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "performed in" ;
    rdfs:comment "Links PerformanceLocation to the Performance." ;
    rdfs:domain :PerformanceLocation ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceLocation .
:hasPerformanceLocation a owl:ObjectProperty ;
    rdfs:label "has performance location" ;
    rdfs:comment "Inverse of performedIn: links Performance to PerformanceLocation." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceLocation ;
    owl:inverseOf :performedIn .

:locationCity a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "location city" ;
    rdfs:comment "Links PerformanceLocation to the City." ;
    rdfs:domain :PerformanceLocation ;
    rdfs:range :City ;
    owl:inverseOf :cityOfPerformance .
:cityOfPerformance a owl:ObjectProperty ;
    rdfs:label "city of performance" ;
    rdfs:comment "Inverse of locationCity: links City to PerformanceLocation." ;
    rdfs:domain :City ;
    rdfs:range :PerformanceLocation ;
    owl:inverseOf :locationCity .

:inRegion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "in region" ;
    rdfs:comment "Links City to Region." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :hasCity .
:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Inverse of inRegion: links Region to City." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :inRegion .

:inCountry a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "in country" ;
    rdfs:comment "Links Region to Country." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :hasRegion .
:hasRegion a owl:ObjectProperty ;
    rdfs:label "has region" ;
    rdfs:comment "Inverse of inCountry: links Country to Region." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :inCountry .

:hasPlace a owl:ObjectProperty ;
    rdfs:label "has place" ;
    rdfs:comment "Relates any entity (e.g., Performance, Band, Album, etc.) to a Place (City, Region, or Country)." ;
    rdfs:domain owl:Thing ;
    rdfs:range :Place ;
    owl:inverseOf :isPlaceOf .
:isPlaceOf a owl:ObjectProperty ;
    rdfs:label "is place of" ;
    rdfs:comment "Inverse of hasPlace: relates Place to any entity it is a place for." ;
    rdfs:domain :Place ;
    rdfs:range owl:Thing ;
    owl:inverseOf :hasPlace .

### Data Properties
:trackCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "track count" ;
    rdfs:comment "The number of tracks in an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:integer .

:membershipStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "Start date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:membershipEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "End date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date of an album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:recordingEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "End date of an album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:releasedOn a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "released on" ;
    rdfs:comment "Release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:composedOn a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "composed on" ;
    rdfs:comment "Composition date of a song." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:critiqueStatement a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "critique statement" ;
    rdfs:comment "Text of a critique about an album." ;
    rdfs:domain :AlbumCritique ;
    rdfs:range xsd:string .

:performedOn a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "performed on" ;
    rdfs:comment "Date of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .
