@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

:HospitalStoryOntology rdf:type owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "Ontology for hospital staff, unions, degrees, employment, articles, seminars, and evaluations as described in the provided story." .

### Classes
:Person rdf:type owl:Class ; rdfs:label "Person" ; rdfs:comment "A human involved in the hospital context." .
:Doctor rdf:type owl:Class ; rdfs:label "Doctor" ; rdfs:comment "A medical doctor." ; rdfs:subClassOf :Person .
:Nurse rdf:type owl:Class ; rdfs:label "Nurse" ; rdfs:comment "A nurse working in the hospital." ; rdfs:subClassOf :Person .
:NursingAssistant rdf:type owl:Class ; rdfs:label "Nursing Assistant" ; rdfs:comment "A person trained as a nursing assistant." ; rdfs:subClassOf :Nurse .
:CertifiedNurse rdf:type owl:Class ; rdfs:label "Certified Nurse" ; rdfs:comment "A nurse with a certification." ; rdfs:subClassOf :Nurse .
:Staff rdf:type owl:Class ; rdfs:label "Staff" ; rdfs:comment "Hospital staff member." ; rdfs:subClassOf :Person .
:Degree rdf:type owl:Class ; rdfs:label "Degree" ; rdfs:comment "A medical degree or certification." .
:StudyPeriod rdf:type owl:Class ; rdfs:label "Study Period" ; rdfs:comment "A period during which a person studies for a degree." .
:Employment rdf:type owl:Class ; rdfs:label "Employment" ; rdfs:comment "A period of employment at a hospital." .
:Hospital rdf:type owl:Class ; rdfs:label "Hospital" ; rdfs:comment "A hospital where people work and seminars are held." .
:City rdf:type owl:Class ; rdfs:label "City" ; rdfs:comment "A city where hospitals are located." .
:Country rdf:type owl:Class ; rdfs:label "Country" ; rdfs:comment "A country where cities are located." .
:Union rdf:type owl:Class ; rdfs:label "Union" ; rdfs:comment "A union organizing hospital staff." .
:UnionMembership rdf:type owl:Class ; rdfs:label "Union Membership" ; rdfs:comment "A person's membership in a union during a time period." .
:UnionRole rdf:type owl:Class ; rdfs:label "Union Role" ; rdfs:comment "A role held by a person within a union." .
:EmployeeEvaluation rdf:type owl:Class ; rdfs:label "Employee Evaluation" ; rdfs:comment "A written evaluation by a doctor for an employee." .
:Article rdf:type owl:Class ; rdfs:label "Article" ; rdfs:comment "A research article." .
:ArticleCollection rdf:type owl:Class ; rdfs:label "Article Collection" ; rdfs:comment "A collection of articles, available as books or CDs." .
:Book rdf:type owl:Class ; rdfs:label "Book" ; rdfs:comment "A book containing articles." ; rdfs:subClassOf :ArticleCollection .
:CD rdf:type owl:Class ; rdfs:label "CD" ; rdfs:comment "A CD containing articles." ; rdfs:subClassOf :ArticleCollection .
:Seminar rdf:type owl:Class ; rdfs:label "Seminar" ; rdfs:comment "A seminar held at a hospital for presenting articles." .
:SeminarPresentation rdf:type owl:Class ; rdfs:label "Seminar Presentation" ; rdfs:comment "A presentation of an article at a seminar." .

### Disjointness
:Doctor owl:disjointWith :Nurse .
:Book owl:disjointWith :CD .

### DisjointUnion
:Nurse owl:disjointUnionOf (:NursingAssistant :CertifiedNurse) .

### Object Properties with Inverses
:hasDegree rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has degree" ; rdfs:comment "Relates a person to a degree." ;
    rdfs:domain :Person ; rdfs:range :Degree ;
    owl:inverseOf :degreeOf .
:degreeOf rdf:type owl:ObjectProperty ;
    rdfs:label "degree of" ; rdfs:comment "Inverse: relates a degree to the person who holds it." ;
    rdfs:domain :Degree ; rdfs:range :Person ;
    owl:inverseOf :hasDegree .

:studiedDuring rdf:type owl:ObjectProperty ;
    rdfs:label "studied during" ; rdfs:comment "Relates a person to the study period for a degree." ;
    rdfs:domain :Person ; rdfs:range :StudyPeriod ;
    owl:inverseOf :studyPeriodOf .
:studyPeriodOf rdf:type owl:ObjectProperty ;
    rdfs:label "study period of" ; rdfs:comment "Inverse: relates a study period to the person." ;
    rdfs:domain :StudyPeriod ; rdfs:range :Person ;
    owl:inverseOf :studiedDuring .

:forDegree rdf:type owl:ObjectProperty ;
    rdfs:label "for degree" ; rdfs:comment "Relates a study period to a degree." ;
    rdfs:domain :StudyPeriod ; rdfs:range :Degree ;
    owl:inverseOf :degreeStudyPeriod .
:degreeStudyPeriod rdf:type owl:ObjectProperty ;
    rdfs:label "degree study period" ; rdfs:comment "Inverse: relates a degree to a study period." ;
    rdfs:domain :Degree ; rdfs:range :StudyPeriod ;
    owl:inverseOf :forDegree .

:employmentOf rdf:type owl:ObjectProperty ;
    rdfs:label "employment of" ; rdfs:comment "Relates a person to their employment." ;
    rdfs:domain :Person ; rdfs:range :Employment ;
    owl:inverseOf :employedPerson .
:employedPerson rdf:type owl:ObjectProperty ;
    rdfs:label "employed person" ; rdfs:comment "Inverse: relates employment to person." ;
    rdfs:domain :Employment ; rdfs:range :Person ;
    owl:inverseOf :employmentOf .

:employedAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employed at" ; rdfs:comment "Relates an employment to a hospital." ;
    rdfs:domain :Employment ; rdfs:range :Hospital ;
    owl:inverseOf :employs .
:employs rdf:type owl:ObjectProperty ;
    rdfs:label "employs" ; rdfs:comment "Inverse: relates a hospital to employment." ;
    rdfs:domain :Hospital ; rdfs:range :Employment ;
    owl:inverseOf :employedAt .

:locatedIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "located in" ; rdfs:comment "Relates a hospital to a city." ;
    rdfs:domain :Hospital ; rdfs:range :City ;
    owl:inverseOf :hasHospital .
:hasHospital rdf:type owl:ObjectProperty ;
    rdfs:label "has hospital" ; rdfs:comment "Inverse: relates a city to a hospital." ;
    rdfs:domain :City ; rdfs:range :Hospital ;
    owl:inverseOf :locatedIn .

:inCountry rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in country" ; rdfs:comment "Relates a city to a country." ;
    rdfs:domain :City ; rdfs:range :Country ;
    owl:inverseOf :hasCity .
:hasCity rdf:type owl:ObjectProperty ;
    rdfs:label "has city" ; rdfs:comment "Inverse: relates a country to a city." ;
    rdfs:domain :Country ; rdfs:range :City ;
    owl:inverseOf :inCountry .

:hasMember rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has member" ; rdfs:comment "Relates a union to its membership." ;
    rdfs:domain :Union ; rdfs:range :UnionMembership ;
    owl:inverseOf :memberOfUnion .
:memberOfUnion rdf:type owl:ObjectProperty ;
    rdfs:label "member of union" ; rdfs:comment "Relates a union membership to a union." ;
    rdfs:domain :UnionMembership ; rdfs:range :Union ;
    owl:inverseOf :hasMember .

:hasUnionRole rdf:type owl:ObjectProperty ;
    rdfs:label "has union role" ; rdfs:comment "Relates a union membership to a union role." ;
    rdfs:domain :UnionMembership ; rdfs:range :UnionRole ;
    owl:inverseOf :unionRoleOfMembership .
:unionRoleOfMembership rdf:type owl:ObjectProperty ;
    rdfs:label "union role of membership" ; rdfs:comment "Inverse: relates a union role to a union membership." ;
    rdfs:domain :UnionRole ; rdfs:range :UnionMembership ;
    owl:inverseOf :hasUnionRole .

:unionRoleOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "union role of" ; rdfs:comment "Relates a union role to a person." ;
    rdfs:domain :UnionRole ; rdfs:range :Person ;
    owl:inverseOf :hasUnionRolePerson .
:hasUnionRolePerson rdf:type owl:ObjectProperty ;
    rdfs:label "has union role person" ; rdfs:comment "Inverse: relates a person to their union role." ;
    rdfs:domain :Person ; rdfs:range :UnionRole ;
    owl:inverseOf :unionRoleOf .

:evaluatedBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evaluated by" ; rdfs:comment "Relates an employee evaluation to a doctor." ;
    rdfs:domain :EmployeeEvaluation ; rdfs:range :Doctor ;
    owl:inverseOf :evaluates .
:evaluates rdf:type owl:ObjectProperty ;
    rdfs:label "evaluates" ; rdfs:comment "Relates a doctor to an employee evaluation." ;
    rdfs:domain :Doctor ; rdfs:range :EmployeeEvaluation ;
    owl:inverseOf :evaluatedBy .

:evaluationOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evaluation of" ; rdfs:comment "Relates an employee evaluation to the employee." ;
    rdfs:domain :EmployeeEvaluation ; rdfs:range :Person ;
    owl:inverseOf :hasEvaluation .
:hasEvaluation rdf:type owl:ObjectProperty ;
    rdfs:label "has evaluation" ; rdfs:comment "Relates a person to an employee evaluation." ;
    rdfs:domain :Person ; rdfs:range :EmployeeEvaluation ;
    owl:inverseOf :evaluationOf .

:composedOf rdf:type owl:ObjectProperty ;
    rdfs:label "composed of" ; rdfs:comment "Relates an article collection to its articles." ;
    rdfs:domain :ArticleCollection ; rdfs:range :Article ;
    owl:inverseOf :partOfCollection .
:partOfCollection rdf:type owl:ObjectProperty ;
    rdfs:label "part of collection" ; rdfs:comment "Inverse: relates an article to the article collection it is part of." ;
    rdfs:domain :Article ; rdfs:range :ArticleCollection ;
    owl:inverseOf :composedOf .

:presentedAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "presented at" ; rdfs:comment "Relates a seminar presentation to a seminar." ;
    rdfs:domain :SeminarPresentation ; rdfs:range :Seminar ;
    owl:inverseOf :seminarPresentationOf .
:seminarPresentationOf rdf:type owl:ObjectProperty ;
    rdfs:label "seminar presentation of" ; rdfs:comment "Relates a seminar to its presentations." ;
    rdfs:domain :Seminar ; rdfs:range :SeminarPresentation ;
    owl:inverseOf :presentedAt .

:presentsArticle rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "presents article" ; rdfs:comment "Relates a seminar presentation to an article." ;
    rdfs:domain :SeminarPresentation ; rdfs:range :Article ;
    owl:inverseOf :presentedIn .
:presentedIn rdf:type owl:ObjectProperty ;
    rdfs:label "presented in" ; rdfs:comment "Inverse: relates an article to the seminar presentation." ;
    rdfs:domain :Article ; rdfs:range :SeminarPresentation ;
    owl:inverseOf :presentsArticle .

:heldAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "held at" ; rdfs:comment "Relates a seminar to the hospital where it is held." ;
    rdfs:domain :Seminar ; rdfs:range :Hospital ;
    owl:inverseOf :hostsSeminar .
:hostsSeminar rdf:type owl:ObjectProperty ;
    rdfs:label "hosts seminar" ; rdfs:comment "Inverse: relates a hospital to a seminar." ;
    rdfs:domain :Hospital ; rdfs:range :Seminar ;
    owl:inverseOf :heldAt .

### Data Properties
:degreeDate rdf:type owl:DatatypeProperty ; rdfs:label "degree date" ; rdfs:comment "The date a degree was obtained." ; rdfs:domain :Degree ; rdfs:range xsd:date .
:studyStartDate rdf:type owl:DatatypeProperty ; rdfs:label "study start date" ; rdfs:comment "Start date of a study period." ; rdfs:domain :StudyPeriod ; rdfs:range xsd:date .
:studyEndDate rdf:type owl:DatatypeProperty ; rdfs:label "study end date" ; rdfs:comment "End date of a study period." ; rdfs:domain :StudyPeriod ; rdfs:range xsd:date .
:employmentStartDate rdf:type owl:DatatypeProperty ; rdfs:label "employment start date" ; rdfs:comment "Start date of employment." ; rdfs:domain :Employment ; rdfs:range xsd:date .
:employmentEndDate rdf:type owl:DatatypeProperty ; rdfs:label "employment end date" ; rdfs:comment "End date of employment." ; rdfs:domain :Employment ; rdfs:range xsd:date .
:unionMembershipStartDate rdf:type owl:DatatypeProperty ; rdfs:label "union membership start date" ; rdfs:comment "Start date of union membership." ; rdfs:domain :UnionMembership ; rdfs:range xsd:date .
:unionMembershipEndDate rdf:type owl:DatatypeProperty ; rdfs:label "union membership end date" ; rdfs:comment "End date of union membership." ; rdfs:domain :UnionMembership ; rdfs:range xsd:date .
:evaluationStatement rdf:type owl:DatatypeProperty ; rdfs:label "evaluation statement" ; rdfs:comment "Text of the evaluation statement." ; rdfs:domain :EmployeeEvaluation ; rdfs:range xsd:string .
:publicationDateBook rdf:type owl:DatatypeProperty ; rdfs:label "publication date (book)" ; rdfs:comment "Publication date of a book." ; rdfs:domain :Book ; rdfs:range xsd:date .
:publicationDateCD rdf:type owl:DatatypeProperty ; rdfs:label "publication date (CD)" ; rdfs:comment "Publication date of a CD." ; rdfs:domain :CD ; rdfs:range xsd:date .
:pageCount rdf:type owl:DatatypeProperty ; rdfs:label "page count" ; rdfs:comment "Number of pages in a book." ; rdfs:domain :Book ; rdfs:range xsd:integer .
:seminarDate rdf:type owl:DatatypeProperty ; rdfs:label "seminar date" ; rdfs:comment "Date of a seminar." ; rdfs:domain :Seminar ; rdfs:range xsd:date .

### GCAs and Restrictions
:Seminar rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :seminarPresentationOf ; owl:someValuesFrom [ rdf:type owl:Restriction ; owl:onProperty :presentsArticle ; owl:someValuesFrom :Article ] ] ;
    rdfs:label "Seminar" ; rdfs:comment "A seminar held at a hospital for presenting articles." .
