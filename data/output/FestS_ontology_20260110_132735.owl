@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/theatre-productions> a owl:Ontology .

### Classes
:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "A person who performs in theatre productions." .

:Act a owl:Class ;
  rdfs:label "Act" ;
  rdfs:comment "A division or section within a play." .

:Author a owl:Class ;
  rdfs:label "Author" ;
  rdfs:comment "A person who writes plays." .

:City a owl:Class ;
  rdfs:label "City" ;
  rdfs:comment "A city where theatres or festivals are located." .

:Country a owl:Class ;
  rdfs:label "Country" ;
  rdfs:comment "A country where cities are located." .

:Ensemble a owl:Class ;
  rdfs:label "Ensemble" ;
  rdfs:comment "A group of actors performing together in a production." .

:Membership a owl:Class ;
  rdfs:label "Membership" ;
  rdfs:comment "A reified relation representing an actor's membership in an ensemble at a certain time." .

:Theatre a owl:Class ;
  rdfs:label "Theatre" ;
  rdfs:comment "A venue where theatre productions are performed." .

:TheatreFestival a owl:Class ;
  rdfs:label "Theatre Festival" ;
  rdfs:comment "An event where multiple theatre productions are held." .

:Play a owl:Class ;
  rdfs:label "Play" ;
  rdfs:comment "A dramatic literary work intended for performance." .

:Production a owl:Class ;
  rdfs:label "Production" ;
  rdfs:comment "A particular performance or staging of a play." .

:Participation a owl:Class ;
  rdfs:label "Participation" ;
  rdfs:comment "A reified relation representing an ensemble's participation in a production at a specific time." .

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A character or part played by an actor in a production." .

:RoleAssignment a owl:Class ;
  rdfs:label "Role Assignment" ;
  rdfs:comment "A reified relation assigning an actor to a role in a production at a particular time." .

:Review a owl:Class ;
  rdfs:label "Review" ;
  rdfs:comment "A critique or evaluation of a production." .

:Newspaper a owl:Class ;
  rdfs:label "Newspaper" ;
  rdfs:comment "A publication that may review theatre productions." .

:StarRating a owl:Class ;
  rdfs:label "Star Rating" ;
  rdfs:comment "A rating (e.g. 1-5 stars) given to a production in a review." .

:PremierEvent a owl:Class ;
  rdfs:label "Premier Event" ;
  rdfs:comment "A special event marking the first performance of a production." .

:Employment a owl:Class ;
  rdfs:label "Employment" ;
  rdfs:comment "A reified relation representing an actor's employment at a theatre during a period." .

### Disjointness
:Actor owl:disjointWith :Role, :Ensemble, :Theatre, :TheatreFestival, :Play, :Production, :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Role owl:disjointWith :Ensemble, :Theatre, :TheatreFestival, :Play, :Production, :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Ensemble owl:disjointWith :Theatre, :TheatreFestival, :Play, :Production, :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Theatre owl:disjointWith :TheatreFestival, :Play, :Production, :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:TheatreFestival owl:disjointWith :Play, :Production, :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Play owl:disjointWith :Production, :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Production owl:disjointWith :Participation, :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Participation owl:disjointWith :Membership, :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Membership owl:disjointWith :RoleAssignment, :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:RoleAssignment owl:disjointWith :Review, :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Review owl:disjointWith :Newspaper, :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:Newspaper owl:disjointWith :StarRating, :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:StarRating owl:disjointWith :PremierEvent, :Employment, :City, :Country, :Act, :Author .
:PremierEvent owl:disjointWith :Employment, :City, :Country, :Act, :Author .
:Employment owl:disjointWith :City, :Country, :Act, :Author .
:City owl:disjointWith :Country, :Act, :Author .
:Country owl:disjointWith :Act, :Author .
:Act owl:disjointWith :Author .

### Object Properties
:hasLocation a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "has location" ;
  rdfs:comment "Associates a theatre festival with the city where it takes place." ;
  rdfs:domain :TheatreFestival ;
  rdfs:range :City ;
  owl:inverseOf :locationOf .

:locationOf a owl:ObjectProperty ;
  rdfs:label "location of" ;
  rdfs:comment "Inverse of hasLocation: associates a city with the festival(s) held there." ;
  rdfs:domain :City ;
  rdfs:range :TheatreFestival .

:locatedIn a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "located in" ;
  rdfs:comment "Associates a city with the country it is located in." ;
  rdfs:domain :City ;
  rdfs:range :Country ;
  owl:inverseOf :hasCity .

:hasCity a owl:ObjectProperty ;
  rdfs:label "has city" ;
  rdfs:comment "Inverse of locatedIn: associates a country with its cities." ;
  rdfs:domain :Country ;
  rdfs:range :City .

:hasProduction a owl:ObjectProperty ;
  rdfs:label "has production" ;
  rdfs:comment "Associates a festival with its productions." ;
  rdfs:domain :TheatreFestival ;
  rdfs:range :Production ;
  owl:inverseOf :productionOf .

:productionOf a owl:ObjectProperty ;
  rdfs:label "production of" ;
  rdfs:comment "Inverse of hasProduction: associates a production with its festival." ;
  rdfs:domain :Production ;
  rdfs:range :TheatreFestival .

:performedAt a owl:ObjectProperty ;
  rdfs:label "performed at" ;
  rdfs:comment "Associates a production with the theatre where it is performed." ;
  rdfs:domain :Production ;
  rdfs:range :Theatre ;
  owl:inverseOf :hostedProduction .

:hostedProduction a owl:ObjectProperty ;
  rdfs:label "hosted production" ;
  rdfs:comment "Inverse of performedAt: associates a theatre with productions it hosts." ;
  rdfs:domain :Theatre ;
  rdfs:range :Production .

:hasBasis a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "has basis" ;
  rdfs:comment "Associates a production with the play it is based on." ;
  rdfs:domain :Production ;
  rdfs:range :Play ;
  owl:inverseOf :basisOf .

:basisOf a owl:ObjectProperty ;
  rdfs:label "basis of" ;
  rdfs:comment "Inverse of hasBasis: associates a play with productions based on it." ;
  rdfs:domain :Play ;
  rdfs:range :Production .

:hasAuthor a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "has author" ;
  rdfs:comment "Associates a play with its author." ;
  rdfs:domain :Play ;
  rdfs:range :Author ;
  owl:inverseOf :authorOf .

:authorOf a owl:ObjectProperty ;
  rdfs:label "author of" ;
  rdfs:comment "Inverse of hasAuthor: associates an author with their plays." ;
  rdfs:domain :Author ;
  rdfs:range :Play .

:hasAct a owl:ObjectProperty ;
  rdfs:label "has act" ;
  rdfs:comment "Associates a play with its acts." ;
  rdfs:domain :Play ;
  rdfs:range :Act ;
  owl:inverseOf :actOf .

:actOf a owl:ObjectProperty ;
  rdfs:label "act of" ;
  rdfs:comment "Inverse of hasAct: associates an act with the play it is part of." ;
  rdfs:domain :Act ;
  rdfs:range :Play .

:hasEnsemble a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "has ensemble" ;
  rdfs:comment "Associates a production with its ensemble." ;
  rdfs:domain :Production ;
  rdfs:range :Ensemble ;
  owl:inverseOf :ensembleOf .

:ensembleOf a owl:ObjectProperty ;
  rdfs:label "ensemble of" ;
  rdfs:comment "Inverse of hasEnsemble: associates an ensemble with the production it belongs to." ;
  rdfs:domain :Ensemble ;
  rdfs:range :Production .

:hasMember a owl:ObjectProperty ;
  rdfs:label "has member" ;
  rdfs:comment "Associates an ensemble with its actor members." ;
  rdfs:domain :Ensemble ;
  rdfs:range :Actor ;
  owl:inverseOf :memberOf .

:memberOf a owl:ObjectProperty ;
  rdfs:label "member of" ;
  rdfs:comment "Inverse of hasMember: associates an actor with the ensemble they are a member of." ;
  rdfs:domain :Actor ;
  rdfs:range :Ensemble .

:hasReview a owl:ObjectProperty ;
  rdfs:label "has review" ;
  rdfs:comment "Associates a production with its reviews." ;
  rdfs:domain :Production ;
  rdfs:range :Review ;
  owl:inverseOf :reviewOf .

:reviewOf a owl:ObjectProperty ;
  rdfs:label "review of" ;
  rdfs:comment "Inverse of hasReview: associates a review with the production it reviews." ;
  rdfs:domain :Review ;
  rdfs:range :Production .

:reviewedBy a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "reviewed by" ;
  rdfs:comment "Associates a review with the newspaper that published it." ;
  rdfs:domain :Review ;
  rdfs:range :Newspaper ;
  owl:inverseOf :reviews .

:reviews a owl:ObjectProperty ;
  rdfs:label "reviews" ;
  rdfs:comment "Inverse of reviewedBy: associates a newspaper with the reviews it publishes." ;
  rdfs:domain :Newspaper ;
  rdfs:range :Review .

:hasStarRating a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "has star rating" ;
  rdfs:comment "Associates a review with its star rating." ;
  rdfs:domain :Review ;
  rdfs:range :StarRating ;
  owl:inverseOf :starRatingOf .

:starRatingOf a owl:ObjectProperty ;
  rdfs:label "star rating of" ;
  rdfs:comment "Inverse of hasStarRating: associates a star rating with the review it is given in." ;
  rdfs:domain :StarRating ;
  rdfs:range :Review .

:hasPremierEvent a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "has premier event" ;
  rdfs:comment "Associates a production with its premier event." ;
  rdfs:domain :Production ;
  rdfs:range :PremierEvent ;
  owl:inverseOf :premierEventOf .

:premierEventOf a owl:ObjectProperty ;
  rdfs:label "premier event of" ;
  rdfs:comment "Inverse of hasPremierEvent: associates a premier event with its production." ;
  rdfs:domain :PremierEvent ;
  rdfs:range :Production .

:hasParticipation a owl:ObjectProperty ;
  rdfs:label "has participation" ;
  rdfs:comment "Associates a production with a participation event (ensemble, time)." ;
  rdfs:domain :Production ;
  rdfs:range :Participation ;
  owl:inverseOf :participationOf .

:participationOf a owl:ObjectProperty ;
  rdfs:label "participation of" ;
  rdfs:comment "Inverse of hasParticipation: associates a participation event with its production." ;
  rdfs:domain :Participation ;
  rdfs:range :Production .

:hasEmployment a owl:ObjectProperty ;
  rdfs:label "has employment" ;
  rdfs:comment "Associates a theatre with an employment relation." ;
  rdfs:domain :Theatre ;
  rdfs:range :Employment ;
  owl:inverseOf :employmentOf .

:employmentOf a owl:ObjectProperty ;
  rdfs:label "employment of" ;
  rdfs:comment "Inverse of hasEmployment: associates an employment relation with its theatre." ;
  rdfs:domain :Employment ;
  rdfs:range :Theatre .

:hasMembership a owl:ObjectProperty ;
  rdfs:label "has membership" ;
  rdfs:comment "Associates an ensemble with a membership relation." ;
  rdfs:domain :Ensemble ;
  rdfs:range :Membership ;
  owl:inverseOf :membershipOf .

:membershipOf a owl:ObjectProperty ;
  rdfs:label "membership of" ;
  rdfs:comment "Inverse of hasMembership: associates a membership relation with its ensemble." ;
  rdfs:domain :Membership ;
  rdfs:range :Ensemble .

:hasRoleAssignment a owl:ObjectProperty ;
  rdfs:label "has role assignment" ;
  rdfs:comment "Associates a production with a role assignment (actor, role, time)." ;
  rdfs:domain :Production ;
  rdfs:range :RoleAssignment ;
  owl:inverseOf :roleAssignmentOf .

:roleAssignmentOf a owl:ObjectProperty ;
  rdfs:label "role assignment of" ;
  rdfs:comment "Inverse of hasRoleAssignment: associates a role assignment with its production." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range :Production .

:playsRole a owl:ObjectProperty ;
  rdfs:label "plays role" ;
  rdfs:comment "Associates a role assignment with a role." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range :Role ;
  owl:inverseOf :rolePlayedIn .

:rolePlayedIn a owl:ObjectProperty ;
  rdfs:label "role played in" ;
  rdfs:comment "Inverse of playsRole: associates a role with role assignments." ;
  rdfs:domain :Role ;
  rdfs:range :RoleAssignment .

:performedBy a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:label "performed by" ;
  rdfs:comment "Associates a role assignment with the actor performing the role." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range :Actor ;
  owl:inverseOf :performsRoleAssignment .

:performsRoleAssignment a owl:ObjectProperty ;
  rdfs:label "performs role assignment" ;
  rdfs:comment "Inverse of performedBy: associates an actor with the role assignments they perform." ;
  rdfs:domain :Actor ;
  rdfs:range :RoleAssignment .

### Data Properties
:festivalDate a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "festival date" ;
  rdfs:comment "The date when a theatre festival takes place." ;
  rdfs:domain :TheatreFestival ;
  rdfs:range xsd:date .

:productionPeriodStart a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "production period start" ;
  rdfs:comment "The start date of a production's run." ;
  rdfs:domain :Production ;
  rdfs:range xsd:date .

:productionPeriodEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "production period end" ;
  rdfs:comment "The end date of a production's run." ;
  rdfs:domain :Production ;
  rdfs:range xsd:date .

:actNumber a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "act number" ;
  rdfs:comment "The number of an act within a play." ;
  rdfs:domain :Act ;
  rdfs:range xsd:integer .

:playWrittenStart a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "play written start" ;
  rdfs:comment "The year when the writing of a play started." ;
  rdfs:domain :Play ;
  rdfs:range xsd:gYear .

:playWrittenEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "play written end" ;
  rdfs:comment "The year when the writing of a play ended." ;
  rdfs:domain :Play ;
  rdfs:range xsd:gYear .

:premierDate a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "premier date" ;
  rdfs:comment "The date of a production's premier event." ;
  rdfs:domain :PremierEvent ;
  rdfs:range xsd:date .

:starValue a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "star value" ;
  rdfs:comment "The number of stars awarded in a review." ;
  rdfs:domain :StarRating ;
  rdfs:range xsd:integer .

:employmentStart a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "employment start" ;
  rdfs:comment "The date an actor started employment at a theatre." ;
  rdfs:domain :Employment ;
  rdfs:range xsd:date .

:membershipStart a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "membership start" ;
  rdfs:comment "The date an actor started membership in an ensemble." ;
  rdfs:domain :Membership ;
  rdfs:range xsd:date .

:membershipEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "membership end" ;
  rdfs:comment "The date an actor ended membership in an ensemble." ;
  rdfs:domain :Membership ;
  rdfs:range xsd:date .

:roleAssignmentStart a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "role assignment start" ;
  rdfs:comment "The date a role assignment starts." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range xsd:date .

:roleAssignmentEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "role assignment end" ;
  rdfs:comment "The date a role assignment ends." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range xsd:date .

### Restrictions and Axioms
:Production owl:equivalentClass [ a owl:Class ; owl:Restriction [ owl:onProperty :hasPremierEvent ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ] ;
  rdfs:comment "A production has exactly one premier event." .
