@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/theatre-productions>
    a owl:Ontology ;
    rdfs:label "Theatre Productions Ontology" ;
    rdfs:comment "Ontology for representing theatre festivals, productions, plays, people, roles, and reviews in the context of Italian theatre events." .

#################################################################
# CLASSES
#################################################################

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in theatre productions." .

:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "A person who acts in a production." ;
    rdfs:subClassOf :Person .

:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:comment "A person who writes plays." ;
    rdfs:subClassOf :Person .

:TheatreFestival a owl:Class ;
    rdfs:label "Theatre Festival" ;
    rdfs:comment "An event where theatre performances are held." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where theatres or festivals are located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing cities." .

:Theatre a owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:comment "A building or institution for theatre performances." .

:Play a owl:Class ;
    rdfs:label "Play" ;
    rdfs:comment "A dramatic work performed in a theatre." .

:Production a owl:Class ;
    rdfs:label "Production" ;
    rdfs:comment "A specific staging of a play by a theatre or ensemble." .

:Ensemble a owl:Class ;
    rdfs:label "Ensemble" ;
    rdfs:comment "A group of people performing together in a production." .

:Act a owl:Class ;
    rdfs:label "Act" ;
    rdfs:comment "A major division of a play." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A character or function played by a person in a production." .

:Review a owl:Class ;
    rdfs:label "Review" ;
    rdfs:comment "A critique or rating of a production by a newspaper." .

:Newspaper a owl:Class ;
    rdfs:label "Newspaper" ;
    rdfs:comment "A newspaper publishing reviews of productions." .

:StarRating a owl:Class ;
    rdfs:label "Star Rating" ;
    rdfs:comment "A numerical rating given to a production in a review." .

# Pivot Classes for Reification
:ProductionMembership a owl:Class ;
    rdfs:label "Production Membership" ;
    rdfs:comment "Reifies a person's membership in a production ensemble, with time information." .

:RoleAssignment a owl:Class ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "Reifies a person's assignment to a role in a production at a given time." .

#################################################################
# OBJECT PROPERTIES (with inverses)
#################################################################

:heldInCity a owl:ObjectProperty ;
    rdfs:label "held in city" ;
    rdfs:comment "Links a theatre festival to the city where it is held." ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :City ;
    owl:inverseOf :cityHoldsFestival .

:cityHoldsFestival a owl:ObjectProperty ;
    rdfs:label "city holds festival" ;
    rdfs:comment "Inverse: Links a city to the festivals it hosts." ;
    rdfs:domain :City ;
    rdfs:range :TheatreFestival ;
    owl:inverseOf :heldInCity .

:hasProduction a owl:ObjectProperty ;
    rdfs:label "has production" ;
    rdfs:comment "Links a festival to a production it hosts." ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :Production ;
    owl:inverseOf :productionOfFestival .

:productionOfFestival a owl:ObjectProperty ;
    rdfs:label "production of festival" ;
    rdfs:comment "Inverse: Links a production to the festival it is part of." ;
    rdfs:domain :Production ;
    rdfs:range :TheatreFestival ;
    owl:inverseOf :hasProduction .

:locatedInCity a owl:ObjectProperty ;
    rdfs:label "located in city" ;
    rdfs:comment "Links a theatre to the city where it is located." ;
    rdfs:domain :Theatre ;
    rdfs:range :City ;
    owl:inverseOf :cityHasTheatre .

:cityHasTheatre a owl:ObjectProperty ;
    rdfs:label "city has theatre" ;
    rdfs:comment "Inverse: Links a city to its theatres." ;
    rdfs:domain :City ;
    rdfs:range :Theatre ;
    owl:inverseOf :locatedInCity .

:locatedInCountry a owl:ObjectProperty ;
    rdfs:label "located in country" ;
    rdfs:comment "Links a city to the country it is located in." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasCity .

:countryHasCity a owl:ObjectProperty ;
    rdfs:label "country has city" ;
    rdfs:comment "Inverse: Links a country to its cities." ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    owl:inverseOf :locatedInCountry .

:basisPlay a owl:ObjectProperty ;
    rdfs:label "basis play" ;
    rdfs:comment "Links a production to the play it is based on." ;
    rdfs:domain :Production ;
    rdfs:range :Play ;
    owl:inverseOf :isBasisOfProduction .

:isBasisOfProduction a owl:ObjectProperty ;
    rdfs:label "is basis of production" ;
    rdfs:comment "Inverse: Links a play to the productions based on it." ;
    rdfs:domain :Play ;
    rdfs:range :Production ;
    owl:inverseOf :basisPlay .

:hasEnsemble a owl:ObjectProperty ;
    rdfs:label "has ensemble" ;
    rdfs:comment "Links a production to its ensemble." ;
    rdfs:domain :Production ;
    rdfs:range :Ensemble ;
    owl:inverseOf :ensembleOfProduction .

:ensembleOfProduction a owl:ObjectProperty ;
    rdfs:label "ensemble of production" ;
    rdfs:comment "Inverse: Links an ensemble to its production." ;
    rdfs:domain :Ensemble ;
    rdfs:range :Production ;
    owl:inverseOf :hasEnsemble .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Links an ensemble to a production membership." ;
    rdfs:domain :Ensemble ;
    rdfs:range :ProductionMembership ;
    owl:inverseOf :memberOfEnsemble .

:memberOfEnsemble a owl:ObjectProperty ;
    rdfs:label "member of ensemble" ;
    rdfs:comment "Inverse: Links a production membership to its ensemble." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range :Ensemble ;
    owl:inverseOf :hasMember .

:memberPerson a owl:ObjectProperty ;
    rdfs:label "member person" ;
    rdfs:comment "Links a production membership to a person." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range :Person ;
    owl:inverseOf :personHasMembership .

:personHasMembership a owl:ObjectProperty ;
    rdfs:label "person has membership" ;
    rdfs:comment "Inverse: Links a person to their production memberships." ;
    rdfs:domain :Person ;
    rdfs:range :ProductionMembership ;
    owl:inverseOf :memberPerson .

:membershipInProduction a owl:ObjectProperty ;
    rdfs:label "membership in production" ;
    rdfs:comment "Links a production membership to a production." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range :Production ;
    owl:inverseOf :productionHasMembership .

:productionHasMembership a owl:ObjectProperty ;
    rdfs:label "production has membership" ;
    rdfs:comment "Inverse: Links a production to its production memberships." ;
    rdfs:domain :Production ;
    rdfs:range :ProductionMembership ;
    owl:inverseOf :membershipInProduction .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Links a production to a role assignment." ;
    rdfs:domain :Production ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :roleAssignmentOfProduction .

:roleAssignmentOfProduction a owl:ObjectProperty ;
    rdfs:label "role assignment of production" ;
    rdfs:comment "Inverse: Links a role assignment to its production." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Production ;
    owl:inverseOf :hasRoleAssignment .

:rolePerson a owl:ObjectProperty ;
    rdfs:label "role person" ;
    rdfs:comment "Links a role assignment to a person." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Person ;
    owl:inverseOf :personHasRoleAssignment .

:personHasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "person has role assignment" ;
    rdfs:comment "Inverse: Links a person to their role assignments." ;
    rdfs:domain :Person ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :rolePerson .

:roleRole a owl:ObjectProperty ;
    rdfs:label "role role" ;
    rdfs:comment "Links a role assignment to a role." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Role ;
    owl:inverseOf :roleHasAssignment .

:roleHasAssignment a owl:ObjectProperty ;
    rdfs:label "role has assignment" ;
    rdfs:comment "Inverse: Links a role to its assignments." ;
    rdfs:domain :Role ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :roleRole .

:roleInProduction a owl:ObjectProperty ;
    rdfs:label "role in production" ;
    rdfs:comment "Links a role assignment to the production." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Production ;
    owl:inverseOf :productionHasRoleAssignment .

:productionHasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "production has role assignment" ;
    rdfs:comment "Inverse: Links a production to its role assignments." ;
    rdfs:domain :Production ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :roleInProduction .

:writtenBy a owl:ObjectProperty ;
    rdfs:label "written by" ;
    rdfs:comment "Links a play to its author." ;
    rdfs:domain :Play ;
    rdfs:range :Author ;
    owl:inverseOf :authorOfPlay .

:authorOfPlay a owl:ObjectProperty ;
    rdfs:label "author of play" ;
    rdfs:comment "Inverse: Links an author to plays they've written." ;
    rdfs:domain :Author ;
    rdfs:range :Play ;
    owl:inverseOf :writtenBy .

:hasAct a owl:ObjectProperty ;
    rdfs:label "has act" ;
    rdfs:comment "Links a play to its acts." ;
    rdfs:domain :Play ;
    rdfs:range :Act ;
    owl:inverseOf :actOfPlay .

:actOfPlay a owl:ObjectProperty ;
    rdfs:label "act of play" ;
    rdfs:comment "Inverse: Links an act to the play it is part of." ;
    rdfs:domain :Act ;
    rdfs:range :Play ;
    owl:inverseOf :hasAct .

:premierOfProduction a owl:ObjectProperty ;
    rdfs:label "premier of production" ;
    rdfs:comment "Links a production to its premier act." ;
    rdfs:domain :Production ;
    rdfs:range :Act ;
    owl:inverseOf :isPremierOf .

:isPremierOf a owl:ObjectProperty ;
    rdfs:label "is premier of" ;
    rdfs:comment "Inverse: Links an act to the production it is the premier of." ;
    rdfs:domain :Act ;
    rdfs:range :Production ;
    owl:inverseOf :premierOfProduction .

:reviewedBy a owl:ObjectProperty ;
    rdfs:label "reviewed by" ;
    rdfs:comment "Links a review to the newspaper that published it." ;
    rdfs:domain :Review ;
    rdfs:range :Newspaper ;
    owl:inverseOf :newspaperHasReview .

:newspaperHasReview a owl:ObjectProperty ;
    rdfs:label "newspaper has review" ;
    rdfs:comment "Inverse: Links a newspaper to reviews it has published." ;
    rdfs:domain :Newspaper ;
    rdfs:range :Review ;
    owl:inverseOf :reviewedBy .

:reviewOfProduction a owl:ObjectProperty ;
    rdfs:label "review of production" ;
    rdfs:comment "Links a review to the production it critiques." ;
    rdfs:domain :Review ;
    rdfs:range :Production ;
    owl:inverseOf :productionHasReview .

:productionHasReview a owl:ObjectProperty ;
    rdfs:label "production has review" ;
    rdfs:comment "Inverse: Links a production to its reviews." ;
    rdfs:domain :Production ;
    rdfs:range :Review ;
    owl:inverseOf :reviewOfProduction .

:reviewHasStarRating a owl:ObjectProperty ;
    rdfs:label "review has star rating" ;
    rdfs:comment "Links a review to its star rating." ;
    rdfs:domain :Review ;
    rdfs:range :StarRating ;
    owl:inverseOf :starRatingOfReview .

:starRatingOfReview a owl:ObjectProperty ;
    rdfs:label "star rating of review" ;
    rdfs:comment "Inverse: Links a star rating to the review it is part of." ;
    rdfs:domain :StarRating ;
    rdfs:range :Review ;
    owl:inverseOf :reviewHasStarRating .

#################################################################
# DATA PROPERTIES
#################################################################

:festivalStartDate a owl:DatatypeProperty ;
    rdfs:label "festival start date" ;
    rdfs:comment "The start date of a theatre festival." ;
    rdfs:domain :TheatreFestival ;
    rdfs:range xsd:dateTime .

:festivalEndDate a owl:DatatypeProperty ;
    rdfs:label "festival end date" ;
    rdfs:comment "The end date of a theatre festival." ;
    rdfs:domain :TheatreFestival ;
    rdfs:range xsd:dateTime .

:actNumber a owl:DatatypeProperty ;
    rdfs:label "act number" ;
    rdfs:comment "The number of an act within a play." ;
    rdfs:domain :Act ;
    rdfs:range xsd:integer ;
    a owl:FunctionalProperty .

:writingStartDate a owl:DatatypeProperty ;
    rdfs:label "writing start date" ;
    rdfs:comment "The start date of writing a play." ;
    rdfs:domain :Play ;
    rdfs:range xsd:dateTime .

:writingEndDate a owl:DatatypeProperty ;
    rdfs:label "writing end date" ;
    rdfs:comment "The end date of writing a play." ;
    rdfs:domain :Play ;
    rdfs:range xsd:dateTime .

:premierDate a owl:DatatypeProperty ;
    rdfs:label "premier date" ;
    rdfs:comment "The date of the premier of a production." ;
    rdfs:domain :Production ;
    rdfs:range xsd:dateTime ;
    a owl:FunctionalProperty .

:employmentStartDate a owl:DatatypeProperty ;
    rdfs:label "employment start date" ;
    rdfs:comment "The start date of a person's membership in a production." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range xsd:dateTime .

:roleStartDate a owl:DatatypeProperty ;
    rdfs:label "role start date" ;
    rdfs:comment "The start date of a role assignment for a person in a production." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:dateTime .

:roleEndDate a owl:DatatypeProperty ;
    rdfs:label "role end date" ;
    rdfs:comment "The end date of a role assignment for a person in a production." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:dateTime .

:starRatingValue a owl:DatatypeProperty ;
    rdfs:label "star rating value" ;
    rdfs:comment "The numeric value of a star rating." ;
    rdfs:domain :StarRating ;
    rdfs:range xsd:integer ;
    a owl:FunctionalProperty .

#################################################################
# CLASS AXIOMS & RESTRICTIONS
#################################################################

# A production has exactly one premier date
:Production rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :premierDate ; owl:cardinality 1 ] .

# A play is written by at least one author
:Play rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :writtenBy ; owl:someValuesFrom :Author ] .

# An ensemble has at least one member
:Ensemble rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasMember ; owl:someValuesFrom :ProductionMembership ] .

# A production has at least one role assignment
:Production rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRoleAssignment ; owl:someValuesFrom :RoleAssignment ] .

# Disjointness
:Actor owl:disjointWith :Author .
:TheatreFestival owl:disjointWith :Play .
:Theatre owl:disjointWith :City .

# DisjointUnion for Person
:Person owl:disjointUnionOf ( :Actor :Author ) .
