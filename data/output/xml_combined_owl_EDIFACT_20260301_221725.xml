<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>An invoice message (INVOIC) in EDIFACT.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isCompositeElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>is composite element of</rdfs:label>    <rdfs:comment>Inverse of hasCompositeElement: indicates the Segment to which this CompositeDataElement belongs.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasCompositeElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#referenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>reference number</rdfs:label>    <rdfs:comment>Reference number for the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Links an Organization to its Addresses.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#invoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>invoice number</rdfs:label>    <rdfs:comment>The identifier for the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#UNEDIFACTInvoiceStory">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology capturing the structure of UN/EDIFACT invoice messages, organizations, roles, and business processes as described in the story.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAssignedInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>has assigned invoice</rdfs:label>    <rdfs:comment>Inverse of assignedToProcess: InvoiceMessages assigned to this BusinessProcess.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#assignedToProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment within a message, e.g., BGM or NAD.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isInvolvedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#UserResourceUsage"/>    <rdfs:label>is involved in</rdfs:label>    <rdfs:comment>Inverse of involvesRole: the UserResourceUsage that involves this AgentRole.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#involvesRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal address for an organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#addressLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>address line</rdfs:label>    <rdfs:comment>A line of address information.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>An organization involved in an invoice, e.g., buyer or seller.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Item"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#quantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>quantity</rdfs:label>    <rdfs:comment>Quantity of the Item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Links a Composite Data Element to its Simple Data Elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRolePlayedBy">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#UserResourceUsage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>is role played by</rdfs:label>    <rdfs:comment>Inverse of playsRole: the Organization that plays this UserResourceUsage role.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#playsRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#inInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#UserResourceUsage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>in invoice</rdfs:label>    <rdfs:comment>Specifies the Invoice Message in which the Organization plays a Role.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#netPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>net price</rdfs:label>    <rdfs:comment>Net price of the Item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Links an Item to its Price.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>A price associated with an item.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Links an Interchange Envelope to its contained Messages.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse of hasSegment: indicates the Message to which this Segment belongs.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSimpleElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:label>is simple element of</rdfs:label>    <rdfs:comment>Inverse of hasSimpleElement: indicates the CompositeDataElement to which this SimpleDataElement belongs.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSimpleElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Links a Message to its Segments.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:label>has item</rdfs:label>    <rdfs:comment>Links an Invoice Message to its Items.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process to which an invoice can be assigned.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Links a Segment to its Composite Data Elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#documentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>document date</rdfs:label>    <rdfs:comment>Date of the invoice as string (due to OWL2 DL datatype restriction).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A generic message in the EDIFACT standard.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#playsRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#UserResourceUsage"/>    <rdfs:label>plays role</rdfs:label>    <rdfs:comment>Links an Organization to its Agent Role assignment in an Invoice context (reified).</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRolePlayedBy"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:label>is price of</rdfs:label>    <rdfs:comment>Inverse of hasPrice: the Item this Price is for.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasPrice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#UserResourceUsage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>User Resource Usage</rdfs:label>    <rdfs:comment>Pivot class for reifying the relationship between Organization, AgentRole, and InvoiceMessage.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>is address of</rdfs:label>    <rdfs:comment>Inverse of hasAddress: the Organization this Address belongs to.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasAddress"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Inverse of containsMessage: indicates the InterchangeEnvelope containing this Message.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#containsMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element within a composite element.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#involvesRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#UserResourceUsage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>involves role</rdfs:label>    <rdfs:comment>Specifies the Agent Role involved in the Organizations participation in the Invoice.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isInvolvedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#totalAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>total amount</rdfs:label>    <rdfs:comment>Total invoice amount.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#UserResourceUsage"/>    <rdfs:label>has role assignment</rdfs:label>    <rdfs:comment>Inverse of inInvoice: UserResourceUsage assignments for this InvoiceMessage.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#inInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasGLN">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has GLN</rdfs:label>    <rdfs:comment>Global Location Number for the Organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in the context of an invoice (e.g., Buyer, Seller, DeliveryParty).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The outer envelope containing messages in EDIFACT.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedToProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:label>assigned to process</rdfs:label>    <rdfs:comment>Assigns the invoice to a business process.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasAssignedInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is item of</rdfs:label>    <rdfs:comment>Inverse of hasItem: the InvoiceMessage this Item belongs to.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>An item being sold in the invoice.</rdfs:comment>  </rdf:Description></rdf:RDF>