@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production> a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "Ontology for modeling music production, band membership, roles, albums, performances, and related entities as described in the Red Hot Chili Peppers scenario." .

#################################################################
#    Classes
#################################################################

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, including musicians and critics." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical group or band." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A musical or organizational role a person can have in a band (e.g., vocalist, guitarist)." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of musical tracks released by a band." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A single audio recording that is part of an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition that can be recorded as a track." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who critiques or reviews albums." ;
    rdfs:subClassOf :Person .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live event where a band performs songs." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances occur or bands are based." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographical region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Pivot Classes for Reification

:UserBandMembership a owl:Class ;
    rdfs:label "User Band Membership" ;
    rdfs:comment "Reifies the membership of a person in a band during a certain period." .

:BandRoleAssignment a owl:Class ;
    rdfs:label "Band Role Assignment" ;
    rdfs:comment "Reifies the assignment of a specific role to a person in a band for a period." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "Reifies the recording event of an album by a band, with start and end dates." .

:TrackSongRelation a owl:Class ;
    rdfs:label "Track Song Relation" ;
    rdfs:comment "Reifies the relationship between a track and the song it records." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "Reifies the relationship between a performance and a song played." .

#################################################################
#    Object Properties (with Inverses)
#################################################################

:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :isPlayedBy ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to the instrument they play." .

:isPlayedBy a owl:ObjectProperty ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument ;
    rdfs:label "is played by" ;
    rdfs:comment "Relates an instrument to the person who plays it." .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :Band ;
    rdfs:range :UserBandMembership ;
    owl:inverseOf :isMembershipOf ;
    rdfs:label "has member" ;
    rdfs:comment "Relates a band to its membership reification." .

:isMembershipOf a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:domain :UserBandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember ;
    rdfs:label "is membership of" ;
    rdfs:comment "Relates a band membership to the band." .

:hasPerson a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :UserBandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :isPersonMembership ;
    rdfs:label "has person" ;
    rdfs:comment "Relates a band membership to the person." .

:isPersonMembership a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :UserBandMembership ;
    owl:inverseOf :hasPerson ;
    rdfs:label "is person membership" ;
    rdfs:comment "Relates a person to their band membership reification." .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :UserBandMembership ;
    rdfs:range :BandRoleAssignment ;
    owl:inverseOf :isRoleAssignmentOf ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Relates a membership to a role assignment." .

:isRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range :UserBandMembership ;
    owl:inverseOf :hasRoleAssignment ;
    rdfs:label "is role assignment of" ;
    rdfs:comment "Relates a role assignment to the membership it refers to." .

:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range :Role ;
    owl:inverseOf :isRoleOf ;
    rdfs:label "has role" ;
    rdfs:comment "Relates a role assignment to a specific role." .

:isRoleOf a owl:ObjectProperty ;
    rdfs:domain :Role ;
    rdfs:range :BandRoleAssignment ;
    owl:inverseOf :hasRole ;
    rdfs:label "is role of" ;
    rdfs:comment "Relates a role to the role assignments it is part of." .

:records a owl:ObjectProperty ;
    rdfs:domain :Band ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :isRecordedBy ;
    rdfs:label "records" ;
    rdfs:comment "Relates a band to an album recording event." .

:isRecordedBy a owl:ObjectProperty ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Band ;
    owl:inverseOf :records ;
    rdfs:label "is recorded by" ;
    rdfs:comment "Relates an album recording event to the band." .

:albumRecorded a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :isAlbumRecordingOf ;
    rdfs:label "album recorded" ;
    rdfs:comment "Relates an album recording event to the album." .

:isAlbumRecordingOf a owl:ObjectProperty ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :albumRecorded ;
    rdfs:label "is album recording of" ;
    rdfs:comment "Relates an album to its recording event." .

:containsTrack a owl:ObjectProperty ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :isTrackOf ;
    rdfs:label "contains track" ;
    rdfs:comment "Relates an album to its tracks." .

:isTrackOf a owl:ObjectProperty ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :containsTrack ;
    rdfs:label "is track of" ;
    rdfs:comment "Relates a track to the album it is part of." .

:trackRelation a owl:ObjectProperty ;
    rdfs:domain :Track ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :isTrackRelationOf ;
    rdfs:label "track relation" ;
    rdfs:comment "Relates a track to its song relation reification." .

:isTrackRelationOf a owl:ObjectProperty ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Track ;
    owl:inverseOf :trackRelation ;
    rdfs:label "is track relation of" ;
    rdfs:comment "Relates a track-song relation to the track." .

:isRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Song ;
    owl:inverseOf :hasRecording ;
    rdfs:label "is recording of" ;
    rdfs:comment "Relates a track-song relation to the song it records." .

:hasRecording a owl:ObjectProperty ;
    rdfs:domain :Song ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :isRecordingOf ;
    rdfs:label "has recording" ;
    rdfs:comment "Relates a song to its track-song relations." .

:criticizes a owl:ObjectProperty ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :isCriticizedBy ;
    rdfs:label "criticizes" ;
    rdfs:comment "Relates a critic to an album they review." .

:isCriticizedBy a owl:ObjectProperty ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :criticizes ;
    rdfs:label "is criticized by" ;
    rdfs:comment "Relates an album to critics who reviewed it." .

:hasPerformance a owl:ObjectProperty ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :isPerformanceOf ;
    rdfs:label "has performance" ;
    rdfs:comment "Relates a band to its performances." .

:isPerformanceOf a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :hasPerformance ;
    rdfs:label "is performance of" ;
    rdfs:comment "Relates a performance to its band." .

:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :isLocationOfPerformance ;
    rdfs:label "performance location" ;
    rdfs:comment "City where a performance is held." .

:isLocationOfPerformance a owl:ObjectProperty ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation ;
    rdfs:label "is location of performance" ;
    rdfs:comment "Relates a city to performances held there." .

:performanceSongRelation a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :isPerformanceSongOf ;
    rdfs:label "performance song relation" ;
    rdfs:comment "Relates a performance to the reification of a song performed." .

:isPerformanceSongOf a owl:ObjectProperty ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceSongRelation ;
    rdfs:label "is performance song of" ;
    rdfs:comment "Relates a performance-song reification to the performance." .

:performedSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :isPerformedIn ;
    rdfs:label "performed song" ;
    rdfs:comment "Relates a performance-song relation to the song performed." .

:isPerformedIn a owl:ObjectProperty ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performedSong ;
    rdfs:label "is performed in" ;
    rdfs:comment "Relates a song to the performance-song relations it is part of." .

:locatedInRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :hasCity ;
    rdfs:label "located in region" ;
    rdfs:comment "Relates a city to the region it is located in." .

:hasCity a owl:ObjectProperty ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :locatedInRegion ;
    rdfs:label "has city" ;
    rdfs:comment "Relates a region to its cities." .

:locatedInCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :hasRegion ;
    rdfs:label "located in country" ;
    rdfs:comment "Relates a region to the country it is located in." .

:hasRegion a owl:ObjectProperty ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :locatedInCountry ;
    rdfs:label "has region" ;
    rdfs:comment "Relates a country to its regions." .

#################################################################
#    Datatype Properties
#################################################################

:membershipStart a owl:DatatypeProperty ;
    rdfs:domain :UserBandMembership ;
    rdfs:range xsd:date ;
    rdfs:label "membership start" ;
    rdfs:comment "Start date of a person's membership in a band." .

:membershipEnd a owl:DatatypeProperty ;
    rdfs:domain :UserBandMembership ;
    rdfs:range xsd:date ;
    rdfs:label "membership end" ;
    rdfs:comment "End date of a person's membership in a band." .

:roleStart a owl:DatatypeProperty ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range xsd:date ;
    rdfs:label "role start" ;
    rdfs:comment "Start date of a specific role assignment." .

:roleEnd a owl:DatatypeProperty ;
    rdfs:domain :BandRoleAssignment ;
    rdfs:range xsd:date ;
    rdfs:label "role end" ;
    rdfs:comment "End date of a specific role assignment." .

:recordingStart a owl:DatatypeProperty ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:date ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date of an album recording." .

:recordingEnd a owl:DatatypeProperty ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:date ;
    rdfs:label "recording end" ;
    rdfs:comment "End date (or release date) of an album recording." .

:trackNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track within an album." .

:songComposedOn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Song ;
    rdfs:range xsd:date ;
    rdfs:label "song composed on" ;
    rdfs:comment "Date when a song was composed." .

:criticComment a owl:DatatypeProperty ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string ;
    rdfs:label "critic comment" ;
    rdfs:comment "The textual critique or comment by a critic on an album." .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Performance ;
    rdfs:range xsd:date ;
    rdfs:label "performance date" ;
    rdfs:comment "Date of a performance." .

#################################################################
#    Disjointness
#################################################################

:Person owl:disjointWith :Band , :Instrument .
:Album owl:disjointWith :Song , :Performance .
:City owl:disjointWith :Region .
:Region owl:disjointWith :Country .

#################################################################
#    End of Ontology
#################################################################
