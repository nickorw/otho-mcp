<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b8">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasAddress"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has section</rdfs:label>    <rdfs:comment>Relates a Message to its major sections (header, detail, summary).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSectionOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an Interchange to its contained Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Interchange"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInInterchange"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#refersToItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>refers to item</rdfs:label>    <rdfs:comment>Relates an InvoiceLineItem to the Item it describes.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOfInvoiceLine"/>  </rdf:Description>  <rdf:Description rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b3">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#refersToItem"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment in a message, such as BGM or NAD.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b1">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasOrganizationInRole"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInInterchange">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is contained in interchange</rdfs:label>    <rdfs:comment>Inverse property: relates a Message to its Interchange envelope.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Interchange"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#containsMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#validatesInvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>validates invoice message</rdfs:label>    <rdfs:comment>Inverse property: relates a BusinessProcess to an InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isValidForBusinessProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>The net price of an item in an invoice line.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasValidationConstraint">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has validation constraint</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to a ValidationConstraint for compliance checks.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#ValidationConstraint"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isValidationConstraintOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Detail Section</rdfs:label>    <rdfs:comment>Detail section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse property: relates a Segment to its Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>An organization involved in an invoice, e.g., buyer or seller.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal or warehouse address associated with an organization in a role.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSimpleElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is simple element of</rdfs:label>    <rdfs:comment>Inverse property: relates a Simple Data Element to its Composite Data Element.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSimpleElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#GlobalLocationNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Global Location Number</rdfs:label>    <rdfs:comment>A specific identifier type for organizations as per D96A.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Identifier"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#playsRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>plays role</rdfs:label>    <rdfs:comment>Relates an OrganizationInRole to an AgentRole (e.g., Buyer, Seller).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isValidationConstraintOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is validation constraint of</rdfs:label>    <rdfs:comment>Inverse property: relates a ValidationConstraint to InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#ValidationConstraint"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasValidationConstraint"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isInvoiceLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is invoice line item of</rdfs:label>    <rdfs:comment>Inverse property: relates an InvoiceLineItem to its InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasInvoiceLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Relates a Segment to its Composite Data Elements.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTotalAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has total amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role of</rdfs:label>    <rdfs:comment>Inverse property: relates an AgentRole to an OrganizationInRole.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#playsRole"/>  </rdf:Description>  <rdf:Description rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b7">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasOrganization"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element within a composite element.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a Message to its Segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#HeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Header Section</rdfs:label>    <rdfs:comment>Header section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#DetailSection"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSectionOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is section of</rdfs:label>    <rdfs:comment>Inverse property: relates a Segment to its Message as a section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>A price value for an item or invoice line.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationInRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization In Role</rdfs:label>    <rdfs:comment>A pivot class associating an Organization, AgentRole, Address, and Identifier for a given message context.</rdfs:comment>    <rdfs:subClassOf rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b6"/>    <rdfs:subClassOf rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b7"/>    <rdfs:subClassOf rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b8"/>    <rdfs:subClassOf rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b9"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemOfInvoiceLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is item of invoice line</rdfs:label>    <rdfs:comment>Inverse property: relates an Item to InvoiceLineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#refersToItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has organization</rdfs:label>    <rdfs:comment>Relates an OrganizationInRole to the Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationOfRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>Relates an OrganizationInRole to an Identifier (e.g., GLN).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Identifier"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIdentifierOfRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isValidForBusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is valid for business process</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to a BusinessProcess.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#validatesInvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>A message representing an invoice (INVOIC).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:subClassOf rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b1"/>    <rdfs:subClassOf rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b2"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationInRoleOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is organization in role of</rdfs:label>    <rdfs:comment>Inverse property: relates an OrganizationInRole to its InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasOrganizationInRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Line</rdfs:label>    <rdfs:comment>A line entry in the invoice listing an item, quantity, and price.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in a business process, e.g., Buyer, Seller, Delivery Party.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a Composite Data Element to its Simple Data Elements.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has invoice number</rdfs:label>    <rdfs:comment>The invoice number.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOfRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is address of role</rdfs:label>    <rdfs:comment>Inverse property: relates an Address to OrganizationInRole.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasAddress"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has invoice line item</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to its InvoiceLineItem entries.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isInvoiceLineItemOf"/>  </rdf:Description>  <rdf:Description rdf:nodeID="nf898b5ebd69d4a5cb0ab6c5ee33d4851b5">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasQuantity"/>    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Relates an OrganizationInRole to an Address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOfRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasOrganizationInRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has organization in role</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to an OrganizationInRole pivot class.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationInRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationInRoleOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">   