://www.example.org/ontology#BuyerRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Buyer Role</rdfs:label>    <rdfs:comment>The organization acting as the buyer.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#DeliveryPartyRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Header</rdfs:label>    <rdfs:comment>Header section of the invoice message, including dates and references.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isHeaderOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is header of</rdfs:label>    <rdfs:comment>Inverse property: InvoiceHeader is header of InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasHeader"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Assignment</rdfs:label>    <rdfs:comment>Pivot class for reifying the assignment of a role to an organization within a message context.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is address of</rdfs:label>    <rdfs:comment>Inverse prope