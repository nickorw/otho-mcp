<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#hasSummary">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has summary</rdfs:label>    <rdfs:comment>Connects an invoice message to its summary section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSummaryOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPlayedBy">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is played by</rdfs:label>    <rdfs:comment>Inverse property: AgentRole is played by Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#playsRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BGMSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>BGM Segment</rdfs:label>    <rdfs:comment>Beginning of Message segment, identifies document type and number.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#ValidationConstraint">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Validation Constraint</rdfs:label>    <rdfs:comment>A constraint or rule used for automated validation (e.g., SHACL).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Inverse property: Message is contained in an Interchange Envelope.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#containsMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The outermost envelope containing one or more EDIFACT messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has role assignment</rdfs:label>    <rdfs:comment>Connects an invoice message to an organization-role assignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleAssignmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service listed in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAssignedToProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is assigned to process</rdfs:label>    <rdfs:comment>Assigns an invoice message to a business process.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasInvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has reference number</rdfs:label>    <rdfs:comment>Connects an invoice header to its reference number.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#ReferenceNumber"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isReferenceNumberOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse property: Segment is part of a message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is price of</rdfs:label>    <rdfs:comment>Inverse property: Price is for an Item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasPrice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>Connects an invoice summary to its invoice amount.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceAmount"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isInvoiceAmountOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Connects an organization to its address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has invoice message</rdfs:label>    <rdfs:comment>Inverse property: BusinessProcess has assigned InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAssignedToProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has header</rdfs:label>    <rdfs:comment>Connects an invoice message to its header section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isHeaderOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasGlobalLocationNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has global location number</rdfs:label>    <rdfs:comment>The GLN of an organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element within a segment or composite.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>An identifier for organizations or documents.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A generic EDIFACT message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isReferenceNumberOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is reference number of</rdfs:label>    <rdfs:comment>Inverse property: ReferenceNumber is for InvoiceHeader.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#ReferenceNumber"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasReferenceNumber"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is item of</rdfs:label>    <rdfs:comment>Inverse property: Item is part of InvoiceDetail.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Quantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Quantity</rdfs:label>    <rdfs:comment>The quantity of an item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isValidatedBy">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is validated by</rdfs:label>    <rdfs:comment>Connects an invoice message to a validation constraint.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#ValidationConstraint"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#validates"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#GlobalLocationNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Global Location Number</rdfs:label>    <rdfs:comment>A globally recognized location identifier (GLN).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Identifier"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail</rdfs:label>    <rdfs:comment>Detail section listing line items.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRoleAssignmentFor">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has role assignment for</rdfs:label>    <rdfs:comment>Inverse property: Organization has role assignment for OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#assignedTo"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>A string identifier for documents or organizations.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has item</rdfs:label>    <rdfs:comment>Connects an invoice detail section to its items.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DeliveryPartyRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Delivery Party Role</rdfs:label>    <rdfs:comment>The organization acting as the delivery party.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>An INVOIC message as defined in EDIFACT D96A.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:subClassOf rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db1"/>    <rdfs:subClassOf rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db2"/>    <rdfs:subClassOf rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db3"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignsRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>assigns role</rdfs:label>    <rdfs:comment>Connects a role assignment to an agent role.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAssignedRoleOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#ReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Reference Number</rdfs:label>    <rdfs:comment>A reference or document number in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db1">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasHeader"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role assignment of</rdfs:label>    <rdfs:comment>Inverse property: OrganizationRoleAssignment is role assignment of InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedTo">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>assigned to</rdfs:label>    <rdfs:comment>Connects a role assignment to an organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRoleAssignmentFor"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>Connects an item to its quantity.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Quantity"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isQuantityOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal or physical address.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isTaxAmountOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is tax amount of</rdfs:label>    <rdfs:comment>Inverse property: TaxAmount is for InvoiceSummary.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#TaxAmount"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasTaxAmount"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#validates">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>validates</rdfs:label>    <rdfs:comment>Inverse property: ValidationConstraint validates InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#ValidationConstraint"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isValidatedBy"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Connects a message to its segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has document date</rdfs:label>    <rdfs:comment>The date of the invoice document, as a string (ISO format recommended).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A generic role played by an organization in the transaction.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTaxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has tax amount</rdfs:label>    <rdfs:comment>Connects an invoice summary to its tax amount.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#TaxAmount"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isTaxAmountOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology/edifact-invoic">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT INVOIC Ontology</rdfs:label>    <rdfs:comment>A deeply structured ontology for UN/EDIFACT D96A INVOIC messages, supporting business document interoperability and validation.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isInvoiceAmountOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is invoice amount of</rdfs:label>    <rdfs:comment>Inverse property: InvoiceAmount is for InvoiceSummary.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceAmount"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasInvoiceAmount"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has detail</rdfs:label>    <rdfs:comment>Connects an invoice message to its detail section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDetailOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSummaryOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is summary of</rdfs:label>    <rdfs:comment>Inverse property: InvoiceSummary is summary of InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.exam