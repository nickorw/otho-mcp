/ontology#InvoiceHeader"/>    <rdf:rest rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db6"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Connects an item to its price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOf"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db6">    <rdf:first rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <rdf:rest rdf:nodeID="n007393434ec4422a8e70dc472d18fe6db7"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>The price of an item.</rdfs:comment>  </rdf:Description></rdf:RDF>