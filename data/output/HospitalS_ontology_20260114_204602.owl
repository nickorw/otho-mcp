@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/hospital-story>
    a owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "An ontology modeling hospital staff, unions, employment, publications, and seminars as described in the provided story." .

#################################################################
# Classes
#################################################################

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in the hospital context." .

:Doctor a owl:Class ;
    rdfs:label "Doctor" ;
    rdfs:comment "A person who is a doctor." ;
    rdfs:subClassOf :Person .

:Nurse a owl:Class ;
    rdfs:label "Nurse" ;
    rdfs:comment "A person who is a certified nurse." ;
    rdfs:subClassOf :Person .

:NursingAssistant a owl:Class ;
    rdfs:label "Nursing Assistant" ;
    rdfs:comment "A person who is a nursing assistant." ;
    rdfs:subClassOf :Person .

:Staff a owl:Class ;
    rdfs:label "Staff" ;
    rdfs:comment "A person who is a member of the hospital staff." ;
    rdfs:subClassOf :Person .

:Degree a owl:Class ;
    rdfs:label "Degree" ;
    rdfs:comment "A medical or nursing degree." .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A reified relationship representing a person's employment at a hospital." .

:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:comment "A hospital institution." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where hospitals are located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country in which a city is located." .

:Union a owl:Class ;
    rdfs:label "Union" ;
    rdfs:comment "A union organizing hospital staff." .

:UnionMembership a owl:Class ;
    rdfs:label "Union Membership" ;
    rdfs:comment "A reified relationship representing a person's membership in a union." .

:UnionRole a owl:Class ;
    rdfs:label "Union Role" ;
    rdfs:comment "A role held by a person within a union." .

:Evaluation a owl:Class ;
    rdfs:label "Evaluation" ;
    rdfs:comment "A written evaluation statement given by a doctor for a staff member." .

:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A research article." .

:ArticleCollection a owl:Class ;
    rdfs:label "Article Collection" ;
    rdfs:comment "A collection of research articles, published as a book or CD." .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A book containing research articles." ;
    rdfs:subClassOf :ArticleCollection .

:CD a owl:Class ;
    rdfs:label "CD" ;
    rdfs:comment "A CD containing research articles." ;
    rdfs:subClassOf :ArticleCollection .

:Seminar a owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A seminar where articles are presented." .

#################################################################
# Disjointness & Disjoint Unions
#################################################################

:Doctor owl:disjointWith :Nurse, :NursingAssistant, :Staff .
:Nurse owl:disjointWith :NursingAssistant, :Staff .
:NursingAssistant owl:disjointWith :Staff .
:Book owl:disjointWith :CD .

:Person owl:disjointUnionOf (:Doctor :Nurse :NursingAssistant :Staff) .
:ArticleCollection owl:disjointUnionOf (:Book :CD) .

#################################################################
# Object Properties and Inverses
#################################################################

:hasDegree a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has degree" ;
    rdfs:comment "Relates a person to a degree they have obtained." ;
    rdfs:domain :Person ;
    rdfs:range :Degree ;
    owl:inverseOf :isDegreeOf .

:isDegreeOf a owl:ObjectProperty ;
    rdfs:label "is degree of" ;
    rdfs:comment "Inverse of hasDegree: Relates a degree to a person who has it." ;
    rdfs:domain :Degree ;
    rdfs:range :Person ;
    owl:inverseOf :hasDegree .

:studiedForDegree a owl:ObjectProperty ;
    rdfs:label "studied for degree" ;
    rdfs:comment "Relates a person to a degree they studied for." ;
    rdfs:domain :Person ;
    rdfs:range :Degree ;
    owl:inverseOf :wasStudiedBy .

:wasStudiedBy a owl:ObjectProperty ;
    rdfs:label "was studied by" ;
    rdfs:comment "Inverse of studiedForDegree: Relates a degree to a person who studied for it." ;
    rdfs:domain :Degree ;
    rdfs:range :Person ;
    owl:inverseOf :studiedForDegree .

:employedAt a owl:ObjectProperty ;
    rdfs:label "employed at" ;
    rdfs:comment "Relates an employment relationship to a hospital." ;
    rdfs:domain :Employment ;
    rdfs:range :Hospital ;
    owl:inverseOf :hasEmployment .

:hasEmployment a owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:comment "Inverse of employedAt: Relates a hospital to an employment relationship." ;
    rdfs:domain :Hospital ;
    rdfs:range :Employment ;
    owl:inverseOf :employedAt .

:locatedInCity a owl:ObjectProperty ;
    rdfs:label "located in city" ;
    rdfs:comment "Relates a hospital to the city it is located in." ;
    rdfs:domain :Hospital ;
    rdfs:range :City ;
    owl:inverseOf :hasHospital .

:hasHospital a owl:ObjectProperty ;
    rdfs:label "has hospital" ;
    rdfs:comment "Inverse of locatedInCity: Relates a city to a hospital located in it." ;
    rdfs:domain :City ;
    rdfs:range :Hospital ;
    owl:inverseOf :locatedInCity .

:locatedInCountry a owl:ObjectProperty ;
    rdfs:label "located in country" ;
    rdfs:comment "Relates a city to the country it is located in." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :hasCity .

:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Inverse of locatedInCountry: Relates a country to a city located in it." ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    owl:inverseOf :locatedInCountry .

:memberOfUnion a owl:ObjectProperty ;
    rdfs:label "member of union" ;
    rdfs:comment "Relates a union membership to a union." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Union ;
    owl:inverseOf :hasMember .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Inverse of memberOfUnion: Relates a union to a membership." ;
    rdfs:domain :Union ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :memberOfUnion .

:unionRole a owl:ObjectProperty ;
    rdfs:label "union role" ;
    rdfs:comment "Relates a union membership to a union role." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :UnionRole ;
    owl:inverseOf :isRoleOfMembership .

:isRoleOfMembership a owl:ObjectProperty ;
    rdfs:label "is role of membership" ;
    rdfs:comment "Inverse of unionRole: Relates a union role to a union membership." ;
    rdfs:domain :UnionRole ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionRole .

:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluated by" ;
    rdfs:comment "Relates an evaluation to the doctor who performed it." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Doctor ;
    owl:inverseOf :performedEvaluation .

:performedEvaluation a owl:ObjectProperty ;
    rdfs:label "performed evaluation" ;
    rdfs:comment "Inverse of evaluatedBy: Relates a doctor to an evaluation they performed." ;
    rdfs:domain :Doctor ;
    rdfs:range :Evaluation ;
    owl:inverseOf :evaluatedBy .

:evaluatesEmployee a owl:ObjectProperty ;
    rdfs:label "evaluates employee" ;
    rdfs:comment "Relates an evaluation to the staff member being evaluated." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Staff ;
    owl:inverseOf :isEvaluationOf .

:isEvaluationOf a owl:ObjectProperty ;
    rdfs:label "is evaluation of" ;
    rdfs:comment "Inverse of evaluatesEmployee: Relates a staff member to an evaluation." ;
    rdfs:domain :Staff ;
    rdfs:range :Evaluation ;
    owl:inverseOf :evaluatesEmployee .

:containsArticle a owl:ObjectProperty ;
    rdfs:label "contains article" ;
    rdfs:comment "Relates an article collection to an article it contains." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Article ;
    owl:inverseOf :isContainedIn .

:isContainedIn a owl:ObjectProperty ;
    rdfs:label "is contained in" ;
    rdfs:comment "Inverse of containsArticle: Relates an article to the collection it is contained in." ;
    rdfs:domain :Article ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :containsArticle .

:publishedAsBook a owl:ObjectProperty ;
    rdfs:label "published as book" ;
    rdfs:comment "Relates an article collection to its book form." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Book ;
    owl:inverseOf :isBookPublicationOf .

:isBookPublicationOf a owl:ObjectProperty ;
    rdfs:label "is book publication of" ;
    rdfs:comment "Inverse of publishedAsBook: Relates a book to the article collection it publishes." ;
    rdfs:domain :Book ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :publishedAsBook .

:publishedAsCD a owl:ObjectProperty ;
    rdfs:label "published as CD" ;
    rdfs:comment "Relates an article collection to its CD form." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :CD ;
    owl:inverseOf :isCDPublicationOf .

:isCDPublicationOf a owl:ObjectProperty ;
    rdfs:label "is CD publication of" ;
    rdfs:comment "Inverse of publishedAsCD: Relates a CD to the article collection it publishes." ;
    rdfs:domain :CD ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :publishedAsCD .

:presentedAtSeminar a owl:ObjectProperty ;
    rdfs:label "presented at seminar" ;
    rdfs:comment "Relates an article to the seminar where it was presented." ;
    rdfs:domain :Article ;
    rdfs:range :Seminar ;
    owl:inverseOf :hasPresentedArticle .

:hasPresentedArticle a owl:ObjectProperty ;
    rdfs:label "has presented article" ;
    rdfs:comment "Inverse of presentedAtSeminar: Relates a seminar to an article presented at it." ;
    rdfs:domain :Seminar ;
    rdfs:range :Article ;
    owl:inverseOf :presentedAtSeminar .

:seminarLocation a owl:ObjectProperty ;
    rdfs:label "seminar location" ;
    rdfs:comment "Relates a seminar to the hospital where it was held." ;
    rdfs:domain :Seminar ;
    rdfs:range :Hospital ;
    owl:inverseOf :locationOfSeminar .

:locationOfSeminar a owl:ObjectProperty ;
    rdfs:label "location of seminar" ;
    rdfs:comment "Inverse of seminarLocation: Relates a hospital to a seminar held there." ;
    rdfs:domain :Hospital ;
    rdfs:range :Seminar ;
    owl:inverseOf :seminarLocation .

#################################################################
# Data Properties
#################################################################

:studyStartDate a owl:DatatypeProperty ;
    rdfs:label "study start date" ;
    rdfs:comment "The start date of a person's studies for a degree." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .

:studyEndDate a owl:DatatypeProperty ;
    rdfs:label "study end date" ;
    rdfs:comment "The end date of a person's studies for a degree." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .

:employmentStartDate a owl:DatatypeProperty ;
    rdfs:label "employment start date" ;
    rdfs:comment "The date when employment started." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .

:unionMembershipStartDate a owl:DatatypeProperty ;
    rdfs:label "union membership start date" ;
    rdfs:comment "The date when a union membership started." ;
    rdfs:domain :UnionMembership ;
    rdfs:range xsd:dateTime .

:evaluationStatement a owl:DatatypeProperty ;
    rdfs:label "evaluation statement" ;
    rdfs:comment "The written statement of an evaluation." ;
    rdfs:domain :Evaluation ;
    rdfs:range xsd:string .

:bookPageCount a owl:DatatypeProperty ;
    rdfs:label "book page count" ;
    rdfs:comment "The number of pages in a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer .

:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publication date" ;
    rdfs:comment "The publication date of a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:dateTime .

:publicationDateCD a owl:DatatypeProperty ;
    rdfs:label "CD publication date" ;
    rdfs:comment "The publication date of a CD." ;
    rdfs:domain :CD ;
    rdfs:range xsd:dateTime .

:seminarDate a owl:DatatypeProperty ;
    rdfs:label "seminar date" ;
    rdfs:comment "The date of a seminar." ;
    rdfs:domain :Seminar ;
    rdfs:range xsd:dateTime .

#################################################################
# General Class Axioms & Restrictions
#################################################################

# Seminar must have at least one presented article
:Seminar rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasPresentedArticle ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Article
] .
