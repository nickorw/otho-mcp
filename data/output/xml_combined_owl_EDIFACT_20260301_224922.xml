ce="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has date</rdfs:label>    <rdfs:comment>Date associated with the invoice document (string-encoded for OWL 2 compliance).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdfs:label>has detail</rdfs:label>    <rdfs:comment>Links an invoice message to its detail section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDetailOfInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemOfDetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdfs:label>is item of detail section</rdfs:label>    <rdfs:comment>Inverse property: relates a line item to the detail section it belongs to.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple, atomic data value within a segment or composite element.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource=