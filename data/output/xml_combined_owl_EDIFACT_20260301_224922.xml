y"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <rdfs:label>has summary</rdfs:label>    <rdfs:comment>Links an invoice message to its summary section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSummaryOfInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:label>has role assignment</rdfs:label>    <rdfs:comment>Inverse property: relates an organization to its role assignments.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOfLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:label>is price of line item</rdfs:label>    <rdfs:comment>Inverse property: relates a price to the line item it is associated with.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#storyid-un-edifact-invoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>An ontology for representing UN/EDIFACT invoice messages, aligned with EN 16931-1 and the Purchase-to-Pay Ontology (P2P-O).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#describesItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:label>describes item</rdfs:label>    <rdfs:comment>Links a line item to the item being sold.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDescribedByLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal or physical address associated with an organization role assignment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isHeaderOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is header of invoice</rdfs:label>    <rdfs:comment>Inverse property: relates a header section to the invoice message it belongs to.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse property: relates a segment to the message it is part of.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Links an interchange envelope to the messages it contains.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:label>has header</rdfs:label>    <rdfs:comment>Links an invoice message to its header section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isHeaderOfInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>Quantity of the item sold in the line item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:label>has item</rdfs:label>    <rdfs:comment>Indicates the line items in the invoice detail section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOfDetailSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    