/rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>Net or unit price for a line item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Invoice Detail Section</rdfs:label>    <rdfs:comment>Section of the invoice listing individual line items.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Associates a message with its segments.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSummaryOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is summary of invoice</rdfs:label>    <rdfs:comment>Inverse property: relates a summary section to the invoice message it belongs to.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A structural unit within a message, such as BGM or NAD segments.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:label>is address of assignment</rdfs:label>    <rdfs:comment>Inverse property: relates an address to the organization role assignments it is associated with.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>Associates an organization with its identifiers (e.g., GLN).</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIdentifierOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>A generic identifier such as a reference number or code.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationInvolvedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is organization involved in</rdfs:label>    <rdfs:comment>Inverse property: relates an organization to the invoice messages it is involved in.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>is role assignment of</rdfs:label>    <rdfs:comment>Inverse property: relates a role assignment to its organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Inverse property: relates a message to its containing interchange envelope.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>has role</rdfs:label>    <rdfs:comment>Specifies the agent role in an organization role assignment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOfAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>The total invoice amount in the summary section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Invoice Header Section</rdfs:label>    <rdfs:comment>Header section with document dates and reference numbers.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDetailOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is detail of invoice</rdfs:label>    <rdfs:comment>Inverse property: relates a detail section to the invoice message it belongs to.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:label>is role of assignment</rdfs:label>    <rdfs:comment>Inverse property: relates an agent role to the organization role assignments it is part of.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in a business process (e.g., Buyer, Seller, Delivery Party).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment, grouping related simple elements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#participatesIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:label>participates in</rdfs:label>    <rdfs:comment>Indicates the business process to which the invoice is assigned.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasParticipantInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Assignment</rdfs:label>    <rdfs:comment>A pivot class representing the assignment of a role (e.g., Buyer, Seller) to an organization, possibly with address and identifier.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Associates a segment with its composite data elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isCompositeElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>is composite element of</rdfs:label>    <rdfs:comment>Inverse property: relates a composite data element to its segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Associates a composite data element with its simple data elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The top-level envelope containing one or more messages in the UN/EDIFACT standard.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>Net price or unit price associated with a line item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#involvesOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>involves organization</rdfs:label>    <rdfs:comment>Indicates which organizations are involved in an invoice message.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationInvolvedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has reference number</rdfs:label>    <rdfs:comment>Reference number in the invoice header.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDescribedByLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:label>is described by line item</rdfs:label>    <rdfs:comment>Inverse property: relates an item to the line item that describes it.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service listed in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceSummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Invoice Summary Section</rdfs:label>    <rdfs:comment>Summary section providing total tax and invoice amounts.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>A line item in the invoice detail section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process to which an invoice can be assigned.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A generic business message within an interchange envelope.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>An organization involved in the invoice process, may play multiple roles.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description></rdf:RDF>