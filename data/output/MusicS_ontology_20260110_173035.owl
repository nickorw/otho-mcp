@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "An ontology describing music production, bands, albums, tracks, performances, and related entities." .

### CLASSES

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, such as a musician or critic." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A musical group consisting of one or more people." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or position held by a person in a band." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A published collection of music tracks." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "An individual recording on an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews or defines albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live musical event by a band." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances occur." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographic region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Pivot Classes for Reification
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reified relation linking a person, a band, a role, and a time period." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "A reified relation linking a band, an album, and a recording period." .

:TrackSongRelation a owl:Class ;
    rdfs:label "Track Song Relation" ;
    rdfs:comment "Reifies the relation between a track and the song it records." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "Reifies the relation between a performance and the songs played." .

### OBJECT PROPERTIES (with inverses)

:playsInstrument a owl:ObjectProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to the instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :instrumentPlayedBy .

:instrumentPlayedBy a owl:ObjectProperty ;
    rdfs:label "instrument played by" ;
    rdfs:comment "Inverse of playsInstrument; relates an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates a band membership to a role." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleOfMembership .

:roleOfMembership a owl:ObjectProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Inverse of hasRole; relates a role to the band membership(s) it is part of." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :hasRole .

:hasMember a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Relates a band membership to a person." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :memberInMembership .

:memberInMembership a owl:ObjectProperty ;
    rdfs:label "member in membership" ;
    rdfs:comment "Inverse of hasMember; relates a person to band membership(s) they are part of." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :hasMember .

:memberOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "member of" ;
    rdfs:comment "Relates a band membership to a band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMembership .

:hasMembership a owl:ObjectProperty ;
    rdfs:label "has membership" ;
    rdfs:comment "Inverse of memberOf; relates a band to its band membership(s)." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberOf .

:recordingOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recording of" ;
    rdfs:comment "Relates a track-song relation to a song." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Song ;
    owl:inverseOf :hasRecordingRelation .

:hasRecordingRelation a owl:ObjectProperty ;
    rdfs:label "has recording relation" ;
    rdfs:comment "Inverse of recordingOf; relates a song to track-song relations." ;
    rdfs:domain :Song ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :recordingOf .

:trackOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track of" ;
    rdfs:comment "Relates a track-song relation to a track." ;
    rdfs:domain :TrackSongRelation ;
    rdfs:range :Track ;
    owl:inverseOf :hasTrackRelation .

:hasTrackRelation a owl:ObjectProperty ;
    rdfs:label "has track relation" ;
    rdfs:comment "Inverse of trackOf; relates a track to the track-song relations it is part of." ;
    rdfs:domain :Track ;
    rdfs:range :TrackSongRelation ;
    owl:inverseOf :trackOf .

:recordedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recorded by" ;
    rdfs:comment "Relates an album recording to the band." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Band ;
    owl:inverseOf :hasAlbumRecording .

:hasAlbumRecording a owl:ObjectProperty ;
    rdfs:label "has album recording" ;
    rdfs:comment "Inverse of recordedBy; relates a band to its album recording(s)." ;
    rdfs:domain :Band ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedBy .

:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates an album recording to the album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :hasRecording .

:hasRecording a owl:ObjectProperty ;
    rdfs:label "has recording" ;
    rdfs:comment "Inverse of recordedAlbum; relates an album to its album recording(s)." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedAlbum .

:hasTrack a owl:ObjectProperty ;
    rdfs:label "has track" ;
    rdfs:comment "Relates an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOnAlbum .

:trackOnAlbum a owl:ObjectProperty ;
    rdfs:label "track on album" ;
    rdfs:comment "Inverse of hasTrack; relates a track to the album(s) it appears on." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :hasTrack .

:definedBy a owl:ObjectProperty ;
    rdfs:label "defined by" ;
    rdfs:comment "Relates a critic to an album." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :hasDefinitionBy .

:hasDefinitionBy a owl:ObjectProperty ;
    rdfs:label "has definition by" ;
    rdfs:comment "Inverse of definedBy; relates an album to the critic(s) who defined it." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :definedBy .

:performedAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performed at" ;
    rdfs:comment "Relates a performance to the city it took place in." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :cityOfPerformance .

:cityOfPerformance a owl:ObjectProperty ;
    rdfs:label "city of performance" ;
    rdfs:comment "Inverse of performedAt; relates a city to the performances held there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performedAt .

:performanceOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Relates a performance-song relation to a performance." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceSong .

:hasPerformanceSong a owl:ObjectProperty ;
    rdfs:label "has performance song" ;
    rdfs:comment "Inverse of performanceOf; relates a performance to performance-song relations." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceOf .

:performedSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Relates a performance-song relation to a song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformedIn .

:songPerformedIn a owl:ObjectProperty ;
    rdfs:label "song performed in" ;
    rdfs:comment "Inverse of performedSong; relates a song to performance-song relations." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performedSong .

:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in region" ;
    rdfs:comment "Relates a city to its region." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Inverse of inRegion; relates a region to its cities." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :inRegion .

:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in country" ;
    rdfs:comment "Relates a region to its country." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Inverse of inCountry; relates a country to its regions." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :inCountry .

### DATA PROPERTIES

:membershipAtTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "membership at time" ;
    rdfs:comment "The time at which a membership is valid." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "End date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:releasedOn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "released on" ;
    rdfs:comment "The release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "composed on" ;
    rdfs:comment "The composition date of a song." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:hasDefinition a owl:DatatypeProperty ;
    rdfs:label "has definition" ;
    rdfs:comment "The textual definition or review by a critic." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "The date of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

:trackNumber a owl:DatatypeProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track on an album." ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer .

:albumTrackCount a owl:DatatypeProperty ;
    rdfs:label "album track count" ;
    rdfs:comment "The total number of tracks on an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:integer .

### CLASS AXIOMS & RESTRICTIONS

# Disjointness
:Person owl:disjointWith :Band .
:Instrument owl:disjointWith :Role .
:Album owl:disjointWith :Song .
:Critic owl:disjointWith :Person .
:City owl:disjointWith :Region .
:Region owl:disjointWith :Country .

# Album must have at least one track
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .

### END OF ONTOLOGY
