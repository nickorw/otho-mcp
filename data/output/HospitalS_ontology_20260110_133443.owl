@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/hospital-story> a owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "An ontology for representing hospital staff, unions, evaluations, publications, and events as described in the hospital story." .

#################################################################
# Classes
#################################################################

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, including staff and authors." .

:Nurse a owl:Class ;
    rdfs:label "Nurse" ;
    rdfs:comment "A person working as a nurse." ;
    rdfs:subClassOf :Person .

:Doctor a owl:Class ;
    rdfs:label "Doctor" ;
    rdfs:comment "A person working as a doctor." ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Nurse .

:NursingAssistant a owl:Class ;
    rdfs:label "Nursing Assistant" ;
    rdfs:comment "A person trained as a nursing assistant." ;
    rdfs:subClassOf :Nurse .

:CertifiedNurse a owl:Class ;
    rdfs:label "Certified Nurse" ;
    rdfs:comment "A nurse with certification." ;
    rdfs:subClassOf :Nurse .

:Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "A person employed by a hospital." ;
    rdfs:subClassOf :Person .

:Union a owl:Class ;
    rdfs:label "Union" ;
    rdfs:comment "A union organizing hospital staff." .

:UnionMembership a owl:Class ;
    rdfs:label "Union Membership" ;
    rdfs:comment "A reified membership relation between a person and a union, possibly with role and time." .

:UnionRole a owl:Class ;
    rdfs:label "Union Role" ;
    rdfs:comment "A role held by a person within a union." .

:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:comment "A hospital facility." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where a hospital may be located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country where a city may be located." .

:DegreeAcquisition a owl:Class ;
    rdfs:label "Degree Acquisition" ;
    rdfs:comment "A reified event of a person acquiring a medical degree, with time and institution." .

:MedicalDegree a owl:Class ;
    rdfs:label "Medical Degree" ;
    rdfs:comment "A degree in a medical field." .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A reified employment relation between a person and a hospital, with start date." .

:EvaluationStatement a owl:Class ;
    rdfs:label "Evaluation Statement" ;
    rdfs:comment "A statement written by a doctor evaluating an employee." .

:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A research article authored by persons." .

:ArticleCollection a owl:Class ;
    rdfs:label "Article Collection" ;
    rdfs:comment "A collection of articles, e.g., a book or CD." .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A book containing articles." ;
    rdfs:subClassOf :ArticleCollection ;
    owl:disjointWith :CD .

:CD a owl:Class ;
    rdfs:label "CD" ;
    rdfs:comment "A CD containing articles." ;
    rdfs:subClassOf :ArticleCollection .

:Seminar a owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A seminar event where articles are presented." .

#################################################################
# Object Properties and Inverses
#################################################################

:hasDegreeAcquisition a owl:ObjectProperty ;
    rdfs:label "has degree acquisition" ;
    rdfs:comment "Links a person to their degree acquisition event." ;
    rdfs:domain :Person ;
    rdfs:range :DegreeAcquisition ;
    owl:inverseOf :degreeAcquisitionOf .

:degreeAcquisitionOf a owl:ObjectProperty ;
    rdfs:label "degree acquisition of" ;
    rdfs:comment "Inverse: links a degree acquisition event to the person." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range :Person ;
    owl:inverseOf :hasDegreeAcquisition .

:acquiredDegree a owl:ObjectProperty ;
    rdfs:label "acquired degree" ;
    rdfs:comment "Links a degree acquisition to the degree obtained." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range :MedicalDegree ;
    owl:inverseOf :isDegreeOfAcquisition .

:isDegreeOfAcquisition a owl:ObjectProperty ;
    rdfs:label "is degree of acquisition" ;
    rdfs:comment "Inverse: links a medical degree to the acquisition event." ;
    rdfs:domain :MedicalDegree ;
    rdfs:range :DegreeAcquisition ;
    owl:inverseOf :acquiredDegree .

:studiedAt a owl:ObjectProperty ;
    rdfs:label "studied at" ;
    rdfs:comment "Links a degree acquisition event to the hospital where study occurred." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range :Hospital ;
    owl:inverseOf :wasStudyLocationFor .

:wasStudyLocationFor a owl:ObjectProperty ;
    rdfs:label "was study location for" ;
    rdfs:comment "Inverse: links a hospital to degree acquisition events." ;
    rdfs:domain :Hospital ;
    rdfs:range :DegreeAcquisition ;
    owl:inverseOf :studiedAt .

:hasEmployment a owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:comment "Links a person to an employment event." ;
    rdfs:domain :Person ;
    rdfs:range :Employment ;
    owl:inverseOf :employmentOf .

:employmentOf a owl:ObjectProperty ;
    rdfs:label "employment of" ;
    rdfs:comment "Inverse: links an employment event to the person." ;
    rdfs:domain :Employment ;
    rdfs:range :Person ;
    owl:inverseOf :hasEmployment .

:employedAt a owl:ObjectProperty ;
    rdfs:label "employed at" ;
    rdfs:comment "Links an employment event to a hospital." ;
    rdfs:domain :Employment ;
    rdfs:range :Hospital ;
    owl:inverseOf :hasEmployeeEmployment .

:hasEmployeeEmployment a owl:ObjectProperty ;
    rdfs:label "has employee employment" ;
    rdfs:comment "Inverse: links a hospital to employment events." ;
    rdfs:domain :Hospital ;
    rdfs:range :Employment ;
    owl:inverseOf :employedAt .

:locatedInCity a owl:ObjectProperty ;
    rdfs:label "located in city" ;
    rdfs:comment "Links a hospital to a city." ;
    rdfs:domain :Hospital ;
    rdfs:range :City ;
    owl:inverseOf :hasHospital .

:hasHospital a owl:ObjectProperty ;
    rdfs:label "has hospital" ;
    rdfs:comment "Inverse: links a city to hospitals." ;
    rdfs:domain :City ;
    rdfs:range :Hospital ;
    owl:inverseOf :locatedInCity .

:locatedInCountry a owl:ObjectProperty ;
    rdfs:label "located in country" ;
    rdfs:comment "Links a city to a country." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :hasCity .

:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Inverse: links a country to cities." ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    owl:inverseOf :locatedInCountry .

:hasUnionMembership a owl:ObjectProperty ;
    rdfs:label "has union membership" ;
    rdfs:comment "Links a person to a union membership event." ;
    rdfs:domain :Person ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionMembershipOf .

:unionMembershipOf a owl:ObjectProperty ;
    rdfs:label "union membership of" ;
    rdfs:comment "Inverse: links a union membership to the person." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasUnionMembership .

:unionMemberOf a owl:ObjectProperty ;
    rdfs:label "union member of" ;
    rdfs:comment "Links a union membership to the union." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Union ;
    owl:inverseOf :hasUnionMember .

:hasUnionMember a owl:ObjectProperty ;
    rdfs:label "has union member" ;
    rdfs:comment "Inverse: links a union to union membership events." ;
    rdfs:domain :Union ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionMemberOf .

:unionRole a owl:ObjectProperty ;
    rdfs:label "union role" ;
    rdfs:comment "Links a union membership to a union role." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :UnionRole ;
    owl:inverseOf :roleOfMembership .

:roleOfMembership a owl:ObjectProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Inverse: links a union role to union memberships." ;
    rdfs:domain :UnionRole ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionRole .

:hasEvaluationStatement a owl:ObjectProperty ;
    rdfs:label "has evaluation statement" ;
    rdfs:comment "Links an employee to their evaluation statement." ;
    rdfs:domain :Employee ;
    rdfs:range :EvaluationStatement ;
    owl:inverseOf :evaluationOf .

:evaluationOf a owl:ObjectProperty ;
    rdfs:label "evaluation of" ;
    rdfs:comment "Inverse: links an evaluation statement to the employee." ;
    rdfs:domain :EvaluationStatement ;
    rdfs:range :Employee ;
    owl:inverseOf :hasEvaluationStatement .

:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluated by" ;
    rdfs:comment "Links an evaluation statement to the doctor." ;
    rdfs:domain :EvaluationStatement ;
    rdfs:range :Doctor ;
    owl:inverseOf :hasEvaluationWritten .

:hasEvaluationWritten a owl:ObjectProperty ;
    rdfs:label "has evaluation written" ;
    rdfs:comment "Inverse: links a doctor to evaluation statements they wrote." ;
    rdfs:domain :Doctor ;
    rdfs:range :EvaluationStatement ;
    owl:inverseOf :evaluatedBy .

:evaluatesEmployee a owl:ObjectProperty ;
    rdfs:label "evaluates employee" ;
    rdfs:comment "Links an evaluation statement to the employee evaluated." ;
    rdfs:domain :EvaluationStatement ;
    rdfs:range :Employee ;
    owl:inverseOf :isEvaluatedByStatement .

:isEvaluatedByStatement a owl:ObjectProperty ;
    rdfs:label "is evaluated by statement" ;
    rdfs:comment "Inverse: links an employee to evaluation statements they are evaluated in." ;
    rdfs:domain :Employee ;
    rdfs:range :EvaluationStatement ;
    owl:inverseOf :evaluatesEmployee .

:hasArticle a owl:ObjectProperty ;
    rdfs:label "has article" ;
    rdfs:comment "Links an article collection to an article." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Article ;
    owl:inverseOf :isArticleIn .

:isArticleIn a owl:ObjectProperty ;
    rdfs:label "is article in" ;
    rdfs:comment "Inverse: links an article to the collection it is in." ;
    rdfs:domain :Article ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :hasArticle .

:publishedAsBook a owl:ObjectProperty ;
    rdfs:label "published as book" ;
    rdfs:comment "Links an article collection to a book version." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Book ;
    owl:inverseOf :bookPublicationOf .

:bookPublicationOf a owl:ObjectProperty ;
    rdfs:label "book publication of" ;
    rdfs:comment "Inverse: links a book to the article collection it publishes." ;
    rdfs:domain :Book ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :publishedAsBook .

:publishedAsCD a owl:ObjectProperty ;
    rdfs:label "published as CD" ;
    rdfs:comment "Links an article collection to a CD version." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :CD ;
    owl:inverseOf :cdPublicationOf .

:cdPublicationOf a owl:ObjectProperty ;
    rdfs:label "CD publication of" ;
    rdfs:comment "Inverse: links a CD to the article collection it publishes." ;
    rdfs:domain :CD ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :publishedAsCD .

:presentedInSeminar a owl:ObjectProperty ;
    rdfs:label "presented in seminar" ;
    rdfs:comment "Links an article to a seminar in which it is presented." ;
    rdfs:domain :Article ;
    rdfs:range :Seminar ;
    owl:inverseOf :hasPresentedArticle .

:hasPresentedArticle a owl:ObjectProperty ;
    rdfs:label "has presented article" ;
    rdfs:comment "Inverse: links a seminar to articles presented in it." ;
    rdfs:domain :Seminar ;
    rdfs:range :Article ;
    owl:inverseOf :presentedInSeminar .

:seminarLocation a owl:ObjectProperty ;
    rdfs:label "seminar location" ;
    rdfs:comment "Links a seminar to the hospital where it takes place." ;
    rdfs:domain :Seminar ;
    rdfs:range :Hospital ;
    owl:inverseOf :isSeminarLocationOf .

:isSeminarLocationOf a owl:ObjectProperty ;
    rdfs:label "is seminar location of" ;
    rdfs:comment "Inverse: links a hospital to seminars held there." ;
    rdfs:domain :Hospital ;
    rdfs:range :Seminar ;
    owl:inverseOf :seminarLocation .

:articleAuthor a owl:ObjectProperty ;
    rdfs:label "article author" ;
    rdfs:comment "Author of an article." ;
    rdfs:domain :Article ;
    rdfs:range :Person ;
    owl:inverseOf :authorOfArticle .

:authorOfArticle a owl:ObjectProperty ;
    rdfs:label "author of article" ;
    rdfs:comment "Inverse: links a person to articles they authored." ;
    rdfs:domain :Person ;
    rdfs:range :Article ;
    owl:inverseOf :articleAuthor .

#################################################################
# Data Properties
#################################################################

:degreeTitle a owl:DatatypeProperty ;
    rdfs:label "degree title" ;
    rdfs:comment "The title of a medical degree." ;
    rdfs:domain :MedicalDegree ;
    rdfs:range xsd:string .

:studyPeriodStart a owl:DatatypeProperty ;
    rdfs:label "study period start" ;
    rdfs:comment "Start date of a degree acquisition." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range xsd:date .

:studyPeriodEnd a owl:DatatypeProperty ;
    rdfs:label "study period end" ;
    rdfs:comment "End date of a degree acquisition." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range xsd:date .

:employmentStartDate a owl:DatatypeProperty ;
    rdfs:label "employment start date" ;
    rdfs:comment "Start date of an employment event." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:date .

:evaluationText a owl:DatatypeProperty ;
    rdfs:label "evaluation text" ;
    rdfs:comment "Text of an evaluation statement." ;
    rdfs:domain :EvaluationStatement ;
    rdfs:range xsd:string .

:bookPageCount a owl:DatatypeProperty ;
    rdfs:label "book page count" ;
    rdfs:comment "Number of pages in a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer .

:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publication date" ;
    rdfs:comment "Publication date of a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:date .

:cdPublicationDate a owl:DatatypeProperty ;
    rdfs:label "CD publication date" ;
    rdfs:comment "Publication date of a CD." ;
    rdfs:domain :CD ;
    rdfs:range xsd:date .

:seminarDate a owl:DatatypeProperty ;
    rdfs:label "seminar date" ;
    rdfs:comment "Date of a seminar." ;
    rdfs:domain :Seminar ;
    rdfs:range xsd:date .

:articleTitle a owl:DatatypeProperty ;
    rdfs:label "article title" ;
    rdfs:comment "Title of an article." ;
    rdfs:domain :Article ;
    rdfs:range xsd:string .

#################################################################
# Restrictions & GCAs
#################################################################

# At least one article is presented at each seminar
[ a owl:Class ;
  owl:intersectionOf (
    :Seminar
    [ a owl:Restriction ;
      owl:onProperty :presentedInSeminar ;
      owl:someValuesFrom :Article ]
  )
] rdfs:subClassOf :Seminar .
