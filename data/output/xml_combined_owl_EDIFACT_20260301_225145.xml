Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>A message representing an invoice (e.g., INVOIC).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:subClassOf rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb1"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Relates an organization to its address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment within a message, such as BGM or NAD.</rdfs:comment>    <owl:disjointUnionOf rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb4"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddressLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has address line</rdfs:label>    <rdfs:comment>A line of an address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Relates an invoice message to its line items.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isLineItemOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationAssignedTo">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is organization assigned to</rdfs:label>    <rdfs:comment>Inverse of assignedOrganization: relates an organization to its role assignments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#RoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse of hasSegment: relates a segment to its message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an interchange envelope to the message(s) it contains.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>An item being sold in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has tax</rdfs:label>    <rdfs:comment>Relates an invoice message to its tax information.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Tax"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isTaxOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTaxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has tax amount</rdfs:label>    <rdfs:comment>The amount of tax in the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb2">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#assignedRole"/>    <owl:allValuesFrom rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb4">    <rdf:first rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdf:rest rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb5"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is price of</rdfs:label>    <rdfs:comment>Inverse of hasPrice: relates a price to the line item it is for.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is identifier of</rdfs:label>    <rdfs:comment>Inverse of hasIdentifier: relates an identifier to its organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb5">    <rdf:first rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdf:rest rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb6"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Detail Section</rdfs:label>    <rdfs:comment>The detail section of an invoice, containing line items.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#HeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Header Section</rdfs:label>    <rdfs:comment>The header section of an invoice, containing dates and reference numbers.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#DetailSection"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a message to its segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Summary Section</rdfs:label>    <rdfs:comment>The summary section of an invoice, containing totals and taxes.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignedTo">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role assigned to</rdfs:label>    <rdfs:comment>Inverse of assignedRole: relates an agent role to role assignments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#RoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role assignment of</rdfs:label>    <rdfs:comment>Inverse of hasRoleAssignment: relates a role assignment to its invoice message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#RoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb6">    <rdf:first rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>An identifier such as a Global Location Number (GLN).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationInvolvedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is organization involved in</rdfs:label>    <rdfs:comment>Inverse of involvesOrganization: relates an organization to invoice messages it is involved in.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>A line item in an invoice, describing an item, quantity, and price.</rdfs:comment>    <rdfs:subClassOf rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb3"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is line item of</rdfs:label>    <rdfs:comment>Inverse of hasLineItem: relates a line item to its invoice message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Relates a line item to its price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Inverse of containsMessage: relates a message to its interchange envelope.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is address of</rdfs:label>    <rdfs:comment>Inverse of hasAddress: relates an address to the organization it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb3">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#describesItem"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#describesItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>describes item</rdfs:label>    <rdfs:comment>Relates a line item to the item it describes.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDescribedByLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>The quantity of items in a line item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isTaxOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is tax of</rdfs:label>    <rdfs:comment>Inverse of hasTax: relates a tax to the invoice message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#RoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Role Assignment</rdfs:label>    <rdfs:comment>A reified relation connecting an organization, its role, and the invoice context.</rdfs:comment>    <rdfs:subClassOf rdf:nodeID="n7ef18546d7324aca93e2ec5fabe56ccbb2"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>assigned role</rdfs:label>    <rdfs:comment>Relates a role assignment to the agent role.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.or