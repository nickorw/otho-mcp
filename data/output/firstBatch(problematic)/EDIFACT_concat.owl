@prefix : <http://example.org/edifact#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_EDIFACTMessage rdf:type owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured message formatted according to the EDIFACT standard." .

:Cl_Invoice rdf:type owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, indicating products, quantities, and agreed prices." .

:Cl_InvoiceListing rdf:type owl:Class ;
    rdfs:label "Invoice Listing" ;
    rdfs:comment "A reification class representing the inclusion of an Invoice in an EDIFACT message." .

:Cl_BusinessDocument rdf:type owl:Class ;
    rdfs:label "Business Document" ;
    rdfs:comment "A superclass for business-related documents exchanged in messages." .

### Class Hierarchies

:Cl_Invoice rdfs:subClassOf :Cl_BusinessDocument .

### Disjoint Classes

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_EDIFACTMessage owl:disjointWith :Cl_InvoiceListing .
:Cl_Invoice owl:disjointWith :Cl_InvoiceListing .

### Properties

:hasInvoiceListing rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Relates an EDIFACT message to an InvoiceListing (reification node)." .

:listsInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Relates an InvoiceListing to the Invoice it lists in the EDIFACT message." .

:isListedInMessage rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "is listed in message" ;
    rdfs:comment "Inverse of hasInvoiceListing, relates InvoiceListing to the EDIFACT message." ;
    owl:inverseOf :hasInvoiceListing .

:invoiceNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "A unique identifier for the invoice." .

:issueDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "issue date" ;
    rdfs:comment "The date the invoice was issued." .

:totalAmount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal ;
    rdfs:label "total amount" ;
    rdfs:comment "The total amount of the invoice." .

### Property Hierarchies

:hasBusinessDocument rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_BusinessDocument ;
    rdfs:label "has business document" ;
    rdfs:comment "Relates an EDIFACT message to any included business document." .

:hasInvoiceListing rdfs:subPropertyOf :hasBusinessDocument .

### Restrictions

:Cl_EDIFACTMessage owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceListing ;
        owl:allValuesFrom :Cl_InvoiceListing
    ]
] .

:Cl_InvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :listsInvoice ;
        owl:allValuesFrom :Cl_Invoice
    ] ;
    owl:Restriction [
        owl:onProperty :isListedInMessage ;
        owl:allValuesFrom :Cl_EDIFACTMessage
    ]
] .

### General Class Axioms

[ rdf:type owl:Restriction ;
  owl:onProperty :listsInvoice ;
  owl:someValuesFrom :Cl_Invoice ;
  rdfs:subClassOf :Cl_InvoiceListing
] .

### Disjoint Union

:Cl_BusinessDocument owl:disjointUnionOf ( :Cl_Invoice ) .

### Example Query (for reference, not part of the ontology)
# To answer the competency question "What invoices are all listed in an EDIFACT message?", 
# query for all :Cl_Invoice linked via :listsInvoice to :Cl_InvoiceListing, which is linked via :hasInvoiceListing to a given :Cl_EDIFACTMessage.
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Entity a owl:Class .
:Cl_Organization a owl:Class ; rdfs:subClassOf :Cl_Entity .
:Cl_Invoice a owl:Class .
:Cl_InvoiceParticipation a owl:Class .   # Pivot class for reification
:Cl_Role a owl:Class .

### Class Hierarchies

:Cl_Supplier a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Customer a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Payer a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Payee a owl:Class ; rdfs:subClassOf :Cl_Organization .

### Properties

# Object Properties
:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Role .

:hasParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

# Role Properties
:isSupplierRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_Supplier .

:isCustomerRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_Customer .

:isPayerRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_Payer .

:isPayeeRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_Payee .

### Restrictions

# Every Cl_InvoiceParticipation must involve an organization and an invoice
:Cl_InvoiceParticipation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:someValuesFrom :Cl_Organization
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesInvoice ;
    owl:someValuesFrom :Cl_Invoice
] .

# Each Cl_Invoice must have at least one participation (organization involved)
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasParticipation ;
    owl:someValuesFrom :Cl_InvoiceParticipation
] .

### Disjointness

:Cl_Supplier owl:disjointWith :Cl_Customer, :Cl_Payer, :Cl_Payee .
:Cl_Customer owl:disjointWith :Cl_Payer, :Cl_Payee .
:Cl_Payer owl:disjointWith :Cl_Payee .

### Equivalency (Optional, if roles are strictly mapped)

:Cl_Supplier owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :isSupplierRole ;
    owl:someValuesFrom :Cl_Role
] .

:Cl_Customer owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :isCustomerRole ;
    owl:someValuesFrom :Cl_Role
] .

:Cl_Payer owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :isPayerRole ;
    owl:someValuesFrom :Cl_Role
] .

:Cl_Payee owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :isPayeeRole ;
    owl:someValuesFrom :Cl_Role
] .

### Example Query Pattern (for the competency question)
# To answer: "Which organizations are involved in the invoice?"
# Query for all :involvesOrganization where there exists a :Cl_InvoiceParticipation linked to the :Cl_Invoice of interest.

# Example instance (not required but illustrative):
#:invoice1 a :Cl_Invoice .
#:orgA a :Cl_Supplier .
#:participation1 a :Cl_InvoiceParticipation ;
#    :involvesOrganization :orgA ;
#    :involvesInvoice :invoice1 ;
#    :hasRole :roleSupplier .
#:roleSupplier a :Cl_Role ; :isSupplierRole :orgA .
@prefix : <http://example.org/invoice#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes
:Cl_Entity a owl:Class .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRole a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_OrganizationInvoiceParticipation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

### Hierarchies
# Cl_Entity is the root class for all entities.
# Cl_Organization and Cl_Invoice are subclasses.
# Cl_OrganizationInvoiceParticipation is a reification class (pivot class) for modeling the role of an organization in an invoice.

### Properties

# Object Properties
:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_OrganizationInvoiceParticipation .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceParticipation ;
    rdfs:range :Cl_Organization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

# Data Properties
:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string .

### Example Restriction (Only Cl_OrganizationInvoiceParticipation uses hasRole)
:Cl_OrganizationInvoiceParticipation owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasRole ;
    owl:allValuesFrom :Cl_InvoiceRole
] .

### Disjointness
:Cl_Organization owl:disjointWith :Cl_Invoice .
:Cl_Organization owl:disjointWith :Cl_InvoiceRole .
:Cl_Invoice owl:disjointWith :Cl_InvoiceRole .

### Explanation
# To answer "What role does organization S play in the invoice?", 
# look for the :Cl_OrganizationInvoiceParticipation instance that links the organization and the invoice, and retrieve its :hasRole property.
@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

:Cl_Organization rdf:type owl:Class .

:Cl_Company rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Supplier rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Buyer rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Invoice rdf:type owl:Class .

:Cl_InvoiceRole rdf:type owl:Class . # Pivot/reification class for role of an organization in an invoice

:Cl_InvoiceBuyerRole rdf:type owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_InvoiceSupplierRole rdf:type owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

#################################################################
# Properties
#################################################################

# Object properties

:hasInvoiceRole rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole .

:roleHeldBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization .

:roleOfInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceRole .

# Subproperties for specific roles

:hasBuyerRole rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasInvoiceRole ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceBuyerRole .

:hasSupplierRole rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasInvoiceRole ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceSupplierRole .

:buyerRoleHeldBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :roleHeldBy ;
    rdfs:domain :Cl_InvoiceBuyerRole ;
    rdfs:range :Cl_Buyer .

:supplierRoleHeldBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :roleHeldBy ;
    rdfs:domain :Cl_InvoiceSupplierRole ;
    rdfs:range :Cl_Supplier .

#################################################################
# Restrictions / Axioms
#################################################################

# An InvoiceBuyerRole must be held by a Cl_Buyer
:Cl_InvoiceBuyerRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerRoleHeldBy ;
          owl:allValuesFrom :Cl_Buyer
        ]
    )
] .

# An InvoiceSupplierRole must be held by a Cl_Supplier
:Cl_InvoiceSupplierRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ rdf:type owl:Restriction ;
          owl:onProperty :supplierRoleHeldBy ;
          owl:allValuesFrom :Cl_Supplier
        ]
    )
] .

# An Invoice has at least one buyer role
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasBuyerRole ;
    owl:someValuesFrom :Cl_InvoiceBuyerRole
] .

# Disjointness
:Cl_Buyer owl:disjointWith :Cl_Supplier .
:Cl_InvoiceBuyerRole owl:disjointWith :Cl_InvoiceSupplierRole .

#################################################################
# Example Query Answering the Competency Question
# "Which organization is the buyer in the invoice?"
# (Given an invoice :Invoice1, find ?org where:
# :Invoice1 :hasBuyerRole ?buyerRole .
# ?buyerRole :buyerRoleHeldBy ?org . )
#################################################################
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#################################################################
# Classes
#################################################################

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, agency, or institution involved in the described scenario." .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:comment "The classification or type of organization (e.g., government agency, private company)." .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "A role played by an organization in a specific context or event." .

:Cl_OrganizationInvolvement a owl:Class ;
    rdfs:label "Organization Involvement" ;
    rdfs:comment "A reification class representing the involvement of an organization in an event or context, capturing its role and additional information." .

:Cl_ContactInfo a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact details for an organization." .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "A unique identifier for an organization." .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "The physical or mailing address of the organization." .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A textual description of the organization." .

#################################################################
# Hierarchies
#################################################################

:Cl_OrganizationIdentifier rdfs:subClassOf :Cl_Organization .
:Cl_OrganizationLocation rdfs:subClassOf :Cl_Organization .
:Cl_ContactInfo rdfs:subClassOf :Cl_Organization .
:Cl_OrganizationDescription rdfs:subClassOf :Cl_Organization .

#################################################################
# Properties
#################################################################

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationType ;
    rdfs:label "has organization type" .

:hasOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_OrganizationRole ;
    rdfs:label "has organization role" .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" .

:hasContactInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_ContactInfo ;
    rdfs:label "has contact info" .

:hasOrganizationIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationIdentifier ;
    rdfs:label "has organization identifier" .

:hasOrganizationLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationLocation ;
    rdfs:label "has organization location" .

:hasDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationDescription ;
    rdfs:label "has description" .

:involvementDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range xsd:string ;
    rdfs:label "involvement description" .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" .

:organizationShortName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization short name" .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" .

:identifierType a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier type" .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact email" .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact phone" .

:contactWebsite a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact website" .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "address line" .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "city" .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "postal code" .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "country" .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range xsd:string ;
    rdfs:label "description text" .

#################################################################
# Restrictions (examples)
#################################################################

:Cl_Organization
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasOrganizationType ;
        owl:allValuesFrom :Cl_OrganizationType
    ] ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasOrganizationIdentifier ;
        owl:someValuesFrom :Cl_OrganizationIdentifier
    ] .

:Cl_OrganizationInvolvement
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :involvesOrganization ;
        owl:allValuesFrom :Cl_Organization
    ] ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasOrganizationRole ;
        owl:someValuesFrom :Cl_OrganizationRole
    ] .

#################################################################
# Disjointness
#################################################################

:Cl_OrganizationType owl:disjointWith :Cl_OrganizationRole .
:Cl_ContactInfo owl:disjointWith :Cl_OrganizationLocation .
:Cl_OrganizationIdentifier owl:disjointWith :Cl_OrganizationDescription .

@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes

:Cl_Person a owl:Class .
:Cl_Stakeholder a owl:Class .
:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person, :Cl_Stakeholder .
:Cl_Seller a owl:Class ;
    rdfs:subClassOf :Cl_Person, :Cl_Stakeholder .
:Cl_Address a owl:Class .
:Cl_BuyerAddressAssignment a owl:Class . # Pivot/reification class for Buyer-Address association

### Disjointness

:Cl_Buyer owl:disjointWith :Cl_Seller .

### Properties

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address .

:buyerAddressAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    owl:inverseOf :hasBuyer .

:assignedToBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :buyerAddressAssignment .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

### Restrictions

:Cl_BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

### Comments

# This ontology allows answering the competency question: "What is the address of the buyer?"
# by linking a Cl_Buyer to a Cl_Address via the Cl_BuyerAddressAssignment pivot class. This supports extensibility
# for possible additional properties such as address validity, address type, etc.
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Classes

:Cl_Invoice rdf:type owl:Class .
:Cl_Item rdf:type owl:Class .
:Cl_InvoiceLine rdf:type owl:Class .
:Cl_InvoiceLine rdf:type owl:Class ; rdfs:subClassOf :Cl_InvoiceComponent .
:Cl_InvoiceComponent rdf:type owl:Class .
:Cl_Product rdf:type owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_Service rdf:type owl:Class ; rdfs:subClassOf :Cl_Item .

# Disjointness
:Cl_Product owl:disjointWith :Cl_Service .

# Properties

:hasInvoiceLine rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:quantity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:totalLineAmount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:invoiceNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:issueDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:itemName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

# Hierarchy for Invoice Components (if more types in future)
:Cl_InvoiceLine rdfs:subClassOf :Cl_InvoiceComponent .

# Equivalent Class for Items Sold in Invoice (for CQ)
# An item is sold in an invoice if there is an invoice line in that invoice that refers to the item.

:Cl_ItemSoldInInvoice rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Cl_Item
            [
                rdf:type owl:Restriction ;
                owl:onProperty [
                    owl:inverseOf :refersToItem
                ] ;
                owl:someValuesFrom [
                    rdf:type owl:Restriction ;
                    owl:onProperty [
                        owl:inverseOf :hasInvoiceLine
                    ] ;
                    owl:someValuesFrom :Cl_Invoice
                ]
            ]
        )
    ] .

# General Class Axiom: Every invoice has at least one invoice line
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

# General Class Axiom: Every invoice line refers to exactly one item
:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] .

# Disjoint Union (if needed for items)
:Cl_Item owl:disjointUnionOf ( :Cl_Product :Cl_Service ) .

@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Item rdf:type owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Represents an item that is sold." .

:Cl_Sale rdf:type owl:Class ;
    rdfs:label "Sale" ;
    rdfs:comment "Represents a sale event of an item." .

:Cl_ItemDisplayInformation rdf:type owl:Class ;
    rdfs:label "Item Display Information" ;
    rdfs:comment "Reification class capturing the information displayed about items sold." .

:Cl_Information rdf:type owl:Class ;
    rdfs:label "Information" ;
    rdfs:comment "General class for information entities." .

:Cl_ItemAttribute rdf:type owl:Class ;
    rdfs:label "Item Attribute" ;
    rdfs:comment "Superclass for all attributes of an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_ItemName rdf:type owl:Class ;
    rdfs:label "Item Name" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemPrice rdf:type owl:Class ;
    rdfs:label "Item Price" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemDescription rdf:type owl:Class ;
    rdfs:label "Item Description" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemCategory rdf:type owl:Class ;
    rdfs:label "Item Category" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemImage rdf:type owl:Class ;
    rdfs:label "Item Image" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemSKU rdf:type owl:Class ;
    rdfs:label "Item SKU" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemStockStatus rdf:type owl:Class ;
    rdfs:label "Item Stock Status" ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemRating rdf:type owl:Class ;
    rdfs:label "Item Rating" ;
    rdfs:subClassOf :Cl_ItemAttribute .

### Hierarchies

:Cl_ItemAttribute rdfs:subClassOf :Cl_Information .

### Pivot/Reification Class

:Cl_ItemDisplayInformation rdf:type owl:Class ;
    rdfs:label "Item Display Information" ;
    rdfs:subClassOf :Cl_Information .

### Properties

:displayedInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemDisplayInformation ;
    rdfs:label "displayed information" ;
    rdfs:comment "Connects an item to its displayed information." .

:hasAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInformation ;
    rdfs:range :Cl_ItemAttribute ;
    rdfs:label "has attribute" ;
    rdfs:comment "Connects item display information to its attributes." .

:itemOf a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInformation ;
    rdfs:range :Cl_Item ;
    owl:inverseOf :displayedInformation ;
    rdfs:label "item of" .

:itemNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemName ;
    rdfs:range xsd:string ;
    rdfs:label "item name value" .

:itemPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price value" .

:itemDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemDescription ;
    rdfs:range xsd:string ;
    rdfs:label "item description value" .

:itemCategoryValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemCategory ;
    rdfs:range xsd:string ;
    rdfs:label "item category value" .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:anyURI ;
    rdfs:label "item image URL" .

:itemSKUValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemSKU ;
    rdfs:range xsd:string ;
    rdfs:label "item SKU value" .

:itemStockStatusValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemStockStatus ;
    rdfs:range xsd:string ;
    rdfs:label "item stock status value" .

:itemRatingValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemRating ;
    rdfs:range xsd:float ;
    rdfs:label "item rating value" .

### Restrictions

:Cl_ItemDisplayInformation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :itemOf ;
          owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasAttribute ;
          owl:someValuesFrom :Cl_ItemAttribute ]
    )
] .

### Disjointness

:Cl_ItemName owl:disjointWith :Cl_ItemPrice, :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage, :Cl_ItemSKU, :Cl_ItemStockStatus, :Cl_ItemRating .
:Cl_ItemPrice owl:disjointWith :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage, :Cl_ItemSKU, :Cl_ItemStockStatus, :Cl_ItemRating .
:Cl_ItemDescription owl:disjointWith :Cl_ItemCategory, :Cl_ItemImage, :Cl_ItemSKU, :Cl_ItemStockStatus, :Cl_ItemRating .
:Cl_ItemCategory owl:disjointWith :Cl_ItemImage, :Cl_ItemSKU, :Cl_ItemStockStatus, :Cl_ItemRating .
:Cl_ItemImage owl:disjointWith :Cl_ItemSKU, :Cl_ItemStockStatus, :Cl_ItemRating .
:Cl_ItemSKU owl:disjointWith :Cl_ItemStockStatus, :Cl_ItemRating .
:Cl_ItemStockStatus owl:disjointWith :Cl_ItemRating .

### General Class Axioms

[ rdf:type owl:Restriction ;
  owl:onProperty :hasAttribute ;
  owl:someValuesFrom :Cl_ItemAttribute ;
  rdfs:subClassOf :Cl_ItemDisplayInformation ] .

### Notes

# This ontology structure allows answering the competency question: "What information is displayed about the items sold?"
# The pivot class Cl_ItemDisplayInformation connects each Cl_Item to the displayed attributes (name, price, description, etc.), and each attribute class captures the value of that information via datatype properties.
@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Invoice rdf:type owl:Class .
:Cl_Item rdf:type owl:Class .
:Cl_InvoiceLine rdf:type owl:Class .
:Cl_Price rdf:type owl:Class .
:Cl_Currency rdf:type owl:Class .
:Cl_Amount rdf:type owl:Class .
:Cl_NetPrice rdf:type owl:Class .
:Cl_Total rdf:type owl:Class .

# Hierarchy
:Cl_Price rdfs:subClassOf :Cl_Amount .
:Cl_NetPrice rdfs:subClassOf :Cl_Price .
:Cl_Total rdfs:subClassOf :Cl_Amount .

# Reification class for the sale of an item in an invoice (pivot class)
:Cl_InvoiceLine rdf:type owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in an invoice representing the sale of a specific item, its quantity, and net price." .

### Properties

# Object Properties

:hasInvoiceLine rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasNetPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice .

:hasCurrency rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range :Cl_Currency .

:hasTotalNetPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Total .

# Data Properties

:quantity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitNetPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal .

:totalNetPriceValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Total ;
    rdfs:range xsd:decimal .

:currencyCode rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

### Restrictions

# Each Cl_InvoiceLine must have exactly one Cl_Item
:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_InvoiceLine must have exactly one Cl_NetPrice
:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_NetPrice must have exactly one unitNetPrice
:Cl_NetPrice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :unitNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_Total must have exactly one totalNetPriceValue
:Cl_Total rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :totalNetPriceValue ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_Invoice can have multiple Cl_InvoiceLines
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_Invoice must have exactly one Cl_Total as total net price
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTotalNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

### Disjointness

:Cl_Invoice owl:disjointWith :Cl_Item, :Cl_InvoiceLine, :Cl_Price, :Cl_Currency, :Cl_Total .

:Cl_Item owl:disjointWith :Cl_InvoiceLine, :Cl_Price, :Cl_Currency, :Cl_Total .

:Cl_InvoiceLine owl:disjointWith :Cl_Price, :Cl_Currency, :Cl_Total .

:Cl_Price owl:disjointWith :Cl_Currency, :Cl_Total .

:Cl_Currency owl:disjointWith :Cl_Total .

### Equivalent Class (General Class Axiom)

# The class Cl_Total is equivalent to the total net price of all items sold in the invoice.
:Cl_Total owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Amount
        [ rdf:type owl:Restriction ;
          owl:onProperty :totalNetPriceValue ;
          owl:someValuesFrom xsd:decimal
        ]
    )
] .

### Annotation for Competency Question

# The net price of the items sold in the invoice can be obtained by traversing:
# Cl_Invoice --hasInvoiceLine--> Cl_InvoiceLine --hasNetPrice--> Cl_NetPrice --unitNetPrice--> xsd:decimal
# and sum (unitNetPrice * quantity) for all Cl_InvoiceLine, or directly via:
# Cl_Invoice --hasTotalNetPrice--> Cl_Total --totalNetPriceValue--> xsd:decimal

# End of ontology for competency question: "What is the net price of the items sold in the invoice?"
@prefix : <http://example.org/invoice#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#################################################################
# Classes
#################################################################

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued to indicate and request payment for goods or services." .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "A reification class representing the details of an invoice, including items, quantities, prices, etc." .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "An item listed on an invoice." .

:Cl_ProductOrService a owl:Class ;
    rdfs:label "Product or Service" ;
    rdfs:comment "The product or service being invoiced." .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "The currency used in the invoice." .

:Cl_ContactParty a owl:Class ;
    rdfs:label "Contact Party" ;
    rdfs:comment "A party involved in the invoice, such as buyer or seller." .

:Cl_InvoiceStatus a owl:Class ;
    rdfs:label "Invoice Status" ;
    rdfs:comment "The status of the invoice (e.g., paid, unpaid, overdue)." .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "An amount of money." .

:Cl_Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity of items or services." .

:Cl_DateTime a owl:Class ;
    rdfs:label "Date Time" ;
    rdfs:comment "A date and time value." .

#################################################################
# Class Hierarchies
#################################################################

:Cl_InvoiceDetail rdfs:subClassOf :Cl_Invoice .
:Cl_Amount rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_Quantity rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_InvoiceItem rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_ProductOrService rdfs:subClassOf :Cl_InvoiceItem .
:Cl_Currency rdfs:subClassOf :Cl_Amount .

#################################################################
# Properties
#################################################################

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Links an invoice to its details." .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "has invoice item" ;
    rdfs:comment "Links invoice detail to its items." .

:refersToProductOrService a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_ProductOrService ;
    rdfs:label "refers to product or service" ;
    rdfs:comment "Links invoice item to the product or service." .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Quantity ;
    rdfs:label "has quantity" ;
    rdfs:comment "Specifies the quantity for an invoice item." .

:hasUnitPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Amount ;
    rdfs:label "has unit price" ;
    rdfs:comment "Specifies the unit price for an invoice item." .

:hasTotalAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Amount ;
    rdfs:label "has total amount" ;
    rdfs:comment "The total amount of the invoice." .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range :Cl_Currency ;
    rdfs:label "has currency" ;
    rdfs:comment "Specifies the currency for an amount." .

:issuedTo a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_ContactParty ;
    rdfs:label "issued to" ;
    rdfs:comment "The party to whom the invoice is issued." .

:issuedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_ContactParty ;
    rdfs:label "issued by" ;
    rdfs:comment "The party who issued the invoice." .

:hasInvoiceStatus a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceStatus ;
    rdfs:label "has invoice status" ;
    rdfs:comment "The status of the invoice." .

:hasInvoiceDate a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_DateTime ;
    rdfs:label "has invoice date" ;
    rdfs:comment "The date the invoice was issued." .

:hasDueDate a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_DateTime ;
    rdfs:label "has due date" ;
    rdfs:comment "The due date for the invoice payment." .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal ;
    rdfs:label "amount value" ;
    rdfs:comment "The value of an amount." .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:decimal ;
    rdfs:label "quantity value" ;
    rdfs:comment "The value of a quantity." .

:quantityUnit a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:string ;
    rdfs:label "quantity unit" ;
    rdfs:comment "The unit of a quantity (e.g., pcs, hours)." .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string ;
    rdfs:label "currency code" ;
    rdfs:comment "The currency code (e.g., USD, EUR)." .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The unique identifier for the invoice." .

:statusValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceStatus ;
    rdfs:range xsd:string ;
    rdfs:label "status value" ;
    rdfs:comment "The value of the invoice status (e.g., paid, unpaid)." .

:dateTimeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_DateTime ;
    rdfs:range xsd:dateTime ;
    rdfs:label "date time value" ;
    rdfs:comment "The actual date and time value." .

:partyName a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactParty ;
    rdfs:range xsd:string ;
    rdfs:label "party name" ;
    rdfs:comment "The name of the contact party." .

#################################################################
# Restrictions and Axioms
#################################################################

:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:someValuesFrom :Cl_InvoiceDetail
] .

:Cl_InvoiceDetail owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceItem ;
    owl:someValuesFrom :Cl_InvoiceItem
] .

:Cl_InvoiceItem owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :refersToProductOrService ;
    owl:someValuesFrom :Cl_ProductOrService
] .

#################################################################
# Disjointness
#################################################################

:Cl_Invoice owl:disjointWith :Cl_InvoiceItem, :Cl_InvoiceDetail, :Cl_ProductOrService, :Cl_ContactParty, :Cl_Currency, :Cl_InvoiceStatus, :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_InvoiceDetail owl:disjointWith :Cl_InvoiceItem, :Cl_ProductOrService, :Cl_ContactParty, :Cl_Currency, :Cl_InvoiceStatus, :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_InvoiceItem owl:disjointWith :Cl_ProductOrService, :Cl_ContactParty, :Cl_Currency, :Cl_InvoiceStatus, :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_ProductOrService owl:disjointWith :Cl_ContactParty, :Cl_Currency, :Cl_InvoiceStatus, :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_ContactParty owl:disjointWith :Cl_Currency, :Cl_InvoiceStatus, :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_Currency owl:disjointWith :Cl_InvoiceStatus, :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_InvoiceStatus owl:disjointWith :Cl_Amount, :Cl_Quantity, :Cl_DateTime .

:Cl_Amount owl:disjointWith :Cl_Quantity, :Cl_DateTime .

:Cl_Quantity owl:disjointWith :Cl_DateTime .
@prefix : <http://example.org/invoice-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes

:Cl_Document a owl:Class .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_Amount a owl:Class .

:Cl_InvoiceAmountReification a owl:Class ;
    rdfs:comment "Pivot class to reify the relationship between an invoice and its amount." .

### Class Hierarchies

:Cl_Invoice rdfs:subClassOf :Cl_Document .

:Cl_InvoiceAmountReification rdfs:comment "Pivot class to reify the relationship between an invoice and its amount." .

### Properties

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_Invoice ;
    rdfs:comment "Links the reification node to the invoice." .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_Amount ;
    rdfs:comment "Links the reification node to the amount." .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The numeric value of the amount." .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:string ;
    rdfs:comment "The currency of the amount, e.g., USD, EUR." .

### Restrictions

:Cl_InvoiceAmountReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAmount ; owl:someValuesFrom :Cl_Amount ]
    )
] .

### Disjointness

:Cl_Invoice owl:disjointWith :Cl_Amount .
:Cl_InvoiceAmountReification owl:disjointWith :Cl_Invoice .
:Cl_InvoiceAmountReification owl:disjointWith :Cl_Amount .

### Example Individual (for illustration, not required by question)

#:Invoice123 a :Cl_Invoice .
#:Amount123 a :Cl_Amount ;
#    :amountValue "1000.00"^^xsd:decimal ;
#    :amountCurrency "USD" .
#:InvoiceAmountReif123 a :Cl_InvoiceAmountReification ;
#    :hasInvoice :Invoice123 ;
#    :hasAmount :Amount123 .

### Notes

# This ontology allows answering the competency question "What is the invoice amount of the invoice?"
# by querying for the :amountValue of the :Cl_Amount linked via :Cl_InvoiceAmountReification
# to a given :Cl_Invoice.
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### Classes
:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued to indicate a transaction, typically listing products, quantities, prices, and payment terms." .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "A unique identifier/number assigned to an invoice, used for reference and tracking." .

:Cl_InvoiceReification a owl:Class ;
    rdfs:label "Invoice Reification" ;
    rdfs:comment "A reification class to connect an invoice with its invoice number, enabling flexible modeling for more complex scenarios." .

### Object Properties
:hasInvoiceIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceReification ;
    rdfs:range :Cl_InvoiceIdentifier ;
    rdfs:label "has invoice identifier" ;
    rdfs:comment "Links an invoice reification to its invoice identifier." .

:aboutInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceReification ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "about invoice" ;
    rdfs:comment "Links an invoice reification to the invoice it describes." .

### Data Properties
:invoiceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value" ;
    rdfs:comment "The literal invoice number as a string." .

### Restrictions & General Class Axioms

# Every Cl_InvoiceReification must be about an invoice and have an invoice identifier
:Cl_InvoiceReification owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :aboutInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceIdentifier ;
          owl:someValuesFrom :Cl_InvoiceIdentifier ]
    )
] .

# The Cl_InvoiceIdentifier is disjoint with Cl_Invoice
:Cl_InvoiceIdentifier owl:disjointWith :Cl_Invoice .

### Example Individuals (optional, for illustration)
#:inv1 a :Cl_Invoice .
#:inv1_id a :Cl_InvoiceIdentifier ;
#    :invoiceNumberValue "INV-2024-001" .
#:inv1_reif a :Cl_InvoiceReification ;
#    :aboutInvoice :inv1 ;
#    :hasInvoiceIdentifier :inv1_id .

# Now, a query like: 
# SELECT ?invNum WHERE {
#   ?reif a :Cl_InvoiceReification ;
#       :aboutInvoice ?invoice ;
#       :hasInvoiceIdentifier ?id .
#   ?id :invoiceNumberValue ?invNum .
#   FILTER (?invoice = :inv1)
# }
# ...will answer "What is the invoice number?" for a given invoice.
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#################################################################
# Classes
#################################################################

:Cl_FileFormat rdf:type owl:Class .
:Cl_FileComponent rdf:type owl:Class .
:Cl_ValidationRequirement rdf:type owl:Class .
:Cl_FileFormatComponentAssignment rdf:type owl:Class .
:Cl_RequiredInformation rdf:type owl:Class .
:Cl_ValidationRule rdf:type owl:Class .
:Cl_InformationType rdf:type owl:Class .

# Hierarchy
:Cl_ValidationRequirement rdfs:subClassOf :Cl_ValidationRule .
:Cl_RequiredInformation rdfs:subClassOf :Cl_InformationType .

# Disjointness
:Cl_FileFormat owl:disjointWith :Cl_FileComponent .
:Cl_FileFormat owl:disjointWith :Cl_ValidationRequirement .
:Cl_FileComponent owl:disjointWith :Cl_ValidationRequirement .
:Cl_RequiredInformation owl:disjointWith :Cl_ValidationRequirement .

#################################################################
# Properties
#################################################################

# Object Properties
:hasComponent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileComponent .

:requiresInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range :Cl_RequiredInformation .

:hasValidationRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_ValidationRequirement .

:hasInformationType rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_InformationType .

:componentAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatComponentAssignment .

:assignsComponent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_FileComponent .

:assignsRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_ValidationRequirement .

:specifiesRequiredInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_RequiredInformation .

# Data Properties
:componentName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_FileComponent ;
    rdfs:range xsd:string .

:informationDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string .

:requirementDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range xsd:string .

:informationTypeName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InformationType ;
    rdfs:range xsd:string .

:formatName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range xsd:string .

#################################################################
# Reification (Pivot Class for Complex Relations)
#################################################################

# Cl_FileFormatComponentAssignment links a FileFormat, FileComponent, ValidationRequirement, and RequiredInformation
:Cl_FileFormatComponentAssignment rdf:type owl:Class ;
    rdfs:label "FileFormatComponentAssignment" ;
    rdfs:comment "Assignment linking a file format, its component, the validation requirement for the component, and the required information." .

# Relations for the pivot class
:assignmentOfFormat rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_FileFormat .

:assignmentOfComponent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_FileComponent .

:assignmentOfRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_ValidationRequirement .

:assignmentOfRequiredInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponentAssignment ;
    rdfs:range :Cl_RequiredInformation .

#################################################################
# Restrictions and Class Axioms
#################################################################

# A valid file format must have at least one validation requirement specifying required information
:Cl_FileFormat owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_FileFormat
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasValidationRequirement ;
          owl:someValuesFrom :Cl_ValidationRequirement
        ]
    )
] .

:Cl_ValidationRequirement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_ValidationRequirement
        [ rdf:type owl:Restriction ;
          owl:onProperty :requiresInformation ;
          owl:someValuesFrom :Cl_RequiredInformation
        ]
    )
] .

:Cl_FileFormatComponentAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_FileFormatComponentAssignment
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignmentOfFormat ;
          owl:someValuesFrom :Cl_FileFormat
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignmentOfComponent ;
          owl:someValuesFrom :Cl_FileComponent
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignmentOfRequirement ;
          owl:someValuesFrom :Cl_ValidationRequirement
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignmentOfRequiredInformation ;
          owl:someValuesFrom :Cl_RequiredInformation
        ]
    )
] .

#################################################################
# Sample Query Answering the Competency Question
#################################################################

# To answer "What information must be provided so that the file format is valid?"
# One can traverse from :Cl_FileFormat via :hasValidationRequirement to :Cl_ValidationRequirement,
# then via :requiresInformation to :Cl_RequiredInformation, and then via :hasInformationType to :Cl_InformationType.

#################################################################
# End of Ontology
#################################################################
@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process, such as procurement, sales, etc." .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice document issued or received in a business process." .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A general class for documents." .

:Cl_Invoice rdfs:subClassOf :Cl_Document .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:label "Invoice Assignment" ;
    rdfs:comment "A reification class representing the assignment of an invoice to a business process." .

#################################################################
# Hierarchies
#################################################################

:Cl_FinancialDocument a owl:Class ;
    rdfs:label "Financial Document" ;
    rdfs:comment "Superclass for all financial documents." .

:Cl_Invoice rdfs:subClassOf :Cl_FinancialDocument .

#################################################################
# Properties
#################################################################

:assignedInvoice a owl:ObjectProperty ;
    rdfs:label "assigned invoice" ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:comment "The invoice being assigned in the context of the assignment." .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:label "assigned business process" ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:comment "The business process to which the invoice is assigned." .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:label "assignment date" ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range xsd:date ;
    rdfs:comment "The date when the invoice was assigned to the business process." .

#################################################################
# Additional Relations and Restrictions
#################################################################

:Cl_InvoiceAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignedInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_InvoiceAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignedBusinessProcess ;
    owl:allValuesFrom :Cl_BusinessProcess
] .

:Cl_InvoiceAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignmentDate ;
    owl:allValuesFrom xsd:date
] .

#################################################################
# Disjointness
#################################################################

:Cl_BusinessProcess owl:disjointWith :Cl_Invoice .
:Cl_BusinessProcess owl:disjointWith :Cl_Document .
:Cl_Invoice owl:disjointWith :Cl_InvoiceAssignment .
:Cl_BusinessProcess owl:disjointWith :Cl_InvoiceAssignment .

#################################################################
# Inverse Properties
#################################################################

:hasInvoiceAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAssignment ;
    owl:inverseOf :assignedInvoice ;
    rdfs:comment "Links an Invoice to its InvoiceAssignment(s)." .

:hasBusinessProcessAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_InvoiceAssignment ;
    owl:inverseOf :assignedBusinessProcess ;
    rdfs:comment "Links a BusinessProcess to its InvoiceAssignment(s)." .

#################################################################
# Equivalent Class (for possible restriction)
#################################################################

:Cl_InvoiceAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :assignedInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .
