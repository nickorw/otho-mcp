#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_EDIFACTMessageInvoiceListing
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :listedInEDIFACTMessage ;
              owl:someValuesFrom :Cl_EDIFACTMessage ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasInvoice ;
              owl:someValuesFrom :Cl_Invoice ]
        )
    ] .

:Cl_InvoiceParticipation
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ;
              owl:onProperty :involvesInvoice ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
              owl:onClass :Cl_Invoice ]
            [ a owl:Restriction ;
              owl:onProperty :involvesOrganization ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
              owl:onClass :Cl_Organization ]
            [ a owl:Restriction ;
              owl:onProperty :hasOrganizationRole ;
              owl:someValuesFrom :Cl_OrganizationRole ]
        )
    ] .

:Cl_InvoiceBuyerRole
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :buyerInRole ;
        owl:allValuesFrom :Cl_Organization
    ] .

:Cl_BuyerAddressAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ; owl:onProperty :buyerInAssignment ; owl:someValuesFrom :Cl_Buyer ]
            [ rdf:type owl:Restriction ; owl:onProperty :addressInAssignment ; owl:someValuesFrom :Cl_Address ]
        )
    ] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Document
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceLine ;
          owl:allValuesFrom :Cl_InvoiceLine
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceLine ;
          owl:someValuesFrom :Cl_InvoiceLine
        ]
        [ a owl:Restriction ;
          owl:onProperty :netPriceOfInvoice ;
          owl:someValuesFrom :Cl_NetPrice
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceDetail ;
          owl:allValuesFrom :Cl_InvoiceDetail
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceNumberAssignment ;
          owl:allValuesFrom :Cl_InvoiceNumberAssignment
        ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :describesItem ;
          owl:allValuesFrom :Cl_Item
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :refersToItem ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Item ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasUnitPrice ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_UnitPrice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasQuantity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Quantity ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasNetPrice ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_NetPrice ]
    )
] .

:Cl_InvoiceDetail owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceItem ;
          owl:allValuesFrom :Cl_InvoiceItem
        ]
    )
] .

:Cl_InvoiceItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :refersToProduct ;
          owl:someValuesFrom :Cl_Product
        ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignmentForInvoice ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :amountOfInvoice ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceNumberAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_Document
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceNumber ;
          owl:allValuesFrom :Cl_InvoiceNumber
        ]
    )
] .

:Cl_FileFormat owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
            owl:onProperty :hasRequirement ;
            owl:someValuesFrom :Cl_FormatRequirement
        ]
        [ rdf:type owl:Restriction ;
            owl:onProperty :hasComponent ;
            owl:someValuesFrom :Cl_FileComponent
        ]
    )
] .

:Cl_FormatRequirement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
            owl:onProperty :requiresInformation ;
            owl:someValuesFrom :Cl_RequiredInformation
        ]
    )
] .

:Cl_FileComponent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
            owl:onProperty :componentDataType ;
            owl:someValuesFrom :Cl_DataType
        ]
    )
] .

:Cl_ItemInformationDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :aboutItem ;
          owl:someValuesFrom :Cl_Item
        ]
        [ a owl:Restriction ;
          owl:onProperty :displayedAttribute ;
          owl:someValuesFrom :Cl_ItemAttribute
        ]
    )
] .

:Cl_Assignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :assignedDocument ;
          owl:someValuesFrom :Cl_Document
        ]
        [ a owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess
        ]
    )
] .

:Cl_Organization owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasOrganizationIdentifier ;
          owl:someValuesFrom :Cl_OrganizationIdentifier
        ]
        [ a owl:Restriction ;
          owl:onProperty :organizationName ;
          owl:allValuesFrom xsd:string
        ]
    )
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:someValuesFrom :Cl_Organization
] .

#################################################################
# General Class Axioms
#################################################################

#################################################################
# End of FestS Ontology
#################################################################