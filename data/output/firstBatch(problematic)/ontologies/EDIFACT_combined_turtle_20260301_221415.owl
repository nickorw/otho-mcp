@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/fests/1.0> ;
    rdfs:label "FestS" .

#################################################################
# Classes
#################################################################

:Cl_Document rdf:type owl:Class ;
    rdfs:label "Document" .

:Cl_Invoice rdf:type owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:subClassOf :Cl_Document .

:Cl_InvoiceAmount rdf:type owl:Class ;
    rdfs:label "Invoice Amount" .

:Cl_InvoiceNumber rdf:type owl:Class ;
    rdfs:label "Invoice Number" .

:Cl_InvoiceLine rdf:type owl:Class ;
    rdfs:label "Invoice Line" .

:Cl_Item rdf:type owl:Class ;
    rdfs:label "Item" .

:Cl_Product rdf:type owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf :Cl_Item .

:Cl_Service rdf:type owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf :Cl_Item .

:Cl_InvoiceItem rdf:type owl:Class ;
    rdfs:label "Invoice Item" .

:Cl_Amount rdf:type owl:Class ;
    rdfs:label "Amount" .

:Cl_Date rdf:type owl:Class ;
    rdfs:label "Date" .

:Cl_Customer rdf:type owl:Class ;
    rdfs:label "Customer" .

:Cl_Organization rdf:type owl:Class ;
    rdfs:label "Organization" .

:Cl_Buyer rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization, :Cl_Person, :Cl_Stakeholder .

:Cl_Seller rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Person rdf:type owl:Class .

:Cl_Stakeholder rdf:type owl:Class .

:Cl_AddressEntity rdf:type owl:Class .

:Cl_Address rdf:type owl:Class ;
    rdfs:subClassOf :Cl_AddressEntity .

:Cl_BuyerAddressAssignment rdf:type owl:Class .

:Cl_InvoiceParticipation rdf:type owl:Class ;
    rdfs:label "Invoice Participation" .

:Cl_OrganizationRole rdf:type owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:subClassOf :Cl_Information .

:Cl_InvoiceRole rdf:type owl:Class ;
    rdfs:label "Invoice Role" .

:Cl_InvoiceParticipant rdf:type owl:Class .

:Cl_InvoiceParticipantRole rdf:type owl:Class .

:Cl_Supplier rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Client rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_SupplierRole rdf:type owl:Class ;
    rdfs:subClassOf :Cl_InvoiceParticipantRole .

:Cl_ClientRole rdf:type owl:Class ;
    rdfs:subClassOf :Cl_InvoiceParticipantRole .

:Cl_Information rdf:type owl:Class ;
    rdfs:label "Information" .

:Cl_OrganizationInformationDisplay rdf:type owl:Class ;
    rdfs:label "Organization Information Display" ;
    rdfs:subClassOf :Cl_Information .

:Cl_ContactDetail rdf:type owl:Class ;
    rdfs:label "Contact Detail" ;
    rdfs:subClassOf :Cl_Information .

:Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf :Cl_Information .

:Cl_OrganizationDisplayEvent rdf:type owl:Class ;
    rdfs:label "Organization Display Event" ;
    rdfs:subClassOf :Cl_Information .

:Cl_OrganizationInformationDisplayEvent rdf:type owl:Class ;
    rdfs:label "Organization Information Display Event" ;
    rdfs:subClassOf :Cl_OrganizationDisplayEvent .

:Cl_SaleDisplay rdf:type owl:Class ;
    rdfs:label "Sale Display" .

:Cl_ItemDisplayInfo rdf:type owl:Class ;
    rdfs:label "Item Display Info" ;
    rdfs:subClassOf :Cl_DisplayElement .

:Cl_DisplayElement rdf:type owl:Class ;
    rdfs:label "Display Element" .

:Cl_Price rdf:type owl:Class ;
    rdfs:label "Price" ;
    rdfs:subClassOf :Cl_DisplayElement, :Cl_Amount .

:Cl_Description rdf:type owl:Class ;
    rdfs:label "Description" ;
    rdfs:subClassOf :Cl_DisplayElement .

:Cl_Image rdf:type owl:Class ;
    rdfs:label "Image" ;
    rdfs:subClassOf :Cl_DisplayElement .

:Cl_AvailabilityStatus rdf:type owl:Class ;
    rdfs:label "Availability Status" ;
    rdfs:subClassOf :Cl_DisplayElement .

:Cl_ItemIdentifier rdf:type owl:Class ;
    rdfs:label "Item Identifier" ;
    rdfs:subClassOf :Cl_DisplayElement .

:Cl_Category rdf:type owl:Class ;
    rdfs:label "Category" ;
    rdfs:subClassOf :Cl_DisplayElement .

:Cl_Currency rdf:type owl:Class .

:Cl_NetPriceComputation rdf:type owl:Class .

:Cl_EDIFACTMessage rdf:type owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message formatted according to the EDIFACT standard." ;
    rdfs:subClassOf :Cl_EDIFACTDocument .

:Cl_EDIFACTDocument rdf:type owl:Class ;
    rdfs:label "EDIFACT Document" ;
    rdfs:comment "A document that is part of an EDIFACT message." ;
    rdfs:subClassOf :Cl_Document .

:Cl_EDIFACTInvoiceListing rdf:type owl:Class ;
    rdfs:label "EDIFACT Invoice Listing" ;
    rdfs:comment "A reification class representing the inclusion of a specific invoice in a specific EDIFACT message." .

:Cl_FileFormat rdf:type owl:Class .
:Cl_FileSpecification rdf:type owl:Class .
:Cl_FileComponent rdf:type owl:Class .
:Cl_Field rdf:type owl:Class .
:Cl_FieldConstraint rdf:type owl:Class .
:Cl_FieldType rdf:type owl:Class .
:Cl_ValidationRule rdf:type owl:Class .
:Cl_RequiredInformation rdf:type owl:Class .
:Cl_FileFormatValidityRequirement rdf:type owl:Class .
:Cl_RequirementSpecification rdf:type owl:Class .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment (Reification: Invoice assigned to Business Process)" .

:Cl_InvoiceDetail a owl:Class .

#################################################################
# Class Hierarchies and Disjoint Unions
#################################################################

:Cl_Buyer rdfs:subClassOf :Cl_Stakeholder .
:Cl_Address rdfs:subClassOf :Cl_AddressEntity .
:Cl_InvoiceParticipant rdfs:subClassOf owl:Thing .
:Cl_InvoiceParticipation rdfs:subClassOf :Cl_InvoiceParticipant .
:Cl_Supplier owl:disjointWith :Cl_Client .
:Cl_SupplierRole owl:disjointWith :Cl_ClientRole .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Item owl:disjointUnionOf ( :Cl_Product :Cl_Service ) .
:Cl_DisplayElement owl:disjointUnionOf ( :Cl_Price :Cl_Description :Cl_Image :Cl_AvailabilityStatus :Cl_ItemIdentifier :Cl_Category ) .
:Cl_Organization owl:disjointUnionOf ( :Cl_Buyer :Cl_Seller ) .
:Cl_FileFormat owl:disjointWith :Cl_Field, :Cl_FieldType, :Cl_ValidationRule .
:Cl_RequirementSpecification owl:disjointUnionOf ( :Cl_FileSpecification :Cl_FileFormatValidityRequirement :Cl_RequiredInformation ) .

#################################################################
# Disjointness
#################################################################

:Cl_Invoice owl:disjointWith :Cl_InvoiceAmount, :Cl_InvoiceNumber, :Cl_BusinessProcess, :Cl_Assignment, :Cl_Organization, :Cl_InvoiceRole, :Cl_InvoiceParticipation, :Cl_Item, :Cl_Price, :Cl_InvoiceLine, :Cl_NetPriceComputation, :Cl_Amount, :Cl_Currency, :Cl_Customer .
:Cl_InvoiceAmount owl:disjointWith :Cl_Document .
:Cl_InvoiceNumber owl:disjointWith :Cl_Invoice .
:Cl_Organization owl:disjointWith :Cl_OrganizationInformationDisplay, :Cl_OrganizationRole, :Cl_ContactDetail, :Cl_Location, :Cl_OrganizationDisplayEvent, :Cl_InvoiceParticipation .
:Cl_OrganizationRole owl:disjointWith :Cl_ContactDetail, :Cl_Location, :Cl_OrganizationInformationDisplay, :Cl_OrganizationDisplayEvent .
:Cl_Buyer owl:disjointWith :Cl_Address, :Cl_BuyerAddressAssignment .
:Cl_Address owl:disjointWith :Cl_BuyerAddressAssignment .
:Cl_Product owl:disjointWith :Cl_InvoiceLine, :Cl_Invoice, :Cl_Service, :Cl_Customer .
:Cl_Service owl:disjointWith :Cl_InvoiceLine, :Cl_Invoice, :Cl_Customer .
:Cl_InvoiceLine owl:disjointWith :Cl_Invoice, :Cl_Price, :Cl_NetPriceComputation, :Cl_Amount, :Cl_Currency, :Cl_Product, :Cl_Service .
:Cl_Price owl:disjointWith :Cl_NetPriceComputation, :Cl_Amount, :Cl_Currency, :Cl_Description, :Cl_Image, :Cl_AvailabilityStatus, :Cl_ItemIdentifier, :Cl_Category .
:Cl_NetPriceComputation owl:disjointWith :Cl_Amount, :Cl_Currency .
:Cl_Amount owl:disjointWith :Cl_Currency, :Cl_InvoiceItem, :Cl_Date .
:Cl_InvoiceItem owl:disjointWith :Cl_Customer .
:Cl_InvoiceRole owl:disjointWith :Cl_Organization, :Cl_InvoiceParticipation .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment .
:Cl_Description owl:disjointWith :Cl_Image, :Cl_AvailabilityStatus, :Cl_ItemIdentifier, :Cl_Category .
:Cl_Image owl:disjointWith :Cl_AvailabilityStatus, :Cl_ItemIdentifier, :Cl_Category .
:Cl_AvailabilityStatus owl:disjointWith :Cl_ItemIdentifier, :Cl_Category .
:Cl_ItemIdentifier owl:disjointWith :Cl_Category .

#################################################################
# Named Individuals (Roles)
#################################################################

:BuyerRole a owl:NamedIndividual , :Cl_OrganizationRole .
:SellerRole a owl:NamedIndividual , :Cl_OrganizationRole .

#################################################################
# Object Properties
#################################################################

:hasInvoiceAmount rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmount .

:hasInvoiceNumber rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumber ;
    rdfs:label "has invoice number"@en ;
    owl:inverseOf :isInvoiceNumberOf .

:isInvoiceNumberOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceNumber .

:hasInvoiceLine rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:isInvoiceLineOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceLine ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice .

:refersToItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasUnitPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Price .

:hasCurrency rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range :Cl_Currency .

:hasNetPriceComputation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPriceComputation .

:computedFromInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceComputation ;
    rdfs:range :Cl_Invoice .

:includesNetPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceComputation ;
    rdfs:range :Cl_Amount .

:hasInvoiceDetail rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail .

:hasCustomer rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer .

:hasInvoiceItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_InvoiceItem .

:hasProduct rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product .

:hasService rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Service .

:hasAmount rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Amount .

:hasInvoiceDate rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Date .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_OrganizationRole .

:relatesToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasBuyer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceParticipation , :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:hasSeller a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Seller .

:isBuyerInInvoice a owl:ObjectProperty ;
    owl:inverseOf :hasBuyer ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_InvoiceParticipation .

:isSellerInInvoice a owl:ObjectProperty ;
    owl:inverseOf :hasSeller ;
    rdfs:domain :Cl_Seller ;
    rdfs:range :Cl_InvoiceParticipation .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation , :Cl_OrganizationInformationDisplayEvent ;
    rdfs:range :Cl_Organization .

:hasContactDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_ContactDetail .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Location .

:displaysInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplayEvent ;
    rdfs:range :Cl_OrganizationInformationDisplay .

:displayedInEvent a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplay ;
    rdfs:range :Cl_OrganizationInformationDisplayEvent .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:hasOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationRole .

:involvesOrganization rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:hasRoleInInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceParticipantRole .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:inverseOf :isAddressOfBuyerAssignment .

:isAddressOfBuyerAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    owl:inverseOf :hasAddress .

:isBuyerOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Item ;
    rdfs:label "has item" .

:inSaleDisplay a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_SaleDisplay ;
    rdfs:label "in sale display" .

:hasDisplayElement a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_DisplayElement ;
    rdfs:label "has display element" .

:hasPrice a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDisplayElement ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Price ;
    rdfs:label "has price" .

:hasDescription a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDisplayElement ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Description ;
    rdfs:label "has description" .

:hasImage a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDisplayElement ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Image ;
    rdfs:label "has image" .

:hasAvailabilityStatus a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDisplayElement ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_AvailabilityStatus ;
    rdfs:label "has availability status" .

:hasItemIdentifier a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDisplayElement ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_ItemIdentifier ;
    rdfs:label "has item identifier" .

:hasCategory a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDisplayElement ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Category ;
    rdfs:label "has category" .

:hasFileSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileSpecification .

:hasValidityRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatValidityRequirement .

:requiresInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_RequiredInformation ;
    owl:inverseOf :isRequiredBy .

:hasComponent a owl:ObjectProperty ;
    rdfs:domain :Cl_FileSpecification ;
    rdfs:range :Cl_FileComponent .

:isField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileComponent ;
    rdfs:range :Cl_Field .

:hasFieldType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldType .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldConstraint .

:hasValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range :Cl_ValidationRule .

:isAboutField a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_Field .

:isRequiredBy a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_FileFormatValidityRequirement ;
    owl:inverseOf :requiresInformation .

:isSpecificationOf a owl:ObjectProperty ;
    owl:inverseOf :hasFileSpecification ;
    rdfs:domain :Cl_FileSpecification ;
    rdfs:range :Cl_FileFormat .

:hasInvoiceListing rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTInvoiceListing ;
    rdfs:label "has invoice listing" .

:listedInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTInvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "listed invoice" .

:inEDIFACTMessage rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTInvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "in EDIFACT message" ;
    owl:inverseOf :hasInvoiceListing .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "assigned invoice" .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "assigned business process" .

:invoiceAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Assignment ;
    rdfs:label "invoice assignment" .

:businessProcessAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedBusinessProcess ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Assignment ;
    rdfs:label "business process assignment" .

#################################################################
# Data Properties
#################################################################

:amountValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount, :Cl_Amount ;
    rdfs:range xsd:decimal .

:currency rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount, :Cl_Price ;
    rdfs:range xsd:string .

:invoiceNumberValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value"@en .

:invoiceNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:invoiceDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:issueDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:organizationType a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:organizationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole, :Cl_InvoiceRole ;
    rdfs:range xsd:string .

:participationRoleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceParticipantRole ;
    rdfs:range xsd:string .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactDetail ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactDetail ;
    rdfs:range xsd:string .

:locationAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:locationCity a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:locationCountry a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:displayedInformationType a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplay ;
    rdfs:range xsd:string .

:displayTimestamp a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplayEvent ;
    rdfs:range xsd:dateTime .

:priceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range xsd:decimal .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:lineQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:integer .

:totalPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:itemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:productCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:serviceCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Service ;
    rdfs:range xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:serviceName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Service ;
    rdfs:range xsd:string .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:invoiceDateValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Date ;
    rdfs:range xsd:date .

:lineDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:string .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_Description ;
    rdfs:range xsd:string .

:imageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Image ;
    rdfs:range xsd:anyURI .

:availabilityStatusValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_AvailabilityStatus ;
    rdfs:range xsd:string .

:itemIdentifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemIdentifier ;
    rdfs:range xsd:string .

:categoryName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Category ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:edifactMessageID rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "EDIFACT message ID" .

:edifactMessageDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:date ;
    rdfs:label "EDIFACT message date" .

:fieldName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:string .

:typeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldType ;
    rdfs:range xsd:string .

:ruleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range xsd:string .

:hasDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" .

#################################################################
# Restrictions and Equivalent Classes
#################################################################

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Document
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceAmount ;
          owl:someValuesFrom :Cl_InvoiceAmount
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceNumber ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_InvoiceNumber
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceLine ;
          owl:allValuesFrom :Cl_InvoiceLine
        ]
    )
] .

:Cl_InvoiceAmount rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :amountValue ;
    owl:someValuesFrom xsd:decimal
] .

:Cl_InvoiceNumber owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :invoiceNumberValue ;
          owl:someValuesFrom xsd:string ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :isInvoiceNumberOf ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:allValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasUnitPrice ; owl:allValuesFrom :Cl_Price ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceItem ; owl:someValuesFrom :Cl_InvoiceItem ]
    )
] .

:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasUnitPrice ;
    owl:allValuesFrom :Cl_Price
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceItem ;
    owl:someValuesFrom :Cl_InvoiceItem
] .

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

:Cl_NetPriceComputation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :computedFromInvoice ;
          owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :includesNetPrice ;
          owl:allValuesFrom :Cl_Amount ]
    )
] .

:Cl_NetPriceComputation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :computedFromInvoice ;
    owl:allValuesFrom :Cl_Invoice
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :includesNetPrice ;
    owl:allValuesFrom :Cl_Amount
] .

:Cl_InvoiceDetail owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAmount ; owl:someValuesFrom :Cl_Amount ]
    )
] .

:Cl_OrganizationInformationDisplayEvent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :displaysInformation ; owl:someValuesFrom :Cl_OrganizationInformationDisplay ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayTimestamp ; owl:someValuesFrom xsd:dateTime ]
    )
] .

:Cl_ItemDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :inSaleDisplay ; owl:someValuesFrom :Cl_SaleDisplay ]
        [ a owl:Restriction ; owl:onProperty :hasDisplayElement ; owl:someValuesFrom :Cl_DisplayElement ]
    )
] .

:Cl_FileFormatValidityRequirement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :requiresInformation ; owl:someValuesFrom :Cl_RequiredInformation ]
    )
] .

:Cl_FileFormat rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasValidityRequirement ;
    owl:someValuesFrom :Cl_FileFormatValidityRequirement
] .

:Cl_FileFormatValidityRequirement rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :requiresInformation ;
    owl:someValuesFrom :Cl_RequiredInformation
] .

:Cl_RequiredInformation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isAboutField ;
    owl:someValuesFrom :Cl_Field
] .

:Cl_EDIFACTInvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :listedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :inEDIFACTMessage ;
          owl:someValuesFrom :Cl_EDIFACTMessage ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :relatesToInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :hasBuyer ;
          owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ;
          owl:onProperty :hasSeller ;
          owl:someValuesFrom :Cl_Seller ]
        [ a owl:Restriction ;
          owl:onProperty :hasOrganization ;
          owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ;
          owl:onProperty :hasRole ;
          owl:someValuesFrom :Cl_OrganizationRole ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceRole ;
          owl:someValuesFrom :Cl_InvoiceRole ]
        [ a owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ;
          owl:onProperty :hasRoleInInvoice ;
          owl:someValuesFrom :Cl_InvoiceParticipantRole ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasBuyer ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Buyer ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasAddress ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Address ]
    )
] .

:Cl_Assignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

#################################################################
# End of Ontology
#################################################################