@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests>
    rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/fests/1.0> .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class .
:Cl_EDIFACTMessage a owl:Class ; rdfs:subClassOf :Cl_Document .
:Cl_Invoice a owl:Class ; rdfs:subClassOf :Cl_Document .
:Cl_InvoiceListing a owl:Class .
:Cl_InvoiceNumber a owl:Class .
:Cl_InvoiceIdentification a owl:Class .
:Cl_InvoiceLine a owl:Class .
:Cl_Item a owl:Class ; rdfs:label "Item" ; rdfs:comment "A product or good that is sold." .
:Cl_Product a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_Service a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_InvoiceAmount a owl:Class ; rdfs:subClassOf :Cl_Amount .
:Cl_Amount a owl:Class .
:Cl_InvoiceDetail a owl:Class .
:Cl_InvoiceItem a owl:Class .
:Cl_MonetaryAmount a owl:Class .
:Cl_InvoiceDate a owl:Class .
:Cl_Customer a owl:Class .
:Cl_Entity a owl:Class .
:Cl_Organization a owl:Class ; rdfs:subClassOf :Cl_Entity .
:Cl_OrganizationType a owl:Class .
:Cl_OrganizationRole a owl:Class .
:Cl_OrganizationInvolvement a owl:Class .
:Cl_ContactInformation a owl:Class ; rdfs:subClassOf :Cl_Description .
:Cl_Location a owl:Class .
:Cl_Description a owl:Class .
:Cl_Event a owl:Class .
:Cl_BusinessProcess a owl:Class .
:Cl_InvoiceAssignment a owl:Class ; rdfs:subClassOf :Cl_Assignment .
:Cl_Assignment a owl:Class .
:Cl_InvoiceParticipation a owl:Class .
:Cl_InvoiceRole a owl:Class .
:Cl_BuyerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRole .
:Cl_SellerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRole .
:Cl_Person a owl:Class .
:Cl_Buyer a owl:Class ; rdfs:subClassOf :Cl_Person .
:Cl_Address a owl:Class .
:Cl_BuyerAddressAssignment a owl:Class .
:Cl_SaleDisplayInfo a owl:Class ; rdfs:label "Sale Display Information" ; rdfs:comment "Reification class representing information displayed about an item sold." .
:Cl_ItemAttribute a owl:Class ; rdfs:label "Item Attribute" ; rdfs:comment "Superclass for all attributes of an item." .
:Cl_ItemName a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item Name" ; rdfs:comment "The name of the item." .
:Cl_ItemPrice a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item Price" ; rdfs:comment "The price of the item." .
:Cl_ItemDescription a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item Description" ; rdfs:comment "The description of the item." .
:Cl_ItemImage a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item Image" ; rdfs:comment "The image representing the item." .
:Cl_ItemCategory a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item Category" ; rdfs:comment "The category the item belongs to." .
:Cl_ItemSKU a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item SKU" ; rdfs:comment "The Stock Keeping Unit identifier for the item." .
:Cl_Company a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Supplier a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Customer a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Biller a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Payer a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_InvoiceParticipation a owl:Class .
:Cl_RoleInInvoice a owl:Class ; rdfs:subClassOf :Cl_Entity .
:Cl_InvoiceRoleType a owl:Class ; rdfs:subClassOf :Cl_Entity .
:SupplierRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType .
:CustomerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType .
:BillerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType .
:PayerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType .
:Cl_FileFormat a owl:Class .
:Cl_ValidationRequirement a owl:Class ; rdfs:subClassOf :Cl_Constraint .
:Cl_Constraint a owl:Class .
:Cl_RequiredInformation a owl:Class ; rdfs:subClassOf :Cl_InformationType .
:Cl_InformationType a owl:Class .
:Cl_DataType a owl:Class .
:Cl_FileFormatValidationRequirement a owl:Class ; rdfs:subClassOf :Cl_Constraint .
:Cl_NetPrice a owl:Class .
:Cl_Price a owl:Class .
:Cl_Quantity a owl:Class .
:Cl_Currency a owl:Class .

#################################################################
# Disjointness
#################################################################

:Cl_Invoice owl:disjointWith :Cl_Item, :Cl_Price, :Cl_InvoiceLine, :Cl_Quantity, :Cl_Currency, :Cl_BusinessProcess, :Cl_InvoiceAssignment, :Cl_Product, :Cl_Customer, :Cl_InvoiceItem, :Cl_MonetaryAmount, :Cl_InvoiceDate, :Cl_Amount .
:Cl_Item owl:disjointWith :Cl_Price, :Cl_InvoiceLine, :Cl_Quantity, :Cl_Currency, :Cl_Invoice, :Cl_RequiredInformation, :Cl_FileFormatValidationRequirement .
:Cl_InvoiceLine owl:disjointWith :Cl_Quantity, :Cl_Currency, :Cl_Price, :Cl_Invoice, :Cl_InvoiceAssignment .
:Cl_Quantity owl:disjointWith :Cl_Currency, :Cl_Price, :Cl_InvoiceLine .
:Cl_Currency owl:disjointWith :Cl_Price, :Cl_InvoiceLine, :Cl_Invoice, :Cl_Quantity .
:Cl_FileFormat owl:disjointWith :Cl_RequiredInformation, :Cl_FileFormatValidationRequirement .
:Cl_RequiredInformation owl:disjointWith :Cl_InformationType, :Cl_DataType, :Cl_Constraint .
:Cl_InformationType owl:disjointWith :Cl_DataType, :Cl_Constraint .
:Cl_DataType owl:disjointWith :Cl_Constraint .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Company owl:disjointWith :Cl_Supplier, :Cl_Customer .
:Cl_Supplier owl:disjointWith :Cl_Customer, :Cl_Biller, :Cl_Payer .
:SupplierRole owl:disjointWith :CustomerRole, :BillerRole, :PayerRole .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_InvoiceAssignment owl:disjointWith :Cl_Invoice, :Cl_BusinessProcess .
:Cl_Organization owl:disjointWith :Cl_Event, :Cl_ContactInformation, :Cl_Location, :Cl_Description .
:Cl_InvoiceNumber owl:disjointWith :Cl_Document .
:Cl_ItemName owl:disjointWith :Cl_ItemPrice , :Cl_ItemDescription , :Cl_ItemImage , :Cl_ItemCategory , :Cl_ItemSKU .
:Cl_ItemPrice owl:disjointWith :Cl_ItemDescription , :Cl_ItemImage , :Cl_ItemCategory , :Cl_ItemSKU .
:Cl_ItemDescription owl:disjointWith :Cl_ItemImage , :Cl_ItemCategory , :Cl_ItemSKU .
:Cl_ItemImage owl:disjointWith :Cl_ItemCategory , :Cl_ItemSKU .
:Cl_ItemCategory owl:disjointWith :Cl_ItemSKU .
:Cl_ItemAttribute owl:disjointUnionOf (
    :Cl_ItemName 
    :Cl_ItemPrice 
    :Cl_ItemDescription 
    :Cl_ItemImage 
    :Cl_ItemCategory 
    :Cl_ItemSKU
) .
:Cl_Buyer owl:disjointWith :Cl_Address .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:comment "Links an EDIFACT message to its InvoiceListing." .

:listedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:comment "Links an InvoiceListing to an Invoice that is listed." .

:isListedIn a owl:ObjectProperty ;
    owl:inverseOf :listedInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:comment "Inverse property of listedInvoice." .

:isInvoiceListingOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceListing ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:comment "Inverse property of hasInvoiceListing." .

:hasInvoiceNumber a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumber ;
    rdfs:label "has invoice number"@en ;
    owl:inverseOf :isInvoiceNumberOf .

:isInvoiceNumberOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range :Cl_Invoice .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range :Cl_Currency .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    owl:inverseOf :isInvoiceOf .

:isInvoiceOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice .

:hasCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer .

:hasInvoiceDate a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDate .

:hasTotalAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_MonetaryAmount .

:refersToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product .

:unitPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_MonetaryAmount .

:lineTotal a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_MonetaryAmount .

:hasInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmount .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :isParticipantIn .

:isParticipantIn a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation , :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation , :Cl_RoleInInvoice ;
    rdfs:range :Cl_Invoice .

:hasRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_RoleInInvoice .

:hasRoleType a owl:ObjectProperty ;
    rdfs:domain :Cl_RoleInInvoice ;
    rdfs:range :Cl_InvoiceRoleType .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_RoleInInvoice ;
    rdfs:range :Cl_Organization .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:hasParticipantOrg a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:inInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

:participantIn a owl:ObjectProperty ;
    owl:inverseOf :hasParticipantOrg ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation .

:invoiceOfParticipation a owl:ObjectProperty ;
    owl:inverseOf :inInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationType .

:hasContactInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_ContactInformation .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Location .

:hasDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Description .

:hasOrganizationInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Event ;
    rdfs:range :Cl_OrganizationInvolvement .

:involvementRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_OrganizationRole .

:involvementDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Description .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address .

:buyerAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_Address ;
    owl:propertyChainAxiom ( [ owl:inverseOf :hasBuyer ] :hasAddress ) .

:displayedAboutItem a owl:ObjectProperty ;
    rdfs:domain :Cl_SaleDisplayInfo ;
    rdfs:range :Cl_Item ;
    rdfs:label "displayed about item" ;
    rdfs:comment "Connects the sale display information to the item it is about." .

:hasAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_SaleDisplayInfo ;
    rdfs:range :Cl_ItemAttribute ;
    rdfs:label "has attribute" ;
    rdfs:comment "Connects sale display information to an item attribute." .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_Invoice .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_BusinessProcess .

:isInvoiceOfAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAssignment .

:isBusinessProcessOfAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedBusinessProcess ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_InvoiceAssignment .

:hasValidationRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatValidationRequirement .

:requiresInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidationRequirement ;
    rdfs:range :Cl_RequiredInformation .

:hasInformationType a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_InformationType .

:hasDataType a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_DataType .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_Constraint .

#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:comment "Invoice number identifier." .

:messageId a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:comment "Unique identifier of the EDIFACT message." .

:issueDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:comment "Date when the invoice was issued." .

:invoiceNumberValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value"@en .

:lineQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:integer .

:lineUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:hasQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:integer .

:hasNetPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal .

:hasCurrencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount, :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal .

:currency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount, :Cl_MonetaryAmount ;
    rdfs:range xsd:string .

:invoiceDateValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDate ;
    rdfs:range xsd:dateTime .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:customerAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:productCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:organizationID a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:organizationWebsite a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:locationAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_Description ;
    rdfs:range xsd:string .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string .

:typeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range xsd:dateTime .

:street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:itemNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemName ;
    rdfs:range xsd:string .

:itemPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal .

:itemDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemDescription ;
    rdfs:range xsd:string .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:anyURI .

:itemCategoryValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemCategory ;
    rdfs:range xsd:string .

:itemSKUValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemSKU ;
    rdfs:range xsd:string .

:informationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string .

:informationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string .

:formatName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range xsd:string .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Constraint ;
    rdfs:range xsd:string .

:involvementTime a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range xsd:dateTime .

:organizationRole a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range xsd:string .

#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_EDIFACTMessage rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceListing ;
    owl:someValuesFrom :Cl_InvoiceListing
] .

:Cl_InvoiceListing rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :listedInvoice ;
    owl:someValuesFrom :Cl_Invoice
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:allValuesFrom :Cl_InvoiceNumber
] .

:Cl_InvoiceNumber owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :isInvoiceNumberOf ;
    owl:someValuesFrom :Cl_Invoice
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:allValuesFrom :Cl_InvoiceLine
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Item
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_NetPrice
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasQuantity ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:integer
] .

:Cl_NetPrice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPriceValue ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:decimal
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasCurrency ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Currency
] .

:Cl_InvoiceAmount owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :amountValue ;
    owl:allValuesFrom xsd:decimal
] .

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceItem ;
    owl:someValuesFrom :Cl_InvoiceItem
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasCustomer ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Customer
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_InvoiceDate
] .

:Cl_InvoiceItem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToProduct ;
    owl:someValuesFrom :Cl_Product
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :unitPrice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_MonetaryAmount
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :lineTotal ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_MonetaryAmount
] .

:Cl_InvoiceDetail owl:equivalentClass :Cl_InvoiceItem .
:Cl_InvoiceItem rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_InvoiceDetail rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isInvoiceOf ;
    owl:someValuesFrom :Cl_Invoice
] .

:Cl_InvoiceParticipation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceRole ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_InvoiceRole
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasParticipantOrg ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Organization
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :inInvoice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Invoice
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_RoleInInvoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasOrganization ;
    owl:someValuesFrom :Cl_Organization
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesInvoice ;
    owl:someValuesFrom :Cl_Invoice
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasRoleType ;
    owl:someValuesFrom :Cl_InvoiceRoleType
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :involvementRole ; owl:someValuesFrom :Cl_OrganizationRole ]
        [ a owl:Restriction ; owl:onProperty :involvementDescription ; owl:someValuesFrom :Cl_Description ]
    )
] .

:Cl_FileFormatValidationRequirement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :requiresInformation ; owl:someValuesFrom :Cl_RequiredInformation ]
    )
] .

:Cl_SaleDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :displayedAboutItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasAttribute ; owl:someValuesFrom :Cl_ItemAttribute ]
    )
] .

:Cl_BuyerAddressAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasBuyer ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Buyer
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasAddress ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Address
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :assignedInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

#################################################################
# End of FestS Ontology
#################################################################