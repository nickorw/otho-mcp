@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Person a owl:Class .
:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .
:Cl_Address a owl:Class .
:Cl_BuyerAddressAssignment a owl:Class .  # Reification/pivot class for Buyer-Address association

### Hierarchies

:Cl_Stakeholder a owl:Class .
:Cl_Buyer rdfs:subClassOf :Cl_Stakeholder .

### Properties

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:FunctionalProperty .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:FunctionalProperty .

:buyerAddressAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    owl:FunctionalProperty .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

### Restrictions

:Cl_BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

### Disjointness

:Cl_Buyer owl:disjointWith :Cl_Seller .  # If Cl_Seller exists elsewhere

### Example Inverse Property

:assignedToBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :buyerAddressAssignment .

### Comment

# This ontology structure allows answering the competency question: "What is the address of the buyer?"
# by linking a Cl_Buyer to a Cl_Address via the Cl_BuyerAddressAssignment pivot class, supporting extensibility
# (e.g., for address validity periods, address types, etc., in future expansions).