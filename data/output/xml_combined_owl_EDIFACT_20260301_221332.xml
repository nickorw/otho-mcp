/>    <rdfs:label>EDIFACT Story Ontology</rdfs:label>    <rdfs:comment>Ontology representing the structure and semantics of UN/EDIFACT invoice messages, aligned with EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n6dcdbee2a4ee4f76b6bb6afe140757dab4">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasRole"/>    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>    <owl:onClass rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#processHasInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>process has invoice (inverse of assignedToProcess)</rdfs:label>    <rdfs:comment>Indicates the InvoiceMessage(s) assigned to this BusinessProcess (inverse of assignedToProcess).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedToProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:label>assigned to process</rdfs:label>    <rdfs:comment>Assigns an Invoice Message to a Business Process.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#processHasInvoice"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n6dcdbee2a4ee4f76b6bb6afe140757dab5">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasIdentifier"/>    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>    <owl:onClass rdf:resource="http://www.example.org/ontology#Identifier"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n6dcdbee2a4ee4f76b6bb6afe140757dab2">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#describesItem"/>    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>    <owl:onClass rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Relates an Organization to its Address(es).</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The outermost envelope containing one or more messages in an EDIFACT transmission.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:subClassOf rdf:nodeID="n6dcdbee2a4ee4f76b6bb6afe140757dab1"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>A message representing an invoice, such as EDIFACT INVOIC.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>The quantity of items in a line item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:label>has header</rdfs:label>    <rdfs:comment>Relates an Invoice Message to its header section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isHeaderOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A business message contained within an Interchange Envelope.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail</rdfs:label>    <rdfs:comment>The detail section of an invoice, containing line items.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>An identifier for organizations or items, such as a Global Location Number.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n6dcdbee2a4ee4f76b6bb6afe140757dab1">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasRoleAssignment"/>    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>    <owl:onClass rdf:resource="http://www.example.org/ontology#RoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#RoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>is role assignment of (inverse of hasRoleAssignment)</rdfs:label>    <rdfs:comment>Indicates the InvoiceMessage that this RoleAssignment belongs to (inverse of hasRoleAssignment).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service listed in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process to which the invoice is assigned.</rdfs:comment>  </rdf:Description></rdf:RDF>