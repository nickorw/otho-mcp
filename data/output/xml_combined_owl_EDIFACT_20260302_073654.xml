owl#FunctionalProperty"/>    <rdfs:label>has global location number</rdfs:label>    <rdfs:comment>Links an organization to its global location number.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#GlobalLocationNumber"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isGlobalLocationNumberOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isInvoiceNumberOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is invoice number of</rdfs:label>    <rdfs:comment>A reference number is for an invoice message (inverse of invoiceNumber).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#ReferenceNumber"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSectionOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is section of</rdfs:label>    <rdfs:comment>A section is part of an invoice message (inverse of hasSection).</rdfs:comment>    <rdfs:domain rdf:nodeID="n24a816c76ec54404b8d8beabe350ee8bb7"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is address of</rdfs:label>    <rdfs:comment>An address is for an organization (inverse of hasAddress).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:lab