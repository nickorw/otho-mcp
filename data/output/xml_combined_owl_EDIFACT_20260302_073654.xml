ization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BGMSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>BGM Segment</rdfs:label>    <rdfs:comment>The Beginning of Message (BGM) segment for document identification.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#mandatoryIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>mandatory identifier</rdfs:label>    <rdfs:comment>A mandatory identifier required by D96A.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Detail Section</rdfs:label>    <rdfs:comment>Section listing individual line items with net prices and quantities.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#invoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>invoice number</rdfs:label>    <rdfs:comment>Links an invoice message to its invoice number.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#ReferenceNumber"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIn