@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/hospital_story>
    a owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "Ontology for hospital staff, unions, articles, and events based on the provided story." .

#################################################################
# Classes
#################################################################
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, including staff and authors." .

:Nurse a owl:Class ;
    rdfs:label "Nurse" ;
    rdfs:comment "A person who is a nurse." ;
    rdfs:subClassOf :Person .

:Doctor a owl:Class ;
    rdfs:label "Doctor" ;
    rdfs:comment "A person who is a doctor." ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Nurse .

:NursingAssistant a owl:Class ;
    rdfs:label "Nursing Assistant" ;
    rdfs:comment "A person who is a nursing assistant." ;
    rdfs:subClassOf :Nurse .

:CertifiedNurse a owl:Class ;
    rdfs:label "Certified Nurse" ;
    rdfs:comment "A nurse who has obtained a certification." ;
    rdfs:subClassOf :Nurse .

:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:comment "A hospital institution." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where hospitals are located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country where cities are located." .

:Union a owl:Class ;
    rdfs:label "Union" ;
    rdfs:comment "A union organizing hospital staff." .

:UnionMembership a owl:Class ;
    rdfs:label "Union Membership" ;
    rdfs:comment "The membership of a person in a union at a point in time." .

:UnionRole a owl:Class ;
    rdfs:label "Union Role" ;
    rdfs:comment "A role held by a person within a union at a specific time." .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A period of employment of a person at a hospital." .

:Degree a owl:Class ;
    rdfs:label "Degree" ;
    rdfs:comment "A medical or nursing degree obtained by a person." .

:Evaluation a owl:Class ;
    rdfs:label "Evaluation" ;
    rdfs:comment "A written evaluation statement by a doctor for an employee." .

:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A research article." .

:ArticleCollection a owl:Class ;
    rdfs:label "Article Collection" ;
    rdfs:comment "A collection of articles available at the hospital library." ;
    owl:disjointUnionOf (:Book :CD) .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A book version of an article collection." ;
    rdfs:subClassOf :ArticleCollection ;
    owl:disjointWith :CD .

:CD a owl:Class ;
    rdfs:label "CD" ;
    rdfs:comment "A CD version of an article collection." ;
    rdfs:subClassOf :ArticleCollection .

:Seminar a owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A seminar where articles are presented." .

#################################################################
# Object Properties with Inverses
#################################################################
:hasDegree a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has degree" ;
    rdfs:comment "Links a person to a degree they have obtained." ;
    rdfs:domain :Person ;
    rdfs:range :Degree ;
    owl:inverseOf :degreeOf .
:degreeOf a owl:ObjectProperty ;
    rdfs:label "degree of" ;
    rdfs:comment "Inverse of hasDegree; links a degree to the person who holds it." ;
    rdfs:domain :Degree ;
    rdfs:range :Person .

:studiedFor a owl:ObjectProperty ;
    rdfs:label "studied for" ;
    rdfs:comment "Links a person to a degree they studied for." ;
    rdfs:domain :Person ;
    rdfs:range :Degree ;
    owl:inverseOf :studiedBy .
:studiedBy a owl:ObjectProperty ;
    rdfs:label "studied by" ;
    rdfs:comment "Inverse of studiedFor; links a degree to a person who studied for it." ;
    rdfs:domain :Degree ;
    rdfs:range :Person .

:employedAt a owl:ObjectProperty ;
    rdfs:label "employed at" ;
    rdfs:comment "Links an employment period to a hospital." ;
    rdfs:domain :Employment ;
    rdfs:range :Hospital ;
    owl:inverseOf :hasEmployment .
:hasEmployment a owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:comment "Inverse of employedAt; links a hospital to the employments at that hospital." ;
    rdfs:domain :Hospital ;
    rdfs:range :Employment .

:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:comment "Links a hospital to its city." ;
    rdfs:domain :Hospital ;
    rdfs:range :City ;
    owl:inverseOf :hasHospital .
:hasHospital a owl:ObjectProperty ;
    rdfs:label "has hospital" ;
    rdfs:comment "Inverse of locatedIn; links a city to hospitals in that city." ;
    rdfs:domain :City ;
    rdfs:range :Hospital .

:cityInCountry a owl:ObjectProperty ;
    rdfs:label "city in country" ;
    rdfs:comment "Links a city to its country." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :hasCity .
:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Inverse of cityInCountry; links a country to its cities." ;
    rdfs:domain :Country ;
    rdfs:range :City .

:hasUnionMembership a owl:ObjectProperty ;
    rdfs:label "has union membership" ;
    rdfs:comment "Links a person to their union membership." ;
    rdfs:domain :Person ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :membershipOf .
:membershipOf a owl:ObjectProperty ;
    rdfs:label "membership of" ;
    rdfs:comment "Inverse of hasUnionMembership; links a union membership to its person." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Person .

:unionOfMembership a owl:ObjectProperty ;
    rdfs:label "union of membership" ;
    rdfs:comment "Links a union membership to the union." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Union ;
    owl:inverseOf :hasMembership .
:hasMembership a owl:ObjectProperty ;
    rdfs:label "has membership" ;
    rdfs:comment "Inverse of unionOfMembership; links a union to its memberships." ;
    rdfs:domain :Union ;
    rdfs:range :UnionMembership .

:hasUnionRole a owl:ObjectProperty ;
    rdfs:label "has union role" ;
    rdfs:comment "Links a union membership to a union role." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :UnionRole ;
    owl:inverseOf :roleOfMembership .
:roleOfMembership a owl:ObjectProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Inverse of hasUnionRole; links a union role to its membership." ;
    rdfs:domain :UnionRole ;
    rdfs:range :UnionMembership .

:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluated by" ;
    rdfs:comment "Links an evaluation to the doctor who wrote it." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Doctor ;
    owl:inverseOf :evaluates .
:evaluates a owl:ObjectProperty ;
    rdfs:label "evaluates" ;
    rdfs:comment "Links a doctor to an evaluation they wrote." ;
    rdfs:domain :Doctor ;
    rdfs:range :Evaluation .

:evaluatedEmployee a owl:ObjectProperty ;
    rdfs:label "evaluated employee" ;
    rdfs:comment "Links an evaluation to the employee being evaluated." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Person ;
    owl:inverseOf :employeeEvaluation .
:employeeEvaluation a owl:ObjectProperty ;
    rdfs:label "employee evaluation" ;
    rdfs:comment "Inverse of evaluatedEmployee; links a person to their evaluations." ;
    rdfs:domain :Person ;
    rdfs:range :Evaluation .

:hasArticle a owl:ObjectProperty ;
    rdfs:label "has article" ;
    rdfs:comment "Links an article collection to its articles." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Article ;
    owl:inverseOf :isArticleOf .
:isArticleOf a owl:ObjectProperty ;
    rdfs:label "is article of" ;
    rdfs:comment "Inverse of hasArticle; links an article to its collection." ;
    rdfs:domain :Article ;
    rdfs:range :ArticleCollection .

:presentedAt a owl:ObjectProperty ;
    rdfs:label "presented at" ;
    rdfs:comment "Links an article to the seminar where it was presented." ;
    rdfs:domain :Article ;
    rdfs:range :Seminar ;
    owl:inverseOf :hasPresentation .
:hasPresentation a owl:ObjectProperty ;
    rdfs:label "has presentation" ;
    rdfs:comment "Inverse of presentedAt; links a seminar to articles presented there." ;
    rdfs:domain :Seminar ;
    rdfs:range :Article .

:seminarLocation a owl:ObjectProperty ;
    rdfs:label "seminar location" ;
    rdfs:comment "Links a seminar to the hospital where it takes place." ;
    rdfs:domain :Seminar ;
    rdfs:range :Hospital ;
    owl:inverseOf :locationOfSeminar .
:locationOfSeminar a owl:ObjectProperty ;
    rdfs:label "location of seminar" ;
    rdfs:comment "Inverse of seminarLocation; links a hospital to seminars held there." ;
    rdfs:domain :Hospital ;
    rdfs:range :Seminar .

#################################################################
# Data Properties
#################################################################
:studyPeriod a owl:DatatypeProperty ;
    rdfs:label "study period" ;
    rdfs:comment "The period during which a person studied for a degree (as string)." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:string .

:employmentStartDate a owl:DatatypeProperty ;
    rdfs:label "employment start date" ;
    rdfs:comment "The date when employment started." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .

:membershipStartDate a owl:DatatypeProperty ;
    rdfs:label "membership start date" ;
    rdfs:comment "The start date of a union membership." ;
    rdfs:domain :UnionMembership ;
    rdfs:range xsd:dateTime .

:roleStartDate a owl:DatatypeProperty ;
    rdfs:label "role start date" ;
    rdfs:comment "The start date of a union role." ;
    rdfs:domain :UnionRole ;
    rdfs:range xsd:dateTime .

:roleLabel a owl:DatatypeProperty ;
    rdfs:label "role label" ;
    rdfs:comment "The label of a union role." ;
    rdfs:domain :UnionRole ;
    rdfs:range xsd:string .

:evaluationStatement a owl:DatatypeProperty ;
    rdfs:label "evaluation statement" ;
    rdfs:comment "The written statement in an evaluation." ;
    rdfs:domain :Evaluation ;
    rdfs:range xsd:string .

:pages a owl:DatatypeProperty ;
    rdfs:label "pages" ;
    rdfs:comment "The number of pages in a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer .

:publishedOn a owl:DatatypeProperty ;
    rdfs:label "published on" ;
    rdfs:comment "The publication date of a book or CD." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range xsd:dateTime .

:seminarDate a owl:DatatypeProperty ;
    rdfs:label "seminar date" ;
    rdfs:comment "The date when a seminar took place." ;
    rdfs:domain :Seminar ;
    rdfs:range xsd:dateTime .

#################################################################
# Axioms and Restrictions
#################################################################
# At least one article is always presented at each seminar
:Seminar rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasPresentation ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Article ] .
