@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "An ontology describing music production, band membership, recording, and performances." .

#################################################################
# Classes
#################################################################
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in music production, band membership, or performance." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A music group or band." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role a person can have in a band (e.g., vocalist, guitarist)." .

:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reification class linking a person, band, role, and time period for membership." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of tracks recorded and released by a band." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A track on an album, which is a recording of a song." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition that can be recorded as a track." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews and comments on albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live performance event by a band." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances can take place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographical region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

#################################################################
# Disjointness
#################################################################
:Person owl:disjointWith :Band, :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Band owl:disjointWith :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Instrument owl:disjointWith :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Album owl:disjointWith :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Track owl:disjointWith :Song, :Critic, :Performance, :City, :Region, :Country .
:Song owl:disjointWith :Critic, :Performance, :City, :Region, :Country .
:Critic owl:disjointWith :Performance, :City, :Region, :Country .
:Performance owl:disjointWith :City, :Region, :Country .
:City owl:disjointWith :Region, :Country .
:Region owl:disjointWith :Country .

#################################################################
# Object Properties (with inverses)
#################################################################
:playsInstrument a owl:ObjectProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :isPlayedBy .

:isPlayedBy a owl:ObjectProperty ;
    rdfs:label "is played by" ;
    rdfs:comment "Relates an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMembership a owl:ObjectProperty ;
    rdfs:label "has membership" ;
    rdfs:comment "Relates a person to their band membership (reified)." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberPerson .

:memberPerson a owl:ObjectProperty ;
    rdfs:label "member person" ;
    rdfs:comment "Relates a band membership to the person involved." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasMembership .

:membershipOfBand a owl:ObjectProperty ;
    rdfs:label "membership of band" ;
    rdfs:comment "Relates a band membership to a band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasBandMembership .

:hasBandMembership a owl:ObjectProperty ;
    rdfs:label "has band membership" ;
    rdfs:comment "Relates a band to a band membership." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :membershipOfBand .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "Relates a band membership to a role." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleOfMembership .

:roleOfMembership a owl:ObjectProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Relates a role to the band membership it is part of." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :hasRole .

:recordedAlbum a owl:ObjectProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates a band to an album they recorded." ;
    rdfs:domain :Band ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecordedBy .

:albumRecordedBy a owl:ObjectProperty ;
    rdfs:label "album recorded by" ;
    rdfs:comment "Relates an album to the band that recorded it." ;
    rdfs:domain :Album ;
    rdfs:range :Band ;
    owl:inverseOf :recordedAlbum .

:albumTrack a owl:ObjectProperty ;
    rdfs:label "album track" ;
    rdfs:comment "Relates an album to one of its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOnAlbum .

:trackOnAlbum a owl:ObjectProperty ;
    rdfs:label "track on album" ;
    rdfs:comment "Relates a track to the album it appears on." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :albumTrack .

:trackOfSong a owl:ObjectProperty ;
    rdfs:label "track of song" ;
    rdfs:comment "Relates a track to the song it is a recording of." ;
    rdfs:domain :Track ;
    rdfs:range :Song ;
    owl:inverseOf :songRecordedAsTrack .

:songRecordedAsTrack a owl:ObjectProperty ;
    rdfs:label "song recorded as track" ;
    rdfs:comment "Relates a song to the track that records it." ;
    rdfs:domain :Song ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfSong .

:criticReview a owl:ObjectProperty ;
    rdfs:label "critic review" ;
    rdfs:comment "Relates a critic to an album they reviewed." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :reviewedByCritic .

:reviewedByCritic a owl:ObjectProperty ;
    rdfs:label "reviewed by critic" ;
    rdfs:comment "Relates an album to the critic who reviewed it." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :criticReview .

:performanceOfBand a owl:ObjectProperty ;
    rdfs:label "performance of band" ;
    rdfs:comment "Relates a performance to the band performing." ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :bandPerformance .

:bandPerformance a owl:ObjectProperty ;
    rdfs:label "band performance" ;
    rdfs:comment "Relates a band to a performance." ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceOfBand .

:performedSong a owl:ObjectProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Relates a performance to a song played." ;
    rdfs:domain :Performance ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformedAt .

:songPerformedAt a owl:ObjectProperty ;
    rdfs:label "song performed at" ;
    rdfs:comment "Relates a song to the performance where it was played." ;
    rdfs:domain :Song ;
    rdfs:range :Performance ;
    owl:inverseOf :performedSong .

:performanceLocation a owl:ObjectProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "Relates a performance to the city where it took place." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :cityPerformance .

:cityPerformance a owl:ObjectProperty ;
    rdfs:label "city performance" ;
    rdfs:comment "Relates a city to a performance that took place there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation .

:cityInRegion a owl:ObjectProperty ;
    rdfs:label "city in region" ;
    rdfs:comment "Relates a city to the region it is in." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Relates a region to a city it contains." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :cityInRegion .

:regionInCountry a owl:ObjectProperty ;
    rdfs:label "region in country" ;
    rdfs:comment "Relates a region to the country it is in." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Relates a country to a region it contains." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :regionInCountry .

#################################################################
# Data Properties
#################################################################
:membershipStart a owl:DatatypeProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "Start date/time of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:membershipEnd a owl:DatatypeProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "End date/time of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStart a owl:DatatypeProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "Start date/time of album recording." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:recordingEnd a owl:DatatypeProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "End date/time (release) of album recording." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:songComposedOn a owl:DatatypeProperty ;
    rdfs:label "song composed on" ;
    rdfs:comment "Date/time when a song was composed." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:reviewComment a owl:DatatypeProperty ;
    rdfs:label "review comment" ;
    rdfs:comment "The comment made by a critic about an album." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:performanceDate a owl:DatatypeProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "Date/time of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

#################################################################
# Complex Axioms & Restrictions (GCI)
#################################################################
:Album rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty :albumTrack ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .
