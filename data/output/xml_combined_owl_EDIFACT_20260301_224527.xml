.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#involvesOrganization"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n37ce31fe51664b2ea5d3aafe71a8fb83b11">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#roleType"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#RoleType"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n37ce31fe51664b2ea5d3aafe71a8fb83b2">    <rdf:first rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdf:rest rdf:nodeID="n37ce31fe51664b2ea5d3aafe71a8fb83b3"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Links a message to its segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isBusinessProcessOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is business process of</rdfs:label>    <rdfs:comment>Links a business process to the invoice message it is assigned to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#relatedToBusinessProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment in an EDIFACT message, such as BGM or NAD.</rdfs:comment>    <owl:disjointUnionOf rdf:nodeID="n37ce31fe51664b2ea5d3aafe71a8fb83b7"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role assignment of</rdfs:label>    <rdfs:comment>Links a role assignment to the invoice message it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>An identifier such as a Global Location Number (GLN).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Links an invoice item line to its price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceItemLine"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Links a message to its containing envelope.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#