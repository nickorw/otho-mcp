@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

#################################################################
# Classes
#################################################################

:Band a owl:Class ;
  rdfs:label "Band" ;
  rdfs:comment "A musical group consisting of members." ;
  owl:disjointWith :Person, :Instrument, :Role, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A human individual, such as a musician or critic." ;
  owl:disjointWith :Instrument, :Role, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .

:Instrument a owl:Class ;
  rdfs:label "Instrument" ;
  rdfs:comment "A musical instrument played by a person." ;
  owl:disjointWith :Role, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A musical or functional role within a band (e.g., vocalist, drummer)." ;
  owl:disjointWith :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .

:Album a owl:Class ;
  rdfs:label "Album" ;
  rdfs:comment "A collection of recorded music tracks." ;
  owl:disjointWith :Track, :Song, :Critic, :Performance, :City, :Region, :Country .

:Track a owl:Class ;
  rdfs:label "Track" ;
  rdfs:comment "A single recording on an album." ;
  owl:disjointWith :Song, :Critic, :Performance, :City, :Region, :Country .

:Song a owl:Class ;
  rdfs:label "Song" ;
  rdfs:comment "A musical composition." ;
  owl:disjointWith :Critic, :Performance, :City, :Region, :Country .

:Critic a owl:Class ;
  rdfs:label "Critic" ;
  rdfs:comment "A person who reviews music albums." ;
  owl:disjointWith :Performance, :City, :Region, :Country .

:Performance a owl:Class ;
  rdfs:label "Performance" ;
  rdfs:comment "A live musical event." ;
  owl:disjointWith :City, :Region, :Country .

:City a owl:Class ;
  rdfs:label "City" ;
  rdfs:comment "A city where performances take place." ;
  owl:disjointWith :Region, :Country .

:Region a owl:Class ;
  rdfs:label "Region" ;
  rdfs:comment "A geographic region containing cities." ;
  owl:disjointWith :Country .

:Country a owl:Class ;
  rdfs:label "Country" ;
  rdfs:comment "A country containing regions." .

#################################################################
# Pivot Classes (Reification)
#################################################################

:UserBandMembership a owl:Class ;
  rdfs:label "User Band Membership" ;
  rdfs:comment "The membership of a person in a band at a certain time." .

:UserRoleAssignment a owl:Class ;
  rdfs:label "User Role Assignment" ;
  rdfs:comment "The assignment of a role to a person in a band at a certain time." .

:AlbumRecordingPeriod a owl:Class ;
  rdfs:label "Album Recording Period" ;
  rdfs:comment "The period during which an album was recorded." .

:AlbumRelease a owl:Class ;
  rdfs:label "Album Release" ;
  rdfs:comment "The release event for an album, with a release date." .

:TrackSongAssociation a owl:Class ;
  rdfs:label "Track Song Association" ;
  rdfs:comment "Association between a track and the song it records." .

:SongComposition a owl:Class ;
  rdfs:label "Song Composition" ;
  rdfs:comment "The event of a song being composed at a certain date." .

:CriticReview a owl:Class ;
  rdfs:label "Critic Review" ;
  rdfs:comment "A review of an album by a critic." .

:PerformanceSong a owl:Class ;
  rdfs:label "Performance Song" ;
  rdfs:comment "The association of a song performed at a performance." .

:PerformanceLocation a owl:Class ;
  rdfs:label "Performance Location" ;
  rdfs:comment "The association of a performance with its city location." .

#################################################################
# Object Properties and Inverses
#################################################################

:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "plays instrument" ;
  rdfs:comment "The instrument played by a person." ;
  rdfs:domain :Person ;
  rdfs:range :Instrument ;
  owl:inverseOf :isPlayedBy .

:isPlayedBy a owl:ObjectProperty ;
  rdfs:label "is played by" ;
  rdfs:comment "Inverse of playsInstrument: links an instrument to the person who plays it." ;
  rdfs:domain :Instrument ;
  rdfs:range :Person .

:hasMember a owl:ObjectProperty ;
  rdfs:label "has member" ;
  rdfs:comment "Links a band to a membership event." ;
  rdfs:domain :Band ;
  rdfs:range :UserBandMembership ;
  owl:inverseOf :memberOfBand .

:memberOfBand a owl:ObjectProperty ;
  rdfs:label "member of band" ;
  rdfs:comment "Inverse of hasMember: links a membership event to a band." ;
  rdfs:domain :UserBandMembership ;
  rdfs:range :Band .

:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "member person" ;
  rdfs:comment "The person involved in a band membership." ;
  rdfs:domain :UserBandMembership ;
  rdfs:range :Person ;
  owl:inverseOf :hasBandMembership .

:hasBandMembership a owl:ObjectProperty ;
  rdfs:label "has band membership" ;
  rdfs:comment "Inverse of memberPerson: links a person to their band memberships." ;
  rdfs:domain :Person ;
  rdfs:range :UserBandMembership .

:membershipStart a owl:DatatypeProperty ;
  rdfs:label "membership start" ;
  rdfs:comment "Start date of a band membership." ;
  rdfs:domain :UserBandMembership ;
  rdfs:range xsd:date .

:membershipEnd a owl:DatatypeProperty ;
  rdfs:label "membership end" ;
  rdfs:comment "End date of a band membership." ;
  rdfs:domain :UserBandMembership ;
  rdfs:range xsd:date .

:hasRoleAssignment a owl:ObjectProperty ;
  rdfs:label "has role assignment" ;
  rdfs:comment "Links a band to a role assignment event." ;
  rdfs:domain :Band ;
  rdfs:range :UserRoleAssignment ;
  owl:inverseOf :roleAssignmentOfBand .

:roleAssignmentOfBand a owl:ObjectProperty ;
  rdfs:label "role assignment of band" ;
  rdfs:comment "Inverse of hasRoleAssignment: links a role assignment to the band." ;
  rdfs:domain :UserRoleAssignment ;
  rdfs:range :Band .

:assignedPerson a owl:ObjectProperty ;
  rdfs:label "assigned person" ;
  rdfs:comment "The person assigned to a role." ;
  rdfs:domain :UserRoleAssignment ;
  rdfs:range :Person ;
  owl:inverseOf :hasRoleAssignmentEvent .

:hasRoleAssignmentEvent a owl:ObjectProperty ;
  rdfs:label "has role assignment event" ;
  rdfs:comment "Inverse of assignedPerson: links a person to their role assignments." ;
  rdfs:domain :Person ;
  rdfs:range :UserRoleAssignment .

:assignedRole a owl:ObjectProperty ;
  rdfs:label "assigned role" ;
  rdfs:comment "The role assigned to a person in a band." ;
  rdfs:domain :UserRoleAssignment ;
  rdfs:range :Role ;
  owl:inverseOf :roleAssignment .

:roleAssignment a owl:ObjectProperty ;
  rdfs:label "role assignment" ;
  rdfs:comment "Inverse of assignedRole: links a role to its assignments." ;
  rdfs:domain :Role ;
  rdfs:range :UserRoleAssignment .

:roleAssignmentStart a owl:DatatypeProperty ;
  rdfs:label "role assignment start" ;
  rdfs:comment "Start date of a role assignment." ;
  rdfs:domain :UserRoleAssignment ;
  rdfs:range xsd:date .

:roleAssignmentEnd a owl:DatatypeProperty ;
  rdfs:label "role assignment end" ;
  rdfs:comment "End date of a role assignment." ;
  rdfs:domain :UserRoleAssignment ;
  rdfs:range xsd:date .

:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "recorded album" ;
  rdfs:comment "The album recorded during a recording period." ;
  rdfs:domain :AlbumRecordingPeriod ;
  rdfs:range :Album ;
  owl:inverseOf :hasRecordingPeriod .

:hasRecordingPeriod a owl:ObjectProperty ;
  rdfs:label "has recording period" ;
  rdfs:comment "Inverse of recordedAlbum: links an album to its recording periods." ;
  rdfs:domain :Album ;
  rdfs:range :AlbumRecordingPeriod .

:recordingStart a owl:DatatypeProperty ;
  rdfs:label "recording start" ;
  rdfs:comment "Start date of album recording." ;
  rdfs:domain :AlbumRecordingPeriod ;
  rdfs:range xsd:date .

:recordingEnd a owl:DatatypeProperty ;
  rdfs:label "recording end" ;
  rdfs:comment "End date of album recording." ;
  rdfs:domain :AlbumRecordingPeriod ;
  rdfs:range xsd:date .

:albumHasTrack a owl:ObjectProperty ;
  rdfs:label "album has track" ;
  rdfs:comment "Links an album to its tracks." ;
  rdfs:domain :Album ;
  rdfs:range :Track ;
  owl:inverseOf :trackOnAlbum .

:trackOnAlbum a owl:ObjectProperty ;
  rdfs:label "track on album" ;
  rdfs:comment "Inverse of albumHasTrack: links a track to its album." ;
  rdfs:domain :Track ;
  rdfs:range :Album .

:trackSongAssociation a owl:ObjectProperty ;
  rdfs:label "track song association" ;
  rdfs:comment "Links a track-song association to a track." ;
  rdfs:domain :TrackSongAssociation ;
  rdfs:range :Track ;
  owl:inverseOf :hasTrackSongAssociation .

:hasTrackSongAssociation a owl:ObjectProperty ;
  rdfs:label "has track song association" ;
  rdfs:comment "Inverse of trackSongAssociation: links a track to its track-song associations." ;
  rdfs:domain :Track ;
  rdfs:range :TrackSongAssociation .

:associatedSong a owl:ObjectProperty ;
  rdfs:label "associated song" ;
  rdfs:comment "Links a track-song association to a song." ;
  rdfs:domain :TrackSongAssociation ;
  rdfs:range :Song ;
  owl:inverseOf :trackSongAssociationOfSong .

:trackSongAssociationOfSong a owl:ObjectProperty ;
  rdfs:label "track song association of song" ;
  rdfs:comment "Inverse of associatedSong: links a song to its track-song associations." ;
  rdfs:domain :Song ;
  rdfs:range :TrackSongAssociation .

:songComposedOn a owl:DatatypeProperty ;
  rdfs:label "song composed on" ;
  rdfs:comment "Date a song was composed." ;
  rdfs:domain :SongComposition ;
  rdfs:range xsd:date .

:composedSong a owl:ObjectProperty ;
  rdfs:label "composed song" ;
  rdfs:comment "The song that was composed." ;
  rdfs:domain :SongComposition ;
  rdfs:range :Song ;
  owl:inverseOf :hasCompositionEvent .

:hasCompositionEvent a owl:ObjectProperty ;
  rdfs:label "has composition event" ;
  rdfs:comment "Inverse of composedSong: links a song to its composition events." ;
  rdfs:domain :Song ;
  rdfs:range :SongComposition .

:criticReviewAbout a owl:ObjectProperty ;
  rdfs:label "critic review about" ;
  rdfs:comment "The album reviewed in a critic review." ;
  rdfs:domain :CriticReview ;
  rdfs:range :Album ;
  owl:inverseOf :hasCriticReview .

:hasCriticReview a owl:ObjectProperty ;
  rdfs:label "has critic review" ;
  rdfs:comment "Inverse of criticReviewAbout: links an album to its critic reviews." ;
  rdfs:domain :Album ;
  rdfs:range :CriticReview .

:reviewedBy a owl:ObjectProperty ;
  rdfs:label "reviewed by" ;
  rdfs:comment "The critic who wrote a review." ;
  rdfs:domain :CriticReview ;
  rdfs:range :Critic ;
  owl:inverseOf :wroteReview .

:wroteReview a owl:ObjectProperty ;
  rdfs:label "wrote review" ;
  rdfs:comment "Inverse of reviewedBy: links a critic to reviews they wrote." ;
  rdfs:domain :Critic ;
  rdfs:range :CriticReview .

:reviewText a owl:DatatypeProperty ;
  rdfs:label "review text" ;
  rdfs:comment "The text of a critic's review." ;
  rdfs:domain :CriticReview ;
  rdfs:range xsd:string .

:performanceOfAlbum a owl:ObjectProperty ;
  rdfs:label "performance of album" ;
  rdfs:comment "The album featured in a performance." ;
  rdfs:domain :Performance ;
  rdfs:range :Album ;
  owl:inverseOf :performedAt .

:performedAt a owl:ObjectProperty ;
  rdfs:label "performed at" ;
  rdfs:comment "Inverse of performanceOfAlbum: links an album to performances." ;
  rdfs:domain :Album ;
  rdfs:range :Performance .

:performanceDate a owl:DatatypeProperty ;
  rdfs:label "performance date" ;
  rdfs:comment "Date of a performance." ;
  rdfs:domain :Performance ;
  rdfs:range xsd:date .

:performanceSong a owl:ObjectProperty ;
  rdfs:label "performance song" ;
  rdfs:comment "The song performed in a performance." ;
  rdfs:domain :PerformanceSong ;
  rdfs:range :Song ;
  owl:inverseOf :songPerformedAt .

:songPerformedAt a owl:ObjectProperty ;
  rdfs:label "song performed at" ;
  rdfs:comment "Inverse of performanceSong: links a song to performance song events." ;
  rdfs:domain :Song ;
  rdfs:range :PerformanceSong .

:performanceSongPerformedAt a owl:ObjectProperty ;
  rdfs:label "performance song performed at" ;
  rdfs:comment "The performance at which a song was performed." ;
  rdfs:domain :PerformanceSong ;
  rdfs:range :Performance ;
  owl:inverseOf :hasPerformanceSong .

:hasPerformanceSong a owl:ObjectProperty ;
  rdfs:label "has performance song" ;
  rdfs:comment "Inverse of performanceSongPerformedAt: links a performance to its performance song events." ;
  rdfs:domain :Performance ;
  rdfs:range :PerformanceSong .

:performanceLocation a owl:ObjectProperty ;
  rdfs:label "performance location" ;
  rdfs:comment "The city where a performance took place." ;
  rdfs:domain :PerformanceLocation ;
  rdfs:range :City ;
  owl:inverseOf :locationOfPerformance .

:locationOfPerformance a owl:ObjectProperty ;
  rdfs:label "location of performance" ;
  rdfs:comment "Inverse of performanceLocation: links a city to performance locations." ;
  rdfs:domain :City ;
  rdfs:range :PerformanceLocation .

:performanceLocationFor a owl:ObjectProperty ;
  rdfs:label "performance location for" ;
  rdfs:comment "The performance that took place at a location." ;
  rdfs:domain :PerformanceLocation ;
  rdfs:range :Performance ;
  owl:inverseOf :hasPerformanceLocation .

:hasPerformanceLocation a owl:ObjectProperty ;
  rdfs:label "has performance location" ;
  rdfs:comment "Inverse of performanceLocationFor: links a performance to its location associations." ;
  rdfs:domain :Performance ;
  rdfs:range :PerformanceLocation .

:cityInRegion a owl:ObjectProperty ;
  rdfs:label "city in region" ;
  rdfs:comment "The region containing a city." ;
  rdfs:domain :City ;
  rdfs:range :Region ;
  owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
  rdfs:label "region has city" ;
  rdfs:comment "Inverse of cityInRegion: links a region to its cities." ;
  rdfs:domain :Region ;
  rdfs:range :City .

:regionInCountry a owl:ObjectProperty ;
  rdfs:label "region in country" ;
  rdfs:comment "The country containing a region." ;
  rdfs:domain :Region ;
  rdfs:range :Country ;
  owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
  rdfs:label "country has region" ;
  rdfs:comment "Inverse of regionInCountry: links a country to its regions." ;
  rdfs:domain :Country ;
  rdfs:range :Region .

#################################################################
# AlbumRelease connection and properties
#################################################################

:releasedAlbum a owl:ObjectProperty ;
  rdfs:label "released album" ;
  rdfs:comment "Connects AlbumRelease event to the Album released." ;
  rdfs:domain :AlbumRelease ;
  rdfs:range :Album ;
  owl:inverseOf :hasReleaseEvent .

:hasReleaseEvent a owl:ObjectProperty ;
  rdfs:label "has release event" ;
  rdfs:comment "Inverse of releasedAlbum: links an Album to its AlbumRelease event." ;
  rdfs:domain :Album ;
  rdfs:range :AlbumRelease .

:releaseDate a owl:DatatypeProperty ;
  rdfs:label "release date" ;
  rdfs:comment "Date the album was released." ;
  rdfs:domain :AlbumRelease ;
  rdfs:range xsd:date .

#################################################################
# Restrictions & Advanced Axioms
#################################################################

:Album rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty :albumHasTrack ;
  owl:someValuesFrom :Track
] .

# Album must have at least one track (CQ 15)

#################################################################
# End of Ontology
#################################################################
