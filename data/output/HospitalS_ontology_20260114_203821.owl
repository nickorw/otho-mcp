@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/hospital-story>
    a owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "An ontology representing hospital staff, unions, education, publications, and seminars." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human being involved in the hospital context." .
:Nurse a owl:Class ;
    rdfs:label "Nurse" ;
    rdfs:comment "A healthcare professional who is a nurse." ;
    rdfs:subClassOf :Person .
:Doctor a owl:Class ;
    rdfs:label "Doctor" ;
    rdfs:comment "A healthcare professional who is a doctor." ;
    rdfs:subClassOf :Person .
:NursingAssistant a owl:Class ;
    rdfs:label "Nursing Assistant" ;
    rdfs:comment "A person trained as a nursing assistant." ;
    rdfs:subClassOf :Nurse .
:CertifiedNurse a owl:Class ;
    rdfs:label "Certified Nurse" ;
    rdfs:comment "A nurse with a certification or degree." ;
    rdfs:subClassOf :Nurse .
:Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "A person employed at a hospital." ;
    rdfs:subClassOf :Person .
:PatientCareEmployee a owl:Class ;
    rdfs:label "Patient Care Employee" ;
    rdfs:comment "An employee involved in patient care." ;
    rdfs:subClassOf :Employee .
:Degree a owl:Class ;
    rdfs:label "Degree" ;
    rdfs:comment "An academic or professional degree." .
:DegreeAcquisition a owl:Class ;
    rdfs:label "Degree Acquisition" ;
    rdfs:comment "A reified event where a person acquires a degree over a time period." .
:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A reified employment event linking a person to a hospital over time." .
:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:comment "A hospital institution." .
:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where hospitals are located." .
:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing cities." .
:Union a owl:Class ;
    rdfs:label "Union" ;
    rdfs:comment "A staff union at a hospital." .
:UnionMembership a owl:Class ;
    rdfs:label "Union Membership" ;
    rdfs:comment "A reified event linking a person to a union, potentially with a role and time period." .
:UnionRole a owl:Class ;
    rdfs:label "Union Role" ;
    rdfs:comment "A role held by a person within a union (e.g., representative)." .
:Evaluation a owl:Class ;
    rdfs:label "Evaluation" ;
    rdfs:comment "A written evaluation of an employee by a doctor." .
:ResearchArticle a owl:Class ;
    rdfs:label "Research Article" ;
    rdfs:comment "A research article relevant to hospital staff and practice." .
:ArticleCollection a owl:Class ;
    rdfs:label "Article Collection" ;
    rdfs:comment "A collection of research articles, as a book or CD." .
:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A book containing research articles." ;
    rdfs:subClassOf :ArticleCollection .
:CD a owl:Class ;
    rdfs:label "CD" ;
    rdfs:comment "A CD containing research articles." ;
    rdfs:subClassOf :ArticleCollection .
:Seminar a owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A seminar where articles are presented and discussed." .
:ArticlePresentation a owl:Class ;
    rdfs:label "Article Presentation" ;
    rdfs:comment "A reified event of a research article being presented at a seminar." .

### Disjointness & DisjointUnion
:Nurse owl:disjointWith :Doctor .
:Book owl:disjointWith :CD .
:ArticleCollection owl:disjointUnionOf (:Book :CD) .

### Object Properties (with inverses)
:hasDegree a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has degree" ;
    rdfs:comment "Links a person to a degree acquisition event." ;
    rdfs:domain :Person ;
    rdfs:range :DegreeAcquisition ;
    owl:inverseOf :degreeOf .
:degreeOf a owl:ObjectProperty ;
    rdfs:label "degree of" ;
    rdfs:comment "Inverse of hasDegree; links a degree acquisition to a person." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range :Person ;
    owl:inverseOf :hasDegree .
:acquiredDegree a owl:ObjectProperty ;
    rdfs:label "acquired degree" ;
    rdfs:comment "Links a degree acquisition event to a degree." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range :Degree ;
    owl:inverseOf :degreeAcquisitionOf .
:degreeAcquisitionOf a owl:ObjectProperty ;
    rdfs:label "degree acquisition of" ;
    rdfs:comment "Inverse of acquiredDegree; links a degree to a degree acquisition." ;
    rdfs:domain :Degree ;
    rdfs:range :DegreeAcquisition ;
    owl:inverseOf :acquiredDegree .
:employedAt a owl:ObjectProperty ;
    rdfs:label "employed at" ;
    rdfs:comment "Links an employment event to a hospital." ;
    rdfs:domain :Employment ;
    rdfs:range :Hospital ;
    owl:inverseOf :hasEmployment .
:hasEmployment a owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:comment "Inverse of employedAt; links a hospital to an employment event." ;
    rdfs:domain :Hospital ;
    rdfs:range :Employment ;
    owl:inverseOf :employedAt .
:employmentPerson a owl:ObjectProperty ;
    rdfs:label "employment person" ;
    rdfs:comment "Links an employment event to a person." ;
    rdfs:domain :Employment ;
    rdfs:range :Person ;
    owl:inverseOf :personEmployment .
:personEmployment a owl:ObjectProperty ;
    rdfs:label "person employment" ;
    rdfs:comment "Inverse of employmentPerson; links a person to an employment event." ;
    rdfs:domain :Person ;
    rdfs:range :Employment ;
    owl:inverseOf :employmentPerson .
:hospitalLocatedIn a owl:ObjectProperty ;
    rdfs:label "hospital located in" ;
    rdfs:comment "Links a hospital to a city." ;
    rdfs:domain :Hospital ;
    rdfs:range :City ;
    owl:inverseOf :cityHasHospital .
:cityHasHospital a owl:ObjectProperty ;
    rdfs:label "city has hospital" ;
    rdfs:comment "Inverse of hospitalLocatedIn; links a city to a hospital." ;
    rdfs:domain :City ;
    rdfs:range :Hospital ;
    owl:inverseOf :hospitalLocatedIn .
:cityInCountry a owl:ObjectProperty ;
    rdfs:label "city in country" ;
    rdfs:comment "Links a city to a country." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasCity .
:countryHasCity a owl:ObjectProperty ;
    rdfs:label "country has city" ;
    rdfs:comment "Inverse of cityInCountry; links a country to a city." ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    owl:inverseOf :cityInCountry .
:hasUnionMembership a owl:ObjectProperty ;
    rdfs:label "has union membership" ;
    rdfs:comment "Links a person to a union membership event." ;
    rdfs:domain :Person ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionMembershipOf .
:unionMembershipOf a owl:ObjectProperty ;
    rdfs:label "union membership of" ;
    rdfs:comment "Inverse of hasUnionMembership; links a union membership to a person." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasUnionMembership .
:unionOfMembership a owl:ObjectProperty ;
    rdfs:label "union of membership" ;
    rdfs:comment "Links a union membership event to a union." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Union ;
    owl:inverseOf :hasUnionMembershipEvent .
:hasUnionMembershipEvent a owl:ObjectProperty ;
    rdfs:label "has union membership event" ;
    rdfs:comment "Inverse of unionOfMembership; links a union to a union membership event." ;
    rdfs:domain :Union ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionOfMembership .
:unionMembershipRole a owl:ObjectProperty ;
    rdfs:label "union membership role" ;
    rdfs:comment "Role held during union membership." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :UnionRole ;
    owl:inverseOf :roleOfUnionMembership .
:roleOfUnionMembership a owl:ObjectProperty ;
    rdfs:label "role of union membership" ;
    rdfs:comment "Inverse of unionMembershipRole; links a union role to a union membership event." ;
    rdfs:domain :UnionRole ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionMembershipRole .
:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluated by" ;
    rdfs:comment "Links an evaluation to the doctor who performed it." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Doctor ;
    owl:inverseOf :performsEvaluation .
:performsEvaluation a owl:ObjectProperty ;
    rdfs:label "performs evaluation" ;
    rdfs:comment "Inverse of evaluatedBy; links a doctor to an evaluation." ;
    rdfs:domain :Doctor ;
    rdfs:range :Evaluation ;
    owl:inverseOf :evaluatedBy .
:evaluatesEmployee a owl:ObjectProperty ;
    rdfs:label "evaluates employee" ;
    rdfs:comment "Links an evaluation to the employee evaluated." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Employee ;
    owl:inverseOf :employeeEvaluation .
:employeeEvaluation a owl:ObjectProperty ;
    rdfs:label "employee evaluation" ;
    rdfs:comment "Inverse of evaluatesEmployee; links an employee to an evaluation." ;
    rdfs:domain :Employee ;
    rdfs:range :Evaluation ;
    owl:inverseOf :evaluatesEmployee .
:hasArticle a owl:ObjectProperty ;
    rdfs:label "has article" ;
    rdfs:comment "Links an article collection to a research article." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :ResearchArticle ;
    owl:inverseOf :isArticleOfCollection .
:isArticleOfCollection a owl:ObjectProperty ;
    rdfs:label "is article of collection" ;
    rdfs:comment "Inverse of hasArticle; links a research article to an article collection." ;
    rdfs:domain :ResearchArticle ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :hasArticle .
:hasArticlePresentation a owl:ObjectProperty ;
    rdfs:label "has article presentation" ;
    rdfs:comment "Links a seminar to an article presentation event." ;
    rdfs:domain :Seminar ;
    rdfs:range :ArticlePresentation ;
    owl:inverseOf :articlePresentationOf .
:articlePresentationOf a owl:ObjectProperty ;
    rdfs:label "article presentation of" ;
    rdfs:comment "Inverse of hasArticlePresentation; links an article presentation to a seminar." ;
    rdfs:domain :ArticlePresentation ;
    rdfs:range :Seminar ;
    owl:inverseOf :hasArticlePresentation .
:presentedArticle a owl:ObjectProperty ;
    rdfs:label "presented article" ;
    rdfs:comment "Links an article presentation to the research article presented." ;
    rdfs:domain :ArticlePresentation ;
    rdfs:range :ResearchArticle ;
    owl:inverseOf :isPresentedIn .
:isPresentedIn a owl:ObjectProperty ;
    rdfs:label "is presented in" ;
    rdfs:comment "Inverse of presentedArticle; links a research article to an article presentation event." ;
    rdfs:domain :ResearchArticle ;
    rdfs:range :ArticlePresentation ;
    owl:inverseOf :presentedArticle .

### Data Properties
:degreeStartDate a owl:DatatypeProperty ;
    rdfs:label "degree start date" ;
    rdfs:comment "The start date of a degree." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range xsd:dateTime .
:degreeEndDate a owl:DatatypeProperty ;
    rdfs:label "degree end date" ;
    rdfs:comment "The end date of a degree." ;
    rdfs:domain :DegreeAcquisition ;
    rdfs:range xsd:dateTime .
:employmentStartDate a owl:DatatypeProperty ;
    rdfs:label "employment start date" ;
    rdfs:comment "Start date of an employment." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .
:unionMembershipStartDate a owl:DatatypeProperty ;
    rdfs:label "union membership start date" ;
    rdfs:comment "Start date of a union membership." ;
    rdfs:domain :UnionMembership ;
    rdfs:range xsd:dateTime .
:evaluationStatement a owl:DatatypeProperty ;
    rdfs:label "evaluation statement" ;
    rdfs:comment "The written statement of an evaluation." ;
    rdfs:domain :Evaluation ;
    rdfs:range xsd:string .
:pages a owl:DatatypeProperty ;
    rdfs:label "pages" ;
    rdfs:comment "Number of pages in a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer .
:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publication date" ;
    rdfs:comment "Publication date of a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:dateTime .
:publicationDateCD a owl:DatatypeProperty ;
    rdfs:label "publication date CD" ;
    rdfs:comment "Publication date of a CD." ;
    rdfs:domain :CD ;
    rdfs:range xsd:dateTime .
:seminarDate a owl:DatatypeProperty ;
    rdfs:label "seminar date" ;
    rdfs:comment "Date of a seminar." ;
    rdfs:domain :Seminar ;
    rdfs:range xsd:dateTime .
:personName a owl:DatatypeProperty ;
    rdfs:label "person name" ;
    rdfs:comment "Name of a person." ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .
:degreeTitle a owl:DatatypeProperty ;
    rdfs:label "degree title" ;
    rdfs:comment "Title of a degree." ;
    rdfs:domain :Degree ;
    rdfs:range xsd:string .
:unionName a owl:DatatypeProperty ;
    rdfs:label "union name" ;
    rdfs:comment "Name of a union." ;
    rdfs:domain :Union ;
    rdfs:range xsd:string .
:unionRoleLabel a owl:DatatypeProperty ;
    rdfs:label "union role label" ;
    rdfs:comment "Label for a union role." ;
    rdfs:domain :UnionRole ;
    rdfs:range xsd:string .
:hospitalName a owl:DatatypeProperty ;
    rdfs:label "hospital name" ;
    rdfs:comment "Name of a hospital." ;
    rdfs:domain :Hospital ;
    rdfs:range xsd:string .
:cityName a owl:DatatypeProperty ;
    rdfs:label "city name" ;
    rdfs:comment "Name of a city." ;
    rdfs:domain :City ;
    rdfs:range xsd:string .
:countryName a owl:DatatypeProperty ;
    rdfs:label "country name" ;
    rdfs:comment "Name of a country." ;
    rdfs:domain :Country ;
    rdfs:range xsd:string .
:articleTitle a owl:DatatypeProperty ;
    rdfs:label "article title" ;
    rdfs:comment "Title of a research article." ;
    rdfs:domain :ResearchArticle ;
    rdfs:range xsd:string .
:articleCollectionTitle a owl:DatatypeProperty ;
    rdfs:label "article collection title" ;
    rdfs:comment "Title of an article collection." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range xsd:string .
:seminarTitle a owl:DatatypeProperty ;
    rdfs:label "seminar title" ;
    rdfs:comment "Title of a seminar." ;
    rdfs:domain :Seminar ;
    rdfs:range xsd:string .

### Restrictions and GCAs
:Seminar rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasArticlePresentation ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :ArticlePresentation ] .

