/ontology#isCompositeElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>Composite element grouping simple data elements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#TAXSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>TAX Segment</rdfs:label>    <rdfs:comment>Tax segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>A line item in the invoice detail section.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>Role played by an organization in a transaction (e.g. Buyer, Supplier, Delivery Party).</rdfs:comment>  </rdf:Description></rdf:RDF>