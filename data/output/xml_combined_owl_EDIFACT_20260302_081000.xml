<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#hasTax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has Tax</rdfs:label>    <rdfs:comment>Links an InvoiceSummary to its Tax.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Tax"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isTaxOfSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has Line Item</rdfs:label>    <rdfs:comment>Links an InvoiceDetail to its line items.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isLineItemOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DTM137DocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>DTM 137 Document Date</rdfs:label>    <rdfs:comment>DTM segment for Document Date (qualifier 137).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#DTMSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Quantity</rdfs:label>    <rdfs:comment>Quantity for a line item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>Any organization involved in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Line Item Of InvoiceDetail</rdfs:label>    <rdfs:comment>Indicates that a LineItem is part of an InvoiceDetail.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDeliveryDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Delivery Date</rdfs:label>    <rdfs:comment>Delivery date in the header.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DTM35DeliveryDate"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Role Of OrganizationRoleAssignment</rdfs:label>    <rdfs:comment>Indicates that an AgentRole is part of an OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>Generic identifier for organizations or documents.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Address Of Organization</rdfs:label>    <rdfs:comment>Indicates that an Address is associated with an Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>Envelope containing EDIFACT messages.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Message</rdfs:label>    <rdfs:comment>Links an Interchange Envelope to its contained Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isMessageOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOfLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Price Of LineItem</rdfs:label>    <rdfs:comment>Indicates that a Price is part of a LineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DTM11DespatchDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>DTM 11 Despatch Date</rdfs:label>    <rdfs:comment>DTM segment for Despatch Date (qualifier 11).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#DTMSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Tax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Tax</rdfs:label>    <rdfs:comment>Tax applied in the invoice summary.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationInvolvedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Organization Involved In Invoice</rdfs:label>    <rdfs:comment>Indicates that an OrganizationRoleAssignment is part of an Invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Invoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#NADBuyer">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>NAD Buyer</rdfs:label>    <rdfs:comment>NAD segment for Buyer role.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#NADSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#NADDeliveryParty">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>NAD Delivery Party</rdfs:label>    <rdfs:comment>NAD segment for Delivery Party role.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#NADSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifiedBy">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Identified By BGM Segment</rdfs:label>    <rdfs:comment>Indicates that an Invoice is identified by a BGM Segment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BGMSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BGMSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>BGM Segment</rdfs:label>    <rdfs:comment>Beginning of Message segment for document identification.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSimpleElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Simple Element Of Composite Data Element</rdfs:label>    <rdfs:comment>Indicates that a Simple Data Element is part of a Composite Data Element.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Header</rdfs:label>    <rdfs:comment>Header section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#involvesOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>involves Organization</rdfs:label>    <rdfs:comment>Links an Invoice to its OrganizationRoleAssignment instances.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationInvolvedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Invoice Number</rdfs:label>    <rdfs:comment>Invoice number in the header.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTotalTax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Total Tax</rdfs:label>    <rdfs:comment>Total tax amount in the summary.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#MOA176TotalTax"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Segment Of Message</rdfs:label>    <rdfs:comment>Indicates that a Segment is part of a Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DTMSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>DTM Segment</rdfs:label>    <rdfs:comment>Date/Time/Period segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#MOASegment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#LINSegment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#QTYSegment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#PRISegment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#TAXSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Invoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice</rdfs:label>    <rdfs:comment>Invoice represented in an INVOIC message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAssignmentOfOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Assignment Of OrganizationRoleAssignment</rdfs:label>    <rdfs:comment>Indicates that an Organization is part of an OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isTaxOfSummary">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Tax Of InvoiceSummary</rdfs:label>    <rdfs:comment>Indicates that a Tax is part of an InvoiceSummary.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Document Date</rdfs:label>    <rdfs:comment>Document date in the header.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DTM137DocumentDate"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A generic EDIFACT message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>Atomic data element in EDIFACT segments.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Role</rdfs:label>    <rdfs:comment>Links an OrganizationRoleAssignment to an AgentRole.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOfAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#GlobalLocationNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Global Location Number</rdfs:label>    <rdfs:comment>GLN used to uniquely identify organizations.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Identifier"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemOfLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Item Of LineItem</rdfs:label>    <rdfs:comment>Indicates that an Item is part of a LineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#MOA176TotalTax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>MOA 176 Total Tax</rdfs:label>    <rdfs:comment>MOA segment for Total Tax (qualifier 176).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#MOASegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#MOA77InvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>MOA 77 Invoice Amount</rdfs:label>    <rdfs:comment>MOA segment for Invoice Amount (qualifier 77).</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#MOASegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail</rdfs:label>    <rdfs:comment>Detail section listing line items in the invoice.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#identifiesInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>identifies Invoice</rdfs:label>    <rdfs:comment>Links a BGM Segment to the Invoice it identifies.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BGMSegment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Invoice"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIdentifiedBy"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#PRISegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>PRI Segment</rdfs:label>    <rdfs:comment>Price segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDespatchDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Despatch Date</rdfs:label>    <rdfs:comment>Despatch date in the header.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DTM11DespatchDate"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has Invoice Amount</rdfs:label>    <rdfs:comment>Total invoice amount in the summary.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#MOA77InvoiceAmount"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>assigned Organization</rdfs:label>    <rdfs:comment>Links an OrganizationRoleAssignment to an Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAssignmentOfOrganization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#EDIFACT_INVOIC_Story">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT INVOIC Ontology for D96A Story</rdfs:label>    <rdfs:comment>Ontology capturing the structure of EDIFACT INVOIC messages, segments, qualifiers, and D96A requirements as described in the provided story.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is Identifier Of Organization</rdfs:label>    <rdfs:comment>Indicates that an Identifier is associated with an Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>contains Segment</rdfs:label>    <rdfs:comment>Links a Message to its segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#NADSupplier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>NAD Supplier</rdfs:label>    <rdfs:comment>NAD segment for Supplier role.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#NADSegment"/>  </rdf:Description>  <rdf:Description r