ource="http://www.example.org/ontology#hasPrice"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#Price"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n2a509f6432f24baa958febe14286215cb3">    <rdf:first rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdf:rest rdf:nodeID="n2a509f6432f24baa958febe14286215cb4"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationRoleOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is organization role of</rdfs:label>    <rdfs:comment>Inverse property: links a role assignment to its invoice message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#RoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasOrganizationRole"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n2a509f6432f24baa958febe14286215cb15">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasOrganizationRole"/>    <owl:allValuesFrom rdf:resource="http://www.example.org/ontology#RoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>assigned role</rdfs:label>    <rdfs:comment>Links a role assignment to a specific agent role (e.g., buyer, seller).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#RoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOfAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectPr