e linking an organization, its role, and the invoice context.</rdfs:comment>    <rdfs:subClassOf rdf:nodeID="n2a509f6432f24baa958febe14286215cb11"/>    <rdfs:subClassOf rdf:nodeID="n2a509f6432f24baa958febe14286215cb12"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>A legal entity involved in the invoice process, such as buyer or seller.</rdfs:comment>    <rdfs:subClassOf rdf:nodeID="n2a509f6432f24baa958febe14286215cb13"/>    <rdfs:subClassOf rdf:nodeID="n2a509f6432f24baa958febe14286215cb14"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Item"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Price"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#netPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>net price</rdfs:label>    <rdfs:comment>The net price of an item in the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n2a509f6432f24baa958febe14286215cb1">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <owl:unionOf rdf:nodeID="n2a509f6432f24baa958febe14286215cb2"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n2a509f6432f24baa958febe14286215cb7">    <rdf:first rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdf:rest rdf:nodeID="n2a509f6432f24baa958febe14286215cb8"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse property: links a segment to its EDIFACT message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#EdifactMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role of assignment</rdfs:label>    <rdfs:comment>Inverse property: links an agent role to its role assignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#RoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#assignedRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#invoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>invoice amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSumm