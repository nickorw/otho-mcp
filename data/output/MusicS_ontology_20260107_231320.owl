@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    rdf:type owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "Ontology for music production, band membership, albums, tracks, performances, and related entities." .

#################################################################
# Classes
#################################################################
:Person rdf:type owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in music production." .

:Band rdf:type owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A music group or ensemble." ;
    owl:disjointWith :Person .

:Instrument rdf:type owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." ;
    owl:disjointWith :Role .

:Role rdf:type owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A specific role held by a person within a band." ;
    owl:disjointWith :Instrument .

:Album rdf:type owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of music tracks released together." ;
    owl:disjointWith :Track, :Song, :Performance .

:Track rdf:type owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A single music track included in an album." ;
    owl:disjointWith :Album .

:Song rdf:type owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition." ;
    owl:disjointWith :Album .

:Critic rdf:type owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews music albums." ;
    rdfs:subClassOf :Person .

:Performance rdf:type owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live event where music is performed." ;
    owl:disjointWith :Album .

:City rdf:type owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances can take place." ;
    owl:disjointWith :Region .

:Region rdf:type owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographic region containing cities." ;
    owl:disjointWith :Country .

:Country rdf:type owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Pivot Classes for Reification
:UserBandMembership rdf:type owl:Class ;
    rdfs:label "User Band Membership" ;
    rdfs:comment "Reifies a person's membership in a band at a specific time and with a specific role." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Role ] .

:TrackRecording rdf:type owl:Class ;
    rdfs:label "Track Recording" ;
    rdfs:comment "Reifies the relationship between a track and the song it records." .

:SongComposition rdf:type owl:Class ;
    rdfs:label "Song Composition" ;
    rdfs:comment "Reifies the composition of a song by a person at a specific date." .

:AlbumRecording rdf:type owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "Reifies the recording period of an album by a band." .

:AlbumRelease rdf:type owl:Class ;
    rdfs:label "Album Release" ;
    rdfs:comment "Reifies the release of an album on a specific date." .

:PerformanceSong rdf:type owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "Reifies the performance of a song during a live event." .

:PerformanceLocation rdf:type owl:Class ;
    rdfs:label "Performance Location" ;
    rdfs:comment "Reifies the location of a performance in a city." .

#################################################################
# Object Properties (reviewed inverses)
#################################################################
:playsInstrument rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Indicates the instrument played by a person." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :isPlayedBy .

:isPlayedBy rdf:type owl:ObjectProperty ;
    rdfs:label "is played by" ;
    rdfs:comment "Inverse property: the instrument is played by a person." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

# Only true logical inverses are defined below
:hasMember rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Indicates the membership relation from a band to a UserBandMembership." ;
    rdfs:domain :Band ;
    rdfs:range :UserBandMembership ;
    owl:inverseOf :isMembershipOfBand .

:isMembershipOfBand rdf:type owl:ObjectProperty ;
    rdfs:label "is membership of band" ;
    rdfs:comment "Inverse property: the membership is of a band." ;
    rdfs:domain :UserBandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember .

:containsTrack rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains track" ;
    rdfs:comment "Indicates the tracks contained in an album." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :isTrackOfAlbum .

:isTrackOfAlbum rdf:type owl:ObjectProperty ;
    rdfs:label "is track of album" ;
    rdfs:comment "Inverse property: the track is contained in an album." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :containsTrack .

:isRecordingOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "is recording of" ;
    rdfs:comment "Indicates the track that is a recording of a song." ;
    rdfs:domain :TrackRecording ;
    rdfs:range :Track ;
    owl:inverseOf :hasRecording .

:hasRecording rdf:type owl:ObjectProperty ;
    rdfs:label "has recording" ;
    rdfs:comment "Inverse property: the track has a recording event." ;
    rdfs:domain :Track ;
    rdfs:range :TrackRecording ;
    owl:inverseOf :isRecordingOf .

:isTrackOfSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "is track of song" ;
    rdfs:comment "Indicates the song that is recorded in a track." ;
    rdfs:domain :TrackRecording ;
    rdfs:range :Song ;
    owl:inverseOf :hasTrackRecording .

:hasTrackRecording rdf:type owl:ObjectProperty ;
    rdfs:label "has track recording" ;
    rdfs:comment "Inverse property: the song has a track recording event." ;
    rdfs:domain :Song ;
    rdfs:range :TrackRecording ;
    owl:inverseOf :isTrackOfSong .

:criticReview rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "critic review" ;
    rdfs:comment "Indicates the album reviewed by a critic." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :isReviewedBy .

:isReviewedBy rdf:type owl:ObjectProperty ;
    rdfs:label "is reviewed by" ;
    rdfs:comment "Inverse property: the album is reviewed by a critic." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :criticReview .

:performanceBand rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance band" ;
    rdfs:comment "Indicates the band performing at a live event." ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :isPerformedIn .

:isPerformedIn rdf:type owl:ObjectProperty ;
    rdfs:label "is performed in" ;
    rdfs:comment "Inverse property: the band is performed in a performance." ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceBand .

:performanceSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance song" ;
    rdfs:comment "Indicates the performance event for a song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceSong .

:hasPerformanceSong rdf:type owl:ObjectProperty ;
    rdfs:label "has performance song" ;
    rdfs:comment "Inverse property: the performance has a performance song event." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceSong .

:performedSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performed song" ;
    rdfs:comment "Indicates the song performed in a performance event." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :isPerformedSongIn .

:isPerformedSongIn rdf:type owl:ObjectProperty ;
    rdfs:label "is performed song in" ;
    rdfs:comment "Inverse property: the song is performed in a performance song event." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performedSong .

:performanceLocation rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "Indicates the location event for a performance." ;
    rdfs:domain :PerformanceLocation ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceLocation .

:hasPerformanceLocation rdf:type owl:ObjectProperty ;
    rdfs:label "has performance location" ;
    rdfs:comment "Inverse property: the performance has a performance location event." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceLocation ;
    owl:inverseOf :performanceLocation .

:locationCity rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "location city" ;
    rdfs:comment "Indicates the city where a performance takes place." ;
    rdfs:domain :PerformanceLocation ;
    rdfs:range :City ;
    owl:inverseOf :isLocationOf .

:isLocationOf rdf:type owl:ObjectProperty ;
    rdfs:label "is location of" ;
    rdfs:comment "Inverse property: the city is the location of a performance location event." ;
    rdfs:domain :City ;
    rdfs:range :PerformanceLocation ;
    owl:inverseOf :locationCity .

:cityInRegion rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "city in region" ;
    rdfs:comment "Indicates the region containing a city." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :hasCity .

:hasCity rdf:type owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Inverse property: the region has a city." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :cityInRegion .

:regionInCountry rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "region in country" ;
    rdfs:comment "Indicates the country containing a region." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :hasRegion .

:hasRegion rdf:type owl:ObjectProperty ;
    rdfs:label "has region" ;
    rdfs:comment "Inverse property: the country has a region." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :regionInCountry .

#################################################################
# Data Properties
#################################################################
:membershipTime rdf:type owl:DatatypeProperty ;
    rdfs:label "membership time" ;
    rdfs:comment "The time period of a person's membership in a band." ;
    rdfs:domain :UserBandMembership ;
    rdfs:range xsd:dateTime .

:recordingPeriodStart rdf:type owl:DatatypeProperty ;
    rdfs:label "recording period start" ;
    rdfs:comment "Start of the album recording period." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:recordingPeriodEnd rdf:type owl:DatatypeProperty ;
    rdfs:label "recording period end" ;
    rdfs:comment "End of the album recording period." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:compositionDate rdf:type owl:DatatypeProperty ;
    rdfs:label "composition date" ;
    rdfs:comment "Date of song composition." ;
    rdfs:domain :SongComposition ;
    rdfs:range xsd:dateTime .

:releaseDate rdf:type owl:DatatypeProperty ;
    rdfs:label "release date" ;
    rdfs:comment "Release date of an album." ;
    rdfs:domain :AlbumRelease ;
    rdfs:range xsd:dateTime .

:reviewText rdf:type owl:DatatypeProperty ;
    rdfs:label "review text" ;
    rdfs:comment "Text of a critic's review." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:performanceDate rdf:type owl:DatatypeProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "Date of a performance event." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

#################################################################
# Complex Axioms & Restrictions
#################################################################
:Band owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasMember ; owl:someValuesFrom :UserBandMembership ] .

:Album owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] ;
    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :containsTrack ; owl:minCardinality 1 ; owl:someValuesFrom :Track ] .

:Track owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :isTrackOfSong ; owl:someValuesFrom :Song ] .

:Performance owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :performanceBand ; owl:someValuesFrom :Band ] .
