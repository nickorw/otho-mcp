ww.example.org/ontology#Segment"/>    <rdfs:subClassOf rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab6"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>A line item in the invoice detail section.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail</rdfs:label>    <rdfs:comment>Detail segment listing line items.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in a transaction (e.g., Buyer, Seller, Delivery Party).</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOfOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is identifier of organization</rdfs:label>    <rdfs:comment>Inverse of hasIdentifier: Links an Identifier to its Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOfMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of message</rdfs:label>    <rdfs:comment>Inverse of containsSegment: Relates a Segment to its parent Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an Interchange Envelope to the messages it contains.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOfDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is line item of detail</rdfs:label>    <rdfs:comment>Inverse of hasLineItem: Links a LineItem to its InvoiceDetail.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#invoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>invoice number</rdfs:label>    <rdfs:comment>The invoice number as a string.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DeliveryPartyRole">    <rdf:type rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>Delivery Party Role</rdfs:label>    <rdfs:comment>The role of delivery party in a transaction.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Links an organization to its address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOfOrganization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BuyerOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Buyer Organization</rdfs:label>    <rdfs:comment>An organization playing the Buyer role in an invoice.</rdfs:comment>    <owl:equivalentClass rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab1"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab4">    <rdf:first rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab2"/>    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationAssigned">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is organization assigned</rdfs:label>    <rdfs:comment>Inverse of assignedOrganization: Links an Organization to its OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab5">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#containsSegment"/>    <owl:allValuesFrom rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentReference">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has document reference</rdfs:label>    <rdfs:comment>Links an invoice header to its document references.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#DocumentReference"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDocumentReferenceOfHeader"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The top-level envelope for EDIFACT messages, containing one or more messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BuyerRole">    <rdf:type rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>Buyer Role</rdfs:label>    <rdfs:comment>The role of buyer in a transaction.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>An item being sold in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab1">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <owl:intersectionOf rdf:nodeID="n15f7ce96a4a542eaba58f431ca51151ab3"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>assigned organization</rdfs:label>    <rdfs:comment>Links an organization role assignment to the assigned organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationAssigned"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#taxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>tax amount</rdfs:label>    <rdfs:comment>The tax amount for the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A generic EDIFACT message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#TotalAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Total Amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#UNEDIFACTInvoiceOntology">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology for representing UN/EDIFACT invoice messages, roles, and business document structure, aligned with EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description></rdf:RDF>