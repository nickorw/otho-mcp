f:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>A deep OWL ontology for EDIFACT invoice messages, D96A/EANCOM/EN16931-1, and P2P-O requirements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Composite data element has simple data elements.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#HeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Header Section</rdfs:label>    <rdfs:comment>Header section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#DetailSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#documentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>document date</rdfs:label>    <rdfs:comment>Date in header section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <owl:FunctionalProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:FunctionalProperty>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Interchange envelope contains messages.</rdfs:comment>    <rdfs:domain rdf:resource="