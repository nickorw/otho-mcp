pe.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>    <owl:equivalentClass rdf:nodeID="nc17e62cb7d184ab0bd6c299f47401cc7b2"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>An item sold in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>Composite data element within a segment.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Organization has address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:nodeID="nc17e62cb7d184ab0bd6c299f47401cc7b1">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <owl:disjointUnionOf rdf:nodeID="nc17e62cb7d184ab0bd6c299f47401cc7b4"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>Net price of an item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#addressLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>address line</rdfs:label>    <rdfs:comment>Address line of an address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Invoice message has line items.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>Address of an organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Assignment</rdfs:label>    <rdfs:comment>Pivot class for linking organizations to roles in a message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment in an EDIFACT message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#globalLocationNumberValue">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>GLN value</rdfs:label>    <rdfs:comment>Value of a global location number.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#GlobalLocationNumber"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <owl:FunctionalProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:FunctionalProperty>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Number</rdfs:label>    <rdfs:comment>Invoice number.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#TaxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Tax Amount</rdfs:label>    <rdfs:comment>Total tax amount in the summary section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="nc17e62cb7d184ab0bd6c299f47401cc7b4">    <rdf:first rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdf:rest rdf:nodeID="nc17e62cb7d184ab0bd6c299f47401cc7b5"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>Generic identifier required by D96A.</rdfs:comment>  </rdf:Description></rdf:RDF>