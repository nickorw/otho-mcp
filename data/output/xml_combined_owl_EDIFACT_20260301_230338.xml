tem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process to which the invoice may be assigned.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse of hasSegment. Relates a segment to its message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an interchange envelope to its contained messages.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>An identifier (such as GLN) for the organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Descrip