:label>    <rdfs:comment>Pivot class for assigning roles to organizations within an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:nodeID="n256262a46b7e4f14ad2bcad5ab12eb29b12"/>    <rdfs:subClassOf rdf:nodeID="n256262a46b7e4f14ad2bcad5ab12eb29b13"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is line item of</rdfs:label>    <rdfs:comment>Inverse of hasLineItem. Relates a line item to its invoice message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment in an EDIFACT message, e.g., BGM, NAD.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has invoice message</rdfs:label>    <rdfs:comment>Inverse of partOfProcess. Relates a business process to its invoice messages.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#partOfProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#taxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>tax amount</rdfs:label>    <rdfs:comment>Total tax amount of the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology/UNEDIFACT-Story-Ontology">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Story Ontology</rdfs:label>    <rdfs:comment>Ontology capturing the structure and semantics of UN/EDIFACT invoice messages, organizations, roles, items, and business processes for procurement and validation.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role assignment of</rdfs:label>    <rdfs:comment>Inverse of hasRoleAssignment. Relates a role assignment to its invoice message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#itemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>item of</rdfs:label>    <rdfs:comment>Relates an invoice line item to its item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasLineItemObject"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Relates an invoice line item to its price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceLineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Inverse of containsMessage. Relates a message to its envelope.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#containsMessage"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n256262a46b7e4f14ad2bcad5ab12eb29b10">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasSection"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#DetailSection"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n256262a46b7e4f14ad2bcad5ab12eb29b9">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasSection"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#HeaderSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#netPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>net price</rdfs:label>    <rdfs:comment>Net price of an item in the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/on