:relatesToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLineItemRelation ;
    rdfs:range :Cl_Item .

:partOfNetPriceCalculation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLineItemRelation ;
