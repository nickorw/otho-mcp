:specifiesRequiredField a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredField ;
    rdfs:range :Cl_Field .

:hasPresenceRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldPresence .

:hasValueSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldValueSpecification .

:hasValueTypeConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldValueSpecification ;
    rdfs:range :Cl_ValueTypeConstraint .

:hasAllowedFormatPattern a owl:ObjectProperty ;
