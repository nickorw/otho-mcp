:hasRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_InformationRequirement .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_Field .

:appliesToField a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationRequirement ;
    rdfs:range :Cl_Field .

:hasFieldType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldType .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldConstraint .

:allowsValue a owl:ObjectProperty ;
