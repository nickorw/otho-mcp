#################################################################
# Restrictions and General Class Axioms
#################################################################

:Cl_EDIFACTMessage rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceListing ;
    owl:someValuesFrom :Cl_InvoiceListing
] .

:Cl_InvoiceListing rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :listsInvoice ;
    owl:someValuesFrom :Cl_Invoice
] ;
    rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :belongsToMessage ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_EDIFACTMessage
] .

:Cl_InvoiceOrganizationInvolvement rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization
] , [
    a owl:Restriction ; owl:onProperty :involvesInvoice ; owl:someValuesFrom :Cl_Invoice
] .

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :hasInvolvedOrganization ; owl:allValuesFrom :Cl_Organization
] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :hasInvoiceItem ; owl:allValuesFrom :Cl_InvoiceItem
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :hasNetPriceCalculation ; owl:someValuesFrom :Cl_NetPriceCalculation
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_BuyerAddressAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :buyerAddressAssignment_hasBuyer ;
    owl:allValuesFrom :Cl_Buyer
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :buyerAddressAssignment_hasAddress ;
    owl:allValuesFrom :Cl_Address
] ;
owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :buyerAddressAssignment_hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ rdf:type owl:Restriction ; owl:onProperty :buyerAddressAssignment_hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_InvoiceItem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_ItemInformationDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :aboutItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasDisplayAttribute ; owl:someValuesFrom :Cl_DisplayAttribute ]
    )
] .

:Cl_ItemName owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_DisplayAttribute
        [ a owl:Restriction ; owl:onProperty :itemNameValue ; owl:allValuesFrom xsd:string ]
    )
] .

:Cl_ItemPrice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_DisplayAttribute
        [ a owl:Restriction ; owl:onProperty :itemPriceValue ; owl:allValuesFrom xsd:decimal ]
    )
] .

:Cl_ItemDescription owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_DisplayAttribute
        [ a owl:Restriction ; owl:onProperty :itemDescriptionValue ; owl:allValuesFrom xsd:string ]
    )
] .

:Cl_ItemCategory owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_DisplayAttribute
        [ a owl:Restriction ; owl:onProperty :itemCategoryValue ; owl:allValuesFrom xsd:string ]
    )
] .

:Cl_ItemImage owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_DisplayAttribute
        [ a owl:Restriction ; owl:onProperty :itemImageURL ; owl:allValuesFrom xsd:anyURI ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_Amount owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasCurrency ;
    owl:someValuesFrom :Cl_Currency
] .

:Cl_InvoiceDetails owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Document
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasCustomer ; owl:someValuesFrom :Cl_Customer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceDate ; owl:someValuesFrom xsd:date ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasDueDate ; owl:someValuesFrom xsd:date ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasTotalAmount ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasCurrency ; owl:someValuesFrom :Cl_Currency ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasPaymentTerms ; owl:someValuesFrom :Cl_PaymentTerms ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasBillingAddress ; owl:someValuesFrom :Cl_Address ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasShippingAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_InvoiceAmount owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceAmountValue ;
    owl:someValuesFrom xsd:decimal
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceAmount ;
    owl:someValuesFrom :Cl_InvoiceAmount
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasIdentifier ;
    owl:allValuesFrom :Cl_InvoiceNumberReification
] .

:Cl_InvoiceNumberReification owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceNumberEntity ;
    owl:allValuesFrom :Cl_Identifier
] ;
    owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :identifiesInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_FileFormat rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasRequirement ;
    owl:someValuesFrom :Cl_InformationRequirement
] .

:Cl_InformationRequirement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :appliesToField ;
    owl:someValuesFrom :Cl_Field
] .

:Cl_Field rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasFieldType ;
    owl:someValuesFrom :Cl_FieldType
] .

:Cl_RequiredField rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :specifiesRequiredField ;
    owl:someValuesFrom :Cl_Field
] .

:Cl_FieldValueSpecification rdfs:subClassOf [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ; owl:onProperty :hasValueTypeConstraint ; owl:someValuesFrom :Cl_ValueTypeConstraint ]
        [ a owl:Restriction ; owl:onProperty :hasAllowedFormatPattern ; owl:someValuesFrom :Cl_AllowedFormatPattern ]
    )
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :assignedToBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_OrganizationInfoDisplay owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :displaysInfoAbout ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedContactInfo ; owl:someValuesFrom :Cl_ContactInfo ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedAddress ; owl:someValuesFrom :Cl_Address ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedIdentifier ; owl:someValuesFrom :Cl_Identifier ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedLogo ; owl:someValuesFrom :Cl_Logo ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedDescription ; owl:someValuesFrom :Cl_Description ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedWebsite ; owl:someValuesFrom :Cl_Website ]
    )
] .

#################################################################
# Disjointness
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_InvoiceListing owl:disjointWith :Cl_EDIFACTMessage , :Cl_Invoice .
:Cl_Organization owl:disjointWith :Cl_Invoice , :Cl_ContactInfo, :Cl_Logo, :Cl_Description, :Cl_Website .
:Cl_InvoiceOrganizationInvolvement owl:disjointWith :Cl_Organization, :Cl_Invoice .
:Cl_Invoice owl:disjointWith :Cl_Organization, :Cl_InvoiceRole, :Cl_BusinessProcess, :Cl_InvoiceAmount, :Cl_Identifier, :Cl_InvoiceAssignment .
:Cl_InvoiceRole owl:disjointWith :Cl_Organization .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_InvoiceItem owl:disjointWith :Cl_Invoice, :Cl_Item .
:Cl_Item owl:disjointWith :Cl_Invoice .
:Cl_Customer owl:disjointWith :Cl_Seller, :Cl_InvoiceLine, :Cl_Product, :Cl_Address, :Cl_Organization .
:Cl_InvoiceLine owl:disjointWith :Cl_Invoice, :Cl_Customer, :Cl_Product, :Cl_Address, :Cl_Organization .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Amount owl:disjointWith :Cl_InvoiceLineItemRelation .
:Cl_InvoiceAmount owl:disjointWith :Cl_Invoice, :Cl_Document .
:Cl_InvoiceNumberReification owl:disjointWith :Cl_Invoice, :Cl_Identifier .
:Cl_InvoiceAssignment owl:disjointWith :Cl_Invoice, :Cl_BusinessProcess .
:Cl_Field owl:disjointWith :Cl_FileFormat, :Cl_InformationRequirement, :Cl_FieldType .
:Cl_ValidationRule owl:disjointWith :Cl_FieldConstraint .
:Cl_AllowedValue owl:disjointWith :Cl_FieldType .
:Cl_FieldPresence owl:disjointWith :Cl_FieldValueSpecification .
:Cl_RequiredField owl:disjointWith :Cl_FieldValueSpecification .
:Cl_ValueTypeConstraint owl:disjointWith :Cl_AllowedFormatPattern .

#################################################################
# Equivalent Classes
#################################################################

:Cl_BuyerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ;
          owl:onProperty :roleType ;
          owl:allValuesFrom :Cl_BuyerRole
        ]
    )
] .

:Cl_SellerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ;
          owl:onProperty :roleType ;
          owl:allValuesFrom :Cl_SellerRole
        ]
    )
] .

:Cl_RequiredField owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_FieldPresence
        [ a owl:Restriction ; owl:onProperty :specifiesRequiredField ; owl:someValuesFrom :Cl_Field ]
    )
] .
