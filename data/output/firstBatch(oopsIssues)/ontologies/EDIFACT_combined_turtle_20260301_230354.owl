:hasPaymentTerms a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_PaymentTerms ;
    rdfs:label "has payment terms" .

:isInvoiceOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceDetails ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice of" .

:hasInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmount .

:assignedToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice .

:assignedAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumberReification .

:identifiesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberReification ;
    rdfs:range :Cl_Invoice ;
