@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class .

:Cl_Document a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Document" .

:Cl_BusinessDocument a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Business Document" .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:subClassOf :Cl_BusinessDocument ;
    rdfs:label "EDIFACT Message" .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_BusinessDocument, :Cl_Document ;
    rdfs:label "Invoice" .

:Cl_InvoiceListing a owl:Class ;
    rdfs:label "Invoice Listing" .

:Cl_InvoiceOrganizationInvolvement a owl:Class ;
    rdfs:label "Invoice Organization Involvement" .

:Cl_InvoiceRelatedEntity a owl:Class ;
    rdfs:label "Invoice Related Entity" .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Buyer Role" .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller Role" .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Reification class to capture the participation of an organization in an invoice with a specific role." .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRelatedEntity, :Cl_Entity ;
    rdfs:label "Organization" .

:Cl_OrganizationInfoDisplay a owl:Class .

:Cl_ContactInfo a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Address a owl:Class ;
    rdfs:subClassOf :Cl_ContactInfo, :Cl_Entity .

:Cl_Identifier a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Logo a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Description a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Website a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Person a owl:Class .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_BuyerAddressAssignment a owl:Class .

:Cl_Item a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Item" .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Product" .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Service" .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "InvoiceItem" ;
    rdfs:comment "A reification class representing the inclusion of an item in an invoice, possibly with quantity and price." .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization, :Cl_Entity ;
    rdfs:label "Customer" .

:Cl_Seller a owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Seller" .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" .

:Cl_ItemInformationDisplay a owl:Class ;
    rdfs:label "Item Information Display" .

:Cl_ItemName a owl:Class ;
    rdfs:subClassOf :Cl_ItemInformationDisplay, :Cl_DisplayAttribute ;
    rdfs:label "Item Name" .

:Cl_ItemPrice a owl:Class ;
    rdfs:subClassOf :Cl_ItemInformationDisplay, :Cl_DisplayAttribute ;
    rdfs:label "Item Price" .

:Cl_ItemDescription a owl:Class ;
    rdfs:subClassOf :Cl_ItemInformationDisplay, :Cl_DisplayAttribute ;
    rdfs:label "Item Description" .

:Cl_ItemCategory a owl:Class ;
    rdfs:subClassOf :Cl_ItemInformationDisplay, :Cl_DisplayAttribute ;
    rdfs:label "Item Category" .

:Cl_ItemImage a owl:Class ;
    rdfs:subClassOf :Cl_ItemInformationDisplay, :Cl_DisplayAttribute ;
    rdfs:label "Item Image" .

:Cl_DisplayAttribute a owl:Class ;
    rdfs:label "Display Attribute" .

:Cl_InvoiceLine a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceLineItemRelation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Amount a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Currency a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_NetPriceCalculation a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceDetails a owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_PaymentTerms a owl:Class .

:Cl_Date a owl:Class .

:Cl_InvoiceAmount a owl:Class .

:Cl_InvoiceAmountAssignment a owl:Class .

:Cl_InvoiceNumberReification a owl:Class .

:Cl_FileFormat a owl:Class .

:Cl_InformationRequirement a owl:Class .

:Cl_Field a owl:Class .

:Cl_FieldConstraint a owl:Class .

:Cl_ValidationRule a owl:Class .

:Cl_FieldType a owl:Class .

:Cl_AllowedValue a owl:Class .

:Cl_RequirementSpecification a owl:Class .

:Cl_RequiredField a owl:Class .

:Cl_FieldPresence a owl:Class .

:Cl_FieldValueSpecification a owl:Class .

:Cl_ValueTypeConstraint a owl:Class .

:Cl_AllowedFormatPattern a owl:Class .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:label "Invoice Assignment" .

#################################################################
# Class Hierarchies
#################################################################

:Cl_RequirementSpecification rdfs:subClassOf :Cl_InformationRequirement .
:Cl_FieldPresence rdfs:subClassOf :Cl_RequirementSpecification .
:Cl_FieldValueSpecification rdfs:subClassOf :Cl_RequirementSpecification .
:Cl_FieldConstraint rdfs:subClassOf :Cl_RequirementSpecification .
:Cl_ValueTypeConstraint rdfs:subClassOf :Cl_FieldConstraint .
:Cl_AllowedFormatPattern rdfs:subClassOf :Cl_FieldConstraint .
:Cl_RequiredField rdfs:subClassOf :Cl_FieldPresence .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing" .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" .

:isListedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceListing ;
    owl:inverseOf :listsInvoice ;
    rdfs:label "is listed in" .

:belongsToMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    owl:inverseOf :hasInvoiceListing ;
    rdfs:label "belongs to message" .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "involves invoice" .

:hasInvolvedOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has involved organization" ;
    owl:inverseOf :isInvolvedInInvoice .

:isInvolvedInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is involved in invoice" .

:hasInvoiceOrganizationInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "has invoice organization involvement" .

:hasOrganizationInvoiceInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "has organization invoice involvement" .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Organization .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole .

:roleType a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRole .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "has invoice item" .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Item ;
    rdfs:label "refers to item" .

:isInvoiceItemOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceItem ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice item of" .

:isItemOfInvoiceItem a owl:ObjectProperty ;
    owl:inverseOf :refersToItem ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "is item of invoice item" .

:issuedTo a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer ;
    rdfs:label "issued to" .

:issuedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Seller ;
    rdfs:label "issued by" .

:itemSold a owl:ObjectProperty ;
    rdfs:domain :Cl_Sale ;
    rdfs:range :Cl_Item ;
    rdfs:label "item sold" .

:displayedInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Sale ;
    rdfs:range :Cl_ItemInformationDisplay ;
    rdfs:label "displayed information" .

:aboutItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformationDisplay ;
    rdfs:range :Cl_Item ;
    rdfs:label "about item" .

:hasDisplayAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformationDisplay ;
    rdfs:range :Cl_DisplayAttribute ;
    rdfs:label "has display attribute" .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range :Cl_Currency .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Currency .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLineItemRelation ;
    rdfs:range :Cl_Amount .

:hasInvoiceLineItemRelation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLineItemRelation .

:relatesToInvoiceLine a owl:ObjectProperty ;
