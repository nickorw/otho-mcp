:hasNetTotalAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_Amount .

:hasInvoiceDetails a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetails ;
    rdfs:label "has invoice details" .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product ;
    rdfs:label "has product" .

:hasCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Customer ;
