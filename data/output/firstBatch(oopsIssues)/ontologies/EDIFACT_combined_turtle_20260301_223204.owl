@prefix : <http://example.org/FestS#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/FestS> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A general class for documents." .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued to a buyer indicating quantities, prices, and amount due for products or services provided." .

:Cl_EDIFACTEntity a owl:Class ;
    rdfs:label "EDIFACT Entity" .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:subClassOf :Cl_EDIFACTEntity ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message conforming to the EDIFACT standard." .

:Cl_InvoiceListing a owl:Class ;
    rdfs:subClassOf :Cl_EDIFACTEntity ;
    rdfs:label "Invoice Listing" ;
    rdfs:comment "A reification class representing the occurrence of an Invoice being listed in a specific EDIFACT message." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A group or institution involved in an event or process." .

:Cl_InvolvedOrganization a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Involved Organization" ;
    rdfs:comment "An organization that is involved in a specific context or event." .

:Cl_OrganizationInformationDisplay a owl:Class ;
    rdfs:label "Organization Information Display" ;
    rdfs:comment "A reification class representing the display of information about an involved organization." .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:comment "The type/category of an organization." .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "The role the organization plays in the context." .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact details for the organization." .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "A unique identifier for the organization." .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "The location of the organization." .

:Cl_OrganizationGeneralInfo a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationInformationDisplay ;
    rdfs:label "Organization General Info" .

:Cl_OrganizationContactInfo a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationInformationDisplay ;
    rdfs:label "Organization Contact Info" .

:Cl_OrganizationRoleDisplay a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationInformationDisplay ;
    rdfs:label "Organization Role Display" .

:Cl_Entity a owl:Class .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_Address a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BuyerAddressAssignment a owl:Class .

:Cl_InvoiceParticipation a owl:Class .

:Cl_InvoiceRole a owl:Class .

:Cl_InvoiceParticipant a owl:Class .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Supplier a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_RoleType a owl:Class .

:Cl_Seller a owl:Class ;
    rdfs:subClassOf :Cl_RoleType .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_RoleType, :Cl_PartyRole .

:Cl_Recipient a owl:Class ;
    rdfs:subClassOf :Cl_RoleType .

:Cl_Payer a owl:Class ;
    rdfs:subClassOf :Cl_RoleType .

:Cl_InvoicePartyRole a owl:Class .

:Cl_PartyRole a owl:Class .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_PartyRole .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Represents an item sold." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_InvoiceLine a owl:Class .

:Cl_DisplayInformation a owl:Class ;
    rdfs:label "Display Information" ;
    rdfs:comment "Information displayed about an item sold." .

:Cl_ItemDisplay a owl:Class ;
    rdfs:label "Item Display" ;
    rdfs:comment "Reification class connecting Item and its Display Information." .

:Cl_DescriptiveAttribute a owl:Class ;
    rdfs:label "Descriptive Attribute" ;
    rdfs:comment "Superclass for all attributes describing an item." .

:Cl_ItemName a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item Name" ;
    rdfs:comment "The name of the item." .

:Cl_ItemPrice a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item Price" ;
    rdfs:comment "The price of the item." .

:Cl_ItemDescription a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item Description" ;
    rdfs:comment "The description of the item." .

:Cl_ItemImage a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item Image" ;
    rdfs:comment "The image of the item." .

:Cl_ItemCategory a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item Category" ;
    rdfs:comment "The category of the item." .

:Cl_ItemStock a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item Stock" ;
    rdfs:comment "The stock quantity of the item." .

:Cl_ItemSKU a owl:Class ;
    rdfs:subClassOf :Cl_DescriptiveAttribute ;
    rdfs:label "Item SKU" ;
    rdfs:comment "The SKU (stock keeping unit) of the item." .

:Cl_MonetaryAmount a owl:Class .

:Cl_NetPrice a owl:Class ;
    rdfs:subClassOf :Cl_MonetaryAmount .

:Cl_Quantity a owl:Class .

:Cl_UnitPrice a owl:Class ;
    rdfs:subClassOf :Cl_MonetaryAmount .

:Cl_Currency a owl:Class .

:Cl_InvoiceDetail a owl:Class .

:Cl_InvoiceDetailReification a owl:Class .

:Cl_Amount a owl:Class .

:Cl_InvoiceItem a owl:Class .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "A monetary value representing the total amount of the invoice." .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:label "Invoice Amount Assignment" ;
    rdfs:comment "A reification class that associates an invoice with its invoice amount." .

:Cl_Identifier a owl:Class .

:Cl_InvoiceNumber a owl:Class ;
    rdfs:subClassOf :Cl_Identifier .

:Cl_InvoiceIdentification a owl:Class ;
    rdfs:comment "Pivot class to associate Invoice with its Invoice Number." .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" .

:Cl_FileFormatSpecification a owl:Class ;
    rdfs:label "File Format Specification" ;
    rdfs:subClassOf :Cl_FileFormat .

:Cl_RequiredInformation a owl:Class ;
    rdfs:label "Required Information" .

:Cl_ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" .

:Cl_InformationType a owl:Class ;
    rdfs:label "Information Type" .

:Cl_ValidityCriterion a owl:Class ;
    rdfs:label "Validity Criterion" .

:Cl_FileFormatValidityRequirement a owl:Class ;
    rdfs:label "File Format Validity Requirement" .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process"@en .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment (pivot class for assigning document to business process)"@en .

#################################################################
# Disjointness and Disjoint Unions
#################################################################

:Cl_Invoice owl:disjointWith :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_Product, :Cl_Customer, :Cl_InvoiceDetail, :Cl_InvoiceItem, :Cl_BusinessProcess, :Cl_InvoiceNumber, :Cl_Organization, :Cl_Item, :Cl_InvoiceLine, :Cl_EDIFACTMessage, :Cl_InvoiceListing .

:Cl_InvoiceAmountAssignment owl:disjointWith :Cl_Invoice, :Cl_InvoiceAmount .

:Cl_InvoiceAmount owl:disjointWith :Cl_Invoice .

:Cl_InvoiceLine owl:disjointWith :Cl_Invoice, :Cl_Item .

:Cl_Item owl:disjointWith :Cl_Invoice, :Cl_DescriptiveAttribute, :Cl_DisplayInformation, :Cl_ItemDisplay .

:Cl_DescriptiveAttribute owl:disjointUnionOf (
    :Cl_ItemName
    :Cl_ItemPrice
    :Cl_ItemDescription
    :Cl_ItemImage
    :Cl_ItemCategory
    :Cl_ItemStock
    :Cl_ItemSKU
) .

:Cl_Item owl:disjointUnionOf ( :Cl_Product :Cl_Service ) .

:Cl_RequiredInformation owl:disjointWith :Cl_ValidationRule, :Cl_ValidityCriterion .
:Cl_FileFormat owl:disjointWith :Cl_RequiredInformation, :Cl_ValidationRule .
:Cl_ValidationRule owl:disjointWith :Cl_InformationType .
:Cl_InformationType owl:disjointUnionOf ( :Cl_RequiredInformation :Cl_ValidationRule ) .

:Cl_OrganizationType owl:disjointWith :Cl_OrganizationRole, :Cl_ContactInformation, :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_OrganizationRole owl:disjointWith :Cl_ContactInformation, :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_ContactInformation owl:disjointWith :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_OrganizationLocation owl:disjointWith :Cl_OrganizationIdentifier .

:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Company owl:disjointWith :Cl_Supplier, :Cl_Customer .

:Cl_Organization owl:disjointWith :Cl_Invoice .
:Cl_InvoiceRole owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_RoleType .

:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .

:Cl_Address owl:disjointWith :Cl_Person .

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_InvoiceListing .
:Cl_Invoice owl:disjointWith :Cl_InvoiceListing .

:Cl_Document owl:disjointWith :Cl_BusinessProcess .

#################################################################
# Class Hierarchies
#################################################################

:Cl_RequiredInformation rdfs:subClassOf :Cl_InformationType .
:Cl_ValidationRule rdfs:subClassOf :Cl_ValidityCriterion .
:Cl_Invoice rdfs:subClassOf :Cl_Document .
:Cl_InvoiceDetail rdfs:subClassOf :Cl_InvoiceItem .
:Cl_InvoiceDetailReification rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_Amount rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_InvoiceNumber rdfs:subClassOf :Cl_Identifier .
:Cl_InvoiceParticipation rdfs:subClassOf :Cl_InvoiceParticipant .
:Cl_OrganizationGeneralInfo rdfs:subClassOf :Cl_OrganizationInformationDisplay .
:Cl_OrganizationContactInfo rdfs:subClassOf :Cl_OrganizationInformationDisplay .
:Cl_OrganizationRoleDisplay rdfs:subClassOf :Cl_OrganizationInformationDisplay .
:Cl_Seller rdfs:subClassOf :Cl_RoleType .
:Cl_BuyerRole rdfs:subClassOf :Cl_RoleType, :Cl_PartyRole .
:Cl_Recipient rdfs:subClassOf :Cl_RoleType .
:Cl_Payer rdfs:subClassOf :Cl_RoleType .
:Cl_BuyerRole rdfs:subClassOf :Cl_PartyRole .
:Cl_SellerRole rdfs:subClassOf :Cl_PartyRole .
:Cl_Product rdfs:subClassOf :Cl_Item .
:Cl_Service rdfs:subClassOf :Cl_Item .
:Cl_UnitPrice rdfs:subClassOf :Cl_MonetaryAmount .
:Cl_NetPrice rdfs:subClassOf :Cl_MonetaryAmount .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Connects an EDIFACT message to an InvoiceListing instance." .

:listedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "listed invoice" ;
    rdfs:comment "The invoice that is listed in an EDIFACT message, via InvoiceListing." .

:inEDIFACTMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "in EDIFACT message" ;
    rdfs:comment "The EDIFACT message in which the invoice is listed." ;
    owl:inverseOf :hasInvoiceListing .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

:participationOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole .

:hasInvoiceRoleParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization .

:hasRoleType a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_RoleType .

:hasInvoicePartyRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoicePartyRole .

:involvesOrganizationPartyRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyRole ;
    rdfs:range :Cl_Organization .

:hasPartyRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyRole ;
    rdfs:range :Cl_PartyRole .

:isInvoiceOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoicePartyRole ;
    rdfs:domain :Cl_InvoicePartyRole ;
    rdfs:range :Cl_Invoice .

:isOrganizationInvolved a owl:ObjectProperty ;
    owl:inverseOf :involvesOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoicePartyRole .

:isRoleOf a owl:ObjectProperty ;
    owl:inverseOf :hasPartyRole ;
    rdfs:domain :Cl_PartyRole ;
    rdfs:range :Cl_InvoicePartyRole .

:hasBuyer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address .

:isBuyerOf a owl:ObjectProperty ;
    owl:inverseOf :hasBuyer ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:isAddressOf a owl:ObjectProperty ;
    owl:inverseOf :hasAddress ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:isLineOfInvoice a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceLine ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice .

:isItemOfLine a owl:ObjectProperty ;
    owl:inverseOf :refersToItem ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine .

:hasDisplay a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemDisplay ;
    rdfs:label "has display" ;
    rdfs:comment "Links an Item to its ItemDisplay reification node." .

:representsItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplay ;
    rdfs:range :Cl_Item ;
    rdfs:label "represents item" ;
    rdfs:comment "Links ItemDisplay to the Item it displays." .

:hasDisplayInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplay ;
    rdfs:range :Cl_DisplayInformation ;
    rdfs:label "has display information" ;
    rdfs:comment "Links ItemDisplay to the Display Information." .

:hasDescriptiveAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range :Cl_DescriptiveAttribute ;
    rdfs:label "has descriptive attribute" ;
    rdfs:comment "Links Display Information to its Descriptive Attributes." .

:hasUnitPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_UnitPrice .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Quantity .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range :Cl_Currency .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetailReification .

:relatesToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range :Cl_Invoice .

:relatesToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range :Cl_Product .

:relatesToCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range :Cl_Amount .

:isDetailOfInvoice a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceDetail ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range :Cl_Invoice .

:hasInvoiceAmountAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountAssignment ;
    rdfs:label "has invoice amount assignment" ;
    rdfs:comment "Relates an invoice to its invoice amount assignment." .

:invoiceAmountOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice amount of" ;
    rdfs:comment "Relates an invoice amount assignment to the invoice." ;
    owl:inverseOf :hasInvoiceAmountAssignment .

:hasInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "Relates an invoice amount assignment to the invoice amount." .

:hasInvoiceIdentification a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentification ;
    rdfs:comment "Links an Invoice to its identification (pivot for reification)." .

:identifiesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceIdentification ;
    rdfs:comment "Inverse property: links InvoiceIdentification to Invoice." .

:hasInvoiceNumber a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range :Cl_InvoiceNumber ;
    rdfs:comment "Associates an InvoiceIdentification with an InvoiceNumber." .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplay ;
    rdfs:range :Cl_InvolvedOrganization ;
    rdfs:label "has organization" .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range :Cl_OrganizationType ;
    rdfs:label "has organization type" .

:hasOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range :Cl_OrganizationRole ;
    rdfs:label "has organization role" .

:hasContactInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range :Cl_ContactInformation ;
    rdfs:label "has contact information" .

:hasOrganizationIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range :Cl_OrganizationIdentifier ;
    rdfs:label "has organization identifier" .

:hasOrganizationLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range :Cl_OrganizationLocation ;
    rdfs:label "has organization location" .

:hasSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatSpecification ;
    rdfs:label "has specification" .

:requiresInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_RequiredInformation ;
    rdfs:label "requires information" .

:requiresValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_ValidationRule ;
    rdfs:label "requires validation rule" .

:hasValidityRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatValidityRequirement ;
    rdfs:label "has validity requirement" .

:validityRequirementInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_RequiredInformation ;
    rdfs:label "validity requirement information" .

:validityRequirementCriterion a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_ValidityCriterion ;
    rdfs:label "validity requirement criterion" .

:informationTypeOf a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_InformationType ;
    rdfs:label "information type of" .

:hasDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_Document ;
    rdfs:label "has document"@en .

:hasBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "has business process"@en .

:hasAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_Assignment ;
    rdfs:label "has assignment"@en .

:isAssignedTo a owl:ObjectProperty ;
    owl:inverseOf :hasAssignedDocument ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "is assigned to business process"@en .

:hasAssignedDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Document ;
    rdfs:label "has assigned document"@en .

#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number"@en .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:roleLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization, :Cl_InvolvedOrganization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" .

:organizationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range xsd:string ;
    rdfs:label "organization description" .

:organizationTypeLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string ;
    rdfs:label "organization type label" .

:organizationRoleLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string ;
    rdfs:label "organization role label" .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact email" .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact phone" .

:contactAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact address" .

:organizationIdentifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "organization identifier value" .

:organizationLocationLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "organization location label" .

:street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine, :Cl_InvoiceDetailReification ;
    rdfs:range xsd:decimal .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine, :Cl_InvoiceDetailReification ;
    rdfs:range xsd:decimal .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:decimal .

:unitPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_UnitPrice ;
    rdfs:range xsd:decimal .

:netPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:productCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:totalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal ;
    rdfs:label "amount value" ;
    rdfs:comment "The numeric value of the invoice amount." .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string ;
    rdfs:label "amount currency" ;
    rdfs:comment "The currency in which the invoice amount is expressed." .

:invoiceNumberValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range xsd:string ;
    rdfs:comment "The string value of the invoice number." .

:itemNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemName ;
    rdfs:range xsd:string ;
    rdfs:label "item name value" .

:itemPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price value" .

:itemDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemDescription ;
    rdfs:range xsd:string ;
    rdfs:label "item description value" .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:anyURI ;
    rdfs:label "item image URL" .

:itemCategoryValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemCategory ;
    rdfs:range xsd:string ;
    rdfs:label "item category value" .

:itemStockValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemStock ;
    rdfs:range xsd:integer ;
    rdfs:label "item stock value" .

:itemSKUValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemSKU ;
    rdfs:range xsd:string ;
    rdfs:label "item SKU value" .

:informationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string ;
    rdfs:label "information name" .

:informationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string ;
    rdfs:label "information description" .

:validationRuleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range xsd:string ;
    rdfs:label "validation rule description" .

:criterionDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidityCriterion ;
    rdfs:range xsd:string ;
    rdfs:label "criterion description" .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:date ;
    rdfs:label "assignment date"@en .

:listingDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range xsd:dateTime ;
    rdfs:label "listing date" ;
    rdfs:comment "The date and time when the invoice was listed in the message." .

:messageID a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "message ID" ;
    rdfs:comment "The unique identifier for the EDIFACT message." .

#################################################################
# Restrictions and Equivalent Classes
#################################################################

:Cl_InvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :listedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :inEDIFACTMessage ;
          owl:someValuesFrom :Cl_EDIFACTMessage ]
    )
] .

:Cl_EDIFACTMessage owl:equivalentClass [
    rdf:type owl:Class ;
    owl:onProperty :hasInvoiceListing ;
    owl:allValuesFrom :Cl_InvoiceListing
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :participationOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceRoleParticipation ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_InvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRoleType ; owl:someValuesFrom :Cl_RoleType ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRoleType ; owl:allValuesFrom :Cl_RoleType ]
    )
] .

:Cl_InvoicePartyRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasPartyRole ; owl:allValuesFrom :Cl_PartyRole ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganizationPartyRole ; owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasPartyRole ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganizationPartyRole ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_BuyerAddressAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasBuyer ;
    owl:allValuesFrom :Cl_Buyer
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasAddress ;
        owl:allValuesFrom :Cl_Address
    ] .

:Cl_Buyer owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ;
          owl:onProperty :isBuyerOf ;
          owl:allValuesFrom :Cl_BuyerAddressAssignment
        ]
    )
] .

:Cl_Address owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ;
          owl:onProperty :isAddressOf ;
          owl:allValuesFrom :Cl_BuyerAddressAssignment
        ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
    )
] ,
[
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasUnitPrice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:onProperty :hasInvoiceLine ;
    owl:allValuesFrom :Cl_InvoiceLine
] ,
[
    rdf:type owl:Class ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

:Cl_InvoiceDetailReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :relatesToInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :relatesToProduct ;
          owl:someValuesFrom :Cl_Product ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :quantity ;
          owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :unitPrice ;
          owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasAmount ;
          owl:someValuesFrom :Cl_Amount ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :invoiceAmountOf ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceAmount ;
          owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceIdentification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :identifiesInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom :Cl_InvoiceNumber ]
    )
] .

:Cl_ItemDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :representsItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasDisplayInformation ; owl:someValuesFrom :Cl_DisplayInformation ]
    )
] .

:Cl_FileFormatValidityRequirement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :validityRequirementInformation ;
          owl:someValuesFrom :Cl_RequiredInformation
        ]
        [ a owl:Restriction ;
          owl:onProperty :validityRequirementCriterion ;
          owl:someValuesFrom :Cl_ValidityCriterion
        ]
    )
] .

:Cl_FileFormat owl:equivalentClass [
    a owl:Class ;
    owl:onProperty :hasValidityRequirement ;
    owl:someValuesFrom :Cl_FileFormatValidityRequirement
] .

:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasDocument ;
          owl:someValuesFrom :Cl_Document ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_OrganizationInformationDisplay owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasOrganization ;
          owl:someValuesFrom :Cl_InvolvedOrganization
        ]
    )
] .
