@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_BusinessProcess a owl:Class ; rdfs:label "Business Process" .
:Cl_Document a owl:Class ; rdfs:label "Document" .
:Cl_FinancialDocument a owl:Class ; rdfs:subClassOf :Cl_Document ; rdfs:label "Financial Document" .
:Cl_Invoice a owl:Class ; rdfs:subClassOf :Cl_FinancialDocument, :Cl_EDIFACTDocument ; rdfs:label "Invoice" ; rdfs:comment "A document issued to indicate a transaction between a buyer and a seller." .
:Cl_EDIFACTDocument a owl:Class ; rdfs:label "EDIFACT Document" ; rdfs:comment "A superclass for all document types in EDIFACT." .
:Cl_EDIFACTMessage a owl:Class ; rdfs:subClassOf :Cl_EDIFACTDocument ; rdfs:label "EDIFACT Message" ; rdfs:comment "A message formatted according to the EDIFACT standard." .
:Cl_EDIFACTInvoiceListing a owl:Class ; rdfs:label "EDIFACT Invoice Listing" ; rdfs:comment "A reification class representing the inclusion of an Invoice in an EDIFACT Message." .
:Cl_DocumentAssignment a owl:Class ; rdfs:label "Document Assignment" .
:Cl_InvoiceAssignment a owl:Class ; rdfs:subClassOf :Cl_DocumentAssignment ; rdfs:label "Invoice Assignment" .
:Cl_Organization a owl:Class ; rdfs:label "Organization" ; rdfs:comment "An entity such as a company, institution, or group involved in the context." .
:Cl_OrganizationType a owl:Class ; rdfs:label "Organization Type" ; rdfs:comment "The type or classification of an organization (e.g., company, NGO, government agency)." .
:Cl_OrganizationContactInfo a owl:Class ; rdfs:label "Organization Contact Info" ; rdfs:comment "Contact information for an organization." .
:Cl_OrganizationRole a owl:Class ; rdfs:label "Organization Role" ; rdfs:comment "A role that an organization plays in an event or context." .
:Cl_OrganizationParticipation a owl:Class ; rdfs:label "Organization Participation" ; rdfs:comment "A reification class representing an organization's involvement in an event or context, capturing its role and related information." .
:Cl_Event a owl:Class ; rdfs:label "Event" ; rdfs:comment "An event or situation in which organizations are involved." .
:Cl_OrganizationName a owl:Class ; rdfs:label "Organization Name" ; rdfs:comment "The name of the organization." .
:Cl_OrganizationIdentifier a owl:Class ; rdfs:label "Organization Identifier" ; rdfs:comment "An identifier for the organization (e.g., registration number, tax ID)." .
:Cl_OrganizationDescription a owl:Class ; rdfs:label "Organization Description" ; rdfs:comment "A textual description or summary of the organization." .
:Cl_Person a owl:Class .
:Cl_Buyer a owl:Class ; rdfs:subClassOf :Cl_Person .
:Cl_Address a owl:Class .
:Cl_BuyerAddressAssignment a owl:Class .
:Cl_InvoiceLine a owl:Class .
:Cl_Item a owl:Class ; rdfs:label "Item" .
:Cl_Product a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_Service a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_SoldItem a owl:Class ; rdfs:subClassOf :Cl_Item ; rdfs:label "Sold Item" .
:Cl_ItemDisplayInfo a owl:Class ; rdfs:subClassOf :Cl_ItemAttribute ; rdfs:label "Item Display Information" .
:Cl_ItemAttribute a owl:Class ; rdfs:label "Item Attribute" .
:Cl_AttributeValue a owl:Class ; rdfs:label "Attribute Value" .
:Cl_MonetaryAmount a owl:Class .
:Cl_NetPriceCalculation a owl:Class .
:Cl_InvoiceDetail a owl:Class .
:Cl_InvoiceItem a owl:Class .
:Cl_Customer a owl:Class .
:Cl_Payment a owl:Class .
:Cl_Amount a owl:Class .
:Cl_Date a owl:Class .
:Cl_InvoiceParty a owl:Class .
:Cl_InvoiceAmount a owl:Class .
:Cl_InvoiceAmountAssignment a owl:Class .
:Cl_InvoiceIdentifier a owl:Class .
:Cl_FileFormat a owl:Class .
:Cl_FormatSpecification a owl:Class .
:Cl_FileFormatComponent a owl:Class ; rdfs:subClassOf :Cl_FormatSpecification .
:Cl_Field a owl:Class .
:Cl_RequiredField a owl:Class ; rdfs:subClassOf :Cl_Field .
:Cl_OptionalField a owl:Class ; rdfs:subClassOf :Cl_Field .
:Cl_FieldType a owl:Class .
:Cl_FieldValue a owl:Class .
:Cl_FieldConstraint a owl:Class ; rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_ConstraintType a owl:Class .
:Cl_ValueRangeConstraint a owl:Class ; rdfs:subClassOf :Cl_ConstraintType .
:Cl_RegexConstraint a owl:Class ; rdfs:subClassOf :Cl_ConstraintType .
:Cl_EnumerationConstraint a owl:Class ; rdfs:subClassOf :Cl_ConstraintType .
:Cl_ValidationRequirement a owl:Class .
:Cl_ValidationRule a owl:Class ; rdfs:subClassOf :Cl_ValidationRequirement .
:Cl_FieldFormatReification a owl:Class .

:Cl_InvoiceRoleAssignment a owl:Class ; rdfs:label "Invoice Role Assignment" ; rdfs:comment "A reification class to capture the role an organization plays in an invoice." .
:Cl_InvoiceRole a owl:Class ; rdfs:label "Invoice Role" ; rdfs:comment "A class for types of roles organizations can play in invoices (e.g., seller, buyer, issuer, recipient)." .
:Cl_InvoiceRoleBuyer a owl:Class ; rdfs:subClassOf :Cl_InvoiceRole ; rdfs:label "Invoice Role Buyer" ; rdfs:comment "A specialization of InvoiceRole where the role type is buyer." .

:Cl_Party a owl:Class .

:Cl_InvoiceParticipation a owl:Class .

:Cl_Supplier a owl:Class .

#################################################################
# Individuals for InvoiceRole
#################################################################

:Seller a :Cl_InvoiceRole ; rdfs:label "Seller" .
:Buyer a :Cl_InvoiceRole ; rdfs:label "Buyer" .
:Issuer a :Cl_InvoiceRole ; rdfs:label "Issuer" .
:Recipient a :Cl_InvoiceRole ; rdfs:label "Recipient" .

#################################################################
# Hierarchies and Equivalence
#################################################################

:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceIdentifier ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:someValuesFrom :Cl_InvoiceDetail
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPriceCalculation ;
    owl:allValuesFrom :Cl_NetPriceCalculation
] .

:Cl_InvoiceIdentifier owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :invoiceAmountAssignment_invoice ;
          owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :invoiceAmountAssignment_amount ;
          owl:allValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceLine_invoice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Invoice
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceLine_item ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Item
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceLine_item ;
    owl:allValuesFrom :Cl_Item
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceLine_invoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_Item owl:equivalentClass [
    owl:unionOf ( :Cl_Product :Cl_Service )
] .
:Cl_Product owl:disjointWith :Cl_Service .

:Cl_ItemDisplayInfo owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :displayInfoHasAttribute ;
    owl:allValuesFrom :Cl_ItemAttribute
] .

:Cl_ItemAttribute owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :attributeHasValue ;
    owl:allValuesFrom :Cl_AttributeValue
] .

:Cl_NetPriceCalculation owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMonetaryAmount ;
    owl:allValuesFrom :Cl_MonetaryAmount
] .

:Cl_Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasOrganizationType ;
    owl:someValuesFrom :Cl_OrganizationType
] .

:Cl_OrganizationParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :participatesInEvent ; owl:someValuesFrom :Cl_Event ]
        [ a owl:Restriction ; owl:onProperty :hasOrganizationRole ; owl:someValuesFrom :Cl_OrganizationRole ]
    )
] .

:Cl_InvoiceParticipation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :participatesInInvoice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Invoice
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :participatingOrganization ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Organization
] .

:Cl_InvoiceRoleAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceRole ;
          owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_InvoiceRole rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :roleOrganization ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Organization
] ,
[
    a owl:Restriction ;
    owl:onProperty :roleType ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Invoice owl:disjointWith :Cl_InvoiceAmount , :Cl_InvoiceAmountAssignment , :Cl_Item , :Cl_InvoiceLine , :Cl_MonetaryAmount , :Cl_NetPriceCalculation , :Cl_InvoiceRoleAssignment , :Cl_InvoiceRole .
:Cl_InvoiceAmount owl:disjointWith :Cl_InvoiceAmountAssignment , :Cl_InvoiceLine , :Cl_Item , :Cl_MonetaryAmount , :Cl_NetPriceCalculation .
:Cl_InvoiceAmountAssignment owl:disjointWith :Cl_InvoiceAmount , :Cl_Invoice .
:Cl_Item owl:disjointWith :Cl_InvoiceLine , :Cl_MonetaryAmount , :Cl_NetPriceCalculation , :Cl_ItemAttribute , :Cl_AttributeValue .
:Cl_InvoiceLine owl:disjointWith :Cl_MonetaryAmount , :Cl_NetPriceCalculation .
:Cl_MonetaryAmount owl:disjointWith :Cl_NetPriceCalculation .
:Cl_RequiredField owl:disjointWith :Cl_OptionalField .
:Cl_RegexConstraint owl:disjointWith :Cl_ValueRangeConstraint , :Cl_EnumerationConstraint .
:Cl_ValueRangeConstraint owl:disjointWith :Cl_EnumerationConstraint .
:Cl_Organization owl:disjointWith :Cl_Event , :Cl_InvoiceRoleAssignment , :Cl_InvoiceRole , :Cl_Invoice .
:Cl_OrganizationContactInfo owl:disjointWith :Cl_OrganizationRole , :Cl_OrganizationType .
:Cl_OrganizationRole owl:disjointWith :Cl_OrganizationType .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_Person owl:disjointWith :Cl_Address .
:Cl_BuyerAddressAssignment owl:disjointWith :Cl_Person , :Cl_Address .
:Cl_InvoiceItem owl:disjointWith :Cl_Payment , :Cl_InvoiceParty , :Cl_Amount , :Cl_Date .
:Cl_Payment owl:disjointWith :Cl_InvoiceParty , :Cl_Amount , :Cl_Date .
:Cl_InvoiceParty owl:disjointWith :Cl_Amount , :Cl_Date .
:Cl_Amount owl:disjointWith :Cl_Date .
:Cl_BusinessProcess owl:disjointWith :Cl_Document .
:Cl_DocumentAssignment owl:disjointWith :Cl_BusinessProcess , :Cl_Document .
:Cl_InvoiceAssignment owl:disjointWith :Cl_BusinessProcess , :Cl_Document .
:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_EDIFACTInvoiceListing owl:disjointWith :Cl_EDIFACTMessage , :Cl_Invoice .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTInvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Links an EDIFACT message to an EDIFACTInvoiceListing instance." .

:listedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTInvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "listed in message" ;
    rdfs:comment "Inverse of hasInvoiceListing, relates an invoice listing to the message." ;
    owl:inverseOf :hasInvoiceListing .

:includesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTInvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "includes invoice" ;
    rdfs:comment "Links the EDIFACTInvoiceListing to the Invoice it includes." .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :participatesInInvoice .

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:participatingOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:organizationHasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :participatingOrganization .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Party .

:hasInvoiceRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "has invoice role assignment" ;
    rdfs:comment "Connects an invoice to its role assignments (reification node for organization-role-invoice triple)." .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Connects an invoice role assignment to the organization involved." .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Specifies the role an organization plays in an invoice." .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "involves invoice" ;
    rdfs:comment "Connects an invoice role assignment to the invoice." .

:roleOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "role organization" ;
    rdfs:comment "The organization playing a specific role in the invoice." .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" ;
    rdfs:comment "Links a participation to the involved organization." .

:participatesInEvent a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationParticipation ;
    rdfs:range :Cl_Event ;
    rdfs:label "participates in event" ;
    rdfs:comment "Links an organization's participation to an event." .

:hasOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationParticipation ;
    rdfs:range :Cl_OrganizationRole ;
    rdfs:label "has organization role" ;
    rdfs:comment "Specifies the role the organization played in the event." .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationType ;
    rdfs:label "has organization type" ;
    rdfs:comment "Specifies the type of the organization." .

:hasContactInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationContactInfo ;
    rdfs:label "has contact info" ;
    rdfs:comment "Links an organization to its contact information." .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address .

:isAddressOfBuyerAssignment a owl:ObjectProperty ;
    owl:inverseOf :hasBuyer ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:isAddressAssignmentOfAddress a owl:ObjectProperty ;
    owl:inverseOf :hasAddress ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment .

:invoiceLine_invoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice .

:invoiceLine_item a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:invoice_hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine ;
    owl:inverseOf :invoiceLine_invoice .

:item_hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine ;
    owl:inverseOf :invoiceLine_item .

:itemHasDisplayInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_SoldItem ;
    rdfs:range :Cl_ItemDisplayInfo ;
    rdfs:label "item has display info" .

:displayInfoHasAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_ItemAttribute ;
    rdfs:label "display info has attribute" .

:attributeHasValue a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range :Cl_AttributeValue ;
    rdfs:label "attribute has value" .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasNetPriceCalculation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPriceCalculation .

:calculatesNetPriceFor a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_Invoice .

:hasMonetaryAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_MonetaryAmount .

:netPriceOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_MonetaryAmount ;
    owl:inverseOf :isNetPriceForInvoice .

:isNetPriceForInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range :Cl_Invoice .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_InvoiceItem .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product .

:hasCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParty ;
    rdfs:range :Cl_Customer .

:hasPayment a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Payment .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Amount .

:hasDate a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Date .

:hasParty a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_InvoiceParty .

:hasInvoiceIdentifier a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentifier ;
    rdfs:label "has invoice identifier" .

:hasDocumentAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_InvoiceAmount .

:hasInvoiceAmount a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasDocumentAmount ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmount .

:invoiceAmountAssignment_invoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice .

:invoiceAmountAssignment_amount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount .

:hasFormatSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FormatSpecification .

:hasComponent a owl:ObjectProperty ;
    rdfs:domain :Cl_FormatSpecification ;
    rdfs:range :Cl_FileFormatComponent .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponent ;
    rdfs:range :Cl_Field .

:hasFieldType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldType .

:hasFieldValue a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldValue .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldConstraint .

:constraintType a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range :Cl_ConstraintType .

:constraintRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range :Cl_ValidationRule .

:appliesToField a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldFormatReification ;
    rdfs:range :Cl_Field .

:requiresConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldFormatReification ;
    rdfs:range :Cl_FieldConstraint .

:requiresValue a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldFormatReification ;
    rdfs:range :Cl_FieldValue .

:partOfFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldFormatReification ;
    rdfs:range :Cl_FileFormat .

:assignedDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_DocumentAssignment ;
    rdfs:range :Cl_Document ;
    rdfs:label "assigned document" .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_DocumentAssignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "assigned business process" .

#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" .

:invoiceStatus a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:issueDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:dueDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:invoiceLine_quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:integer .

:invoiceLine_unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:invoiceLine_totalPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:item_name a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:productCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:integer .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:totalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal .

:paymentMethod a owl:DatatypeProperty ;
    rdfs:domain :Cl_Payment ;
    rdfs:range xsd:string .

:paymentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Payment ;
    rdfs:range xsd:date .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:customerID a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:hasQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:hasUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:hasLineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount , :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal .

:currency a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:string .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string .

:invoiceNumberValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value" .

:hasOrganizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "has organization name" .

:hasOrganizationIdentifier a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "has organization identifier" .

:hasOrganizationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "has organization description" .

:hasOrganizationAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "has organization address" .

:hasOrganizationEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "has organization email" .

:hasOrganizationPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "has organization phone" .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:attributeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "attribute name" .

:attributeValueString a owl:DatatypeProperty ;
    rdfs:domain :Cl_AttributeValue ;
    rdfs:range xsd:string ;
    rdfs:label "attribute value string" .

:attributeValueDecimal a owl:DatatypeProperty ;
    rdfs:domain :Cl_AttributeValue ;
    rdfs:range xsd:decimal ;
    rdfs:label "attribute value decimal" .

:attributeValueInteger a owl:DatatypeProperty ;
    rdfs:domain :Cl_AttributeValue ;
    rdfs:range xsd:integer ;
    rdfs:label "attribute value integer" .

:roleType a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role type" ;
    rdfs:comment "The type of role the organization plays in the invoice (e.g., 'buyer', 'seller')." .

:roleAssignmentNote a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range xsd:string ;
    rdfs:label "role assignment note" ;
    rdfs:comment "Optional note or description for the role assignment." .

:fieldTypeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldType ;
    rdfs:range xsd:string .

:fieldTypeDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldType ;
    rdfs:range xsd:string .

:fieldName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:string .

:isRequired a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:boolean .

:regexPattern a owl:DatatypeProperty ;
    rdfs:domain :Cl_RegexConstraint ;
    rdfs:range xsd:string .

:enumerationValues a owl:DatatypeProperty ;
    rdfs:domain :Cl_EnumerationConstraint ;
    rdfs:range xsd:string .

:minValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueRangeConstraint ;
    rdfs:range xsd:decimal .

:maxValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueRangeConstraint ;
    rdfs:range xsd:decimal .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range xsd:string .

:validationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRequirement ;
    rdfs:range xsd:string .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_DocumentAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" .

#################################################################
# Restrictions for Assignments
#################################################################

:Cl_DocumentAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :assignedDocument ;
    owl:someValuesFrom :Cl_Document
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :assignedBusinessProcess ;
    owl:someValuesFrom :Cl_BusinessProcess
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_DocumentAssignment
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedDocument ;
          owl:allValuesFrom :Cl_Invoice
        ]
    )
] .

:Cl_EDIFACTInvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :listedInMessage ;
          owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :includesInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_FieldFormatReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :appliesToField ;
          owl:someValuesFrom :Cl_Field ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :requiresConstraint ;
          owl:someValuesFrom :Cl_FieldConstraint ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :partOfFileFormat ;
          owl:someValuesFrom :Cl_FileFormat ]
    )
] .

#################################################################
# General Class Axioms (Soft Restrictions)
#################################################################

:Cl_Organization rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty :hasContactInfo ;
  owl:someValuesFrom :Cl_OrganizationContactInfo
] ,
[
  a owl:Restriction ;
  owl:onProperty :hasOrganizationName ;
  owl:someValuesFrom xsd:string
] .

:Cl_SoldItem rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty :itemHasDisplayInfo ;
  owl:someValuesFrom :Cl_ItemDisplayInfo
] .

#################################################################
# End of ontology FestS
#################################################################
