@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Invoice rdf:type owl:Class .
:Cl_Item rdf:type owl:Class .
:Cl_InvoiceLine rdf:type owl:Class .
:Cl_Price rdf:type owl:Class .
:Cl_Currency rdf:type owl:Class .
:Cl_Amount rdf:type owl:Class .
:Cl_NetPrice rdf:type owl:Class .
:Cl_Total rdf:type owl:Class .

# Hierarchy
:Cl_Price rdfs:subClassOf :Cl_Amount .
:Cl_NetPrice rdfs:subClassOf :Cl_Price .
:Cl_Total rdfs:subClassOf :Cl_Amount .

# Reification class for the sale of an item in an invoice (pivot class)
:Cl_InvoiceLine rdf:type owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in an invoice representing the sale of a specific item, its quantity, and net price." .

### Properties

# Object Properties

:hasInvoiceLine rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasNetPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice .

:hasCurrency rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range :Cl_Currency .

:hasTotalNetPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Total .

# Data Properties

:quantity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitNetPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal .

:totalNetPriceValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Total ;
    rdfs:range xsd:decimal .

:currencyCode rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

### Restrictions

# Each Cl_InvoiceLine must have exactly one Cl_Item
:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_InvoiceLine must have exactly one Cl_NetPrice
:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_NetPrice must have exactly one unitNetPrice
:Cl_NetPrice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :unitNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_Total must have exactly one totalNetPriceValue
:Cl_Total rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :totalNetPriceValue ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_Invoice can have multiple Cl_InvoiceLines
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Each Cl_Invoice must have exactly one Cl_Total as total net price
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTotalNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

### Disjointness

:Cl_Invoice owl:disjointWith :Cl_Item, :Cl_InvoiceLine, :Cl_Price, :Cl_Currency, :Cl_Total .

:Cl_Item owl:disjointWith :Cl_InvoiceLine, :Cl_Price, :Cl_Currency, :Cl_Total .

:Cl_InvoiceLine owl:disjointWith :Cl_Price, :Cl_Currency, :Cl_Total .

:Cl_Price owl:disjointWith :Cl_Currency, :Cl_Total .

:Cl_Currency owl:disjointWith :Cl_Total .

### Equivalent Class (General Class Axiom)

# The class Cl_Total is equivalent to the total net price of all items sold in the invoice.
:Cl_Total owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Amount
        [ rdf:type owl:Restriction ;
          owl:onProperty :totalNetPriceValue ;
          owl:someValuesFrom xsd:decimal
        ]
    )
] .

### Annotation for Competency Question

# The net price of the items sold in the invoice can be obtained by traversing:
# Cl_Invoice --hasInvoiceLine--> Cl_InvoiceLine --hasNetPrice--> Cl_NetPrice --unitNetPrice--> xsd:decimal
# and sum (unitNetPrice * quantity) for all Cl_InvoiceLine, or directly via:
# Cl_Invoice --hasTotalNetPrice--> Cl_Total --totalNetPriceValue--> xsd:decimal

# End of ontology for competency question: "What is the net price of the items sold in the invoice?"