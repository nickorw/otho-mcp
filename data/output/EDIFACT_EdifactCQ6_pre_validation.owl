@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Person a owl:Class .
:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .
:Cl_Address a owl:Class .
:Cl_BuyerAddressAssignment a owl:Class . # Reification/pivot class for Buyer-Address association

### Class Hierarchies

:Cl_Entity a owl:Class .
:Cl_Person rdfs:subClassOf :Cl_Entity .
:Cl_Address rdfs:subClassOf :Cl_Entity .
:Cl_BuyerAddressAssignment rdfs:subClassOf :Cl_Entity .

### Object Properties

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :isBuyerOfAssignment .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:inverseOf :isAddressOfAssignment .

:isBuyerOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:isAddressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment .

### Data Properties

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

### Restrictions

# Every Cl_BuyerAddressAssignment must have exactly one Buyer and one Address
:Cl_BuyerAddressAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasBuyer ;
              owl:cardinality "1"^^xsd:nonNegativeInteger ;
              owl:allValuesFrom :Cl_Buyer
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasAddress ;
              owl:cardinality "1"^^xsd:nonNegativeInteger ;
              owl:allValuesFrom :Cl_Address
            ]
        )
    ] .

### Disjointness

:Cl_Buyer owl:disjointWith :Cl_Address .

### Equivalent To

# If needed, can specify that an Address uniquely identifies a Buyer in this assignment context
# :Cl_BuyerAddressAssignment owl:equivalentClass [ ... ] .

### Notes

# This ontology models the answer to the competency question "What is the address of the buyer?"
# by introducing a pivot class Cl_BuyerAddressAssignment that connects Cl_Buyer and Cl_Address,
# allowing for the representation of complex scenarios (e.g., buyers with multiple addresses, address validity, etc.).
