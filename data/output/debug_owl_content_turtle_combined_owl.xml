@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "Ontology for representing music production, band membership, albums, performances, and related entities as described in the Red Hot Chili Peppers story." .

#################################################################
# Classes
#################################################################

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "An individual human involved in music production, performance, or critique." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A group of persons who perform music together." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or position held by a person within a band." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A published collection of tracks." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "A single audio track on an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition that may be recorded as a track." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews or comments on albums." .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live event in which a band performs music." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances can take place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographical region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Pivot Classes for N-ary Relations
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reified relation representing a person's membership in a band, their role, and the time period." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "A reified relation representing the recording period of an album." .

:TrackRecording a owl:Class ;
    rdfs:label "Track Recording" ;
    rdfs:comment "A reified relation linking a track to the song it records." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "A reified relation linking a performance to songs performed." .

#################################################################
# Object Properties (with Inverses)
#################################################################

:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :instrumentPlayedBy .

:instrumentPlayedBy a owl:ObjectProperty ;
    rdfs:label "instrument played by" ;
    rdfs:comment "Inverse: Relates an instrument to a person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasBandMembership a owl:ObjectProperty ;
    rdfs:label "has band membership" ;
    rdfs:comment "Relates a person to their band membership instances." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :membershipOfPerson .

:membershipOfPerson a owl:ObjectProperty ;
    rdfs:label "membership of person" ;
    rdfs:comment "Inverse: Relates a band membership to the person who holds it." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasBandMembership .

:bandOfMembership a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "band of membership" ;
    rdfs:comment "Relates a band membership instance to a band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasBandMembershipInstance .

:hasBandMembershipInstance a owl:ObjectProperty ;
    rdfs:label "has band membership instance" ;
    rdfs:comment "Inverse: Relates a band to a band membership instance." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :bandOfMembership .

:roleOfMembership a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "role of membership" ;
    rdfs:comment "Relates a band membership instance to a role." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :membershipForRole .

:membershipForRole a owl:ObjectProperty ;
    rdfs:label "membership for role" ;
    rdfs:comment "Inverse: Relates a role to a band membership instance." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :roleOfMembership .

:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates an album recording instance to the album recorded." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecordingInstance .

:albumRecordingInstance a owl:ObjectProperty ;
    rdfs:label "album recording instance" ;
    rdfs:comment "Inverse: Relates an album to its recording instance." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedAlbum .

:hasTrack a owl:ObjectProperty ;
    rdfs:label "has track" ;
    rdfs:comment "Relates an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfAlbum .

:trackOfAlbum a owl:ObjectProperty ;
    rdfs:label "track of album" ;
    rdfs:comment "Inverse: Relates a track to the album it is part of." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :hasTrack .

:trackRecording a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "track recording" ;
    rdfs:comment "Relates a track recording to the track." ;
    rdfs:domain :TrackRecording ;
    rdfs:range :Track ;
    owl:inverseOf :recordingOfTrack .

:recordingOfTrack a owl:ObjectProperty ;
    rdfs:label "recording of track" ;
    rdfs:comment "Inverse: Relates a track to its recording instance." ;
    rdfs:domain :Track ;
    rdfs:range :TrackRecording ;
    owl:inverseOf :trackRecording .

:recordingOfSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recording of song" ;
    rdfs:comment "Relates a track recording to the song it records." ;
    rdfs:domain :TrackRecording ;
    rdfs:range :Song ;
    owl:inverseOf :songRecordedBy .

:songRecordedBy a owl:ObjectProperty ;
    rdfs:label "song recorded by" ;
    rdfs:comment "Inverse: Relates a song to the track recording." ;
    rdfs:domain :Song ;
    rdfs:range :TrackRecording ;
    owl:inverseOf :recordingOfSong .

:criticOf a owl:ObjectProperty ;
    rdfs:label "critic of" ;
    rdfs:comment "Relates a critic to an album they review." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :albumCritic .

:albumCritic a owl:ObjectProperty ;
    rdfs:label "album critic" ;
    rdfs:comment "Inverse: Relates an album to its critic(s)." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :criticOf .

:performanceOfBand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance of band" ;
    rdfs:comment "Relates a performance to the band performing." ;
    rdfs:domain :Performance ;
    rdfs:range :Band ;
    owl:inverseOf :bandPerformance .

:bandPerformance a owl:ObjectProperty ;
    rdfs:label "band performance" ;
    rdfs:comment "Inverse: Relates a band to its performances." ;
    rdfs:domain :Band ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceOfBand .

:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance location" ;
    rdfs:comment "Relates a performance to the city where it occurs." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :cityPerformance .

:cityPerformance a owl:ObjectProperty ;
    rdfs:label "city performance" ;
    rdfs:comment "Inverse: Relates a city to performances held there." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performanceLocation .

:performanceSong a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "performance song" ;
    rdfs:comment "Relates a performance song instance to a performance." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :songPerformanceInstance .

:songPerformanceInstance a owl:ObjectProperty ;
    rdfs:label "song performance instance" ;
    rdfs:comment "Inverse: Relates a performance to its performance song instances." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceSong .

:songInPerformance a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "song in performance" ;
    rdfs:comment "Relates a performance song instance to a song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :performanceOfSong .

:performanceOfSong a owl:ObjectProperty ;
    rdfs:label "performance of song" ;
    rdfs:comment "Inverse: Relates a song to its performance song instances." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :songInPerformance .

:cityInRegion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "city in region" ;
    rdfs:comment "Relates a city to the region it is located in." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .

:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Inverse: Relates a region to its cities." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :cityInRegion .

:regionInCountry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "region in country" ;
    rdfs:comment "Relates a region to the country it is located in." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .

:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Inverse: Relates a country to its regions." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :regionInCountry .

#################################################################
# Data Properties
#################################################################

:albumReleaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "album release date" ;
    rdfs:comment "The release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:dateTime .

:trackNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track within an album." ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer .

:albumTrackCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "album track count" ;
    rdfs:comment "The total number of tracks in an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:integer .

:startDateOfMembership a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start date of membership" ;
    rdfs:comment "The date a person started their membership in a band." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:endDateOfMembership a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end date of membership" ;
    rdfs:comment "The date a person ended their membership in a band." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:dateTime .

:recordingStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording start date" ;
    rdfs:comment "The start date for recording an album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:recordingEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recording end date" ;
    rdfs:comment "The end date for recording an album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:dateTime .

:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "composed on" ;
    rdfs:comment "The date a song was composed." ;
    rdfs:domain :Song ;
    rdfs:range xsd:dateTime .

:criticComment a owl:DatatypeProperty ;
    rdfs:label "critic comment" ;
    rdfs:comment "A comment made by a critic about an album." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance date" ;
    rdfs:comment "The date of a performance." ;
    rdfs:domain :Performance ;
    rdfs:range xsd:dateTime .

#################################################################
# Disjointness
#################################################################

:Person owl:disjointWith :Band, :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Band owl:disjointWith :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Instrument owl:disjointWith :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Album owl:disjointWith :Track, :Song, :Critic, :Performance, :City, :Region, :Country .
:Track owl:disjointWith :Song, :Critic, :Performance, :City, :Region, :Country .
:Song owl:disjointWith :Critic, :Performance, :City, :Region, :Country .
:Critic owl:disjointWith :Performance, :City, :Region, :Country .
:Performance owl:disjointWith :City, :Region, :Country .
:City owl:disjointWith :Region, :Country .
:Region owl:disjointWith :Country .

#################################################################
# Class Restrictions & GCAs
#################################################################

# Album must have at least one track
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .
