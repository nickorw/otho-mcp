@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/music-production>
    a owl:Ontology ;
    rdfs:label "Music Production Ontology" ;
    rdfs:comment "An ontology for representing music production, band membership, albums, tracks, performances, and related entities." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, such as a musician or critic." .

:Band a owl:Class ;
    rdfs:label "Band" ;
    rdfs:comment "A group of musicians performing together." .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:comment "A musical instrument played by a person." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A musical or organizational role in a band (e.g., vocalist, guitarist)." .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of tracks released as a record." .

:Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "An individual track or recording on an album." .

:Song a owl:Class ;
    rdfs:label "Song" ;
    rdfs:comment "A musical composition that may be recorded as a track." .

:Critic a owl:Class ;
    rdfs:label "Critic" ;
    rdfs:comment "A person who reviews or critiques music albums." ;
    rdfs:subClassOf :Person .

:Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A live performance event by a band or artist." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city where performances take place." .

:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A region containing cities." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country containing regions." .

# Pivot Classes for reification
:BandMembership a owl:Class ;
    rdfs:label "Band Membership" ;
    rdfs:comment "A reified relation representing a person's membership in a band with a role and time interval." .

:AlbumRecording a owl:Class ;
    rdfs:label "Album Recording" ;
    rdfs:comment "A reified event representing the recording of an album with start and end dates." .

:TrackSongMapping a owl:Class ;
    rdfs:label "Track-Song Mapping" ;
    rdfs:comment "A reified relation mapping a track to the song it records." .

:PerformanceSong a owl:Class ;
    rdfs:label "Performance Song" ;
    rdfs:comment "A reified relation linking a performance to the songs played." .

### Object Properties and Inverses
:playsInstrument a owl:ObjectProperty ;
    rdfs:label "plays instrument" ;
    rdfs:comment "Relates a person to an instrument they play." ;
    rdfs:domain :Person ;
    rdfs:range :Instrument ;
    owl:inverseOf :playedBy .
:playedBy a owl:ObjectProperty ;
    rdfs:label "played by" ;
    rdfs:comment "Relates an instrument to the person who plays it." ;
    rdfs:domain :Instrument ;
    rdfs:range :Person ;
    owl:inverseOf :playsInstrument .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Relates a band to a BandMembership instance." ;
    rdfs:domain :Band ;
    rdfs:range :BandMembership ;
    owl:inverseOf :membershipOf .
:membershipOf a owl:ObjectProperty ;
    rdfs:label "membership of" ;
    rdfs:comment "Relates a BandMembership to the Band." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Band ;
    owl:inverseOf :hasMember .

:memberPerson a owl:ObjectProperty ;
    rdfs:label "member person" ;
    rdfs:comment "Relates a BandMembership to the Person member." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Person ;
    owl:inverseOf :personMembership .
:memberPerson a owl:FunctionalProperty .
:personMembership a owl:ObjectProperty ;
    rdfs:label "person membership" ;
    rdfs:comment "Relates a Person to their BandMembership." ;
    rdfs:domain :Person ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberPerson .

:memberRole a owl:ObjectProperty ;
    rdfs:label "member role" ;
    rdfs:comment "Relates a BandMembership to the Role played by the member." ;
    rdfs:domain :BandMembership ;
    rdfs:range :Role ;
    owl:inverseOf :roleInMembership .
:roleInMembership a owl:ObjectProperty ;
    rdfs:label "role in membership" ;
    rdfs:comment "Relates a Role to BandMemberships in which it is played." ;
    rdfs:domain :Role ;
    rdfs:range :BandMembership ;
    owl:inverseOf :memberRole .

:recordedAlbum a owl:ObjectProperty ;
    rdfs:label "recorded album" ;
    rdfs:comment "Relates an AlbumRecording to the Album." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range :Album ;
    owl:inverseOf :albumRecording .
:recordedAlbum a owl:FunctionalProperty .
:albumRecording a owl:ObjectProperty ;
    rdfs:label "album recording" ;
    rdfs:comment "Relates an Album to its AlbumRecording." ;
    rdfs:domain :Album ;
    rdfs:range :AlbumRecording ;
    owl:inverseOf :recordedAlbum .

:albumHasTrack a owl:ObjectProperty ;
    rdfs:label "album has track" ;
    rdfs:comment "Relates an album to its tracks." ;
    rdfs:domain :Album ;
    rdfs:range :Track ;
    owl:inverseOf :trackOfAlbum .
:trackOfAlbum a owl:ObjectProperty ;
    rdfs:label "track of album" ;
    rdfs:comment "Relates a Track to the Album it is part of." ;
    rdfs:domain :Track ;
    rdfs:range :Album ;
    owl:inverseOf :albumHasTrack .
:trackOfAlbum a owl:FunctionalProperty .

:trackSongMapping a owl:ObjectProperty ;
    rdfs:label "track song mapping" ;
    rdfs:comment "Relates a TrackSongMapping to the Song." ;
    rdfs:domain :TrackSongMapping ;
    rdfs:range :Song ;
    owl:inverseOf :songTrackMapping .
:trackSongMapping a owl:FunctionalProperty .
:songTrackMapping a owl:ObjectProperty ;
    rdfs:label "song track mapping" ;
    rdfs:comment "Relates a Song to its TrackSongMapping." ;
    rdfs:domain :Song ;
    rdfs:range :TrackSongMapping ;
    owl:inverseOf :trackSongMapping .

:hasCriticReview a owl:ObjectProperty ;
    rdfs:label "has critic review" ;
    rdfs:comment "Relates an album to a critic who reviewed it." ;
    rdfs:domain :Album ;
    rdfs:range :Critic ;
    owl:inverseOf :reviewedAlbum .
:reviewedAlbum a owl:ObjectProperty ;
    rdfs:label "reviewed album" ;
    rdfs:comment "Relates a Critic to the Album they reviewed." ;
    rdfs:domain :Critic ;
    rdfs:range :Album ;
    owl:inverseOf :hasCriticReview .

:performedAt a owl:ObjectProperty ;
    rdfs:label "performed at" ;
    rdfs:comment "Relates a performance to the city where it occurred." ;
    rdfs:domain :Performance ;
    rdfs:range :City ;
    owl:inverseOf :cityPerformance .
:performedAt a owl:FunctionalProperty .
:cityPerformance a owl:ObjectProperty ;
    rdfs:label "city performance" ;
    rdfs:comment "Relates a City to performances held in it." ;
    rdfs:domain :City ;
    rdfs:range :Performance ;
    owl:inverseOf :performedAt .

:performanceSong a owl:ObjectProperty ;
    rdfs:label "performance song" ;
    rdfs:comment "Relates a PerformanceSong to a Song." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Song ;
    owl:inverseOf :songPerformance .
:performanceSong a owl:FunctionalProperty .
:songPerformance a owl:ObjectProperty ;
    rdfs:label "song performance" ;
    rdfs:comment "Relates a Song to PerformanceSong in which it is played." ;
    rdfs:domain :Song ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceSong .

:performanceOf a owl:ObjectProperty ;
    rdfs:label "performance of" ;
    rdfs:comment "Relates a PerformanceSong to a Performance." ;
    rdfs:domain :PerformanceSong ;
    rdfs:range :Performance ;
    owl:inverseOf :hasPerformanceSong .
:performanceOf a owl:FunctionalProperty .
:hasPerformanceSong a owl:ObjectProperty ;
    rdfs:label "has performance song" ;
    rdfs:comment "Relates a Performance to its PerformanceSong instances." ;
    rdfs:domain :Performance ;
    rdfs:range :PerformanceSong ;
    owl:inverseOf :performanceOf .

:cityInRegion a owl:ObjectProperty ;
    rdfs:label "city in region" ;
    rdfs:comment "Relates a city to its region." ;
    rdfs:domain :City ;
    rdfs:range :Region ;
    owl:inverseOf :regionHasCity .
:cityInRegion a owl:FunctionalProperty .
:regionHasCity a owl:ObjectProperty ;
    rdfs:label "region has city" ;
    rdfs:comment "Relates a Region to its Cities." ;
    rdfs:domain :Region ;
    rdfs:range :City ;
    owl:inverseOf :cityInRegion .

:regionInCountry a owl:ObjectProperty ;
    rdfs:label "region in country" ;
    rdfs:comment "Relates a region to its country." ;
    rdfs:domain :Region ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasRegion .
:regionInCountry a owl:FunctionalProperty .
:countryHasRegion a owl:ObjectProperty ;
    rdfs:label "country has region" ;
    rdfs:comment "Relates a Country to its Regions." ;
    rdfs:domain :Country ;
    rdfs:range :Region ;
    owl:inverseOf :regionInCountry .

### Data Properties
:membershipStart a owl:DatatypeProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "The start date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:date .

:membershipEnd a owl:DatatypeProperty ;
    rdfs:label "membership end" ;
    rdfs:comment "The end date of a band membership." ;
    rdfs:domain :BandMembership ;
    rdfs:range xsd:date .

:recordingStart a owl:DatatypeProperty ;
    rdfs:label "recording start" ;
    rdfs:comment "The start date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:date .

:recordingEnd a owl:DatatypeProperty ;
    rdfs:label "recording end" ;
    rdfs:comment "The end date of album recording." ;
    rdfs:domain :AlbumRecording ;
    rdfs:range xsd:date .

:composedOn a owl:DatatypeProperty ;
    rdfs:label "composed on" ;
    rdfs:comment "The date a song was composed." ;
    rdfs:domain :Song ;
    rdfs:range xsd:date .

:reviewText a owl:DatatypeProperty ;
    rdfs:label "review text" ;
    rdfs:comment "The text of a critic's review." ;
    rdfs:domain :Critic ;
    rdfs:range xsd:string .

:albumReleaseDate a owl:DatatypeProperty ;
    rdfs:label "album release date" ;
    rdfs:comment "The release date of an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:date .

:trackNumber a owl:DatatypeProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The number of a track on an album." ;
    rdfs:domain :Track ;
    rdfs:range xsd:integer .

:albumTrackCount a owl:DatatypeProperty ;
    rdfs:label "album track count" ;
    rdfs:comment "The number of tracks on an album." ;
    rdfs:domain :Album ;
    rdfs:range xsd:integer .
:albumTrackCount a owl:FunctionalProperty .

### Restrictions and Axioms
# Album must have at least one track
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumHasTrack ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .
:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumTrackCount ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

# Disjointness axioms
:Person owl:disjointWith :Band .
:Instrument owl:disjointWith :Role .
:Album owl:disjointWith :Song .
:Track owl:disjointWith :Song .
:Critic owl:disjointWith :Performance .
:Performance owl:disjointWith :Album .
:City owl:disjointWith :Region .
:Region owl:disjointWith :Country .
