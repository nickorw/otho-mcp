/ontology#isTaxAmountOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#TaxAmount"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdfs:label>is tax amount of</rdfs:label>    <rdfs:comment>Inverse property: TaxAmount is part of SummarySection.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment is a logical grouping of data elements within a message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>is role assignment of</rdfs:label>    <rdfs:comment>Inverse property: OrganizationRoleAssignment is for Organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOfDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceItemDetail"/>    <rdfs:label>is price of detail</rdfs:label>    <rdfs:comment>Inverse property: Price is part of InvoiceItemDetail.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Assignment</rdfs:label>    <rdfs:comment>A pivot class reifying the assignment of an AgentRole to an Organization within an InvoiceMessage context.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The outermost envelope in EDIFACT, containing one or more messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Document Date</rdfs:label>    <rdfs:comment>A date associated with the invoice document.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="nf178e9f925a04a33af7cc84a005a281cb1">    <rdf:first rdf:resource="http://www.example.org/ontology#BuyerRole"/>    <rdf:rest rdf:nodeID="nf178e9f925a04a33af7cc84a005a281cb2"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#ReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Reference Number</rdfs:label>    <rdfs:comment>A reference number in the invoice header.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Amount</rdfs:label>    <rdfs:comment>The total invoice amount in the summary.</rdfs:comment>  </rdf:Description></rdf:RDF>