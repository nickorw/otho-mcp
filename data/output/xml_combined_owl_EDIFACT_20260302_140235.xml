/ontology#hasReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#ReferenceNumber"/>    <rdfs:label>has reference number</rdfs:label>    <rdfs:comment>Connects a HeaderSection to a ReferenceNumber.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isReferenceNumberOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isQuantityOfDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Quantity"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceItemDetail"/>    <rdfs:label>is quantity of detail</rdfs:label>    <rdfs:comment>Inverse property: Quantity is part of InvoiceItemDetail.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in the context of an invoice.</rdfs:comment>    <owl:disjointUnionOf rdf:nodeID="nf178e9f925a04a33af7cc84a005a281cb1"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Section"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>Summary Section</rdfs:label>    <rdfs:comment>Summary section providing total tax and invoice amounts.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isItemDetailOf">    <rdf:type rdf:resource="http://www.w3.org/