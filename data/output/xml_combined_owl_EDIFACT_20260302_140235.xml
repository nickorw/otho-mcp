omment>A composite data element in EDIFACT, grouping multiple simple elements.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#TaxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Tax Amount</rdfs:label>    <rdfs:comment>The total tax amount in the invoice summary.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Connects a CompositeDataElement to its SimpleDataElement(s).</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#netPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>net price</rdfs:label>    <rdfs:comment>The net price of an item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#usesP2PClass">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#P2PCoreClass"/>    <rdfs:label>uses P2P-O class</rdfs:label>    <rdfs:comment>Connects an InvoiceMessage to a core class from the P2P-O ontology.</rdfs:comment>    <owl:invers