@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/TheatreProductions>
    a owl:Ontology ;
    rdfs:label "Theatre Productions Ontology" ;
    rdfs:comment "Ontology describing theatre festivals, productions, plays, ensembles, actors, roles, and reviews in Italy." .

### Classes
:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city in which a theatre or festival is located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country in which a city is located." .

:TheatreFestival a owl:Class ;
    rdfs:label "Theatre Festival" ;
    rdfs:comment "A festival featuring theatre productions." .

:Theatre a owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:comment "A theatre venue where productions are staged." .

:Play a owl:Class ;
    rdfs:label "Play" ;
    rdfs:comment "A written dramatic work." .

:Production a owl:Class ;
    rdfs:label "Production" ;
    rdfs:comment "A specific staging of a play." .

:Ensemble a owl:Class ;
    rdfs:label "Ensemble" ;
    rdfs:comment "A group of actors performing together in a production." .

:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "A person who acts in theatre productions." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A character or part played by an actor in a production." .

:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:comment "A person who writes plays." .

:Newspaper a owl:Class ;
    rdfs:label "Newspaper" ;
    rdfs:comment "A newspaper or periodical reviewing productions." .

:Review a owl:Class ;
    rdfs:label "Review" ;
    rdfs:comment "A review of a production by a newspaper." .

:StarRating a owl:Class ;
    rdfs:label "Star Rating" ;
    rdfs:comment "A rating assigned to a production by a review." .

:Act a owl:Class ;
    rdfs:label "Act" ;
    rdfs:comment "A division of a play." .

### Pivot Classes (Reification)
:ProductionMembership a owl:Class ;
    rdfs:label "Production Membership" ;
    rdfs:comment "Membership of an actor in an ensemble for a production at a point in time." .

:RoleAssignment a owl:Class ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "Assignment of a role to an actor in a production at a point in time." .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "Employment of an actor at a theatre with a start date." .

### Object Properties
:hasLocation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has location" ;
    rdfs:comment "Relates a theatre festival to its host city." ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :City ;
    owl:inverseOf :isLocationOf .

:isLocationOf a owl:ObjectProperty ;
    rdfs:label "is location of" ;
    rdfs:comment "Inverse of hasLocation: relates a city to the theatre festival(s) it hosts." ;
    rdfs:domain :City ;
    rdfs:range :TheatreFestival ;
    owl:inverseOf :hasLocation .

:isLocatedIn a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "is located in" ;
    rdfs:comment "Relates a theatre to its city." ;
    rdfs:domain :Theatre ;
    rdfs:range :City ;
    owl:inverseOf :hasTheatre .

:hasTheatre a owl:ObjectProperty ;
    rdfs:label "has theatre" ;
    rdfs:comment "Inverse of isLocatedIn: relates a city to its theatres." ;
    rdfs:domain :City ;
    rdfs:range :Theatre ;
    owl:inverseOf :isLocatedIn .

:isInCountry a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "is in country" ;
    rdfs:comment "Relates a city to its country." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :hasCity .

:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Inverse of isInCountry: relates a country to its cities." ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    owl:inverseOf :isInCountry .

:hasPlay a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has play" ;
    rdfs:comment "Relates a production to its play." ;
    rdfs:domain :Production ;
    rdfs:range :Play ;
    owl:inverseOf :isPlayOf .

:isPlayOf a owl:ObjectProperty ;
    rdfs:label "is play of" ;
    rdfs:comment "Inverse of hasPlay: relates a play to a production." ;
    rdfs:domain :Play ;
    rdfs:range :Production ;
    owl:inverseOf :hasPlay .

:writtenBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "written by" ;
    rdfs:comment "Relates a play to its author." ;
    rdfs:domain :Play ;
    rdfs:range :Author ;
    owl:inverseOf :authorOf .

:authorOf a owl:ObjectProperty ;
    rdfs:label "author of" ;
    rdfs:comment "Inverse of writtenBy: relates an author to their plays." ;
    rdfs:domain :Author ;
    rdfs:range :Play ;
    owl:inverseOf :writtenBy .

:hasAct a owl:ObjectProperty ;
    rdfs:label "has act" ;
    rdfs:comment "Relates a play to its acts." ;
    rdfs:domain :Play ;
    rdfs:range :Act ;
    owl:inverseOf :isActOf .

:isActOf a owl:ObjectProperty ;
    rdfs:label "is act of" ;
    rdfs:comment "Inverse of hasAct: relates an act to its play." ;
    rdfs:domain :Act ;
    rdfs:range :Play ;
    owl:inverseOf :hasAct .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Relates an ensemble to its actors." ;
    rdfs:domain :Ensemble ;
    rdfs:range :Actor ;
    owl:inverseOf :isMemberOf .

:isMemberOf a owl:ObjectProperty ;
    rdfs:label "is member of" ;
    rdfs:comment "Inverse of hasMember: relates an actor to their ensemble." ;
    rdfs:domain :Actor ;
    rdfs:range :Ensemble ;
    owl:inverseOf :hasMember .

:hasProduction a owl:ObjectProperty ;
    rdfs:label "has production" ;
    rdfs:comment "Relates a theatre festival to its productions." ;
    rdfs:domain :TheatreFestival ;
    rdfs:range :Production ;
    owl:inverseOf :isProductionOf .

:isProductionOf a owl:ObjectProperty ;
    rdfs:label "is production of" ;
    rdfs:comment "Inverse of hasProduction: relates a production to its festival." ;
    rdfs:domain :Production ;
    rdfs:range :TheatreFestival ;
    owl:inverseOf :hasProduction .

:hasEnsemble a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has ensemble" ;
    rdfs:comment "Relates a production to its ensemble." ;
    rdfs:domain :Production ;
    rdfs:range :Ensemble ;
    owl:inverseOf :isEnsembleOf .

:isEnsembleOf a owl:ObjectProperty ;
    rdfs:label "is ensemble of" ;
    rdfs:comment "Inverse of hasEnsemble: relates an ensemble to its production." ;
    rdfs:domain :Ensemble ;
    rdfs:range :Production ;
    owl:inverseOf :hasEnsemble .

:hasReview a owl:ObjectProperty ;
    rdfs:label "has review" ;
    rdfs:comment "Relates a production to its reviews." ;
    rdfs:domain :Production ;
    rdfs:range :Review ;
    owl:inverseOf :isReviewOf .

:isReviewOf a owl:ObjectProperty ;
    rdfs:label "is review of" ;
    rdfs:comment "Inverse of hasReview: relates a review to its production." ;
    rdfs:domain :Review ;
    rdfs:range :Production ;
    owl:inverseOf :hasReview .

:hasStarRating a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has star rating" ;
    rdfs:comment "Relates a review to its star rating." ;
    rdfs:domain :Review ;
    rdfs:range :StarRating ;
    owl:inverseOf :isStarRatingOf .

:isStarRatingOf a owl:ObjectProperty ;
    rdfs:label "is star rating of" ;
    rdfs:comment "Inverse of hasStarRating: relates a star rating to its review." ;
    rdfs:domain :StarRating ;
    rdfs:range :Review ;
    owl:inverseOf :hasStarRating .

:reviewedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "reviewed by" ;
    rdfs:comment "Relates a review to the newspaper that authored it." ;
    rdfs:domain :Review ;
    rdfs:range :Newspaper ;
    owl:inverseOf :hasReviewBy .

:hasReviewBy a owl:ObjectProperty ;
    rdfs:label "has review by" ;
    rdfs:comment "Inverse of reviewedBy: relates a newspaper to its reviews." ;
    rdfs:domain :Newspaper ;
    rdfs:range :Review ;
    owl:inverseOf :reviewedBy .

:hasEmployment a owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:comment "Relates an actor to their employment records." ;
    rdfs:domain :Actor ;
    rdfs:range :Employment ;
    owl:inverseOf :isEmploymentOf .

:isEmploymentOf a owl:ObjectProperty ;
    rdfs:label "is employment of" ;
    rdfs:comment "Inverse of hasEmployment: relates employment to the actor." ;
    rdfs:domain :Employment ;
    rdfs:range :Actor ;
    owl:inverseOf :hasEmployment .

:employedAt a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "employed at" ;
    rdfs:comment "Relates an employment record to the theatre." ;
    rdfs:domain :Employment ;
    rdfs:range :Theatre ;
    owl:inverseOf :employs .

:employs a owl:ObjectProperty ;
    rdfs:label "employs" ;
    rdfs:comment "Inverse of employedAt: relates a theatre to its employees." ;
    rdfs:domain :Theatre ;
    rdfs:range :Employment ;
    owl:inverseOf :employedAt .

:hasProductionMembership a owl:ObjectProperty ;
    rdfs:label "has production membership" ;
    rdfs:comment "Relates an ensemble to its production membership records." ;
    rdfs:domain :Ensemble ;
    rdfs:range :ProductionMembership ;
    owl:inverseOf :isProductionMembershipOf .

:isProductionMembershipOf a owl:ObjectProperty ;
    rdfs:label "is production membership of" ;
    rdfs:comment "Inverse of hasProductionMembership: relates a production membership to its ensemble." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range :Ensemble ;
    owl:inverseOf :hasProductionMembership .

:membershipInProduction a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "membership in production" ;
    rdfs:comment "Relates a production membership record to the production." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range :Production ;
    owl:inverseOf :hasProductionMembershipIn .

:hasProductionMembershipIn a owl:ObjectProperty ;
    rdfs:label "has production membership in" ;
    rdfs:comment "Inverse of membershipInProduction: relates a production to its production memberships." ;
    rdfs:domain :Production ;
    rdfs:range :ProductionMembership ;
    owl:inverseOf :membershipInProduction .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Relates an actor to their role assignments." ;
    rdfs:domain :Actor ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :isRoleAssignmentOf .

:isRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:label "is role assignment of" ;
    rdfs:comment "Inverse of hasRoleAssignment: relates a role assignment to its actor." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Actor ;
    owl:inverseOf :hasRoleAssignment .

:assignedRole a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "assigned role" ;
    rdfs:comment "Relates a role assignment to the role." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Role ;
    owl:inverseOf :isAssignedRoleOf .

:isAssignedRoleOf a owl:ObjectProperty ;
    rdfs:label "is assigned role of" ;
    rdfs:comment "Inverse of assignedRole: relates a role to its role assignments." ;
    rdfs:domain :Role ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :assignedRole .

:roleInProduction a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "role in production" ;
    rdfs:comment "Relates a role assignment to the production." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Production ;
    owl:inverseOf :hasRoleAssignmentIn .

:hasRoleAssignmentIn a owl:ObjectProperty ;
    rdfs:label "has role assignment in" ;
    rdfs:comment "Inverse of roleInProduction: relates a production to its role assignments." ;
    rdfs:domain :Production ;
    rdfs:range :RoleAssignment ;
    owl:inverseOf :roleInProduction .

### Data Properties
:employmentStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "employment start" ;
    rdfs:comment "The start date of an actor's employment." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .

:membershipStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "membership start" ;
    rdfs:comment "The start date of a production membership." ;
    rdfs:domain :ProductionMembership ;
    rdfs:range xsd:dateTime .

:roleTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "role time" ;
    rdfs:comment "Temporal information about a role assignment (e.g., week, period)." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:string .

:premierDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "premier date" ;
    rdfs:comment "The premier date of a production." ;
    rdfs:domain :Production ;
    rdfs:range xsd:dateTime .

:actNumber a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "act number" ;
    rdfs:comment "The number of an act in a play." ;
    rdfs:domain :Act ;
    rdfs:range xsd:integer .

:numberOfActs a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "number of acts" ;
    rdfs:comment "The total number of acts in a play." ;
    rdfs:domain :Play ;
    rdfs:range xsd:integer .

:writingPeriodStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "writing period start" ;
    rdfs:comment "The year when the writing of a play started." ;
    rdfs:domain :Play ;
    rdfs:range xsd:gYear .

:writingPeriodEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "writing period end" ;
    rdfs:comment "The year when the writing of a play ended." ;
    rdfs:domain :Play ;
    rdfs:range xsd:gYear .

### Restrictions and Axioms
:Production owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :premierDate ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:comment "A production has exactly one premier date." .

### Disjointness
:City owl:disjointWith :Country .
:Actor owl:disjointWith :Ensemble .
:TheatreFestival owl:disjointWith :Production .
