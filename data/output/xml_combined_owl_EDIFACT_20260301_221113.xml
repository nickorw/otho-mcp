<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>The net price of an item in a LineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isMandatoryElementOfMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is mandatory element of message</rdfs:label>    <rdfs:comment>Inverse of hasMandatoryElement: relates a Segment to the Message for which it is mandatory.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has role assignment</rdfs:label>    <rdfs:comment>Inverse of assignedToInvoice: relates InvoiceMessage to its OrganizationRoleAssignments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isCompositeElementOfSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is composite element of segment</rdfs:label>    <rdfs:comment>Inverse of hasCompositeElement: relates a CompositeDataElement to its Segment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleAssignmentOfOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role assignment of organization</rdfs:label>    <rdfs:comment>Inverse of playsRole: relates an OrganizationRoleAssignment to its Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has invoice</rdfs:label>    <rdfs:comment>Inverse of isAssignedToProcess: relates a BusinessProcess to its InvoiceMessages.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment in a message, such as BGM or NAD.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAssignedToProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>is assigned to process</rdfs:label>    <rdfs:comment>Assigns an InvoiceMessage to a BusinessProcess.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>A legal entity or participant in a business process.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Address"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Price"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#describesItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>describes item</rdfs:label>    <rdfs:comment>Relates a LineItem to an Item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDescribedByLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOfDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is line item of detail</rdfs:label>    <rdfs:comment>Inverse of hasLineItem: relates a LineItem to InvoiceDetail.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Relates a LineItem to a Price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOfLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOfLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is price of line item</rdfs:label>    <rdfs:comment>Inverse of hasPrice: relates a Price to the LineItem it is for.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasMandatoryElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has mandatory element</rdfs:label>    <rdfs:comment>Links a Message to a Segment that is mandatory per standards.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isMandatoryElementOfMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>The total invoice amount in the summary.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal or physical address.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDescribedByLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is described by line item</rdfs:label>    <rdfs:comment>Inverse of describesItem: relates an Item to the LineItem describing it.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#playsRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>plays role assignment</rdfs:label>    <rdfs:comment>Relates an Organization to an OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleAssignmentOfOrganization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Assignment</rdfs:label>    <rdfs:comment>Reifies the assignment of an organization to a role in an invoice context.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>Relates an Organization to an Identifier, e.g., GLN.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Identifier"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIdentifierOfOrganization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element in a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Relates a Segment to a Composite Data Element.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOfSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has role</rdfs:label>    <rdfs:comment>Relates an OrganizationRoleAssignment to an AgentRole.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOfAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice number</rdfs:label>    <rdfs:comment>The invoice number in the header.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceSummary">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Summary</rdfs:label>    <rdfs:comment>The summary section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role of assignment</rdfs:label>    <rdfs:comment>Inverse of hasRole: relates an AgentRole to OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>The price associated with an item or invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>contains segment</rdfs:label>    <rdfs:comment>Relates a Message to a Segment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOfMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isMessageInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is message in envelope</rdfs:label>    <rdfs:comment>Inverse of hasMessage: relates a Message to the InterchangeEnvelope it is in.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Relates an InvoiceDetail to a LineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isLineItemOfDetail"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOfOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is identifier of organization</rdfs:label>    <rdfs:comment>Inverse of hasIdentifier: relates an Identifier to its Organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOfRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is address of role assignment</rdfs:label>    <rdfs:comment>Inverse of hasAddress: relates an Address to OrganizationRoleAssignment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOfMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of message</rdfs:label>    <rdfs:comment>Inverse of containsSegment: relates a Segment to its Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedToInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>assigned to invoice</rdfs:label>    <rdfs:comment>Links an OrganizationRoleAssignment to an InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a Composite Data Element to a Simple Data Element.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOfComposite"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSimpleElementOfComposite">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is simple element of composite</rdfs:label>    <rdfs:comment>Inverse of hasSimpleElement: relates a SimpleDataElement to its CompositeDataElement.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Header</rdfs:label>    <rdfs:comment>The header section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has message</rdfs:label>    <rdfs:comment>Relates an Interchange Envelope to a Message.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isMessageInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>An itemized line in the invoice detail section.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization, such as Buyer or Delivery Party.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element grouping simple elements.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has date</rdfs:label>    <rdfs:comment>The date of the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Relates an OrganizationRoleAssignment to an Address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOfRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>A unique identifier, such as a Global Location Number.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>Envelope containing one or more messages in UN/EDIFACT</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Message"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#storyid">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology for modeling UN/EDIFACT invoices, message structure, organization roles, and compliance with EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>The quantity of items in a LineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail</rdfs:label>    <rdfs:comment>The detail section of an invoice message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>A message representing an invoice, subclass of Message.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service listed in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process, e.g., Purchase-to-Pay.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A business message such as INVOIC in UN/EDIFACT.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description></rdf:RDF>