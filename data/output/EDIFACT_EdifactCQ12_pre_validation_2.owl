@prefix : <http://example.org/invoice#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes (with hierarchy)

:Cl_Document rdf:type owl:Class .

:Cl_Invoice rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_InvoiceIdentifier rdf:type owl:Class .

:Cl_InvoiceNumberAssignment rdf:type owl:Class .

### Disjointness

:Cl_InvoiceIdentifier owl:disjointWith :Cl_Invoice .
:Cl_InvoiceNumberAssignment owl:disjointWith :Cl_Invoice .
:Cl_InvoiceNumberAssignment owl:disjointWith :Cl_InvoiceIdentifier .

### Properties

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :isInvoiceNumberAssignmentOf .

:isInvoiceNumberAssignmentOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumberAssignment .

:hasInvoiceNumber rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_InvoiceIdentifier ;
    owl:inverseOf :isInvoiceNumberOfAssignment .

:isInvoiceNumberOfAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range :Cl_InvoiceNumberAssignment .

:invoiceNumberValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

### Restrictions and Class Axioms

# Every Invoice has at least one InvoiceNumberAssignment
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isInvoiceNumberAssignmentOf ;
    owl:someValuesFrom :Cl_InvoiceNumberAssignment
] .

# Every InvoiceNumberAssignment relates exactly one Invoice and one InvoiceIdentifier
:Cl_InvoiceNumberAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Every InvoiceNumberAssignment must have an Invoice and an InvoiceIdentifier
:Cl_InvoiceNumberAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:allValuesFrom :Cl_Invoice
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:allValuesFrom :Cl_InvoiceIdentifier
] .

# Optional: Equivalence for pivot class (not strictly necessary for answering the competency question)
#:Cl_InvoiceNumberAssignment owl:equivalentClass [
#    rdf:type owl:Class ;
#    owl:intersectionOf (
#        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
#        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
#    )
#] .

### Comment

# This ontology structure allows answering "What is the invoice number?" by traversing from a :Cl_Invoice to its :Cl_InvoiceNumberAssignment, then to the :Cl_InvoiceIdentifier, and finally retrieving the :invoiceNumberValue.