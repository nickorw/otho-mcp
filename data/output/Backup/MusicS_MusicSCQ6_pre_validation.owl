@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Creative Work" .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:label "Musical Work" .

:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:label "Album" .

:Cl_Event rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Event" .

:Cl_ReleaseEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Release Event" .

# Object Properties
:hasReleaseEvent rdf:type owl:ObjectProperty ;
    rdfs:label "has release event" ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_ReleaseEvent ;
    rdf:type owl:FunctionalProperty . # An album is considered to have one primary release event in this context.

:concernsAlbum rdf:type owl:ObjectProperty ;
    rdfs:label "concerns album" ;
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :hasReleaseEvent ;
    rdf:type owl:FunctionalProperty . # A release event refers to exactly one album.

# Data Properties
:hasReleaseDate rdf:type owl:DatatypeProperty ;
    rdfs:label "has release date" ;
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range xsd:date ;
    rdf:type owl:FunctionalProperty . # A release event has exactly one release date.

# General Class Axioms / Restrictions
# An Album must have exactly one primary Release Event based on the 'hasReleaseEvent' property being functional.
:Cl_Album owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Album
        [
            rdf:type owl:Restriction ;
            owl:onProperty :hasReleaseEvent ;
            owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .

# A ReleaseEvent must concern exactly one Album and have exactly one Release Date.
:Cl_ReleaseEvent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_ReleaseEvent
        [
            rdf:type owl:Restriction ;
            owl:onProperty :concernsAlbum ;
            owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
        [
            rdf:type owl:Restriction ;
            owl:onProperty :hasReleaseDate ;
            owl:cardinality "1"^^xsd:nonNegativeInteger
        ]
    )
] .