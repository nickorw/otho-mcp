@prefix : <http://www.semanticweb.org/ontology/band-membership#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/ontology/band-membership> rdf:type owl:Ontology ;
                                                     owl:versionIRI <http://www.semanticweb.org/ontology/band-membership/1.0.0> ;
                                                     rdfs:comment "Ontology for representing band membership information to answer the competency question: 'What are the members of a certain band at a certain point in time?'" .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
           rdfs:comment "The most general class representing anything in the domain." .

:Cl_Agent rdf:type owl:Class ;
          rdfs:subClassOf :Cl_Entity ;
          rdfs:comment "Represents an entity that can perform actions or has a role." .

:Cl_Organization rdf:type owl:Class ;
                 rdfs:subClassOf :Cl_Agent ;
                 rdfs:comment "Represents a group or organized body." .

:Cl_Band rdf:type owl:Class ;
         rdfs:subClassOf :Cl_Organization ;
         rdfs:comment "Represents a musical band." .

:Cl_Person rdf:type owl:Class ;
           rdfs:subClassOf :Cl_Agent ;
           rdfs:comment "Represents an individual person." .

:Cl_TemporalEntity rdf:type owl:Class ;
                   rdfs:subClassOf :Cl_Entity ;
                   rdfs:comment "Represents any entity related to time." .

:Cl_DateTime rdf:type owl:Class ;
             rdfs:subClassOf :Cl_TemporalEntity ;
             rdfs:comment "Represents a specific point in time or a date and time." .

# Pivot class for reifying the 'member of a band at a certain time' relationship
:Cl_BandMembership rdf:type owl:Class ;
                   rdfs:subClassOf :Cl_Entity ;
                   rdfs:comment "Represents the specific event or state of a person being a member of a band, including the temporal context." .

#################################################################
#    Object Properties
#################################################################

:hasMembershipEvent rdf:type owl:ObjectProperty ;
                    rdfs:domain :Cl_Band ;
                    rdfs:range :Cl_BandMembership ;
                    rdfs:comment "Links a band to a specific membership event involving one of its members." .

:forBand rdf:type owl:ObjectProperty ;
         owl:inverseOf :hasMembershipEvent ;
         rdfs:domain :Cl_BandMembership ;
         rdfs:range :Cl_Band ;
         rdfs:comment "Links a band membership event to the specific band it pertains to." .

:involvesPerson rdf:type owl:ObjectProperty ;
                rdfs:domain :Cl_BandMembership ;
                rdfs:range :Cl_Person ;
                rdfs:comment "Links a band membership event to the person who is the member." .

:hasBandMembership rdf:type owl:ObjectProperty ;
                   owl:inverseOf :involvesPerson ;
                   rdfs:domain :Cl_Person ;
                   rdfs:range :Cl_BandMembership ;
                   rdfs:comment "Links a person to a specific band membership event they are involved in." .

#################################################################
#    Data Properties
#################################################################

:bandName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Cl_Band ;
          rdfs:range xsd:string ;
          owl:functional true ;
          rdfs:comment "The official or common name of the band." .

:personName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Cl_Person ;
            rdfs:range xsd:string ;
            owl:functional true ;
            rdfs:comment "The primary name of the person." .

:hasMembershipStartTime rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Cl_BandMembership ;
                        rdfs:range xsd:dateTime ;
                        owl:functional true ;
                        rdfs:comment "The date and time when the person's membership in the band began." .

:hasMembershipEndTime rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Cl_BandMembership ;
                      rdfs:range xsd:dateTime ;
                      owl:functional true ;
                      rdfs:comment "The date and time when the person's membership in the band ended. This property might be absent if the membership is ongoing." .

#################################################################
#    General Class Axioms / Restrictions
#################################################################

# A Cl_BandMembership must involve exactly one person.
:Cl_BandMembership rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :involvesPerson ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                      rdfs:comment "Each band membership event must link to exactly one person."
                                    ] .

# A Cl_BandMembership must be for exactly one band.
:Cl_BandMembership rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :forBand ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                      rdfs:comment "Each band membership event must link to exactly one band."
                                    ] .

# A Cl_BandMembership must have a start time.
:Cl_BandMembership rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasMembershipStartTime ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                      rdfs:comment "Each band membership event must have a defined start date and time."
                                    ] .

# If a band has members, it implies there are membership events.
:Cl_Band rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasMembershipEvent ;
                            owl:someValuesFrom :Cl_BandMembership ;
                            rdfs:comment "A band must be associated with at least one band membership event if it has members."
                          ] .

# If a person is a band member, they must be involved in at least one band membership event.
:Cl_Person rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :hasBandMembership ;
                              owl:someValuesFrom :Cl_BandMembership ;
                              rdfs:comment "A person identified as a band member must be associated with at least one band membership event."
                            ] .