@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Place rdf:type owl:Class .

:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Place .

:Cl_Settlement rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity .

:Cl_City rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Settlement .

:Cl_PoliticalEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity .

:Cl_Country rdf:type owl:Class ;
    rdfs:subClassOf :Cl_PoliticalEntity .

# Disjointness axioms
:Cl_Settlement owl:disjointWith :Cl_PoliticalEntity .
:Cl_City owl:disjointWith :Cl_Country .

# Properties
:hasLocationCountry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_City ;
    rdfs:range :Cl_Country ;
    owl:inverseOf :isLocationOfCity ;
    rdf:type owl:FunctionalProperty .

:isLocationOfCity rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Country ;
    rdfs:range :Cl_City .

# General Class Axioms / Restrictions
# Every Cl_City must be located in at least one Cl_Country.
:Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasLocationCountry ;
    owl:someValuesFrom :Cl_Country
] .