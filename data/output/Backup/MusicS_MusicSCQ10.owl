@prefix : <http://example.org/performance-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology URI
<http://example.org/performance-ontology> rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/performance-ontology/1.0> ;
    rdfs:comment "Ontology for representing performance events and their timings, focusing on the competency question 'When did a certain performance take place?'" .

#################################################################
#    Classes
#################################################################

# Top-level abstract class for all entities
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A top-level class for all conceptual entities in the ontology, serving as a root for classification." .

# Classes related to temporal concepts
:Cl_TemporalEntity rdf:type owl:Class ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "Represents any entity that has a temporal dimension, such as points in time or intervals." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_DateTime rdf:type owl:Class ;
    rdfs:label "Date Time" ;
    rdfs:comment "Represents a specific point in time, including both date and time components, mapping to xsd:dateTime." ;
    rdfs:subClassOf :Cl_TemporalEntity .

# Classes related to activities and events
:Cl_Activity rdf:type owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "Represents any action, process, or task that can be performed." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Performance rdf:type owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "Represents a specific act of performing, such as a musical concert, theatrical play, or an exhibition." ;
    rdfs:subClassOf :Cl_Activity .

:Cl_Occurrence rdf:type owl:Class ;
    rdfs:label "Occurrence" ;
    rdfs:comment "A general class for any event or happening that takes place at a specific time or over an interval." ;
    rdfs:subClassOf :Cl_Entity .

# Reification Class: Cl_PerformanceOccurrence
# This pivot class captures the event of a specific performance taking place at a certain time.
:Cl_PerformanceOccurrence rdf:type owl:Class ;
    rdfs:label "Performance Occurrence" ;
    rdfs:comment "Represents a specific instance or scheduled event of a Cl_Performance taking place at a particular date and time. This class reifies the 'takes place at' relationship." ;
    rdfs:subClassOf :Cl_Occurrence ;
    # Definition of Cl_PerformanceOccurrence using an equivalent class axiom:
    # A Performance Occurrence is an Occurrence that must concern a Performance and must have a date/time.
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Cl_Occurrence
            [ rdf:type owl:Restriction ;
              owl:onProperty :op_concernsPerformance ;
              owl:someValuesFrom :Cl_Performance ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :dp_atDateTime ;
              owl:someValuesFrom xsd:dateTime ]
        )
    ] .

# General Class Axioms (Additional restrictions for Cl_PerformanceOccurrence)
# Every Cl_PerformanceOccurrence must concern exactly one Cl_Performance.
:Cl_PerformanceOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :op_concernsPerformance ;
    owl:cardinality 1 ;
    rdfs:comment "Every Performance Occurrence must be associated with exactly one specific Performance."
] .

# Every Cl_PerformanceOccurrence must have exactly one dp_atDateTime.
:Cl_PerformanceOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :dp_atDateTime ;
    owl:cardinality 1 ;
    rdfs:comment "Every Performance Occurrence must have exactly one date and time specified for its occurrence."
] .

#################################################################
#    Object Properties
#################################################################

:op_concernsPerformance rdf:type owl:ObjectProperty ;
    rdfs:label "concerns performance" ;
    rdfs:comment "Links an instance of Cl_PerformanceOccurrence to the specific Cl_Performance that is taking place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Performance .

#################################################################
#    Data Properties
#################################################################

:dp_atDateTime rdf:type owl:DatatypeProperty ;
    rdfs:label "at date time" ;
    rdfs:comment "Specifies the precise date and time at which a Cl_PerformanceOccurrence takes place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range xsd:dateTime .