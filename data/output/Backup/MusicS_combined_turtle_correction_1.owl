@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://fest.org/ontology/> .

:FestS rdf:type owl:Ontology ;
    owl:versionIRI :1.0.0 .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

# Agents
:Cl_Agent rdf:type owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Person rdf:type owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf :Cl_Agent .

:Cl_Musician rdf:type owl:Class ;
    rdfs:label "Musician" ;
    rdfs:subClassOf :Cl_Person .

:Cl_Composer rdf:type owl:Class ;
    rdfs:label "Composer" ;
    rdfs:subClassOf :Cl_Person .

:Cl_Critic rdf:type owl:Class ;
    rdfs:label "Critic" ;
    rdfs:subClassOf :Cl_Person .

:ClOrganization rdf:type owl:Class ; # Renamed from :Cl_Organization for P22
    rdfs:label "Organization" ; # Added for P08
    rdfs:subClassOf :Cl_Agent .

:Cl_Band rdf:type owl:Class ;
    rdfs:label "Band" ;
    rdfs:subClassOf :ClOrganization . # Updated reference for P22

# Objects / Items
:Cl_Object rdf:type owl:Class ;
    rdfs:label "Object" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_Item rdf:type owl:Class ;
    rdfs:label "Item" ; # Added for P08
    rdfs:subClassOf :Cl_Object .

:Cl_MusicalInstrument rdf:type owl:Class ;
    rdfs:label "Musical instrument" ; # Added for P08
    rdfs:subClassOf :Cl_Object .

:Cl_StringInstrument rdf:type owl:Class ;
    rdfs:label "String instrument" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalInstrument .
:Cl_WindInstrument rdf:type owl:Class ;
    rdfs:label "Wind instrument" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalInstrument .
:Cl_PercussionInstrument rdf:type owl:Class ;
    rdfs:label "Percussion instrument" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalInstrument .
:Cl_KeyboardInstrument rdf:type owl:Class ;
    rdfs:label "Keyboard instrument" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalInstrument .
:Cl_ElectronicInstrument rdf:type owl:Class ;
    rdfs:label "Electronic instrument" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalInstrument .

:Cl_Role rdf:type owl:Class ;
    rdfs:label "Role" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

# Temporal Entities
:Cl_TemporalEntity rdf:type owl:Class ;
    rdfs:label "Temporal entity" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_DateTime rdf:type owl:Class ;
    rdfs:label "Date time" ; # Added for P08
    rdfs:subClassOf :Cl_TemporalEntity .

:Cl_TimePoint rdf:type owl:Class ;
    rdfs:label "Time point" ; # Added for P08
    rdfs:subClassOf :Cl_TemporalEntity .

:Cl_TimePeriod rdf:type owl:Class ;
    rdfs:label "Time period" ; # Added for P08
    rdfs:subClassOf :Cl_TemporalEntity .

# Events
:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_Activity rdf:type owl:Class ;
    rdfs:label "Activity" ; # Added for P08
    rdfs:subClassOf :Cl_Event .

:Cl_Performance rdf:type owl:Class ;
    rdfs:label "Performance" ; # Added for P08
    rdfs:subClassOf :Cl_Activity .

:Cl_Concert rdf:type owl:Class ;
    rdfs:label "Concert" ; # Added for P08
    rdfs:subClassOf :Cl_Performance .

:Cl_Play rdf:type owl:Class ;
    rdfs:label "Play" ; # Added for P08
    rdfs:subClassOf :Cl_Performance .

:Cl_DancePerformance rdf:type owl:Class ;
    rdfs:label "Dance performance" ; # Added for P08
    rdfs:subClassOf :Cl_Performance .

:Cl_Occurrence rdf:type owl:Class ;
    rdfs:label "Occurrence" ; # Added for P08
    rdfs:subClassOf :Cl_Event .

:Cl_PerformanceOccurrence rdf:type owl:Class ;
    rdfs:label "Performance occurrence" ; # Added for P08
    rdfs:subClassOf :Cl_Occurrence .

:Cl_CompositionEvent rdf:type owl:Class ;
    rdfs:label "Composition event" ; # Added for P08
    rdfs:subClassOf :Cl_Event .

:Cl_RecordingEvent rdf:type owl:Class ;
    rdfs:label "Recording event" ; # Added for P08
    rdfs:subClassOf :Cl_Event .

:Cl_ReleaseEvent rdf:type owl:Class ;
    rdfs:label "Release event" ; # Added for P08
    rdfs:subClassOf :Cl_Event .

# Creative Works
:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:label "Creative work" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:label "Musical work" ; # Added for P08
    rdfs:subClassOf :Cl_CreativeWork .

:Cl_Song rdf:type owl:Class ;
    rdfs:label "Song" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalWork .

:Cl_AudioRecording rdf:type owl:Class ;
    rdfs:label "Audio recording" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalWork .

:Cl_Collection rdf:type owl:Class ;
    rdfs:label "Collection" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_Album rdf:type owl:Class ;
    rdfs:label "Album" ; # Added for P08
    rdfs:subClassOf :Cl_MusicalWork , :Cl_Collection .

:Cl_Record owl:equivalentClass :Cl_Album ;
    rdfs:label "Record" . # Added for P08

# Geographical Entities
:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:label "Geographical entity" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_Location rdf:type owl:Class ;
    rdfs:label "Location" ; # Added for P08
    rdfs:subClassOf :Cl_GeographicalEntity .

:Cl_Place rdf:type owl:Class ;
    rdfs:label "Place" ; # Added for P08
    rdfs:subClassOf :Cl_Location .

:Cl_PopulatedPlace rdf:type owl:Class ;
    rdfs:label "Populated place" ; # Added for P08
    rdfs:subClassOf :Cl_Place .

:Cl_City rdf:type owl:Class ;
    rdfs:label "City" ; # Added for P08
    rdfs:subClassOf :Cl_PopulatedPlace .

:Cl_AdministrativeDivision rdf:type owl:Class ;
    rdfs:label "Administrative division" ; # Added for P08
    rdfs:subClassOf :Cl_Location .

:Cl_Country rdf:type owl:Class ;
    rdfs:label "Country" ; # Added for P08
    rdfs:subClassOf :Cl_AdministrativeDivision .

:Cl_Region rdf:type owl:Class ;
    rdfs:label "Region" ; # Added for P08
    rdfs:subClassOf :Cl_AdministrativeDivision , :Cl_Location .

:Cl_Venue rdf:type owl:Class ;
    rdfs:label "Venue" ; # Added for P08
    rdfs:subClassOf :Cl_Location .

:Cl_Theatre rdf:type owl:Class ;
    rdfs:label "Theatre" ; # Added for P08
    rdfs:subClassOf :Cl_Venue .

:Cl_ConcertHall rdf:type owl:Class ;
    rdfs:label "Concert hall" ; # Added for P08
    rdfs:subClassOf :Cl_Venue .

:Cl_OutdoorVenue rdf:type owl:Class ;
    rdfs:label "Outdoor venue" ; # Added for P08
    rdfs:subClassOf :Cl_Venue .

# Reified Relations
:Cl_Relation rdf:type owl:Class ;
    rdfs:label "Relation" ; # Added for P08
    rdfs:subClassOf :Cl_Entity .

:Cl_InstrumentPlayingRelation rdf:type owl:Class ;
    rdfs:label "Instrument playing relation" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

:Cl_BandMembership rdf:type owl:Class ;
    rdfs:label "Band membership" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

:Cl_BandRoleAssignment rdf:type owl:Class ;
    rdfs:label "Band role assignment" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

:Cl_AlbumTrackInclusion rdf:type owl:Class ;
    rdfs:label "Album track inclusion" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

:Cl_RecordingInstance rdf:type owl:Class ;
    rdfs:label "Recording instance" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

:Cl_Review rdf:type owl:Class ;
    rdfs:label "Review" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

:Cl_PerformanceSongEvent rdf:type owl:Class ;
    rdfs:label "Performance song event" ; # Added for P08
    rdfs:subClassOf :Cl_Relation .

# Added Cl_Track for missing definition in the provided ontology, needed for :Cl_AlbumTrackInclusion
:Cl_Track rdf:type owl:Class ;
    rdfs:label "Track" ;
    rdfs:subClassOf :Cl_CreativeWork .

#################################################################
#    Object Properties
#################################################################

:playsInstrumentRelation rdf:type owl:ObjectProperty ;
    rdfs:label "Plays instrument relation" ; # Added for P08
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_InstrumentPlayingRelation .

:hasPlayer rdf:type owl:ObjectProperty ;
    rdfs:label "Has player" ; # Added for P08
    rdfs:domain :Cl_InstrumentPlayingRelation ;
    rdfs:range :Cl_Person ;
    owl:inverseOf :playsInstrumentRelation .

:hasInstrument rdf:type owl:ObjectProperty ;
    rdfs:label "Has instrument" ; # Added for P08
    rdfs:domain :Cl_InstrumentPlayingRelation ;
    rdfs:range :Cl_MusicalInstrument .

:instrumentIsPlayedInRelation rdf:type owl:ObjectProperty ;
    rdfs:label "Instrument is played in relation" ; # Added for P08
    rdfs:domain :Cl_MusicalInstrument ;
    rdfs:range :Cl_InstrumentPlayingRelation ;
    owl:inverseOf :hasInstrument .

:hasMembershipEvent rdf:type owl:ObjectProperty ;
    rdfs:label "Has membership event" ; # Added for P08
    rdfs:domain :Cl_Band ;
    rdfs:range :Cl_BandMembership .

:forBand rdf:type owl:ObjectProperty ;
    rdfs:label "For band" ; # Added for P08
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Band ;
    owl:inverseOf :hasMembershipEvent .

:involvesPerson rdf:type owl:ObjectProperty ;
    rdfs:label "Involves person" ; # Added for P08
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Person .

:hasBandMembership rdf:type owl:ObjectProperty ;
    rdfs:label "Has band membership" ; # Added for P08
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_BandMembership ;
    owl:inverseOf :involvesPerson .

:roleAssignedToPerson rdf:type owl:ObjectProperty ;
    rdfs:label "Role assigned to person" ; # Added for P08
    rdfs:domain :Cl_BandRoleAssignment ;
    rdfs:range :Cl_Person ;
    owl:cardinality 1 ;
    owl:inverseOf :assignedRoleOfPerson . # Added for P13

:assignedRoleOfPerson rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Assigned role of person" ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_BandRoleAssignment ;
    owl:inverseOf :roleAssignedToPerson .

:roleInBand rdf:type owl:ObjectProperty ;
    rdfs:label "Role in band" ; # Added for P08
    rdfs:domain :Cl_BandRoleAssignment ;
    rdfs:range :Cl_Band ;
    owl:cardinality 1 ;
    owl:inverseOf :assignedRoleInBand . # Added for P13

:assignedRoleInBand rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Assigned role in band" ;
    rdfs:domain :Cl_Band ;
    rdfs:range :Cl_BandRoleAssignment ;
    owl:inverseOf :roleInBand .

:hasRole rdf:type owl:ObjectProperty ;
    rdfs:label "Has role" ; # Added for P08
    rdfs:domain :Cl_BandRoleAssignment ;
    rdfs:range :Cl_Role ;
    owl:cardinality 1 ;
    owl:inverseOf :isRoleForAssignment . # Added for P13

:isRoleForAssignment rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Is role for assignment" ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_BandRoleAssignment ;
    owl:inverseOf :hasRole .

:atTimePoint rdf:type owl:ObjectProperty ;
    rdfs:label "At time point" ; # Added for P08
    rdfs:domain :Cl_BandRoleAssignment ;
    rdfs:range :Cl_TimePoint ;
    owl:cardinality 1 ;
    owl:inverseOf :timePointOfRoleAssignment . # Added for P13

:timePointOfRoleAssignment rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Time point of role assignment" ;
    rdfs:domain :Cl_TimePoint ;
    rdfs:range :Cl_BandRoleAssignment ;
    owl:inverseOf :atTimePoint .

:hasRecordingEvent rdf:type owl:ObjectProperty ;
    rdfs:label "Has recording event" ; # Added for P08
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_RecordingEvent .

:recordedAlbum rdf:type owl:ObjectProperty ;
    rdfs:label "Recorded album" ; # Added for P08
    rdfs:domain :Cl_RecordingEvent ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :hasRecordingEvent .

:occursDuring rdf:type owl:ObjectProperty ;
    rdfs:label "Occurs during" ; # Added for P08
    rdfs:domain :Cl_RecordingEvent ;
    rdfs:range :Cl_TimePeriod .

:isTimePeriodOf rdf:type owl:ObjectProperty ;
    rdfs:label "Is time period of" ; # Added for P08
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range :Cl_RecordingEvent ;
    owl:inverseOf :occursDuring .

:includesTrackPlacement rdf:type owl:ObjectProperty ;
    rdfs:label "Includes track placement" ; # Added for P08
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_AlbumTrackInclusion .

:isPlacementForTrack rdf:type owl:ObjectProperty ;
    rdfs:label "Is placement for track" ; # Added for P08
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range :Cl_Track ;
    owl:inverseOf :trackHasPlacement . # Added for P13

:trackHasPlacement rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Track has placement" ;
    rdfs:domain :Cl_Track ;
    rdfs:range :Cl_AlbumTrackInclusion ;
    owl:inverseOf :isPlacementForTrack .

:relatesToAlbum rdf:type owl:ObjectProperty ;
    rdfs:label "Relates to album" ; # Added for P08
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :includesTrackPlacement .

:hasReleaseEvent rdf:type owl:ObjectProperty ;
    rdfs:label "Has release event" ; # Added for P08
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_ReleaseEvent ;
    rdf:type owl:FunctionalProperty .

:concernsAlbum rdf:type owl:ObjectProperty ;
    rdfs:label "Concerns album" ; # Added for P08
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :hasReleaseEvent ;
    rdf:type owl:FunctionalProperty .

:hasRecordingInstance rdf:type owl:ObjectProperty ;
    rdfs:label "Has recording instance" ; # Added for P08
    rdfs:domain :Cl_AudioRecording ;
    rdfs:range :Cl_RecordingInstance ;
    owl:inverseOf :isRecordingInstanceFor . # Added for P13

:isRecordingInstanceFor rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Is recording instance for" ;
    rdfs:domain :Cl_RecordingInstance ;
    rdfs:range :Cl_AudioRecording ;
    owl:inverseOf :hasRecordingInstance .

:isInstanceOfMusicalWork rdf:type owl:ObjectProperty ;
    rdfs:label "Is instance of musical work" ; # Added for P08
    rdfs:domain :Cl_RecordingInstance ;
    rdfs:range :Cl_MusicalWork ;
    owl:inverseOf :hasInstance . # Added for P13

:hasInstance rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Has instance" ;
    rdfs:domain :Cl_MusicalWork ;
    rdfs:range :Cl_RecordingInstance ;
    owl:inverseOf :isInstanceOfMusicalWork .

:isRecordingOf rdf:type owl:ObjectProperty ;
    rdfs:label "Is recording of" ; # Added for P08
    rdfs:domain :Cl_AudioRecording ;
    rdfs:range :Cl_MusicalWork ;
    owl:propertyChainAxiom ( :hasRecordingInstance :isInstanceOfMusicalWork ) ;
    owl:inverseOf :hasRecording . # Added for P13

:hasRecording rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Has recording" ;
    rdfs:domain :Cl_MusicalWork ;
    rdfs:range :Cl_AudioRecording ;
    owl:inverseOf :isRecordingOf .

:hasComposition rdf:type owl:ObjectProperty ;
    rdfs:label "Has composition" ; # Added for P08
    rdfs:domain :Cl_Song ;
    rdfs:range :Cl_CompositionEvent .

:composesWorkEvent rdf:type owl:ObjectProperty ;
    rdfs:label "Composes work event" ; # Added for P08
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range :Cl_Song ;
    owl:inverseOf :hasComposition .

:performedBy rdf:type owl:ObjectProperty ;
    rdfs:label "Performed by" ; # Added for P08
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range :Cl_Composer .

:composedEventOf rdf:type owl:ObjectProperty ;
    rdfs:label "Composed event of" ; # Added for P08
    rdfs:domain :Cl_Composer ;
    rdfs:range :Cl_CompositionEvent ;
    owl:inverseOf :performedBy .

:writesReview rdf:type owl:ObjectProperty ;
    rdfs:label "Writes review" ; # Added for P08
    rdfs:domain :Cl_Critic ;
    rdfs:range :Cl_Review .

:reviewedBy rdf:type owl:ObjectProperty ;
    rdfs:label "Reviewed by" ; # Added for P08
    rdfs:domain :Cl_Review ;
    rdfs:range :Cl_Critic ;
    owl:inverseOf :writesReview ;
    rdf:type owl:FunctionalProperty .

:reviewsRecord rdf:type owl:ObjectProperty ;
    rdfs:label "Reviews record" ; # Added for P08
    rdfs:domain :Cl_Review ;
    rdfs:range :Cl_Record ;
    rdf:type owl:FunctionalProperty .

:isReviewedIn rdf:type owl:ObjectProperty ;
    rdfs:label "Is reviewed in" ; # Added for P08
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_Review ;
    owl:inverseOf :reviewsRecord .

:concernsPerformance rdf:type owl:ObjectProperty ;
    rdfs:label "Concerns performance" ; # Added for P08
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Performance .

:atLocation rdf:type owl:ObjectProperty ;
    rdfs:label "At location" ; # Added for P08
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Location ;
    rdf:type owl:FunctionalProperty .

:featuresOccurrence rdf:type owl:ObjectProperty ;
    rdfs:label "Features occurrence" ; # Added for P08
    rdfs:domain :Cl_Location ;
    rdfs:range :Cl_PerformanceOccurrence ;
    owl:inverseOf :atLocation .

:performanceRefersTo rdf:type owl:ObjectProperty ;
    rdfs:label "Performance refers to" ; # Added for P08
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Performance ;
    rdf:type owl:FunctionalProperty .

:isInstanceOfPerformance rdf:type owl:ObjectProperty ;
    rdfs:label "Is instance of performance" ; # Added for P08
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceOccurrence ;
    owl:inverseOf :performanceRefersTo .

:hasPerformanceEvent rdf:type owl:ObjectProperty ;
    rdfs:label "Has performance event" ; # Added for P08
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceSongEvent .

:referencesPerformance rdf:type owl:ObjectProperty ;
    rdfs:label "References performance" ; # Added for P08
    rdfs:domain :Cl_PerformanceSongEvent ;
    rdfs:range :Cl_Performance ;
    owl:inverseOf :hasPerformanceEvent .

:featuresSong rdf:type owl:ObjectProperty ;
    rdfs:label "Features song" ; # Added for P08
    rdfs:domain :Cl_PerformanceSongEvent ;
    rdfs:range :Cl_Song .

:isFeaturedInEvent rdf:type owl:ObjectProperty ;
    rdfs:label "Is featured in event" ; # Added for P08
    rdfs:domain :Cl_Song ;
    rdfs:range :Cl_PerformanceSongEvent ;
    owl:inverseOf :featuresSong .

:isLocatedInRegion rdf:type owl:ObjectProperty ;
    rdfs:label "Is located in region" ; # Added for P08
    rdfs:domain :Cl_City ;
    rdfs:range :Cl_Region ;
    owl:inverseOf :regionHasCity . # Added for P13

:regionHasCity rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Region has city" ;
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_City ;
    owl:inverseOf :isLocatedInRegion .

:hasPart rdf:type owl:ObjectProperty ;
    rdfs:label "Has part" ; # Added for P08
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_Location ;
    owl:inverseOf :isPartOf .

:isPartOf rdf:type owl:ObjectProperty ;
    rdfs:label "Is part of" ; # Added for P08
    rdfs:domain :Cl_Location ;
    rdfs:range :Cl_Region ;
    rdfs:subPropertyOf :isLocatedInRegion .

:hasAdministrativeDivision rdf:type owl:ObjectProperty ;
    rdfs:label "Has administrative division" ; # Added for P08
    rdfs:domain :Cl_Country ;
    rdfs:range :Cl_AdministrativeDivision .

:isAdministrativeDivisionOf rdf:type owl:ObjectProperty ;
    rdfs:label "Is administrative division of" ; # Added for P08
    rdfs:domain :Cl_AdministrativeDivision ;
    rdfs:range :Cl_Country ;
    owl:inverseOf :hasAdministrativeDivision .

:isLocatedInCountry rdf:type owl:ObjectProperty ;
    rdfs:label "Is located in country" ; # Added for P08
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_Country ;
    rdfs:subPropertyOf :isAdministrativeDivisionOf ;
    rdf:type owl:FunctionalProperty ;
    owl:inverseOf :countryHasRegion . # Added for P13

:countryHasRegion rdf:type owl:ObjectProperty ; # Added for P13
    rdfs:label "Country has region" ;
    rdfs:domain :Cl_Country ;
    rdfs:range :Cl_Region ;
    owl:inverseOf :isLocatedInCountry .

:hasTrack rdf:type owl:ObjectProperty ;
    rdfs:label "Has track" ; # Added for P08
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_Track .


#################################################################
#    Datatype Properties
#################################################################

:hasName rdf:type owl:DatatypeProperty ;
    rdfs:label "Has name" ; # Added for P08
    rdfs:domain :Cl_Entity ;
    rdfs:range xsd:string .

:playsSinceYear rdf:type owl:DatatypeProperty ;
    rdfs:label "Plays since year" ; # Added for P08
    rdfs:domain :Cl_InstrumentPlayingRelation ;
    rdfs:range xsd:gYear .

:bandName rdf:type owl:DatatypeProperty ;
    rdfs:label "Band name" ; # Added for P08
    rdfs:domain :Cl_Band ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:personName rdf:type owl:DatatypeProperty ;
    rdfs:label "Person name" ; # Added for P08
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:hasMembershipStartTime rdf:type owl:DatatypeProperty ;
    rdfs:label "Has membership start time" ; # Added for P08
    rdfs:domain :Cl_BandMembership ;
    rdfs:range xsd:dateTime ;
    rdf:type owl:FunctionalProperty .

:hasMembershipEndTime rdf:type owl:DatatypeProperty ;
    rdfs:label "Has membership end time" ; # Added for P08
    rdfs:domain :Cl_BandMembership ;
    rdfs:range xsd:dateTime ;
    rdf:type owl:FunctionalProperty .

:timeValue rdf:type owl:DatatypeProperty ;
    rdfs:label "Time value" ; # Added for P08
    rdfs:domain :Cl_TimePoint ;
    rdfs:range xsd:dateTime ;
    owl:maxCardinality 1 ;
    owl:minCardinality 1 .

:albumTitle rdf:type owl:DatatypeProperty ;
    rdfs:label "Album title" ; # Added for P08
    rdfs:domain :Cl_Album ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :hasName .

:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:label "Has start time" ; # Added for P08
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date .

:hasEndTime rdf:type owl:DatatypeProperty ;
    rdfs:label "Has end time" ; # Added for P08
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:date .

:trackTitle rdf:type owl:DatatypeProperty ;
    rdfs:label "Track title" ; # Added for P08
    rdfs:domain :Cl_Track ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :hasName .

:hasTrackNumber rdf:type owl:DatatypeProperty ;
    rdfs:label "Has track number" ; # Added for P08
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range xsd:integer .

:hasReleaseDate rdf:type owl:DatatypeProperty ;
    rdfs:label "Has release date" ; # Added for P08
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range xsd:date ;
    rdf:type owl:FunctionalProperty .

:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:label "Has title" ; # Added for P08
    rdfs:domain :Cl_CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :hasName .

:hasDurationSeconds rdf:type owl:DatatypeProperty ;
    rdfs:label "Has duration seconds" ; # Added for P08
    rdfs:domain :Cl_AudioRecording ;
    rdfs:range xsd:integer .

:songTitle rdf:type owl:DatatypeProperty ;
    rdfs:label "Song title" ; # Added for P08
    rdfs:domain :Cl_Song ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :hasName .

:compositionDate rdf:type owl:DatatypeProperty ;
    rdfs:label "Composition date" ; # Added for P08
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range xsd:date .

:composerName rdf:type owl:DatatypeProperty ;
    rdfs:label "Composer name" ; # Added for P08
    rdfs:domain :Cl_Composer ;
    rdfs:range xsd:string .

:criticName rdf:type owl:DatatypeProperty ;
    rdfs:label "Critic name" ; # Added for P08
    rdfs:domain :Cl_Critic ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:criticAffiliation rdf:type owl:DatatypeProperty ;
    rdfs:label "Critic affiliation" ; # Added for P08
    rdfs:domain :Cl_Critic ;
    rdfs:range xsd:string .

:recordArtist rdf:type owl:DatatypeProperty ;
    rdfs:label "Record artist" ; # Added for P08
    rdfs:domain :Cl_Record ;
    rdfs:range xsd:string .

:reviewContent rdf:type owl:DatatypeProperty ;
    rdfs:label "Review content" ; # Added for P08
    rdfs:domain :Cl_Review ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:reviewRating rdf:type owl:DatatypeProperty ;
    rdfs:label "Review rating" ; # Added for P08
    rdfs:domain :Cl_Review ;
    rdfs:range xsd:decimal ;
    rdf:type owl:FunctionalProperty .

:reviewDate rdf:type owl:DatatypeProperty ;
    rdfs:label "Review date" ; # Added for P08
    rdfs:domain :Cl_Review ;
    rdfs:range xsd:date ;
    rdf:type owl:FunctionalProperty .

:hasDate rdf:type owl:DatatypeProperty ;
    rdfs:label "Has date" ; # Added for P08
    rdfs:domain :Cl_Event ;
    rdfs:range xsd:date .

:performanceName rdf:type owl:DatatypeProperty ;
    rdfs:label "Performance name" ; # Added for P08
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:locationName rdf:type owl:DatatypeProperty ;
    rdfs:label "Location name" ; # Added for P08
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:locationAddress rdf:type owl:DatatypeProperty ;
    rdfs:label "Location address" ; # Added for P08
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty .

:occurrenceDateTime rdf:type owl:DatatypeProperty ;
    rdfs:label "Occurrence date time" ; # Added for P08
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range xsd:dateTime ;
    rdf:type owl:FunctionalProperty .

:hasCityName rdf:type owl:DatatypeProperty ;
    rdfs:label "Has city name" ; # Added for P08
    rdfs:domain :Cl_City ;
    rdfs:range xsd:string .

:hasRegionName rdf:type owl:DatatypeProperty ;
    rdfs:label "Has region name" ; # Added for P08
    rdfs:domain :Cl_Region ;
    rdfs:range xsd:string .

:hasCode rdf:type owl:DatatypeProperty ;
    rdfs:label "Has code" ; # Added for P08
    rdfs:domain :Cl_AdministrativeDivision ;
    rdfs:range xsd:string .


#################################################################
#    Axioms
#################################################################

:Cl_InstrumentPlayingRelation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasPlayer ;
    owl:someValuesFrom :Cl_Person
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInstrument ;
    owl:someValuesFrom :Cl_MusicalInstrument
] .

:Cl_Musician owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Person
        [ rdf:type owl:Restriction ;
          owl:onProperty :playsInstrumentRelation ;
          owl:someValuesFrom :Cl_InstrumentPlayingRelation
        ]
    )
] .

:Cl_Person rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:someValuesFrom xsd:string
] .

:Cl_MusicalInstrument rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:someValuesFrom xsd:string
] .

owl:AllDisjointClasses rdf:type owl:AllDisjointClasses ;
    owl:members ( :Cl_StringInstrument :Cl_WindInstrument :Cl_PercussionInstrument :Cl_KeyboardInstrument :Cl_ElectronicInstrument ) .

:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesPerson ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :forBand ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMembershipStartTime ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Band rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMembershipEvent ;
    owl:someValuesFrom :Cl_BandMembership
] .

:Cl_Person rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasBandMembership ;
    owl:someValuesFrom :Cl_BandMembership
] .

:Cl_BandRoleAssignment rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :roleAssignedToPerson ;
      owl:someValuesFrom :Cl_Person
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :roleInBand ;
      owl:someValuesFrom :Cl_Band
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasRole ;
      owl:someValuesFrom :Cl_Role
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :atTimePoint ;
      owl:someValuesFrom :Cl_TimePoint
    ] .

:Cl_RecordingEvent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Event
        [ rdf:type owl:Restriction ;
          owl:onProperty :recordedAlbum ;
          owl:someValuesFrom :Cl_Album
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :occursDuring ;
          owl:someValuesFrom :Cl_TimePeriod
        ]
    )
] .

:Cl_Album rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :includesTrackPlacement ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_AlbumTrackInclusion
] .

:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isPlacementForTrack ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Track
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :relatesToAlbum ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Album
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTrackNumber ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:integer
] .

:Cl_Album rdfs:subClassOf [ # Changed from owl:equivalentClass to rdfs:subClassOf for P24
    rdf:type owl:Restriction ;
    owl:onProperty :hasReleaseEvent ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_ReleaseEvent rdfs:subClassOf [ # Changed from owl:equivalentClass to rdfs:subClassOf for P24
    rdf:type owl:Restriction ;
    owl:onProperty :concernsAlbum ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [ # Added as a separate rdfs:subClassOf axiom for P24
    rdf:type owl:Restriction ;
    owl:onProperty :hasReleaseDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_AudioRecording rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasRecordingInstance ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_RecordingInstance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isInstanceOfMusicalWork ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_AudioRecording rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isRecordingOf ;
    owl:someValuesFrom :Cl_MusicalWork
] .

:Cl_Song rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasComposition ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_CompositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :composesWorkEvent ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :compositionDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :performedBy ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_CreativeWork owl:disjointWith :Cl_Event .
:Cl_CreativeWork owl:disjointWith :Cl_Agent .
:Cl_Event owl:disjointWith :Cl_Agent .

:Cl_Review rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :reviewedBy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :reviewsRecord ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :reviewContent ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Cl_Critic rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :criticName ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Cl_Record rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :albumTitle ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Cl_PerformanceOccurrence owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Occurrence
        [ rdf:type owl:Restriction ;
          owl:onProperty :performanceRefersTo ;
          owl:someValuesFrom :Cl_Performance ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :occurrenceDateTime ;
          owl:someValuesFrom xsd:dateTime ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :atLocation ;
          owl:someValuesFrom :Cl_Location ]
    )
] .

:Cl_PerformanceOccurrence rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :performanceRefersTo ;
    owl:cardinality 1
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :occurrenceDateTime ;
    owl:cardinality 1
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :atLocation ;
    owl:cardinality 1
] .

:Cl_Performance owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasPerformanceEvent ;
    owl:someValuesFrom :Cl_PerformanceSongEvent
] .

:Cl_Song owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :isFeaturedInEvent ;
    owl:someValuesFrom :Cl_PerformanceSongEvent
] .

:Cl_PerformanceSongEvent owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Relation
        [ rdf:type owl:Restriction ;
          owl:onProperty :referencesPerformance ;
          owl:allValuesFrom :Cl_Performance
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :featuresSong ;
          owl:allValuesFrom :Cl_Song
        ]
    )
] .

owl:AllDisjointClasses rdf:type owl:AllDisjointClasses ;
    owl:members ( :Cl_Concert :Cl_Play :Cl_DancePerformance ) .

owl:AllDisjointClasses rdf:type owl:AllDisjointClasses ;
    owl:members ( :Cl_Theatre :Cl_ConcertHall ) .

:Cl_PopulatedPlace owl:disjointWith :Cl_Region .

:Cl_Region rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedInCountry ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Country
] .

:Cl_Country rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Region rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasName ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Record rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTrack ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .