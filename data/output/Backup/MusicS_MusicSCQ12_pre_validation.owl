@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology Declaration
:performanceOntology a owl:Ontology ;
    rdfs:comment "Ontology for representing performances and their locations, structured to answer 'Where did a certain performance take place?' using reification." ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# ---------------------------------------------------
# Classes
# ---------------------------------------------------

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class for anything in the ontology." .

:Cl_Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general class for any happening or occurrence." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A type of event involving action or performance." ;
    rdfs:subClassOf :Cl_Event .

:Cl_Performance a owl:Class ;
    rdfs:label "Performance" ;
    rdfs:comment "A class representing an artistic or public presentation, e.g., a concert, play, or dance." ;
    rdfs:subClassOf :Cl_Activity .

:Cl_Concert a owl:Class ;
    rdfs:label "Concert" ;
    rdfs:comment "A live musical performance." ;
    rdfs:subClassOf :Cl_Performance .

:Cl_Play a owl:Class ;
    rdfs:label "Play" ;
    rdfs:comment "A theatrical performance." ;
    rdfs:subClassOf :Cl_Performance .

:Cl_DancePerformance a owl:Class ;
    rdfs:label "Dance Performance" ;
    rdfs:comment "A performance featuring dance." ;
    rdfs:subClassOf :Cl_Performance .

:Cl_Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A general class for any physical location." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A class representing a physical place or venue where events can occur." ;
    rdfs:subClassOf :Cl_Place .

:Cl_Venue a owl:Class ;
    rdfs:label "Venue" ;
    rdfs:comment "A place where a public event or meeting is held." ;
    rdfs:subClassOf :Cl_Location .

:Cl_Theatre a owl:Class ;
    rdfs:label "Theatre" ;
    rdfs:comment "A building or outdoor area in which plays and other dramatic performances are given." ;
    rdfs:subClassOf :Cl_Venue .

:Cl_ConcertHall a owl:Class ;
    rdfs:label "Concert Hall" ;
    rdfs:comment "A building or part of a building specifically designed for musical concerts." ;
    rdfs:subClassOf :Cl_Venue .

:Cl_OutdoorVenue a owl:Class ;
    rdfs:label "Outdoor Venue" ;
    rdfs:comment "A venue situated outdoors." ;
    rdfs:subClassOf :Cl_Location .

# Pivot Class for reification: Cl_PerformanceOccurrence
# This class acts as an intermediary for the "performance took place at location" relationship.
:Cl_PerformanceOccurrence a owl:Class ;
    rdfs:label "Performance Occurrence" ;
    rdfs:comment "Represents a specific instance of a performance happening at a particular location and potentially at a specific time. This reifies the 'takes place' action, allowing for additional details about the event itself." ;
    rdfs:subClassOf :Cl_Event .

# General Class Axioms / Restrictions for Cl_PerformanceOccurrence
# Every Performance Occurrence must be associated with a Performance
:Cl_PerformanceOccurrence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :op_hasPerformance ;
    owl:someValuesFrom :Cl_Performance ;
    rdfs:comment "Ensures every Cl_PerformanceOccurrence is linked to at least one Cl_Performance."
] .

# Every Performance Occurrence must be associated with a Location
:Cl_PerformanceOccurrence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :op_atLocation ;
    owl:someValuesFrom :Cl_Location ;
    rdfs:comment "Ensures every Cl_PerformanceOccurrence is linked to at least one Cl_Location."
] .

# Disjointness axioms for classes
:Cl_Concert owl:disjointWith :Cl_Play .
:Cl_Concert owl:disjointWith :Cl_DancePerformance .
:Cl_Play owl:disjointWith :Cl_DancePerformance .
:Cl_Theatre owl:disjointWith :Cl_ConcertHall .

# ---------------------------------------------------
# Properties
# ---------------------------------------------------

# Object Properties

:op_hasPerformance a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has performance" ;
    rdfs:comment "Connects a Performance Occurrence to the specific Performance (the work/concept) that was presented." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Performance .

:op_atLocation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "at location" ;
    rdfs:comment "Connects a Performance Occurrence to the Location (venue) where it took place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range :Cl_Location .

# Inverse Property for op_atLocation
:op_featuresOccurrence a owl:ObjectProperty ;
    rdfs:label "features occurrence" ;
    rdfs:comment "Connects a Location to a Performance Occurrence that happened there." ;
    rdfs:domain :Cl_Location ;
    rdfs:range :Cl_PerformanceOccurrence ;
    owl:inverseOf :op_atLocation .

# Inverse Property for op_hasPerformance
:op_isInstanceOfPerformance a owl:ObjectProperty ;
    rdfs:label "is instance of performance" ;
    rdfs:comment "Connects a Performance (the conceptual work) to the specific Performance Occurrence instances (its showings) it has." ;
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceOccurrence ;
    owl:inverseOf :op_hasPerformance .

# Data Properties

:dp_performanceName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "performance name" ;
    rdfs:comment "The official name or title of the performance." ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:string .

:dp_locationName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "location name" ;
    rdfs:comment "The common name of the location or venue." ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:dp_locationAddress a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "location address" ;
    rdfs:comment "The physical address of the location or venue." ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:dp_occurrenceDateTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "occurrence date and time" ;
    rdfs:comment "The specific date and time when this particular performance occurrence took place." ;
    rdfs:domain :Cl_PerformanceOccurrence ;
    rdfs:range xsd:dateTime .
