@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/hospital_story>
    a owl:Ontology ;
    rdfs:label "Hospital Story Ontology" ;
    rdfs:comment "Ontology modeling entities and events from a hospital scenario for answering competency questions about staff, unions, evaluations, publications, and seminars." .

### Classes
:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, including doctors, nurses, assistants, and employees." .

:Doctor a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Doctor" ;
    rdfs:comment "A medical doctor working at a hospital." .

:Nurse a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Nurse" ;
    rdfs:comment "A certified nurse working at a hospital." .

:NursingAssistant a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Nursing Assistant" ;
    rdfs:comment "A nursing assistant working at a hospital." .

:Employee a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Employee" ;
    rdfs:comment "Any person employed at a hospital." .

:Degree a owl:Class ;
    rdfs:label "Degree" ;
    rdfs:comment "A formal qualification awarded to a person." .

:StudyPeriod a owl:Class ;
    rdfs:label "Study Period" ;
    rdfs:comment "A period during which a person studies for a degree (pivot/reification class)." .

:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:comment "A healthcare institution where staff are employed and seminars held." .

:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A city in which a hospital is located." .

:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country in which a city is located." .

:Employment a owl:Class ;
    rdfs:label "Employment" ;
    rdfs:comment "A period of employment for a person at a hospital (pivot/reification class)." .

:Union a owl:Class ;
    rdfs:label "Union" ;
    rdfs:comment "A staff union organizing employees at a hospital." .

:UnionMembership a owl:Class ;
    rdfs:label "Union Membership" ;
    rdfs:comment "A person's membership in a union at a hospital (pivot/reification class)." .

:UnionRole a owl:Class ;
    rdfs:label "Union Role" ;
    rdfs:comment "A role held by a person within a union (pivot/reification class)." .

:Evaluation a owl:Class ;
    rdfs:label "Evaluation" ;
    rdfs:comment "A written evaluation by a doctor for an employee (pivot/reification class)." .

:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A research article written by staff and included in collections." .

:ArticleCollection a owl:Class ;
    rdfs:label "Article Collection" ;
    rdfs:comment "A collection of research articles, available as books or CDs." .

:Book a owl:Class ;
    rdfs:subClassOf :ArticleCollection ;
    rdfs:label "Book" ;
    rdfs:comment "A book version of an article collection." .

:CD a owl:Class ;
    rdfs:subClassOf :ArticleCollection ;
    rdfs:label "CD" ;
    rdfs:comment "A CD version of an article collection." .

:Seminar a owl:Class ;
    rdfs:label "Seminar" ;
    rdfs:comment "A seminar held at a hospital for presenting articles." .

:SeminarPresentation a owl:Class ;
    rdfs:label "Seminar Presentation" ;
    rdfs:comment "A presentation of an article at a seminar (pivot/reification class)." .

### Disjointness
:Doctor owl:disjointWith :Nurse, :NursingAssistant .
:Nurse owl:disjointWith :NursingAssistant .

### Object Properties and Inverses
:hasDegree a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has degree" ;
    rdfs:comment "Relates a person to a degree they have obtained." ;
    rdfs:domain :Person ;
    rdfs:range :Degree ;
    owl:inverseOf :degreeOf .
:degreeOf a owl:ObjectProperty ;
    rdfs:label "degree of" ;
    rdfs:comment "Inverse: Relates a degree to the person who has it." ;
    rdfs:domain :Degree ;
    rdfs:range :Person ;
    owl:inverseOf :hasDegree .

:studiedFor a owl:ObjectProperty ;
    rdfs:label "studied for" ;
    rdfs:comment "Relates a study period to the degree studied for." ;
    rdfs:domain :StudyPeriod ;
    rdfs:range :Degree ;
    owl:inverseOf :degreeStudiedDuring .
:degreeStudiedDuring a owl:ObjectProperty ;
    rdfs:label "degree studied during" ;
    rdfs:comment "Inverse: Relates a degree to study periods." ;
    rdfs:domain :Degree ;
    rdfs:range :StudyPeriod ;
    owl:inverseOf :studiedFor .

:hasStudyPeriod a owl:ObjectProperty ;
    rdfs:label "has study period" ;
    rdfs:comment "Relates a person to a period of study." ;
    rdfs:domain :Person ;
    rdfs:range :StudyPeriod ;
    owl:inverseOf :studyPeriodOf .
:studyPeriodOf a owl:ObjectProperty ;
    rdfs:label "study period of" ;
    rdfs:comment "Inverse: Relates a study period to the person." ;
    rdfs:domain :StudyPeriod ;
    rdfs:range :Person ;
    owl:inverseOf :hasStudyPeriod .

:employedAt a owl:ObjectProperty ;
    rdfs:label "employed at" ;
    rdfs:comment "Relates an employment event to a hospital." ;
    rdfs:domain :Employment ;
    rdfs:range :Hospital ;
    owl:inverseOf :employmentEvent .
:employmentEvent a owl:ObjectProperty ;
    rdfs:label "employment event" ;
    rdfs:comment "Inverse: Relates a hospital to employment events." ;
    rdfs:domain :Hospital ;
    rdfs:range :Employment ;
    owl:inverseOf :employedAt .

:hasEmployment a owl:ObjectProperty ;
    rdfs:label "has employment" ;
    rdfs:comment "Relates a person to an employment event." ;
    rdfs:domain :Person ;
    rdfs:range :Employment ;
    owl:inverseOf :employmentOf .
:employmentOf a owl:ObjectProperty ;
    rdfs:label "employment of" ;
    rdfs:comment "Inverse: Relates an employment event to the person." ;
    rdfs:domain :Employment ;
    rdfs:range :Person ;
    owl:inverseOf :hasEmployment .

:hospitalLocatedIn a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "hospital located in" ;
    rdfs:comment "Relates a hospital to the city it is located in." ;
    rdfs:domain :Hospital ;
    rdfs:range :City ;
    owl:inverseOf :cityHasHospital .
:cityHasHospital a owl:ObjectProperty ;
    rdfs:label "city has hospital" ;
    rdfs:comment "Inverse: Relates a city to hospitals located in it." ;
    rdfs:domain :City ;
    rdfs:range :Hospital ;
    owl:inverseOf :hospitalLocatedIn .

:cityInCountry a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "city in country" ;
    rdfs:comment "Relates a city to the country it is in." ;
    rdfs:domain :City ;
    rdfs:range :Country ;
    owl:inverseOf :countryHasCity .
:countryHasCity a owl:ObjectProperty ;
    rdfs:label "country has city" ;
    rdfs:comment "Inverse: Relates a country to its cities." ;
    rdfs:domain :Country ;
    rdfs:range :City ;
    owl:inverseOf :cityInCountry .

:hasUnionMembership a owl:ObjectProperty ;
    rdfs:label "has union membership" ;
    rdfs:comment "Relates a person to a union membership event." ;
    rdfs:domain :Person ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionMembershipOf .
:unionMembershipOf a owl:ObjectProperty ;
    rdfs:label "union membership of" ;
    rdfs:comment "Inverse: Relates a union membership to the person." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Person ;
    owl:inverseOf :hasUnionMembership .

:membershipInUnion a owl:ObjectProperty ;
    rdfs:label "membership in union" ;
    rdfs:comment "Relates a union membership event to a union." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :Union ;
    owl:inverseOf :unionHasMembership .
:unionHasMembership a owl:ObjectProperty ;
    rdfs:label "union has membership" ;
    rdfs:comment "Inverse: Relates a union to its memberships." ;
    rdfs:domain :Union ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :membershipInUnion .

:unionRoleHeld a owl:ObjectProperty ;
    rdfs:label "union role held" ;
    rdfs:comment "Relates a union role event to a union." ;
    rdfs:domain :UnionRole ;
    rdfs:range :Union ;
    owl:inverseOf :unionHasRole .
:unionHasRole a owl:ObjectProperty ;
    rdfs:label "union has role" ;
    rdfs:comment "Inverse: Relates a union to its roles." ;
    rdfs:domain :Union ;
    rdfs:range :UnionRole ;
    owl:inverseOf :unionRoleHeld .

:roleHeldBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "role held by" ;
    rdfs:comment "Relates a union role event to the person holding the role." ;
    rdfs:domain :UnionRole ;
    rdfs:range :Person ;
    owl:inverseOf :personHoldsRole .
:personHoldsRole a owl:ObjectProperty ;
    rdfs:label "person holds role" ;
    rdfs:comment "Inverse: Relates a person to union roles they hold." ;
    rdfs:domain :Person ;
    rdfs:range :UnionRole ;
    owl:inverseOf :roleHeldBy .

:roleHeldDuring a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "role held during" ;
    rdfs:comment "Relates a union role event to a union membership." ;
    rdfs:domain :UnionRole ;
    rdfs:range :UnionMembership ;
    owl:inverseOf :unionMembershipHasRole .
:unionMembershipHasRole a owl:ObjectProperty ;
    rdfs:label "union membership has role" ;
    rdfs:comment "Inverse: Relates a union membership to union roles held during it." ;
    rdfs:domain :UnionMembership ;
    rdfs:range :UnionRole ;
    owl:inverseOf :roleHeldDuring .

:evaluatedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "evaluated by" ;
    rdfs:comment "Relates an evaluation event to the doctor who performed it." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Doctor ;
    owl:inverseOf :performedEvaluation .
:performedEvaluation a owl:ObjectProperty ;
    rdfs:label "performed evaluation" ;
    rdfs:comment "Inverse: Relates a doctor to evaluations they performed." ;
    rdfs:domain :Doctor ;
    rdfs:range :Evaluation ;
    owl:inverseOf :evaluatedBy .

:evaluationFor a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "evaluation for" ;
    rdfs:comment "Relates an evaluation event to the employee being evaluated." ;
    rdfs:domain :Evaluation ;
    rdfs:range :Employee ;
    owl:inverseOf :hasEvaluation .
:hasEvaluation a owl:ObjectProperty ;
    rdfs:label "has evaluation" ;
    rdfs:comment "Relates an employee to an evaluation event." ;
    rdfs:domain :Employee ;
    rdfs:range :Evaluation ;
    owl:inverseOf :evaluationFor .

:containsArticle a owl:ObjectProperty ;
    rdfs:label "contains article" ;
    rdfs:comment "Relates an article collection to an article it contains." ;
    rdfs:domain :ArticleCollection ;
    rdfs:range :Article ;
    owl:inverseOf :articleInCollection .
:articleInCollection a owl:ObjectProperty ;
    rdfs:label "article in collection" ;
    rdfs:comment "Inverse: Relates an article to article collections it is in." ;
    rdfs:domain :Article ;
    rdfs:range :ArticleCollection ;
    owl:inverseOf :containsArticle .

:presentedInSeminar a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "presented in seminar" ;
    rdfs:comment "Relates a seminar presentation to the seminar." ;
    rdfs:domain :SeminarPresentation ;
    rdfs:range :Seminar ;
    owl:inverseOf :seminarHasPresentation .
:seminarHasPresentation a owl:ObjectProperty ;
    rdfs:label "seminar has presentation" ;
    rdfs:comment "Inverse: Relates a seminar to its presentations." ;
    rdfs:domain :Seminar ;
    rdfs:range :SeminarPresentation ;
    owl:inverseOf :presentedInSeminar .

:presentationOfArticle a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "presentation of article" ;
    rdfs:comment "Relates a seminar presentation to the article presented." ;
    rdfs:domain :SeminarPresentation ;
    rdfs:range :Article ;
    owl:inverseOf :articlePresentedIn .
:articlePresentedIn a owl:ObjectProperty ;
    rdfs:label "article presented in" ;
    rdfs:comment "Inverse: Relates an article to seminar presentations where it was presented." ;
    rdfs:domain :Article ;
    rdfs:range :SeminarPresentation ;
    owl:inverseOf :presentationOfArticle .

:seminarHeldAt a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "seminar held at" ;
    rdfs:comment "Relates a seminar to the hospital where it is held." ;
    rdfs:domain :Seminar ;
    rdfs:range :Hospital ;
    owl:inverseOf :hospitalHasSeminar .
:hospitalHasSeminar a owl:ObjectProperty ;
    rdfs:label "hospital has seminar" ;
    rdfs:comment "Inverse: Relates a hospital to seminars held there." ;
    rdfs:domain :Hospital ;
    rdfs:range :Seminar ;
    owl:inverseOf :seminarHeldAt .

### Data Properties
:degreeAwardedDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "degree awarded date" ;
    rdfs:comment "The date a degree was awarded." ;
    rdfs:domain :Degree ;
    rdfs:range xsd:dateTime .

:studyStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "study start date" ;
    rdfs:comment "The start date of a study period." ;
    rdfs:domain :StudyPeriod ;
    rdfs:range xsd:dateTime .

:studyEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "study end date" ;
    rdfs:comment "The end date of a study period." ;
    rdfs:domain :StudyPeriod ;
    rdfs:range xsd:dateTime .

:employmentStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "employment start date" ;
    rdfs:comment "The start date of an employment event." ;
    rdfs:domain :Employment ;
    rdfs:range xsd:dateTime .

:unionMembershipStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "union membership start date" ;
    rdfs:comment "The start date of a union membership event." ;
    rdfs:domain :UnionMembership ;
    rdfs:range xsd:dateTime .

:unionMembershipEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "union membership end date" ;
    rdfs:comment "The end date of a union membership event." ;
    rdfs:domain :UnionMembership ;
    rdfs:range xsd:dateTime .

:unionRoleStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "union role start date" ;
    rdfs:comment "The start date of a union role event." ;
    rdfs:domain :UnionRole ;
    rdfs:range xsd:dateTime .

:unionRoleEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "union role end date" ;
    rdfs:comment "The end date of a union role event." ;
    rdfs:domain :UnionRole ;
    rdfs:range xsd:dateTime .

:evaluationText a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "evaluation text" ;
    rdfs:comment "The text of an evaluation statement." ;
    rdfs:domain :Evaluation ;
    rdfs:range xsd:string .

:bookPageCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "book page count" ;
    rdfs:comment "The number of pages in a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:integer .

:publicationDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "publication date" ;
    rdfs:comment "The publication date of a book." ;
    rdfs:domain :Book ;
    rdfs:range xsd:dateTime .

:publicationDateCD a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "publication date CD" ;
    rdfs:comment "The publication date of a CD." ;
    rdfs:domain :CD ;
    rdfs:range xsd:dateTime .

:seminarDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "seminar date" ;
    rdfs:comment "The date a seminar was held." ;
    rdfs:domain :Seminar ;
    rdfs:range xsd:dateTime .

### General Class Axioms & Restrictions
:Seminar rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :presentedInSeminar ; owl:someValuesFrom :SeminarPresentation ] .
# This restriction ensures at least one SeminarPresentation per Seminar (CQ15)
