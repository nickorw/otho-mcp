@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Classes

:Cl_Item rdf:type owl:Class ;
    rdfs:label "Item" .

:Cl_Sale rdf:type owl:Class ;
    rdfs:label "Sale" .

:Cl_ItemInformation rdf:type owl:Class ;
    rdfs:label "Item Information" .

:Cl_DisplayInformation rdf:type owl:Class ;
    rdfs:label "Display Information" .

# Hierarchy: Information as superclass
:Cl_Information rdf:type owl:Class ;
    rdfs:label "Information" .

:Cl_ItemInformation rdfs:subClassOf :Cl_Information .
:Cl_DisplayInformation rdfs:subClassOf :Cl_Information .

### Reification / Pivot class for Displaying Item Information

:Cl_ItemDisplay rdf:type owl:Class ;
    rdfs:label "Item Display" .

### Disjointness
:Cl_Item owl:disjointWith :Cl_Information .
:Cl_Sale owl:disjointWith :Cl_Information .

### Properties

# Object Properties

:hasItem rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplay ;
    rdfs:range :Cl_Item ;
    rdfs:label "has item" .

:displaysInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplay ;
    rdfs:range :Cl_DisplayInformation ;
    rdfs:label "displays information" .

:hasDisplay rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemDisplay ;
    rdfs:label "has display" .

# Data Properties for Item Information

:itemName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item name" .

:itemDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item description" .

:itemPrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price" .

:itemCategory rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item category" .

:itemSKU rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:string ;
    rdfs:label "item SKU" .

:itemImageURL rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range xsd:anyURI ;
    rdfs:label "item image URL" .

# Data Properties for Display Information

:displayedField rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range xsd:string ;
    rdfs:label "displayed field" .

:displayOrder rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range xsd:integer ;
    rdfs:label "display order" .

:displayFormat rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayInformation ;
    rdfs:range xsd:string ;
    rdfs:label "display format" .

### Relations between Item and Item Information

:hasItemInformation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemInformation ;
    rdfs:label "has item information" .

### Example Restriction: All displaysInformation must refer to Cl_DisplayInformation
:Cl_ItemDisplay rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :displaysInformation ;
    owl:allValuesFrom :Cl_DisplayInformation
] .

### General Class Axiom: If something hasItemInformation, it is an Item
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasItemInformation ;
    owl:someValuesFrom :Cl_ItemInformation ;
    rdfs:subClassOf :Cl_Item
] .

### Disjoint Union of Information subclasses
:Cl_Information owl:disjointUnionOf ( :Cl_ItemInformation :Cl_DisplayInformation ) .
