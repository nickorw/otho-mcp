 to business process</rdfs:label>    <rdfs:comment>Links an invoice message to a business process.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>An EDIFACT invoice message (INVOIC).</rdfs:comment>    <owl:equivalentClass rdf:nodeID="n0e78cf2281834413aa9f97a1ffe9f51bb1"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>Links a line item to its quantity.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Quantity"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has detail</rdfs:label>    <rdfs:comment>Links an invoice message to its detail section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#DetailSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#forOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>f