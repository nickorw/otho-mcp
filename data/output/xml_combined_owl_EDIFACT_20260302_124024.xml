"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology/edifact-invoic-ontology">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT INVOIC Ontology</rdfs:label>    <rdfs:comment>A deeply structured ontology for UN/EDIFACT D96A INVOIC messages, roles, and validation, supporting EN 16931-1 and P2P-O alignment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#describesItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>describes item</rdfs:label>    <rdfs:comment>Links a line item to the item it describes.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#ValidationConstraint">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Validation Constraint</rdfs:label>    <rdfs:comment>A constraint for validating invoice content (e.g., SHACL rule).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service listed in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>A line item in the invoice, referencing an item, quantity, and price.</rdfs:comment>    <owl:equivalentClass rdf:nodeID="n0e78cf2281834413aa9f97a1ffe9f51bb14"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#GlobalLocationNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:label>Global Location Number</rdfs:label>    <rdfs:comment>A unique identifier for organizations as per GS1 standards.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Links a detail section to its line items.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasMandatoryIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has mandatory identifier</rdfs:label>    <rdfs:comment>Links an invoice message to a mandatory identifier for compliance validation.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Identifier"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has role assignment</rdfs:label>    <rdfs:comment>Links an invoice message to a role assignment (pivot class).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#RoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n0e78cf2281834413aa9f97a1ffe9f51bb16">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasNetPrice"/>    <owl:s