://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Section"/>    <rdfs:label>Header Section</rdfs:label>    <rdfs:comment>Section containing document dates, reference numbers, and invoice metadata.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The top-level envelope containing one or more EDIFACT messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice number</rdfs:label>    <rdfs:comment>Links a header section to the invoice number.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceNumber"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>Links a line item to its net price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has header</rdfs:label>    <rdfs:comment>Links an invoice message to its header section.</rdfs:comment>    <rdfs:domain rd