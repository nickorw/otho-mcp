@prefix : <http://example.org/music-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Classes
#################################################################

:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class representing anything in the domain." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Person" ;
    rdfs:comment "Represents an individual person." .

:Cl_Instrument rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Instrument" ;
    rdfs:comment "Represents a musical instrument." .

:Cl_Activity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Activity" ;
    rdfs:comment "A general class for activities or events, serving as a superclass for reified relationships or actions." .

:Cl_MusicalProficiency rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Activity ;
    rdfs:label "Musical Proficiency" ;
    rdfs:comment "A reification class representing a person's skill or proficiency in playing a specific musical instrument. This pivot class captures the complex relationship involving a person (entity), an instrument (entity), and a skill level (datatype)." .

#################################################################
#    Disjoint Classes
#################################################################

:Cl_Person owl:disjointWith :Cl_Instrument, :Cl_Activity .
:Cl_Instrument owl:disjointWith :Cl_Activity .

#################################################################
#    Object Properties
#################################################################

:hasProficiency rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_MusicalProficiency ;
    rdfs:label "has proficiency" ;
    rdfs:comment "Connects a person to an instance of their musical proficiency in an instrument." .

:isProficiencyOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasProficiency ;
    rdfs:domain :Cl_MusicalProficiency ;
    rdfs:range :Cl_Person ;
    owl:functional true ; # Each MusicalProficiency instance is related to exactly one Person
    rdfs:label "is proficiency of" ;
    rdfs:comment "The inverse of 'hasProficiency', connecting a musical proficiency instance back to the person who possesses it." .

:skillForInstrument rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_MusicalProficiency ;
    rdfs:range :Cl_Instrument ;
    owl:functional true ; # Each MusicalProficiency instance is for exactly one Instrument
    rdfs:label "skill for instrument" ;
    rdfs:comment "Connects a musical proficiency instance to the specific instrument it pertains to." .

:isInstrumentOfSkill rdf:type owl:ObjectProperty ;
    owl:inverseOf :skillForInstrument ;
    rdfs:domain :Cl_Instrument ;
    rdfs:range :Cl_MusicalProficiency ;
    rdfs:label "is instrument of skill" ;
    rdfs:comment "The inverse of 'skillForInstrument', connecting an instrument to a musical proficiency instance related to it." .

#################################################################
#    Data Properties
#################################################################

:personName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    owl:functional true ; # A person has exactly one name
    rdfs:label "person name" ;
    rdfs:comment "The name of a person." .

:instrumentName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Instrument ;
    rdfs:range xsd:string ;
    owl:functional true ; # An instrument has exactly one name
    rdfs:label "instrument name" ;
    rdfs:comment "The name of a musical instrument." .

:hasSkillLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_MusicalProficiency ;
    rdfs:range xsd:string ;
    owl:functional true ; # Each MusicalProficiency instance has exactly one skill level
    rdfs:label "has skill level" ;
    rdfs:comment "The level of skill a person has with a particular instrument (e.g., 'Beginner', 'Intermediate', 'Expert')." .

#################################################################
#    Restrictions / Axioms
#################################################################

# Every MusicalProficiency instance must be related to exactly one Person.
:Cl_MusicalProficiency rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isProficiencyOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every instance of MusicalProficiency is linked to exactly one Person."
] .

# Every MusicalProficiency instance must be for exactly one Instrument.
:Cl_MusicalProficiency rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :skillForInstrument ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every instance of MusicalProficiency is associated with exactly one Instrument."
] .

# Every MusicalProficiency instance must have exactly one defined skill level.
:Cl_MusicalProficiency rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasSkillLevel ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Ensures that every instance of MusicalProficiency has exactly one defined skill level."
] .

# A Person, if described in terms of musical abilities, can have one or more musical proficiencies.
:Cl_Person rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasProficiency ;
    owl:someValuesFrom :Cl_MusicalProficiency ;
    rdfs:comment "Specifies that a Person can have at least one musical proficiency recorded, if they have any."
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology Metadata
:ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for modeling band memberships at specific points in time, addressing the competency question: 'What are the members of a certain band at a certain point in time?'" ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# Classes
# Top-level entity class
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "The most general class, representing any entity in the domain." .

# Hierarchies for Agent/Person
:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents any agent, living or otherwise, capable of action." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents a human individual." .

# Hierarchies for Organizations/Groups
:Cl_Organization rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a structured group of people." .

:Cl_MusicalGroup rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "Represents any group formed for musical performance." .

:Cl_Band rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalGroup ;
    rdfs:comment "Represents a specific type of musical group, typically playing contemporary music." .

# Class for Time Points
:Cl_TimePoint rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a specific, instantaneous point in time." .

# Reification Class: Cl_Membership
:Cl_Membership rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A pivot class representing the specific event or state of a person being a member of a band at a particular point in time." .

# Properties

# Data Properties
:hasName rdf:type owl:DatatypeProperty ;
    rdfs:comment "A general property for the name of an entity." .

:bandName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Band ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "The official name of the band." .

:personName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "The full name of the person." .

:dateTimeValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePoint ;
    rdfs:range xsd:dateTime ;
    rdf:type owl:FunctionalProperty ;
    rdfs:comment "The precise date and time value for a Cl_TimePoint instance." .

# Object Properties (for Reification)
:hasMembershipEntry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Band ;
    rdfs:range :Cl_Membership ;
    rdfs:comment "Links a band to its individual membership entries." .

:memberOfBandEntry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_Band ;
    owl:inverseOf :hasMembershipEntry ;
    rdfs:comment "Links a membership entry to the band it pertains to." .

:memberIsPerson rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Links a membership entry to the specific person who is the member." .

:personIsMemberOfEntry rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_Membership ;
    owl:inverseOf :memberIsPerson ;
    rdfs:comment "Links a person to the membership entries they are part of." .

:membershipValidAtTime rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Membership ;
    rdfs:range :Cl_TimePoint ;
    rdfs:comment "Links a membership entry to the specific point in time at which it is valid." .

:timeValidatesMembership rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_TimePoint ;
    rdfs:range :Cl_Membership ;
    owl:inverseOf :membershipValidAtTime ;
    rdfs:comment "Links a time point to the membership entries that are valid at that time." .

# Restrictions/Axioms for Cl_Membership
# A Cl_Membership instance is defined by its association with a band, a person, and a time point.
# This ensures that every membership entry precisely captures these three aspects.
:Cl_Membership owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :memberOfBandEntry ;
          owl:someValuesFrom :Cl_Band
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :memberIsPerson ;
          owl:someValuesFrom :Cl_Person
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :membershipValidAtTime ;
          owl:someValuesFrom :Cl_TimePoint
        ]
    )
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/band-ontology#> .

# Ontology Metadata (Optional, but good practice)
:bandOntology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for modeling band memberships, roles, and temporal aspects." ;
    owl:versionIRI <http://example.org/band-ontology/1.0.0> .

# 1. Classes
# Top-level General Classes
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "The most general class for all entities in the ontology." .

:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A general class for entities that can perform actions or have roles." .

:Cl_TemporalEntity rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A general class for entities related to time." .

:Cl_Description rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "A general class for descriptive concepts like roles or attributes." .

# Specific Classes inheriting from General Classes
:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents an individual person." .

:Cl_Organization rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents a structured group of people." .

:Cl_Band rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:comment "Represents a musical group or band." .

:Cl_Role rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Description ;
    rdfs:comment "Represents a specific function or part performed by someone." .

:Cl_TimePoint rdf:type owl:Class ;
    rdfs:subClassOf :Cl_TemporalEntity ;
    rdfs:comment "Represents a specific moment in time." .

# Reification Class for Band Membership (Pivot Class)
:Cl_BandMembership rdf:type owl:Class ;
    rdfs:subClassOf :Cl_TemporalEntity ; # A band membership exists over time
    rdfs:comment "Represents the specific context of a person having a certain role in a band at a particular time." .

# Disjointness Axioms (Optional, but good for robust modeling)
:Cl_Person owl:disjointWith :Cl_Band .
:Cl_Person owl:disjointWith :Cl_Role .
:Cl_Band owl:disjointWith :Cl_Role .
:Cl_BandMembership owl:disjointWith :Cl_Person .
:Cl_BandMembership owl:disjointWith :Cl_Band .
:Cl_BandMembership owl:disjointWith :Cl_Role .

# 2. Properties

# Data Properties
:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Entity ;
    rdfs:range xsd:string ;
    rdfs:comment "A generic property to assign a name to an entity." .

:personName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Person ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of a person." .

:bandName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Band ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of a band." .

:roleName rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasName ;
    rdfs:domain :Cl_Role ;
    rdfs:range xsd:string ;
    rdfs:comment "The name or description of a role (e.g., 'Vocalist', 'Guitarist')." .

:atDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Specifies the precise date and time when a band membership instance is valid." .
:atDateTime rdf:type owl:FunctionalProperty ; # A single membership instance has one specific time
    rdfs:comment "Ensures that a band membership occurs at a unique point in time." .


# Object Properties for Reification (Connecting Cl_BandMembership to other classes)
:hasMember rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Person ;
    rdfs:comment "Links a band membership instance to the person who is a member." .

:isMemberOfBand rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Band ;
    rdfs:comment "Links a band membership instance to the band in which the person is a member." .

:hasRole rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_BandMembership ;
    rdfs:range :Cl_Role ;
    rdfs:comment "Links a band membership instance to the specific role the person holds in the band." .

# 3. Restrictions and General Class Axioms
# Ensuring Cl_BandMembership instances are complete
:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMember ;
    owl:someValuesFrom :Cl_Person ;
    rdfs:comment "Every band membership must involve a person."
] .
:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMember ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Each band membership involves exactly one person."
] .

:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isMemberOfBand ;
    owl:someValuesFrom :Cl_Band ;
    rdfs:comment "Every band membership must be for a specific band."
] .
:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isMemberOfBand ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Each band membership involves exactly one band."
] .

:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasRole ;
    owl:someValuesFrom :Cl_Role ;
    rdfs:comment "Every band membership must specify a role."
] .
:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasRole ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Each band membership involves exactly one role."
] .

:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :atDateTime ;
    owl:someValuesFrom xsd:dateTime ;
    rdfs:comment "Every band membership must have a specific point in time."
] .
:Cl_BandMembership rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :atDateTime ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Each band membership is valid at exactly one point in time."
] .

# General Class Axioms for completeness (e.g., a Person is related to BandMembership)
# This states that if something is a Cl_Person, it is also necessarily (but not sufficiently) described as having been a member in some Cl_BandMembership.
:Cl_Person rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty [owl:inverseOf :hasMember] ;
    owl:someValuesFrom :Cl_BandMembership ;
    rdfs:comment "A person is associated with at least one band membership (inversely, they are 'a member of' a BandMembership instance)."
] .

:Cl_Band rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty [owl:inverseOf :isMemberOfBand] ;
    owl:someValuesFrom :Cl_BandMembership ;
    rdfs:comment "A band is associated with at least one band membership (inversely, it 'has membership' instances)."
] .

:Cl_Role rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty [owl:inverseOf :hasRole] ;
    owl:someValuesFrom :Cl_BandMembership ;
    rdfs:comment "A role is associated with at least one band membership (inversely, it 'is a role in' a BandMembership instance)."
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/music-ontology#> .

# Classes
# Hierarchy: Cl_TemporalEntity -> Cl_TimePeriod

:Cl_Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "Represents a musical album, a collection of audio recordings." .

:Cl_TemporalEntity a owl:Class ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "A general class for concepts that exist over a period of time or represent a point in time." .

:Cl_TimePeriod a owl:Class ;
    rdfs:subClassOf :Cl_TemporalEntity ;
    rdfs:label "Time Period" ;
    rdfs:comment "Represents a specific duration, defined by a start and end date/time." .

:Cl_RecordingEvent a owl:Class ;
    rdfs:label "Recording Event" ;
    rdfs:comment "A pivot class (reification) capturing the event of an album being recorded. It links an album to the specific time period during which its recording occurred." .

# Properties

# Object Properties (for reification and connecting classes)

:hasRecordingEvent a owl:ObjectProperty ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_RecordingEvent ;
    rdfs:label "has recording event" ;
    rdfs:comment "Connects an album to a specific event where it was recorded." .

:recordedAlbum a owl:ObjectProperty ;
    rdfs:domain :Cl_RecordingEvent ;
    rdfs:range :Cl_Album ;
    owl:inverseOf :hasRecordingEvent ;
    rdfs:label "recorded album" ;
    rdfs:comment "Connects a recording event to the album that was the subject of the recording." .

:occurredDuring a owl:ObjectProperty ;
    rdfs:domain :Cl_RecordingEvent ;
    rdfs:range :Cl_TimePeriod ;
    rdfs:label "occurred during" ;
    rdfs:comment "Connects a recording event to the time period during which it took place." .

:isPeriodOfRecordingEvent a owl:ObjectProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range :Cl_RecordingEvent ;
    owl:inverseOf :occurredDuring ;
    rdfs:label "is period of recording event" ;
    rdfs:comment "Connects a time period to a recording event that occurred within it." .

# Data Properties (for connecting classes to literal values)

:albumTitle a owl:DatatypeProperty ;
    rdfs:domain :Cl_Album ;
    rdfs:range xsd:string ;
    rdfs:label "album title" ;
    rdfs:comment "The primary title of the album." ;
    a owl:FunctionalProperty . # An album typically has one main title.

:hasStartDateTime a owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has start date time" ;
    rdfs:comment "The specific date and time when a time period begins." ;
    a owl:FunctionalProperty . # A time period has one unique start time.

:hasEndDateTime a owl:DatatypeProperty ;
    rdfs:domain :Cl_TimePeriod ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has end date time" ;
    rdfs:comment "The specific date and time when a time period concludes." ;
    a owl:FunctionalProperty . # A time period has one unique end time.

:hasLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_TemporalEntity ;
    rdfs:range xsd:string ;
    rdfs:label "has label" ;
    rdfs:comment "A human-readable label or description for a temporal entity." .

# General Class Axioms / Restrictions

# Every Cl_RecordingEvent must involve an album.
:Cl_RecordingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :recordedAlbum ;
    owl:someValuesFrom :Cl_Album
] ;
rdfs:comment "A recording event must be associated with an album that was recorded." .

# Every Cl_RecordingEvent must occur during a time period.
:Cl_RecordingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :occurredDuring ;
    owl:someValuesFrom :Cl_TimePeriod
] ;
rdfs:comment "A recording event must have a defined time period during which it took place." .

# Every Cl_Album must have an album title.
:Cl_Album rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :albumTitle ;
    owl:someValuesFrom xsd:string
] ;
rdfs:comment "Every album entity must have an associated title." .

# Every Cl_TimePeriod must have a start date/time.
:Cl_TimePeriod rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasStartDateTime ;
    owl:someValuesFrom xsd:dateTime
] ;
rdfs:comment "Every time period must specify its starting date and time." .

# Every Cl_TimePeriod must have an end date/time.
:Cl_TimePeriod rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasEndDateTime ;
    owl:someValuesFrom xsd:dateTime
] ;
rdfs:comment "Every time period must specify its ending date and time." .
@prefix : <http://example.org/musicontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:musicOntology a owl:Ontology ;
    rdfs:comment "An ontology for music information, modeling albums and tracks with reification for their relationship, addressing the competency question: 'How many tracks does a particular album contain?'" ;
    owl:versionIRI <http://example.org/musicontology/1.0> .

# Classes
:Cl_CreativeWork a owl:Class ;
    rdfs:label "Creative Work" ;
    rdfs:comment "A general class for any work of creation or intellectual property." .

:Cl_MusicEntity a owl:Class ;
    rdfs:label "Music Entity" ;
    rdfs:comment "A class for any entity specifically related to music, such as albums, tracks, or artists." ;
    rdfs:subClassOf :Cl_CreativeWork .

:Cl_Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of music tracks, typically released together as a cohesive body of work." ;
    rdfs:subClassOf :Cl_MusicEntity .

:Cl_Track a owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "An individual piece of music, which can stand alone or be part of a larger collection like an album." ;
    rdfs:subClassOf :Cl_MusicEntity .

# Reification Class: Cl_AlbumTrackInclusion captures the nuanced relationship between an Album and a Track, including properties like track number.
:Cl_AlbumTrackInclusion a owl:Class ;
    rdfs:label "Album Track Inclusion" ;
    rdfs:comment "A pivot class representing the specific event or instance of a track's inclusion within an album, allowing for additional details like its sequential position." ;
    rdfs:subClassOf :owl:Thing . # A general conceptual class for relationships.

# Properties

# General Object properties for hierarchical relations
:op_hasPart a owl:ObjectProperty ;
    rdfs:label "has part" ;
    rdfs:comment "A generic property relating a whole to its constituent parts." ;
    rdfs:domain :Cl_CreativeWork ;
    rdfs:range :Cl_CreativeWork .

:op_isPart a owl:ObjectProperty ;
    owl:inverseOf :op_hasPart ;
    rdfs:label "is part of" ;
    rdfs:comment "A generic property relating a part to its containing whole." ;
    rdfs:domain :Cl_CreativeWork ;
    rdfs:range :Cl_CreativeWork .

# Object properties for Reification (linking Album and Track via Cl_AlbumTrackInclusion)
:op_includesTrackInclusion a owl:ObjectProperty ;
    rdfs:label "includes track inclusion" ;
    rdfs:comment "Relates an album to a specific instance of a track's inclusion within that album." ;
    rdfs:domain :Cl_Album ;
    rdfs:range :Cl_AlbumTrackInclusion .

:op_trackIncludedInAlbum a owl:ObjectProperty ;
    owl:inverseOf :op_includesTrackInclusion ;
    rdfs:label "track included in album" ;
    rdfs:comment "Relates a specific track inclusion instance back to the album it belongs to." ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range :Cl_Album ;
    a owl:FunctionalProperty . # A specific inclusion instance can only belong to one album.

:op_relatesToTrack a owl:ObjectProperty ;
    rdfs:label "relates to track" ;
    rdfs:comment "Connects an album-track inclusion instance to the specific track being included." ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range :Cl_Track ;
    a owl:FunctionalProperty . # A specific inclusion instance refers to one particular track.

:op_isIncludedVia a owl:ObjectProperty ;
    owl:inverseOf :op_relatesToTrack ;
    rdfs:label "is included via" ;
    rdfs:comment "Relates a track to the specific inclusion instance that places it within an album." ;
    rdfs:domain :Cl_Track ;
    rdfs:range :Cl_AlbumTrackInclusion .

# Data properties
:dp_title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "The primary title of a music entity." ;
    rdfs:domain :Cl_MusicEntity ;
    rdfs:range xsd:string .

:dp_releaseDate a owl:DatatypeProperty ;
    rdfs:label "release date" ;
    rdfs:comment "The date when a music entity (album or track) was officially released." ;
    rdfs:domain :Cl_MusicEntity ;
    rdfs:range xsd:date .

:dp_duration a owl:DatatypeProperty ;
    rdfs:label "duration" ;
    rdfs:comment "The temporal length of a track, typically expressed in seconds." ;
    rdfs:domain :Cl_Track ;
    rdfs:range xsd:integer .

:dp_trackNumber a owl:DatatypeProperty ;
    rdfs:label "track number" ;
    rdfs:comment "The sequential position of a track within an album, specified as part of its inclusion relationship." ;
    rdfs:domain :Cl_AlbumTrackInclusion ;
    rdfs:range xsd:integer ;
    a owl:FunctionalProperty . # Each track inclusion instance has a single track number.

# Restrictions and General Class Axioms

# Restriction: An Cl_Album must have at least one Cl_AlbumTrackInclusion to be considered an album containing tracks.
:Cl_Album rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :op_includesTrackInclusion ;
    owl:someValuesFrom :Cl_AlbumTrackInclusion
] .

# Restriction: Every Cl_AlbumTrackInclusion instance must relate to exactly one album.
:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :op_trackIncludedInAlbum ;
    owl:cardinality 1
] .

# Restriction: Every Cl_AlbumTrackInclusion instance must relate to exactly one track.
:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :op_relatesToTrack ;
    owl:cardinality 1
] .

# Restriction: Every Cl_AlbumTrackInclusion instance must have exactly one track number defined.
:Cl_AlbumTrackInclusion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :dp_trackNumber ;
    owl:cardinality 1
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Classes
:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:comment "A general class representing any creative work." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "A specialized class for works that are musical in nature." .

:Cl_Album rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:comment "A specific type of musical work, typically a collection of audio recordings released together." .

# Reification Pivot Class
:Cl_ReleaseEvent rdf:type owl:Class ;
    rdfs:comment "Represents a specific event of an album's release, allowing for the capture of details pertaining to that event, such as the exact date." .

# Object Properties
:relatesToAlbum rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range :Cl_Album ;
    owl:functionalProperty true ;
    rdfs:comment "Connects a specific release event to the album that was released during this event. This property is functional as each release event pertains to one specific album." .

# Data Properties
:hasReleaseDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ReleaseEvent ;
    rdfs:range xsd:date ;
    owl:functionalProperty true ;
    rdfs:comment "Specifies the precise date on which a release event took place. This property is functional as a single release event instance has one specific date." .

# General Class Axioms / Restrictions

# Every Cl_ReleaseEvent must be related to some Cl_Album.
:Cl_ReleaseEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :relatesToAlbum ;
    owl:someValuesFrom :Cl_Album
] .

# Every Cl_ReleaseEvent must have a Cl_hasReleaseDate.
:Cl_ReleaseEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasReleaseDate ;
    owl:someValuesFrom xsd:date
] .

# An Cl_Album must have at least one Cl_ReleaseEvent.
# This restriction asserts that for any instance of Cl_Album, there must be at least one Cl_ReleaseEvent
# that relates to it via the inverse of :relatesToAlbum.
:Cl_Album rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty [
        owl:inverseOf :relatesToAlbum ;
        rdf:type owl:ObjectProperty
    ] ;
    owl:someValuesFrom :Cl_ReleaseEvent
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

owl:Ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for music tracks and songs to answer 'What song is a specific track a recording of?'" .

# Class Definitions
:Cl_Entity rdf:type owl:Class ;
    rdfs:comment "The most general class representing anything in the domain." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents an abstract creative work or intellectual creation." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "Represents an abstract musical composition." .

:Cl_Song rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:comment "Represents a distinct musical composition, typically with lyrics and melody." .

:Cl_Manifestation rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:comment "Represents a physical or digital embodiment/manifestation of a creative work." .

:Cl_AudioRecording rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Manifestation ;
    rdfs:comment "Represents any form of audio recording." .

:Cl_Track rdf:type owl:Class ;
    rdfs:subClassOf :Cl_AudioRecording ;
    rdfs:comment "Represents a specific recorded audio item, often found on an album or release." .

# Property Definitions
:Pr_isRecordingOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Track ;
    rdfs:range :Cl_Song ;
    rdf:type owl:FunctionalProperty ; # A specific track is a recording of exactly one song.
    rdfs:comment "Links an audio track to the abstract song (musical composition) it is a recording of." .

:Pr_hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain rdfs:Resource ; # Can be applied to various resources like songs and tracks
    rdfs:range xsd:string ;
    rdfs:comment "Provides the title or name of an entity." .

:Pr_hasDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Track ;
    rdfs:range xsd:decimal ; # Duration typically in seconds
    rdfs:comment "Specifies the duration of an audio track, measured in seconds." .

# Class Axioms and Restrictions
# A Cl_Track must be a recording of exactly one Cl_Song.
:Cl_Track rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :Pr_isRecordingOf ;
    owl:cardinality 1 ;
    rdfs:comment "Every Cl_Track must be a recording of exactly one Cl_Song."
] .

# Every Cl_Song must have at least one title.
:Cl_Song rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :Pr_hasTitle ;
    owl:minCardinality 1 ;
    rdfs:comment "Every Cl_Song must have at least one title."
] .

# Every Cl_Track must have at least one title.
:Cl_Track rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :Pr_hasTitle ;
    owl:minCardinality 1 ;
    rdfs:comment "Every Cl_Track must have at least one title."
] .

# Every Cl_Track must have a duration.
:Cl_Track rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :Pr_hasDuration ;
    owl:minCardinality 1 ;
    rdfs:comment "Every Cl_Track must have a duration."
] .
@prefix : <http://www.ontology.org/music-composition#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:Ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for music composition, designed to answer the competency question 'When was a certain song composed?' using reification." .

# --- Class Hierarchies ---

# Base Class for creative works
:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:comment "Represents any original creation or intellectual work." .

# Musical Works Hierarchy
:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:comment "Represents any creation in the domain of music." .

:Cl_Song rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:comment "Represents a specific musical piece, typically characterized by melody and lyrics." .

# Agent Hierarchy (for entities performing actions)
:Cl_Agent rdf:type owl:Class ;
    rdfs:comment "Represents an entity that can perform an action, such as a person or an organization." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:comment "Represents an individual human being." .

:Cl_Composer rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:comment "Represents a person who creates musical compositions." .

# Event Hierarchy
:Cl_Event rdf:type owl:Class ;
    rdfs:comment "Represents a happening or an occurrence in time." .

# Reification Class for Composition Event
:Cl_CompositionEvent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:comment "A pivot class representing the specific event of a song being composed, linking the song, the composer, and the date of composition." .

# --- Properties ---

# Object Properties for Cl_CompositionEvent (Reification)
:hasComposedMusicalWork rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range :Cl_Song ;
    rdfs:comment "Links a composition event to the specific song that was created during that event." .

:hasComposerAgent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range :Cl_Composer ;
    rdfs:comment "Links a composition event to the composer who performed the act of composing." .

# Data Properties
:hasCompositionDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_CompositionEvent ;
    rdfs:range xsd:date ;
    rdfs:comment "Indicates the specific date when a composition event occurred." ;
    owl:functionalProperty true . # A single composition event has one specific composition date.

:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_MusicalWork ;
    rdfs:range xsd:string ;
    rdfs:comment "The primary title of a musical work." ;
    owl:functionalProperty true . # A musical work typically has one main title.

:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Agent ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of an agent (e.g., person's full name, organization's name)." ;
    owl:functionalProperty true . # An agent typically has one primary name.

# --- Restrictions / General Class Axioms ---

# Every CompositionEvent must involve at least one song and one composer.
# This ensures that a Cl_CompositionEvent instance is meaningful.
:Cl_CompositionEvent owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasComposedMusicalWork ;
    owl:someValuesFrom :Cl_Song
] .

:Cl_CompositionEvent owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasComposerAgent ;
    owl:someValuesFrom :Cl_Composer
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/record-critic-ontology#> .

# Ontology Metadata
owl:Ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for representing critic reviews of records, designed to answer 'What does a certain critic say about a certain record?'" ;
    owl:versionIRI <http://example.org/record-critic-ontology/1.0> .

# Class Definitions and Hierarchies
:Cl_Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "The most general class in this ontology, representing anything that can be described." .

:Cl_Agent rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Agent" ;
    rdfs:comment "A class for entities that can perform actions or be active participants." .

:Cl_Person rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Agent ;
    rdfs:label "Person" ;
    rdfs:comment "A human being." .

:Cl_CreativeWork rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Creative Work" ;
    rdfs:comment "A product of human creativity or intellectual effort." .

:Cl_Critic rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Critic" ;
    rdfs:comment "An individual who professionally evaluates and reviews creative works, specifically records in this context." .

:Cl_Record rdf:type owl:Class ;
    rdfs:subClassOf :Cl_CreativeWork ;
    rdfs:label "Record" ;
    rdfs:comment "A sound recording, typically a music album, single, or EP." .

# Reification Class for Review Interactions
:Cl_ReviewInteraction rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Review Interaction" ;
    rdfs:comment "A pivot class representing a specific instance of a critic reviewing a record. This class captures the nuanced relationship and associated details like review text and rating." ;
    # General class axioms to ensure a review interaction always involves a critic and a record
    rdfs:subClassOf
        [ rdf:type owl:Restriction ;
            owl:onProperty :hasCritic ;
            owl:someValuesFrom :Cl_Critic
        ] ;
    rdfs:subClassOf
        [ rdf:type owl:Restriction ;
            owl:onProperty :reviewsRecord ;
            owl:someValuesFrom :Cl_Record
        ] .

# Disjointness Axioms
:Cl_Critic owl:disjointWith :Cl_Record .
:Cl_Critic owl:disjointWith :Cl_ReviewInteraction .
:Cl_Record owl:disjointWith :Cl_ReviewInteraction .
:Cl_Person owl:disjointWith :Cl_CreativeWork .

# Property Definitions

# Object Properties (connecting classes)
:hasCritic rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ReviewInteraction ;
    rdfs:range :Cl_Critic ;
    rdfs:label "has critic" ;
    rdfs:comment "Links a review interaction to the specific critic who conducted it." ;
    owl:functional true . # A single review interaction is performed by exactly one critic.

:reviewsRecord rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_ReviewInteraction ;
    rdfs:range :Cl_Record ;
    rdfs:label "reviews record" ;
    rdfs:comment "Links a review interaction to the specific record that was reviewed." ;
    owl:functional true . # A single review interaction focuses on exactly one record.

# Inverse Properties for enhanced navigation
:isCriticOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Critic ;
    rdfs:range :Cl_ReviewInteraction ;
    rdfs:label "is critic of" ;
    rdfs:comment "The inverse property of 'hasCritic', linking a critic to the review interactions they performed." ;
    owl:inverseOf :hasCritic .

:isReviewedByInteraction rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_ReviewInteraction ;
    rdfs:label "is reviewed by interaction" ;
    rdfs:comment "The inverse property of 'reviewsRecord', linking a record to the review interactions it is part of." ;
    owl:inverseOf :reviewsRecord .

# Data Properties (connecting classes to literal values)
:criticName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Critic ;
    rdfs:range xsd:string ;
    rdfs:label "critic name" ;
    rdfs:comment "The full name of the critic." ;
    owl:functional true .

:recordTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range xsd:string ;
    rdfs:label "record title" ;
    rdfs:comment "The official title of the record." ;
    owl:functional true .

:artistName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_Record ;
    rdfs:range xsd:string ;
    rdfs:label "artist name" ;
    rdfs:comment "The name of the artist or band who created the record." .

:reviewText rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ReviewInteraction ;
    rdfs:range xsd:string ;
    rdfs:label "review text" ;
    rdfs:comment "The complete text content of the critic's review." .

:hasRatingValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ReviewInteraction ;
    rdfs:range xsd:decimal ; # Allows for ratings like 7.5/10 or 3.5/5
    rdfs:label "has rating value" ;
    rdfs:comment "The numerical rating or score given in the review." ;
    owl:functional true .

:reviewDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_ReviewInteraction ;
    rdfs:range xsd:date ;
    rdfs:label "review date" ;
    rdfs:comment "The date on which the review was published." ;
    owl:functional true .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

### Classes
:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" .

:Cl_Performance rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Performance" .

# Reification class for a specific instance of a performance taking place
:Cl_PerformanceEvent rdf:type owl:Class ;
    rdfs:label "Performance Event" ;
    rdfs:comment "Represents a specific occurrence of a performance, linking a performance with its time of occurrence." ;
    # General class axiom: A PerformanceEvent must refer to a Performance and have a DateTime.
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty :occursForPerformance ;
                      owl:someValuesFrom :Cl_Performance ] ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty :hasDateTime ;
                      owl:someValuesFrom xsd:dateTime ] .

### Properties

# Object Property: Links a Performance Event to the specific Performance it refers to
:occursForPerformance rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_PerformanceEvent ;
    rdfs:range :Cl_Performance ;
    rdfs:label "occurs for performance" .

# Object Property: Links a Performance to its specific Performance Event(s)
:hasPerformanceEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_PerformanceEvent ;
    owl:inverseOf :occursForPerformance ;
    rdfs:label "has performance event" .

# Data Property: Specifies the date and time of a Performance Event
:hasDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain :Cl_PerformanceEvent ;
    rdfs:range xsd:dateTime ;
    owl:functional true ; # A specific performance event typically has one exact date/time
    rdfs:label "has date time" .

# General Class Axiom Example (Optional, demonstrating restriction usage)
# :Cl_PerformanceEvent is the only class that uses the 'hasDateTime' property for its domain.
:Cl_PerformanceEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasDateTime ;
    owl:allValuesFrom xsd:dateTime
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> .

# Classes
:Cl_Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A general class representing any kind of event." .

:Cl_Performance rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:label "Performance" ;
    rdfs:comment "A specific instance of a live or recorded presentation of artistic work." .

:Cl_MusicalWork rdf:type owl:Class ;
    rdfs:label "Musical Work" ;
    rdfs:comment "A general class for any composed piece of music." .

:Cl_Song rdf:type owl:Class ;
    rdfs:subClassOf :Cl_MusicalWork ;
    rdfs:label "Song" ;
    rdfs:comment "A specific type of musical work, typically with vocals." .

# Reification Class: Cl_PerformanceEvent
# This pivot class captures the specific instance of a song being played within a performance,
# addressing the need to link a Song, a Performance, and the act of playing them together.
:Cl_PerformanceEvent rdf:type owl:Class ;
    rdfs:label "Performance Event" ;
    rdfs:comment "Represents the specific instance of a song being played during a performance." .

# Object Properties
:occursInPerformance rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "occurs in performance" ;
    rdfs:domain :Cl_PerformanceEvent ;
    rdfs:range :Cl_Performance ;
    rdfs:comment "Links a specific PerformanceEvent instance to the Performance it is part of. Declared as Functional because a specific instance of a song being played (a PerformanceEvent) can only occur in one particular Performance." .

:playsSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "plays song" ;
    rdfs:domain :Cl_PerformanceEvent ;
    rdfs:range :Cl_Song ;
    rdfs:comment "Links a specific PerformanceEvent instance to the Song that was played during that instance. Declared as Functional because a specific instance of a song being played (a PerformanceEvent) only plays one particular Song." .

# Data Properties
:hasTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has title" ;
    rdfs:domain :Cl_MusicalWork ;
    rdfs:range xsd:string ;
    rdfs:comment "The title of a musical work or song. Functional as a musical work typically has a single primary title." .

:hasDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has date" ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:date ;
    rdfs:comment "The specific date on which the performance took place. Functional as a performance occurs on one specific date." .

:hasLocation rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has location" ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:string ;
    rdfs:comment "The geographical location where the performance was held. Functional as a performance occurs at one specific location." .

# General Class Axioms and Restrictions
# A Cl_PerformanceEvent must always be linked to exactly one Cl_Performance and exactly one Cl_Song.
:Cl_PerformanceEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :occursInPerformance ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Each instance of a PerformanceEvent must be associated with exactly one Performance."
] .

:Cl_PerformanceEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :playsSong ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Each instance of a PerformanceEvent must be associated with exactly one Song."
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .

# Ontology Metadata
:ontology a owl:Ontology ;
    rdfs:comment "Ontology for representing performances and their locations, specifically designed to answer the competency question: 'Where did a certain performance take place?'" ;
    owl:versionIRI <http://example.org/ontology/1.0> .

# Classes
:Cl_Event a owl:Class ;
    rdfs:comment "Represents a general occurrence or happening." .

:Cl_Performance a owl:Class ;
    rdfs:subClassOf :Cl_Event ;
    rdfs:comment "Represents a specific public display or presentation, such as a concert, play, or show, which is a type of event." .

:Cl_Location a owl:Class ;
    rdfs:comment "Represents a geographical or physical place." .

:Cl_Venue a owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:comment "Represents a specific place or building where events, especially performances, are held, such as a theater, stadium, or hall. It is a more specific type of location." .

# Properties

# Object Property: where a performance takes place
:takesPlaceAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range :Cl_Venue ;
    rdfs:comment "Links a performance to the specific venue where it occurs. This is a functional property, indicating that a particular performance (at a given time) takes place at exactly one primary venue." .

# Data Properties for Performance
:hasPerformanceName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Performance ;
    rdfs:range xsd:string ;
    rdfs:comment "The name or title given to a performance." .

# Data Properties for Location and Venue
:hasLocationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string ;
    rdfs:comment "The general name of any location." .

:hasVenueName a owl:DatatypeProperty ;
    rdfs:subPropertyOf :hasLocationName ;
    rdfs:domain :Cl_Venue ;
    rdfs:range xsd:string ;
    rdfs:comment "The specific name of a venue. This is a sub-property of hasLocationName because a venue name is a type of location name." .

:hasAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_Venue ;
    rdfs:range xsd:string ;
    rdfs:comment "The physical street address of the venue." .

# Restrictions
# Every performance must take place at some venue.
:Cl_Performance rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :takesPlaceAt ;
    owl:someValuesFrom :Cl_Venue ;
    rdfs:comment "This restriction ensures that every instance of Cl_Performance must be linked to at least one instance of Cl_Venue via the :takesPlaceAt property, thus answering 'Where did a certain performance take place?'."
] .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ontology#> . # Base URI for the ontology

# Ontology metadata (optional but good practice)
:ontology rdf:type owl:Ontology ;
    rdfs:comment "Ontology for geographical locations to answer the competency question 'In what region is a certain city located?'." .

# Classes
:Cl_GeographicalEntity rdf:type owl:Class ;
    rdfs:comment "A top-level class representing any identifiable geographical entity." .

:Cl_Location rdf:type owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity ;
    rdfs:comment "A class representing a general location, which is a type of geographical entity." .

:Cl_City rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:comment "A class representing a city, which is a specific type of location." .

:Cl_Region rdf:type owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:comment "A class representing a geographical region, which can be an administrative division (e.g., state, country) or a larger geographical area (e.g., continent, mountain range)." .

# General Class Axiom: Every city must be located in at least one region.
# This ensures that instances of Cl_City will always have a relationship to Cl_Region via locatedInRegion.
:Cl_City rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :locatedInRegion ;
    owl:someValuesFrom :Cl_Region
] .

# Object Properties
:locatedInRegion rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_City ;
    rdfs:range :Cl_Region ;
    rdf:type owl:AsymmetricProperty ; # If City A is in Region B, Region B is not in City A.
    rdf:type owl:IrreflexiveProperty ; # A city cannot be located within itself.
    rdfs:comment "Connects a city to the geographical region it is located in. This property directly answers the competency question 'In what region is a certain city located?'." .

:isRegionOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :locatedInRegion ;
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_City ;
    rdfs:comment "Connects a region to a city that is contained within it. This is the inverse of locatedInRegion." .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/geography#> .

:geographyOntology a owl:Ontology ;
    rdfs:comment "An ontology for geographical entities, focusing on the location of regions within countries to answer competency questions." .

# Classes
####################################################################################

:Cl_GeographicalEntity a owl:Class ;
    rdfs:comment "The top-level class for any entity that has a geographical existence." .

:Cl_Location a owl:Class ;
    rdfs:subClassOf :Cl_GeographicalEntity ;
    rdfs:comment "Represents a specific point or area in space." .

:Cl_Country a owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:comment "Represents a sovereign state or nation." .

:Cl_Region a owl:Class ;
    rdfs:subClassOf :Cl_Location ;
    rdfs:comment "Represents a distinct area or subdivision within a larger geographical entity, such as a country." .

# Class Axioms / Restrictions
####################################################################################

:Cl_Country owl:disjointWith :Cl_Region ;
    rdfs:comment "A Country cannot also be a Region, and vice-versa." .

# Properties
####################################################################################

:isLocatedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_GeographicalEntity ;
    rdfs:range :Cl_Location ;
    rdfs:comment "A general property indicating that a geographical entity is situated within another location." .

:isLocatedInCountry a owl:ObjectProperty ;
    rdfs:subPropertyOf :isLocatedIn ;
    rdfs:domain :Cl_Region ;
    rdfs:range :Cl_Country ;
    owl:functional true ; # A region is typically located in exactly one country
    rdfs:comment "Relates a geographical region to the specific country it is part of." .

# Property Restrictions
####################################################################################

# Every Cl_Region must be located in some Cl_Country
:Cl_Region rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isLocatedInCountry ;
    owl:someValuesFrom :Cl_Country
] ;
rdfs:comment "This restriction ensures that every instance of Cl_Region is asserted to be located in at least one Cl_Country." .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/recordontology#> .

# Ontology Declaration
:recordOntology rdf:type owl:Ontology ;
    owl:versionIRI :recordOntology-1.0 ;
    rdfs:comment "An ontology for modeling musical records and tracks, focusing on their composition."@en .

# Classes
:Cl_Record rdf:type owl:Class ;
    rdfs:label "Record" ;
    rdfs:comment "Represents a musical record, album, or compilation." .

:Cl_Track rdf:type owl:Class ;
    rdfs:label "Track" ;
    rdfs:comment "Represents an individual musical track or song." .

# Properties
:hasTrack rdf:type owl:ObjectProperty ;
    rdfs:label "has track" ;
    rdfs:domain :Cl_Record ;
    rdfs:range :Cl_Track ;
    rdfs:comment "Relates a record to its constituent tracks." .

# Competency Question: "A record always contains at least one track."
# This is modeled by asserting that Cl_Record is a subclass of a restriction
# stating that every instance of Cl_Record must have at least one value for the hasTrack property.
:Cl_Record rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTrack ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:label "Every record must have at least one track" ;
    rdfs:comment "This restriction ensures that any instance classified as Cl_Record must be associated with at least one Cl_Track via the hasTrack property."
] .