<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#Seller">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>Seller</rdfs:label>    <rdfs:comment>The role of seller in an invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasOrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#inInvoice"/>    <rdfs:label>has organization role assignment</rdfs:label>    <rdfs:comment>Inverse of inInvoice; relates an InvoiceMessage to its OrganizationRoleAssignments.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDetail">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#DetailSection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDetailOfInvoice"/>    <rdfs:label>has detail</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to its DetailSection.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#inInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasOrganizationRoleAssignment"/>    <rdfs:label>in invoice</rdfs:label>    <rdfs:comment>Relates an OrganizationRoleAssignment to the InvoiceMessage where the role is played.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedBusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isBusinessProcessOfInvoice"/>    <rdfs:label>assigned business process</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to a BusinessProcess.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or good listed in the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isBusinessProcessOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#assignedBusinessProcess"/>    <rdfs:label>is business process of invoice</rdfs:label>    <rdfs:comment>Inverse of assignedBusinessProcess; relates a BusinessProcess to its InvoiceMessage.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isLineItemOf"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Relates the DetailSection to its LineItems.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOfLineItem"/>    <rdfs:label>has item</rdfs:label>    <rdfs:comment>Relates a LineItem to an Item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSummary">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SummarySection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSummaryOfInvoice"/>    <rdfs:label>has summary</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to its SummarySection.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#issueDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>issue date</rdfs:label>    <rdfs:comment>The date the invoice was issued, as a string (compliant with OWL 2 DL).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasIdentifier"/>    <rdfs:label>is identifier of assignment</rdfs:label>    <rdfs:comment>Inverse of hasIdentifier; relates an Identifier to the OrganizationRoleAssignment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isNetPriceOfLineItem"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>Relates a LineItem to its net Price.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#netPriceValue">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>net price value</rdfs:label>    <rdfs:comment>The net price of an item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRolePlayedBy">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#playsRole"/>    <rdfs:label>is role played by</rdfs:label>    <rdfs:comment>Inverse of playsRole; relates an OrganizationRoleAssignment to the Organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isHeaderOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasHeader"/>    <rdfs:label>is header of invoice</rdfs:label>    <rdfs:comment>Inverse of hasHeader; relates a HeaderSection to its InvoiceMessage.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A business process to which the invoice may be assigned.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse of hasSegment; relates a Segment to its Message.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an InterchangeEnvelope to the Messages it contains.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isHeaderOfInvoice"/>    <rdfs:label>has header</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to its HeaderSection.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDetailOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasDetail"/>    <rdfs:label>is detail of invoice</rdfs:label>    <rdfs:comment>Inverse of hasDetail; relates a DetailSection to its InvoiceMessage.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#invoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>invoice amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOfAssignment"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Relates an OrganizationRoleAssignment to an Address.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#EDIFACTInvoiceOntology">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology for representing UN/EDIFACT invoice messages and their structure, roles, and data elements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isNetPriceOfLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasNetPrice"/>    <rdfs:label>is net price of line item</rdfs:label>    <rdfs:comment>Inverse of hasNetPrice; relates a Price to its LineItem.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#HeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Header Section</rdfs:label>    <rdfs:comment>Header section of the invoice, including dates and references.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#DetailSection"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a Message to its Segments.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment in an EDIFACT message, such as BGM or NAD.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasAddress"/>    <rdfs:label>is address of assignment</rdfs:label>    <rdfs:comment>Inverse of hasAddress; relates an Address to the OrganizationRoleAssignment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#DetailSection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasLineItem"/>    <rdfs:label>is line item of</rdfs:label>    <rdfs:comment>Inverse of hasLineItem; relates a LineItem to its DetailSection.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>A unique identifier, such as a GLN, associated with an organization or address.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#containsMessage"/>    <rdfs:label>is contained in envelope</rdfs:label>    <rdfs:comment>Inverse of containsMessage; relates a Message to its InterchangeEnvelope.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization within an invoice (e.g., Buyer, Seller, Delivery Party).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOfAssignment"/>    <rdfs:label>has role</rdfs:label>    <rdfs:comment>Relates an OrganizationRoleAssignment to an AgentRole.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isCompositeElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasCompositeElement"/>    <rdfs:label>is composite element of</rdfs:label>    <rdfs:comment>Inverse of hasCompositeElement; relates a Composite Data Element to its Segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Buyer">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>Buyer</rdfs:label>    <rdfs:comment>The role of buyer in an invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal address associated with an organization role.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Assignment</rdfs:label>    <rdfs:comment>A reification node linking an organization, its role, address, identifier, and the invoice context.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Identifier"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIdentifierOfAssignment"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>Relates an OrganizationRoleAssignment to an Identifier.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOf"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Relates a Segment to its Composite Data Elements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#gln">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>GLN</rdfs:label>    <rdfs:comment>Global Location Number identifier.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#invoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>invoice number</rdfs:label>    <rdfs:comment>The unique identifier of the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasRole"/>    <rdfs:label>is role of assignment</rdfs:label>    <rdfs:comment>Inverse of hasRole; relates an AgentRole to the OrganizationRoleAssignment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a Composite Data Element to its Simple Data Elements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#addressLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>address line</rdfs:label>    <rdfs:comment>A line of an address.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Summary Section</rdfs:label>    <rdfs:comment>Summary section, containing totals for the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSummaryOfInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <owl:inver