ent>The quantity for a LineItem.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has section</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to its sections (header, detail, summary).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#involvesOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>involves organization</rdfs:label>    <rdfs:comment>Relates an InvoiceMessage to organizations involved.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element in a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element in a composite.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Summary Section</rdfs:label>    <rdfs:comment>Summary section with totals and taxes.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a Message to its Segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>A price value, e.g., net price for a line item.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Tax"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has document date</rdfs:label>    <rdfs:comment>The date of the invoice document (string for OWL 2 DL compliance).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#EN16931Compliance">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>EN 16931 Compliance</rdfs:label>    <rdfs:comment>Represents compliance with EN 16931-1 standard.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a CompositeDataElement to its SimpleDataElements.</rdfs:comment>    <rdfs:domain r