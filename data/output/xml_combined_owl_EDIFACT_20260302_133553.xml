Message"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has reference number</rdfs:label>    <rdfs:comment>Relates a HeaderSection to its ReferenceNumber.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#ReferenceNumber"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>Relates a SummarySection to its InvoiceAmount.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceAmount"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#compliesWithEN16931">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>complies with EN 16931</rdfs:label>    <rdfs:comment>Indicates EN 16931-1 compliance for an InvoiceMessage.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#EN16931Compliance"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n017a7e09664e4f3d8630e57c8ab99dfab4">    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasSection"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rd