ogy#InvoiceHeader"/>    <rdf:rest rdf:nodeID="n13b9ca7f1e684acfba1b57fd07842a50b10"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Links an Organization to an Address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#WarehouseAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Warehouse Address</rdfs:label>    <rdfs:comment>A warehouse address associated with an organization.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Address"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#HeadquartersAddress"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasItemDescription">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has item description</rdfs:label>    <rdfs:comment>A description of an item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddressLine">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdfs:label>has address line</rdfs:label>    <rdfs:comment>A line of an address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The top-level envelope containing one or more EDIFACT messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#taxOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is tax of invoice summary</rdfs:label>    <rdfs:comment>Links a Tax to the InvoiceSummary it is part of (inverse of hasTax).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasTax"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasGLN">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has GLN</rdfs:label>    <rdfs:comment>The Global Location Number identifier.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n13b9ca7f1e684acfba1b57fd07842a50b14">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#hasAgentRole"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#AgentRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#edifact_invoice_story">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>A deep OWL ontology for UN/EDIFACT invoice messages, segments, and business roles, aligned with EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description>  <rdf:Description r