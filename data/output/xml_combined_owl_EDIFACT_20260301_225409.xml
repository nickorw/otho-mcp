<?xml version="1.0" encoding="utf-8"?><rdf:RDF   xmlns:owl="http://www.w3.org/2002/07/owl#"   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice number</rdfs:label>    <rdfs:comment>The invoice number as specified in the header section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Relates a segment to its composite data elements.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAddressOfRoleParticipation">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is address of role participation</rdfs:label>    <rdfs:comment>Inverse of hasAddress: relates an address to the role participation instance.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleParticipation"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedToProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>assigned to process</rdfs:label>    <rdfs:comment>Relates an invoice message to a business process (e.g., Purchase-to-Pay).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isProcessAssignmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPostalCode">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has postal code</rdfs:label>    <rdfs:comment>The postal code of an address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The interchange envelope that contains one or more messages per UN/EDIFACT.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSummarySectionOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is summary section of</rdfs:label>    <rdfs:comment>Inverse of hasSummarySection: relates a summary section to the invoice message it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has agent role</rdfs:label>    <rdfs:comment>Links a role participation to a specific agent role (e.g., Buyer, Seller).</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleParticipation"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAgentRoleOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or good listed in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Relates an invoice detail section to its line items.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isLineItemOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleParticipationOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is role participation of</rdfs:label>    <rdfs:comment>Inverse of participatesAsRole: links a role participation to the organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleParticipation"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>Inverse of hasSegment: relates a segment to the message it is part of.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an interchange envelope to the message(s) it contains.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#participatesAsRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>participates as role</rdfs:label>    <rdfs:comment>Links an organization to its role participation(s) within an invoice context.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleParticipation"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleParticipationOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Links a role participation to an address used in that role context.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleParticipation"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOfRoleParticipation"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTaxAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has tax amount</rdfs:label>    <rdfs:comment>The total tax amount in the invoice summary section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isProcessAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is process assignment of</rdfs:label>    <rdfs:comment>Inverse of assignedToProcess: relates a business process to the invoice message assigned to it.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has detail section</rdfs:label>    <rdfs:comment>Relates an invoice message to its detail section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDetailSectionOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isPriceOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is price of</rdfs:label>    <rdfs:comment>Inverse of hasPrice: relates a price to the line item it is for.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is identifier of</rdfs:label>    <rdfs:comment>Inverse of hasIdentifier: relates an identifier to the organization it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a message to its segments.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>The net price of an item in a line item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Address">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Address</rdfs:label>    <rdfs:comment>A postal address associated with an organization in a specific role context.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Organization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isAgentRoleOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is agent role of</rdfs:label>    <rdfs:comment>Inverse of hasAgentRole: relates an agent role to the role participation instance.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleParticipation"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A segment within an EDIFACT message, e.g., BGM, NAD.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Identifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Identifier</rdfs:label>    <rdfs:comment>A generic identifier for organizations or entities.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is line item of</rdfs:label>    <rdfs:comment>Inverse of hasLineItem: relates a line item to the detail section it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasReferenceNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has reference number</rdfs:label>    <rdfs:comment>A reference number in the invoice header section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has price</rdfs:label>    <rdfs:comment>Relates a line item to its price.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isPriceOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasGLN">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has GLN</rdfs:label>    <rdfs:comment>The Global Location Number (GLN) for an organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#GLNIdentifier"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#AgentRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Agent Role</rdfs:label>    <rdfs:comment>A role played by an organization in the context of an invoice (e.g., Buyer, Seller, Delivery Party).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#describesItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>describes item</rdfs:label>    <rdfs:comment>Relates a line item to the item it describes.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isDescribedByLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasQuantity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has quantity</rdfs:label>    <rdfs:comment>The quantity of an item in a line item.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceDetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Detail Section</rdfs:label>    <rdfs:comment>The detail section of an invoice message, listing line items.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isHeaderSectionOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is header section of</rdfs:label>    <rdfs:comment>Inverse of hasHeaderSection: relates a header section to the invoice message it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>The total amount of the invoice in the summary section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCity">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has city</rdfs:label>    <rdfs:comment>The city of an address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceHeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Header Section</rdfs:label>    <rdfs:comment>The header section of an invoice message, containing dates, reference numbers, etc.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeaderSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has header section</rdfs:label>    <rdfs:comment>Relates an invoice message to its header section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isHeaderSectionOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has identifier</rdfs:label>    <rdfs:comment>Links an organization to its identifier(s), such as GLN.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Identifier"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isIdentifierOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDescribedByLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is described by line item</rdfs:label>    <rdfs:comment>Inverse of describesItem: relates an item to the line item describing it.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isCompositeElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is composite element of</rdfs:label>    <rdfs:comment>Inverse of hasCompositeElement: relates a composite data element to its segment.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has summary section</rdfs:label>    <rdfs:comment>Relates an invoice message to its summary section.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummarySection"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSummarySectionOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a composite data element to its simple data elements.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasStreet">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has street</rdfs:label>    <rdfs:comment>The street of an address.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDetailSectionOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is detail section of</rdfs:label>    <rdfs:comment>Inverse of hasDetailSection: relates a detail section to the invoice message it belongs to.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#BusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Business Process</rdfs:label>    <rdfs:comment>A process to which the invoice can be assigned (e.g., Purchase-to-Pay).</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Price">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Price</rdfs:label>    <rdfs:comment>A price value associated with an item in a line item.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasName">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has name</rdfs:label>    <rdfs:comment>The name of an organization.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element, the smallest unit within a message segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#GLNIdentifier">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>GLN Identifier</rdfs:label>    <rdfs:comment>A Global Location Number identifier for organizations.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Identifier"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Message</rdfs:label>    <rdfs:comment>A message of type INVOIC representing an invoice in UN/EDIFACT.</rdfs:comment>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Message"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:label>has document date</rdfs:label>    <rdfs:comment>The document date of the invoice.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is contained in</rdfs:label>    <rdfs:comment>Inverse of containsMessage: relates a message to the envelope that contains it.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSimpleElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:label>is simple element of</rdfs:label>    <rdfs:comment>Inverse of hasSimpleElement: relates a simple data element to its composite.</rdfs:comment>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#OrganizationRoleParticipation">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization Role Participation</rdfs:label>    <rdfs:comment>Reifies the participation of an organization in a specific agent role and context (e.g., as Buyer, Seller, Delivery Party in a given invoice).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InvoiceSummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice Summary Section</rdfs:label>    <rdfs:comment>The summary section of an invoice message, showing totals and taxes.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>An organization involved in the invoice process.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#LineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Line Item</rdfs:label>    <rdfs:comment>A single line item in the invoice detail section.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Message">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Message</rdfs:label>    <rdfs:comment>A business document message, such as an invoice, as defined by UN/EDIFACT.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#UNEDIFACTInvoiceOntology">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>UN/EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology for representing UN/EDIFACT-based invoice messages and their components, roles, and business process context.</rdfs:comment>  </rdf:Description></rdf:RDF>