ion>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceHeader"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has document date</rdfs:label>    <rdfs:comment>The date of the invoice document (string, for OWL 2 DL compliance).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#CompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Composite Data Element</rdfs:label>    <rdfs:comment>A composite data element within a segment, grouping several simple elements.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab8">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <owl:intersectionOf rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab11"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#NadSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>NAD Segment</rdfs:label>    <rdfs:comment>Name and Address segment, provides details about parties involved in the transaction.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Segment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Segment</rdfs:label>    <rdfs:comment>A structural component of a message, containing composite and simple data elements.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#identifiesInvoice">    <rdf: