ssage</rdfs:label>    <rdfs:comment>An invoice message as defined by EDIFACT, containing segments for transactional data.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab12">    <rdf:first rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab10"/>    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#P2POCoreClass">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>P2P-O Core Class</rdfs:label>    <rdfs:comment>Alignment anchor to the Purchase-to-Pay Ontology (P2P-O) core classes.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:label>has composite element</rdfs:label>    <rdfs:comment>Relates a Segment to its Composite Data Elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeElementOf"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab10">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#assignedToBusinessProcess"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#BusinessProcess"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>An entity (company, customer, supplier) involved in the transaction.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Item"/>    <owl:disjointWith rdf:resource="http://