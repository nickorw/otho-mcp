ription>  <rdf:Description rdf:about="http://www.example.org/ontology#involvesOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:label>involves organization</rdfs:label>    <rdfs:comment>Relates an Invoice to the organizations involved, via OrganizationRoleAssignment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationInvolvedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#InterchangeEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Interchange Envelope</rdfs:label>    <rdfs:comment>The highest-level envelope in an EDIFACT transmission, containing one or more messages.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isP2POAlignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#P2POCoreClass"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:label>is P2P-O alignment of</rdfs:label>    <rdfs:comment>P2P-O Core Class alignment for an Invoice.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#alignsWithP2PO"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or service referenced in a line item.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isTaxOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:label>is tax of</rdfs:label>    <rdfs:comment>A Tax is part of an Invoice Summary.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasTax"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:label>has tax</rdfs:label>    <rdfs:comment>Relates the Invoice Summary to the Tax information.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isTaxOf"/>  </rdf:Description>  <rdf:Description rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab6">    <rdf:first rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab4"/>    <rdf:rest rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab7"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>is segment of</rdfs:label>    <rdfs:comment>A Segment is part of a Message.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedToBusinessProcess">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BusinessProcess"/>    <rdfs:label>assigned to business process</rdfs:label>    <rdfs:comment>Relates an Invoice to the Business Process it is part of.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isBusinessProcessOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceSummary"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>The total amount of the invoice.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isCompositeElementOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>is composite element of</rdfs:label>    <rdfs:comment>A Composite Data Element is part of a Segment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasCompositeElement"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Relates an Organization to its Address(es).</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology/edifact-invoice-story">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT Invoice Ontology</rdfs:label>    <rdfs:comment>Ontology for representing UN/EDIFACT invoice messages, segments, roles, and business constraints as described in the story and CQs.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab7">    <rdf:first rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab5"/>    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>assigned role</rdfs:label>    <rdfs:comment>Assigns a role (such as Buyer or Delivery Party) to an OrganizationRoleAssignment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleOfAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#alignsWithEN16931">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#EN16931Alignment"/>    <rdfs:label>aligns with EN16931</rdfs:label>    <rdfs:comment>Relates an Invoice to its EN 16931 alignment anchor.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isEN16931AlignmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>A simple data element, the basic unit of information in a segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#containsMessage">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:label>contains message</rdfs:label>    <rdfs:comment>Relates an Interchange Envelope to the Message(s) it contains.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContainedInEnvelope"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSimpleElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:label>has simple element</rdfs:label>    <rdfs:comment>Relates a Composite Data Element to its Simple Data Elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSimpleElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#alignsWithP2PO">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#P2POCoreClass"/>    <rdfs:label>aligns with P2P-O</rdfs:label>    <rdfs:comment>Relates an Invoice to its P2P-O alignment anchor.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isP2POAlignmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DeliveryPartyRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>Delivery Party Role</rdfs:label>    <rdfs:comment>Role for an Organization acting as the delivery party.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>assigned organization</rdfs:label>    <rdfs:comment>Assigns an Organization to an OrganizationRoleAssignment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationAssignmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Invoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Invoice</rdfs:label>    <rdfs:comment>A business document representing a request for payment, modeled as the core subject of the INVOIC message.</rdfs:comment>    <owl:equivalentClass rdf:nodeID="n31b15f1c63a648009481d373ae5cd29ab8"/>    <rdfs:seeAlso rdf:resource="http://www.example.org/ontology#ValidationConstraint"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationInvolvedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:label>is organization involved in</rdfs:label>    <rdfs:comment>An OrganizationRoleAssignment is involved in an Invoice.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#involvesOrganization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isDescribedByLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:label>is described by line item</rdfs:label>    <rdfs:comment>An Item is described by a Line Item.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#describesItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isRoleOfAssignment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#OrganizationRoleAssignment"/>    <rdfs:label>is role of assignment</rdfs:label>    <rdfs:comment>An AgentRole is assigned to an OrganizationRoleAssignment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#assignedRole"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasLineItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:label>has line item</rdfs:label>    <rdfs:comment>Relates the Invoice Detail section to its Line Items.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isLineItemOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isLineItemOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceDetail"/>    <rdfs:label>is line item of</rdfs:label>    <rdfs:comment>A Line Item is part of an Invoice Detail section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasLineItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isNetPriceOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#LineItem"/>    <rdfs:label>is net price of</rdfs:label>    <rdfs:comment>A Price is the net price of a Line Item.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasNetPrice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Tax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Tax</rdfs:label>    <rdfs:comment>Tax amount or rate applied to the invoice or line items.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasSegment">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>has segment</rdfs:label>    <rdfs:comment>Relates a Message to its Segments.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isSegmentOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifiedByBGM">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Invoice"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#BGMSegment"/>    <rdfs:label>is identified by BGM</rdfs:label>    <rdfs:comment>An Invoice is identified by a BGM Segment.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#identifiesInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationAssignmentOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>