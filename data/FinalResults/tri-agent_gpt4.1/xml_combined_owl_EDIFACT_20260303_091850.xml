g/ontology#Item">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Item</rdfs:label>    <rdfs:comment>A product or good listed in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Price"/>  </rdf:Description>  <rdf:Description rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab3">    <rdf:first rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdf:rest rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab4"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasTax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Tax"/>    <rdfs:label>has tax</rdfs:label>    <rdfs:comment>Links the summary section to tax information.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isTaxOfSummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#storyid">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>    <rdfs:label>EDIFACT INVOIC D96A Ontology</rdfs:label>    <rdfs:comment>Ontology for representing UN/EDIFACT D96A INVOIC messages, segments, organizations, and roles, with alignment to EN 16931-1 and P2P-O.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isHeaderOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>header of invoice message</rdfs:label>    <rdfs:comment>Indicates the invoice message for which this is the header section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasHeader"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasNetPrice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Price"/>    <rdfs:label>has net price</rdfs:label>    <rdfs:comment>Links an item to its net price.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isNetPriceOfItem"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasInvoiceAmount">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#SummarySection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceAmount"/>    <rdfs:label>has invoice amount</rdfs:label>    <rdfs:comment>Links the summary section to the total invoice amount.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isInvoiceAmountOfSummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:label>has address</rdfs:label>    <rdfs:comment>Links an organization to its addresses.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#DetailSection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Detail Section</rdfs:label>    <rdfs:comment>Lists all line items in the invoice.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#SummarySection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasWarehouseAddress">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:label>has warehouse address</rdfs:label>    <rdfs:comment>Links an organization to its warehouse address.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isWarehouseAddressOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Item"/>    <rdfs:label>has item</rdfs:label>    <rdfs:comment>Links a detail section to its listed items.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isItemOfDetailSection"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasHeader">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:label>has header</rdfs:label>    <rdfs:comment>Links an invoice message to its header section.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isHeaderOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#roleContext">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#PivotOrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>role context</rdfs:label>    <rdfs:comment>The context (invoice) in which a role is assigned.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isContextOfRoleAssignment"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isIdentifierOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>identifier of organization</rdfs:label>    <rdfs:comment>Indicates the organization for which this is an identifier.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasIdentifier"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasGlobalLocationNumber">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Identifier"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has Global Location Number</rdfs:label>    <rdfs:comment>The Global Location Number (GLN) for an organization.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab6">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <owl:intersectionOf rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab10"/>  </rdf:Description>  <rdf:Description rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab17">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>    <owl:onProperty rdf:resource="http://www.example.org/ontology#roleContext"/>    <owl:someValuesFrom rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SimpleDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Simple Data Element</rdfs:label>    <rdfs:comment>An atomic data value within a composite or segment.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedRole">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#PivotOrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#AgentRole"/>    <rdfs:label>assigned role</rdfs:label>    <rdfs:comment>The role assigned to an organization in a particular context.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isRoleAssignedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isContainedInEnvelope">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Message"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InterchangeEnvelope"/>    <rdfs:label>contained in envelope</rdfs:label>    <rdfs:comment>Indicates the envelope in which this message is contained.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#containsMessage"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasCompositeDataElement">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#SimpleDataElement"/>    <rdfs:label>has composite data element</rdfs:label>    <rdfs:comment>Links a composite data element to its simple data elements.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isCompositeDataElementOf"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#SummarySection">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:subClassOf rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>Summary Section</rdfs:label>    <rdfs:comment>Contains totals such as tax and invoice amount.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isWarehouseAddressOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Address"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>warehouse address of organization</rdfs:label>    <rdfs:comment>Indicates the organization for which this is a warehouse address.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasWarehouseAddress"/>  </rdf:Description>  <rdf:Description rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab4">    <rdf:first rdf:resource="http://www.example.org/ontology#DetailSection"/>    <rdf:rest rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab5"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isInvolvedInInvoice">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:label>involved in invoice</rdfs:label>    <rdfs:comment>Indicates the invoice message in which this organization is involved.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#involvesOrganization"/>  </rdf:Description>  <rdf:Description rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab14">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <owl:intersectionOf rdf:nodeID="ncc5708b77efe46688f1f49f2e5b6cffab18"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isOrganizationAssignedIn">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#PivotOrganizationRoleAssignment"/>    <rdfs:label>organization assigned in assignment</rdfs:label>    <rdfs:comment>Indicates the role assignment in which this organization is assigned.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#assignedOrganization"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Organization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Organization</rdfs:label>    <rdfs:comment>A legal entity involved in the transaction, such as buyer or supplier.</rdfs:comment>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#AgentRole"/>    <owl:disjointWith rdf:resource="http://www.example.org/ontology#Item"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#assignedOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#PivotOrganizationRoleAssignment"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>assigned organization</rdfs:label>    <rdfs:comment>The organization assigned a role in a particular context.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isOrganizationAssignedIn"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#hasDocumentDate">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#HeaderSection"/>    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>    <rdfs:label>has document date</rdfs:label>    <rdfs:comment>The date of the document (string format).</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#Tax">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>    <rdfs:label>Tax</rdfs:label>    <rdfs:comment>A tax applied to the invoice or items.</rdfs:comment>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#involvesOrganization">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#InvoiceMessage"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Organization"/>    <rdfs:label>involves organization</rdfs:label>    <rdfs:comment>Links an invoice to an involved organization.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#isInvolvedInInvoice"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isSegmentDataOf">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http://www.example.org/ontology#CompositeDataElement"/>    <rdfs:range rdf:resource="http://www.example.org/ontology#Segment"/>    <rdfs:label>segment data of segment</rdfs:label>    <rdfs:comment>Indicates the segment for which this is a composite data element.</rdfs:comment>    <owl:inverseOf rdf:resource="http://www.example.org/ontology#hasSegmentData"/>  </rdf:Description>  <rdf:Description rdf:about="http://www.example.org/ontology#isNetPriceOfItem">    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>    <rdfs:domain rdf:resource="http:/