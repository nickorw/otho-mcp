        "arguments": "{\"key\":\"current_owl\",\"value\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\\n  rdfs:label \\\"EDIFACT D96A INVOIC Ontology\\\" ;\\n  rdfs:comment \\\"A profound OWL ontology for the UN/EDIFACT D96A INVOIC message, including all foundational and mandatory segments, roles, and data structures as per EANCOM, EN 16931-1, and P2P-O alignment.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:InterchangeEnvelope a owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"The EDIFACT interchange envelope, containing one or more messages.\\\" .\\n:Message a owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A digital business message within an interchange envelope.\\\" .\\n:InvoiceMessage a owl:Class ;\\n  rdfs:subClassOf :Message ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An EDIFACT INVOIC message for global trade transactions.\\\" .\\n:Segment a owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A logical segment within an EDIFACT message.\\\" .\\n:BGMSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n:NADSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n:DTMSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"DTM Segment\\\" ;\\n  rdfs:comment \\\"Date/Time/Period segment for document and delivery dates.\\\" .\\n:MOASegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"MOA Segment\\\" ;\\n  rdfs:comment \\\"Monetary Amount segment for invoice and line item amounts.\\\" .\\n:RFFSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"RFF Segment\\\" ;\\n  rdfs:comment \\\"Reference segment for document and order references.\\\" .\\n:LINSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"LIN Segment\\\" ;\\n  rdfs:comment \\\"Line Item segment for item identification.\\\" .\\n:PIASegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PIA Segment\\\" ;\\n  rdfs:comment \\\"Additional Product ID segment for alternative item codes.\\\" .\\n:QTYSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"QTY Segment\\\" ;\\n  rdfs:comment \\\"Quantity segment for line item quantities.\\\" .\\n:PRISegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PRI Segment\\\" ;\\n  rdfs:comment \\\"Price segment for unit prices.\\\" .\\n:TAXSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"TAX Segment\\\" ;\\n  rdfs:comment \\\"Tax segment for tax breakdowns.\\\" .\\n:ALCSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"ALC Segment\\\" ;\\n  rdfs:comment \\\"Allowance or Charge segment for discounts or surcharges.\\\" .\\n:UNSSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"UNS Segment\\\" ;\\n  rdfs:comment \\\"Section Control segment for totals separation.\\\" .\\n:CompositeDataElement a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"A composite data element in a segment.\\\" .\\n:SimpleDataElement a owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple data element within a composite.\\\" .\\n:HeaderSection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:comment \\\"Header section of the invoice message.\\\" .\\n:DetailSection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:comment \\\"Detail section with line items.\\\" .\\n:SummarySection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:comment \\\"Summary section with totals and taxes.\\\" .\\n:Organization a owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"A party involved in the invoice, potentially in multiple roles.\\\" .\\n:AgentRole a owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in the invoice (e.g., Buyer, Supplier).\\\" .\\n:BuyerRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Buyer Role\\\" ;\\n  rdfs:comment \\\"Role of the buyer in the invoice.\\\" .\\n:DeliveryPartyRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Delivery Party Role\\\" ;\\n  rdfs:comment \\\"Role of the delivery party in the invoice.\\\" .\\n:Address a owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"A postal or physical address for an organization.\\\" .\\n:GlobalLocationNumber a owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A unique identifier for an organization's location.\\\" .\\n:Item a owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"A product or service sold in the invoice.\\\" .\\n:Price a owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"A price associated with an item.\\\" .\\n:Quantity a owl:Class ;\\n  rdfs:label \\\"Quantity\\\" ;\\n  rdfs:comment \\\"A quantity of an item.\\\" .\\n:Tax a owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"A tax breakdown for the invoice or line item.\\\" .\\n:BusinessProcess a owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"A business process to which the invoice can be assigned.\\\" .\\n:ValidationCon