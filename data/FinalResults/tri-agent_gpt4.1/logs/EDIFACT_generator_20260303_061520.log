2026-03-03 06:23:07 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\n  rdfs:label \"EDIFACT D96A INVOIC Ontology\" ;\n  rdfs:comment \"A profound OWL ontology for the UN/EDIFACT D96A INVOIC message, including all foundational and mandatory segments, roles, and data structures as per EANCOM, EN 16931-1, and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The EDIFACT interchange envelope, containing one or more messages.\" .\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A digital business message within an interchange envelope.\" .\n:InvoiceMessage a owl:Class ;\n  rdfs:subClassOf :Message ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An EDIFACT INVOIC message for global trade transactions.\" .\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A logical segment within an EDIFACT message.\" .\n:BGMSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"BGM Segment\" ;\n  rdfs:comment \"Beginning of Message segment for document identification.\" .\n:NADSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"NAD Segment\" ;\n  rdfs:comment \"Name and Address segment for participant details.\" .\n:DTMSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"DTM Segment\" ;\n  rdfs:comment \"Date/Time/Period segment for document and delivery dates.\" .\n:MOASegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"MOA Segment\" ;\n  rdfs:comment \"Monetary Amount segment for invoice and line item amounts.\" .\n:RFFSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"RFF Segment\" ;\n  rdfs:comment \"Reference segment for document and order references.\" .\n:LINSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"LIN Segment\" ;\n  rdfs:comment \"Line Item segment for item identification.\" .\n:PIASegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"PIA Segment\" ;\n  rdfs:comment \"Additional Product ID segment for alternative item codes.\" .\n:QTYSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"QTY Segment\" ;\n  rdfs:comment \"Quantity segment for line item quantities.\" .\n:PRISegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"PRI Segment\" ;\n  rdfs:comment \"Price segment for unit prices.\" .\n:TAXSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"TAX Segment\" ;\n  rdfs:comment \"Tax segment for tax breakdowns.\" .\n:ALCSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"ALC Segment\" ;\n  rdfs:comment \"Allowance or Charge segment for discounts or surcharges.\" .\n:UNSSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"UNS Segment\" ;\n  rdfs:comment \"Section Control segment for totals separation.\" .\n:CompositeDataElement a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element in a segment.\" .\n:SimpleDataElement a owl:Class ;\n  rdfs:subClassOf :CompositeDataElement ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element within a composite.\" .\n:HeaderSection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Header section of the invoice message.\" .\n:DetailSection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Detail section with line items.\" .\n:SummarySection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Summary section with totals and taxes.\" .\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"A party involved in the invoice, potentially in multiple roles.\" .\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in the invoice (e.g., Buyer, Supplier).\" .\n:BuyerRole a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Buyer Role\" ;\n  rdfs:comment \"Role of the buyer in the invoice.\" .\n:DeliveryPartyRole a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Delivery Party Role\" ;\n  rdfs:comment \"Role of the delivery party in the invoice.\" .\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal or physical address for an organization.\" .\n:GlobalLocationNumber a owl:Class ;\n  rdfs:label \"Global Location Number\" ;\n  rdfs:comment \"A unique identifier for an organization's location.\" .\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service sold in the invoice.\" .\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A price associated with an item.\" .\n:Quantity a owl:Class ;\n  rdfs:label \"Quantity\" ;\n  rdfs:comment \"A quantity of an item.\" .\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"A tax breakdown for the invoice or line item.\" .\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice can be assigned.\" .\n:ValidationConstraint a owl:Class ;\n  rdfs:label \"Validation Constraint\" ;\n  rdfs:comment \"A constraint for automated validation (e.g., SHACL rule).\" .\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A pivot class for reifying the sale of an item with price and quantity.\" ;\n  owl:equivalentClass [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ] .\n:RoleAssignment a owl:Class ;\n  rdfs:label \"Role Assignment\" ;\n  rdfs:comment \"A pivot class reifying an organization-role-address relationship.\" ;\n  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:allValuesFrom :AgentRole ] .\n:InvoiceAmount a owl:Class ;\n  rdfs:label \"Invoice Amount\" ;\n  rdfs:comment \"The total invoice amount.\" .\n:ReferenceNumber a owl:Class ;\n  rdfs:label \"Reference Number\" ;\n  rdfs:comment \"A reference number for the invoice or related document.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n:containsMessage a owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Links an interchange envelope to a message.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message .\n:containsMessage a owl:FunctionalProperty .\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Links a message to its segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n:hasHeaderSection a owl:ObjectProperty ;\n  rdfs:label \"has header section\" ;\n  rdfs:comment \"Links an invoice message to its header section.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection .\n:hasHeaderSection a owl:FunctionalProperty .\n:hasDetailSection a owl:ObjectProperty ;\n  rdfs:label \"has detail section\" ;\n  rdfs:comment \"Links an invoice message to its detail section.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :DetailSection .\n:hasDetailSection a owl:FunctionalProperty .\n:hasSummarySection a owl:ObjectProperty ;\n  rdfs:label \"has summary section\" ;\n  rdfs:comment \"Links an invoice message to its summary section.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SummarySection .\n:hasSummarySection a owl:FunctionalProperty .\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links a detail section to a line item.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n:describesItem a owl:ObjectProperty ;\n  rdfs:label \"describes item\" ;\n  rdfs:comment \"Links a line item to the item being sold.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n:hasNetPrice a owl:ObjectProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Links a line item to its net price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price .\n:hasNetPrice a owl:FunctionalProperty .\n:hasQuantity a owl:ObjectProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Links a line item to its quantity.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Quantity .\n:hasQuantity a owl:FunctionalProperty .\n:involvesOrganization a owl:ObjectProperty ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Links an invoice message to an involved organization.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Organization .\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Links an invoice message to a role assignment.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :RoleAssignment .\n:assignedRole a owl:ObjectProperty ;\n  rdfs:label \"assigned role\" ;\n  rdfs:comment \"Links a role assignment to an agent role.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole .\n:assignedRole a owl:FunctionalProperty .\n:assignedOrganization a owl:ObjectProperty ;\n  rdfs:label \"assigned organization\" ;\n  rdfs:comment \"Links a role assignment to an organization.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization .\n:assignedOrganization a owl:FunctionalProperty .\n:assignedAddress a owl:ObjectProperty ;\n  rdfs:label \"assigned address\" ;\n  rdfs:comment \"Links a role assignment to an address.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Address .\n:hasInvoiceAmount a owl:ObjectProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Links a summary section to the invoice amount.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :InvoiceAmount .\n:hasInvoiceAmount a owl:FunctionalProperty .\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Links a summary section to tax breakdowns.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax .\n:hasBusinessProcess a owl:ObjectProperty ;\n  rdfs:label \"has business process\" ;\n  rdfs:comment \"Links an invoice message to a business process.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess .\n:hasValidationConstraint a owl:ObjectProperty ;\n  rdfs:label \"has validation constraint\" ;\n  rdfs:comment \"Links an invoice message to a validation constraint (e.g., SHACL rule).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :ValidationConstraint .\n\n#################################################################\n# Data Properties\n#################################################################\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\n  rdfs:label \"has Global Location Number\" ;\n  rdfs:comment \"Links an organization to its GLN identifier.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string .\n:hasGlobalLocationNumber a owl:FunctionalProperty .\n:hasReferenceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Links an invoice message to its reference number.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string .\n:hasReferenceNumber a owl:FunctionalProperty .\n:hasDate a owl:DatatypeProperty ;\n  rdfs:label \"has date\" ;\n  rdfs:comment \"Links a DTM segment to a date value.\" ;\n  rdfs:domain :DTMSegment ;\n  rdfs:range xsd:string .\n:hasDate a owl:FunctionalProperty .\n:hasDateQualifier a owl:DatatypeProperty ;\n  rdfs:label \"has date qualifier\" ;\n  rdfs:comment \"Links a DTM segment to a qualifier indicating the type of date (e.g., invoice, delivery).\" ;\n  rdfs:domain :DTMSegment ;\n  rdfs:range xsd:string .\n:hasDateQualifier a owl:FunctionalProperty .\n:hasAmount a owl:DatatypeProperty ;\n  rdfs:label \"has amount\" ;\n  rdfs:comment \"Links a MOA segment to a monetary amount.\" ;\n  rdfs:domain :MOASegment ;\n  rdfs:range xsd:decimal .\n:hasAmount a owl:FunctionalProperty .\n:hasAmountQualifier a owl:DatatypeProperty ;\n  rdfs:label \"has amount qualifier\" ;\n  rdfs:comment \"Links a MOA segment to a qualifier indicating the type of amount (e.g., invoice total, line total).\" ;\n  rdfs:domain :MOASegment ;\n  rdfs:range xsd:string .\n:hasAmountQualifier a owl:FunctionalProperty .\n:hasReference a owl:DatatypeProperty ;\n  rdfs:label \"has reference\" ;\n  rdfs:comment \"Links an RFF segment to a reference value.\" ;\n  rdfs:domain :RFFSegment ;\n  rdfs:range xsd:string .\n:hasReference a owl:FunctionalProperty .\n:hasReferenceQualifier a owl:DatatypeProperty ;\n  rdfs:label \"has reference qualifier\" ;\n  rdfs:comment \"Links an RFF segment to a qualifier indicating the type of reference (e.g., order, invoice).\" ;\n  rdfs:domain :RFFSegment ;\n  rdfs:range xsd:string .\n:hasReferenceQualifier a owl:FunctionalProperty .\n:hasLineNumber a owl:DatatypeProperty ;\n  rdfs:label \"has line number\" ;\n  rdfs:comment \"Links a LIN segment to the line item number.\" ;\n  rdfs:domain :LINSegment ;\n  rdfs:range xsd:integer .\n:hasLineNumber a owl:FunctionalProperty .\n:hasProductID a owl:DatatypeProperty ;\n  rdfs:label \"has product ID\" ;\n  rdfs:comment \"Links a LIN segment to the primary product identifier.\" ;\n  rdfs:domain :LINSegment ;\n  rdfs:range xsd:string .\n:hasAdditionalProductID a owl:DatatypeProperty ;\n  rdfs:label \"has additional product ID\" ;\n  rdfs:comment \"Links a PIA segment to an additional product identifier.\" ;\n  rdfs:domain :PIASegment ;\n  rdfs:range xsd:string .\n:hasQuantityValue a owl:DatatypeProperty ;\n  rdfs:label \"has quantity value\" ;\n  rdfs:comment \"Links a QTY segment to the quantity value.\" ;\n  rdfs:domain :QTYSegment ;\n  rdfs:range xsd:decimal .\n:hasQuantityValue a owl:FunctionalProperty .\n:hasQuantityQualifier a owl:DatatypeProperty ;\n  rdfs:label \"has quantity qualifier\" ;\n  rdfs:comment \"Links a QTY segment to a qualifier indicating the type of quantity (e.g., invoiced, ordered).\" ;\n  rdfs:domain :QTYSegment ;\n  rdfs:range xsd:string .\n:hasQuantityQualifier a owl:FunctionalProperty .\n:hasUnitPrice a owl:DatatypeProperty ;\n  rdfs:label \"has unit price\" ;\n  rdfs:comment \"Links a PRI segment to the unit price value.\" ;\n  rdfs:domain :PRISegment ;\n  rdfs:range xsd:decimal .\n:hasUnitPrice a owl:FunctionalProperty .\n:hasPriceQualifier a owl:DatatypeProperty ;\n  rdfs:label \"has price qualifier\" ;\n  rdfs:comment \"Links a PRI segment to a qualifier indicating the type of price (e.g., net, gross).\" ;\n  rdfs:domain :PRISegment ;\n  rdfs:range xsd:string .\n:hasPriceQualifier a owl:FunctionalProperty .\n:hasTaxType a owl:DatatypeProperty ;\n  rdfs:label \"has tax type\" ;\n  rdfs:comment \"Links a TAX segment to the tax type.\" ;\n  rdfs:domain :TAXSegment ;\n  rdfs:range xsd:string .\n:hasTaxType a owl:FunctionalProperty .\n:hasTaxAmount a owl:DatatypeProperty ;\n  rdfs:label \"has tax amount\" ;\n  rdfs:comment \"Links a TAX segment to the tax amount.\" ;\n  rdfs:domain :TAXSegment ;\n  rdfs:range xsd:decimal .\n:hasTaxAmount a owl:FunctionalProperty .\n:hasAllowanceChargeType a owl:DatatypeProperty ;\n  rdfs:label \"has allowance/charge type\" ;\n  rdfs:comment \"Links an ALC segment to the type of allowance or charge.\" ;\n  rdfs:domain :ALCSegment ;\n  rdfs:range xsd:string .\n:hasAllowanceChargeType a owl:FunctionalProperty .\n:hasAllowanceChargeAmount a owl:DatatypeProperty ;\n  rdfs:label \"has allowance/charge amount\" ;\n  rdfs:comment \"Links an ALC segment to the amount of allowance or charge.\" ;\n  rdfs:domain :ALCSegment ;\n  rdfs:range xsd:decimal .\n:hasAllowanceChargeAmount a owl:FunctionalProperty .\n:hasControlIndicator a owl:DatatypeProperty ;\n  rdfs:label \"has control indicator\" ;\n  rdfs:comment \"Links a UNS segment to a control indicator (e.g., S for summary).\" ;\n  rdfs:domain :UNSSegment ;\n  rdfs:range xsd:string .\n:hasControlIndicator a owl:FunctionalProperty .\n:hasName a owl:DatatypeProperty ;\n  rdfs:label \"has name\" ;\n  rdfs:comment \"The name of an organization.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string .\n:hasName a owl:FunctionalProperty .\n:hasAddressLine a owl:DatatypeProperty ;\n  rdfs:label \"has address line\" ;\n  rdfs:comment \"The address line for an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n:hasAddressLine a owl:FunctionalProperty .\n:hasPostalCode a owl:DatatypeProperty ;\n  rdfs:label \"has postal code\" ;\n  rdfs:comment \"The postal code for an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n:hasPostalCode a owl:FunctionalProperty .\n:hasCity a owl:DatatypeProperty ;\n  rdfs:label \"has city\" ;\n  rdfs:comment \"The city for an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n:hasCity a owl:FunctionalProperty .\n:hasCountry a owl:DatatypeProperty ;\n  rdfs:label \"has country\" ;\n  rdfs:comment \"The country for an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n:hasCountry a owl:FunctionalProperty .\n\n#################################################################\n# Disjointness and Unions\n#################################################################\n:Organization owl:disjointWith :Item .\n:Address owl:disjointWith :Organization .\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Segment owl:disjointUnionOf ( :BGMSegment :NADSegment :DTMSegment :MOASegment :RFFSegment :LINSegment :PIASegment :QTYSegment :PRISegment :TAXSegment :ALCSegment :UNSSegment :HeaderSection :DetailSection :SummarySection ) .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
