"A line item in the detail section, describing an item, price, and quantity.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value, such as net price or invoice amount.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax amount in the summary section.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice can be assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint used for SHACL validation of invoice data.\\\" .\\n\\n:P2PConcept a owl:Class ;\\n    rdfs:label \\\"P2P-O Concept\\\" ;\\n    rdfs:comment \\\"A concept from the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n#################################################################\\n# Object Properties and Inverse Properties\\n#################################################################\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an envelope to its contained message.\\\" ;\\n    owl:inverseOf :isContainedInEnvelope .\\n\\n:isContainedInEnvelope a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is contained in envelope\\\" ;\\n    rdfs:comment \\\"Inverse property: relates a message to its envelope.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its segments.\\\" ;\\n    owl:inverseOf :isSegmentOfMessage .\\n\\n:isSegmentOfMessage a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of message\\\" ;\\n    rdfs:comment \\\"Inve