        "arguments": "{\"key\":\"current_owl\",\"value\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n:EDIFACTInvoiceOntology rdf:type owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"Ontology for modeling EDIFACT invoices, roles, segments, and D96A compliance based on story and CQs.\\\" .\\n\\n# Classes\\n:InterchangeEnvelope rdf:type owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The envelope that contains EDIFACT messages.\\\" .\\n\\n:Message rdf:type owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:InvoiceMessage rdf:type owl:Class ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"An invoice message (INVOIC) in EDIFACT.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:Segment rdf:type owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment in an EDIFACT message.\\\" .\\n\\n:BGMSegment rdf:type owl:Class ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:NADSegment rdf:type owl:Class ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement rdf:type owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"Composite data element in a segment.\\\" .\\n\\n:SimpleDataElement rdf:type owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"Simple data element in a segment.\\\" .\\n\\n:InvoiceHeader rdf:type owl:Class ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"Header section of the invoice message.\\\" .\\n\\n:InvoiceDetail rdf:type owl:Class ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"Detail section listing line items of the invoice.\\\" .\\n\\n:InvoiceSummary rdf:type owl:Class ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"Summary section of the invoice message.\\\" .\\n\\n:Organization rdf:type owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice.\\\" .\\n\\n:AgentRole rdf:type owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"Role played by an organization in the invoice (e.g., Buyer, Supplier, Delivery Party).\\\" .\\n\\n:RoleAssignment rdf:type owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"Pivot class for assigning AgentRole to Organization within an InvoiceMessage.\\\" .\\n\\n:Address rdf:type owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"Address of an organization.\\\" .\\n\\n:Identifier rdf:type owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"Generic identifier for organizations.\\\" .\\n\\n:GLNIdentifier rdf:type owl:Class ;\\n    rdfs:label \\\"GLN Identifier\\\" ;\\n    rdfs:comment \\\"Global Location Number identifier.\\\" ;\\n    rdfs:subClassOf :Identifier .\\n\\n:LineItem rdf:type owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"An item listed in the invoice detail section.\\\" .\\n\\n:Item rdf:type owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"An item sold in the invoice.\\\" .\\n\\n:Price rdf:type owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"Net price of an item.\\\" .\\n\\n:Tax rdf:type owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"Tax information for the invoice.\\\" .\\n\\n:ReferenceNumber rdf:type owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"Reference number for the invoice document.\\\" .\\n\\n:BusinessProcess rdf:type owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"Business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint rdf:type owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"Constraint for validating the invoice format and content.\\\" .\\n\\n# Disjoint and Union axioms\\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n:Organization owl:disjointWith :Address, :Item, :Identifier .\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment) .\\n:Identifier owl:disjointUnionOf (:GLNIdentifier) .\\n\\n# Object Properties\\n:hasMessage rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has Message\\\" ;\\n    rdfs:comment \\\"Links Interchange Envelope to contained Messages.\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdf:type owl:FunctionalProperty ;\\n    owl:inverseOf :isMessageOf .\\n\\n:isMessageOf rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is Message Of\\\" ;\\n    rdfs:comment \\\"Inverse: Message is part of an Interchange Envelope.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    owl:inverseOf :hasMessage .\\n\\n:hasSegment rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has Segment\\\" ;\\n    rdfs:comment \\\"Links Message to its Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is Segment Of\\\" ;\\n    rdfs:comment \\\"Inverse: Segment is part of a Message.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasHeader rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has Header\\\" ;\\n    rdfs:comment \\\"Links InvoiceMessage to its Header section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader ;\\n    rdf:type owl:FunctionalProper