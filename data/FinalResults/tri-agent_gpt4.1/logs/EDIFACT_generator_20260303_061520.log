    {
      "id": "call_y07mxkJ19DIiJ0eNL3fIeex2",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/storyid> a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT D96A Invoice Ontology\\\" ;\\n    rdfs:comment \\\"Ontology for representing UN/EDIFACT D96A invoice messages, segments, roles, and validation constraints, aligned with EN 16931-1 and P2P-O.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"Top-level EDIFACT envelope containing messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A message within an interchange envelope.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"An EDIFACT INVOIC message representing an invoice.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within a message, such as BGM or NAD.\\\" .\\n\\n:BGMSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"The Beginning of Message (BGM) segment for document identification.\\\" .\\n\\n:NADSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"The Name and Address (NAD) segment for participant details.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"Header section of an invoice message, containing document dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"Detail section of an invoice message, listing line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"Summary section of an invoice message, providing totals and taxes.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite element.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice (buyer, supplier, etc.).\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in a business process (e.g., Buyer, Supplier).\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"Reified association of an organization, a role, and a message context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"An address associated with an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A generic identifier for organizations or items.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:subClassOf :Identifier ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A GLN identifier for organizations.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"An item sold in the invoice.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:subClassOf :Item ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the detail section, describing an item, price, and quantity.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value, such as net price or invoice amount.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax amount in the summary section.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice can be assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint used for SHACL validation of invoice data.\\\" .\\n\\n:P2PConcept a owl:Class ;\\n    rdfs:label \\\"P2P-O Concept\\\" ;\\n    rdfs:comment \\\"A concept from the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n#################################################################\\n# Object Properties and Inverse Properties\\n#################################################################\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an envelope to its contained message.\\\" ;\\n    owl:inverseOf :isContainedInEnvelope .\\n\\n:isContainedInEnvelope a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is contained in envelope\\\" ;\\n    rdfs:comment \\\"Inverse property: relates a message to its envelope.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its segments.\\\" ;\\n    owl:inverseOf :isSegmentOfMessage .\\n\\n:isSegmentOfMessage a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of message\\\" ;\\n    rdfs:comment \\\"Inverse property: rel