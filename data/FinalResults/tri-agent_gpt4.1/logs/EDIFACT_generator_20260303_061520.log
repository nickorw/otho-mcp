ass ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:HeaderSection rdf:type owl:Class ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:comment \\\"Header section of an invoice message, containing dates and reference numbers.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:DetailSection rdf:type owl:Class ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:comment \\\"Detail section listing individual line items.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:SummarySection rdf:type owl:Class ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:comment \\\"Summary section providing totals and tax information.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:Organization rdf:type owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"An organization involved in the invoice, such as buyer or delivery party.\\\" .\\n\\n:AgentRole rdf:type owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in a transaction.\\\" .\\n\\n:RoleAssignment rdf:type owl:Class ;\\n  rdfs:label \\\"Role Assignment\\\" ;\\n  rdfs:comment \\\"A pivot class for reification of organization roles in invoice context.\\\" .\\n\\n:Address rdf:type owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"Address of an organization.\\\" .\\n\\n:Identifier rdf:type owl:Class ;\\n  rdfs:label \\\"Identifier\\\" ;\\n  rdfs:comment \\\"An identifier for an organization.\\\" .\\n\\n:GlobalLocationNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A global location number identifier.\\\" ;\\n  rdfs:subClassOf :Identifier .\\n\\n:Item rdf:type owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"An item sold in the invoice.\\\" .\\n\\n:Price rdf:type owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"Price information for items or invoices.\\\" .\\n\\n:Quantity rdf:type owl:Class ;\\n  rdfs:label \\\"Quantity\\\" ;\\n  rdfs:comment \\\"Quantity of items sold.\\\" .\\n\\n:LineItem rdf:type owl:Class ;\\n  rdfs:label \\\"Line Item\\\" ;\\n  rdfs:comment \\\"A line item in the invoice detail section.\\\" .\\n\\n:Tax rdf:type owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"Tax information in the summary section.\\\" .\\n\\n:ReferenceNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number for document identification.\\\" .\\n\\n:BusinessProcess rdf:type owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"Business process assignment for the invoice.\\\" .\\n\\n:ValidationConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"Constraint for validating invoice messages.\\\" .\\n\\n:EN16931Requirement rdf:type owl:Class ;\\n  rdfs:label \\\"EN 16931 Requirement\\\" ;\\n  rdfs:comment \\\"A requirement from EN 16931-1 standard.\\\" .\\n\\n:P2POntologyReference rdf:type owl:Class ;\\n  rdfs:label \\\"P2P-O Reference\\\" ;\\n  rdfs:comment \\\"Reference to the Purchase-to-Pay Ontology.\\\" .\\n\\n:SHACLConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"SHACL Constraint\\\" ;\\n  rdfs:comment \\\"SHACL constraint for automated validation.\\\" .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n:containsMessage rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains message\\\" ;\\n  rdfs:comment \\\"Relates an interchange envelope to the messages it contains.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasSegment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has segment\\\" ;\\n  rdfs:comment \\\"Relates a message to its constituent segments.\\\" .\\n\\n:hasSection rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has section\\\" ;\\n  rdfs:comment \\\"Relates an invoice message to its header, detail, and summary sections.\\\" .\\n\\n:hasCompositeElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has composite element\\\" ;\\n  rdfs:comment \\\"Relates a segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has simple element\\\" ;\\n  rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" .\\n\\n:playsRole rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"plays role\\\" ;\\n  rdfs:comment \\\"Relates an organization to its role assignment in a transaction.\\\" .\\n\\n:hasRole rdf:type owl:ObjectProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"has role\\\" ;\\n  rdfs:comment \\\"Specifies the agent role played in a role assignment.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:inContextOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"in context of\\\" ;\\n  rdfs:comment \\\"Specifies the invoice message context for a role assignment.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasAddress rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has address\\\" ;\\n  rdfs:comment \\\"Relates an organization to its address.\\\" .\\n\\n:hasIdentifier rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"has identifier\\\" ;\\n  rdfs:comment \\\"Relates an organization to its identifier.\\\" .\\n\\n:isBuyer rdf:type owl:ObjectProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is buyer\\\" ;\\n  rdfs:comment \\\"Specifies the buyer organization in a role assignment.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:isDeliveryParty rdf:type owl:ObjectProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is delivery party\\\" ;\\n  rdfs:comment \\\"Specifies the delivery party organization in a role assignment.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :DetailSection ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"has line item\\\" ;\\n  rdfs:comment \\\"Relates the detail section to its line items.\\\" .\\n\\n:describesItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"describes item\\\" ;\\n  rdfs:comment \\\"Relates a line item to the item it describes.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasNetPrice rdf:type owl:ObjectProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has net price\\\" ;\\n  rdfs:comment \\\"Relates a line item to its net price.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasQuantity rdf:type owl:ObjectProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Quantity ;\\n  rdfs:label \\\"has quantity\\\" ;\\n  rdfs:comment \\\"Relates a line item to its quantity.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasTax rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"has tax\\\" ;\\n  rdfs:comment \\\"Relates the summary section to tax information.\\\" .\\n\\n:hasInvoiceAmount rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has invoice amount\\\" ;\\n  rdfs:comment \\\"Relates the summary section to the total invoice amount.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasReferenceNumber rdf:type owl:ObjectProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :ReferenceNumber ;\\n  rdfs:label \\\"has reference number\\\" ;\\n  rdfs:comment \\\"Relates the header section to a reference number.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasBusinessProcess rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"has business process\\\" ;\\n  rdfs:comment \\\"Assigns a business process to the invoice message.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasValidationConstraint rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint ;\\n  rdfs:label \\\"has validation constraint\\\" ;\\n  rdfs:comment \\\"Relates an invoice message to validation constraints.\\\" .\\n\\n:conformsToEN16931 rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :EN16931Requirement ;\\n  rdfs:label \\\"conforms to EN 16931\\\" ;\\n  rdfs:comment \\\"Indicates that the invoice message conforms to a requirement of EN 16931-1.\\\" .\\n\\n:referencesP2PO rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :P2POntologyReference ;\\n  rdfs:label \\\"references P2P-O\\\" ;\\n  rdfs:comment \\\"Links the invoice message to a reference in the Purchase-to-Pay Ontology.\\\" .\\n\\n:validatedBySHACL rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :SHACLConstraint ;\\n  rdfs:label \\\"validated by SHACL\\\" ;\\n  rdfs:comment \\\"Indicates that the invoice message is validated by a SHACL constraint.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:hasDocumentDate rdf:type owl:DatatypeProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has document date\\\" ;\\n  rdfs:comment \\\"Date of the invoice document.\\\" ;\\n  owl:FunctionalProperty .\\n\\n:hasValue rdf:type owl:DatatypeProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has value\\\" ;\\n  rdfs:comment \\\"The value of a simple data element.\\\" ;\\n  owl:FunctionalProperty .\\n\\n#################################################################\\n# Hierarchies, Disjoint, and DisjointUnion\\n#################################################################\\n:InterchangeEnvelope owl:disjointWith :Message .\\n:Message owl:disjointWith :Segment .\\n:Segment owl:disjointWith :CompositeDataElement .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n:Organization owl:disjointWith :Item .\\n:Address owl:disjointWith :Identifier .\\n:HeaderSection owl:disjointWith :DetailSection .\\n:HeaderSection owl:disjointWith :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :HeaderSection :DetailSection :SummarySection) .\\n\\n#################################################################\\n# Complex Axioms & Restrictions\\n#################################################################\\n:InvoiceMessage owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :hasSection ; owl:allValuesFrom :Segment ] ;\\n  owl:Restriction [ owl:onProperty :hasBusinessProcess ; owl:someValuesFrom :BusinessProcess ] ] .\\n\\n:RoleAssignment owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :hasRole ; owl:allValuesFrom :AgentRole ] ;\\n  owl:Restriction [ owl:onProperty :inContextOf ; owl:allValuesFrom :InvoiceMessage ] ] .\\n\\n:LineItem owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :describesItem ; owl:allValuesFrom :Item ] ;\\n  owl:Restriction [ owl:onProperty :hasNetPrice ; owl:allValuesFrom :Price ] ;\\n  owl:Restriction [ owl:onProperty :hasQuantity ; owl:allValuesFrom :Quantity ] ] .\\n\\n#################################################################\\n# Annotations\\n#################################################################\\n# All classes and properties have rdfs:label and rdfs:comment as required.\\n\"}",
