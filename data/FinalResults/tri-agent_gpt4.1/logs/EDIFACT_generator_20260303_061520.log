      "id": "call_tsleRdUp4C1XKPUn4e9s52UW",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n:EDIFACT_INVOIC_Ontology rdf:type owl:Ontology ;\\n  rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n  rdfs:comment \\\"A deeply structured ontology for representing UN/EDIFACT invoice messages, segments, organizations, and business context, aligned with EN 16931-1 and P2P-O standards.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:InterchangeEnvelope rdf:type owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"Envelope containing EDIFACT messages.\\\" .\\n\\n:Message rdf:type owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A business message within an interchange envelope.\\\" .\\n\\n:InvoiceMessage rdf:type owl:Class ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An invoice message, such as INVOIC, within the interchange envelope.\\\" ;\\n  rdfs:subClassOf :Message .\\n\\n:Segment rdf:type owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGMSegment rdf:type owl:Class ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"Beginning of Message segment for document identification.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:NADSegment rdf:type owl:Class ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"Name and Address segment for participant details.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:HeaderSection rdf:type owl:Class ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:comment \\\"Header section of an invoice message, containing dates and reference numbers.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:DetailSection rdf:type owl:Class ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:comment \\\"Detail section listing individual line items.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:SummarySection rdf:type owl:Class ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:comment \\\"Summary section providing totals and tax information.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:Organization rdf:type owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"An organization involved in the invoice, such as buyer or delivery party.\\\" .\\n\\n:AgentRole rdf:type owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in a transaction.\\\" .\\n\\n:RoleAssignment rdf:type owl:Class ;\\n  rdfs:label \\\"Role Assignment\\\" ;\\n  rdfs:comment \\\"A pivot class for reification of organization roles in invoice context.\\\" .\\n\\n:Address rdf:type owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"Address of an organization.\\\" .\\n\\n:Identifier rdf:type owl:Class ;\\n  rdfs:label \\\"Identifier\\\" ;\\n  rdfs:comment \\\"An identifier for an organization.\\\" .\\n\\n:GlobalLocationNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A global location number identifier.\\\" ;\\n  rdfs:subClassOf :Identifier .\\n\\n:Item rdf:type owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"An item sold in the invoice.\\\" .\\n\\n:Price rdf:type owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"Price information for items or invoices.\\\" .\\n\\n:Quantity rdf:type owl:Class ;\\n  rdfs:label \\\"Quantity\\\" ;\\n  rdfs:comment \\\"Quantity of items sold.\\\" .\\n\\n:LineItem rdf:type owl:Class ;\\n  rdfs:label \\\"Line Item\\\" ;\\n  rdfs:comment \\\"A line item in the invoice detail section.\\\" .\\n\\n:Tax rdf:type owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"Tax information in the summary section.\\\" .\\n\\n:ReferenceNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number for document identification.\\\" .\\n\\n:BusinessProcess rdf:type owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"Business process assignment for the invoice.\\\" .\\n\\n:ValidationConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"Constraint for validating invoice messages.\\\" .\\n\\n:EN16931Requirement rdf:type owl:Class ;\\n  rdfs:label \\\"EN 16931 Requirement\\\" ;\\n  rdfs:comment \\\"A requirement from EN 16931-1 standard.\\\" .\\n\\n:P2POntologyReference rdf:type owl:Class ;\\n  rdfs:label \\\"P2P-O Reference\\\" ;\\n  rdfs:comment \\\"Reference to the Purchase-to-Pay Ontology.\\\" .\\n\\n:SHACLConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"SHACL Constraint\\\" ;\\n  rdfs:comment \\\"SHACL constraint for automated validation.\\\" .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n:containsMessage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains message\\\" ;\\n  rdfs:comment \\\"Relates an interchange envelope to the messages it contains.\\\" ;\\n  owl:inverseOf :isContainedInEnvelope .\\n\\n:isContainedInEnvelope rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :InterchangeEnvelope ;\\n  rdfs:label \\\"is contained in envelope\\\" ;\\n  rdfs:comment \\\"Inverse of containsMessage: relates a message to the envelope that contains it.\\\" ;\\n  owl:inverseOf :containsMessage .\\n\\n:hasSegment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has segment\\\" ;\\n  rdfs:comment \\\"Relates a message to its constituent segments.\\\" ;\\n  owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"is segment of\\\" ;\\n  rdfs:comment \\\"Inverse of hasSegment: relates a segment to the message it is part of.\\\" ;\\n  owl:inverseOf :hasSegment .\\n\\n:hasSection rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has section\\\" ;\\n  rdfs:comment \\\"Relates an invoice message to its header, detail, and summary sections.\\\" ;\\n  owl:inverseOf :isSectionOf .\\n\\n:isSectionOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is section of\\\" ;\\n  rdfs:comment \\\"Inverse of hasSection: relates a section to its invoice message.\\\" ;\\n  owl:inverseOf :hasSection .\\n\\n:hasCompositeElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has composite element\\\" ;\\n  rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n  owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"is composite element of\\\" ;\\n  rdfs:comment \\\"Inverse of hasCompositeElement: relates a composite data element to its segment.\\\" ;\\n  owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has simple element\\\" ;\\n  rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" ;\\n  owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"is simple element of\\\" ;\\n  rdfs:comment \\\"Inverse of hasSimpleElement: relates a simple data element to its composite data element.\\\" ;\\n  owl:inverseOf :hasSimpleElement .\\n\\n:playsRole rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"plays role\\\" ;\\n  rdfs:comment \\\"Relates an organization to its role assignment in a transaction.\\\" ;\\n  owl:inverseOf :rolePlayedBy .\\n\\n:rolePlayedBy rdf:type owl:ObjectProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"role played by\\\" ;\\n  rdfs:comment \\\"Inverse of playsRole: relates a role assignment to the organization that plays it.\\\" ;\\n  owl:inverseOf :playsRole .\\n\\n:hasRole rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"has role\\\" ;\\n  rdfs:comment \\\"Specifies the agent role played in a role assignment.\\\" ;\\n  owl:inverseOf :isRoleOf .\\n\\n:isRoleOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :AgentRole ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"is role of\\\" ;\\n  rdfs:comment \\\"Inverse of hasRole: relates an agent role to the role assignment it is part of.\\\" ;\\n  owl:inverseOf :hasRole .\\n\\n:inContextOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"in context of\\\" ;\\n  rdfs:comment \\\"Specifies the invoice message context for a role assignment.\\\" ;\\n  owl:inverseOf :contextHasRoleAssignment .\\n\\n:contextHasRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"context has role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of inContextOf: relates an invoice message to its role assignments.\\\" ;\\n  owl:inverseOf :inContextOf .\\n\\n:hasAddress rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has address\\\" ;\\n  rdfs:comment \\\"Relates an organization to its address.\\\" ;\\n  owl:inverseOf :isAddressOf .\\n\\n:isAddressOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Address ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is address of\\\" ;\\n  rdfs:comment \\\"Inverse of hasAddress: relates an address to the organization it belongs to.\\\" ;\\n  owl:inverseOf :hasAddress .\\n\\n:hasIdentifier rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"has identifier\\\" ;\\n  rdfs:comment \\\"Relates an organization to its identifier.\\\" ;\\n  owl:inverseOf :isIdentifierOf .\\n\\n:isIdentifierOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is identifier of\\\" ;\\n  rdfs:comment \\\"Inverse of hasIdentifier: relates an identifier to the organization it belongs to.\\\" ;\\n  owl:inverseOf :hasIdentifier .\\n\\n:isBuyer rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is buyer\\\" ;\\n  rdfs:comment \\\"Specifies the buyer organization in a role assignment.\\\" ;\\n  owl:inverseOf :buyerRoleAssignment .\\n\\n:buyerRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"buyer role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of isBuyer: relates an organization to the buyer role assignment.\\\" ;\\n  owl:inverseOf :isBuyer .\\n\\n:isDeliveryParty rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is delivery party\\\" ;\\n  rdfs:comment \\\"Specifies the delivery party organization in a role assignment.\\\" ;\\n  owl:inverseOf :deliveryPartyRoleAssignment .\\n\\n:deliveryPartyRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"delivery party role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of isDeliveryParty: relates an organization to the delivery party role assignment.\\\" ;\\n  owl:inverseOf :isDeliveryParty .\\n\\n:hasLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :DetailSection ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"has line item\\\" ;\\n  rdfs:comment \\\"Relates the detail section to its line items.\\\" ;\\n  owl:inverseOf :isLineItemOf .\\n\\n:isLineItemOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :DetailSection ;\\n  rdfs:label \\\"is line item of\\\" ;\\n  rdfs:comment \\\"Inverse of hasLineItem: relates a line item to the detail section it belongs to.\\\" ;\\n  owl:inverseOf :hasLineItem .\\n\\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"describes item\\\" ;\\n  rdfs:comment \\\"Relates a line item to the item it describes.\\\" ;\\n  owl:inverseOf :isDescribedByLineItem .\\n\\n:isDescribedByLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Item ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"is described by line item\\\" ;\\n  rdfs:comment \\\"Inverse of describesItem: relates an item to the line item that describes it.\\\" ;\\n  owl:inverseOf :describesItem .\\n\\n:hasNetPrice rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has net price\\\" ;\\n  rdfs:comment \\\"Relates a line item to its net price.\\\" ;\\n  owl:inverseOf :isNetPriceOf .\\n\\n:isNetPriceOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Price ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"is net price of\\\" ;\\n  rdfs:comment \\\"Inverse of hasNetPrice: relates a price to the line item it is the net price for.\\\" ;\\n  owl:inverseOf :hasNetPrice .\\n\\n:hasQuantity rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Quantity ;\\n  rdfs:label \\\"has quantity\\\" ;\\n  rdfs:comment \\\"Relates a line item to its quantity.\\\" ;\\n  owl:inverseOf :isQuantityOf .\\n\\n:isQuantityOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Quantity ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"is quantity of\\\" ;\\n  rdfs:comment \\\"Inverse of hasQuantity: relates a quantity to the line item it is for.\\\" ;\\n  owl:inverseOf :hasQuantity .\\n\\n:hasTax rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"has tax\\\" ;\\n  rdfs:comment \\\"Relates the summary section to tax information.\\\" ;\\n  owl:inverseOf :isTaxOf .\\n\\n:isTaxOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Tax ;\\n  rdfs:range :SummarySection ;\\n  rdfs:label \\\"is tax of\\\" ;\\n  rdfs:comment \\\"Inverse of hasTax: relates a tax to the summary section it is part of.\\\" ;\\n  owl:inverseOf :hasTax .\\n\\n:hasInvoiceAmount rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has invoice amount\\\" ;\\n  rdfs:comment \\\"Relates the summary section to the total invoice amount.\\\" ;\\n  owl:inverseOf :isInvoiceAmountOf .\\n\\n:isInvoiceAmountOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Price ;\\n  rdfs:range :SummarySection ;\\n  rdfs:label \\\"is invoice amount of\\\" ;\\n  rdfs:comment \\\"Inverse of hasInvoiceAmount: relates a price to the summary section it is the total for.\\\" ;\\n  owl:inverseOf :hasInvoiceAmount .\\n\\n:hasReferenceNumber rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :ReferenceNumber ;\\n  rdfs:label \\\"has reference number\\\" ;\\n  rdfs:comment \\\"Relates the header section to a reference number.\\\" ;\\n  owl:inverseOf :isReferenceNumberOf .\\n\\n:isReferenceNumberOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :ReferenceNumber ;\\n  rdfs:range :HeaderSection ;\\n  rdfs:label \\\"is reference number of\\\" ;\\n  rdfs:comment \\\"Inverse of hasReferenceNumber: relates a reference number to the header section it identifies.\\\" ;\\n  owl:inverseOf :hasReferenceNumber .\\n\\n:hasBusinessProcess rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"has business process\\\" ;\\n  rdfs:comment \\\"Assigns a business process to the invoice message.\\\" ;\\n  owl:inverseOf :isBusinessProcessOf .\\n\\n:isBusinessProcessOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :BusinessProcess ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is business process of\\\" ;\\n  rdfs:comment \\\"Inverse of hasBusinessProcess: relates a business process to the invoice message it is assigned to.\\\" ;\\n  owl:inverseOf :hasBusinessProcess .\\n\\n:hasValidationConstraint rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint ;\\n  rdfs:label \\\"has validation constraint\\\" ;\\n  rdfs:comment \\\"Relates an invoice message to validation constraints.\\\" ;\\n  owl:inverseOf :isValidationConstraintOf .\\n\\n:isValidationConstraintOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :ValidationConstraint ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is validation constraint of\\\" ;\\n  rdfs:comment \\\"Inverse of hasValidationConstraint: relates a validation constraint to the invoice message it validates.\\\" ;\\n  owl:inverseOf :hasValidationConstraint .\\n\\n:conformsToEN16931 rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :EN16931Requirement ;\\n  rdfs:label \\\"conforms to EN 16931\\\" ;\\n  rdfs:comment \\\"Indicates that the invoice message conforms to a requirement of EN 16931-1.\\\" ;\\n  owl:inverseOf :isEN16931RequirementOf .\\n\\n:isEN16931RequirementOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :EN16931Requirement ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is EN16931 requirement of\\\" ;\\n  rdfs:comment \\\"Inverse of conformsToEN16931: relates an EN16931 requirement to the invoice message it applies to.\\\" ;\\n  owl:inverseOf :conformsToEN16931 .\\n\\n:referencesP2PO rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :P2POntologyReference ;\\n  rdfs:label \\\"references P2P-O\\\" ;\\n  rdfs:comment \\\"Links the invoice message to a reference in the Purchase-to-Pay Ontology.\\\" ;\\n  owl:inverseOf :isReferencedByInvoiceMessage .\\n\\n:isReferencedByInvoiceMessage rdf:type owl:ObjectProperty ;\\n  rdfs:domain :P2POntologyReference ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is referenced by invoice message\\\" ;\\n  rdfs:comment \\\"Inverse of referencesP2PO: relates a P2P-O reference to the invoice message that references it.\\\" ;\\n  owl:inverseOf :referencesP2PO .\\n\\n:validatedBySHACL rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :SHACLConstraint ;\\n  rdfs:label \\\"validated by SHACL\\\" ;\\n  rdfs:comment \\\"Indicates that the invoice message is validated by a SHACL constraint.\\\" ;\\n  owl:inverseOf :isSHACLConstraintOf .\\n\\n:isSHACLConstraintOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SHACLConstraint ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is SHACL constraint of\\\" ;\\n  rdfs:comment \\\"Inverse of validatedBySHACL: relates a SHACL constraint to the invoice message it validates.\\\" ;\\n  owl:inverseOf :validatedBySHACL .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:hasDocumentDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has document date\\\" ;\\n  rdfs:comment \\\"Date of the invoice document.\\\" .\\n\\n:hasValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has value\\\" ;\\n  rdfs:comment \\\"The value of a simple data element.\\\" .\\n\\n#################################################################\\n# Hierarchies, Disjoint, and DisjointUnion\\n#################################################################\\n:InterchangeEnvelope owl:disjointWith :Message .\\n:Message owl:disjointWith :Segment .\\n:Segment owl:disjointWith :CompositeDataElement .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n:Organization owl:disjointWith :Item .\\n:Address owl:disjointWith :Identifier .\\n:HeaderSection owl:disjointWith :DetailSection .\\n:HeaderSection owl:disjointWith :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :HeaderSection :DetailSection :SummarySection) .\\n\\n#################################################################\\n# Complex Axioms & Restrictions\\n#################################################################\\n:InvoiceMessage owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:intersectionOf (\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :Segment ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasBusinessProcess ; owl:someValuesFrom :BusinessProcess ]\\n  )\\n] .\\n\\n:RoleAssignment owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:intersectionOf (\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:allValuesFrom :AgentRole ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :inContextOf ; owl:allValuesFrom :InvoiceMessage ]\\n  )\\n] .\\n\\n:LineItem owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:intersectionOf (\\n    [ rdf:type owl:Restriction ; owl:onProperty :describesItem ; owl:allValuesFrom :Item ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom :Price ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:allValuesFrom :Quantity ]\\n  )\\n] .\\n\\n#################################################################\\n# Annotations\\n#################################################################\\n# All classes and properties have rdfs:label and rdfs:comment as required.\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
    {
      "id": "call_yGGB0XSGNi1ec6sISF8czEf9",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n:EDIFACT_INVOIC_Ontology rdf:type owl:Ontology ;\\n  rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n  rdfs:comment \\\"A deeply structured ontology for representing UN/EDIFACT invoice messages, segments, organizations, and business context, aligned with EN 16931-1 and P2P-O standards.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:InterchangeEnvelope rdf:type owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"Envelope containing EDIFACT messages.\\\" .\\n\\n:Message rdf:type owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A business message within an interchange envelope.\\\" .\\n\\n:InvoiceMessage rdf:type owl:Class ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An invoice message, such as INVOIC, within the interchange envelope.\\\" ;\\n  rdfs:subClassOf :Message .\\n\\n:Segment rdf:type owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGMSegment rdf:type owl:Class ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"Beginning of Message segment for document identification.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:NADSegment rdf:type owl:Class ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"Name and Address segment for participant details.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:HeaderSection rdf:type owl:Class ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:comment \\\"Header section of an invoice message, containing dates and reference numbers.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:DetailSection rdf:type owl:Class ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:comment \\\"Detail section listing individual line items.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:SummarySection rdf:type owl:Class ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:comment \\\"Summary section providing totals and tax information.\\\" ;\\n  rdfs:subClassOf :Segment .\\n\\n:Organization rdf:type owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"An organization involved in the invoice, such as buyer or delivery party.\\\" .\\n\\n:AgentRole rdf:type owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in a transaction.\\\" .\\n\\n:RoleAssignment rdf:type owl:Class ;\\n  rdfs:label \\\"Role Assignment\\\" ;\\n  rdfs:comment \\\"A pivot class for reification of organization roles in invoice context.\\\" .\\n\\n:Address rdf:type owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"Address of an organization.\\\" .\\n\\n:Identifier rdf:type owl:Class ;\\n  rdfs:label \\\"Identifier\\\" ;\\n  rdfs:comment \\\"An identifier for an organization.\\\" .\\n\\n:GlobalLocationNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A global location number identifier.\\\" ;\\n  rdfs:subClassOf :Identifier .\\n\\n:Item rdf:type owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"An item sold in the invoice.\\\" .\\n\\n:Price rdf:type owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"Price information for items or invoices.\\\" .\\n\\n:Quantity rdf:type owl:Class ;\\n  rdfs:label \\\"Quantity\\\" ;\\n  rdfs:comment \\\"Quantity of items sold.\\\" .\\n\\n:LineItem rdf:type owl:Class ;\\n  rdfs:label \\\"Line Item\\\" ;\\n  rdfs:comment \\\"A line item in the invoice detail section.\\\" .\\n\\n:Tax rdf:type owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"Tax information in the summary section.\\\" .\\n\\n:ReferenceNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number for document identification.\\\" .\\n\\n:BusinessProcess rdf:type owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"Business process assignment for the invoice.\\\" .\\n\\n:ValidationConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"Constraint for validating invoice messages.\\\" .\\n\\n:EN16931Requirement rdf:type owl:Class ;\\n  rdfs:label \\\"EN 16931 Requirement\\\" ;\\n  rdfs:comment \\\"A requirement from EN 16931-1 standard.\\\" .\\n\\n:P2POntologyReference rdf:type owl:Class ;\\n  rdfs:label \\\"P2P-O Reference\\\" ;\\n  rdfs:comment \\\"Reference to the Purchase-to-Pay Ontology.\\\" .\\n\\n:SHACLConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"SHACL Constraint\\\" ;\\n  rdfs:comment \\\"SHACL constraint for automated validation.\\\" .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n:containsMessage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains message\\\" ;\\n  rdfs:comment \\\"Relates an interchange envelope to the messages it contains.\\\" ;\\n  owl:inverseOf :isContainedInEnvelope .\\n\\n:isContainedInEnvelope rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :InterchangeEnvelope ;\\n  rdfs:label \\\"is contained in envelope\\\" ;\\n  rdfs:comment \\\"Inverse of containsMessage: relates a message to the envelope that contains it.\\\" ;\\n  owl:inverseOf :containsMessage .\\n\\n:hasSegment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has segment\\\" ;\\n  rdfs:comment \\\"Relates a message to its constituent segments.\\\" ;\\n  owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"is segment of\\\" ;\\n  rdfs:comment \\\"Inverse of hasSegment: relates a segment to the message it is part of.\\\" ;\\n  owl:inverseOf :hasSegment .\\n\\n:hasSection rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has section\\\" ;\\n  rdfs:comment \\\"Relates an invoice message to its header, detail, and summary sections.\\\" ;\\n  owl:inverseOf :isSectionOf .\\n\\n:isSectionOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is section of\\\" ;\\n  rdfs:comment \\\"Inverse of hasSection: relates a section to its invoice message.\\\" ;\\n  owl:inverseOf :hasSection .\\n\\n:hasCompositeElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has composite element\\\" ;\\n  rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n  owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"is composite element of\\\" ;\\n  rdfs:comment \\\"Inverse of hasCompositeElement: relates a composite data element to its segment.\\\" ;\\n  owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has simple element\\\" ;\\n  rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" ;\\n  owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"is simple element of\\\" ;\\n  rdfs:comment \\\"Inverse of hasSimpleElement: relates a simple data element to its composite data element.\\\" ;\\n  owl:inverseOf :hasSimpleElement .\\n\\n:playsRole rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"plays role\\\" ;\\n  rdfs:comment \\\"Relates an organization to its role assignment in a transaction.\\\" ;\\n  owl:inverseOf :rolePlayedBy .\\n\\n:rolePlayedBy rdf:type owl:ObjectProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"role played by\\\" ;\\n  rdfs:comment \\\"Inverse of playsRole: relates a role assignment to the organization that plays it.\\\" ;\\n  owl:inverseOf :playsRole .\\n\\n:hasRole rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"has role\\\" ;\\n  rdfs:comment \\\"Specifies the agent role played in a role assignment.\\\" ;\\n  owl:inverseOf :isRoleOf .\\n\\n:isRoleOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :AgentRole ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"is role of\\\" ;\\n  rdfs:comment \\\"Inverse of hasRole: relates an agent role to the role assignment it is part of.\\\" ;\\n  owl:inverseOf :hasRole .\\n\\n:inContextOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"in context of\\\" ;\\n  rdfs:comment \\\"Specifies the invoice message context for a role assignment.\\\" ;\\n  owl:inverseOf :contextHasRoleAssignment .\\n\\n:contextHasRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"context has role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of inContextOf: relates an invoice message to its role assignments.\\\" ;\\n  owl:inverseOf :inContextOf .\\n\\n:hasAddress rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has address\\\" ;\\n  rdfs:comment \\\"Relates an organization to its address.\\\" ;\\n  owl:inverseOf :isAddressOf .\\n\\n:isAddressOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Address ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is address of\\\" ;\\n  rdfs:comment \\\"Inverse of hasAddress: relates an address to the organization it belongs to.\\\" ;\\n  owl:inverseOf :hasAddress .\\n\\n:hasIdentifier rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"has identifier\\\" ;\\n  rdfs:comment \\\"Relates an organization to its identifier.\\\" ;\\n  owl:inverseOf :isIdentifierOf .\\n\\n:isIdentifierOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is identifier of\\\" ;\\n  rdfs:comment \\\"Inverse of hasIdentifier: relates an identifier to the organization it belongs to.\\\" ;\\n  owl:inverseOf :hasIdentifier .\\n\\n:isBuyer rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is buyer\\\" ;\\n  rdfs:comment \\\"Specifies the buyer organization in a role assignment.\\\" ;\\n  owl:inverseOf :buyerRoleAssignment .\\n\\n:buyerRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"buyer role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of isBuyer: relates an organization to the buyer role assignment.\\\" ;\\n  owl:inverseOf :isBuyer .\\n\\n:isDeliveryParty rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is delivery party\\\" ;\\n  rdfs:comment \\\"Specifies the delivery party organization in a role assignment.\\\" ;\\n  owl:inverseOf :deliveryPartyRoleAssignment .\\n\\n:deliveryPartyRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :RoleAssignment ;\\n  rdfs:label \\\"delivery party role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of isDeliveryParty: relates an organization to the delivery party role assignment.\\\" ;\\n  owl:inverseOf :isDeliveryParty .\\n\\n:hasLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :DetailSection ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"has line item\\\" ;\\n  rdfs:comment \\\"Relates the detail section to its line items.\\\" ;\\n  owl:inverseOf :isLineItemOf .\\n\\n:isLineItemOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :DetailSection ;\\n  rdfs:label \\\"is line item of\\\" ;\\n  rdfs:comment \\\"Inverse of hasLineItem: relates a line item to the detail section it belongs to.\\\" ;\\n  owl:inverseOf :hasLineItem .\\n\\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"describes item\\\" ;\\n  rdfs:comment \\\"Relates a line item to the item it describes.\\\" ;\\n  owl:inverseOf :isDescribedByLineItem .\\n\\n:isDescribedByLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Item ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"is described by line item\\\" ;\\n  rdfs:comment \\\"Inverse of describesItem: relates an item to the line item that describes it.\\\" ;\\n  owl:inverseOf :describesItem .\\n\\n:hasNetPrice rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has net price\\\" ;\\n  rdfs:comment \\\"Relates a line item to its net price.\\\" ;\\n  owl:inverseOf :isNetPriceOf .\\n\\n:isNetPriceOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Price ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"is net price of\\\" ;\\n  rdfs:comment \\\"Inverse of hasNetPrice: relates a price to the line item it is the net price for.\\\" ;\\n  owl:inverseOf :hasNetPrice .\\n\\n:hasQuantity rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Quantity ;\\n  rdfs:label \\\"has quantity\\\" ;\\n  rdfs:comment \\\"Relates a line item to its quantity.\\\" ;\\n  owl:inverseOf :isQuantityOf .\\n\\n:isQuantityOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Quantity ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"is quantity of\\\" ;\\n  rdfs:comment \\\"Inverse of hasQuantity: relates a quantity to the line item it is for.\\\" ;\\n  owl:inverseOf :hasQuantity .\\n\\n:hasTax rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"has tax\\\" ;\\n  rdfs:comment \\\"Relates the summary section to tax information.\\\" ;\\n  owl:inverseOf :isTaxOf .\\n\\n:isTaxOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Tax ;\\n  rdfs:range :SummarySection ;\\n  rdfs:label \\\"is tax of\\\" ;\\n  rdfs:comment \\\"Inverse of hasTax: relates a tax to the summary section it is part of.\\\" ;\\n  owl:inverseOf :hasTax .\\n\\n:hasInvoiceAmount rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has invoice amount\\\" ;\\n  rdfs:comment \\\"Relates the summary section to the total invoice amount.\\\" ;\\n  owl:inverseOf :isInvoiceAmountOf .\\n\\n:isInvoiceAmountOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Price ;\\n  rdfs:range :SummarySection ;\\n  rdfs:label \\\"is invoice amount of\\\" ;\\n  rdfs:comment \\\"Inverse of hasInvoiceAmount: relates a price to the summary section it is the total for.\\\" ;\\n  owl:inverseOf :hasInvoiceAmount .\\n\\n:hasReferenceNumber rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :ReferenceNumber ;\\n  rdfs:label \\\"has reference number\\\" ;\\n  rdfs:comment \\\"Relates the header section to a reference number.\\\" ;\\n  owl:inverseOf :isReferenceNumberOf .\\n\\n:isReferenceNumberOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :ReferenceNumber ;\\n  rdfs:range :HeaderSection ;\\n  rdfs:label \\\"is reference number of\\\" ;\\n  rdfs:comment \\\"Inverse of hasReferenceNumber: relates a reference number to the header section it identifies.\\\" ;\\n  owl:inverseOf :hasReferenceNumber .\\n\\n:hasBusinessProcess rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"has business process\\\" ;\\n  rdfs:comment \\\"Assigns a business process to the invoice message.\\\" ;\\n  owl:inverseOf :isBusinessProcessOf .\\n\\n:isBusinessProcessOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :BusinessProcess ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is business process of\\\" ;\\n  rdfs:comment \\\"Inverse of hasBusinessProcess: relates a business process to the invoice message it is assigned to.\\\" ;\\n  owl:inverseOf :hasBusinessProcess .\\n\\n:hasValidationConstraint rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint ;\\n  rdfs:label \\\"has validation constraint\\\" ;\\n  rdfs:comment \\\"Relates an invoice message to validation constraints.\\\" ;\\n  owl:inverseOf :isValidationConstraintOf .\\n\\n:isValidationConstraintOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :ValidationConstraint ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is validation constraint of\\\" ;\\n  rdfs:comment \\\"Inverse of hasValidationConstraint: relates a validation constraint to the invoice message it validates.\\\" ;\\n  owl:inverseOf :hasValidationConstraint .\\n\\n:conformsToEN16931 rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :EN16931Requirement ;\\n  rdfs:label \\\"conforms to EN 16931\\\" ;\\n  rdfs:comment \\\"Indicates that the invoice message conforms to a requirement of EN 16931-1.\\\" ;\\n  owl:inverseOf :isEN16931RequirementOf .\\n\\n:isEN16931RequirementOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :EN16931Requirement ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is EN16931 requirement of\\\" ;\\n  rdfs:comment \\\"Inverse of conformsToEN16931: relates an EN16931 requirement to the invoice message it applies to.\\\" ;\\n  owl:inverseOf :conformsToEN16931 .\\n\\n:referencesP2PO rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :P2POntologyReference ;\\n  rdfs:label \\\"references P2P-O\\\" ;\\n  rdfs:comment \\\"Links the invoice message to a reference in the Purchase-to-Pay Ontology.\\\" ;\\n  owl:inverseOf :isReferencedByInvoiceMessage .\\n\\n:isReferencedByInvoiceMessage rdf:type owl:ObjectProperty ;\\n  rdfs:domain :P2POntologyReference ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is referenced by invoice message\\\" ;\\n  rdfs:comment \\\"Inverse of referencesP2PO: relates a P2P-O reference to the invoice message that references it.\\\" ;\\n  owl:inverseOf :referencesP2PO .\\n\\n:validatedBySHACL rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :SHACLConstraint ;\\n  rdfs:label \\\"validated by SHACL\\\" ;\\n  rdfs:comment \\\"Indicates that the invoice message is validated by a SHACL constraint.\\\" ;\\n  owl:inverseOf :isSHACLConstraintOf .\\n\\n:isSHACLConstraintOf rdf:type owl:ObjectProperty ;\\n  rdfs:domain :SHACLConstraint ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is SHACL constraint of\\\" ;\\n  rdfs:comment \\\"Inverse of validatedBySHACL: relates a SHACL constraint to the invoice message it validates.\\\" ;\\n  owl:inverseOf :validatedBySHACL .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:hasDocumentDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has document date\\\" ;\\n  rdfs:comment \\\"Date of the invoice document.\\\" .\\n\\n:hasValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has value\\\" ;\\n  rdfs:comment \\\"The value of a simple data element.\\\" .\\n\\n#################################################################\\n# Hierarchies, Disjoint, and DisjointUnion\\n#################################################################\\n:InterchangeEnvelope owl:disjointWith :Message .\\n:Message owl:disjointWith :Segment .\\n:Segment owl:disjointWith :CompositeDataElement .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n:Organization owl:disjointWith :Item .\\n:Address owl:disjointWith :Identifier .\\n:HeaderSection owl:disjointWith :DetailSection .\\n:HeaderSection owl:disjointWith :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :HeaderSection :DetailSection :SummarySection) .\\n\\n#################################################################\\n# Complex Axioms & Restrictions\\n#################################################################\\n:InvoiceMessage owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:intersectionOf (\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :Segment ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasBusinessProcess ; owl:someValuesFrom :BusinessProcess ]\\n  )\\n] .\\n\\n:RoleAssignment owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:intersectionOf (\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:allValuesFrom :AgentRole ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :inContextOf ; owl:allValuesFrom :InvoiceMessage ]\\n  )\\n] .\\n\\n:LineItem owl:equivalentClass [ rdf:type owl:Class ;\\n  owl:intersectionOf (\\n    [ rdf:type owl:Restriction ; owl:onProperty :describesItem ; owl:allValuesFrom :Item ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom :Price ]\\n    [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:allValuesFrom :Quantity ]\\n  )\\n] .\\n\\n#################################################################\\n# Annotations\\n#################################################################\\n# All classes and properties have rdfs:label and rdfs:comment as required.\\n\"}",
