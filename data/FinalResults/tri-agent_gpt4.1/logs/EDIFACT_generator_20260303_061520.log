t\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n    owl:inverseOf :isCompositeElementOfSegment .\\n\\n:isCompositeElementOfSegment a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"is composite element of segment\\\" ;\\n    rdfs:comment \\\"Inverse property: relates a composite element to its parent segment.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a composite element to its simple data elements.\\\" ;\\n    owl:inverseOf :isSimpleElementOfComposite .\\n\\n:isSimpleElementOfComposite a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple element of composite\\\" ;\\n    rdfs:comment \\\"Inverse property: relates a simple element to its parent composite.\\\" .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"plays role assignment\\\" ;\\n    rdfs:comment \\\"Links an organization to its role assignments.\\\" ;\\n    owl:inverseOf :isRolePlayedByOrganization .\\n\\n:isRolePlayedByOrganization a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is role played by organization\\\" ;\\n    rdfs:comment \\\"Inverse property: links a role assignment to its organization.\\\" .\\n\\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Links a role assignment to an agent role (e.g., Buyer, Supplier).\\\" ;\\n    owl:inverseOf :isRoleOfAssignment .\\n\\n:isRoleOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"is role of assignment\\\" ;\\n    rdfs:comment \\\"Inverse property: links an agent role to its role assignment.\\\" .\\n\\n:inContextOfInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"in context of invoice\\\" ;\\n    rdfs:comment \\\"Links a role assignment to its invoice message context.\\\" ;\\n    owl:inverseOf :hasRoleAssignmentInInvoice .\\n\\n:hasRoleAssignmentInInvoice a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"has role assignment in invoice\\\" ;\\n    rdfs:comment \\\"Inverse property: links an invoice message to its role assignment.\\\" .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization to its address.\\\" ;\\n    owl:inverseOf :isAddressOfOrganization .\\n\\n:isAddressOfOrganization a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is address of organization\\\" ;\\n    rdfs:comment \\\"Inverse property: links an address to its organization.\\\" .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an organization to its identifiers (e.g., GLN).\\\" ;\\n    owl:inverseOf :isIdentifierOfOrganization .\\n\\n:isIdentifierOfOrganization a owl:ObjectProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is identifier of organization\\\" ;\\n    rdfs:comment \\\"Inverse property: links an identifier to its organization.\\\" .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links a detail section to its line items.\\\" ;\\n    owl:inverseOf :isLineItemOfDetailSection .\\n\\n:isLineItemOfDetailSection a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"is line item of detail section\\\" ;\\n    rdfs:comment \\\"Inverse property: links a line item to its detail section.\\\" .\\n\\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Links a line item to the described item.\\\" ;\\n    owl:inverseOf :isDescribedByLineItem .\\n\\n:isDescribedByLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is described by line item\\\" ;\\n    rdfs:comment \\\"Inverse property: links an item to its line item description.\\\" .\\n\\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Links a line item to its net price.\\\" ;\\n    owl:inverseOf :isNetPriceForLineItem .\\n\\n:isNetPriceForLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is net price for line item\\\" ;\\n    rdfs:comment \\\"Inverse property: links a price to its line item.\\\" .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links a summary section to its taxes.\\\" ;\\n    owl:inverseOf :isTaxOfSummarySection .\\n\\n:isTaxOfSummarySection a owl:ObjectProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is tax of summary section\\\" ;\\n    rdfs:comment \\\"Inverse property: links a tax to its summary section.\\\" .\\n\\n:hasInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Links a summary section to the invoice total amount.\\\" ;\\n    owl:inverseOf :isInvoiceAmountOfSummarySection .\\n\\n:isInvoiceAmountOfSummarySection a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is invoice amount of summary section\\\" ;\\n    rdfs:comment \\\"Inverse property: links a price to its summary section.\\\" .\\n\\n:isAssignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is assigned to business process\\\" ;\\n    rdfs:comment \\\"Inverse property: links a business process to its assigned invoice message.\\\" .\\n\\n:isValidatedBy a owl:ObjectProperty ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is validated by\\\" ;\\n    rdfs:comment \\\"Inverse property: links a validation constraint to its invoice message.\\\" .\\n\\n:p2pEquivalent a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :P2PConcept ;\\n    rdfs:range owl:Thing ;\\n    rdfs:label \\\"P2P-O equivalent\\\" ;\\n    rdfs:comment \\\"Indicates the equivalent P2P-O concept.\\\" ;\\n    owl:inverseOf :hasP2PConceptEquivalent .\\n\\n:hasP2PConceptEquivalent a owl:ObjectProperty ;\\n    rdfs:domain owl:Thing ;\\n    rdfs:range :P2PConcept ;\\n    rdfs:label \\\"has P2P concept equivalent\\\" ;\\n    rdfs:comment \\\"Inverse property: links a concept to its P2P-O equivalent.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:hasGLN a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :GlobalLocationNumber ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"The GLN string value for an organization.\\\" .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :BGMSegment ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"Invoice number as found in BGM segment.\\\" .\\n\\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The document date in the header section.\\\" .\\n\\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"The reference number in the header section.\\\" .\\n\\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of the item in a line item.\\\" .\\n\\n#################################################################\\n# Restrictions & Axioms\\n#################################################################\\n# OrganizationRoleAssignment reifies Organization, AgentRole, and InvoiceMessage\\n:OrganizationRoleAssignment owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ]\\n        [ a owl:Restriction ; owl:onProperty :inContextOfInvoice ; owl:someValuesFrom :InvoiceMessage ]\\n    )\\n] .\\n\\n# InvoiceMessage must have header, detail, and summary sections\\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasHeaderSection ; owl:someValuesFrom :HeaderSection ] ,\\n                                   [ a owl:Restriction ; owl:onProperty :hasDetailSection ; owl:someValuesFrom :DetailSection ] ,\\n                                   [ a owl:Restriction ; owl:onProperty :hasSummarySection ; owl:someValuesFrom :SummarySection ] .\\n\\n# DetailSection must have at least one line item\\n:DetailSection rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasLineItem ; owl:someValuesFrom :LineItem ] .\\n\\n# LineItem must describe an item and have a net price\\n:LineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ] ,\\n                          [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Price ] .\\n\\n# SummarySection must have invoice amount\\n:SummarySection rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasInvoiceAmount ; owl:someValuesFrom :Price ] .\\n\\n# Organization must have at least one identifier\\n:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasIdentifier ; owl:someValuesFrom :Identifier ] .\\n\\n# Address is functional for an Organization\\n:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:maxCardinality \\\"1\\\"^^xsd:nonNegativeInteger ] .\\n\\n#################################################################\\n# Disjointness\\n#################################################################\\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :Item , :Address , :Identifier .\\n:Item owl:disjointWith :Price .\\n:Price owl:disjointWith :Tax .\\n\\n#################################################################\\n# Individuals (Examples)\\n#################################################################\\n:Buyer a :AgentRole ;\\n    rdfs:label \\\"Buyer\\\" ;\\n    rdfs:comment \\\"Role of buyer in invoice context.\\\" .\\n\\n:Supplier a :AgentRole ;\\n    rdfs:label \\\"Supplier\\\" ;\\n    rdfs:comment \\\"Role of supplier in invoice context.\\\" .\\n\"}",
