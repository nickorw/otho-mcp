ss ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple (atomic) data element within a segment.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an invoice message, containing reference numbers and dates.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The detail section listing all line items in the invoice.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section providing totals such as tax and invoice amount.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"An itemized entry in the invoice detail section.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A company or entity involved in the invoice transaction.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the invoice context (e.g., Buyer, Seller, DeliveryParty).\\\" .\\n\\n:OrganizationalRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organizational Role Assignment\\\" ;\\n    rdfs:comment \\\"A pivot class reifying the assignment of a role to an organization within a specific invoice context.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal address associated with an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A generic identifier for organizations or items.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A globally unique location identifier for organizations.\\\" ;\\n    rdfs:subClassOf :Identifier .\\n\\n:InvoiceAmount a owl:Class ;\\n    rdfs:label \\\"Invoice Amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:TaxAmount a owl:Class ;\\n    rdfs:label \\\"Tax Amount\\\" ;\\n    rdfs:comment \\\"The total tax amount in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value associated with a line item.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity value associated with a line item.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number for the invoice document.\\\" .\\n\\n:DocumentDate a owl:Class ;\\n    rdfs:label \\\"Document Date\\\" ;\\n    rdfs:comment \\\"The date of the invoice document.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice can be assigned.\\\" .\\n\\n:Standard a owl:Class ;\\n    rdfs:label \\\"Standard\\\" ;\\n    rdfs:comment \\\"A formal standard (e.g., EN 16931-1) to which the invoice aligns.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint used for automated validation of invoice data.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:LineItemDetail a owl:Class ;\\n    rdfs:label \\\"Line Item Detail\\\" ;\\n    rdfs:comment \\\"A pivot class reifying the details for a line item (e.g., price, quantity).\\\" ;\\n    rdfs:subClassOf :DetailSection .\\n\\n#################################################################\\n# Disjointness and Disjoint Unions\\n#################################################################\\n\\n:InterchangeEnvelope owl:disjointWith :Message .\\n:Organization owl:disjointWith :Address .\\n:LineItem owl:disjointWith :Organization .\\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:BGMSegment owl:disjointWith :NADSegment .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :HeaderSection :DetailSection :SummarySection) .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an InterchangeEnvelope to its contained Message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a Message to its Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment .\\n\\n:hasHeaderSection a owl:ObjectProperty ;\\n    rdfs:label \\\"has header section\\\" ;\\n    rdfs:comment \\\"Relates an InvoiceMessage to its HeaderSection.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :HeaderSection ;\\n    owl:FunctionalProperty .\\n\\n:hasDetailSection a owl:ObjectProperty ;\\n    rdfs:label \\\"has detail section\\\" ;\\n    rdfs:comment \\\"Relates an InvoiceMessage to its DetailSection.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    owl:FunctionalProperty .\\n\\n:hasSummarySection a owl:ObjectProperty ;\\n    rdfs:label \\\"has summary section\\\" ;\\n    rdfs:comment \\\"Relates an InvoiceMessage to its SummarySection.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SummarySection ;\\n    owl:FunctionalProperty .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Relates a DetailSection to its LineItems.\\\" ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Relates an InvoiceMessage to OrganizationalRoleAssignments.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :OrganizationalRoleAssignment .\\n\\n:assignedRole a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"Relates an OrganizationalRoleAssignment to the AgentRole.\\\" ;\\n    rdfs:domain :OrganizationalRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:FunctionalProperty .\\n\\n:performedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"performed by\\\" ;\\n    rdfs:comment \\\"Relates an OrganizationalRoleAssignment to the Organization performing the role.\\\" ;\\n    rdfs:domain :OrganizationalRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:FunctionalProperty .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Relates an Organization to its Address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Relates an Organization to its Identifier(s).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier .\\n\\n:hasGLN a owl:ObjectProperty ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Relates an Organization to its Global Location Number.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :GlobalLocationNumber ;\\n    owl:FunctionalProperty .\\n\\n:playsRoleIn a owl:ObjectProperty ;\\n    rdfs:label \\\"plays role in\\\" ;\\n    rdfs:comment \\\"Relates an Organization to the OrganizationalRoleAssignment(s) in which it participates.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationalRoleAssignment .\\n\\n:hasInvoiceAmount a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Relates a SummarySection to its InvoiceAmount.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :InvoiceAmount ;\\n    owl:FunctionalProperty .\\n\\n:hasTaxAmount a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax amount\\\" ;\\n    rdfs:comment \\\"Relates a SummarySection to its TaxAmount.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :TaxAmount ;\\n    owl:FunctionalProperty .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Relates a LineItem to the Item it describes.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    owl:FunctionalProperty .\\n\\n:hasPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Relates a LineItem to its Price.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    owl:FunctionalProperty .\\n\\n:hasQuantity a owl:ObjectProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Relates a LineItem to its Quantity.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Quantity ;\\n    owl:FunctionalProperty .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Relates an InvoiceMessage to a BusinessProcess.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    owl:FunctionalProperty .\\n\\n:alignedWithStandard a owl:ObjectProperty ;\\n    rdfs:label \\\"aligned with standard\\\" ;\\n    rdfs:comment \\\"Indicates the standard to which the invoice aligns.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Standard .\\n\\n:validatedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"validated by\\\" ;\\n    rdfs:comment \\\"Indicates a validation constraint applied to the InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"The reference number in the header section.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasDocumentDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The document date in the header section.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"has value\\\" ;\\n    rdfs:comment \\\"The value of an amount, price, or quantity.\\\" ;\\n    rdfs:domain :InvoiceAmount, :TaxAmount, :Price, :Quantity ;\\n    rdfs:range xsd:decimal ;\\n    owl:FunctionalProperty .\\n\\n:hasCurrency a owl:DatatypeProperty ;\\n    rdfs:label \\\"has currency\\\" ;\\n    rdfs:comment \\\"The currency for an amount or price.\\\" ;\\n    rdfs:domain :InvoiceAmount, :TaxAmount, :Price ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasItemDescription a owl:DatatypeProperty ;\\n    rdfs:label \\\"has item description\\\" ;\\n    rdfs:comment \\\"A description for an item.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasAddressLine a owl:DatatypeProperty ;\\n    rdfs:label \\\"has address line\\\" ;\\n    rdfs:comment \\\"The address line for an address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasPostalCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"has postal code\\\" ;\\n    rdfs:comment \\\"The postal code for an address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasCity a owl:DatatypeProperty ;\\n    rdfs:label \\\"has city\\\" ;\\n    rdfs:comment \\\"The city for an address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:hasCountry a owl:DatatypeProperty ;\\n    rdfs:label \\\"has country\\\" ;\\n    rdfs:comment \\\"The country for an address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n#################################################################\\n# Restrictions and Advanced Modeling\\n#################################################################\\n\\n:InvoiceMessage rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasRoleAssignment ;\\n    owl:allValuesFrom :OrganizationalRoleAssignment\\n] .\\n\\n:OrganizationalRoleAssignment rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :assignedRole ;\\n    owl:someValuesFrom :AgentRole\\n] , [\\n    a owl:Restriction ;\\n    owl:onProperty :performedBy ;\\n    owl:someValuesFrom :Organization\\n] .\\n\\n:LineItem rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasPrice ;\\n    owl:allValuesFrom :Price\\n] .\\n\\n#################################################################\\n# Annotations (rdfs:label and rdfs:comment already included above)\\n#################################################################\\n\"}",
