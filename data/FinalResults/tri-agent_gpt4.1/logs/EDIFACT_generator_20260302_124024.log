 ;\n    rdfs:label \"is MEA segment of\" ;\n    rdfs:comment \"Inverse of hasMEASegment.\" ;\n    rdfs:domain :MEA_Segment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasMEASegment .\n\n:hasALCSegment a owl:ObjectProperty ;\n    rdfs:label \"has ALC segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its ALC_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ALC_Segment ;\n    owl:inverseOf :isALCSegmentOf .\n\n:isALCSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is ALC segment of\" ;\n    rdfs:comment \"Inverse of hasALCSegment.\" ;\n    rdfs:domain :ALC_Segment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasALCSegment .\n\n:hasTAXSegment a owl:ObjectProperty ;\n    rdfs:label \"has TAX segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its TAX_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :TAX_Segment ;\n    owl:inverseOf :isTAXSegmentOf .\n\n:isTAXSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is TAX segment of\" ;\n    rdfs:comment \"Inverse of hasTAXSegment.\" ;\n    rdfs:domain :TAX_Segment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasTAXSegment .\n\n:hasRFFSegment a owl:ObjectProperty ;\n    rdfs:label \"has RFF segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its RFF_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RFF_Segment ;\n    owl:inverseOf :isRFFSegmentOf .\n\n:isRFFSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is RFF segment of\" ;\n    rdfs:comment \"Inverse of hasRFFSegment.\" ;\n    rdfs:domain :RFF_Segment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasRFFSegment .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n\n:hasGlobalLocationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has Global Location Number\" ;\n    rdfs:comment \"Relates an Organization to its GLN i