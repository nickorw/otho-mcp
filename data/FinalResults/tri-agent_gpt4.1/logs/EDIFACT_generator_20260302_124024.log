2026-03-02 12:50:58 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#EDIFACT_INVOIC_Story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Ontology\" ;\n    rdfs:comment \"Ontology for modeling UN/EDIFACT D96A INVOIC messages, segments, and business document semantics for industrial procurement.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Top-level envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A message within an interchange, such as INVOIC.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A message representing an invoice (INVOIC).\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment is a logical grouping of data elements in EDIFACT.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:DTM_Segment a owl:Class ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment, with subclasses for qualifiers (e.g., 137: Document Date).\" ;\n    rdfs:subClassOf :Segment .\n\n:MOA_Segment a owl:Class ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment, for invoice totals, taxes, etc.\" ;\n    rdfs:subClassOf :Segment .\n\n:QTY_Segment a owl:Class ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment, with qualifiers (e.g., invoiced quantity).\" ;\n    rdfs:subClassOf :Segment .\n\n:MEA_Segment a owl:Class ;\n    rdfs:label \"MEA Segment\" ;\n    rdfs:comment \"Measurements segment, for reporting measurements relevant to line items.\" ;\n    rdfs:subClassOf :Segment .\n\n:ALC_Segment a owl:Class ;\n    rdfs:label \"ALC Segment\" ;\n    rdfs:comment \"Allowances/Charges segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:TAX_Segment a owl:Class ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax details segment, for specifying tax categories, rates, and amounts.\" ;\n    rdfs:subClassOf :Segment .\n\n:RFF_Segment a owl:Class ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment, used for document and line-level referencing.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeElement a owl:Class ;\n    rdfs:label \"Composite Element\" ;\n    rdfs:comment \"A composite data element in a segment.\" .\n\n:SimpleElement a owl:Class ;\n    rdfs:label \"Simple Element\" ;\n    rdfs:comment \"A simple (atomic) data element in a segment or composite.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Section containing document-level data (dates, references, etc.).\" ;\n    rdfs:subClassOf :CompositeElement .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Section containing invoice line items.\" ;\n    rdfs:subClassOf :CompositeElement .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Section summarizing totals, taxes, etc.\" ;\n    rdfs:subClassOf :CompositeElement .\n\n:InvoiceLine a owl:Class ;\n    rdfs:label \"Invoice Line\" ;\n    rdfs:comment \"A single line item in the invoice.\" ;\n    rdfs:subClassOf :DetailSection .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice, such as buyer or supplier.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the invoice (e.g., Buyer, Delivery Party).\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role of buyer in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"Role of delivery party in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Physical or logical address associated with an organization.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"GLN identifier for organization locations.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item being sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Price information for an item.\" .\n\n:Quantity a owl:Class ;\n    rdfs:label \"Quantity\" ;\n    rdfs:comment \"Quantity information for an item or line.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information related to items or invoice.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number (e.g., invoice number, order number).\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint used for automated validation of invoice data.\" .\n\n:P2P_O_Alignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment node for Purchase-to-Pay Ontology.\" .\n\n:EN16931_Alignment a owl:Class ;\n    rdfs:label \"EN 16931 Alignment\" ;\n    rdfs:comment \"Alignment node for EN 16931 European Standard.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Class for invoice total amount, used for reification if needed.\" .\n\n:InvoiceNumber a owl:Class ;\n    rdfs:label \"Invoice Number\" ;\n    rdfs:comment \"Class for invoice number, used for reification if needed.\" .\n\n# Pivot Classes\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Reifies the assignment of a role to an organization within an invoice context.\" .\n\n:InvoiceLineItemDetail a owl:Class ;\n    rdfs:label \"Invoice Line Item Detail\" ;\n    rdfs:comment \"Reifies the details of an invoice line item, such as price, quantity, and tax.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to its contained Message(s).\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its constituent Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its major logical sections (header, detail, summary).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :CompositeElement .\n\n:hasInvoiceLine a owl:ObjectProperty ;\n    rdfs:label \"has invoice line\" ;\n    rdfs:comment \"Relates a DetailSection to its InvoiceLine(s).\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :InvoiceLine .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates an InvoiceLine to the Item being sold.\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Item .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Relates an Organization to its OrganizationRoleAssignment(s).\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the AgentRole.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n\n:assignedToInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned to invoice\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the InvoiceMessage context.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Relates an InvoiceMessage to a BusinessProcess.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n:isAlignedWithP2P_O a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is aligned with P2P-O\" ;\n    rdfs:comment \"Relates an InvoiceMessage to a P2P_O_Alignment node.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2P_O_Alignment .\n\n:isAlignedWithEN16931 a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is aligned with EN16931\" ;\n    rdfs:comment \"Relates an InvoiceMessage to an EN16931_Alignment node.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931_Alignment .\n\n:hasValidationConstraint a owl:ObjectProperty ;\n    rdfs:label \"has validation constraint\" ;\n    rdfs:comment \"Relates an InvoiceMessage to a ValidationConstraint.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint .\n\n:hasDTMSegment a owl:ObjectProperty ;\n    rdfs:label \"has DTM segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its DTM_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DTM_Segment .\n\n:hasMOASegment a owl:ObjectProperty ;\n    rdfs:label \"has MOA segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its MOA_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :MOA_Segment .\n\n:hasQTYSegment a owl:ObjectProperty ;\n    rdfs:label \"has QTY segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its QTY_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :QTY_Segment .\n\n:hasMEASegment a owl:ObjectProperty ;\n    rdfs:label \"has MEA segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its MEA_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :MEA_Segment .\n\n:hasALCSegment a owl:ObjectProperty ;\n    rdfs:label \"has ALC segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its ALC_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ALC_Segment .\n\n:hasTAXSegment a owl:ObjectProperty ;\n    rdfs:label \"has TAX segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its TAX_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :TAX_Segment .\n\n:hasRFFSegment a owl:ObjectProperty ;\n    rdfs:label \"has RFF segment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its RFF_Segment(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RFF_Segment .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n\n:hasGlobalLocationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has Global Location Number\" ;\n    rdfs:comment \"Relates an Organization to its GLN identifier.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Relates a HeaderSection to its reference number.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Relates a HeaderSection to its document date (as string, ISO-8601).\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Relates a SummarySection to the invoice total amount.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n\n:hasTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"Relates a SummarySection to the total tax amount.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its invoice number.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates an InvoiceLine to the net price of the item.\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range xsd:decimal .\n\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Relates an InvoiceLine to the quantity of the item.\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range xsd:integer .\n\n#################################################################\n# COMPLEX AXIOMS & RESTRICTIONS\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [\n    rdf:type owl:Restriction ;\n    owl:onProperty :hasSection ;\n    owl:allValuesFrom :CompositeElement\n] .\n\n:OrganizationRoleAssignment owl:equivalentClass [\n    rdf:type owl:Restriction ;\n    owl:onProperty :assignedRole ;\n    owl:someValuesFrom :AgentRole\n] .\n\n:InvoiceLine owl:equivalentClass [\n    rdf:type owl:Restriction ;\n    owl:onProperty :hasItem ;\n    owl:someValuesFrom :Item\n] .\n\n#################################################################\n# ANNOTATIONS\n#################################################################\n\n# All classes and properties above have rdfs:label and rdfs:comment as required.\n"
}
