2026-03-02 12:56:34 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACT_INVOIC_Ontology rdf:type owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Ontology\" ;\n    rdfs:comment \"Ontology for modeling UN/EDIFACT INVOIC messages, segments, roles, and semantic constraints for global trade invoices, with alignment to EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n\n:InterchangeEnvelope rdf:type owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope containing one or more EDIFACT messages.\" .\n\n:Message rdf:type owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message, such as INVOIC.\" .\n\n:InvoiceMessage rdf:type owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An INVOIC message representing a digital invoice document.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment rdf:type owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message, e.g., BGM or NAD.\" .\n\n:BGM_Segment rdf:type owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment rdf:type owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:HeaderSection rdf:type owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section containing document dates and reference numbers.\" ;\n    rdfs:subClassOf :Segment .\n\n:DetailSection rdf:type owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section listing individual line items.\" ;\n    rdfs:subClassOf :Segment .\n\n:SummarySection rdf:type owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section providing invoice totals and tax amounts.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement rdf:type owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement rdf:type owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:Organization rdf:type owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An entity involved in the invoice, such as Buyer or Delivery Party.\" .\n\n:AgentRole rdf:type owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the invoice (e.g., Buyer, Supplier, Delivery Party).\" .\n\n:Address rdf:type owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Address associated with an organization.\" .\n\n:LineItem rdf:type owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An itemized product or service in the invoice detail section.\" .\n\n:Item rdf:type owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service being sold.\" .\n\n:Price rdf:type owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Net price of an item.\" .\n\n:Tax rdf:type owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax amount applied to the invoice.\" .\n\n:ReferenceNumber rdf:type owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Invoice number or other reference identifier.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"Business process to which the invoice is assigned.\" .\n\n:Identifier rdf:type owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"Generic identifier for organizations or documents.\" .\n\n:GlobalLocationNumber rdf:type owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"Global Location Number (GLN) for organization identification.\" ;\n    rdfs:subClassOf :Identifier .\n\n:ValidationConstraint rdf:type owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"Constraint for automated validation, e.g., SHACL rules.\" .\n\n:EN16931Alignment rdf:type owl:Class ;\n    rdfs:label \"EN 16931 Alignment\" ;\n    rdfs:comment \"Alignment to European Standard EN 16931-1.\" .\n\n:P2POAlignment rdf:type owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment to Purchase-to-Pay Ontology (P2P-O).\" .\n\n:InvoiceAmount rdf:type owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:OrganizationRoleAssignment rdf:type owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for reifying the relationship between an organization and its role in an invoice.\" .\n\n#################################################################\n# HIERARCHY AND DISJOINTNESS\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :Address .\n:AgentRole owl:disjointWith :Organization .\n\n:Segment owl:disjointUnionOf (:BGM_Segment :NADSegment :HeaderSection :DetailSection :SummarySection) .\n\n#################################################################\n# PROPERTIES\n#################################################################\n\n:hasMessage rdf:type owl:ObjectProperty ;\n    rdfs:label \"has message\" ;\n    rdfs:comment \"Links an interchange envelope to its contained message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n\n:messageOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"message of\" ;\n    rdfs:comment \"Inverse of hasMessage, links a message to its envelope.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :hasMessage .\n\n:containsSegment rdf:type owl:ObjectProperty ;\n    rdfs:label \"contains segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:segmentOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"segment of\" ;\n    rdfs:comment \"Inverse of containsSegment, links a segment to its parent message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    owl:inverseOf :containsSegment .\n\n:hasSection rdf:type owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an invoice message to its sections (header, detail, summary).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Segment .\n\n:sectionOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"section of\" ;\n    rdfs:comment \"Inverse of hasSection, links a section to its invoice message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasSection .\n\n:hasHeader rdf:type owl:ObjectProperty ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an invoice message to its header section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :HeaderSection .\n\n:headerOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"header of\" ;\n    rdfs:comment \"Inverse of hasHeader, links a header section to its invoice message.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasHeader .\n\n:hasDetail rdf:type owl:ObjectProperty ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links an invoice message to its detail section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DetailSection .\n\n:detailOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"detail of\" ;\n    rdfs:comment \"Inverse of hasDetail, links a detail section to its invoice message.\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasDetail .\n\n:hasSummary rdf:type owl:ObjectProperty ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links an invoice message to its summary section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SummarySection .\n\n:summaryOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"summary of\" ;\n    rdfs:comment \"Inverse of hasSummary, links a summary section to its invoice message.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasSummary .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links a detail section to its line items.\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem .\n\n:lineItemOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem, links a line item to its detail section.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    owl:inverseOf :hasLineItem .\n\n:aboutItem rdf:type owl:ObjectProperty ;\n    rdfs:label \"about item\" ;\n    rdfs:comment \"Links a line item to the item it describes.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item .\n\n:itemOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"item of\" ;\n    rdfs:comment \"Inverse of aboutItem, links an item to the line item that describes it.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :aboutItem .\n\n:hasNetPrice rdf:type owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a line item to its net price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n\n:netPriceOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice, links a price to its line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasNetPrice .\n\n:hasQuantity rdf:type owl:DatatypeProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Quantity of items in a line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceAmount rdf:type owl:ObjectProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Links a summary section to the invoice amount.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceAmount .\n\n:invoiceAmountOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"invoice amount of\" ;\n    rdfs:comment \"Inverse of hasInvoiceAmount, links an invoice amount to its summary section.\" ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range :SummarySection ;\n    owl:inverseOf :hasInvoiceAmount .\n\n:hasTax rdf:type owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links a summary section to the tax applied.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax .\n\n:taxOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"tax of\" ;\n    rdfs:comment \"Inverse of hasTax, links a tax to its summary section.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range :SummarySection ;\n    owl:inverseOf :hasTax .\n\n:hasOrganizationRoleAssignment rdf:type owl:ObjectProperty ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Links an invoice message to a pivot class for organization-role reification.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:organizationRoleAssignmentOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"organization role assignment of\" ;\n    rdfs:comment \"Inverse of hasOrganizationRoleAssignment, links an organization role assignment to its invoice message.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasOrganizationRoleAssignment .\n\n:involvesOrganization rdf:type owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an organization role assignment to the involved organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n\n:organizationInRoleAssignment rdf:type owl:ObjectProperty ;\n    rdfs:label \"organization in role assignment\" ;\n    rdfs:comment \"Inverse of involvesOrganization, links an organization to its role assignments.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRole rdf:type owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links an organization role assignment to the agent role played.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n\n:roleOfAssignment rdf:type owl:ObjectProperty ;\n    rdfs:label \"role of assignment\" ;\n    rdfs:comment \"Inverse of hasRole, links an agent role to its assignments.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :hasRole .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:addressOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"address of\" ;\n    rdfs:comment \"Inverse of hasAddress, links an address to its organization.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasIdentifier rdf:type owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifiers.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n\n:identifierOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier, links an identifier to its organization.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasIdentifier .\n\n:hasGlobalLocationNumber rdf:type owl:ObjectProperty ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"Links an organization to its Global Location Number.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber .\n\n:globalLocationNumberOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"global location number of\" ;\n    rdfs:comment \"Inverse of hasGlobalLocationNumber, links a GLN to its organization.\" ;\n    rdfs:domain :GlobalLocationNumber ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasGlobalLocationNumber .\n\n:hasReferenceNumber rdf:type owl:ObjectProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Links a header section to its reference number.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :ReferenceNumber .\n\n:referenceNumberOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"reference number of\" ;\n    rdfs:comment \"Inverse of hasReferenceNumber, links a reference number to its header section.\" ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range :HeaderSection ;\n    owl:inverseOf :hasReferenceNumber .\n\n:hasDocumentDate rdf:type owl:DatatypeProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Date of the invoice document (string format).\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:isAlignedWithEN16931 rdf:type owl:ObjectProperty ;\n    rdfs:label \"is aligned with EN 16931\" ;\n    rdfs:comment \"Links an invoice message to EN 16931 alignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931Alignment .\n\n:alignedEN16931Of rdf:type owl:ObjectProperty ;\n    rdfs:label \"aligned EN 16931 of\" ;\n    rdfs:comment \"Inverse of isAlignedWithEN16931, links EN 16931 alignment to its invoice message.\" ;\n    rdfs:domain :EN16931Alignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :isAlignedWithEN16931 .\n\n:isAlignedWithP2PO rdf:type owl:ObjectProperty ;\n    rdfs:label \"is aligned with P2P-O\" ;\n    rdfs:comment \"Links an invoice message to P2P-O alignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2POAlignment .\n\n:alignedP2POOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"aligned P2P-O of\" ;\n    rdfs:comment \"Inverse of isAlignedWithP2PO, links P2P-O alignment to its invoice message.\" ;\n    rdfs:domain :P2POAlignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :isAlignedWithP2PO .\n\n:validatesWith rdf:type owl:ObjectProperty ;\n    rdfs:label \"validates with\" ;\n    rdfs:comment \"Links an invoice message to its validation constraints (e.g., SHACL).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint .\n\n:validatedBy rdf:type owl:ObjectProperty ;\n    rdfs:label \"validated by\" ;\n    rdfs:comment \"Inverse of validatesWith, links a validation constraint to its invoice message.\" ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :validatesWith .\n\n:assignedToProcess rdf:type owl:ObjectProperty ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Links an invoice message to the business process it belongs to.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n:processOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"process of\" ;\n    rdfs:comment \"Inverse of assignedToProcess, links a business process to its invoice message.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :assignedToProcess .\n\n#################################################################\n# CONNECTIONS FOR DATA ELEMENTS\n#################################################################\n\n:hasCompositeElement rdf:type owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:compositeElementOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement, links a composite data element to its segment.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement rdf:type owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:simpleElementOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement, links a simple data element to its composite data element.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :hasSimpleElement .\n\n#################################################################\n# PROPERTY CHARACTERISTICS\n#################################################################\n\n:hasMessage a owl:FunctionalProperty .\n:hasHeader a owl:FunctionalProperty .\n:hasDetail a owl:FunctionalProperty .\n:hasSummary a owl:FunctionalProperty .\n\n#################################################################\n# ANNOTATIONS\n#################################################################\n# (All classes and properties above include rdfs:label and rdfs:comment)\n\n#################################################################\n# COMPLEX AXIOMS & RESTRICTIONS\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :hasHeader ; owl:allValuesFrom :HeaderSection ] [ rdf:type owl:Restriction ; owl:onProperty :hasDetail ; owl:allValuesFrom :DetailSection ] [ rdf:type owl:Restriction ; owl:onProperty :hasSummary ; owl:allValuesFrom :SummarySection ] ) ] .\n\n:LineItem owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :aboutItem ; owl:someValuesFrom :Item ] [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Price ] [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom xsd:decimal ] ) ] .\n\n:OrganizationRoleAssignment owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Organization ] [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ] ) ] .\n\n#################################################################\n# INDIVIDUALS (EXAMPLES)\n#################################################################\n# (No individuals provided; ontology is schema-level)\n"
}
