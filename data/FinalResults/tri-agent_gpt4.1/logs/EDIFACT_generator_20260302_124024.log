      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoic-ontology>\n  a owl:Ontology ;\n  rdfs:label \"EDIFACT INVOIC Ontology\" ;\n  rdfs:comment \"A deeply structured ontology for UN/EDIFACT D96A INVOIC messages, roles, and validation, supporting EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The top-level envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:subClassOf :Message ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An EDIFACT invoice message (INVOIC).\" .\n\n:Section a owl:Class ;\n  rdfs:label \"Section\" ;\n  rdfs:comment \"A logical section of an invoice: header, detail, or summary.\" .\n\n:HeaderSection a owl:Class ;\n  rdfs:subClassOf :Section ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Section containing document dates, reference numbers, and invoice metadata.\" .\n\n:DetailSection a owl:Class ;\n  rdfs:subClassOf :Section ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Section listing line items and their attributes.\" .\n\n:SummarySection a owl:Class ;\n  rdfs:subClassOf :Section ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Section providing tax and invoice totals.\" .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A generic EDIFACT segment.\" .\n\n:BGMSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"BGM Segment\" ;\n  rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NADSegment a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"NAD Segment\" ;\n  rdfs:comment \"Name and Address segment for participant details.\" .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element comprising multiple simple data elements.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element representing an atomic value.\" .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"A legal entity or party involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in a business transaction.\" .\n\n:BuyerRole a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Buyer Role\" ;\n  rdfs:comment \"Role of buyer in the invoice process.\" .\n\n:DeliveryPartyRole a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Delivery Party Role\" ;\n  rdfs:comment \"Role of delivery party in the invoice process.\" .\n\n:RoleAssignment a owl:Class ;\n  rdfs:label \"Role Assignment\" ;\n  rdfs:comment \"A reified relation linking an organization to a role in a specific context (pivot class).\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A physical or legal address related to an organization.\" .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"A generic identifier (e.g., D96A, EN 16931-1, GLN).\" .\n\n:GlobalLocationNumber a owl:Class ;\n  rdfs:subClassOf :Identifier ;\n  rdfs:label \"Global Location Number\" ;\n  rdfs:comment \"A unique identifier for organizations as per GS1 standards.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service listed in the invoice.\" .\n\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in the invoice, referencing an item, quantity, and price.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A monetary value for an item or invoice component.\" .\n\n:Quantity a owl:Class ;\n  rdfs:label \"Quantity\" ;\n  rdfs:comment \"A quantity of items in a line item.\" .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"A tax amount, rate, or code in the summary section.\" .\n\n:ReferenceNumber a owl:Class ;\n  rdfs:label \"Reference Number\" ;\n  rdfs:comment \"A reference number for the invoice or related documents.\" .\n\n:InvoiceAmount a owl:Class ;\n  rdfs:label \"Invoice Amount\" ;\n  rdfs:comment \"The total amount of the invoice.\" .\n\n:InvoiceNumber a owl:Class ;\n  rdfs:label \"Invoice Number\" ;\n  rdfs:comment \"The unique invoice number.\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n  rdfs:label \"Validation Constraint\" ;\n  rdfs:comment \"A constraint for validating invoice content (e.g., SHACL rule).\" .\n\n#################################################################\n# DISJOINT CLASSES\n#################################################################\n\n:Organization owl:disjointWith :Item, :Segment, :Section .\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\n:BGMSegment owl:disjointWith :NADSegment .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Links an Interchange Envelope to its contained message(s).\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Links a message to its segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Links an invoice message to its logical sections.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Section .\n\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has header\" ;\n  rdfs:comment \"Links an invoice message to its header section.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection .\n\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has detail\" ;\n  rdfs:comment \"Links an invoice message to its detail section.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :DetailSection .\n\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has summary\" ;\n  rdfs:comment \"Links an invoice message to its summary section.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SummarySection .\n\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links a detail section to its line items.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n\n:describesItem a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"describes item\" ;\n  rdfs:comment \"Links a line item to the item it describes.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n\n:hasNetPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Links a line item to its net price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price .\n\n:hasQuantity a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Links a line item to its quantity.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Quantity .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Links a summary section to its taxes.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax .\n\n:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Links a summary section to the total invoice amount.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :InvoiceAmount .\n\n:hasInvoiceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"Links a header section to the invoice number.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :InvoiceNumber .\n\n:involvesOrganization a owl:ObjectProperty ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Links an invoice message to an involved organization.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Organization .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Links an invoice message to a role assignment (pivot class).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :RoleAssignment .\n\n:playsRole a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"plays role\" ;\n  rdfs:comment \"Links a role assignment to the agent role played.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole .\n\n:forOrganization a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"for organization\" ;\n  rdfs:comment \"Links a role assignment to the organization playing the role.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization to its address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to its generic identifier.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier .\n\n:hasGlobalLocationNumber a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has global location number\" ;\n  rdfs:comment \"Links an organization to its GLN.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :GlobalLocationNumber .\n\n:hasReferenceNumber a owl:ObjectProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Links a header section to its reference numbers.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :ReferenceNumber .\n\n:hasMandatoryIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has mandatory identifier\" ;\n  rdfs:comment \"Links an invoice message to a mandatory identifier for compliance validation.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Identifier .\n\n:isAssignedToBusinessProcess a owl:ObjectProperty ;\n  rdfs:label \"is assigned to business process\" ;\n  rdfs:comment \"Links an invoice message to a business process.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess .\n\n:hasValidationConstraint a owl:ObjectProperty ;\n  rdfs:label \"has validation constraint\" ;\n  rdfs:comment \"Links an invoice message to a validation constraint (e.g., SHACL rule).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :ValidationConstraint .\n\n:hasCompositeElement a owl:ObjectProperty ;\n  rdfs:label \"has composite element\" ;\n  rdfs:comment \"Links a segment to its composite data elements.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n  rdfs:label \"has simple element\" ;\n  rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement .\n\n:hasRoleInContext a owl:ObjectProperty ;\n  rdfs:label \"has role in context\" ;\n  rdfs:comment \"Links an organization to a role assignment (inverse direction).\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :RoleAssignment .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n\n:hasDate a owl:DatatypeProperty ;\n  rdfs:label \"has date\" ;\n  rdfs:comment \"Links a header section to a date/time value.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:dateTime .\n\n:hasValue a owl:DatatypeProperty ;\n  rdfs:label \"has value\" ;\n  rdfs:comment \"Links a simple data element to its string value.\" ;\n  rdfs:domain :SimpleDataElement ;\n  rdfs:range xsd:string .\n\n#################################################################\n# RESTRICTIONS & GCAs\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    :Message\n    [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :HeaderSection ]\n    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :DetailSection ]\n    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :SummarySection ]\n  )\n] .\n\n:RoleAssignment owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :forOrganization ; owl:someValuesFrom :Organization ]\n    [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ]\n  )\n] .\n\n:LineItem owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ]\n    [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Price ]\n    [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom :Quantity ]\n  )\n] .\n\n#################################################################\n# ANNOTATIONS (for all classes and properties above)\n# (Already included inline)\n#################################################################\n"
}
