\\n#################################################################\\n# PROPERTY CHARACTERISTICS\\n#################################################################\\n\\n:hasMessage rdf:type owl:FunctionalProperty .\\n:hasHeader rdf:type owl:FunctionalProperty .\\n:hasDetail rdf:type owl:FunctionalProperty .\\n:hasSummary rdf:type owl:FunctionalProperty .\\n\\n#################################################################\\n# ANNOTATIONS\\n#################################################################\\n# (All classes and properties above include rdfs:label and rdfs:comment)\\n\\n#################################################################\\n# COMPLEX AXIOMS & RESTRICTIONS\\n#################################################################\\n\\n:InvoiceMessage owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :hasHeader ; owl:allValuesFrom :HeaderSection ] [ rdf:type owl:Restriction ; owl:onProperty :hasDetail ; owl:allValuesFrom :DetailSection ] [ rdf:type owl:Restriction ; owl:onProperty :hasSummary ; owl:allValuesFrom :SummarySection ] ) ] .\\n\\n:LineItem owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :aboutItem ; owl:someValuesFrom :Item ] [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Price ] [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom xsd:decimal ] ) ] .\\n\\n:OrganizationRoleAssignment owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Organization ] [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ] ) ] .\\n\\n#################################################################\\n# INDIVIDUALS (EXAMPLES)\\n#################################################################\\n# (No individuals provided; ontology is schema-level)\\n\"}"