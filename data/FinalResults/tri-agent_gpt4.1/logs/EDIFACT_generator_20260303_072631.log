    {
      "id": "call_tye6tdF4MJAzRVii2jO10azZ",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/edifact-invoice>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"Ontology for modeling the structure and semantics of EDIFACT invoice messages (D96A) including envelopes, messages, segments, organizations, roles, and line items.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A business message such as INVOIC, contained within an InterchangeEnvelope.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within a message, such as BGM or NAD, composed of composite and simple data elements.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment, grouping multiple simple elements.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A basic data element within a composite or segment, representing atomic values.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"An invoice document represented in the EDIFACT INVOIC message format.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A party involved in the invoice, such as buyer, supplier, or delivery party.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the context of an invoice (e.g., Buyer, DeliveryParty).\\\" ;\\n    owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\\n\\n:BuyerRole a owl:Class ;\\n    rdfs:label \\\"Buyer Role\\\" ;\\n    rdfs:comment \\\"A specific agent role indicating the organization is acting as buyer.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:DeliveryPartyRole a owl:Class ;\\n    rdfs:label \\\"Delivery Party Role\\\" ;\\n    rdfs:comment \\\"A specific agent role indicating the organization is acting as delivery party.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address related to an organization.\\\" .\\n\\n:HeadquartersAddress a owl:Class ;\\n    rdfs:label \\\"Headquarters Address\\\" ;\\n    rdfs:comment \\\"The main address of an organization.\\\" ;\\n    rdfs:subClassOf :Address .\\n\\n:WarehouseAddress a owl:Class ;\\n    rdfs:label \\\"Warehouse Address\\\" ;\\n    rdfs:comment \\\"The address of an organization's warehouse.\\\" ;\\n    rdfs:subClassOf :Address .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A globally unique location identifier for organizations.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"An item listed on the invoice, representing goods or services sold.\\\" ;\\n    rdfs:subClassOf :InvoiceLineItemDetail .\\n\\n:P2PItem a owl:Class ;\\n    rdfs:label \\\"P2P Item\\\" ;\\n    rdfs:comment \\\"An item as defined in the Purchase-to-Pay Ontology (P2P-O), subclass of LineItem.\\\" ;\\n    rdfs:subClassOf :LineItem .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The section of the invoice containing general document information (dates, references).\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The section of the invoice listing line items and their details.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The section of the invoice summarizing totals such as tax and invoice amount.\\\" .\\n\\n:InvoiceLineItemDetail a owl:Class ;\\n    rdfs:label \\\"Invoice Line Item Detail\\\" ;\\n    rdfs:comment \\\"A pivot class reifying the relationship between a line item, its price, and quantity for the invoice detail section.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"The net price of a line item on the invoice.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"The number of units for a line item on the invoice.\\\" .\\n\\n:TaxAmount a owl:Class ;\\n    rdfs:label \\\"Tax Amount\\\" ;\\n    rdfs:comment \\\"The total tax amount for the invoice.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n    rdfs:label \\\"Invoice Amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number such as an invoice number.\\\" .\\n\\n:DocumentDate a owl:Class ;\\n    rdfs:label \\\"Document Date\\\" ;\\n    rdfs:comment \\\"A date associated with the invoice document (issue, due, etc.).\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice can be assigned.\\\" .\\n\\n:P2POrganization a owl:Class ;\\n    rdfs:label \\\"P2P Organization\\\" ;\\n    rdfs:comment \\\"An organization as defined in the Purchase-to-Pay Ontology (P2P-O), subclass of Organization.\\\" ;\\n    rdfs:subClassOf :Organization .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A pivot class reifying the assignment of a role to an organization.\\\" .\\n\\n#################################################################\\n# Properties\\n#################################################################\\n\\n# Object Properties\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an InterchangeEnvelope to its contained Message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message .\\n    # Removed owl:TransitiveProperty due to pitfall P29\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a Message to its Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasSegment.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a Segment to its CompositeDataElements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is composite element of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasCompositeElement.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a CompositeDataElement to its SimpleDataElements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is simple element of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasSimpleElement.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n:hasInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice\\\" ;\\n    rdfs:comment \\\"Relates a Message to its Invoice.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :isInvoiceOf .\\n\\n:isInvoiceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is invoice of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasInvoice.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasInvoice .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Relates an Invoice to an involved Organization.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :isOrganizationInvolvedIn .\\n\\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\\n    rdfs:label \\\"is organization involved in\\\" ;\\n    rdfs:comment \\\"Inverse property of involvesOrganization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :involvesOrganization .\\n\\n:hasAgentRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has agent role assignment\\\" ;\\n    rdfs:comment \\\"Relates an Organization to its OrganizationRoleAssignment(s).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :isAgentRoleAssignmentOf .\\n\\n:isAgentRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is agent role assignment of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasAgentRoleAssignment.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAgentRoleAssignment .\\n\\n:hasRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has role\\\