ganizations.\"},{\"property\":\":playsRole\",\"type\":\"ObjectProperty\",\"domain\":\"OrganizationRoleAssignment\",\"range\":\"AgentRole\",\"characteristics\":[\"Functional\"],\"label\":\"plays role\",\"comment\":\"Links a role assignment to a role.\"},{\"property\":\":assignedTo\",\"type\":\"ObjectProperty\",\"domain\":\"OrganizationRoleAssignment\",\"range\":\"Organization\",\"characteristics\":[\"Functional\"],\"label\":\"assigned to\",\"comment\":\"Links a role assignment to an organization.\"},{\"property\":\":hasAddress\",\"type\":\"ObjectProperty\",\"domain\":\"Organization\",\"range\":\"Address\",\"characteristics\":[],\"label\":\"has address\",\"comment\":\"Links an organization to its addresses.\"},{\"property\":\":hasGlobalLocationNumber\",\"type\":\"DataProperty\",\"domain\":\"Organization\",\"range\":\"xsd:string\",\"characteristics\":[\"Functional\"],\"label\":\"has Global Location Number\",\"comment\":\"The organization's global location number.\"},{\"property\":\":hasIdentifier\",\"type\":\"DataProperty\",\"domain\":\"Organization\",\"range\":\"xsd:string\",\"characteristics\":[],\"label\":\"has identifier\",\"comment\":\"Generic identifier for organizations.\"},{\"property\":\":hasName\",\"type\":\"DataProperty\",\"domain\":\"Organization\",\"range\":\"xsd:string\",\"characteristics\":[\"Functional\"],\"label\":\"has name\",\"comment\":\"The name of the organization.\"},{\"property\":\":hasNetPrice\",\"type\":\"DataProperty\",\"domain\":\"Price\",\"range\":\"xsd:decimal\",\"characteristics\":[\"Functional\"],\"label\":\"has net price\",\"comment\":\"The net price of an item.\"},{\"property\":\":hasQuantity\",\"type\":\"DataProperty\",\"domain\":\"LineItem\",\"range\":\"xsd:decimal\",\"characteristics\":[],\"label\":\"has quantity\",\"comment\":\"Quantity of the line item.\"},{\"property\":\":hasTaxAmount\",\"type\":\"DataProperty\",\"domain\":\"Tax\",\"range\":\"xsd:decimal\",\"characteristics\":[\"Functional\"],\"label\":\"has tax amount\",\"commen