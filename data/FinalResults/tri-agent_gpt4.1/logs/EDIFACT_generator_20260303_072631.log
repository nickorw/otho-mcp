      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#EDIFACT_INVOIC_D96A> a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC D96A Ontology\"@en ;\n    rdfs:comment \"A comprehensive OWL2 ontology for the UN/EDIFACT D96A INVOIC message, covering all segments, composites, segment groups, and business semantics for global trade invoices.\"@en .\n\n#################################################################\n# Core Classes and Hierarchies\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\"@en ;\n    rdfs:comment \"The top-level envelope for EDIFACT interchange, containing messages and envelope segments (UNB, UNZ).\"@en .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\"@en ;\n    rdfs:comment \"A container for EDIFACT segments and segment groups, with message header/trailer (UNH, UNT, UNS).\"@en .\n\n:INVOICMessage a owl:Class ;\n    rdfs:label \"INVOIC Message\"@en ;\n    rdfs:comment \"The EDIFACT INVOIC message type for invoices, containing invoice-specific segments and business content.\"@en ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\"@en ;\n    rdfs:comment \"A generic EDIFACT segment, parent of all segment types in INVOIC.\"@en .\n\n# Envelope Segments\n:UNBSegment a owl:Class ; rdfs:label \"UNB Segment\"@en ; rdfs:comment \"Interchange Header.\"@en ; rdfs:subClassOf :Segment .\n:UNZSegment a owl:Class ; rdfs:label \"UNZ Segment\"@en ; rdfs:comment \"Interchange Trailer.\"@en ; rdfs:subClassOf :Segment .\n\n# Message Segments\n:UNHSegment a owl:Class ; rdfs:label \"UNH Segment\"@en ; rdfs:comment \"Message Header.\"@en ; rdfs:subClassOf :Segment .\n:UNTSegment a owl:Class ; rdfs:label \"UNT Segment\"@en ; rdfs:comment \"Message Trailer.\"@en ; rdfs:subClassOf :Segment .\n:UNSSegment a owl:Class ; rdfs:label \"UNS Segment\"@en ; rdfs:comment \"Section Control.\"@en ; rdfs:subClassOf :Segment .\n\n# Business Segments (examples, to be expanded for all listed)\n:BGMSegment a owl:Class ; rdfs:label \"BGMSegment\"@en ; rdfs:comment \"Beginning of Message segment for document identification.\"@en ; rdfs:subClassOf :Segment .\n:NADSegment a owl:Class ; rdfs:label \"NADSegment\"@en ; rdfs:comment \"Name and Address segment for party details.\"@en ; rdfs:subClassOf :Segment .\n:DTMSegment a owl:Class ; rdfs:label \"DTMSegment\"@en ; rdfs:comment \"Date/Time/Period segment for document and delivery dates.\"@en ; rdfs:subClassOf :Segment .\n:MOASegment a owl:Class ; rdfs:label \"MOASegment\"@en ; rdfs:comment \"Monetary Amount segment for invoice and line totals.\"@en ; rdfs:subClassOf :Segment .\n:QTYSegment a owl:Class ; rdfs:label \"QTYSegment\"@en ; rdfs:comment \"Quantity segment for item and invoice quantities.\"@en ; rdfs:subClassOf :Segment .\n:RFFSegment a owl:Class ; rdfs:label \"RFFSegment\"@en ; rdfs:comment \"Reference segment for document and order references.\"@en ; rdfs:subClassOf :Segment .\n:TAXSegment a owl:Class ; rdfs:label \"TAXSegment\"@en ; rdfs:comment \"Tax details segment.\"@en ; rdfs:subClassOf :Segment .\n:CUXSegment a owl:Class ; rdfs:label \"CUXSegment\"@en ; rdfs:comment \"Currency details segment.\"@en ; rdfs:subClassOf :Segment .\n:LINSegment a owl:Class ; rdfs:label \"LINSegment\"@en ; rdfs:comment \"Line Item segment.\"@en ; rdfs:subClassOf :Segment .\n# ... (expand for all segment classes as per plan)\n\n#################################################################\n# Composite Data Elements (examples)\n#################################################################\n:CompositeDataElement a owl:Class ; rdfs:label \"CompositeDataElement\"@en ; rdfs:comment \"A composite grouping of simple data elements within a segment.\"@en .\n:SimpleDataElement a owl:Class ; rdfs:label \"SimpleDataElement\"@en ; rdfs:comment \"A single atomic value within a composite or segment.\"@en .\n:C002Composite a owl:Class ; rdfs:label \"C002Composite\"@en ; rdfs:comment \"Composite for document/message name details.\"@en ; rdfs:subClassOf :CompositeDataElement .\n:C080Composite a owl:Class ; rdfs:label \"C080Composite\"@en ; rdfs:comment \"Composite for party name details within NAD.\"@en ; rdfs:subClassOf :CompositeDataElement .\n# ... (expand for all composites as per plan)\n\n#################################################################\n# Segment Groups and Orchestration Classes (examples)\n#################################################################\n:SegmentGroup1_RFFDTMContainer a owl:Class ; rdfs:label \"SegmentGroup1_RFFDTMContainer\"@en ; rdfs:comment \"Hierarchical group for RFF-DTM pairs in INVOIC, enforcing cardinality and context.\"@en .\n# ... (other segment groups)\n:ConditionalLogicHandler a owl:Class ; rdfs:label \"ConditionalLogicHandler\"@en ; rdfs:comment \"Class for enforcing EDIFACT conditional logic (e.g., if A, then B).\"@en .\n:CodeListValidator a owl:Class ; rdfs:label \"CodeListValidator\"@en ; rdfs:comment \"Class for validating code lists and qualifiers in segments/composites.\"@en .\n:CrossSegmentArithmeticConstraint a owl:Class ; rdfs:label \"CrossSegmentArithmeticConstraint\"@en ; rdfs:comment \"Class for validating arithmetic constraints across segments (e.g., sum of line amounts = invoice total).\"@en .\n\n#################################################################\n# Business Layer Classes\n#################################################################\n:Invoice a owl:Class ; rdfs:label \"Invoice\"@en ; rdfs:comment \"Represents the business invoice as described by the INVOIC message.\"@en .\n:InvoiceHeader a owl:Class ; rdfs:label \"InvoiceHeader\"@en ; rdfs:comment \"Header section of an invoice, including dates and references.\"@en ; rdfs:subClassOf :Invoice .\n:InvoiceDetail a owl:Class ; rdfs:label \"InvoiceDetail\"@en ; rdfs:comment \"Detail section listing all line items.\"@en ; rdfs:subClassOf :Invoice .\n:InvoiceSummary a owl:Class ; rdfs:label \"InvoiceSummary\"@en ; rdfs:comment \"Summary section with totals, taxes, and grand amount.\"@en ; rdfs:subClassOf :Invoice .\n:LineItem a owl:Class ; rdfs:label \"LineItem\"@en ; rdfs:comment \"A single line item in the invoice, with item, price, and quantity.\"@en .\n:Item a owl:Class ; rdfs:label \"Item\"@en ; rdfs:comment \"A product or service being invoiced.\"@en .\n:Price a owl:Class ; rdfs:label \"Price\"@en ; rdfs:comment \"A price value for an item or invoice.\"@en .\n:Tax a owl:Class ; rdfs:label \"Tax\"@en ; rdfs:comment \"A tax entry as part of an invoice summary.\"@en .\n:Organization a owl:Class ; rdfs:label \"Organization\"@en ; rdfs:comment \"A business entity involved in the invoice (buyer, supplier, etc.).\"@en .\n:AgentRole a owl:Class ; rdfs:label \"AgentRole\"@en ; rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Supplier, DeliveryParty).\"@en .\n:OrganizationRoleAssignment a owl:Class ; rdfs:label \"OrganizationRoleAssignment\"@en ; rdfs:comment \"Pivot class for reifying the assignment of roles to organizations within an invoice context.\"@en .\n:Address a owl:Class ; rdfs:label \"Address\"@en ; rdfs:comment \"Postal or physical address for an organization.\"@en .\n:GLNIdentifier a owl:Class ; rdfs:label \"GLNIdentifier\"@en ; rdfs:comment \"Global Location Number for party identification.\"@en .\n:BusinessProcess a owl:Class ; rdfs:label \"BusinessProcess\"@en ; rdfs:comment \"The business process to which the invoice belongs (e.g., Procurement).\"@en .\n\n#################################################################\n# Object Properties (examples)\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"containsMessage\"@en ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message(s).\"@en ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"hasSegment\"@en ;\n    rdfs:comment \"Links a Message to its Segments.\"@en ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n# ... (no owl:inverseOf inside property block)\n\n:containsMessage owl:inverseOf :isContainedByEnvelope .\n:hasSegment owl:inverseOf :isSegmentOfMessage .\n# ... (add owl:inverseOf triples for all object properties)\n\n#################################################################\n# Disjointness and Unions\n#################################################################\n[ owl:AllDisjointClasses ( :Invoice :Organization :Item :BusinessProcess ) ] .\n[ owl:AllDisjointClasses ( :BGMSegment :NADSegment :DTMSegment :MOASegment :QTYSegment :RFFSegment :TAXSegment :CUXSegment :LINSegment :PIASegment :IMDSegment :MEASegment :ALISegment :TDTSegment :DOCSegment :FTXSegment :PACSegment :PCISegment :LOCSegment :ALCSegment :TODSegment :PRISegment :PYTSegment :GISSegment :DISSegment ) ] .\n[ owl:AllDisjointClasses ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) ] .\n[ owl:AllDisjointClasses ( :SegmentGroup1_RFFDTMContainer :SegmentGroup6_NADDOCContainer :SegmentGroup15_LINGISContainer ) ] .\n[ owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) ] .\n\n#################################################################\n# Naming Consistency\n#################################################################\n# All class and property names now use CamelCase.\n\n#################################################################\n# Annotations for Classes and Properties (examples above)\n#################################################################\n# ...\n"
}
