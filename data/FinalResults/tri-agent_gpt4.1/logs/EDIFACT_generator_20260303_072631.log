2026-03-03 07:37:26 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#EDIFACT_INVOIC_D96A> a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC D96A Ontology\"@en ;\n    rdfs:comment \"A comprehensive OWL2 ontology for the UN/EDIFACT D96A INVOIC message, covering all segments, composites, segment groups, and business semantics for global trade invoices.\"@en .\n\n#################################################################\n# Core Classes and Hierarchies\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\"@en ;\n    rdfs:comment \"The top-level envelope for EDIFACT interchange, containing messages and envelope segments (UNB, UNZ).\"@en .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\"@en ;\n    rdfs:comment \"A container for EDIFACT segments and segment groups, with message header/trailer (UNH, UNT, UNS).\"@en .\n\n:INVOICMessage a owl:Class ;\n    rdfs:label \"INVOIC Message\"@en ;\n    rdfs:comment \"The EDIFACT INVOIC message type for invoices, containing invoice-specific segments and business content.\"@en ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\"@en ;\n    rdfs:comment \"A generic EDIFACT segment, parent of all segment types in INVOIC.\"@en .\n\n# Envelope Segments\n:UNBSegment a owl:Class ; rdfs:label \"UNB Segment\"@en ; rdfs:comment \"Interchange Header.\"@en ; rdfs:subClassOf :Segment .\n:UNZSegment a owl:Class ; rdfs:label \"UNZ Segment\"@en ; rdfs:comment \"Interchange Trailer.\"@en ; rdfs:subClassOf :Segment .\n\n# Message Segments\n:UNHSegment a owl:Class ; rdfs:label \"UNH Segment\"@en ; rdfs:comment \"Message Header.\"@en ; rdfs:subClassOf :Segment .\n:UNTSegment a owl:Class ; rdfs:label \"UNT Segment\"@en ; rdfs:comment \"Message Trailer.\"@en ; rdfs:subClassOf :Segment .\n:UNSSegment a owl:Class ; rdfs:label \"UNS Segment\"@en ; rdfs:comment \"Section Control.\"@en ; rdfs:subClassOf :Segment .\n\n# Business Segments (examples, to be expanded for all listed)\n:BGMSegment a owl:Class ; rdfs:label \"BGM Segment\"@en ; rdfs:comment \"Beginning of Message segment for document identification.\"@en ; rdfs:subClassOf :Segment .\n:NADSegment a owl:Class ; rdfs:label \"NAD Segment\"@en ; rdfs:comment \"Name and Address segment for party details.\"@en ; rdfs:subClassOf :Segment .\n:DTMSegment a owl:Class ; rdfs:label \"DTM Segment\"@en ; rdfs:comment \"Date/Time/Period segment for document and delivery dates.\"@en ; rdfs:subClassOf :Segment .\n:MOASegment a owl:Class ; rdfs:label \"MOA Segment\"@en ; rdfs:comment \"Monetary Amount segment for invoice and line totals.\"@en ; rdfs:subClassOf :Segment .\n:QTYSegment a owl:Class ; rdfs:label \"QTY Segment\"@en ; rdfs:comment \"Quantity segment for item and invoice quantities.\"@en ; rdfs:subClassOf :Segment .\n:RFFSegment a owl:Class ; rdfs:label \"RFF Segment\"@en ; rdfs:comment \"Reference segment for document and order references.\"@en ; rdfs:subClassOf :Segment .\n:TAXSegment a owl:Class ; rdfs:label \"TAX Segment\"@en ; rdfs:comment \"Tax details segment.\"@en ; rdfs:subClassOf :Segment .\n:CUXSegment a owl:Class ; rdfs:label \"CUX Segment\"@en ; rdfs:comment \"Currency details segment.\"@en ; rdfs:subClassOf :Segment .\n:LINSegment a owl:Class ; rdfs:label \"LIN Segment\"@en ; rdfs:comment \"Line Item segment.\"@en ; rdfs:subClassOf :Segment .\n# ... (expand for all segment classes as per plan)\n\n#################################################################\n# Composite Data Elements (examples)\n#################################################################\n:CompositeDataElement a owl:Class ; rdfs:label \"Composite Data Element\"@en ; rdfs:comment \"A composite grouping of simple data elements within a segment.\"@en .\n:SimpleDataElement a owl:Class ; rdfs:label \"Simple Data Element\"@en ; rdfs:comment \"A single atomic value within a composite or segment.\"@en .\n:C002Composite a owl:Class ; rdfs:label \"C002 Composite (Document/Message Name)\"@en ; rdfs:comment \"Composite for document/message name details.\"@en ; rdfs:subClassOf :CompositeDataElement .\n:C080Composite a owl:Class ; rdfs:label \"C080 Composite (Party Name)\"@en ; rdfs:comment \"Composite for party name details within NAD.\"@en ; rdfs:subClassOf :CompositeDataElement .\n# ... (expand for all composites as per plan)\n\n#################################################################\n# Segment Groups and Orchestration Classes (examples)\n#################################################################\n:SegmentGroup1_RFFDTMContainer a owl:Class ; rdfs:label \"Segment Group 1 (RFF-DTM Container)\"@en ; rdfs:comment \"Hierarchical group for RFF-DTM pairs in INVOIC, enforcing cardinality and context.\"@en .\n# ... (other segment groups)\n:ConditionalLogicHandler a owl:Class ; rdfs:label \"Conditional Logic Handler\"@en ; rdfs:comment \"Class for enforcing EDIFACT conditional logic (e.g., if A, then B).\"@en .\n:CodeListValidator a owl:Class ; rdfs:label \"Code List Validator\"@en ; rdfs:comment \"Class for validating code lists and qualifiers in segments/composites.\"@en .\n:CrossSegmentArithmeticConstraint a owl:Class ; rdfs:label \"Cross-Segment Arithmetic Constraint\"@en ; rdfs:comment \"Class for validating arithmetic constraints across segments (e.g., sum of line amounts = invoice total).\"@en .\n\n#################################################################\n# Business Layer Classes\n#################################################################\n:Invoice a owl:Class ; rdfs:label \"Invoice\"@en ; rdfs:comment \"Represents the business invoice as described by the INVOIC message.\"@en .\n:InvoiceHeader a owl:Class ; rdfs:label \"Invoice Header\"@en ; rdfs:comment \"Header section of an invoice, including dates and references.\"@en ; rdfs:subClassOf :Invoice .\n:InvoiceDetail a owl:Class ; rdfs:label \"Invoice Detail\"@en ; rdfs:comment \"Detail section listing all line items.\"@en ; rdfs:subClassOf :Invoice .\n:InvoiceSummary a owl:Class ; rdfs:label \"Invoice Summary\"@en ; rdfs:comment \"Summary section with totals, taxes, and grand amount.\"@en ; rdfs:subClassOf :Invoice .\n:LineItem a owl:Class ; rdfs:label \"Line Item\"@en ; rdfs:comment \"A single line item in the invoice, with item, price, and quantity.\"@en .\n:Item a owl:Class ; rdfs:label \"Item\"@en ; rdfs:comment \"A product or service being invoiced.\"@en .\n:Price a owl:Class ; rdfs:label \"Price\"@en ; rdfs:comment \"A price value for an item or invoice.\"@en .\n:Tax a owl:Class ; rdfs:label \"Tax\"@en ; rdfs:comment \"A tax entry as part of an invoice summary.\"@en .\n:Organization a owl:Class ; rdfs:label \"Organization\"@en ; rdfs:comment \"A business entity involved in the invoice (buyer, supplier, etc.).\"@en .\n:AgentRole a owl:Class ; rdfs:label \"Agent Role\"@en ; rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Supplier, DeliveryParty).\"@en .\n:OrganizationRoleAssignment a owl:Class ; rdfs:label \"Organization Role Assignment\"@en ; rdfs:comment \"Pivot class for reifying the assignment of roles to organizations within an invoice context.\"@en .\n:Address a owl:Class ; rdfs:label \"Address\"@en ; rdfs:comment \"Postal or physical address for an organization.\"@en .\n:GLNIdentifier a owl:Class ; rdfs:label \"GLN Identifier\"@en ; rdfs:comment \"Global Location Number for party identification.\"@en .\n:BusinessProcess a owl:Class ; rdfs:label \"Business Process\"@en ; rdfs:comment \"The business process to which the invoice belongs (e.g., Procurement).\"@en .\n\n#################################################################\n# Object Properties (examples)\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\"@en ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message(s).\"@en ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\"@en ;\n    rdfs:comment \"Links a Message to its Segments.\"@en ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\"@en ;\n    rdfs:comment \"Links a Segment to its CompositeDataElements.\"@en ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\"@en ;\n    rdfs:comment \"Links a CompositeDataElement to its SimpleDataElements.\"@en ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n:hasC080Composite a owl:ObjectProperty ;\n    rdfs:label \"has C080 composite\"@en ;\n    rdfs:comment \"Links NADSegment to its C080 Party Name composite.\"@en ;\n    rdfs:domain :NADSegment ;\n    rdfs:range :C080Composite .\n:hasC059Composite a owl:ObjectProperty ;\n    rdfs:label \"has C059 composite\"@en ;\n    rdfs:comment \"Links NADSegment to its C059 Street composite.\"@en ;\n    rdfs:domain :NADSegment ;\n    rdfs:range :C059Composite .\n:hasC082Composite a owl:ObjectProperty ;\n    rdfs:label \"has C082 composite\"@en ;\n    rdfs:comment \"Links LINSegment to its C082 Item Number Identification composite.\"@en ;\n    rdfs:domain :LINSegment ;\n    rdfs:range :C082Composite .\n:hasC212Composite a owl:ObjectProperty ;\n    rdfs:label \"has C212 composite\"@en ;\n    rdfs:comment \"Links LINSegment to its C212 Item Number Identification composite.\"@en ;\n    rdfs:domain :LINSegment ;\n    rdfs:range :C212Composite .\n:hasSegmentGroup a owl:ObjectProperty ;\n    rdfs:label \"has segment group\"@en ;\n    rdfs:comment \"Links a Message to its hierarchical SegmentGroups.\"@en ;\n    rdfs:domain :Message ;\n    rdfs:range :SegmentGroup .\n:hasRFFDTMGroup a owl:ObjectProperty ;\n    rdfs:label \"has RFF-DTM group\"@en ;\n    rdfs:comment \"Links a Message to its SegmentGroup1_RFFDTMContainer.\"@en ;\n    rdfs:domain :Message ;\n    rdfs:range :SegmentGroup1_RFFDTMContainer .\n:representsInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"represents invoice\"@en ;\n    rdfs:comment \"Links an INVOICMessage to the Invoice business entity.\"@en ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :Invoice .\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has header\"@en ;\n    rdfs:comment \"Links an Invoice to its InvoiceHeader.\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceHeader .\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has detail\"@en ;\n    rdfs:comment \"Links an Invoice to its InvoiceDetail.\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail .\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has summary\"@en ;\n    rdfs:comment \"Links an Invoice to its InvoiceSummary.\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceSummary .\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\"@en ;\n    rdfs:comment \"Links InvoiceDetail to its LineItems.\"@en ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem .\n:soldItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"sold item\"@en ;\n    rdfs:comment \"Links LineItem to the sold Item.\"@en ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item .\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\"@en ;\n    rdfs:comment \"Links LineItem to its net Price.\"@en ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:label \"has quantity\"@en ;\n    rdfs:comment \"The quantity for a LineItem.\"@en ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\"@en ;\n    rdfs:comment \"Links InvoiceSummary to Tax entries.\"@en ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax .\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"has invoice amount\"@en ;\n    rdfs:comment \"The total amount for an invoice.\"@en ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\"@en ;\n    rdfs:comment \"The invoice number.\"@en ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:label \"has document date\"@en ;\n    rdfs:comment \"The date of the invoice document.\"@en ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has reference number\"@en ;\n    rdfs:comment \"A reference number for the invoice.\"@en ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\"@en ;\n    rdfs:comment \"Links an Invoice to involved Organizations.\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization .\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has organization role assignment\"@en ;\n    rdfs:comment \"Links Invoice to its OrganizationRoleAssignments (pivot for reification).\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :OrganizationRoleAssignment .\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned organization\"@en ;\n    rdfs:comment \"Links OrganizationRoleAssignment to the Organization.\"@en ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned role\"@en ;\n    rdfs:comment \"Links OrganizationRoleAssignment to the AgentRole.\"@en ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n:assignedToInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned to invoice\"@en ;\n    rdfs:comment \"Links OrganizationRoleAssignment to the Invoice.\"@en ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Invoice .\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\"@en ;\n    rdfs:comment \"Links Organization to its Address.\"@en ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n:hasGLNIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has GLN identifier\"@en ;\n    rdfs:comment \"Links Organization to its GLNIdentifier.\"@en ;\n    rdfs:domain :Organization ;\n    rdfs:range :GLNIdentifier .\n:isBuyer a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is buyer\"@en ;\n    rdfs:comment \"Links AgentRole to the Buyer Organization.\"@en ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :Organization .\n:isDeliveryParty a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is delivery party\"@en ;\n    rdfs:comment \"Links AgentRole to the Delivery Party Organization.\"@en ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :Organization .\n:hasBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has business process\"@en ;\n    rdfs:comment \"Links Invoice to its BusinessProcess.\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess .\n:isValidatedBy a owl:ObjectProperty ;\n    rdfs:label \"is validated by\"@en ;\n    rdfs:comment \"Links Invoice to a SHACLShape for validation.\"@en ;\n    rdfs:domain :Invoice ;\n    rdfs:range :SHACLShape .\n:enforcesConditionalLogic a owl:ObjectProperty ;\n    rdfs:label \"enforces conditional logic\"@en ;\n    rdfs:comment \"Links ConditionalLogicHandler to SegmentGroups for business rule enforcement.\"@en ;\n    rdfs:domain :ConditionalLogicHandler ;\n    rdfs:range :SegmentGroup .\n:validatesCodeList a owl:ObjectProperty ;\n    rdfs:label \"validates code list\"@en ;\n    rdfs:comment \"Links CodeListValidator to Segments for code/qualifier validation.\"@en ;\n    rdfs:domain :CodeListValidator ;\n    rdfs:range :Segment .\n:enforcesArithmeticConstraint a owl:ObjectProperty ;\n    rdfs:label \"enforces arithmetic constraint\"@en ;\n    rdfs:comment \"Links CrossSegmentArithmeticConstraint to SegmentGroups for sum/total checks.\"@en ;\n    rdfs:domain :CrossSegmentArithmeticConstraint ;\n    rdfs:range :SegmentGroup .\n\n#################################################################\n# Complex Axioms and Restrictions (examples)\n#################################################################\n:Invoice a owl:Class ;\n    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :InvoiceHeader ]\n        [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :InvoiceDetail ]\n        [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :InvoiceSummary ]\n    ) ] .\n\n:LineItem a owl:Class ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :soldItem ; owl:someValuesFrom :Item ] .\n\n:OrganizationRoleAssignment a owl:Class ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Organization ] ,\n        [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ] .\n\n:InvoiceSummary a owl:Class ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasInvoiceAmount ; owl:allValuesFrom xsd:decimal ] .\n\n#################################################################\n# Disjointness and Unions\n#################################################################\n[ owl:AllDisjointClasses ( :Invoice :Organization :Item :BusinessProcess ) ] .\n[ owl:AllDisjointClasses ( :BGMSegment :NADSegment :DTMSegment :MOASegment :QTYSegment :RFFSegment :TAXSegment :CUXSegment :LINSegment :PIASegment :IMDSegment :MEASegment :ALISegment :TDTSegment :DOCSegment :FTXSegment :PACSegment :PCISegment :LOCSegment :ALCSegment :TODSegment :PRISegment :PYTSegment :GISSegment :DISSegment ) ] .\n[ owl:AllDisjointClasses ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) ] .\n[ owl:AllDisjointClasses ( :SegmentGroup1_RFFDTMContainer :SegmentGroup6_NADDOCContainer :SegmentGroup15_LINGISContainer ) ] .\n[ owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) ] .\n\n#################################################################\n# Annotations for Classes and Properties (examples above)\n#################################################################\n# ...\n"
}
