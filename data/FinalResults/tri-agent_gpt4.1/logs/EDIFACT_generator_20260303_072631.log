      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-ontology>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"A deeply structured ontology for modeling UN/EDIFACT invoice messages, segments, and organizational roles, aligned with D96A and EN 16931-1.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level envelope that contains one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT invoice message (INVOIC).\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"The Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"The Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header section of an invoice, containing dates and references.\" ;\n    rdfs:subClassOf :Segment .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The detail section with line items.\" ;\n    rdfs:subClassOf :Segment .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The summary section with totals and tax.\" ;\n    rdfs:subClassOf :Segment .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A business organization involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction.\" ;\n    owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"The role of buyer in an invoice transaction.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"The role of delivery party in an invoice transaction.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A physical or logical address related to an organization.\" ;\n    owl:disjointUnionOf ( :WarehouseAddress :HeadquartersAddress ) .\n\n:WarehouseAddress a owl:Class ;\n    rdfs:label \"Warehouse Address\" ;\n    rdfs:comment \"Address of a warehouse related to an organization.\" ;\n    rdfs:subClassOf :Address .\n\n:HeadquartersAddress a owl:Class ;\n    rdfs:label \"Headquarters Address\" ;\n    rdfs:comment \"Headquarters address of an organization.\" ;\n    rdfs:subClassOf :Address .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item sold in the invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the invoice, referencing an item and its price.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item or invoice.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information for the invoice.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for the document.\" .\n\n:DocumentDate a owl:Class ;\n    rdfs:label \"Document Date\" ;\n    rdfs:comment \"The date of the invoice document.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier for organizations or documents.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validating the invoice according to rules or standards.\" .\n\n:P2PItem a owl:Class ;\n    rdfs:label \"P2P-O Item\" ;\n    rdfs:comment \"A core item class from the Purchase-to-Pay Ontology.\" ;\n    rdfs:subClassOf :Item .\n\n:P2POrganization a owl:Class ;\n    rdfs:label \"P2P-O Organization\" ;\n    rdfs:comment \"A core organization class from the Purchase-to-Pay Ontology.\" ;\n    rdfs:subClassOf :Organization .\n\n#################################################################\n# PIVOT/REIFICATION CLASSES\n#################################################################\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A reification class linking an organization to a role in a specific context.\" .\n\n:LineItemDetail a owl:Class ;\n    rdfs:label \"Line Item Detail\" ;\n    rdfs:comment \"A reification class capturing detailed attributes of a line item.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to its contained message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"message is contained in envelope\" ;\n    rdfs:comment \"The message is contained in an interchange envelope.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Associates a message with its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"segment of message\" ;\n    rdfs:comment \"The segment is part of a message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    owl:inverseOf :hasSegment .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Associates an invoice message with its sections: header, detail, summary.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSectionOf .\n\n:isSectionOf a owl:ObjectProperty ;\n    rdfs:label \"section of invoice message\" ;\n    rdfs:comment \"The section is part of an invoice message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasSection .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Associates the detail section with line items.\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:label \"line item of detail section\" ;\n    rdfs:comment \"The line item belongs to a detail section.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    owl:inverseOf :hasLineItem .\n\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Associates a line item with the item being sold.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:inverseOf :isItemOfLineItem .\n\n:isItemOfLineItem a owl:ObjectProperty ;\n    rdfs:label \"line item for item\" ;\n    rdfs:comment \"The item is referenced by a line item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasItem .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Associates a line item with its price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isPriceOfLineItem .\n\n:isPriceOfLineItem a owl:ObjectProperty ;\n    rdfs:label \"price of line item\" ;\n    rdfs:comment \"The price is associated with a line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasPrice .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Associates the summary section with tax information.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax ;\n    owl:inverseOf :isTaxOfSummary .\n\n:isTaxOfSummary a owl:ObjectProperty ;\n    rdfs:label \"tax of summary section\" ;\n    rdfs:comment \"The tax is part of a summary section.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range :SummarySection ;\n    owl:inverseOf :hasTax .\n\n:hasInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Links summary to total invoice amount.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceAmount ;\n    owl:inverseOf :isInvoiceAmountOfSummary .\n\n:isInvoiceAmountOfSummary a owl:ObjectProperty ;\n    rdfs:label \"invoice amount of summary section\" ;\n    rdfs:comment \"The invoice amount is part of a summary section.\" ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range :SummarySection ;\n    owl:inverseOf :hasInvoiceAmount .\n\n:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Links header to document reference number.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :ReferenceNumber ;\n    owl:inverseOf :isReferenceNumberOfHeader .\n\n:isReferenceNumberOfHeader a owl:ObjectProperty ;\n    rdfs:label \"reference number of header section\" ;\n    rdfs:comment \"The reference number is part of a header section.\" ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range :HeaderSection ;\n    owl:inverseOf :hasReferenceNumber .\n\n:hasDocumentDate a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Links header to document date.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :DocumentDate ;\n    owl:inverseOf :isDocumentDateOfHeader .\n\n:isDocumentDateOfHeader a owl:ObjectProperty ;\n    rdfs:label \"document date of header section\" ;\n    rdfs:comment \"The document date is part of a header section.\" ;\n    rdfs:domain :DocumentDate ;\n    rdfs:range :HeaderSection ;\n    owl:inverseOf :hasDocumentDate .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an invoice message to involved organizations.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:label \"organization involved in invoice message\" ;\n    rdfs:comment \"The organization is involved in an invoice message.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :involvesOrganization .\n\n:playsRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Links a role assignment to a role.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isRolePlayedInAssignment .\n\n:isRolePlayedInAssignment a owl:ObjectProperty ;\n    rdfs:label \"role played in assignment\" ;\n    rdfs:comment \"The role is played in a specific assignment.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :playsRole .\n\n:assignedTo a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned to\" ;\n    rdfs:comment \"Links a role assignment to an organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"role assignment of organization\" ;\n    rdfs:comment \"The role assignment relates to an organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :assignedTo .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its addresses.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOfOrganization .\n\n:isAddressOfOrganization a owl:ObjectProperty ;\n    rdfs:label \"address of organization\" ;\n    rdfs:comment \"The address belongs to an organization.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links invoice to the relevant business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:label \"business process of invoice message\" ;\n    rdfs:comment \"The business process to which an invoice message is assigned.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasBusinessProcess .\n\n:isValidatedBy a owl:ObjectProperty ;\n    rdfs:label \"is validated by\" ;\n    rdfs:comment \"Links an invoice message to a validation constraint.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    owl:inverseOf :validates .\n\n:validates a owl:ObjectProperty ;\n    rdfs:label \"validates invoice message\" ;\n    rdfs:comment \"The constraint validates an invoice message.\" ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :isValidatedBy .\n\n:hasMandatoryIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has mandatory identifier\" ;\n    rdfs:comment \"Links invoice message to mandatory identifiers.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Identifier ;\n    owl:inverseOf :isMandatoryIdentifierOf .\n\n:isMandatoryIdentifierOf a owl:ObjectProperty ;\n    rdfs:label \"mandatory identifier of invoice message\" ;\n    rdfs:comment \"The identifier is mandatory for an invoice message.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasMandatoryIdentifier .\n\n:hasP2PItem a owl:ObjectProperty ;\n    rdfs:label \"has P2P item\" ;\n    rdfs:comment \"Links line item to P2P-O item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :P2PItem ;\n    owl:inverseOf :isP2PItemOfLineItem .\n\n:isP2PItemOfLineItem a owl:ObjectProperty ;\n    rdfs:label \"P2P item of line item\" ;\n    rdfs:comment \"The P2P-O item is associated with a line item.\" ;\n    rdfs:domain :P2PItem ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasP2PItem .\n\n:hasP2POrganization a owl:ObjectProperty ;\n    rdfs:label \"has P2P organization\" ;\n    rdfs:comment \"Links organization to P2P-O organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :P2POrganization ;\n    owl:inverseOf :isP2POrganizationOf .\n\n:isP2POrganizationOf a owl:ObjectProperty ;\n    rdfs:label \"P2P organization of organization\" ;\n    rdfs:comment \"The P2P-O organization is associated with an organization.\" ;\n    rdfs:domain :P2POrganization ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasP2POrganization .\n\n# Pivot class LineItemDetail now connected\n:detailsLineItem a owl:ObjectProperty ;\n    rdfs:label \"details line item\" ;\n    rdfs:comment \"Connects LineItemDetail to the LineItem it details.\" ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isDetailedBy .\n\n:isDetailedBy a owl:ObjectProperty ;\n    rdfs:label \"detailed by line item detail\" ;\n    rdfs:comment \"The line item is detailed by a LineItemDetail resource.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :LineItemDetail ;\n    owl:inverseOf :detailsLineItem .\n\n:detailsItem a owl:ObjectProperty ;\n    rdfs:label \"details item\" ;\n    rdfs:comment \"Connects LineItemDetail to the Item it details.\" ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :Item ;\n    owl:inverseOf :isItemDetailedBy .\n\n:isItemDetailedBy a owl:ObjectProperty ;\n    rdfs:label \"item detailed by line item detail\" ;\n    rdfs:comment \"The item is detailed by a LineItemDetail resource.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItemDetail ;\n    owl:inverseOf :detailsItem .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n:hasGlobalLocationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has Global Location Number\" ;\n    rdfs:comment \"The organization's global location number.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Generic identifier for organizations.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasName a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has name\" ;\n    rdfs:comment \"The name of the organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of an item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Quantity of the line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:hasTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"The total tax amount.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n#################################################################\n# RESTRICTIONS & GCAs\n#################################################################\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :HeaderSection ] ,\n                                 [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :DetailSection ] ,\n                                 [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :SummarySection ] .\n\n:OrganizationRoleAssignment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :playsRole ; owl:allValuesFrom :AgentRole ] .\n\n:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:allValuesFrom :Address ] .\n\n#################################################################\n# ANNOTATIONS\n#################################################################\n# (All classes and properties have rdfs:label and rdfs:comment as required)\n"
}
