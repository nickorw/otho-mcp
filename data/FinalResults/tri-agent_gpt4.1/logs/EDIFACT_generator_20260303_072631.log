      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Story Ontology\" ;\n    rdfs:comment \"Ontology representing the structure of EDIFACT INVOIC messages, segments, and business semantics for procurement scenarios as described in the story.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope that contains EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:INVOICMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message for invoices.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment, identifies the document.\" .\n\n:NADSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment, provides participant details.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element in an EDIFACT segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element in an EDIFACT segment.\" .\n\n:Section a owl:Class ;\n    rdfs:label \"Section\" ;\n    rdfs:comment \"A generic section within an INVOIC message (Header, Detail, or Summary).\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:subClassOf :Section ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section of an invoice message, contains document dates and reference numbers.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:subClassOf :Section ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section of an invoice message, lists line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:subClassOf :Section ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section of an invoice message, provides totals.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"An invoice document within the INVOIC message.\" .\n\n:InvoiceLine a owl:Class ;\n    rdfs:label \"Invoice Line\" ;\n    rdfs:comment \"A line item within an invoice.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the transaction (buyer, seller, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice (e.g., Buyer, Supplier, Delivery Party).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier assigned to an organization (e.g., VAT, DUNS).\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:subClassOf :Identifier ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A GLN identifier for organizations.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value associated with an item or invoice line.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information for the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validating the invoice structure and content.\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A reification class linking an organization to a role in the context of a specific invoice.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:InterchangeEnvelope owl:disjointWith :Message, :Segment, :CompositeDataElement, :SimpleDataElement, :Invoice, :Organization, :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Message owl:disjointWith :Segment, :CompositeDataElement, :SimpleDataElement, :Invoice, :Organization, :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Segment owl:disjointWith :CompositeDataElement, :SimpleDataElement, :Invoice, :Organization, :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:CompositeDataElement owl:disjointWith :SimpleDataElement, :Invoice, :Organization, :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:SimpleDataElement owl:disjointWith :Invoice, :Organization, :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Invoice owl:disjointWith :Organization, :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Organization owl:disjointWith :AgentRole, :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:AgentRole owl:disjointWith :Address, :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Address owl:disjointWith :Identifier, :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Identifier owl:disjointWith :Item, :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Item owl:disjointWith :Price, :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Price owl:disjointWith :Tax, :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:Tax owl:disjointWith :BusinessProcess, :ValidationConstraint, :RoleAssignment, :Section .\n:BusinessProcess owl:disjointWith :ValidationConstraint, :RoleAssignment, :Section .\n:ValidationConstraint owl:disjointWith :RoleAssignment, :Section .\n:RoleAssignment owl:disjointWith :Section .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to the contained Message.\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :Section ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an INVOICMessage to its header, detail, and summary sections.\" ;\n    owl:inverseOf :isSectionOf .\n\n:isSectionOf a owl:ObjectProperty ;\n    rdfs:domain :Section ;\n    rdfs:range :INVOICMessage ;\n    rdfs:label \"is section of\" ;\n    rdfs:comment \"Inverse of hasSection.\" .\n\n:hasInvoice a owl:ObjectProperty ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :Invoice ;\n    rdfs:label \"has invoice\" ;\n    rdfs:comment \"Links an INVOICMessage to an Invoice.\" ;\n    owl:inverseOf :isInvoiceOf .\n\n:isInvoiceOf a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :INVOICMessage ;\n    rdfs:label \"is invoice of\" ;\n    rdfs:comment \"Inverse of hasInvoice.\" .\n\n:hasLine a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceLine ;\n    rdfs:label \"has line\" ;\n    rdfs:comment \"Links an Invoice to its InvoiceLines.\" ;\n    owl:inverseOf :isLineOf .\n\n:isLineOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is line of\" ;\n    rdfs:comment \"Inverse of hasLine.\" .\n\n:hasOrganization a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdfs:label \"has organization\" ;\n    rdfs:comment \"Links an Invoice to involved Organizations.\" ;\n    owl:inverseOf :isOrganizationIn .\n\n:isOrganizationIn a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is organization in\" ;\n    rdfs:comment \"Inverse of hasOrganization.\" .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an Organization to its RoleAssignments.\" ;\n    owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"is role assignment of\" ;\n    rdfs:comment \"Inverse of hasRoleAssignment.\" .\n\n:playsRole a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Links a RoleAssignment to an AgentRole.\" ;\n    owl:inverseOf :isRolePlayedInAssignment .\n\n:isRolePlayedInAssignment a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"is role played in assignment\" ;\n    rdfs:comment \"Inverse of playsRole.\" .\n\n:inContextOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Invoice ;\n    rdfs:label \"in context of invoice\" ;\n    rdfs:comment \"Links a RoleAssignment to the Invoice context.\" ;\n    owl:inverseOf :hasRoleAssignmentInContext .\n\n:hasRoleAssignmentInContext a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"has role assignment in context\" ;\n    rdfs:comment \"Inverse of inContextOfInvoice.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to its Addresses.\" ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an Organization to its Identifiers.\" ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier.\" .\n\n:hasGLN a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Links an Organization to its Global Location Number (GLN).\" ;\n    owl:inverseOf :isGLNOf .\n\n:isGLNOf a owl:ObjectProperty ;\n    rdfs:domain :GlobalLocationNumber ;\n    rdfs:range :Organization ;\n    rdfs:label \"is GLN of\" ;\n    rdfs:comment \"Inverse of hasGLN.\" .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Item ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links an InvoiceLine to an Item.\" ;\n    owl:inverseOf :isItemOfLine .\n\n:isItemOfLine a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :InvoiceLine ;\n    rdfs:label \"is item of line\" ;\n    rdfs:comment \"Inverse of hasItem.\" .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links an InvoiceLine to its net Price.\" ;\n    owl:inverseOf :isNetPriceOfLine .\n\n:isNetPriceOfLine a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :InvoiceLine ;\n    rdfs:label \"is net price of line\" ;\n    rdfs:comment \"Inverse of hasNetPrice.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links an Invoice to its Tax information.\" ;\n    owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is tax of\" ;\n    rdfs:comment \"Inverse of hasTax.\" .\n\n:hasValidationConstraint a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :ValidationConstraint ;\n    rdfs:label \"has validation constraint\" ;\n    rdfs:comment \"Links an Invoice to ValidationConstraints for SHACL validation.\" ;\n    owl:inverseOf :isValidationConstraintOf .\n\n:isValidationConstraintOf a owl:ObjectProperty ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is validation constraint of\" ;\n    rdfs:comment \"Inverse of hasValidationConstraint.\" .\n\n:isValidForBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"is valid for business process\" ;\n    rdfs:comment \"Links an Invoice to a BusinessProcess.\" ;\n    owl:inverseOf :hasInvoiceValidFor .\n\n:hasInvoiceValidFor a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :Invoice ;\n    rdfs:label \"has invoice valid for\" ;\n    rdfs:comment \"Inverse of isValidForBusinessProcess.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a Segment to its CompositeDataElements.\" ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Specifies the quantity for an InvoiceLine.\" .\n\n:hasTotalAmount a owl:DatatypeProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has total amount\" ;\n    rdfs:comment \"The total amount for an Invoice.\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number for an Invoice.\" .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The document date for an Invoice (ISO 8601 string).\" .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"The reference number for an Invoice.\" .\n\n:hasLabel a owl:DatatypeProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has label\" ;\n    rdfs:comment \"Label for a SimpleDataElement.\" .\n\n:hasValue a owl:DatatypeProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has value\" ;\n    rdfs:comment \"Value of a SimpleDataElement.\" .\n\n#################################################################\n# Property Characteristics\n#################################################################\n\n:containsMessage a owl:FunctionalProperty .\n:hasGLN a owl:FunctionalProperty .\n:hasInvoiceNumber a owl:FunctionalProperty .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n\n:Invoice a owl:Class ;\n    owl:equivalentClass [\n        a owl:Class ;\n        owl:intersectionOf (\n            [ a owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:cardinality \"1\"^^xsd:nonNegativeInteger ]\n            [ a owl:Restriction ; owl:onProperty :hasLine ; owl:minCardinality \"1\"^^xsd:nonNegativeInteger ]\n        )\n    ] .\n\n:RoleAssignment a owl:Class ;\n    owl:equivalentClass [\n        a owl:Class ;\n        owl:intersectionOf (\n            [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ]\n            [ a owl:Restriction ; owl:onProperty :inContextOfInvoice ; owl:someValuesFrom :Invoice ]\n        )\n    ] .\n\n:Organization a owl:Class ;\n    owl:equivalentClass [\n        a owl:Class ;\n        owl:intersectionOf (\n            [ a owl:Restriction ; owl:onProperty :hasRoleAssignment ; owl:someValuesFrom :RoleAssignment ]\n        )\n    ] .\n\n#################################################################\n# End of ontology\n#################################################################\n"
