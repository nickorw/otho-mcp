ion ;\\n    rdfs:range :GlobalLocationNumber .\\n    a owl:FunctionalProperty .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Relates a LineItem to its Item.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item .\\n    a owl:FunctionalProperty .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Relates a LineItem to its net Price.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price .\\n    a owl:FunctionalProperty .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Relates a SummarySection to its Tax.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax .\\n\\n:hasInvoiceAmount a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Relates a SummarySection to its InvoiceAmount.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :InvoiceAmount .\\n    a owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Relates a HeaderSection to its ReferenceNumber.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :ReferenceNumber .\\n    a owl:FunctionalProperty .\\n\\n:isAssignedToProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned to process\\\" ;\\n    rdfs:comment \\\"Assigns an InvoiceMessage to a BusinessProcess.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n\\n:compliesWithEN16931 a owl:ObjectProperty ;\\n    rdfs:label \\\"complies with EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates EN 16931-1 compliance for an InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :EN16931Compliance .\\n    a owl:FunctionalProperty .\\n\\n:alignedWithP2PO a owl:ObjectProperty ;\\n    rdfs:label \\\"aligned with P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates P2P-O alignment for an InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :P2POAlignment .\\n    a owl:FunctionalProperty .\\n\\n:validatedBySHACL a owl:ObjectProperty ;\\n    rdfs:label \\\"validated by SHACL\\\" ;\\n    rdfs:comment \\\"Indicates SHACL validation for an InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SHACLConstraint .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a Segment to its CompositeDataElements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a CompositeDataElement to its SimpleDataElements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:usesDelimiter a owl:ObjectProperty ;\\n    rdfs:label \\\"uses delimiter\\\" ;\\n    rdfs:comment \\\"Relates a Segment to a Delimiter used in EDIFACT syntax.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Delimiter .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity for a LineItem.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:hasDocumentDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The date of the invoice document (string for OWL 2 DL compliance).\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number as a string.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range xsd:string .\\n    a owl:FunctionalProperty .\\n\\n#################################################################\\n# Disjoint and Equivalence Axioms\\n#################################################################\\n\\n:Organization owl:disjointWith :Item .\\n:Address owl:disjointWith :Item .\\n:Price owl:disjointWith :Tax .\\n:Message owl:disjointWith :Segment .\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n\\n# The following line is commented out because Turtle does not support owl:disjointUnionOf directly\\n# owl:disjointUnionOf ( :BGM_Segment :NAD_Segment :HeaderSection :DetailSection :SummarySection ) :Segment .\\n\\n#################################################################\\n# Restrictions and Complex Axioms\\n#################################################################\\n\\n:InvoiceMessage owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n      [ owl:onProperty :hasSection ; owl:someValuesFrom :HeaderSection ]\\n      [ owl:onProperty :hasSection ; owl:someValuesFrom :DetailSection ]\\n      [ owl:onProperty :hasSection ; owl:someValuesFrom :SummarySection ]\\n    )\\n] .\\n\\n:Pivot_OrganizationRoleAssignment owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n      [ owl:onProperty :hasAgentRole ; owl:allValuesFrom :AgentRole ]\\n      [ owl:onProperty :hasParticipant ; owl:allValuesFrom :Organization ]\\n    )\\n] .\\n\"}",
