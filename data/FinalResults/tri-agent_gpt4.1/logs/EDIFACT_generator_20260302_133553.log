s:comment \"Summary section with totals and taxes.\" ;\n    rdfs:subClassOf :Segment .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A single line item in the invoice.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the business process.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization (e.g., Buyer, Supplier, DeliveryParty).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A unique global location identifier (GLN).\" ;\n    rdfs:subClassOf :Identifier .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item or product listed in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value, e.g., net price for a line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax amount or type in the invoice.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Document or invoice reference number.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:EN16931Compliance a owl:Class ;\n    rdfs:label \"EN 16931 Compliance\" ;\n    rdfs:comment \"Represents compliance with EN 16931-1 standard.\" .\n\n:P2POAlignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment with the Purchase-to-Pay Ontology (P2P-O).\" .\n\n:SHACLConstraint a owl:Class ;\n    r