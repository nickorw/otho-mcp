2026-03-02 13:43:28 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\n  rdfs:label \"EDIFACT INVOIC D96A/EANCOM Ontology\" ;\n  rdfs:comment \"A deep, profoundly structured ontology for the UN/EDIFACT INVOIC message, covering all D96A/EANCOM mandatory segments, roles, and composites, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"InterchangeEnvelope\" ;\n  rdfs:comment \"The root envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"EDIFACTMessage\" ;\n  rdfs:comment \"A generic EDIFACT message contained within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:label \"InvoiceMessage\" ;\n  rdfs:comment \"An INVOIC message representing a global trade invoice. Subclass of Message.\" ;\n  rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n  rdfs:label \"EDIFACTSegment\" ;\n  rdfs:comment \"A generic EDIFACT segment.\" .\n\n:BGMSegment a owl:Class ;\n  rdfs:label \"BGMSegment\" ;\n  rdfs:comment \"Beginning of Message segment for document identification.\" ;\n  rdfs:subClassOf :Segment .\n\n:NADSegment a owl:Class ;\n  rdfs:label \"NADSegment\" ;\n  rdfs:comment \"Name and Address segment for participant details.\" ;\n  rdfs:subClassOf :Segment .\n\n:DTMSegment a owl:Class ;\n  rdfs:label \"DTMSegment\" ;\n  rdfs:comment \"Date/Time/Period segment for document, delivery, and tax dates.\" ;\n  rdfs:subClassOf :Segment .\n\n:RFFSegment a owl:Class ;\n  rdfs:label \"RFFSegment\" ;\n  rdfs:comment \"Reference segment for document, order, and line item references.\" ;\n  rdfs:subClassOf :Segment .\n\n:MOASegment a owl:Class ;\n  rdfs:label \"MOASegment\" ;\n  rdfs:comment \"Monetary Amount segment for totals, taxes, and line item amounts.\" ;\n  rdfs:subClassOf :Segment .\n\n:QTYSegment a owl:Class ;\n  rdfs:label \"QTYSegment\" ;\n  rdfs:comment \"Quantity segment for invoiced, delivered, and despatched quantities.\" ;\n  rdfs:subClassOf :Segment .\n\n:LINSegment a owl:Class ;\n  rdfs:label \"LINSegment\" ;\n  rdfs:comment \"Line Item segment for item identification and line numbering.\" ;\n  rdfs:subClassOf :Segment .\n\n:IMDSegment a owl:Class ;\n  rdfs:label \"IMDSegment\" ;\n  rdfs:comment \"Item Description segment for line item textual descriptions.\" ;\n  rdfs:subClassOf :Segment .\n\n:PRISegment a owl:Class ;\n  rdfs:label \"PRISegment\" ;\n  rdfs:comment \"Price segment for line item net prices.\" ;\n  rdfs:subClassOf :Segment .\n\n:TAXSegment a owl:Class ;\n  rdfs:label \"TAXSegment\" ;\n  rdfs:comment \"Tax segment for tax category, type, and rate details.\" ;\n  rdfs:subClassOf :Segment .\n\n:ALCSegment a owl:Class ;\n  rdfs:label \"ALCSegment\" ;\n  rdfs:comment \"Allowance/Charge segment for discounts and surcharges.\" ;\n  rdfs:subClassOf :Segment .\n\n:PACSegment a owl:Class ;\n  rdfs:label \"PACSegment\" ;\n  rdfs:comment \"Package segment for packaging details at line or message level.\" ;\n  rdfs:subClassOf :Segment .\n\n:MEASegment a owl:Class ;\n  rdfs:label \"MEASegment\" ;\n  rdfs:comment \"Measurement segment for physical measurements and weights.\" ;\n  rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"CompositeDataElement\" ;\n  rdfs:comment \"A composite data element grouping multiple simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"SimpleDataElement\" ;\n  rdfs:comment \"A simple data element holding atomic values.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:HeaderSection a owl:Class ;\n  rdfs:label \"HeaderSection\" ;\n  rdfs:comment \"Header section of an invoice, containing document metadata.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:DetailSection a owl:Class ;\n  rdfs:label \"DetailSection\" ;\n  rdfs:comment \"Detail section listing invoice line items.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:SummarySection a owl:Class ;\n  rdfs:label \"SummarySection\" ;\n  rdfs:comment \"Summary section providing invoice totals, taxes, and allowances.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"A legal entity involved in the invoice (buyer, supplier, etc.).\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"AgentRole\" ;\n  rdfs:comment \"A role played by an organization in a business process (e.g., Buyer, Supplier).\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service described in a line item.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A monetary value assigned to an item or total.\" .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"A tax amount or tax type applied to the invoice or line item.\" .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"A unique identifier such as a GLN (Global Location Number).\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"BusinessProcess\" ;\n  rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:RoleAssignment a owl:Class ;\n  rdfs:label \"RoleAssignment\" ;\n  rdfs:comment \"A reification (pivot) class linking an organization, its role, and the invoice context.\" .\n\n:LineItem a owl:Class ;\n  rdfs:label \"LineItem\" ;\n  rdfs:comment \"A single line item within the detail section of the invoice.\" .\n\n:C002DocumentMessageName a owl:Class ;\n  rdfs:label \"C002DocumentMessageName\" ;\n  rdfs:comment \"Composite for document/message name in BGM segment.\" .\n\n:C056DepartmentOrEmployeeDetails a owl:Class ;\n  rdfs:label \"C056DepartmentOrEmployeeDetails\" ;\n  rdfs:comment \"Composite for department or employee details in NAD segment.\" .\n\n:C509PriceInformation a owl:Class ;\n  rdfs:label \"C509PriceInformation\" ;\n  rdfs:comment \"Composite for price information in PRI segment.\" .\n\n#################################################################\n# Properties (Object/Data)\n#################################################################\n\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"containsMessage\" ;\n  rdfs:comment \"Relates an InterchangeEnvelope to its contained Message(s).\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  owl:inverseOf :isContainedByEnvelope .\n\n:isContainedByEnvelope a owl:ObjectProperty ;\n  rdfs:label \"isContainedByEnvelope\" ;\n  rdfs:comment \"Inverse: Relates a Message to its containing InterchangeEnvelope.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :InterchangeEnvelope ;\n  owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"hasSegment\" ;\n  rdfs:comment \"Relates a Message to its constituent Segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment ;\n  owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isSegmentOf\" ;\n  rdfs:comment \"Inverse: Relates a Segment to its parent Message.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :Message ;\n  owl:inverseOf :hasSegment .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"hasSection\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its main sections (header, detail, summary).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :CompositeDataElement ;\n  owl:inverseOf :isSectionOf .\n\n:isSectionOf a owl:ObjectProperty ;\n  rdfs:label \"isSectionOf\" ;\n  rdfs:comment \"Inverse: Relates a CompositeDataElement to its parent InvoiceMessage.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :InvoiceMessage ;\n  owl:inverseOf :hasSection .\n\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasHeader\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its HeaderSection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection ;\n  owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n  rdfs:label \"isHeaderOf\" ;\n  rdfs:comment \"Inverse: Relates a HeaderSection to its parent InvoiceMessage.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :InvoiceMessage ;\n  owl:inverseOf :hasHeader .\n\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasDetail\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its DetailSection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :DetailSection ;\n  owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n  rdfs:label \"isDetailOf\" ;\n  rdfs:comment \"Inverse: Relates a DetailSection to its parent InvoiceMessage.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :InvoiceMessage ;\n  owl:inverseOf :hasDetail .\n\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasSummary\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its SummarySection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SummarySection ;\n  owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n  rdfs:label \"isSummaryOf\" ;\n  rdfs:comment \"Inverse: Relates a SummarySection to its parent InvoiceMessage.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :InvoiceMessage ;\n  owl:inverseOf :hasSummary .\n\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"hasLineItem\" ;\n  rdfs:comment \"Relates a DetailSection to its LineItems.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n  rdfs:label \"isLineItemOf\" ;\n  rdfs:comment \"Inverse: Relates a LineItem to its parent DetailSection.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :DetailSection ;\n  owl:inverseOf :hasLineItem .\n\n:describesOrganization a owl:ObjectProperty ;\n  rdfs:label \"describesOrganization\" ;\n  rdfs:comment \"Relates a NADSegment to the Organization it describes.\" ;\n  rdfs:domain :NADSegment ;\n  rdfs:range :Organization ;\n  owl:inverseOf :isDescribedByNAD .\n\n:isDescribedByNAD a owl:ObjectProperty ;\n  rdfs:label \"isDescribedByNAD\" ;\n  rdfs:comment \"Inverse: Relates an Organization to its describing NADSegment.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :NADSegment ;\n  owl:inverseOf :describesOrganization .\n\n:hasAgentRole a owl:ObjectProperty ;\n  rdfs:label \"hasAgentRole\" ;\n  rdfs:comment \"Links an Organization to the AgentRole(s) it plays.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :AgentRole ;\n  owl:inverseOf :isAgentRoleOf .\n\n:isAgentRoleOf a owl:ObjectProperty ;\n  rdfs:label \"isAgentRoleOf\" ;\n  rdfs:comment \"Inverse: Links an AgentRole to its Organization.\" ;\n  rdfs:domain :AgentRole ;\n  rdfs:range :Organization ;\n  owl:inverseOf :hasAgentRole .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"hasAddress\" ;\n  rdfs:comment \"Links an Organization to its Address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address ;\n  owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n  rdfs:label \"isAddressOf\" ;\n  rdfs:comment \"Inverse: Links an Address to its Organization.\" ;\n  rdfs:domain :Address ;\n  rdfs:range :Organization ;\n  owl:inverseOf :hasAddress .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"hasIdentifier\" ;\n  rdfs:comment \"Links an Organization to its Identifier(s) such as GLN.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier ;\n  owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n  rdfs:label \"isIdentifierOf\" ;\n  rdfs:comment \"Inverse: Links an Identifier to its Organization.\" ;\n  rdfs:domain :Identifier ;\n  rdfs:range :Organization ;\n  owl:inverseOf :hasIdentifier .\n\n:playsRole a owl:ObjectProperty ;\n  rdfs:label \"playsRole\" ;\n  rdfs:comment \"Links a RoleAssignment to an AgentRole played by an Organization in an Invoice.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole ;\n  owl:inverseOf :isRolePlayedByAssignment .\n\n:isRolePlayedByAssignment a owl:ObjectProperty ;\n  rdfs:label \"isRolePlayedByAssignment\" ;\n  rdfs:comment \"Inverse: Links an AgentRole to its RoleAssignment.\" ;\n  rdfs:domain :AgentRole ;\n  rdfs:range :RoleAssignment ;\n  owl:inverseOf :playsRole .\n\n:assignedTo a owl:ObjectProperty ;\n  rdfs:label \"assignedTo\" ;\n  rdfs:comment \"Links a RoleAssignment to the Organization that plays the role.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization ;\n  owl:inverseOf :isAssignmentOf .\n\n:isAssignmentOf a owl:ObjectProperty ;\n  rdfs:label \"isAssignmentOf\" ;\n  rdfs:comment \"Inverse: Links an Organization to its RoleAssignment.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :RoleAssignment ;\n  owl:inverseOf :assignedTo .\n\n:inInvoice a owl:ObjectProperty ;\n  rdfs:label \"inInvoice\" ;\n  rdfs:comment \"Links a RoleAssignment to the InvoiceMessage context.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :InvoiceMessage ;\n  owl:inverseOf :hasRoleAssignment .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"hasRoleAssignment\" ;\n  rdfs:comment \"Inverse: Links an InvoiceMessage to its RoleAssignment(s).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :RoleAssignment ;\n  owl:inverseOf :inInvoice .\n\n:hasItem a owl:ObjectProperty ;\n  rdfs:label \"hasItem\" ;\n  rdfs:comment \"Links a LineItem to the Item it describes.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item ;\n  owl:inverseOf :isItemOf .\n\n:isItemOf a owl:ObjectProperty ;\n  rdfs:label \"isItemOf\" ;\n  rdfs:comment \"Inverse: Links an Item to its LineItem.\" ;\n  rdfs:domain :Item ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :hasItem .\n\n:hasNetPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasNetPrice\" ;\n  rdfs:comment \"Links a LineItem to the Price (net) for that item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n  rdfs:label \"isNetPriceOf\" ;\n  rdfs:comment \"Inverse: Links a Price to its LineItem.\" ;\n  rdfs:domain :Price ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :hasNetPrice .\n\n:hasQuantity a owl:DatatypeProperty ;\n  rdfs:label \"hasQuantity\" ;\n  rdfs:comment \"Links a LineItem to its quantity.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"hasTax\" ;\n  rdfs:comment \"Links a SummarySection to its associated Tax details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax ;\n  owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n  rdfs:label \"isTaxOf\" ;\n  rdfs:comment \"Inverse: Links a Tax to its SummarySection.\" ;\n  rdfs:domain :Tax ;\n  rdfs:range :SummarySection ;\n  owl:inverseOf :hasTax .\n\n:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasInvoiceAmount\" ;\n  rdfs:comment \"Links a SummarySection to the total invoice Price.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Price ;\n  owl:inverseOf :isInvoiceAmountOf .\n\n:isInvoiceAmountOf a owl:ObjectProperty ;\n  rdfs:label \"isInvoiceAmountOf\" ;\n  rdfs:comment \"Inverse: Links a Price to its SummarySection.\" ;\n  rdfs:domain :Price ;\n  rdfs:range :SummarySection ;\n  owl:inverseOf :hasInvoiceAmount .\n\n:hasDTMSegment a owl:ObjectProperty ;\n  rdfs:label \"hasDTMSegment\" ;\n  rdfs:comment \"Links a HeaderSection to its DTMSegment(s) for document and delivery dates.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :DTMSegment ;\n  owl:inverseOf :isDTMSegmentOf .\n\n:isDTMSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isDTMSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a DTMSegment to its HeaderSection.\" ;\n  rdfs:domain :DTMSegment ;\n  rdfs:range :HeaderSection ;\n  owl:inverseOf :hasDTMSegment .\n\n:hasRFFSegment a owl:ObjectProperty ;\n  rdfs:label \"hasRFFSegment\" ;\n  rdfs:comment \"Links a HeaderSection to its RFFSegment(s) for references.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :RFFSegment ;\n  owl:inverseOf :isRFFSegmentOf .\n\n:isRFFSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isRFFSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a RFFSegment to its HeaderSection.\" ;\n  rdfs:domain :RFFSegment ;\n  rdfs:range :HeaderSection ;\n  owl:inverseOf :hasRFFSegment .\n\n:hasMOASegment a owl:ObjectProperty ;\n  rdfs:label \"hasMOASegment\" ;\n  rdfs:comment \"Links a SummarySection to its MOASegment(s) for monetary amounts.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :MOASegment ;\n  owl:inverseOf :isMOASegmentOf .\n\n:isMOASegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isMOASegmentOf\" ;\n  rdfs:comment \"Inverse: Links a MOASegment to its SummarySection.\" ;\n  rdfs:domain :MOASegment ;\n  rdfs:range :SummarySection ;\n  owl:inverseOf :hasMOASegment .\n\n:hasQTYSegment a owl:ObjectProperty ;\n  rdfs:label \"hasQTYSegment\" ;\n  rdfs:comment \"Links a LineItem to its QTYSegment(s) for quantities.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :QTYSegment ;\n  owl:inverseOf :isQTYSegmentOf .\n\n:isQTYSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isQTYSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a QTYSegment to its LineItem.\" ;\n  rdfs:domain :QTYSegment ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :hasQTYSegment .\n\n:hasLINSegment a owl:ObjectProperty ;\n  rdfs:label \"hasLINSegment\" ;\n  rdfs:comment \"Links a DetailSection to its LINSegment(s) for line item identification.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LINSegment ;\n  owl:inverseOf :isLINSegmentOf .\n\n:isLINSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isLINSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a LINSegment to its DetailSection.\" ;\n  rdfs:domain :LINSegment ;\n  rdfs:range :DetailSection ;\n  owl:inverseOf :hasLINSegment .\n\n:hasIMDSegment a owl:ObjectProperty ;\n  rdfs:label \"hasIMDSegment\" ;\n  rdfs:comment \"Links a LineItem to its IMDSegment(s) for item descriptions.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :IMDSegment ;\n  owl:inverseOf :isIMDSegmentOf .\n\n:isIMDSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isIMDSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a IMDSegment to its LineItem.\" ;\n  rdfs:domain :IMDSegment ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :hasIMDSegment .\n\n:hasPRISegment a owl:ObjectProperty ;\n  rdfs:label \"hasPRISegment\" ;\n  rdfs:comment \"Links a LineItem to its PRISegment(s) for price information.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PRISegment ;\n  owl:inverseOf :isPRISegmentOf .\n\n:isPRISegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isPRISegmentOf\" ;\n  rdfs:comment \"Inverse: Links a PRISegment to its LineItem.\" ;\n  rdfs:domain :PRISegment ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :hasPRISegment .\n\n:hasTAXSegment a owl:ObjectProperty ;\n  rdfs:label \"hasTAXSegment\" ;\n  rdfs:comment \"Links a SummarySection to its TAXSegment(s) for tax details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :TAXSegment ;\n  owl:inverseOf :isTAXSegmentOf .\n\n:isTAXSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isTAXSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a TAXSegment to its SummarySection.\" ;\n  rdfs:domain :TAXSegment ;\n  rdfs:range :SummarySection ;\n  owl:inverseOf :hasTAXSegment .\n\n:hasALCSegment a owl:ObjectProperty ;\n  rdfs:label \"hasALCSegment\" ;\n  rdfs:comment \"Links a SummarySection to its ALCSegment(s) for allowances/charges.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :ALCSegment ;\n  owl:inverseOf :isALCSegmentOf .\n\n:isALCSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isALCSegmentOf\" ;\n  rdfs:comment \"Inverse: Links an ALCSegment to its SummarySection.\" ;\n  rdfs:domain :ALCSegment ;\n  rdfs:range :SummarySection ;\n  owl:inverseOf :hasALCSegment .\n\n:hasPACSegment a owl:ObjectProperty ;\n  rdfs:label \"hasPACSegment\" ;\n  rdfs:comment \"Links a DetailSection to its PACSegment(s) for packaging details.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :PACSegment ;\n  owl:inverseOf :isPACSegmentOf .\n\n:isPACSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isPACSegmentOf\" ;\n  rdfs:comment \"Inverse: Links a PACSegment to its DetailSection.\" ;\n  rdfs:domain :PACSegment ;\n  rdfs:range :DetailSection ;\n  owl:inverseOf :hasPACSegment .\n\n:hasMEASegment a owl:ObjectProperty ;\n  rdfs:label \"hasMEASegment\" ;\n  rdfs:comment \"Links a LineItem to its MEASegment(s) for measurements.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :MEASegment ;\n  owl:inverseOf :isMEASegmentOf .\n\n:isMEASegmentOf a owl:ObjectProperty ;\n  rdfs:label \"isMEASegmentOf\" ;\n  rdfs:comment \"Inverse: Links a MEASegment to its LineItem.\" ;\n  rdfs:domain :MEASegment ;\n  rdfs:range :LineItem ;\n  owl:inverseOf :hasMEASegment .\n\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasInvoiceNumber\" ;\n  rdfs:comment \"The invoice's unique number.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n  rdfs:label \"hasDocumentDate\" ;\n  rdfs:comment \"The date of the invoice document (use xsd:string for compliance).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n  rdfs:label \"hasReferenceNumber\" ;\n  rdfs:comment \"A reference number associated with the invoice (e.g., order or delivery note).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasGLN a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:label \"hasGLN\" ;\n  rdfs:comment \"A Global Location Number (GLN) identifier for an organization.\" ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string .\n\n:assignedBusinessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"assignedBusinessProcess\" ;\n  rdfs:comment \"The business process to which the invoice is assigned.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n  rdfs:label \"isBusinessProcessOf\" ;\n  rdfs:comment \"Inverse: Links a BusinessProcess to its InvoiceMessage.\" ;\n  rdfs:domain :BusinessProcess ;\n  rdfs:range :InvoiceMessage ;\n  owl:inverseOf :assignedBusinessProcess .\n\n:hasC002 a owl:ObjectProperty ;\n  rdfs:label \"hasC002DocumentMessageName\" ;\n  rdfs:comment \"Links a BGMSegment to its C002 composite for document/message name.\" ;\n  rdfs:domain :BGMSegment ;\n  rdfs:range :C002DocumentMessageName ;\n  owl:inverseOf :isC002OfBGM .\n\n:isC002OfBGM a owl:ObjectProperty ;\n  rdfs:label \"isC002OfBGM\" ;\n  rdfs:comment \"Inverse: Links a C002 composite to its BGMSegment.\" ;\n  rdfs:domain :C002DocumentMessageName ;\n  rdfs:range :BGMSegment ;\n  owl:inverseOf :hasC002 .\n\n:hasC056 a owl:ObjectProperty ;\n  rdfs:label \"hasC056DepartmentOrEmployeeDetails\" ;\n  rdfs:comment \"Links a NADSegment to its C056 composite for department/employee details.\" ;\n  rdfs:domain :NADSegment ;\n  rdfs:range :C056DepartmentOrEmployeeDetails ;\n  owl:inverseOf :isC056OfNAD .\n\n:isC056OfNAD a owl:ObjectProperty ;\n  rdfs:label \"isC056OfNAD\" ;\n  rdfs:comment \"Inverse: Links a C056 composite to its NADSegment.\" ;\n  rdfs:domain :C056DepartmentOrEmployeeDetails ;\n  rdfs:range :NADSegment ;\n  owl:inverseOf :hasC056 .\n\n:hasC509 a owl:ObjectProperty ;\n  rdfs:label \"hasC509PriceInformation\" ;\n  rdfs:comment \"Links a PRISegment to its C509 composite for price information.\" ;\n  rdfs:domain :PRISegment ;\n  rdfs:range :C509PriceInformation ;\n  owl:inverseOf :isC509OfPRI .\n\n:isC509OfPRI a owl:ObjectProperty ;\n  rdfs:label \"isC509OfPRI\" ;\n  rdfs:comment \"Inverse: Links a C509 composite to its PRISegment.\" ;\n  rdfs:domain :C509PriceInformation ;\n  rdfs:range :PRISegment ;\n  owl:inverseOf :hasC509 .\n\n#################################################################\n# Axioms, Disjointness, and Restrictions\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :Item, :Address .\n:Segment owl:disjointWith :CompositeDataElement .\n\n#################################################################\n# General Class Axioms and Restrictions\n#################################################################\n\n:RoleAssignment owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ]\n    [ a owl:Restriction ; owl:onProperty :assignedTo ; owl:someValuesFrom :Organization ]\n    [ a owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :InvoiceMessage ]\n  )\n] .\n\n:InvoiceMessage owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :HeaderSection ]\n    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :DetailSection ]\n    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :SummarySection ]\n  )\n] .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
