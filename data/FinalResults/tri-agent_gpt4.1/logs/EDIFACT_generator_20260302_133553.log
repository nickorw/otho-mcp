2026-03-02 13:43:28 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\n  rdfs:label \"EDIFACT INVOIC D96A/EANCOM Ontology\" ;\n  rdfs:comment \"A deep, profoundly structured ontology for the UN/EDIFACT INVOIC message, covering all D96A/EANCOM mandatory segments, roles, and composites, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The root envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"EDIFACT Message\" ;\n  rdfs:comment \"A generic EDIFACT message contained within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An INVOIC message representing a global trade invoice. Subclass of Message.\" ;\n  rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n  rdfs:label \"EDIFACT Segment\" ;\n  rdfs:comment \"A generic EDIFACT segment.\" .\n\n:BGM_Segment a owl:Class ;\n  rdfs:label \"BGM Segment\" ;\n  rdfs:comment \"Beginning of Message segment for document identification.\" ;\n  rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n  rdfs:label \"NAD Segment\" ;\n  rdfs:comment \"Name and Address segment for participant details.\" ;\n  rdfs:subClassOf :Segment .\n\n:DTM_Segment a owl:Class ;\n  rdfs:label \"DTM Segment\" ;\n  rdfs:comment \"Date/Time/Period segment for document, delivery, and tax dates.\" ;\n  rdfs:subClassOf :Segment .\n\n:RFF_Segment a owl:Class ;\n  rdfs:label \"RFF Segment\" ;\n  rdfs:comment \"Reference segment for document, order, and line item references.\" ;\n  rdfs:subClassOf :Segment .\n\n:MOA_Segment a owl:Class ;\n  rdfs:label \"MOA Segment\" ;\n  rdfs:comment \"Monetary Amount segment for totals, taxes, and line item amounts.\" ;\n  rdfs:subClassOf :Segment .\n\n:QTY_Segment a owl:Class ;\n  rdfs:label \"QTY Segment\" ;\n  rdfs:comment \"Quantity segment for invoiced, delivered, and despatched quantities.\" ;\n  rdfs:subClassOf :Segment .\n\n:LIN_Segment a owl:Class ;\n  rdfs:label \"LIN Segment\" ;\n  rdfs:comment \"Line Item segment for item identification and line numbering.\" ;\n  rdfs:subClassOf :Segment .\n\n:IMD_Segment a owl:Class ;\n  rdfs:label \"IMD Segment\" ;\n  rdfs:comment \"Item Description segment for line item textual descriptions.\" ;\n  rdfs:subClassOf :Segment .\n\n:PRI_Segment a owl:Class ;\n  rdfs:label \"PRI Segment\" ;\n  rdfs:comment \"Price segment for line item net prices.\" ;\n  rdfs:subClassOf :Segment .\n\n:TAX_Segment a owl:Class ;\n  rdfs:label \"TAX Segment\" ;\n  rdfs:comment \"Tax segment for tax category, type, and rate details.\" ;\n  rdfs:subClassOf :Segment .\n\n:ALC_Segment a owl:Class ;\n  rdfs:label \"ALC Segment\" ;\n  rdfs:comment \"Allowance/Charge segment for discounts and surcharges.\" ;\n  rdfs:subClassOf :Segment .\n\n:PAC_Segment a owl:Class ;\n  rdfs:label \"PAC Segment\" ;\n  rdfs:comment \"Package segment for packaging details at line or message level.\" ;\n  rdfs:subClassOf :Segment .\n\n:MEA_Segment a owl:Class ;\n  rdfs:label \"MEA Segment\" ;\n  rdfs:comment \"Measurement segment for physical measurements and weights.\" ;\n  rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element grouping multiple simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element holding atomic values.\" .\n\n:HeaderSection a owl:Class ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Header section of an invoice, containing document metadata.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:DetailSection a owl:Class ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Detail section listing invoice line items.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:SummarySection a owl:Class ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Summary section providing invoice totals, taxes, and allowances.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"A legal entity involved in the invoice (buyer, supplier, etc.).\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in a business process (e.g., Buyer, Supplier).\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service described in a line item.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A monetary value assigned to an item or total.\" .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"A tax amount or tax type applied to the invoice or line item.\" .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"A unique identifier such as a GLN (Global Location Number).\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:RoleAssignment a owl:Class ;\n  rdfs:label \"Role Assignment\" ;\n  rdfs:comment \"A reification (pivot) class linking an organization, its role, and the invoice context.\" .\n\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A single line item within the detail section of the invoice.\" .\n\n:C002_DocumentMessageName a owl:Class ;\n  rdfs:label \"C002 Document/Message Name\" ;\n  rdfs:comment \"Composite for document/message name in BGM segment.\" .\n\n:C056_DepartmentOrEmployeeDetails a owl:Class ;\n  rdfs:label \"C056 Department/Employee Details\" ;\n  rdfs:comment \"Composite for department or employee details in NAD segment.\" .\n\n:C509_PriceInformation a owl:Class ;\n  rdfs:label \"C509 Price Information\" ;\n  rdfs:comment \"Composite for price information in PRI segment.\" .\n\n#################################################################\n# Properties (Object/Data)\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Relates an InterchangeEnvelope to its contained Message(s).\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Relates a Message to its constituent Segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its main sections (header, detail, summary).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :CompositeDataElement .\n\n:hasHeader a owl:ObjectProperty ;\n  rdfs:label \"has header\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its HeaderSection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection ;\n  owl:FunctionalProperty .\n\n:hasDetail a owl:ObjectProperty ;\n  rdfs:label \"has detail\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its DetailSection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :DetailSection ;\n  owl:FunctionalProperty .\n\n:hasSummary a owl:ObjectProperty ;\n  rdfs:label \"has summary\" ;\n  rdfs:comment \"Relates an InvoiceMessage to its SummarySection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SummarySection ;\n  owl:FunctionalProperty .\n\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Relates a DetailSection to its LineItems.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n\n:describesOrganization a owl:ObjectProperty ;\n  rdfs:label \"describes organization\" ;\n  rdfs:comment \"Relates a NAD_Segment to the Organization it describes.\" ;\n  rdfs:domain :NAD_Segment ;\n  rdfs:range :Organization .\n\n:hasAgentRole a owl:ObjectProperty ;\n  rdfs:label \"has agent role\" ;\n  rdfs:comment \"Links an Organization to the AgentRole(s) it plays.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :AgentRole .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an Organization to its Address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an Organization to its Identifier(s) such as GLN.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier .\n\n:playsRole a owl:ObjectProperty ;\n  rdfs:label \"plays role\" ;\n  rdfs:comment \"Links a RoleAssignment to an AgentRole played by an Organization in an Invoice.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole .\n\n:assignedTo a owl:ObjectProperty ;\n  rdfs:label \"assigned to\" ;\n  rdfs:comment \"Links a RoleAssignment to the Organization that plays the role.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization .\n\n:inInvoice a owl:ObjectProperty ;\n  rdfs:label \"in invoice\" ;\n  rdfs:comment \"Links a RoleAssignment to the InvoiceMessage context.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :InvoiceMessage .\n\n:hasItem a owl:ObjectProperty ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Links a LineItem to the Item it describes.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n\n:hasNetPrice a owl:ObjectProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Links a LineItem to the Price (net) for that item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  owl:FunctionalProperty .\n\n:hasQuantity a owl:DatatypeProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Links a LineItem to its quantity.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Links a SummarySection to its associated Tax details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax .\n\n:hasInvoiceAmount a owl:ObjectProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Links a SummarySection to the total invoice Price.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Price ;\n  owl:FunctionalProperty .\n\n:hasDTMSegment a owl:ObjectProperty ;\n  rdfs:label \"has DTM segment\" ;\n  rdfs:comment \"Links a HeaderSection to its DTM_Segment(s) for document and delivery dates.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :DTM_Segment .\n\n:hasRFFSegment a owl:ObjectProperty ;\n  rdfs:label \"has RFF segment\" ;\n  rdfs:comment \"Links a HeaderSection to its RFF_Segment(s) for references.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :RFF_Segment .\n\n:hasMOASegment a owl:ObjectProperty ;\n  rdfs:label \"has MOA segment\" ;\n  rdfs:comment \"Links a SummarySection to its MOA_Segment(s) for monetary amounts.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :MOA_Segment .\n\n:hasQTYSegment a owl:ObjectProperty ;\n  rdfs:label \"has QTY segment\" ;\n  rdfs:comment \"Links a LineItem to its QTY_Segment(s) for quantities.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :QTY_Segment .\n\n:hasLINSement a owl:ObjectProperty ;\n  rdfs:label \"has LIN segment\" ;\n  rdfs:comment \"Links a DetailSection to its LIN_Segment(s) for line item identification.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LIN_Segment .\n\n:hasIMDSegment a owl:ObjectProperty ;\n  rdfs:label \"has IMD segment\" ;\n  rdfs:comment \"Links a LineItem to its IMD_Segment(s) for item descriptions.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :IMD_Segment .\n\n:hasPRISegment a owl:ObjectProperty ;\n  rdfs:label \"has PRI segment\" ;\n  rdfs:comment \"Links a LineItem to its PRI_Segment(s) for price information.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PRI_Segment .\n\n:hasTAXSegment a owl:ObjectProperty ;\n  rdfs:label \"has TAX segment\" ;\n  rdfs:comment \"Links a SummarySection to its TAX_Segment(s) for tax details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :TAX_Segment .\n\n:hasALCSegment a owl:ObjectProperty ;\n  rdfs:label \"has ALC segment\" ;\n  rdfs:comment \"Links a SummarySection to its ALC_Segment(s) for allowances/charges.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :ALC_Segment .\n\n:hasPACSegment a owl:ObjectProperty ;\n  rdfs:label \"has PAC segment\" ;\n  rdfs:comment \"Links a DetailSection to its PAC_Segment(s) for packaging details.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :PAC_Segment .\n\n:hasMEASegment a owl:ObjectProperty ;\n  rdfs:label \"has MEA segment\" ;\n  rdfs:comment \"Links a LineItem to its MEA_Segment(s) for measurements.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :MEA_Segment .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"The invoice's unique number.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n  rdfs:label \"has document date\" ;\n  rdfs:comment \"The date of the invoice document (use xsd:string for compliance).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"A reference number associated with the invoice (e.g., order or delivery note).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasGLN a owl:DatatypeProperty ;\n  rdfs:label \"has GLN\" ;\n  rdfs:comment \"A Global Location Number (GLN) identifier for an organization.\" ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:assignedBusinessProcess a owl:ObjectProperty ;\n  rdfs:label \"assigned business process\" ;\n  rdfs:comment \"The business process to which the invoice is assigned.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  owl:FunctionalProperty .\n\n:hasC002 a owl:ObjectProperty ;\n  rdfs:label \"has C002 Document/Message Name\" ;\n  rdfs:comment \"Links a BGM_Segment to its C002 composite for document/message name.\" ;\n  rdfs:domain :BGM_Segment ;\n  rdfs:range :C002_DocumentMessageName .\n\n:hasC056 a owl:ObjectProperty ;\n  rdfs:label \"has C056 Department/Employee Details\" ;\n  rdfs:comment \"Links a NAD_Segment to its C056 composite for department/employee details.\" ;\n  rdfs:domain :NAD_Segment ;\n  rdfs:range :C056_DepartmentOrEmployeeDetails .\n\n:hasC509 a owl:ObjectProperty ;\n  rdfs:label \"has C509 Price Information\" ;\n  rdfs:comment \"Links a PRI_Segment to its C509 composite for price information.\" ;\n  rdfs:domain :PRI_Segment ;\n  rdfs:range :C509_PriceInformation .\n\n#################################################################\n# Axioms, Disjointness, and Restrictions\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :Item, :Address .\n:Segment owl:disjointWith :CompositeDataElement .\n\n# DisjointUnion axiom (informal, for clarity)\n# owl:disjointUnionOf (:Segment :CompositeDataElement :SimpleDataElement)\n\n#################################################################\n# General Class Axioms and Restrictions\n#################################################################\n\n:RoleAssignment owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ]\n    [ a owl:Restriction ; owl:onProperty :assignedTo ; owl:someValuesFrom :Organization ]\n    [ a owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :InvoiceMessage ]\n  )\n] .\n\n:InvoiceMessage owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :HeaderSection ]\n    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :DetailSection ]\n    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :SummarySection ]\n  )\n] .\n\n#################################################################\n# Property Characteristics\n#################################################################\n\n:containsMessage a owl:FunctionalProperty .\n:hasHeader a owl:FunctionalProperty .\n:hasDetail a owl:FunctionalProperty .\n:hasSummary a owl:FunctionalProperty .\n:hasNetPrice a owl:FunctionalProperty .\n:hasInvoiceAmount a owl:FunctionalProperty .\n:hasInvoiceNumber a owl:FunctionalProperty .\n:hasGLN a owl:FunctionalProperty .\n:assignedBusinessProcess a owl:FunctionalProperty .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
