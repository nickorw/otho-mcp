2026-03-02 14:01:44 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#edifact-invoice-ontology> a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for modeling EDIFACT D96A Invoice Messages with EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope containing EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT invoice message (INVOIC).\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"Beginning of Message Segment (BGM)\" ;\n    rdfs:comment \"Segment for document identification (BGM).\" ;\n    rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n    rdfs:label \"Name and Address Segment (NAD)\" ;\n    rdfs:comment \"Segment for organization and address details (NAD).\" ;\n    rdfs:subClassOf :Segment .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section of the invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section listing line items.\" ;\n    rdfs:subClassOf :Segment .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section with totals and taxes.\" ;\n    rdfs:subClassOf :Segment .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A single line item in the invoice.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the business process.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization (e.g., Buyer, Supplier, DeliveryParty).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A unique global location identifier (GLN).\" ;\n    rdfs:subClassOf :Identifier .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item or product listed in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value, e.g., net price for a line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax amount or type in the invoice.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Document or invoice reference number.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:EN16931Compliance a owl:Class ;\n    rdfs:label \"EN 16931 Compliance\" ;\n    rdfs:comment \"Represents compliance with EN 16931-1 standard.\" .\n\n:P2POAlignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment with the Purchase-to-Pay Ontology (P2P-O).\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"A SHACL constraint for validation.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element in a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element in a composite.\" .\n\n:Delimiter a owl:Class ;\n    rdfs:label \"Delimiter\" ;\n    rdfs:comment \"A delimiter used in EDIFACT (e.g., plus sign, colon).\" .\n\n:Pivot_OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment (Pivot)\" ;\n    rdfs:comment \"Reification class linking organizations, roles, and context.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to its contained Message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n:containsMessage a owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n:hasSegment a owl:FunctionalProperty .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its sections (header, detail, summary).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Segment .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates a DetailSection to its LineItems.\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem .\n:hasLineItem a owl:FunctionalProperty .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Relates an InvoiceMessage to organizations involved.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an InvoiceMessage to a role assignment (pivot class).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Pivot_OrganizationRoleAssignment .\n\n:hasAgentRole a owl:ObjectProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a role assignment to an AgentRole (e.g., Buyer, Supplier).\" ;\n    rdfs:domain :Pivot_OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n:hasAgentRole a owl:FunctionalProperty .\n\n:hasParticipant a owl:ObjectProperty ;\n    rdfs:label \"has participant\" ;\n    rdfs:comment \"Links a role assignment to an Organization.\" ;\n    rdfs:domain :Pivot_OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n:hasParticipant a owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Relates an Organization to an Identifier.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n\n:hasGlobalLocationNumber a owl:ObjectProperty ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"Relates an Organization to a GlobalLocationNumber.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber .\n:hasGlobalLocationNumber a owl:FunctionalProperty .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates a LineItem to its Item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item .\n:hasItem a owl:FunctionalProperty .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates a LineItem to its net Price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n:hasNetPrice a owl:FunctionalProperty .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Relates a SummarySection to its Tax.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax .\n\n:hasInvoiceAmount a owl:ObjectProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Relates a SummarySection to its InvoiceAmount.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceAmount .\n:hasInvoiceAmount a owl:FunctionalProperty .\n\n:hasReferenceNumber a owl:ObjectProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Relates a HeaderSection to its ReferenceNumber.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :ReferenceNumber .\n:hasReferenceNumber a owl:FunctionalProperty .\n\n:isAssignedToProcess a owl:ObjectProperty ;\n    rdfs:label \"is assigned to process\" ;\n    rdfs:comment \"Assigns an InvoiceMessage to a BusinessProcess.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n:compliesWithEN16931 a owl:ObjectProperty ;\n    rdfs:label \"complies with EN 16931\" ;\n    rdfs:comment \"Indicates EN 16931-1 compliance for an InvoiceMessage.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931Compliance .\n:compliesWithEN16931 a owl:FunctionalProperty .\n\n:alignedWithP2PO a owl:ObjectProperty ;\n    rdfs:label \"aligned with P2P-O\" ;\n    rdfs:comment \"Indicates P2P-O alignment for an InvoiceMessage.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2POAlignment .\n:alignedWithP2PO a owl:FunctionalProperty .\n\n:validatedBySHACL a owl:ObjectProperty ;\n    rdfs:label \"validated by SHACL\" ;\n    rdfs:comment \"Indicates SHACL validation for an InvoiceMessage.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SHACLConstraint .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its CompositeDataElements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a CompositeDataElement to its SimpleDataElements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:usesDelimiter a owl:ObjectProperty ;\n    rdfs:label \"uses delimiter\" ;\n    rdfs:comment \"Relates a Segment to a Delimiter used in EDIFACT syntax.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Delimiter .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity for a LineItem.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The date of the invoice document (string for OWL 2 DL compliance).\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number as a string.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n:hasInvoiceNumber a owl:FunctionalProperty .\n\n#################################################################\n# Disjoint and Equivalence Axioms\n#################################################################\n\n:Organization owl:disjointWith :Item .\n:Address owl:disjointWith :Item .\n:Price owl:disjointWith :Tax .\n:Message owl:disjointWith :Segment .\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n\n# The following line is commented out because Turtle does not support owl:disjointUnionOf directly\n# owl:disjointUnionOf ( :BGM_Segment :NAD_Segment :HeaderSection :DetailSection :SummarySection ) :Segment .\n\n#################################################################\n# Restrictions and Complex Axioms\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      [ owl:onProperty :hasSection ; owl:someValuesFrom :HeaderSection ]\n      [ owl:onProperty :hasSection ; owl:someValuesFrom :DetailSection ]\n      [ owl:onProperty :hasSection ; owl:someValuesFrom :SummarySection ]\n    )\n] .\n\n:Pivot_OrganizationRoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      [ owl:onProperty :hasAgentRole ; owl:allValuesFrom :AgentRole ]\n      [ owl:onProperty :hasParticipant ; owl:allValuesFrom :Organization ]\n    )\n] .\n"
}
