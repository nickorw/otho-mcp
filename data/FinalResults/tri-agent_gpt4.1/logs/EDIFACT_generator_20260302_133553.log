      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#StoryID> a owl:Ontology ;\\n  rdfs:label \\\"EDIFACT INVOIC Deep Structured Ontology\\\" ;\\n  rdfs:comment \\\"A profoundly structured ontology for UN/EDIFACT INVOIC messages, including D96A/EANCOM, EN16931, and P2P-O alignment.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"Top-level envelope containing all messages in an EDIFACT interchange.\\\" .\\n\\n:Message a owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A contained message within an interchange envelope.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n  rdfs:subClassOf :Message ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An invoice (INVOIC) message in the interchange.\\\" .\\n\\n:Segment a owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within a message, such as BGM or NAD.\\\" .\\n\\n:BGM a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Beginning of Message Segment\\\" ;\\n  rdfs:comment \\\"The BGM segment identifying the document type and number.\\\" .\\n\\n:NAD a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Name and Address Segment\\\" ;\\n  rdfs:comment \\\"The NAD segment for participant details (e.g., buyer, supplier).\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple, atomic data element.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:subClassOf :InvoiceMessage ;\\n  rdfs:comment \\\"Header section of the invoice, containing dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:subClassOf :InvoiceMessage ;\\n  rdfs:comment \\\"Detail section listing line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:subClassOf :InvoiceMessage ;\\n  rdfs:comment \\\"Summary section with totals and taxes.\\\" .\\n\\n:Organization a owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"Any organization involved in the invoice transaction.\\\" .\\n\\n:AgentRole a owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in the invoice context.\\\" .\\n\\n:BuyerRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Buyer Role\\\" ;\\n  rdfs:comment \\\"The buyer role in the invoice.\\\" .\\n\\n:DeliveryPartyRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Delivery Party Role\\\" ;\\n  rdfs:comment \\\"The delivery party role in the invoice.\\\" .\\n\\n:Address a owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"A postal address associated with an organization.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A GLN identifier for an organization location.\\\" .\\n\\n:Item a owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"A line item in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"The price of an item.\\\" .\\n\\n:Quantity a owl:Class ;\\n  rdfs:label \\\"Quantity\\\" ;\\n  rdfs:comment \\\"The quantity of an item.\\\" .\\n\\n:Tax a owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"Tax information in the summary section.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n  rdfs:label \\\"Invoice Amount\\\" ;\\n  rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:InvoiceNumber a owl:Class ;\\n  rdfs:label \\\"Invoice Number\\\" ;\\n  rdfs:comment \\\"The invoice's unique identifier.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:P2PAlignment a owl:Class ;\\n  rdfs:label \\\"P2P-O Alignment\\\" ;\\n  rdfs:comment \\\"Alignment with the Purchase-to-Pay Ontology.\\\" .\\n\\n:EN16931Alignment a owl:Class ;\\n  rdfs:label \\\"EN 16931 Alignment\\\" ;\\n  rdfs:comment \\\"Alignment with the European Standard EN 16931-1.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"A constraint for automated validation (e.g., SHACL).\\\" .\\n\\n:SHACLConstraint a owl:Class ;\\n  rdfs:subClassOf :ValidationConstraint ;\\n  rdfs:label \\\"SHACL Constraint\\\" ;\\n  rdfs:comment \\\"A SHACL constraint for validation of invoice data.\\\" .\\n\\n:Pivot_OrganizationRoleAssignment a owl:Class ;\\n  rdfs:label \\\"Organization Role Assignment (Pivot)\\\" ;\\n  rdfs:comment \\\"Reifies the assignment of an AgentRole to an Organization in an Invoice context.\\\" .\\n\\n#################################################################\\n# Disjointness & DisjointUnion\\n#################################################################\\n\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\\n:Organization owl:disjointWith :Segment .\\n:AgentRole owl:disjointWith :Organization .\\n:Pivot_OrganizationRoleAssignment owl:disjointWith :Organization .\\n\\n[ owl:disjointUnionOf ( :AgentRole :BuyerRole :DeliveryPartyRole ) ] .\\n\\n##########################################