        "arguments": "{\"key\":\"current_owl\",\"value\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/storyid> a owl:Ontology ;\\n  rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n  rdfs:comment \\\"A deep ontology for UN/EDIFACT D96A INVOIC messages, with EANCOM, EN 16931-1, and P2P-O alignment.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:InterchangeEnvelope a owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n  rdfs:subClassOf :Message ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An EDIFACT INVOIC message for global trade transactions.\\\" .\\n\\n:Segment a owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGMSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"The Beginning of Message segment for document identification.\\\" .\\n\\n:NADSegment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"The Name and Address segment for participant details.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"Composite data element containing simple elements.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"Atomic data element within a composite.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:comment \\\"The header section of an invoice message, containing document dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:comment \\\"The detail section listing line items with prices and quantities.\\\" .\\n\\n:SummarySection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:comment \\\"The summary section providing total tax and invoice amounts.\\\" .\\n\\n:Organization a owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"A business entity involved in the invoice, e.g., buyer, supplier, delivery party.\\\" .\\n\\n:AgentRole a owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in a transaction.\\\" .\\n\\n:BuyerRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Buyer Role\\\" ;\\n  rdfs:comment \\\"The role of buyer in a transaction.\\\" .\\n\\n:DeliveryPartyRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Delivery Party Role\\\" ;\\n  rdfs:comment \\\"The role of delivery party in a transaction.\\\" .\\n\\n:Address a owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"An address associated with an organization or role.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A unique identifier for a location, such as a warehouse or headquarters.\\\" .\\n\\n:Item a owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"A product or good being invoiced.\\\" .\\n\\n:Price a owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"A monetary value assigned to an item.\\\" .\\n\\n:Quantity a owl:Class ;\\n  rdfs:label \\\"Quantity\\