        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/storyid> a owl:Ontology ;\\n  rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n  rdfs:comment \\\"A deep ontology for UN/EDIFACT D96A INVOIC messages, with EANCOM, EN 16931-1, and P2P-O alignment.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:InterchangeEnvelope a owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n  rdfs:subClassOf :Message ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An EDIFACT INVOIC message for global trade transactions.\\\" .\\n\\n:Segment a owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGM_Segment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"The Beginning of Message segment for document identification.\\\" .\\n\\n:NAD_Segment a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"The Name and Address segment for participant details.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"Composite data element containing simple elements.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"Atomic data element within a composite.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Header Section\\\" ;\\n  rdfs:comment \\\"The header section of an invoice message, containing document dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Detail Section\\\" ;\\n  rdfs:comment \\\"The detail section listing line items with prices and quantities.\\\" .\\n\\n:SummarySection a owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"Summary Section\\\" ;\\n  rdfs:comment \\\"The summary section providing total tax and invoice amounts.\\\" .\\n\\n:Organization a owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"A business entity involved in the invoice, e.g., buyer, supplier, delivery party.\\\" .\\n\\n:AgentRole a owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization in a transaction.\\\" .\\n\\n:BuyerRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Buyer Role\\\" ;\\n  rdfs:comment \\\"The role of buyer in a transaction.\\\" .\\n\\n:DeliveryPartyRole a owl:Class ;\\n  rdfs:subClassOf :AgentRole ;\\n  rdfs:label \\\"Delivery Party Role\\\" ;\\n  rdfs:comment \\\"The role of delivery party in a transaction.\\\" .\\n\\n:Address a owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"An address associated with an organization or role.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A unique identifier for a location, such as a warehouse or headquarters.\\\" .\\n\\n:Item a owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"A product or good being invoiced.\\\" .\\n\\n:Price a owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"A monetary value assigned to an item.\\\" .\\n\\n:Quantity a owl:Class ;\\n  rdfs:label \\\"Quantity\\\" ;\\n  rdfs:comment \\\"The amount of an item listed in the invoice.\\\" .\\n\\n:Tax a owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"A tax applied to the invoice or line item.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n  rdfs:label \\\"Reference Number\\\" ;\\n  rdfs:comment \\\"A reference number in the document header.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"A constraint for automated validation, e.g., SHACL rules.\\\" .\\n\\n:InvoiceLine a owl:Class ;\\n  rdfs:label \\\"Invoice Line\\\" ;\\n  rdfs:comment \\\"A line item in the invoice.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n  rdfs:label \\\"Invoice Amount\\\" ;\\n  rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:InvoiceNumber a owl:Class ;\\n  rdfs:label \\\"Invoice Number\\\" ;\\n  rdfs:comment \\\"The unique number of the invoice.\\\" .\\n\\n:Identifier a owl:Class ;\\n  rdfs:label \\\"Identifier\\\" ;\\n  rdfs:comment \\\"A generic identifier (e.g. for organizations, addresses).\\\" .\\n\\n# Pivot Classes\\n:OrganizationRoleAssignment a owl:Class ;\\n  rdfs:label \\\"Organization Role Assignment\\\" ;\\n  rdfs:comment \\\"Reifies the assignment of an AgentRole to an Organization, possibly with context.\\\" .\\n\\n:InvoiceLineItem a owl:Class ;\\n  rdfs:subClassOf :InvoiceLine ;\\n  rdfs:label \\\"Invoice Line Item\\\" ;\\n  rdfs:comment \\\"A reified line item linking item, price, and quantity.\\\" .\\n\\n#################################################################\\n# Class Hierarchy Axioms\\n#################################################################\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Item owl:disjointWith :Organization .\\n:Segment owl:disjointWith :Organization .\\n\\n:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\\n\\n#################################################################\\n# Properties\\n#################################################################\\n:containsMessage a owl:ObjectProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains message\\\" ;\\n  rdfs:comment \\\"Links an envelope to the message(s) it contains.\\\" .\\n:containsMessage a owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has segment\\\" ;\\n  rdfs:comment \\\"Links a message to its segments.\\\" .\\n\\n:hasSection a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range [ owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ;\\n  rdfs:label \\\"has section\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its logical sections.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has composite element\\\" ;\\n  rdfs:comment \\\"Links a segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has simple element\\\" ;\\n  rdfs:comment \\\"Links a composite element to its simple data elements.\\\" .\\n\\n:playsRole a owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"plays role\\\" ;\\n  rdfs:comment \\\"Indicates the role played by an organization.\\\" .\\n\\n:hasAddress a owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has address\\\" ;\\n  rdfs:comment \\\"Links an organization to its address.\\\" .\\n:hasAddress a owl:FunctionalProperty .\\n\\n:hasGlobalLocationNumber a owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :GlobalLocationNumber ;\\n  rdfs:label \\\"has global location number\\\" ;\\n  rdfs:comment \\\"Links an organization to its GLN.\\\" .\\n:hasGlobalLocationNumber a owl:FunctionalProperty .\\n\\n:assignedRole a owl:ObjectProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"assigned role\\\" ;\\n  rdfs:comment \\\"The agent role assigned in this assignment.\\\" .\\n:assignedRole a owl:FunctionalProperty .\\n\\n:assignedToOrganization a owl:ObjectProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"assigned to organization\\\" ;\\n  rdfs:comment \\\"The organization to which the role is assigned.\\\" .\\n:assignedToOrganization a owl:FunctionalProperty .\\n\\n:hasInvoiceLine a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceLineItem ;\\n  rdfs:label \\\"has invoice line\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its line items.\\\" .\\n\\n:refersToItem a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"refers to item\\\" ;\\n  rdfs:comment \\\"Links a line item to the item being sold.\\\" .\\n:refersToItem a owl:FunctionalProperty .\\n\\n:netPrice a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"net price\\\" ;\\n  rdfs:comment \\\"The net price of the item in the line item.\\\" .\\n:netPrice a owl:FunctionalProperty .\\n\\n:quantity a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Quantity ;\\n  rdfs:label \\\"quantity\\\" ;\\n  rdfs:comment \\\"The quantity of the item in the line item.\\\" .\\n:quantity a owl:FunctionalProperty .\\n\\n:tax a owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"tax\\\" ;\\n  rdfs:comment \\\"The tax in the summary section.\\\" .\\n:tax a owl:FunctionalProperty .\\n\\n:invoiceAmount a owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :InvoiceAmount ;\\n  rdfs:label \\\"invoice amount\\\" ;\\n  rdfs:comment \\\"The total invoice amount.\\\" .\\n:invoiceAmount a owl:FunctionalProperty .\\n\\n:invoiceNumber a owl:ObjectProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :InvoiceNumber ;\\n  rdfs:label \\\"invoice number\\\" ;\\n  rdfs:comment \\\"The invoice number in the header section.\\\" .\\n:invoiceNumber a owl:FunctionalProperty .\\n\\n:referenceNumber a owl:ObjectProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :ReferenceNumber ;\\n  rdfs:label \\\"reference number\\\" ;\\n  rdfs:comment \\\"A reference number in the header section.\\\" .\\n:referenceNumber a owl:FunctionalProperty .\\n\\n:identifier a owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"identifier\\\" ;\\n  rdfs:comment \\\"A generic identifier for the organization.\\\" .\\n:identifier a owl:FunctionalProperty .\\n\\n:businessProcess a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"business process\\\" ;\\n  rdfs:comment \\\"The business process to which the invoice is assigned.\\\" .\\n:businessProcess a owl:FunctionalProperty .\\n\\n:mandatoryIdentifier a owl:ObjectProperty ;\\n  rdfs:domain :ValidationConstraint ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"mandatory identifier\\\" ;\\n  rdfs:comment \\\"A mandatory identifier required for validation.\\\" .\\n\\n#################################################################\\n# Restrictions & GCAs\\n#################################################################\\n# Example: Each InvoiceLineItem must refer to exactly one Item, have one Price and one Quantity\\n:InvoiceLineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] ,\\n                                   [ a owl:Restriction ; owl:onProperty :netPrice ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] ,\\n                                   [ a owl:Restriction ; owl:onProperty :quantity ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] .\\n\\n# General Class Axiom: Any Organization with a BuyerRole is a Buyer\\n[ a owl:Class ; owl:equivalentClass [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :BuyerRole ] ; rdfs:subClassOf :Organization ] .\\n\\n# ValidationConstraint: All mandatory identifiers must be present\\n:ValidationConstraint rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :mandatoryIdentifier ; owl:someValuesFrom :Identifier ] .\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
