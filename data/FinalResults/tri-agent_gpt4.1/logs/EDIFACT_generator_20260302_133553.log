      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#EDIFACT_INVOIC_Ontology> a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Ontology\" ;\n    rdfs:comment \"A deep ontology for EDIFACT INVOIC messages, organizations, roles, and business context, aligned to D96A and EN 16931-1.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The envelope that contains one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message representing an invoice transaction.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NAD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element in a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element in a composite element or segment.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of the invoice containing document dates and references.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section listing line items of the invoice.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section providing totals for tax and invoice amount.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice process.\" .\n\n:OrganizationRole a owl:Class ;\n    rdfs:label \"Organization Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice (e.g., Buyer, Delivery Party).\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:subClassOf :OrganizationRole ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role of an organization as the buyer.\" .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:subClassOf :OrganizationRole ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"Role of an organization as the delivery party.\" .\n\n:AgentRoleAssignment a owl:Class ;\n    rdfs:label \"Agent Role Assignment\" ;\n    rdfs:comment \"Reifies the assignment of a role and address to an organization in a specific invoice context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"An address associated with an organization role.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service sold in the invoice.\" .\n\n:ItemLine a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Item Line\" ;\n    rdfs:comment \"A line in the invoice detail referring to a specific item, its price, and quantity.\" .\n\n:Price a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A composite element representing price information.\" .\n\n:Tax a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A composite element representing tax information.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for identifying the invoice or related documents.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:P2PElement a owl:Class ;\n    rdfs:label \"Purchase-to-Pay Element\" ;\n    rdfs:comment \"Element from the Purchase-to-Pay Ontology (P2P-O).\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to the messages it contains.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Associates a message with its constituent segments.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Associates a segment with its composite data elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Associates a composite element with its simple data elements.\" .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an invoice message to its header section.\" .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links an invoice message to its detail section.\" .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummary ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links an invoice message to its summary section.\" .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Indicates organizations involved in the invoice.\" .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :AgentRoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to its role assignments (reification of agent roles).\" .\n\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :AgentRoleAssignment ;\n    rdfs:range :OrganizationRole ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"The role assigned to an organization in a specific context.\" .\n\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :AgentRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"The organization assigned a specific role.\" .\n\n:assignedAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :AgentRoleAssignment ;\n    rdfs:range :Address ;\n    rdfs:label \"assigned address\" ;\n    rdfs:comment \"The address associated with an organization's role in a context.\" .\n\n:hasItemLine a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :ItemLine ;\n    rdfs:label \"has item line\" ;\n    rdfs:comment \"Links the invoice detail to its item lines.\" .\n\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links an item line to the item it describes.\" .\n\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links an item line to its net price.\" .\n\n:hasTotalTax a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax ;\n    rdfs:label \"has total tax\" ;\n    rdfs:comment \"Links invoice summary to total tax.\" .\n\n:assignedToProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Assigns the invoice to a business process.\" .\n\n:hasP2PElement a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2PElement ;\n    rdfs:label \"has P2P element\" ;\n    rdfs:comment \"Links invoice to elements from the Purchase-to-Pay ontology.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasGLN a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"The Global Location Number of the organization.\" .\n\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Reference number of the invoice.\" .\n\n:hasInvoiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice date\" ;\n    rdfs:comment \"The date of the invoice. Use xsd:string for compliance.\" .\n\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Quantity of the item in the item line.\" .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Total invoice amount.\" .\n\n#################################################################\n# Class Disjointness\n#################################################################\n\n:OrganizationRole owl:disjointWith :Segment .\n:Organization owl:disjointWith :Segment .\n:Item owl:disjointWith :Organization .\n:InvoiceHeader owl:disjointWith :InvoiceDetail .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n\n#################################################################\n# General Class Axioms & Restrictions\n#################################################################\n\n:BuyerRole owl:equivalentClass [\n    a owl:Restriction ;\n    owl:onProperty :assignedRole ;\n    owl:allValuesFrom :BuyerRole\n] .\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasHeader ;\n    owl:someValuesFrom :InvoiceHeader\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasDetail ;\n    owl:someValuesFrom :InvoiceDetail\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasSummary ;\n    owl:someValuesFrom :InvoiceSummary\n] .\n\n:AgentRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :assignedRole ;\n    owl:someValuesFrom :OrganizationRole\n] , [\n    a owl:Restriction ;\n    owl:onProperty :assignedOrganization ;\n    owl:someValuesFrom :Organization\n] .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
