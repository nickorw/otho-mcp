nt owl:disjointWith :Organization .\\n\\n:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\\n\\n#################################################################\\n# Properties & Inverses\\n#################################################################\\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains message\\\" ;\\n  rdfs:comment \\\"Links an envelope to the message(s) it contains.\\\" ;\\n  owl:inverseOf :isContainedInEnvelope .\\n:isContainedInEnvelope a owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :InterchangeEnvelope ;\\n  rdfs:label \\\"is contained in envelope\\\" ;\\n  rdfs:comment \\\"Inverse: Message is contained in envelope.\\\" ;\\n  owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has segment\\\" ;\\n  rdfs:comment \\\"Links a message to its segments.\\\" ;\\n  owl:inverseOf :isSegmentOf .\\n:isSegmentOf a owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"is segment of\\\" ;\\n  rdfs:comment \\\"Inverse: Segment is part of message.\\\" ;\\n  owl:inverseOf :hasSegment .\\n\\n:hasSection a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range [ owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ;\\n  rdfs:label \\\"has section\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its logical sections.\\\" ;\\n  owl:inverseOf :isSectionOf .\\n:isSectionOf a owl:ObjectProperty ;\\n  rdfs:domain [ owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is section of\\\" ;\\n  rdfs:comment \\\"Inverse: Section is part of invoice message.\\\" ;\\n  owl:inverseOf :hasSection .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has composite element\\\" ;\\n  rdfs:comment \\\"Links a segment to its composite data elements.\\\" ;\\n  owl:inverseOf :isCompositeElementOf .\\n:isCompositeElementOf a owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"is composite element of\\\" ;\\n  rdfs:comment \\\"Inverse: Composite data element is part of segment.\\\" ;\\n  owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has simple element\\\" ;\\n  rdfs:comment \\\"Links a composite element to its simple data elements.\\\" ;\\n  owl:inverseOf :isSimpleElementOf .\\n:isSimpleElementOf a owl:ObjectProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"is simple element of\\\" ;\\n  rdfs:comment \\\"Inverse: Simple data element is part of composite.\\\" ;\\n  owl:inverseOf :hasSimpleElement .\\n\\n:playsRole a owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"plays role\\\" ;\\n  rdfs:comment \\\"Indicates the role played by an organization.\\\" ;\\n  owl:inverseOf :isRoleOf .\\n:isRoleOf a owl:ObjectProperty ;\\n  rdfs:domain :AgentRole ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is role of\\\" ;\\n  rdfs:comment \\\"Inverse: Role is played by organization.\\\" ;\\n  owl:inverseOf :playsRole .\\n\\n:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has address\\\" ;\\n  rdfs:comment \\\"Links an organization to its address.\\\" ;\\n  owl:inverseOf :isAddressOf .\\n:isAddressOf a owl:ObjectProperty ;\\n  rdfs:domain :Address ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is address of\\\" ;\\n  rdfs:comment \\\"Inverse: Address is for organization.\\\" ;\\n  owl:inverseOf :hasAddress .\\n\\n:hasGlobalLocationNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :GlobalLocationNumber ;\\n  rdfs:label \\\"has global location number\\\" ;\\n  rdfs:comment \\\"Links an organization to its GLN.\\\" ;\\n  owl:inverseOf :isGLNOf .\\n:isGLNOf a owl:ObjectProperty ;\\n  rdfs:domain :GlobalLocationNumber ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is GLN of\\\" ;\\n  rdfs:comment \\\"Inverse: GLN is for organization.\\\" ;\\n  owl:inverseOf :hasGlobalLocationNumber .\\n\\n:assignedRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"assigned role\\\" ;\\n  rdfs:comment \\\"The agent role assigned in this assignment.\\\" ;\\n  owl:inverseOf :isAssignedRoleOf .\\n:isAssignedRoleOf a owl:ObjectProperty ;\\n  rdfs:domain :AgentRole ;\\n  rdfs:range :OrganizationRoleAssignment ;\\n  rdfs:label \\\"is assigned role of\\\" ;\\n  rdfs:comment \\\"Inverse: Role is assigned in assignment.\\\" ;\\n  owl:inverseOf :assignedRole .\\n\\n:assignedToOrganization a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"assigned to organization\\\" ;\\n  rdfs:comment \\\"The organization to which the role is assigned.\\\" ;\\n  owl:inverseOf :hasRoleAssignment .\\n:hasRoleAssignment a owl:ObjectProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :OrganizationRoleAssignment ;\\n  rdfs:label \\\"has role assignment\\\" ;\\n  rdfs:comment \\\"Inverse: Organization has role assignment.\\\" ;\\n  owl:inverseOf :assignedToOrganization .\\n\\n:hasInvoiceLine a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceLine ;\\n  rdfs:label \\\"has invoice line\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its invoice lines.\\\" ;\\n  owl:inverseOf :isInvoiceLineOf .\\n:isInvoiceLineOf a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceLine ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is invoice line of\\\" ;\\n  rdfs:comment \\\"Inverse: Invoice line is part of invoice message.\\\" ;\\n  owl:inverseOf :hasInvoiceLine .\\n\\n:hasInvoiceLineItem a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceLine ;\\n  rdfs:range :InvoiceLineItem ;\\n  rdfs:label \\\"has invoice line item\\\" ;\\n  rdfs:comment \\\"Links an invoice line to its line item.\\\" ;\\n  owl:inverseOf :isInvoiceLineItemOf .\\n:isInvoiceLineItemOf a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :InvoiceLine ;\\n  rdfs:label \\\"is invoice line item of\\\" ;\\n  rdfs:comment \\\"Inverse: Line item is part of invoice line.\\\" ;\\n  owl:inverseOf :hasInvoiceLineItem .\\n\\n:refersToItem a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"refers to item\\\" ;\\n  rdfs:comment \\\"Links a line item to the item being sold.\\\" ;\\n  owl:inverseOf :isItemReferredBy .\\n:isItemReferredBy a owl:ObjectProperty ;\\n  rdfs:domain :Item ;\\n  rdfs:range :InvoiceLineItem ;\\n  rdfs:label \\\"is item referred by\\\" ;\\n  rdfs:comment \\\"Inverse: Item is referenced by line item.\\\" ;\\n  owl:inverseOf :refersToItem .\\n\\n:netPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"net price\\\" ;\\n  rdfs:comment \\\"The net price of the item in the line item.\\\" ;\\n  owl:inverseOf :isNetPriceOf .\\n:isNetPriceOf a owl:ObjectProperty ;\\n  rdfs:domain :Price ;\\n  rdfs:range :InvoiceLineItem ;\\n  rdfs:label \\\"is net price of\\\" ;\\n  rdfs:comment \\\"Inverse: Price is for line item.\\\" ;\\n  owl:inverseOf :netPrice .\\n\\n:quantity a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Quantity ;\\n  rdfs:label \\\"quantity\\\" ;\\n  rdfs:comment \\\"The quantity of the item in the line item.\\\" ;\\n  owl:inverseOf :isQuantityOf .\\n:isQuantityOf a owl:ObjectProperty ;\\n  rdfs:domain :Quantity ;\\n  rdfs:range :InvoiceLineItem ;\\n  rdfs:label \\\"is quantity of\\\" ;\\n  rdfs:comment \\\"Inverse: Quantity is for line item.\\\" ;\\n  owl:inverseOf :quantity .\\n\\n:tax a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"tax\\\" ;\\n  rdfs:comment \\\"The tax in the summary section.\\\" ;\\n  owl:inverseOf :isTaxOf .\\n:isTaxOf a owl:ObjectProperty ;\\n  rdfs:domain :Tax ;\\n  rdfs:range :SummarySection ;\\n  rdfs:label \\\"is tax of\\\" ;\\n  rdfs:comment \\\"Inverse: Tax is for summary section.\\\" ;\\n  owl:inverseOf :tax .\\n\\n:invoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :InvoiceAmount ;\\n  rdfs:label \\\"invoice amount\\\" ;\\n  rdfs:comment \\\"The total invoice amount.\\\" ;\\n  owl:inverseOf :isInvoiceAmountOf .\\n:isInvoiceAmountOf a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceAmount ;\\n  rdfs:range :SummarySection ;\\n  rdfs:label \\\"is invoice amount of\\\" ;\\n  rdfs:comment \\\"Inverse: Invoice amount is for summary section.\\\" ;\\n  owl:inverseOf :invoiceAmount .\\n\\n:invoiceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :InvoiceNumber ;\\n  rdfs:label \\\"invoice number\\\" ;\\n  rdfs:comment \\\"The invoice number in the header section.\\\" ;\\n  owl:inverseOf :isInvoiceNumberOf .\\n:isInvoiceNumberOf a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceNumber ;\\n  rdfs:range :HeaderSection ;\\n  rdfs:label \\\"is invoice number of\\\" ;\\n  rdfs:comment \\\"Inverse: Invoice number is for header section.\\\" ;\\n  owl:inverseOf :invoiceNumber .\\n\\n:referenceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :ReferenceNumber ;\\n  rdfs:label \\\"reference number\\\" ;\\n  rdfs:comment \\\"A reference number in the header section.\\\" ;\\n  owl:inverseOf :isReferenceNumberOf .\\n:isReferenceNumberOf a owl:ObjectProperty ;\\n  rdfs:domain :ReferenceNumber ;\\n  rdfs:range :HeaderSection ;\\n  rdfs:label \\\"is reference number of\\\" ;\\n  rdfs:comment \\\"Inverse: Reference number is for header section.\\\" ;\\n  owl:inverseOf :referenceNumber .\\n\\n:identifier a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"identifier\\\" ;\\n  rdfs:comment \\\"A generic identifier for the organization.\\\" ;\\n  owl:inverseOf :isIdentifierOf .\\n:isIdentifierOf a owl:ObjectProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"is identifier of\\\" ;\\n  rdfs:comment \\\"Inverse: Identifier is for organization.\\\" ;\\n  owl:inverseOf :identifier .\\n\\n:businessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"business process\\\" ;\\n  rdfs:comment \\\"The business process to which the invoice is assigned.\\\" ;\\n  owl:inverseOf :isBusinessProcessOf .\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n  rdfs:domain :BusinessProcess ;\\n  rdfs:range :InvoiceMessage ;\\n  rdfs:label \\\"is business process of\\\" ;\\n  rdfs:comment \\\"Inverse: Business process is for invoice message.\\\" ;\\n  owl:inverseOf :businessProcess .\\n\\n:mandatoryIdentifier a owl:ObjectProperty ;\\n  rdfs:domain :ValidationConstraint ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"mandatory identifier\\\" ;\\n  rdfs:comment \\\"A mandatory identifier required for validation.\\\" ;\\n  owl:inverseOf :isMandatoryIdentifierOf .\\n:isMandatoryIdentifierOf a owl:ObjectProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range :ValidationConstraint ;\\n  rdfs:label \\\"is mandatory identifier of\\\" ;\\n  rdfs:comment \\\"Inverse: Identifier is required by validation constraint.\\\" ;\\n  owl:inverseOf :mandatoryIdentifier .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:date a owl:DatatypeProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"date\\\" ;\\n  rdfs:comment \\\"A date value in the header section (ISO string).\\\" .\\n\\n#################################################################\\n# Restrictions & GCAs\\n#################################################################\\n:InvoiceLineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] ,\\n                                   [ a owl:Restriction ; owl:onProperty :netPrice ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] ,\\n                                   [ a owl:Restriction ; owl:onProperty :quantity ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] .\\n\\n[ a owl:Class ; owl:equivalentClass [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :BuyerRole ] ; rdfs:subClassOf :Organization ] .\\n\\n:ValidationConstraint rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :mandatoryIdentifier ; owl:someValuesFrom :Identifier ] .\\n\"}",
