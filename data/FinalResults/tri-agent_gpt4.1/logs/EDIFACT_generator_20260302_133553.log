      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#StoryID> a owl:Ontology ;\n  rdfs:label \"EDIFACT INVOIC Deep Structured Ontology\" ;\n  rdfs:comment \"A profoundly structured ontology for UN/EDIFACT INVOIC messages, including D96A/EANCOM, EN16931, and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"Top-level envelope containing all messages in an EDIFACT interchange.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A contained message within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:subClassOf :Message ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An invoice (INVOIC) message in the interchange.\" .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:BGM a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Beginning of Message Segment\" ;\n  rdfs:comment \"The BGM segment identifying the document type and number.\" .\n\n:NAD a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Name and Address Segment\" ;\n  rdfs:comment \"The NAD segment for participant details (e.g., buyer, supplier).\" .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:subClassOf :CompositeDataElement ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple, atomic data element.\" .\n\n:HeaderSection a owl:Class ;\n  rdfs:label \"Header Section\" ;\n  rdfs:subClassOf :InvoiceMessage ;\n  rdfs:comment \"Header section of the invoice, containing dates and reference numbers.\" .\n\n:DetailSection a owl:Class ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:subClassOf :InvoiceMessage ;\n  rdfs:comment \"Detail section listing line items.\" .\n\n:SummarySection a owl:Class ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:subClassOf :InvoiceMessage ;\n  rdfs:comment \"Summary section with totals and taxes.\" .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"Any organization involved in the invoice transaction.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in the invoice context.\" .\n\n:BuyerRole a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Buyer Role\" ;\n  rdfs:comment \"The buyer role in the invoice.\" .\n\n:DeliveryPartyRole a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Delivery Party Role\" ;\n  rdfs:comment \"The delivery party role in the invoice.\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal address associated with an organization.\" .\n\n:GlobalLocationNumber a owl:Class ;\n  rdfs:label \"Global Location Number\" ;\n  rdfs:comment \"A GLN identifier for an organization location.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A line item in the invoice.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"The price of an item.\" .\n\n:Quantity a owl:Class ;\n  rdfs:label \"Quantity\" ;\n  rdfs:comment \"The quantity of an item.\" .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"Tax information in the summary section.\" .\n\n:InvoiceAmount a owl:Class ;\n  rdfs:label \"Invoice Amount\" ;\n  rdfs:comment \"The total amount of the invoice.\" .\n\n:InvoiceNumber a owl:Class ;\n  rdfs:label \"Invoice Number\" ;\n  rdfs:comment \"The invoice's unique identifier.\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:P2PAlignment a owl:Class ;\n  rdfs:label \"P2P-O Alignment\" ;\n  rdfs:comment \"Alignment with the Purchase-to-Pay Ontology.\" .\n\n:EN16931Alignment a owl:Class ;\n  rdfs:label \"EN 16931 Alignment\" ;\n  rdfs:comment \"Alignment with the European Standard EN 16931-1.\" .\n\n:ValidationConstraint a owl:Class ;\n  rdfs:label \"Validation Constraint\" ;\n  rdfs:comment \"A constraint for automated validation (e.g., SHACL).\" .\n\n:SHACLConstraint a owl:Class ;\n  rdfs:subClassOf :ValidationConstraint ;\n  rdfs:label \"SHACL Constraint\" ;\n  rdfs:comment \"A SHACL constraint for validation of invoice data.\" .\n\n:Pivot_OrganizationRoleAssignment a owl:Class ;\n  rdfs:label \"Organization Role Assignment (Pivot)\" ;\n  rdfs:comment \"Reifies the assignment of an AgentRole to an Organization in an Invoice context.\" .\n\n#################################################################\n# Disjointness & DisjointUnion\n#################################################################\n\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\n:Organization owl:disjointWith :Segment .\n:AgentRole owl:disjointWith :Organization .\n:Pivot_OrganizationRoleAssignment owl:disjointWith :Organization .\n\n[ owl:disjointUnionOf ( :AgentRole :BuyerRole :DeliveryPartyRole ) ] .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:hasMessage a owl:ObjectProperty ;\n  rdfs:label \"has message\" ;\n  rdfs:comment \"Links an InterchangeEnvelope to its contained Message.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  owl:FunctionalProperty .\n\n:containsSegment a owl:ObjectProperty ;\n  rdfs:label \"contains segment\" ;\n  rdfs:comment \"Links a Message to its Segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Links an InvoiceMessage to its Header, Detail, or Summary sections.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection, :DetailSection, :SummarySection .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Links an Organization to its role assignment pivot.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Pivot_OrganizationRoleAssignment .\n\n:assignedRole a owl:ObjectProperty ;\n  rdfs:label \"assigned role\" ;\n  rdfs:comment \"Links a role assignment pivot to an AgentRole.\" ;\n  rdfs:domain :Pivot_OrganizationRoleAssignment ;\n  rdfs:range :AgentRole ;\n  owl:FunctionalProperty .\n\n:roleInInvoice a owl:ObjectProperty ;\n  rdfs:label \"role in invoice\" ;\n  rdfs:comment \"Links a role assignment pivot to the InvoiceMessage context.\" ;\n  rdfs:domain :Pivot_OrganizationRoleAssignment ;\n  rdfs:range :InvoiceMessage ;\n  owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an Organization to its Address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address ;\n  owl:FunctionalProperty .\n\n:hasGLN a owl:ObjectProperty ;\n  rdfs:label \"has GLN\" ;\n  rdfs:comment \"Links an Organization to its Global Location Number.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :GlobalLocationNumber ;\n  owl:FunctionalProperty .\n\n:hasItem a owl:ObjectProperty ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Links a DetailSection to an Item.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :Item .\n\n:hasPrice a owl:ObjectProperty ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Links an Item to its Price.\" ;\n  rdfs:domain :Item ;\n  rdfs:range :Price ;\n  owl:FunctionalProperty .\n\n:hasQuantity a owl:ObjectProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Links an Item to its Quantity.\" ;\n  rdfs:domain :Item ;\n  rdfs:range :Quantity ;\n  owl:FunctionalProperty .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Links a SummarySection to its Tax.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax .\n\n:hasInvoiceAmount a owl:ObjectProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Links a SummarySection to its InvoiceAmount.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :InvoiceAmount ;\n  owl:FunctionalProperty .\n\n:hasInvoiceNumber a owl:ObjectProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"Links an InvoiceMessage to its InvoiceNumber.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :InvoiceNumber ;\n  owl:FunctionalProperty .\n\n:alignedWithP2P a owl:ObjectProperty ;\n  rdfs:label \"aligned with P2P-O\" ;\n  rdfs:comment \"Alignment of InvoiceMessage with P2P-O.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :P2PAlignment .\n\n:alignedWithEN16931 a owl:ObjectProperty ;\n  rdfs:label \"aligned with EN16931\" ;\n  rdfs:comment \"Alignment of InvoiceMessage with EN16931.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :EN16931Alignment .\n\n:validatedBy a owl:ObjectProperty ;\n  rdfs:label \"validated by\" ;\n  rdfs:comment \"Links an InvoiceMessage to a ValidationConstraint.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :ValidationConstraint .\n\n:assignedToBusinessProcess a owl:ObjectProperty ;\n  rdfs:label \"assigned to business process\" ;\n  rdfs:comment \"Links an InvoiceMessage to a BusinessProcess.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  owl:FunctionalProperty .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:date a owl:DatatypeProperty ;\n  rdfs:label \"date\" ;\n  rdfs:comment \"A date value in the header section.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:referenceNumber a owl:DatatypeProperty ;\n  rdfs:label \"reference number\" ;\n  rdfs:comment \"A reference number in the header section.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:addressLine1 a owl:DatatypeProperty ;\n  rdfs:label \"address line 1\" ;\n  rdfs:comment \"First line of a postal address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:addressLine2 a owl:DatatypeProperty ;\n  rdfs:label \"address line 2\" ;\n  rdfs:comment \"Second line of a postal address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:postalCode a owl:DatatypeProperty ;\n  rdfs:label \"postal code\" ;\n  rdfs:comment \"Postal code of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:city a owl:DatatypeProperty ;\n  rdfs:label \"city\" ;\n  rdfs:comment \"City of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:country a owl:DatatypeProperty ;\n  rdfs:label \"country\" ;\n  rdfs:comment \"Country of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:glnCode a owl:DatatypeProperty ;\n  rdfs:label \"GLN code\" ;\n  rdfs:comment \"GLN string value.\" ;\n  rdfs:domain :GlobalLocationNumber ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:itemDescription a owl:DatatypeProperty ;\n  rdfs:label \"item description\" ;\n  rdfs:comment \"Description of an invoice item.\" ;\n  rdfs:domain :Item ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:netPrice a owl:DatatypeProperty ;\n  rdfs:label \"net price\" ;\n  rdfs:comment \"Net price of an item.\" ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:quantityValue a owl:DatatypeProperty ;\n  rdfs:label \"quantity value\" ;\n  rdfs:comment \"Quantity value of an item.\" ;\n  rdfs:domain :Quantity ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:taxAmount a owl:DatatypeProperty ;\n  rdfs:label \"tax amount\" ;\n  rdfs:comment \"Tax amount in the summary section.\" ;\n  rdfs:domain :Tax ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:invoiceTotal a owl:DatatypeProperty ;\n  rdfs:label \"invoice total\" ;\n  rdfs:comment \"Total invoice amount.\" ;\n  rdfs:domain :InvoiceAmount ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:invoiceNumberValue a owl:DatatypeProperty ;\n  rdfs:label \"invoice number value\" ;\n  rdfs:comment \"Value of the invoice number.\" ;\n  rdfs:domain :InvoiceNumber ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:constraintExpression a owl:DatatypeProperty ;\n  rdfs:label \"constraint expression\" ;\n  rdfs:comment \"Constraint expression for validation.\" ;\n  rdfs:domain :ValidationConstraint ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:shaclExpression a owl:DatatypeProperty ;\n  rdfs:label \"SHACL expression\" ;\n  rdfs:comment \"SHACL constraint expression.\" ;\n  rdfs:domain :SHACLConstraint ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    :Message\n    [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :HeaderSection ]\n    [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :DetailSection ]\n    [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :SummarySection ]\n    [ a owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom :InvoiceNumber ]\n    [ a owl:Restriction ; owl:onProperty :assignedToBusinessProcess ; owl:someValuesFrom :BusinessProcess ]\n  ]\n] .\n\n:Organization owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :hasRoleAssignment ; owl:someValuesFrom :Pivot_OrganizationRoleAssignment ]\n    [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Address ]\n    [ a owl:Restriction ; owl:onProperty :hasGLN ; owl:someValuesFrom :GlobalLocationNumber ]\n  )\n] .\n\n:Pivot_OrganizationRoleAssignment owl:equivalentClass [\n  a owl:Class ;\n  owl:intersectionOf (\n    [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ]\n    [ a owl:Restriction ; owl:onProperty :roleInInvoice ; owl:someValuesFrom :InvoiceMessage ]\n  )\n] .\n\n#################################################################\n# End of ontology\n#################################################################\n"
}
