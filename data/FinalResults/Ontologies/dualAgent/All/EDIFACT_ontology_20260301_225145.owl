@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology#UNEDIFACTInvoiceOntology> a owl:Ontology ;
  rdfs:label "UN/EDIFACT Invoice Ontology" ;
  rdfs:comment "Ontology for modeling UN/EDIFACT invoice messages, organizations, roles, and document structure as per EN 16931-1 and P2P-O alignment." .

#################################################################
# Classes
#################################################################
:InterchangeEnvelope a owl:Class ;
  rdfs:label "Interchange Envelope" ;
  rdfs:comment "The envelope containing one or more EDIFACT messages." .

:Message a owl:Class ;
  rdfs:label "Message" ;
  rdfs:comment "A generic message within an interchange envelope." .

:InvoiceMessage a owl:Class ;
  rdfs:label "Invoice Message" ;
  rdfs:comment "A message representing an invoice (e.g., INVOIC)." ;
  rdfs:subClassOf :Message .

:Segment a owl:Class ;
  rdfs:label "Segment" ;
  rdfs:comment "A segment within a message, such as BGM or NAD." .

:HeaderSection a owl:Class ;
  rdfs:label "Header Section" ;
  rdfs:comment "The header section of an invoice, containing dates and reference numbers." ;
  rdfs:subClassOf :Segment .

:DetailSection a owl:Class ;
  rdfs:label "Detail Section" ;
  rdfs:comment "The detail section of an invoice, containing line items." ;
  rdfs:subClassOf :Segment .

:SummarySection a owl:Class ;
  rdfs:label "Summary Section" ;
  rdfs:comment "The summary section of an invoice, containing totals and taxes." ;
  rdfs:subClassOf :Segment .

:CompositeDataElement a owl:Class ;
  rdfs:label "Composite Data Element" ;
  rdfs:comment "A composite data element within a segment." ;
  rdfs:subClassOf :Segment .

:SimpleDataElement a owl:Class ;
  rdfs:label "Simple Data Element" ;
  rdfs:comment "A simple data element within a composite data element." ;
  rdfs:subClassOf :CompositeDataElement .

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "An organization involved in the invoice, such as buyer or seller." .

:AgentRole a owl:Class ;
  rdfs:label "Agent Role" ;
  rdfs:comment "A role played by an organization in a transaction (e.g., Buyer, Seller, Delivery Party)." .

:RoleAssignment a owl:Class ;
  rdfs:label "Role Assignment" ;
  rdfs:comment "A reified relation connecting an organization, its role, and the invoice context." .

:Address a owl:Class ;
  rdfs:label "Address" ;
  rdfs:comment "An address associated with an organization." ;
  rdfs:subClassOf :CompositeDataElement .

:Identifier a owl:Class ;
  rdfs:label "Identifier" ;
  rdfs:comment "An identifier such as a Global Location Number (GLN)." .

:LineItem a owl:Class ;
  rdfs:label "Line Item" ;
  rdfs:comment "A line item in an invoice, describing an item, quantity, and price." .

:Item a owl:Class ;
  rdfs:label "Item" ;
  rdfs:comment "An item being sold in the invoice." .

:Price a owl:Class ;
  rdfs:label "Price" ;
  rdfs:comment "A price associated with a line item." .

:Tax a owl:Class ;
  rdfs:label "Tax" ;
  rdfs:comment "A tax amount associated with the invoice." .

:BusinessProcess a owl:Class ;
  rdfs:label "Business Process" ;
  rdfs:comment "A business process to which the invoice can be assigned." .

#################################################################
# Object Properties (with inverses)
#################################################################
:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "contains message" ;
  rdfs:comment "Relates an interchange envelope to the message(s) it contains." ;
  rdfs:domain :InterchangeEnvelope ;
  rdfs:range :Message ;
  owl:inverseOf :isContainedInEnvelope .

:isContainedInEnvelope a owl:ObjectProperty ;
  rdfs:label "is contained in envelope" ;
  rdfs:comment "Inverse of containsMessage: relates a message to its interchange envelope." ;
  rdfs:domain :Message ;
  rdfs:range :InterchangeEnvelope .

:hasSegment a owl:ObjectProperty ;
  rdfs:label "has segment" ;
  rdfs:comment "Relates a message to its segments." ;
  rdfs:domain :Message ;
  rdfs:range :Segment ;
  owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
  rdfs:label "is segment of" ;
  rdfs:comment "Inverse of hasSegment: relates a segment to its message." ;
  rdfs:domain :Segment ;
  rdfs:range :Message .

:hasCompositeDataElement a owl:ObjectProperty ;
  rdfs:label "has composite data element" ;
  rdfs:comment "Relates a segment to its composite data elements." ;
  rdfs:domain :Segment ;
  rdfs:range :CompositeDataElement ;
  owl:inverseOf :isCompositeDataElementOf .

:isCompositeDataElementOf a owl:ObjectProperty ;
  rdfs:label "is composite data element of" ;
  rdfs:comment "Inverse of hasCompositeDataElement: relates a composite data element to its segment." ;
  rdfs:domain :CompositeDataElement ;
  rdfs:range :Segment .

:hasSimpleDataElement a owl:ObjectProperty ;
  rdfs:label "has simple data element" ;
  rdfs:comment "Relates a composite data element to its simple data elements." ;
  rdfs:domain :CompositeDataElement ;
  rdfs:range :SimpleDataElement ;
  owl:inverseOf :isSimpleDataElementOf .

:isSimpleDataElementOf a owl:ObjectProperty ;
  rdfs:label "is simple data element of" ;
  rdfs:comment "Inverse of hasSimpleDataElement: relates a simple data element to its composite data element." ;
  rdfs:domain :SimpleDataElement ;
  rdfs:range :CompositeDataElement .

:involvesOrganization a owl:ObjectProperty ;
  rdfs:label "involves organization" ;
  rdfs:comment "Relates an invoice message to organizations involved." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range :Organization ;
  owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
  rdfs:label "is organization involved in" ;
  rdfs:comment "Inverse of involvesOrganization: relates an organization to invoice messages it is involved in." ;
  rdfs:domain :Organization ;
  rdfs:range :InvoiceMessage .

:hasRoleAssignment a owl:ObjectProperty ;
  rdfs:label "has role assignment" ;
  rdfs:comment "Relates an invoice message to a role assignment (pivot class for reification)." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range :RoleAssignment ;
  owl:inverseOf :isRoleAssignmentOf .

:isRoleAssignmentOf a owl:ObjectProperty ;
  rdfs:label "is role assignment of" ;
  rdfs:comment "Inverse of hasRoleAssignment: relates a role assignment to its invoice message." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range :InvoiceMessage .

:assignedRole a owl:ObjectProperty ;
  rdfs:label "assigned role" ;
  rdfs:comment "Relates a role assignment to the agent role." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range :AgentRole ;
  owl:inverseOf :isRoleAssignedTo .

:isRoleAssignedTo a owl:ObjectProperty ;
  rdfs:label "is role assigned to" ;
  rdfs:comment "Inverse of assignedRole: relates an agent role to role assignments." ;
  rdfs:domain :AgentRole ;
  rdfs:range :RoleAssignment .

:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "assigned organization" ;
  rdfs:comment "Relates a role assignment to the organization assigned that role." ;
  rdfs:domain :RoleAssignment ;
  rdfs:range :Organization ;
  owl:inverseOf :isOrganizationAssignedTo .

:isOrganizationAssignedTo a owl:ObjectProperty ;
  rdfs:label "is organization assigned to" ;
  rdfs:comment "Inverse of assignedOrganization: relates an organization to its role assignments." ;
  rdfs:domain :Organization ;
  rdfs:range :RoleAssignment .

:hasAddress a owl:ObjectProperty ;
  rdfs:label "has address" ;
  rdfs:comment "Relates an organization to its address." ;
  rdfs:domain :Organization ;
  rdfs:range :Address ;
  owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
  rdfs:label "is address of" ;
  rdfs:comment "Inverse of hasAddress: relates an address to the organization it belongs to." ;
  rdfs:domain :Address ;
  rdfs:range :Organization .

:hasIdentifier a owl:ObjectProperty ;
  rdfs:label "has identifier" ;
  rdfs:comment "Relates an organization to its identifier (e.g., GLN)." ;
  rdfs:domain :Organization ;
  rdfs:range :Identifier ;
  owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
  rdfs:label "is identifier of" ;
  rdfs:comment "Inverse of hasIdentifier: relates an identifier to its organization." ;
  rdfs:domain :Identifier ;
  rdfs:range :Organization .

:hasLineItem a owl:ObjectProperty ;
  rdfs:label "has line item" ;
  rdfs:comment "Relates an invoice message to its line items." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range :LineItem ;
  owl:inverseOf :isLineItemOf .

:isLineItemOf a owl:ObjectProperty ;
  rdfs:label "is line item of" ;
  rdfs:comment "Inverse of hasLineItem: relates a line item to its invoice message." ;
  rdfs:domain :LineItem ;
  rdfs:range :InvoiceMessage .

:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "describes item" ;
  rdfs:comment "Relates a line item to the item it describes." ;
  rdfs:domain :LineItem ;
  rdfs:range :Item ;
  owl:inverseOf :isDescribedByLineItem .

:isDescribedByLineItem a owl:ObjectProperty ;
  rdfs:label "is described by line item" ;
  rdfs:comment "Inverse of describesItem: relates an item to the line item describing it." ;
  rdfs:domain :Item ;
  rdfs:range :LineItem .

:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "has price" ;
  rdfs:comment "Relates a line item to its price." ;
  rdfs:domain :LineItem ;
  rdfs:range :Price ;
  owl:inverseOf :isPriceOf .

:isPriceOf a owl:ObjectProperty ;
  rdfs:label "is price of" ;
  rdfs:comment "Inverse of hasPrice: relates a price to the line item it is for." ;
  rdfs:domain :Price ;
  rdfs:range :LineItem .

:hasTax a owl:ObjectProperty ;
  rdfs:label "has tax" ;
  rdfs:comment "Relates an invoice message to its tax information." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range :Tax ;
  owl:inverseOf :isTaxOf .

:isTaxOf a owl:ObjectProperty ;
  rdfs:label "is tax of" ;
  rdfs:comment "Inverse of hasTax: relates a tax to the invoice message." ;
  rdfs:domain :Tax ;
  rdfs:range :InvoiceMessage .

:assignedToBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "assigned to business process" ;
  rdfs:comment "Relates an invoice message to a business process." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range :BusinessProcess ;
  owl:inverseOf :isBusinessProcessAssignmentOf .

:isBusinessProcessAssignmentOf a owl:ObjectProperty ;
  rdfs:label "is business process assignment of" ;
  rdfs:comment "Inverse of assignedToBusinessProcess: relates a business process to invoice messages assigned to it." ;
  rdfs:domain :BusinessProcess ;
  rdfs:range :InvoiceMessage .

#################################################################
# Data Properties
#################################################################
:hasInvoiceNumber a owl:DatatypeProperty ;
  rdfs:label "has invoice number" ;
  rdfs:comment "The invoice number." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range xsd:string .

:hasInvoiceAmount a owl:DatatypeProperty ;
  rdfs:label "has invoice amount" ;
  rdfs:comment "The total amount of the invoice." ;
  rdfs:domain :InvoiceMessage ;
  rdfs:range xsd:decimal .

:hasDocumentDate a owl:DatatypeProperty ;
  rdfs:label "has document date" ;
  rdfs:comment "The date and time of the document." ;
  rdfs:domain :HeaderSection ;
  rdfs:range xsd:dateTime .

:hasReferenceNumber a owl:DatatypeProperty ;
  rdfs:label "has reference number" ;
  rdfs:comment "The reference number in the header section." ;
  rdfs:domain :HeaderSection ;
  rdfs:range xsd:string .

:hasNetPrice a owl:DatatypeProperty ;
  rdfs:label "has net price" ;
  rdfs:comment "The net price of an item in a line item." ;
  rdfs:domain :Price ;
  rdfs:range xsd:decimal .

:hasQuantity a owl:DatatypeProperty ;
  rdfs:label "has quantity" ;
  rdfs:comment "The quantity of items in a line item." ;
  rdfs:domain :LineItem ;
  rdfs:range xsd:decimal .

:hasTaxAmount a owl:DatatypeProperty ;
  rdfs:label "has tax amount" ;
  rdfs:comment "The amount of tax in the invoice." ;
  rdfs:domain :Tax ;
  rdfs:range xsd:decimal .

:hasIdentifierValue a owl:DatatypeProperty ;
  rdfs:label "has identifier value" ;
  rdfs:comment "The value for an identifier (e.g., GLN)." ;
  rdfs:domain :Identifier ;
  rdfs:range xsd:string .

:hasAddressLine a owl:DatatypeProperty ;
  rdfs:label "has address line" ;
  rdfs:comment "A line of an address." ;
  rdfs:domain :Address ;
  rdfs:range xsd:string .

#################################################################
# Disjointness
#################################################################
:HeaderSection owl:disjointWith :DetailSection, :SummarySection .
:DetailSection owl:disjointWith :SummarySection .
:Organization owl:disjointWith :AgentRole, :Address .
:Item owl:disjointWith :LineItem .
:InvoiceMessage owl:disjointWith :InterchangeEnvelope .

#################################################################
# Restrictions & GCAs
#################################################################
:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Organization ] .
:RoleAssignment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:allValuesFrom :AgentRole ] .
:LineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ] .

#################################################################
# Disjoint Union
#################################################################
:Segment owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .
