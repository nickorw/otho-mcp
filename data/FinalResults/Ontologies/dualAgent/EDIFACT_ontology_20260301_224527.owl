@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .
@base <http://www.example.org/ontology#UNEDIFACT_INVOICE> .

<http://www.example.org/ontology#UNEDIFACT_INVOICE> a owl:Ontology ;
    rdfs:label "UN/EDIFACT Invoice Ontology" ;
    rdfs:comment "An ontology modeling the structure and semantics of UN/EDIFACT invoice messages, aligned with EN 16931-1 and P2P-O." .

#################################################################
# Classes
#################################################################

:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The root envelope containing EDIFACT messages." .

:Message a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "A generic EDIFACT message." .

:InvoiceMessage a owl:Class ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An invoice message (INVOIC) as defined in UN/EDIFACT." ;
    rdfs:subClassOf :Message .

:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "A segment in an EDIFACT message, such as BGM or NAD." .

:InvoiceHeaderSection a owl:Class ;
    rdfs:label "Invoice Header Section" ;
    rdfs:comment "Header section of an invoice, containing dates and reference numbers." ;
    rdfs:subClassOf :Segment .

:InvoiceDetailSection a owl:Class ;
    rdfs:label "Invoice Detail Section" ;
    rdfs:comment "Detail section listing invoice line items." ;
    rdfs:subClassOf :Segment .

:InvoiceSummarySection a owl:Class ;
    rdfs:label "Invoice Summary Section" ;
    rdfs:comment "Summary section providing totals such as tax and invoice amount." ;
    rdfs:subClassOf :Segment .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite element in a segment, grouping multiple simple elements." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A simple data element in a segment." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A business entity involved in the transaction." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in an invoice (e.g., Buyer, Seller)." .

:RoleType a owl:Class ;
    rdfs:label "Role Type" ;
    rdfs:comment "The type of agent role (e.g., Buyer, Seller, DeliveryParty)." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address for an organization." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "An identifier such as a Global Location Number (GLN)." .

:OrganizationRoleAssignment a owl:Class ;
    rdfs:label "Organization Role Assignment" ;
    rdfs:comment "A pivot class linking an organization to its role(s) in an invoice." .

:InvoiceItemLine a owl:Class ;
    rdfs:label "Invoice Item Line" ;
    rdfs:comment "A pivot class representing a line item in the invoice, linking item, price, and quantity." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item being sold in the invoice." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value for an item line." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which the invoice is assigned." .

:EDIFACTDelimiter a owl:Class ;
    rdfs:label "EDIFACT Delimiter" ;
    rdfs:comment "A delimiter character used in EDIFACT, such as plus or colon." .

#################################################################
# Object Properties (with correct annotations)
#################################################################

:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "contains message" ;
    rdfs:comment "Links an interchange envelope to the message(s) it contains." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :Message ;
    owl:inverseOf :isContainedInEnvelope .

:isContainedInEnvelope a owl:ObjectProperty ;
    rdfs:label "is contained in envelope" ;
    rdfs:comment "Links a message to its containing envelope." ;
    rdfs:domain :Message ;
    rdfs:range :InterchangeEnvelope ;
    owl:inverseOf :containsMessage .

:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:comment "Links a message to its segments." ;
    rdfs:domain :Message ;
    rdfs:range :Segment ;
    owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
    rdfs:label "is segment of" ;
    rdfs:comment "Links a segment to the message it is part of." ;
    rdfs:domain :Segment ;
    rdfs:range :Message ;
    owl:inverseOf :hasSegment .

:hasCompositeElement a owl:ObjectProperty ;
    rdfs:label "has composite element" ;
    rdfs:comment "Links a segment to its composite elements." ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :isCompositeElementOf .

:isCompositeElementOf a owl:ObjectProperty ;
    rdfs:label "is composite element of" ;
    rdfs:comment "Links a composite data element to the segment it is part of." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment ;
    owl:inverseOf :hasCompositeElement .

:hasSimpleElement a owl:ObjectProperty ;
    rdfs:label "has simple element" ;
    rdfs:comment "Links a composite element to its simple elements." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    owl:inverseOf :isSimpleElementOf .

:isSimpleElementOf a owl:ObjectProperty ;
    rdfs:label "is simple element of" ;
    rdfs:comment "Links a simple data element to the composite data element it is part of." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :hasSimpleElement .

:playedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "played by" ;
    rdfs:comment "Links an agent role to the organization playing it." ;
    rdfs:domain :AgentRole ;
    rdfs:range :Organization ;
    owl:inverseOf :playsRole .

:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role" ;
    rdfs:comment "Links an organization to the agent role it plays." ;
    rdfs:domain :Organization ;
    rdfs:range :AgentRole ;
    owl:inverseOf :playedBy .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Links an invoice message to its organization role assignments." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :isRoleAssignmentOf .

:isRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:label "is role assignment of" ;
    rdfs:comment "Links a role assignment to the invoice message it belongs to." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasRoleAssignment .

:roleType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "role type" ;
    rdfs:comment "Links an agent role to its role type." ;
    rdfs:domain :AgentRole ;
    rdfs:range :RoleType ;
    owl:inverseOf :isRoleTypeOf .

:isRoleTypeOf a owl:ObjectProperty ;
    rdfs:label "is role type of" ;
    rdfs:comment "Links a role type to the agent role it is associated with." ;
    rdfs:domain :RoleType ;
    rdfs:range :AgentRole ;
    owl:inverseOf :roleType .

:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Links an organization to its address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of" ;
    rdfs:comment "Links an address to the organization it is for." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "has identifier" ;
    rdfs:comment "Links an organization to its identifier(s)." ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier ;
    owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Links an identifier to the organization it identifies." ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization ;
    owl:inverseOf :hasIdentifier .

:hasInvoiceSection a owl:ObjectProperty ;
    rdfs:label "has invoice section" ;
    rdfs:comment "Links an invoice message to its sections (header, detail, summary)." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Segment ;
    owl:inverseOf :isInvoiceSectionOf .

:isInvoiceSectionOf a owl:ObjectProperty ;
    rdfs:label "is invoice section of" ;
    rdfs:comment "Links a segment to the invoice message it is part of." ;
    rdfs:domain :Segment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasInvoiceSection .

:hasLineItem a owl:ObjectProperty ;
    rdfs:label "has line item" ;
    rdfs:comment "Links the detail section to its invoice item lines." ;
    rdfs:domain :InvoiceDetailSection ;
    rdfs:range :InvoiceItemLine ;
    owl:inverseOf :isLineItemOf .

:isLineItemOf a owl:ObjectProperty ;
    rdfs:label "is line item of" ;
    rdfs:comment "Links an invoice item line to the detail section it is part of." ;
    rdfs:domain :InvoiceItemLine ;
    rdfs:range :InvoiceDetailSection ;
    owl:inverseOf :hasLineItem .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links an invoice message to organizations involved in it." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :Organization ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Links an organization to the invoice message it is involved in." ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :involvesOrganization .

:relatedToBusinessProcess a owl:ObjectProperty ;
    rdfs:label "related to business process" ;
    rdfs:comment "Links an invoice message to a business process." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :isBusinessProcessOf .

:isBusinessProcessOf a owl:ObjectProperty ;
    rdfs:label "is business process of" ;
    rdfs:comment "Links a business process to the invoice message it is assigned to." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :relatedToBusinessProcess .

:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Links an invoice item line to an item." ;
    rdfs:domain :InvoiceItemLine ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOf .

:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:comment "Links an item to the invoice item line it is part of." ;
    rdfs:domain :Item ;
    rdfs:range :InvoiceItemLine ;
    owl:inverseOf :hasItem .

:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has price" ;
    rdfs:comment "Links an invoice item line to its price." ;
    rdfs:domain :InvoiceItemLine ;
    rdfs:range :Price ;
    owl:inverseOf :isPriceOf .

:isPriceOf a owl:ObjectProperty ;
    rdfs:label "is price of" ;
    rdfs:comment "Links a price to the invoice item line it is for." ;
    rdfs:domain :Price ;
    rdfs:range :InvoiceItemLine ;
    owl:inverseOf :hasPrice .

# New property to connect EDIFACTDelimiter
:usesDelimiter a owl:ObjectProperty ;
    rdfs:label "uses delimiter" ;
    rdfs:comment "Links an InterchangeEnvelope or Message to the EDIFACTDelimiter used in the message." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (:InterchangeEnvelope :Message) ] ;
    rdfs:range :EDIFACTDelimiter ;
    owl:inverseOf :isDelimiterUsedBy .

:isDelimiterUsedBy a owl:ObjectProperty ;
    rdfs:label "is delimiter used by" ;
    rdfs:comment "Links an EDIFACTDelimiter to the InterchangeEnvelope or Message that uses it." ;
    rdfs:domain :EDIFACTDelimiter ;
    rdfs:range [ a owl:Class ; owl:unionOf (:InterchangeEnvelope :Message) ] ;
    owl:inverseOf :usesDelimiter .

#################################################################
# Data Properties
#################################################################

:hasNetPrice a owl:DatatypeProperty ;
    rdfs:label "has net price" ;
    rdfs:comment "The net price value." ;
    rdfs:domain :Price ;
    rdfs:range xsd:decimal .

:hasQuantity a owl:DatatypeProperty ;
    rdfs:label "has quantity" ;
    rdfs:comment "The quantity of items in a line." ;
    rdfs:domain :InvoiceItemLine ;
    rdfs:range xsd:decimal .

:hasInvoiceAmount a owl:DatatypeProperty ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "The total invoice amount." ;
    rdfs:domain :InvoiceSummarySection ;
    rdfs:range xsd:decimal .

:hasInvoiceNumber a owl:DatatypeProperty ;
    rdfs:label "has invoice number" ;
    rdfs:comment "The invoice number." ;
    rdfs:domain :InvoiceHeaderSection ;
    rdfs:range xsd:string .

:hasDate a owl:DatatypeProperty ;
    rdfs:label "has date" ;
    rdfs:comment "A date (e.g., invoice date)." ;
    rdfs:domain :InvoiceHeaderSection ;
    rdfs:range xsd:string .

:hasTaxTotal a owl:DatatypeProperty ;
    rdfs:label "has tax total" ;
    rdfs:comment "The total tax amount." ;
    rdfs:domain :InvoiceSummarySection ;
    rdfs:range xsd:decimal .

:hasReferenceNumber a owl:DatatypeProperty ;
    rdfs:label "has reference number" ;
    rdfs:comment "A reference number in the header section." ;
    rdfs:domain :InvoiceHeaderSection ;
    rdfs:range xsd:string .

:hasGLN a owl:DatatypeProperty ;
    rdfs:label "has GLN" ;
    rdfs:comment "A Global Location Number identifying an organization." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:hasName a owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:comment "The name of an organization." ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .

:hasStreet a owl:DatatypeProperty ;
    rdfs:label "has street" ;
    rdfs:comment "The street address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:hasCity a owl:DatatypeProperty ;
    rdfs:label "has city" ;
    rdfs:comment "The city of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:hasPostalCode a owl:DatatypeProperty ;
    rdfs:label "has postal code" ;
    rdfs:comment "The postal code of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:hasCountry a owl:DatatypeProperty ;
    rdfs:label "has country" ;
    rdfs:comment "The country of an address." ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

#################################################################
# Disjointness and DisjointUnion
#################################################################

:InvoiceHeaderSection owl:disjointWith :InvoiceDetailSection, :InvoiceSummarySection .
:InvoiceDetailSection owl:disjointWith :InvoiceSummarySection .
:SimpleDataElement owl:disjointWith :CompositeDataElement .
:Organization owl:disjointWith :Address .
:Price owl:disjointWith :Item .

:Segment owl:disjointUnionOf (:InvoiceHeaderSection :InvoiceDetailSection :InvoiceSummarySection) .

#################################################################
# Restrictions and GCAs
#################################################################

:OrganizationRoleAssignment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :playedBy ; owl:someValuesFrom :Organization ],
    [ a owl:Restriction ; owl:onProperty :roleType ; owl:someValuesFrom :RoleType ] .

:InvoiceItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ],
    [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ] .

:InvoiceMessage owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasInvoiceSection ; owl:someValuesFrom :Segment ] .

#################################################################
# End of Ontology
#################################################################
