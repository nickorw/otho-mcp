@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests>
    a owl:Ontology ;
    rdfs:label "FestS" .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic class for any kind of document." .

:Cl_FinancialDocument a owl:Class ;
    rdfs:label "Financial Document" ;
    rdfs:comment "A document related to financial transactions." ;
    rdfs:subClassOf :Cl_Document .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A business/commercial document representing an invoice." ;
    rdfs:subClassOf :Cl_FinancialDocument, :Cl_Entity .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "A unique identifier assigned to an invoice, typically the invoice number." .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "Represents an item entry in an invoice." .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in an invoice representing a sale of an item with quantity, price, etc." .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:label "Invoice Amount Assignment" .

:Cl_MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount" .

:Cl_InvoiceAmount rdfs:subClassOf :Cl_MonetaryAmount .

:Cl_Amount a owl:Class .

:Cl_Price a owl:Class ; rdfs:subClassOf :Cl_Amount .

:Cl_NetPrice a owl:Class ; rdfs:subClassOf :Cl_Price .

:Cl_GrossPrice a owl:Class ; rdfs:subClassOf :Cl_Price .

:Cl_Quantity a owl:Class .

:Cl_Currency a owl:Class .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, supplier, or customer involved in invoices." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_OrganizationInfo a owl:Class ;
    rdfs:label "Organization Information" .

:Cl_ContactInfo a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_Description a owl:Class ;
    rdfs:label "Description" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_Logo a owl:Class ;
    rdfs:label "Logo" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_Website a owl:Class ;
    rdfs:label "Website" ;
    rdfs:subClassOf :Cl_OrganizationInfo .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "The role that an organization plays in the context of an invoice (e.g., buyer, seller, issuer, recipient)." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Buyer Role" .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller Role" .

:Cl_IssuerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Issuer Role" .

:Cl_RecipientRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Recipient Role" .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Reification class representing an organization's participation in an invoice with a specific role." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceParty a owl:Class ;
    rdfs:label "Invoice Party" .

:Cl_Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:subClassOf :Cl_InvoiceParty .

:Cl_Person a owl:Class .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_Address a owl:Class .

:Cl_BuyerAddressAssignment a owl:Class .

:Cl_InvoiceDate a owl:Class .

:Cl_Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf :Cl_Item .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service sold on an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf :Cl_Item .

:Cl_ItemDisplayInfo a owl:Class ;
    rdfs:label "Item Display Information" ;
    rdfs:subClassOf :Cl_Sale .

:Cl_ItemAttribute a owl:Class ;
    rdfs:label "Item Attribute" .

:Cl_DisplayValue a owl:Class ;
    rdfs:label "Display Value" .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process in the organization." .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:label "Invoice Assignment" ;
    rdfs:comment "A reification class to model the assignment of an invoice to a business process." .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured message following the EDIFACT standard." .

:Cl_EDIFACTMessageInvoiceListing a owl:Class ;
    rdfs:label "EDIFACT Message Invoice Listing" ;
    rdfs:comment "A reification node representing the listing of invoices within an EDIFACT message." .

:Cl_BusinessDocument a owl:Class ;
    rdfs:label "Business Document" ;
    rdfs:comment "A superclass for business documents such as invoices, orders, etc." ;
    rdfs:subClassOf :Cl_Document .

:Cl_FileFormat a owl:Class .

:Cl_FileFormatSpecification a owl:Class .

:Cl_RequiredInformation a owl:Class .

:Cl_Field a owl:Class .

:Cl_FieldType a owl:Class .

:Cl_ValidationRule a owl:Class .

:Cl_Requirement a owl:Class .

:Cl_Restriction a owl:Class .

:Cl_FieldRequirement a owl:Class .

:Cl_FieldValue a owl:Class .

:Cl_FileFormatValidityRequirement a owl:Class .

#################################################################
# Hierarchies & Subclasses
#################################################################

:Cl_Invoice rdfs:subClassOf :Cl_BusinessDocument, :Cl_FinancialDocument, :Cl_Entity .
:Cl_Organization rdfs:subClassOf :Cl_InvoiceParty, :Cl_Entity .
:Cl_Person rdfs:subClassOf :Cl_InvoiceParty, :Cl_Entity .
:Cl_Customer rdfs:subClassOf :Cl_InvoiceParty .
:Cl_InvoiceItem rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_InvoiceDate rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_InvoiceAmount rdfs:subClassOf :Cl_InvoiceDetail, :Cl_MonetaryAmount .
:Cl_InvoiceDetail rdfs:subClassOf owl:Thing .
:Cl_InvoiceItem rdfs:subClassOf owl:Thing .
:Cl_InvoiceDate rdfs:subClassOf owl:Thing .
:Cl_InvoiceAmount rdfs:subClassOf owl:Thing .
:Cl_InvoiceParty rdfs:subClassOf owl:Thing .
:Cl_InvoiceLine rdfs:subClassOf owl:Thing .
:Cl_BuyerAddressAssignment rdfs:subClassOf owl:Thing .
:Cl_Product rdfs:subClassOf :Cl_Item .
:Cl_Service rdfs:subClassOf :Cl_Item .
:Cl_ItemDisplayInfo rdfs:subClassOf :Cl_Sale .
:Cl_OrganizationInfo rdfs:subClassOf owl:Thing .
:Cl_ContactInfo rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_OrganizationType rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_Identifier rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_Description rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_Logo rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_Location rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_Website rdfs:subClassOf :Cl_OrganizationInfo .
:Cl_FieldType rdfs:subClassOf :Cl_RequiredInformation .
:Cl_Field rdfs:subClassOf :Cl_RequiredInformation .
:Cl_ValidationRule rdfs:subClassOf :Cl_Restriction .
:Cl_FieldValue rdfs:subClassOf :Cl_RequiredInformation .
:Cl_Requirement rdfs:subClassOf :Cl_FileFormatSpecification .
:Cl_Restriction rdfs:subClassOf :Cl_Requirement .
:Cl_FieldRequirement rdfs:subClassOf :Cl_Requirement .

#################################################################
# Disjointness
#################################################################

:Cl_Organization owl:disjointWith :Cl_Invoice, :Cl_InvoiceRole, :Cl_InvoiceParticipation, :Cl_Person, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_MonetaryAmount .
:Cl_Invoice owl:disjointWith :Cl_InvoiceRole, :Cl_InvoiceParticipation, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_MonetaryAmount, :Cl_BusinessProcess, :Cl_InvoiceAssignment, :Cl_InvoiceIdentifier .
:Cl_InvoiceRole owl:disjointWith :Cl_InvoiceParticipation, :Cl_Organization, :Cl_Invoice .
:Cl_InvoiceParticipation owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_InvoiceRole .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_InvoiceItem owl:disjointWith :Cl_InvoiceDate, :Cl_InvoiceAmount .
:Cl_Organization owl:disjointWith :Cl_Person .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_Person owl:disjointWith :Cl_Address .
:Cl_Item owl:disjointWith :Cl_ItemDisplayInfo, :Cl_ItemAttribute, :Cl_DisplayValue, :Cl_Sale .
:Cl_Sale owl:disjointWith :Cl_Item, :Cl_ItemAttribute, :Cl_DisplayValue .
:Cl_ItemDisplayInfo owl:disjointWith :Cl_ItemAttribute, :Cl_DisplayValue .
:Cl_ItemAttribute owl:disjointWith :Cl_DisplayValue .
:Cl_InvoiceAssignment owl:disjointWith :Cl_Invoice, :Cl_BusinessProcess, :Cl_Document, :Cl_FinancialDocument .
:Cl_Field owl:disjointWith :Cl_ValidationRule, :Cl_Restriction, :Cl_FieldType, :Cl_FileFormat, :Cl_FileFormatSpecification .
:Cl_FieldRequirement owl:disjointWith :Cl_ValidationRule, :Cl_Restriction .
:Cl_ValidationRule owl:disjointWith :Cl_Restriction .
:Cl_FieldValue owl:disjointWith :Cl_Field, :Cl_FieldType, :Cl_Requirement .
:Cl_InvoiceIdentifier owl:disjointWith :Cl_Invoice, :Cl_Document .

#################################################################
# Object Properties
#################################################################

:hasInvoiceIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentifier ;
    rdfs:label "has invoice identifier" ;
    rdfs:comment "Relates an invoice to its identifier (invoice number)." ;
    owl:inverseOf :isInvoiceIdentifierOf .

:isInvoiceIdentifierOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice identifier of" ;
    rdfs:comment "Inverse property for hasInvoiceIdentifier." ;
    owl:inverseOf :hasInvoiceIdentifier .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "has invoice item" ;
    rdfs:comment "Links an invoice to its invoice items." ;
    owl:inverseOf :isInvoiceItemOf .

:isInvoiceItemOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice item of" ;
    owl:inverseOf :hasInvoiceItem .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem, :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "refers to item" .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice .

:hasGrossPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_GrossPrice .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Quantity .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range :Cl_Currency .

:hasTotalNetPrice a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPrice .

:hasInvoiceDetail a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail ;
    owl:inverseOf :isDetailOf .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product .

:hasCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer ;
    owl:inverseOf :isCustomerOf .

:issuedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :isIssuedByOf .

:hasInvoiceDate a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_InvoiceDate .

:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_InvoiceAmount .

:isDetailOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceDetail .

:isCustomerOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasCustomer .

:isIssuedByOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :issuedBy .

:hasInvoiceAmountAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountAssignment ;
    rdfs:label "has invoice amount assignment" ;
    owl:inverseOf :invoiceAmountAssignmentForInvoice .

:invoiceAmountAssignmentForInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice amount assignment for invoice" ;
    owl:inverseOf :hasInvoiceAmountAssignment .

:assignsInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:label "assigns invoice amount" .

:hasOrganization a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" .

:hasContactInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_ContactInfo ;
    rdfs:label "has contact info" .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_OrganizationType ;
    rdfs:label "has organization type" .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_Identifier ;
    rdfs:label "has identifier" .

:hasDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_Description ;
    rdfs:label "has description" .

:hasLogo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_Logo ;
    rdfs:label "has logo" .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_Location ;
    rdfs:label "has location" .

:hasWebsite a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo ;
    rdfs:range :Cl_Website ;
    rdfs:label "has website" .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :participatesInInvoice .

:hasOrganizationParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :involvesOrganization .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :hasOrganizationParticipation .

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceParticipation .

:participation_organization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :has_participation .

:participation_invoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :invoice_has_participation .

:participation_role a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:has_participation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :participation_organization .

:invoice_has_participation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :participation_invoice .

:hasInvoiceParticipation2 a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address .

:buyerHasAddressAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:hasDisplayInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Sale ;
    rdfs:range :Cl_ItemDisplayInfo ;
    owl:inverseOf :displayedForInfo .

:displayedItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Item .

:hasDisplayedAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_ItemAttribute .

:hasDisplayValue a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_DisplayValue .

:attributeOf a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range :Cl_Item .

:displayedForInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Sale ;
    owl:inverseOf :hasDisplayInfo .

:hasDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Document .

:hasFinancialDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_FinancialDocument ;
    rdfs:subPropertyOf :hasDocument .

:hasInvoiceBP a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Invoice ;
    rdfs:subPropertyOf :hasFinancialDocument .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :isInvoiceAssignmentFor .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_BusinessProcess ;
    owl:inverseOf :isBusinessProcessAssignmentFor .

:isInvoiceAssignmentFor a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAssignment ;
    owl:inverseOf :assignedInvoice .

:isBusinessProcessAssignmentFor a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_InvoiceAssignment ;
    owl:inverseOf :assignedBusinessProcess .

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing .

:listedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_Invoice .

:hasBusinessDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_BusinessDocument .

:hasRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_Requirement .

:requiresField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_FieldRequirement .

:requiresValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_ValidationRule .

:specifiesFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_FileFormat .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_Field .

:fieldHasType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldType .

:fieldHasRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldRequirement .

:fieldHasValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_ValidationRule .

:fieldHasValue a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldValue .

:hasRestriction a owl:ObjectProperty ;
    rdfs:domain :Cl_Requirement ;
    rdfs:range :Cl_Restriction .

:validityRequirementForFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_FileFormat .

:validityRequirementHasSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityRequirement ;
    rdfs:range :Cl_FileFormatSpecification .

#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:invoiceNumberValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:invoiceDateValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDate ;
    rdfs:range xsd:date .

:invoiceAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal .

:invoiceTotalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:organization_name a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:productQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:integer .

:productUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:itemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item, :Cl_ItemAttribute ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item, :Cl_ItemAttribute ;
    rdfs:range xsd:string .

:itemUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:itemTotalPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:itemQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:integer .

:itemPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range xsd:decimal .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range xsd:string .

:itemCategory a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range xsd:string .

:displayValueLiteral a owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayValue ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string .

:contactAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range xsd:string .

:organizationTypeLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Identifier ;
    rdfs:range xsd:string .

:identifierType a owl:DatatypeProperty ;
    rdfs:domain :Cl_Identifier ;
    rdfs:range xsd:string .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_Description ;
    rdfs:range xsd:string .

:logoURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Logo ;
    rdfs:range xsd:anyURI .

:locationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:locationCoordinates a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:websiteURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Website ;
    rdfs:range xsd:anyURI .

:hasAmountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:decimal .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

