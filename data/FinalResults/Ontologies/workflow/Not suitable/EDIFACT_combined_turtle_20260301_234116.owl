    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range xsd:dateTime .

#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceIdentifier ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_InvoiceIdentifier
] ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Cl_FinancialDocument
            [ a owl:Restriction ;
              owl:onProperty :assignedInvoice ;
              owl:allValuesFrom :Cl_InvoiceAssignment
            ]
        )
    ] ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasInvoiceDetail ;
        owl:allValuesFrom :Cl_InvoiceDetail
    ] ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasInvoiceItem ;
        owl:allValuesFrom :Cl_InvoiceItem
    ] ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasInvoiceLine ;
        owl:allValuesFrom :Cl_InvoiceLine
    ] ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasInvoiceListing ;
        owl:allValuesFrom :Cl_EDIFACTMessageInvoiceListing
    ] ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasInvoiceParticipation ;
        owl:someValuesFrom :Cl_InvoiceParticipation
    ] .

:Cl_InvoiceIdentifier rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_InvoiceDetail owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceItem ;
    owl:someValuesFrom :Cl_InvoiceItem
] .

:Cl_InvoiceItem owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasProduct ;
    owl:allValuesFrom :Cl_Product
] ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :refersToItem ;
        owl:allValuesFrom :Cl_Item
    ] .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Cl_NetPrice ]
        [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom :Cl_Quantity ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :assignsInvoiceAmount ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_InvoiceAmount ]
        [ a owl:Restriction ; owl:onProperty :invoiceAmountAssignmentForInvoice ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Invoice ]
    )
] .

:Cl_InvoiceParticipation
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ; owl:onProperty :participation_organization ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Organization ]
            [ a owl:Restriction ; owl:onProperty :participation_invoice ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Invoice ]
            [ a owl:Restriction ; owl:onProperty :participation_role ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_InvoiceRole ]
        )
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :involvesOrganization ;
        owl:allValuesFrom :Cl_Organization
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :participatesInInvoice ;
        owl:allValuesFrom :Cl_Invoice
    ] .

:Cl_Organization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasOrganizationParticipation ;
    owl:someValuesFrom :Cl_InvoiceParticipation
] .

:Cl_InvoiceParticipation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :participatesInInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_OrganizationInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Address ]
    )
] .

:Cl_Buyer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :buyerHasAddressAssignment ;
    owl:someValuesFrom :Cl_BuyerAddressAssignment
] .

:Cl_ItemDisplayInfo owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :displayedItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_ItemDisplayInfo rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasDisplayedAttribute ;
    owl:someValuesFrom :Cl_ItemAttribute
] ;
    rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasDisplayValue ;
    owl:someValuesFrom :Cl_DisplayValue
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :assignedInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_FileFormatValidityRequirement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :validityRequirementForFileFormat ; owl:someValuesFrom :Cl_FileFormat ]
        [ a owl:Restriction ; owl:onProperty :requiresField ; owl:someValuesFrom :Cl_FieldRequirement ]
        [ a owl:Restriction ; owl:onProperty :requiresValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
    )
] .

#################################################################
# Inverse Properties
#################################################################

# All inverse properties have been explicitly declared on both properties above.

#################################################################
# End of Ontology
#################################################################
