:lineItemUnitPrice rdf:type owl:DatatypeProperty ; rdfs:domain :InvoiceLineItem ; rdfs:range xsd:decimal ; rdfs:label "line item unit price"@en ; rdfs:comment "Unit price for invoice line item."@en .
:lineItemTotal rdf:type owl:DatatypeProperty ; rdfs:domain :InvoiceLineItem ; rdfs:range xsd:decimal ; rdfs:label "line item total"@en ; rdfs:comment "Total for invoice line item."@en .
:description rdf:type owl:DatatypeProperty ; rdfs:domain :Item ; rdfs:range xsd:string ; rdfs:label "description"@en ; rdfs:comment "Description of the item."@en .
:amountValue rdf:type owl:DatatypeProperty ; rdfs:domain :InvoiceAmount ; rdfs:range xsd:decimal ; rdfs:label "amount value"@en ; rdfs:comment "Value for invoice amount."@en .
:currencyCode rdf:type owl:DatatypeProperty ; rdfs:domain :Currency ; rdfs:range xsd:string ; rdfs:label "currency code"@en ; rdfs:comment "Code of the currency."@en .
:identificationValue rdf:type owl:DatatypeProperty ; rdfs:domain :InvoiceIdentificationEvent ; rdfs:range xsd:string ; rdfs:label "identification value"@en ; rdfs:comment "Value for invoice identification."@en .
:fieldName rdf:type owl:DatatypeProperty ; rdfs:domain :FieldDefinition ; rdfs:range xsd:string ; rdfs:label "field name"@en ; rdfs:comment "Name of the field."@en .
:constraintExpression rdf:type owl:DatatypeProperty ; rdfs:domain :FieldConstraint ; rdfs:range xsd:string ; rdfs:label "constraint expression"@en ; rdfs:comment "Expression for the constraint."@en .
:presenceType rdf:type owl:DatatypeProperty ; rdfs:domain :FieldPresenceRequirement ; rdfs:range xsd:string ; rdfs:label "presence type"@en ; rdfs:comment "Type of presence requirement."@en .
:formatPattern rdf:type owl:DatatypeProperty ; rdfs:domain :FieldFormatSpecification ; rdfs:range xsd:string ; rdfs:label "format pattern"@en ; rdfs:comment "Pattern for field format."@en .
:dataTypeName rdf:type owl:DatatypeProperty ; rdfs:domain :DataType ; rdfs:range xsd:string ; rdfs:label "data type name"@en ; rdfs:comment "Name of data type."@en .
:validationRule rdf:type owl:DatatypeProperty ; rdfs:domain :FieldValidation ; rdfs:range xsd:string ; rdfs:label "validation rule"@en ; rdfs:comment "Validation rule for field."@en .
:fieldValue rdf:type owl:DatatypeProperty ; rdfs:domain :FieldValue ; rdfs:range xsd:string ; rdfs:label "field value"@en ; rdfs:comment "Value of the field."@en .
:assignmentDate a owl:DatatypeProperty ; rdfs:domain :Assignment ; rdfs:range xsd:dateTime ; rdfs:label "assignment date"@en ; rdfs:comment "Date of the assignment."@en .
:addressStreet rdf:type owl:DatatypeProperty ; rdfs:domain :Address ; rdfs:range xsd:string ; rdfs:label "street"@en ; rdfs:comment "Street for the address."@en .
:addressCity rdf:type owl:DatatypeProperty ; rdfs:domain :Address ; rdfs:range xsd:string ; rdfs:label "city"@en ; rdfs:comment "City for the address."@en .
:addressPostalCode rdf:type owl:DatatypeProperty ; rdfs:domain :Address ; rdfs:range xsd:string ; rdfs:label "postal code"@en ; rdfs:comment "Postal code for the address."@en .
:addressCountry rdf:type owl:DatatypeProperty ; rdfs:domain :Address ; rdfs:range xsd:string ; rdfs:label "country"@en ; rdfs:comment "Country for the address."@en .

#################################################################
# Restrictions & Equivalent Classes
#################################################################

:InvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :listsInvoice ; owl:someValuesFrom :Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :isListedInMessage ; owl:someValuesFrom :EDIFACTMessage ]
    )
] .

:InvoiceOrganizationInvolvement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:allValuesFrom :Organization
] .
:InvoiceOrganizationInvolvement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :involvesInvoice ;
    owl:allValuesFrom :Invoice
] .

:InvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRoleType ; owl:someValuesFrom :RoleType ]
    )
] .

:Invoice a owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasInvoiceParticipant ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:intersectionOf (
                :InvoiceParticipant
                [ rdf:type owl:Restriction ;
                  owl:onProperty :isBuyer ;
                  owl:someValuesFrom :Buyer
                ]
            )
        ]
    ] .

:OrganizationDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :displayedForInvolvement ; owl:someValuesFrom :OrganizationInvolvement ]
        [ a owl:Restriction ; owl:onProperty :displayedFieldLabel ; owl:someValuesFrom xsd:string ]
    )
] .

:OrganizationIdentifier owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :identifierValue ; owl:allValuesFrom xsd:string ]
        [ a owl:Restriction ; owl:onProperty :identifierType ; owl:allValuesFrom xsd:string ]
    )
] .

:BuyerAddressAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :buyerAddressAssignmentHasBuyer ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :buyerAddressAssignmentHasAddress ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
:BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :buyerAddressAssignmentHasBuyer ; owl:someValuesFrom :Buyer ]
        [ rdf:type owl:Restriction ; owl:onProperty :buyerAddressAssignmentHasAddress ; owl:someValuesFrom :Address ]
    )
] .

:Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:allValuesFrom :InvoiceLine
] .

:InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Item
] .

:ItemSaleDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasItem ;
          owl:someValuesFrom :Item ]
        [ a owl:Restriction ;
          owl:onProperty :hasSale ;
          owl:someValuesFrom :Sale ]
        [ a owl:Restriction ;
          owl:onProperty :displaysAttribute ;
          owl:someValuesFrom :ItemAttribute ]
    )
] .

:InvoiceNetPrice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceReference ; owl:someValuesFrom :Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNetPriceValue ; owl:someValuesFrom xsd:decimal ]
    )
] .

:InvoiceItemNetPrice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceItemReference ; owl:someValuesFrom :InvoiceItem ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :NetPrice ]
    )
] .

:InvoiceDetail owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasLineItem ;
          owl:someValuesFrom :InvoiceLineItem
        ]
    )
] .

:Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceDetail ;
          owl:allValuesFrom :InvoiceDetail
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasIssuer ;
          owl:allValuesFrom :InvoiceIssuer
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasRecipient ;
          owl:allValuesFrom :InvoiceRecipient
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :invoiceDate ;
          owl:allValuesFrom xsd:date
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :totalAmount ;
          owl:allValuesFrom xsd:decimal
        ]
    )
] .

:InvoiceLineItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :refersToItem ;
          owl:someValuesFrom :Item
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :lineItemQuantity ;
          owl:allValuesFrom xsd:integer
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :lineItemUnitPrice ;
          owl:allValuesFrom xsd:decimal
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :lineItemTotal ;
          owl:allValuesFrom xsd:decimal
        ]
    )
] .

:Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceAmount ;
    owl:allValuesFrom :InvoiceAmount
] .

:InvoiceAmount owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :amountValue ;
    owl:allValuesFrom xsd:decimal
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasCurrency ;
    owl:allValuesFrom :Currency
] .

:InvoiceIdentifier owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceNumber ;
    owl:allValuesFrom xsd:string
] .

:ValidFileFormatSpecification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :FileFormat
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasRequiredField ;
          owl:allValuesFrom [ rdf:type owl:Class ;
                              owl:intersectionOf (
                                  :FieldDefinition
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasDataType ;
                                    owl:someValuesFrom :DataType ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasFieldConstraint ;
                                    owl:someValuesFrom :FieldConstraint ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasPresenceRequirement ;
                                    owl:someValuesFrom :FieldPresenceRequirement ]
                              ) ] ]
    )
] .

:Assignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
        ]
        [ a owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
        ]
    )
] .

#################################################################
# Disjointness & Disjoint Union
#################################################################

:EDIFACTMessage owl:disjointWith :Invoice .
:EDIFACTDocument owl:disjointUnionOf ( :EDIFACTMessage ) .
:Invoice owl:disjointWith :Organization , :InvoiceRole , :RoleType , :InvoiceOrganizationInvolvement , :InvoiceIdentifier, :InvoiceAmount, :AmountValue, :Currency, :Assignment .
:Organization owl:disjointWith :InvoiceRole , :RoleType , :InvoiceOrganizationInvolvement .
:InvoiceRole owl:disjointWith :RoleType , :InvoiceOrganizationInvolvement .
:InvoiceOrganizationInvolvement owl:disjointWith :RoleType .
:InvoiceParticipant owl:disjointWith :Invoice .
:Buyer owl:disjointWith :Seller , :Address .
:Product owl:disjointWith :Service .
:Invoice owl:disjointWith :Item , :InvoiceLine .
:InvoiceLine owl:disjointWith :Invoice .
:NetPrice owl:disjointWith :GrossPrice .
:InvoiceNetPrice owl:disjointWith :InvoiceItemNetPrice .
:Product owl:disjointWith :Service .
:InvoiceIssuer owl:disjointWith :InvoiceRecipient .
:Invoice owl:disjointWith :InvoiceAmount , :AmountValue , :Currency .
:InvoiceAmount owl:disjointWith :Currency .
:FileFormat owl:disjointWith :FieldDefinition, :FieldConstraint, :DataType, :ValidationRequirement .
:FieldDefinition owl:disjointWith :FieldConstraint, :DataType, :ValidationRequirement .
:FieldConstraint owl:disjointWith :DataType, :ValidationRequirement .
:DataType owl:disjointWith :ValidationRequirement .
:OrganizationType owl:disjointWith :OrganizationRole , :ContactInformation , :OrganizationIdentifier , :OrganizationDescription .
:OrganizationRole owl:disjointWith :ContactInformation , :OrganizationIdentifier , :OrganizationDescription .
:ContactInformation owl:disjointWith :OrganizationIdentifier , :OrganizationDescription .
:OrganizationIdentifier owl:disjointWith :OrganizationDescription .
:BusinessProcess owl:disjointWith :Invoice, :Document, :Assignment .
:Document owl:disjointWith :Assignment .

:ItemAttribute owl:disjointUnionOf (
    :ItemName
    :ItemPrice
    :ItemDescription
    :ItemImage
    :ItemCategory
    :ItemQuantity
) .

#################################################################
# General Class Axioms
#################################################################

[ rdf:type owl:Restriction ;
  owl:onProperty :hasInvoiceListing ;
  owl:someValuesFrom :InvoiceListing ;
  rdfs:subClassOf :EDIFACTMessage
] .

:Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :isInvoiceOfAssignment ;
    owl:someValuesFrom :Assignment
] .

#################################################################
# Unconnected Classes Connected (P04)
#################################################################

:Constraint rdfs:subClassOf :ValidationRequirement .
:AmountValue rdfs:subClassOf :Entity .
:Document rdfs:subClassOf :Entity .
:ThingSold rdfs:subClassOf :Entity .
:FileComponent rdfs:subClassOf :Entity .
:Price rdfs:subClassOf :Entity .
:ValidationRequirement rdfs:subClassOf :Entity .
:BusinessEntity rdfs:subClassOf :Entity .
:Customer rdfs:subClassOf :Entity .

#################################################################
# End of Ontology
#################################################################