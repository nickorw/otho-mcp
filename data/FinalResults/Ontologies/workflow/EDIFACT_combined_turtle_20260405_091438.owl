@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Entity rdf:type owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A general entity in the system, superclass for other entities."@en ;
    rdfs:subClassOf owl:Thing .

:Document rdf:type owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:comment "A document, such as an invoice or message."@en ;
    rdfs:subClassOf :Entity .

:EDIFACTDocument rdf:type owl:Class ;
    rdfs:subClassOf :Document ;
    rdfs:label "EDIFACT Document"@en ;
    rdfs:comment "A document in EDIFACT format."@en .

:EDIFACTMessage rdf:type owl:Class ;
    rdfs:subClassOf :EDIFACTDocument ;
    rdfs:label "EDIFACT Message"@en ;
    rdfs:comment "An EDIFACT message."@en .

:Invoice rdf:type owl:Class ;
    rdfs:subClassOf :Document ;
    rdfs:label "Invoice"@en ;
    rdfs:comment "A commercial document issued by a seller to a buyer, relating to a sale transaction."@en .

:InvoiceListing rdf:type owl:Class ;
    rdfs:label "Invoice Listing"@en ;
    rdfs:comment "A listing of invoices, e.g., in an EDIFACT message."@en .

:InvoiceOrganizationInvolvement rdf:type owl:Class ;
    rdfs:label "Invoice-Organization Involvement"@en ;
    rdfs:comment "A reification/pivot class that links an invoice with organizations involved in it."@en .

:InvoiceRole rdf:type owl:Class ;
    rdfs:label "Invoice Role"@en ;
    rdfs:comment "A reification class that connects an Organization, an Invoice, and the Role the Organization plays in the Invoice."@en .

:RoleType rdf:type owl:Class ;
    rdfs:label "Role Type"@en ;
    rdfs:comment "Represents the type of role an organization can play in an invoice (e.g., issuer, recipient, payer)."@en .

:InvoiceParticipant rdf:type owl:Class ;
    rdfs:label "Invoice Participant"@en ;
    rdfs:comment "Superclass for entities participating in an invoice."@en .

:Organization rdf:type owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An entity such as a company, NGO, government body, etc."@en ;
    rdfs:subClassOf :InvoiceParticipant .

:BusinessEntity rdf:type owl:Class ;
    rdfs:label "Business Entity"@en ;
    rdfs:comment "A business entity."@en ;
    rdfs:subClassOf :Entity .

:OrganizationType rdf:type owl:Class ;
    rdfs:label "Organization Type"@en ;
    rdfs:comment "The type or category of the organization (e.g., company, government, NGO)."@en .

:ContactInformation rdf:type owl:Class ;
    rdfs:label "Contact Information"@en ;
    rdfs:comment "Contact details for an organization (address, phone, email, etc.)."@en ;
    rdfs:subClassOf :Location, :OrganizationDisplayInfo .

:Location rdf:type owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "Physical or postal location associated with an organization."@en .

:OrganizationInvolvement rdf:type owl:Class ;
    rdfs:label "Organization Involvement"@en ;
    rdfs:comment "Pivot class to represent the specific involvement of an organization in an event or context, possibly including role, time, and other details."@en .

:OrganizationRole rdf:type owl:Class ;
    rdfs:label "Organization Role"@en ;
    rdfs:comment "The role an organization plays in a given context (e.g., sponsor, partner, organizer)."@en .

:OrganizationIdentifier rdf:type owl:Class ;
    rdfs:label "Organization Identifier"@en ;
    rdfs:comment "Identifiers such as registration number, tax ID, etc."@en ;
    rdfs:subClassOf :OrganizationDisplayInfo .

:OrganizationDescription rdf:type owl:Class ;
    rdfs:label "Organization Description"@en ;
    rdfs:comment "A textual description or summary of the organization."@en ;
    rdfs:subClassOf :OrganizationDisplayInfo .

:OrganizationDisplayInfo rdf:type owl:Class ;
    rdfs:label "Organization Display Info"@en ;
    rdfs:comment "Reification class capturing all information displayed about an organization as per the story or system interface."@en .

:Buyer rdf:type owl:Class ;
    rdfs:subClassOf :Organization, :Person ;
    rdfs:label "Buyer"@en ;
    rdfs:comment "An organization or person who buys items."@en .

:Seller rdf:type owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Seller"@en ;
    rdfs:comment "An organization that sells items."@en .

:Person rdf:type owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person entity."@en .

:Address rdf:type owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Address"@en ;
    rdfs:comment "An address entity."@en .

:BuyerAddressAssignment rdf:type owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Buyer Address Assignment"@en ;
    rdfs:comment "Assignment of an address to a buyer."@en .

:Item rdf:type owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "An entity that is sold in the system."@en ;
    rdfs:subClassOf :Entity .

:Product rdf:type owl:Class ;
    rdfs:subClassOf :Item ;
    rdfs:label "Product"@en ;
    rdfs:comment "A product item."@en .

:Service rdf:type owl:Class ;
    rdfs:subClassOf :Item ;
    rdfs:label "Service"@en ;
    rdfs:comment "A service item."@en .

:InvoiceLine rdf:type owl:Class ;
    rdfs:subClassOf :ThingSold ;
    rdfs:label "Invoice Line"@en ;
    rdfs:comment "A line in an invoice."@en .

:ThingSold rdf:type owl:Class ;
    rdfs:label "Thing Sold"@en ;
    rdfs:comment "A thing that is sold (superclass for items, services, etc.)."@en ;
    rdfs:subClassOf :Item, :Entity .

:Sale rdf:type owl:Class ;
    rdfs:label "Sale"@en ;
    rdfs:comment "A transaction or event of selling items."@en .

:ItemSaleDisplay rdf:type owl:Class ;
    rdfs:label "Item Sale Display"@en ;
    rdfs:comment "A reification class to represent the information displayed about items sold in a sale."@en .

:ItemAttribute rdf:type owl:Class ;
    rdfs:label "Item Attribute"@en ;
    rdfs:comment "Superclass for item attributes displayed."@en .

:ItemName rdf:type owl:Class ;
    rdfs:subClassOf :ItemAttribute ;
    rdfs:label "Item Name"@en ;
    rdfs:comment "The name of the item."@en .

:ItemPrice rdf:type owl:Class ;
    rdfs:subClassOf :ItemAttribute ;
    rdfs:label "Item Price"@en ;
    rdfs:comment "The price of the item."@en .

:ItemDescription rdf:type owl:Class ;
    rdfs:subClassOf :ItemAttribute ;
    rdfs:label "Item Description"@en ;
    rdfs:comment "The description of the item."@en .

:ItemImage rdf:type owl:Class ;
    rdfs:subClassOf :ItemAttribute ;
    rdfs:label "Item Image"@en ;
    rdfs:comment "The image of the item."@en .

:ItemCategory rdf:type owl:Class ;
    rdfs:subClassOf :ItemAttribute ;
    rdfs:label "Item Category"@en ;
    rdfs:comment "The category of the item."@en .

:ItemQuantity rdf:type owl:Class ;
    rdfs:subClassOf :ItemAttribute ;
    rdfs:label "Item Quantity"@en ;
    rdfs:comment "The quantity of the item sold."@en .

:DisplayFormat rdf:type owl:Class ;
    rdfs:label "Display Format"@en ;
    rdfs:comment "The format in which item information is displayed."@en .

:InvoiceItem rdf:type owl:Class ;
    rdfs:label "Invoice Item"@en ;
    rdfs:comment "An item in an invoice."@en .

:Price rdf:type owl:Class ;
    rdfs:label "Price"@en ;
    rdfs:comment "A price value."@en ;
    rdfs:subClassOf :Entity .

:NetPrice rdf:type owl:Class ;
    rdfs:subClassOf :Price ;
    rdfs:label "Net Price"@en ;
    rdfs:comment "Net price value."@en .

:GrossPrice rdf:type owl:Class ;
    rdfs:subClassOf :Price ;
    rdfs:label "Gross Price"@en ;
    rdfs:comment "Gross price value."@en .

:Tax rdf:type owl:Class ;
    rdfs:label "Tax"@en ;
    rdfs:comment "A tax applied to an invoice or item."@en .

:Currency rdf:type owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Currency"@en ;
    rdfs:comment "A currency."@en ;
    rdfs:subClassOf :Entity .

:InvoiceItemNetPrice rdf:type owl:Class ;
    rdfs:label "Invoice Item Net Price"@en ;
    rdfs:comment "Net price for an invoice item."@en .

:InvoiceNetPrice rdf:type owl:Class ;
    rdfs:label "Invoice Net Price"@en ;
    rdfs:comment "Net price for an invoice."@en .

:InvoiceDetail rdf:type owl:Class ;
    rdfs:label "Invoice Detail"@en ;
    rdfs:comment "Details of an invoice."@en .

:Customer rdf:type owl:Class ;
    rdfs:label "Customer"@en ;
    rdfs:comment "A customer."@en ;
    rdfs:subClassOf :Entity .

:InvoiceIssuer rdf:type owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Invoice Issuer"@en ;
    rdfs:comment "The issuer of the invoice."@en .

:InvoiceRecipient rdf:type owl:Class ;
    rdfs:subClassOf :Customer ;
    rdfs:label "Invoice Recipient"@en ;
    rdfs:comment "The recipient of the invoice."@en .

:InvoiceLineItem rdf:type owl:Class ;
    rdfs:label "Invoice Line Item"@en ;
    rdfs:comment "A line item in an invoice."@en .

:AmountValue rdf:type owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Amount Value"@en ;
    rdfs:comment "A value representing an amount."@en ;
    rdfs:subClassOf :Entity .

:InvoiceAmount rdf:type owl:Class ;
    rdfs:subClassOf :AmountValue ;
    rdfs:label "Invoice Amount"@en ;
    rdfs:comment "The amount on an invoice."@en .

:InvoiceIdentifier rdf:type owl:Class ;
    rdfs:subClassOf :Document ;
    rdfs:label "Invoice Identifier"@en ;
    rdfs:comment "Identifier for an invoice."@en .

:InvoiceIdentificationEvent rdf:type owl:Class ;
    rdfs:label "Invoice Identification Event"@en ;
    rdfs:comment "An event identifying an invoice."@en .

:FileFormat rdf:type owl:Class ;
    rdfs:label "File Format"@en ;
    rdfs:comment "A file format."@en .

:FileComponent rdf:type owl:Class ;
    rdfs:label "File Component"@en ;
    rdfs:comment "A component of a file format."@en ;
    rdfs:subClassOf :Entity .

:ValidationRequirement rdf:type owl:Class ;
    rdfs:label "Validation Requirement"@en ;
    rdfs:comment "A requirement for validation of a file format or data."@en ;
    rdfs:subClassOf :Entity .

:DataType rdf:type owl:Class ;
    rdfs:label "Data Type"@en ;
    rdfs:comment "A data type for a field."@en .

:Constraint rdf:type owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "A constraint on a field or value."@en ;
    rdfs:subClassOf :ValidationRequirement .

:RequiredField rdf:type owl:Class ;
    rdfs:subClassOf :FieldDefinition ;
    rdfs:label "Required Field"@en ;
    rdfs:comment "A required field in a file format."@en .

:FieldValue rdf:type owl:Class ;
    rdfs:label "Field Value"@en ;
    rdfs:comment "A value for a field."@en .

:FieldDefinition rdf:type owl:Class ;
    rdfs:subClassOf :FileComponent ;
    rdfs:label "Field Definition"@en ;
    rdfs:comment "A definition of a field in a file format."@en .

:FieldConstraint rdf:type owl:Class ;
    rdfs:subClassOf :Constraint ;
    rdfs:label "Field Constraint"@en ;
    rdfs:comment "A constraint on a field."@en .

:FieldPresenceRequirement rdf:type owl:Class ;
    rdfs:subClassOf :Constraint ;
    rdfs:label "Field Presence Requirement"@en ;
    rdfs:comment "A requirement for field presence."@en .

:FieldFormatSpecification rdf:type owl:Class ;
    rdfs:subClassOf :ValidationRequirement ;
    rdfs:label "Field Format Specification"@en ;
    rdfs:comment "Specification for the format of a field."@en .

:FieldValidation rdf:type owl:Class ;
    rdfs:subClassOf :ValidationRequirement ;
    rdfs:label "Field Validation"@en ;
    rdfs:comment "A validation rule for a field."@en .

:ValidFileFormatSpecification rdf:type owl:Class ;
    rdfs:subClassOf :ValidationRequirement ;
    rdfs:label "Valid File Format Specification"@en ;
    rdfs:comment "A specification of a valid file format."@en .

:FileFormatValidationRequirement rdf:type owl:Class ;
    rdfs:label "File Format Validation Requirement"@en ;
    rdfs:comment "A validation requirement for a file format."@en .

:BusinessProcess rdf:type owl:Class ;
    rdfs:label "Business Process"@en ;
    rdfs:comment "A set of related structured activities or tasks performed to achieve a business goal."@en .

:Assignment rdf:type owl:Class ;
    rdfs:label "Assignment"@en ;
    rdfs:comment "A reification class representing the assignment of an invoice to a business process."@en .

#################################################################
# Hierarchies
#################################################################

:ContactInformation rdfs:subClassOf :Location .
:OrganizationIdentifier rdfs:subClassOf :OrganizationDisplayInfo .
:OrganizationType rdfs:subClassOf :OrganizationDisplayInfo .
:OrganizationDescription rdfs:subClassOf :OrganizationDisplayInfo .
:ContactInformation rdfs:subClassOf :OrganizationDisplayInfo .
:Invoice rdfs:subClassOf :Document .
:Product rdfs:subClassOf :Item .
:Service rdfs:subClassOf :Item .
:InvoiceLine rdfs:subClassOf :ThingSold .
:NetPrice rdfs:subClassOf :Price .
:GrossPrice rdfs:subClassOf :Price .
:InvoiceAmount rdfs:subClassOf :AmountValue .
:InvoiceIdentifier rdfs:subClassOf :Document .
:RequiredField rdfs:subClassOf :FieldDefinition .
:FieldConstraint rdfs:subClassOf :Constraint .
:FieldPresenceRequirement rdfs:subClassOf :Constraint .
:FieldFormatSpecification rdfs:subClassOf :ValidationRequirement .
:FieldValidation rdfs:subClassOf :ValidationRequirement .
:ValidFileFormatSpecification rdfs:subClassOf :ValidationRequirement .
:Buyer rdfs:subClassOf :Organization .
:Buyer rdfs:subClassOf :Person .
:InvoiceRole rdfs:subClassOf :InvoiceParticipant .
:Organization rdfs:subClassOf :InvoiceParticipant .
:ThingSold rdfs:subClassOf :Item .

#################################################################
# Object Properties (with explicit inverses, and annotation fixes)
#################################################################

:hasInvoice a owl:ObjectProperty ; rdfs:domain :InvoiceRole ; rdfs:range :Invoice ; rdfs:label "has invoice"@en ; rdfs:comment "Relates an invoice role to the invoice."@en ;
    owl:inverseOf :isInvoiceOfRole .
:isInvoiceOfRole a owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceRole ; rdfs:label "is invoice of role"@en ; rdfs:comment "Inverse of hasInvoice."@en .

:hasOrganization a owl:ObjectProperty ; rdfs:domain :InvoiceRole ; rdfs:range :Organization ; rdfs:label "has organization"@en ; rdfs:comment "Relates an invoice role to the organization."@en ;
    owl:inverseOf :isOrganizationOfRole .
:isOrganizationOfRole a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :InvoiceRole ; rdfs:label "is organization of role"@en ; rdfs:comment "Inverse of hasOrganization."@en .

:hasRoleType a owl:ObjectProperty ; rdfs:domain :InvoiceRole ; rdfs:range :RoleType ; rdfs:label "has role type"@en ; rdfs:comment "Relates an invoice role to the role type."@en ;
    owl:inverseOf :isRoleTypeOfRole .
:isRoleTypeOfRole a owl:ObjectProperty ; rdfs:domain :RoleType ; rdfs:range :InvoiceRole ; rdfs:label "is role type of role"@en ; rdfs:comment "Inverse of hasRoleType."@en .

:listsInvoice rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceListing ; rdfs:range :Invoice ; rdfs:label "lists invoice"@en ; rdfs:comment "Relates an invoice listing to the invoices it lists."@en ;
    owl:inverseOf :isListedBy .
:isListedBy rdf:type owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceListing ; rdfs:label "is listed by"@en ; rdfs:comment "Inverse of listsInvoice."@en .

:participantOrganization a owl:ObjectProperty ; rdfs:domain :InvoiceParticipant ; rdfs:range :Organization ; rdfs:label "participant organization"@en ; rdfs:comment "Relates an invoice participant to an organization."@en ;
    owl:inverseOf :isParticipantOrganizationOf .
:isParticipantOrganizationOf a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :InvoiceParticipant ; rdfs:label "is participant organization of"@en ; rdfs:comment "Inverse of participantOrganization."@en .

:hasInvoiceParticipant a owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceParticipant ; rdfs:label "has invoice participant"@en ; rdfs:comment "Relates an invoice to its participants."@en ;
    owl:inverseOf :isInvoiceParticipantOf .
:isInvoiceParticipantOf a owl:ObjectProperty ; rdfs:domain :InvoiceParticipant ; rdfs:range :Invoice ; rdfs:label "is invoice participant of"@en ; rdfs:comment "Inverse of hasInvoiceParticipant."@en .

:hasInvoiceListing rdf:type owl:ObjectProperty ; rdfs:domain :EDIFACTMessage ; rdfs:range :InvoiceListing ; rdfs:label "has invoice listing"@en ; rdfs:comment "Relates an EDIFACT message to its invoice listing."@en ;
    owl:inverseOf :isListedInMessage .
:isListedInMessage rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceListing ; rdfs:range :EDIFACTMessage ; rdfs:label "is listed in message"@en ; rdfs:comment "Indicates the EDIFACT message in which an invoice listing appears."@en .

:involvesOrganization rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceOrganizationInvolvement ; rdfs:range :Organization ; rdfs:label "involves organization"@en ; rdfs:comment "Relates an invoice-organization involvement to the organization."@en ;
    owl:inverseOf :isInvolvedInInvoice .
:isInvolvedInInvoice rdf:type owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :InvoiceOrganizationInvolvement ; rdfs:label "is involved in invoice involvement"@en ; rdfs:comment "Inverse of involvesOrganization."@en .

:involvesInvoice rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceOrganizationInvolvement ; rdfs:range :Invoice ; rdfs:label "involves invoice"@en ; rdfs:comment "Relates an invoice-organization involvement to the invoice."@en ;
    owl:inverseOf :isInvoiceInvolvementOf .
:isInvoiceInvolvementOf rdf:type owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceOrganizationInvolvement ; rdfs:label "is invoice involvement of"@en ; rdfs:comment "Inverse of involvesInvoice."@en .

:isBuyer a owl:ObjectProperty ; rdfs:domain :InvoiceParticipant ; rdfs:range :Buyer ; rdfs:label "is buyer"@en ; rdfs:comment "Relates an invoice participant to a buyer."@en ;
    owl:inverseOf :isBuyerOfParticipant .
:isBuyerOfParticipant a owl:ObjectProperty ; rdfs:domain :Buyer ; rdfs:range :InvoiceParticipant ; rdfs:label "is buyer of participant"@en ; rdfs:comment "Inverse of isBuyer."@en .

:isSeller a owl:ObjectProperty ; rdfs:domain :InvoiceParticipant ; rdfs:range :Seller ; rdfs:label "is seller"@en ; rdfs:comment "Relates an invoice participant to a seller."@en ;
    owl:inverseOf :isSellerOfParticipant .
:isSellerOfParticipant a owl:ObjectProperty ; rdfs:domain :Seller ; rdfs:range :InvoiceParticipant ; rdfs:label "is seller of participant"@en ; rdfs:comment "Inverse of isSeller."@en .

:hasOrganizationRole a owl:ObjectProperty ; rdfs:domain :OrganizationInvolvement ; rdfs:range :OrganizationRole ; rdfs:label "has organization role"@en ; rdfs:comment "Relates an organization involvement to the organization role."@en ;
    owl:inverseOf :isOrganizationRoleOf .
:isOrganizationRoleOf rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationRole ; rdfs:range :OrganizationInvolvement ; rdfs:label "is organization role of"@en ; rdfs:comment "Inverse of hasOrganizationRole."@en .

:hasContactInformation a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :ContactInformation ; rdfs:label "has contact information"@en ; rdfs:comment "Relates an organization to its contact information."@en ;
    owl:inverseOf :isContactInformationOf .
:isContactInformationOf rdf:type owl:ObjectProperty ; rdfs:domain :ContactInformation ; rdfs:range :Organization ; rdfs:label "is contact information of"@en ; rdfs:comment "Inverse of hasContactInformation."@en .

:hasLocation a owl:ObjectProperty ; rdfs:domain :ContactInformation ; rdfs:range :Location ; rdfs:label "has location"@en ; rdfs:comment "Relates contact information to a location."@en ;
    owl:inverseOf :isLocationOf .
:isLocationOf rdf:type owl:ObjectProperty ; rdfs:domain :Location ; rdfs:range :ContactInformation ; rdfs:label "is location of"@en ; rdfs:comment "Inverse of hasLocation."@en .

:hasOrganizationType a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :OrganizationType ; rdfs:label "has organization type"@en ; rdfs:comment "Relates an organization to its type."@en ;
    owl:inverseOf :isOrganizationTypeOf .
:isOrganizationTypeOf rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationType ; rdfs:range :Organization ; rdfs:label "is organization type of"@en ; rdfs:comment "Inverse of hasOrganizationType."@en .

:hasOrganizationIdentifier a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :OrganizationIdentifier ; rdfs:label "has organization identifier"@en ; rdfs:comment "Relates an organization to its identifier."@en ;
    owl:inverseOf :isOrganizationIdentifierOf .
:isOrganizationIdentifierOf rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationIdentifier ; rdfs:range :Organization ; rdfs:label "is organization identifier of"@en ; rdfs:comment "Inverse of hasOrganizationIdentifier."@en .

:hasOrganizationDescription a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :OrganizationDescription ; rdfs:label "has organization description"@en ; rdfs:comment "Relates an organization to its description."@en ;
    owl:inverseOf :isOrganizationDescriptionOf .
:isOrganizationDescriptionOf rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationDescription ; rdfs:range :Organization ; rdfs:label "is organization description of"@en ; rdfs:comment "Inverse of hasOrganizationDescription."@en .

:hasDisplayInfo a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :OrganizationDisplayInfo ; rdfs:label "has display info"@en ; rdfs:comment "Relates an organization to its display info."@en ;
    owl:inverseOf :isDisplayInfoOf .
:isDisplayInfoOf rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationDisplayInfo ; rdfs:range :Organization ; rdfs:label "is display info of"@en ; rdfs:comment "Inverse of hasDisplayInfo."@en .

:displayedForInvolvement a owl:ObjectProperty ; rdfs:domain :OrganizationDisplayInfo ; rdfs:range :OrganizationInvolvement ; rdfs:label "displayed for involvement"@en ; rdfs:comment "Relates display info to an organization involvement."@en ;
    owl:inverseOf :hasDisplayInfoForInvolvement .
:hasDisplayInfoForInvolvement rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationInvolvement ; rdfs:range :OrganizationDisplayInfo ; rdfs:label "has display info for involvement"@en ; rdfs:comment "Inverse of displayedForInvolvement."@en .

:hasInvoiceLine a owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceLine ; rdfs:label "has invoice line"@en ; rdfs:comment "Relates an invoice to its invoice lines."@en ;
    owl:inverseOf :isInvoiceLineOf .
:isInvoiceLineOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceLine ; rdfs:range :Invoice ; rdfs:label "is invoice line of"@en ; rdfs:comment "Inverse of hasInvoiceLine."@en .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :InvoiceLine ;
    rdfs:range :Item ;
    rdfs:label "refers to item"@en ;
    rdfs:comment "Relates an invoice line to the item it refers to."@en ;
    owl:inverseOf :isItemReferredBy .
:isItemReferredBy rdf:type owl:ObjectProperty ; rdfs:domain :Item ; rdfs:range :InvoiceLine ; rdfs:label "is item referred by"@en ; rdfs:comment "Inverse of refersToItem."@en .

:hasInvoiceItem rdf:type owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceItem ; rdfs:label "has invoice item"@en ; rdfs:comment "Relates an invoice to its invoice items."@en ;
    owl:inverseOf :isInvoiceItemOf .
:isInvoiceItemOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceItem ; rdfs:range :Invoice ; rdfs:label "is invoice item of"@en ; rdfs:comment "Inverse of hasInvoiceItem."@en .

:hasInvoiceItemNetPrice rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceItem ; rdfs:range :InvoiceItemNetPrice ; rdfs:label "has invoice item net price"@en ; rdfs:comment "Relates an invoice item to its net price."@en ;
    owl:inverseOf :isInvoiceItemNetPriceOf .
:isInvoiceItemNetPriceOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceItemNetPrice ; rdfs:range :InvoiceItem ; rdfs:label "is invoice item net price of"@en ; rdfs:comment "Inverse of hasInvoiceItemNetPrice."@en .

:hasInvoiceNetPrice rdf:type owl:ObjectProperty ; rdfs:domain :Invoice ; rdfs:range :InvoiceNetPrice ; rdfs:label "has invoice net price"@en ; rdfs:comment "Relates an invoice to its net price."@en ;
    owl:inverseOf :isInvoiceNetPriceOf .
