#################################################################
# Restrictions, Equivalent Classes, and Disjointness
#################################################################

:Cl_EDIFACTMessageInvoiceListing owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :listsInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_OrganizationInvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRoleType ; owl:someValuesFrom :Cl_RoleType ]
    )
] .

:Cl_InvoiceParty owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :relatedToInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_Buyer owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :buyerAddressAssignment ;
    owl:allValuesFrom :Cl_BuyerAddressAssignment
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_InvoiceItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom :Cl_Quantity ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Cl_Price ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceItem ; owl:someValuesFrom :Cl_InvoiceItem ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom :Cl_InvoiceNumber ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToProduct ; owl:someValuesFrom :Cl_Product ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Cl_NetPrice ]
    )
] .

:Cl_NetPrice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasCurrency ;
    owl:allValuesFrom :Cl_Currency
] .

:Cl_SaleInfo owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :saleInfoForItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasDisplayAttribute ; owl:someValuesFrom :Cl_DisplayAttribute ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasSeller ; owl:someValuesFrom :Cl_Seller ]
    )
] .

:Cl_InvoiceDetailReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceDetail_invoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceDetail_item ; owl:someValuesFrom :Cl_InvoiceItem ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceDetailQuantity ; owl:someValuesFrom xsd:integer ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceDetailUnitPrice ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceDetailTotal ; owl:someValuesFrom xsd:decimal ]
    )
] .

:Cl_InvoiceAmountReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceAmountInvoice ;
          owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceAmount ;
          owl:allValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :orgName ;
    owl:someValuesFrom xsd:string
] .

#################################################################
# Disjointness and Disjoint Unions
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_Supplier owl:disjointWith :Cl_Client .
:Cl_Organization owl:disjointWith :Cl_Invoice , :Cl_InvoiceRole, :Cl_InvoiceParty , :Cl_OrganizationType , :Cl_ContactInfo , :Cl_RoleType .
:Cl_Invoice owl:disjointWith :Cl_InvoiceRole , :Cl_InvoiceParty , :Cl_InvoiceNumber , :Cl_InvoiceAmount , :Cl_InvoiceAmountReification , :Cl_BusinessProcess , :Cl_InvoiceAssignment , :Cl_Customer , :Cl_Product , :Cl_InvoiceItem , :Cl_InvoiceDetailReification , :Cl_Seller , :Cl_Item , :Cl_InvoiceLine .
:Cl_InvoiceRole owl:disjointWith :Cl_InvoiceParty , :Cl_Invoice , :Cl_Organization , :Cl_RoleType .
:Cl_InvoiceParty owl:disjointWith :Cl_Organization , :Cl_Invoice , :Cl_InvoiceRole .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Buyer owl:disjointWith :Cl_Address , :Cl_BuyerAddressAssignment .
:Cl_Address owl:disjointWith :Cl_BuyerAddressAssignment .
:Cl_Product owl:disjointWith :Cl_Service , :Cl_InvoiceItem , :Cl_InvoiceDetailReification , :Cl_Customer .
:Cl_InvoiceLine owl:disjointWith :Cl_Invoice .
:Cl_NetPrice owl:disjointWith :Cl_GrossPrice .
:Cl_Price owl:disjointUnionOf ( :Cl_NetPrice :Cl_GrossPrice ) .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Item owl:disjointWith :Cl_Seller .
:Cl_Price owl:disjointWith :Cl_Description, :Cl_Image, :Cl_StockStatus, :Cl_ProductCategory, :Cl_ContactInfo .
:Cl_Seller owl:disjointWith :Cl_DisplayAttribute .
:Cl_InvoiceDetailReification owl:disjointWith :Cl_Invoice , :Cl_Customer , :Cl_Product , :Cl_InvoiceItem .
:Cl_InvoiceAmount owl:disjointWith :Cl_InvoiceAmountReification , :Cl_Invoice .
:Cl_FileFormat owl:disjointWith :Cl_InformationElement .
:Cl_ValidationInstance owl:disjointWith :Cl_ValidationResult .
:Cl_InvoiceAssignment owl:disjointWith :Cl_Invoice , :Cl_BusinessProcess , :Cl_Document .
:Cl_ContactInfo owl:disjointWith :Cl_Organization .
:Cl_RoleType owl:disjointWith :Cl_Organization .
:Cl_Item owl:disjointUnionOf ( :Cl_Product :Cl_Service ) .

#################################################################
# Subclass and Hierarchy Axioms
#################################################################

:Cl_RequirementType rdfs:subClassOf :Cl_InformationElement .
:Cl_Constraint rdfs:subClassOf :Cl_InformationElement .
:Cl_FileFormatValidityRequirement rdfs:subClassOf :Cl_InformationElement .
:Cl_ValidationInstance rdfs:subClassOf :Cl_InformationElement .
:Cl_ValidationResult rdfs:subClassOf :Cl_InformationElement .
:Cl_Invoice rdfs:subClassOf :Cl_Document , :Cl_FinancialDocument , :Cl_InvoiceEntity .
:Cl_InvoiceLine rdfs:subClassOf :Cl_Item .
:Cl_NetPrice rdfs:subClassOf :Cl_Price , :Cl_MonetaryValue .
:Cl_GrossPrice rdfs:subClassOf :Cl_Price , :Cl_MonetaryValue .
:Cl_Company rdfs:subClassOf :Cl_Organization .
:Cl_Supplier rdfs:subClassOf :Cl_Organization .
:Cl_Client rdfs:subClassOf :Cl_Organization .
:Cl_InvoiceAmount rdfs:subClassOf :Cl_Amount .
:Cl_InvoiceNumber rdfs:subClassOf :Cl_InvoiceIdentifier .
:Cl_ProductCategory rdfs:subClassOf :Cl_DisplayAttribute .
:Cl_Description rdfs:subClassOf :Cl_DisplayAttribute .
:Cl_Image rdfs:subClassOf :Cl_DisplayAttribute .
:Cl_StockStatus rdfs:subClassOf :Cl_DisplayAttribute .
:Cl_ContactInfo rdfs:subClassOf :Cl_DisplayAttribute .
:Cl_InvoiceEntity rdfs:subClassOf :Cl_Entity .
:Cl_Product rdfs:subClassOf :Cl_Item , :Cl_Entity .
:Cl_Service rdfs:subClassOf :Cl_Item .
:Cl_OrganizationType rdfs:subClassOf :Cl_Organization .
:Cl_InvoiceIdentifier rdfs:subClassOf :Cl_Document .
:Cl_Amount rdfs:subClassOf :Cl_Entity .
:Cl_Value rdfs:subClassOf :Cl_Entity .
:Cl_FinancialDocument rdfs:subClassOf :Cl_Document .

#################################################################
# General Class Axioms / Soft Restrictions
#################################################################

[ a owl:Restriction ;
  owl:onProperty :assignedInvoice ;
  owl:someValuesFrom :Cl_Invoice ;
  rdfs:subClassOf :Cl_InvoiceAssignment
] .

[ a owl:Restriction ;
  owl:onProperty :assignedBusinessProcess ;
  owl:someValuesFrom :Cl_BusinessProcess ;
  rdfs:subClassOf :Cl_InvoiceAssignment
] .

[ a owl:Restriction ;
  owl:onProperty :isInformationElementOf ;
  owl:someValuesFrom :Cl_FileFormatValidityRequirement ;
  rdfs:subClassOf :Cl_InformationElement
] .

:Cl_FileFormatValidityRequirement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :requiresInformationElement ;
    owl:someValuesFrom :Cl_InformationElement
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasConstraint ;
    owl:someValuesFrom :Cl_Constraint
] .

:Cl_FileFormat rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasValidityRequirement ;
    owl:someValuesFrom :Cl_FileFormatValidityRequirement
] .

#################################################################
# Naming Convention Harmonization
#################################################################

#################################################################
# End of FestS ontology
#################################################################