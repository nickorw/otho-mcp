@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests>
    a owl:Ontology ;
    rdfs:label "FestS" .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A generic entity, superclass for organizations, persons, items, events, invoices, etc." ;
    rdfs:subClassOf owl:Thing .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document class, supertype for EDIFACT messages and invoices." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "An electronic data interchange message formatted according to the EDIFACT standard." ;
    rdfs:subClassOf :Cl_Document .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, relating to a sale transaction and indicating the products, quantities, and agreed prices for products or services." ;
    rdfs:subClassOf :Cl_Document , :Cl_FinancialDocument , :Cl_InvoiceEntity .

:Cl_EDIFACTMessageInvoiceListing a owl:Class ;
    rdfs:label "EDIFACT Message Invoice Listing" ;
    rdfs:comment "A reification/pivot class representing the inclusion of an Invoice in an EDIFACT Message." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, agency, or institution involved in an event, project, or process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:comment "A category or classification of organization, such as government, NGO, corporation, etc." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Company" ;
    rdfs:comment "A company that may be involved in invoices." .

:Cl_Supplier a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Supplier" ;
    rdfs:comment "A supplier organization involved in invoices." .

:Cl_Client a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Client" ;
    rdfs:comment "A client organization involved in invoices." .

:Cl_ContactInfo a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact details for an organization or seller." ;
    rdfs:subClassOf :Cl_DisplayAttribute .

:Cl_OrganizationInvolvement a owl:Class ;
    rdfs:label "Organization Involvement" ;
    rdfs:comment "A reification class capturing the involvement of an organization in an event, project, or process, and the information displayed about it." .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "A reification class representing the involvement of an organization in an invoice." .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "Role played by an organization or person in an invoice (e.g. buyer, seller)." .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "Role of a buyer in an invoice." .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Seller Role" ;
    rdfs:comment "Role of a seller in an invoice." .

:Cl_InvoiceParty a owl:Class ;
    rdfs:label "Invoice Party Reification" ;
    rdfs:comment "A reification class linking an organization, a role, and an invoice." .

:Cl_OrganizationInvoiceRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Organization Invoice Role" ;
    rdfs:comment "Pivot class for reification: links an Organization, an Invoice, and a RoleType." .

:Cl_RoleType a owl:Class ;
    rdfs:label "Role Type" ;
    rdfs:comment "The kind of role (e.g., buyer, seller, issuer, payer, recipient, etc.) the organization plays in an invoice." .

:Cl_Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in the process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Buyer a owl:Class ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person or organization who buys goods or services." ;
    rdfs:subClassOf :Cl_Person .

:Cl_Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address for a person or organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of an address to a buyer." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item that is sold." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item , :Cl_Entity ;
    rdfs:label "Product" ;
    rdfs:comment "A product that may be sold." .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Service" ;
    rdfs:comment "A service that may be sold." .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "An item listed in an invoice." .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in an invoice, typically representing a product or service." ;
    rdfs:subClassOf :Cl_Item .

:Cl_Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity of an item." .

:Cl_Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A monetary value for an item or service." ;
    rdfs:subClassOf :Cl_MonetaryValue , :Cl_DisplayAttribute .

:Cl_NetPrice a owl:Class ;
    rdfs:label "Net Price" ;
    rdfs:comment "The net price for an item or service." ;
    rdfs:subClassOf :Cl_Price .

:Cl_GrossPrice a owl:Class ;
    rdfs:label "Gross Price" ;
    rdfs:comment "The gross price for an item or service." ;
    rdfs:subClassOf :Cl_Price .

:Cl_MonetaryValue a owl:Class ;
    rdfs:label "Monetary Value" ;
    rdfs:comment "A value representing money." .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "Currency used for the price." .

:Cl_SaleInfo a owl:Class ;
    rdfs:label "SaleInfo" ;
    rdfs:comment "Reified class to capture information displayed about items sold." .

:Cl_ProductCategory a owl:Class ;
    rdfs:label "ProductCategory" ;
    rdfs:comment "Category or type of the item." ;
    rdfs:subClassOf :Cl_DisplayAttribute .

:Cl_Seller a owl:Class ;
    rdfs:label "Seller" ;
    rdfs:comment "Entity selling the item." .

:Cl_Description a owl:Class ;
    rdfs:label "Description" ;
    rdfs:comment "Textual description of an item." ;
    rdfs:subClassOf :Cl_DisplayAttribute .

:Cl_Image a owl:Class ;
    rdfs:label "Image" ;
    rdfs:comment "Image representing the item." ;
    rdfs:subClassOf :Cl_DisplayAttribute .

:Cl_StockStatus a owl:Class ;
    rdfs:label "StockStatus" ;
    rdfs:comment "Availability status of the item." ;
    rdfs:subClassOf :Cl_DisplayAttribute .

:Cl_DisplayAttribute a owl:Class ;
    rdfs:label "DisplayAttribute" ;
    rdfs:comment "General superclass for attributes displayed about an item." .

:Cl_InvoiceNetPriceCalculation a owl:Class ;
    rdfs:label "Invoice Net Price Calculation" ;
    rdfs:comment "A calculation of the net price for an invoice." .

:Cl_InvoiceEntity a owl:Class ;
    rdfs:label "Invoice Entity" ;
    rdfs:comment "A superclass for invoice-related entities." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceDetailReification a owl:Class ;
    rdfs:label "Invoice Detail Reification" ;
    rdfs:comment "A reification class for detailed invoice information." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer involved in an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A monetary amount." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "The amount for an invoice." ;
    rdfs:subClassOf :Cl_Amount .

:Cl_InvoiceAmountReification a owl:Class ;
    rdfs:label "Invoice Amount Reification" ;
    rdfs:comment "A reification class for invoice amounts." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_FinancialDocument a owl:Class ;
    rdfs:label "Financial Document" ;
    rdfs:comment "A document with financial significance." ;
    rdfs:subClassOf :Cl_Document .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "A unique identifier for an invoice." ;
    rdfs:subClassOf :Cl_Document .

:Cl_InvoiceNumber a owl:Class ;
    rdfs:label "Invoice Number" ;
    rdfs:comment "A number identifying an invoice." ;
    rdfs:subClassOf :Cl_InvoiceIdentifier .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format for electronic documents." .

:Cl_InformationElement a owl:Class ;
    rdfs:label "Information Element" ;
    rdfs:comment "A piece of information required in a file format." .

:Cl_FileFormatValidityRequirement a owl:Class ;
    rdfs:label "File Format Validity Requirement" ;
    rdfs:comment "A reification class linking a file format to the information elements and constraints required for its validity." ;
    rdfs:subClassOf :Cl_InformationElement .

:Cl_ValidationInstance a owl:Class ;
    rdfs:label "Validation Instance" ;
    rdfs:comment "An instance of a validation process." ;
    rdfs:subClassOf :Cl_InformationElement .

:Cl_Value a owl:Class ;
    rdfs:label "Value" ;
    rdfs:comment "A value for a property or attribute." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_RequirementType a owl:Class ;
    rdfs:label "Requirement Type" ;
    rdfs:comment "A type of requirement for a file format." ;
    rdfs:subClassOf :Cl_InformationElement .

:Cl_Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint on information elements or validity requirements." ;
    rdfs:subClassOf :Cl_InformationElement .

:Cl_ValidationResult a owl:Class ;
    rdfs:label "Validation Result" ;
    rdfs:comment "A result of a validation process." ;
    rdfs:subClassOf :Cl_InformationElement .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process within the organization." .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:label "Invoice Assignment" ;
    rdfs:comment "A reification class representing the assignment of an invoice to a business process." .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Links an EDIFACT message to its invoice listing reification." ;
    owl:inverseOf :listedInMessage .

:listedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "listed in message" ;
    rdfs:comment "Inverse of hasInvoiceListing, links invoice listing reification to the message." ;
    owl:inverseOf :hasInvoiceListing .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Links the invoice listing reification to the Invoice." ;
    owl:inverseOf :listedByMessageListing .

:listedByMessageListing a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:label "listed by message listing" ;
    rdfs:comment "Inverse of listsInvoice." ;
    owl:inverseOf :listsInvoice .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_InvoiceParticipation :Cl_InvoiceParty :Cl_OrganizationInvolvement ) ] ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links a participation or involvement to an organization." ;
    owl:inverseOf :organizationInvolvedIn .

:organizationInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_InvoiceParticipation :Cl_InvoiceParty :Cl_OrganizationInvolvement ) ] ;
    rdfs:label "organization involved in" ;
    rdfs:comment "Inverse of involvesOrganization." ;
    owl:inverseOf :involvesOrganization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "involves invoice" ;
    rdfs:comment "Links a participation to an invoice." ;
    owl:inverseOf :invoiceInvolvedInParticipation .

:invoiceInvolvedInParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "invoice involved in participation" ;
    rdfs:comment "Inverse of involvesInvoice." ;
    owl:inverseOf :involvesInvoice .

:hasRoleInInvoice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range xsd:string ;
    rdfs:label "has role in invoice" ;
    rdfs:comment "The role played in the invoice." .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "has invoice participation" ;
    rdfs:comment "Links an invoice to its participations." ;
    owl:inverseOf :invoiceParticipationOf ;
    owl:deprecated "true"^^xsd:boolean .

:hasInvoiceParticipationCamelCase a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "hasInvoiceParticipation" ;
    rdfs:comment "Links an invoice to its participations (CamelCase preferred naming)." ;
    owl:inverseOf :invoiceParticipationOfCamelCase .

:invoiceParticipationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice participation of" ;
    rdfs:comment "Inverse of hasInvoiceParticipation." ;
    owl:inverseOf :hasInvoiceParticipation .

:invoiceParticipationOfCamelCase a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoiceParticipationOf" ;
    rdfs:comment "Inverse of hasInvoiceParticipation (CamelCase)." ;
    owl:inverseOf :hasInvoiceParticipationCamelCase .

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "participates in invoice" ;
    rdfs:comment "Links an organization to its invoice participations." ;
    owl:inverseOf :invoiceParticipationByOrganization .

:invoiceParticipationByOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "invoice participation by organization" ;
    rdfs:comment "Inverse of participatesInInvoice." ;
    owl:inverseOf :participatesInInvoice .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" ;
    rdfs:comment "Links a role to an organization." ;
    owl:inverseOf :organizationOfRole .

:organizationOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvoiceRole ;
    rdfs:label "organization of role" ;
    rdfs:comment "Inverse of hasOrganization." ;
    owl:inverseOf :hasOrganization .

:hasInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links a role to an invoice." ;
    owl:inverseOf :invoiceOfRole .

:invoiceOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_OrganizationInvoiceRole ;
    rdfs:label "invoice of role" ;
    rdfs:comment "Inverse of hasInvoice." ;
    owl:inverseOf :hasInvoice .

:hasInvoiceAmountInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice (amount reification)" ;
    rdfs:comment "Links an invoice amount reification to an invoice." ;
    owl:inverseOf :invoiceOfAmountReification .

:invoiceOfAmountReification a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountReification ;
    rdfs:label "invoice of amount reification" ;
    rdfs:comment "Inverse of hasInvoiceAmountInvoice." ;
    owl:inverseOf :hasInvoiceAmountInvoice .

:hasInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "Links an invoice amount reification to an invoice amount." ;
    owl:inverseOf :invoiceAmountOfReification .

:invoiceAmountOfReification a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range :Cl_InvoiceAmountReification ;
    rdfs:label "invoice amount of reification" ;
    rdfs:comment "Inverse of hasInvoiceAmount." ;
    owl:inverseOf :hasInvoiceAmount .

:hasRoleType a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvoiceRole ;
    rdfs:range :Cl_RoleType ;
    rdfs:label "has role type" ;
    rdfs:comment "Links a role to a role type." ;
    owl:inverseOf :roleTypeOfRole .

:roleTypeOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_RoleType ;
    rdfs:range :Cl_OrganizationInvoiceRole ;
    rdfs:label "role type of role" ;
    rdfs:comment "Inverse of hasRoleType." ;
    owl:inverseOf :hasRoleType .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParty ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Links a party reification to an invoice role." ;
    owl:inverseOf :invoiceRoleOfParty .

:invoiceRoleOfParty a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParty ;
    rdfs:label "invoice role of party" ;
    rdfs:comment "Inverse of hasInvoiceRole." ;
    owl:inverseOf :hasInvoiceRole .

:relatedToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParty ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "related to invoice" ;
    rdfs:comment "Links a party reification to an invoice." ;
    owl:inverseOf :invoiceOfParty .

:invoiceOfParty a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParty ;
    rdfs:label "invoice of party" ;
    rdfs:comment "Inverse of relatedToInvoice." ;
    owl:inverseOf :relatedToInvoice .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_Invoice :Cl_BuyerAddressAssignment ) ] ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "has buyer" ;
    rdfs:comment "Links an invoice or assignment to a buyer." ;
    owl:inverseOf :buyerOf .

:buyerOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_Invoice :Cl_BuyerAddressAssignment ) ] ;
    rdfs:label "buyer of" ;
    rdfs:comment "Inverse of hasBuyer." ;
    owl:inverseOf :hasBuyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    rdfs:label "connects the assignment to the address" ;
    rdfs:comment "Links a buyer address assignment to an address." ;
    owl:inverseOf :addressOfAssignment .

:addressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "relates an address to its assignment" ;
    rdfs:comment "Inverse of hasAddress." ;
    owl:inverseOf :hasAddress .

:buyerAddressAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "relates a buyer to their address assignment" ;
    rdfs:comment "Links a buyer to their address assignment." ;
    owl:inverseOf :buyerOfAssignment .

:buyerOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "buyer of assignment" ;
    rdfs:comment "Inverse of buyerAddressAssignment." ;
    owl:inverseOf :buyerAddressAssignment .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "has invoice item" ;
    rdfs:comment "Links an invoice to its items." ;
    owl:inverseOf :invoiceItemOf .

:invoiceItemOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice item of" ;
    rdfs:comment "Inverse of hasInvoiceItem." ;
    owl:inverseOf :hasInvoiceItem .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Item ;
    rdfs:label "refers to item" ;
    rdfs:comment "Links an invoice item to an item." ;
    owl:inverseOf :itemOfInvoiceItem .

:itemOfInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "item of invoice item" ;
    rdfs:comment "Inverse of refersToItem." ;
    owl:inverseOf :refersToItem .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_InvoiceItem :Cl_InvoiceLine ) ] ;
    rdfs:range :Cl_Quantity ;
    rdfs:label "has quantity" ;
    rdfs:comment "Links an invoice item or line to a quantity." ;
    owl:inverseOf :quantityOf .

:quantityOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_InvoiceItem :Cl_InvoiceLine ) ] ;
    rdfs:label "quantity of" ;
    rdfs:comment "Inverse of hasQuantity." ;
    owl:inverseOf :hasQuantity .

:hasPrice a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_InvoiceItem :Cl_SaleInfo ) ] ;
    rdfs:range :Cl_Price ;
    rdfs:label "has price" ;
    rdfs:comment "Links an invoice item or sale info to a price." ;
    owl:inverseOf :priceOf .

:priceOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_InvoiceItem :Cl_SaleInfo ) ] ;
    rdfs:label "price of" ;
    rdfs:comment "Inverse of hasPrice." ;
    owl:inverseOf :hasPrice .

:refersToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product ;
    rdfs:label "refers to product" ;
    rdfs:comment "Links an invoice line to a product." ;
    owl:inverseOf :productOfInvoiceLine .

:productOfInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "product of invoice line" ;
    rdfs:comment "Inverse of refersToProduct." ;
    owl:inverseOf :refersToProduct .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice ;
    rdfs:label "has net price" ;
    rdfs:comment "Links an invoice line to its net price." ;
    owl:inverseOf :netPriceOf .

:netPriceOf a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "net price of" ;
    rdfs:comment "Inverse of hasNetPrice." ;
    owl:inverseOf :hasNetPrice .

:hasGrossPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_GrossPrice ;
    rdfs:label "has gross price" ;
    rdfs:comment "Links an invoice line to its gross price." ;
    owl:inverseOf :grossPriceOf .

:grossPriceOf a owl:ObjectProperty ;
    rdfs:domain :Cl_GrossPrice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "gross price of" ;
    rdfs:comment "Inverse of hasGrossPrice." ;
    owl:inverseOf :hasGrossPrice .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_MonetaryValue :Cl_Price :Cl_InvoiceNetPriceCalculation ) ] ;
    rdfs:range :Cl_Currency ;
    rdfs:label "has currency" ;
    rdfs:comment "Links a monetary value, price, or calculation to a currency." ;
    owl:inverseOf :currencyOf .

:currencyOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Cl_MonetaryValue :Cl_Price :Cl_InvoiceNetPriceCalculation ) ] ;
