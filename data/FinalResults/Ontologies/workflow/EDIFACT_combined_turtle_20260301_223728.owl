@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests>
    a owl:Ontology ;
    rdfs:label "FestS" .

#################################################################
# Core Classes
#################################################################

:Cl_Document a owl:Class ;
    rdfs:label "Document" .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, indicating products, quantities, and agreed prices." ;
    rdfs:subClassOf :Cl_Document .

:Cl_BusinessMessage a owl:Class ;
    rdfs:label "Business Message" .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured EDI message conforming to the EDIFACT standard." ;
    rdfs:subClassOf :Cl_BusinessMessage .

:Cl_InvoiceListing a owl:Class ;
    rdfs:label "Invoice Listing" ;
    rdfs:comment "A reification class to relate an EDIFACT message to one or more invoices, capturing the listing event." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Supplier a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_InvoiceOrganizationInvolvement a owl:Class .

:Cl_OrganizationRole a owl:Class .

:Cl_SupplierRole a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationRole .

:Cl_CustomerRole a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationRole .

:Cl_InvoiceParticipant a owl:Class ;
    rdfs:label "Invoice Participant" ;
    rdfs:comment "A reification/pivot class linking an Organization to an Invoice with a specific Role." .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" .

:Cl_Seller a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_BuyerRole a owl:Class ;
    rdfs:label "Buyer Role" ;
    rdfs:subClassOf :Cl_InvoiceParticipation .

:Cl_Buyer a owl:Class .

:Cl_Issuer a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_Recipient a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" .

:Cl_SellerRole a owl:Class ;
    rdfs:label "Seller Role" ;
    rdfs:subClassOf :Cl_InvoiceParticipation .

:Cl_InvolvedOrganization a owl:Class ;
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Involved Organization" .

:Cl_OrganizationDisplayInfo a owl:Class ;
    rdfs:label "Organization Display Information" .

:Cl_OrganizationName a owl:Class ;
    rdfs:label "Organization Name" ;
    rdfs:subClassOf :Cl_OrganizationDisplayInfo .

:Cl_OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:subClassOf :Cl_OrganizationDisplayInfo .

:Cl_OrganizationContactInfo a owl:Class ;
    rdfs:label "Organization Contact Information" ;
    rdfs:subClassOf :Cl_OrganizationDisplayInfo .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:subClassOf :Cl_OrganizationDisplayInfo .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:subClassOf :Cl_OrganizationDisplayInfo .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:subClassOf :Cl_OrganizationDisplayInfo .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process in the organization." .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment (Reification)" ;
    rdfs:comment "A reification class capturing the assignment of an invoice to a business process." .

#################################################################
# Invoice Number Assignment
#################################################################

:Cl_InvoiceIdentifier a owl:Class .

:Cl_InvoiceNumberAssignment a owl:Class .

#################################################################
# Invoice Amount Reification
#################################################################

:Cl_InvoiceAmount a owl:Class .

:Cl_InvoiceAmountReification a owl:Class .

#################################################################
# Invoice Line, Item, Product, Service, Price, Quantity
#################################################################

:Cl_InvoiceDetail a owl:Class .

:Cl_InvoiceLine a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceDetail .

:Cl_Item a owl:Class ;
    rdfs:label "Item" .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_Amount a owl:Class .

:Cl_Quantity a owl:Class .

:Cl_UnitPrice a owl:Class .

:Cl_NetPrice a owl:Class ;
    rdfs:subClassOf :Cl_Amount .

:Cl_InvoiceLineNetPrice a owl:Class .

:Cl_MonetaryValue a owl:Class .

:Cl_Price a owl:Class .

:Cl_Currency a owl:Class .

:Cl_Date a owl:Class .

:Cl_InvoiceStatus a owl:Class .

#################################################################
# Item Display Information
#################################################################

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" .

:Cl_ItemDisplayInfo a owl:Class ;
    rdfs:label "Item Display Information" .

:Cl_ItemAttribute a owl:Class ;
    rdfs:label "Item Attribute" .

:Cl_TextualAttribute a owl:Class ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_NumericAttribute a owl:Class ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_DisplayAttribute a owl:Class ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemName a owl:Class ;
    rdfs:subClassOf :Cl_TextualAttribute , :Cl_DisplayAttribute .

:Cl_ItemDescription a owl:Class ;
    rdfs:subClassOf :Cl_TextualAttribute , :Cl_DisplayAttribute .

:Cl_ItemPrice a owl:Class ;
    rdfs:subClassOf :Cl_NumericAttribute , :Cl_DisplayAttribute .

:Cl_ItemImage a owl:Class ;
    rdfs:subClassOf :Cl_DisplayAttribute .

#################################################################
# File Format Validation and Requirements
#################################################################

:Cl_FileFormat a owl:Class .

:Cl_FileFormatSpecification a owl:Class .

:Cl_Requirement a owl:Class .

:Cl_RequiredElement a owl:Class ;
    rdfs:subClassOf :Cl_Requirement .

:Cl_ValidationRule a owl:Class ;
    rdfs:subClassOf :Cl_Requirement .

:Cl_ElementValueConstraint a owl:Class ;
    rdfs:subClassOf :Cl_Requirement .

:Cl_ValidationInformation a owl:Class .

:Cl_ValidationContext a owl:Class .

:Cl_FileFormatValidation a owl:Class .

#################################################################
# Address and Buyer Address Assignment
#################################################################

:Cl_Actor a owl:Class .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Actor .

:Cl_Address a owl:Class .

:Cl_BuyerAddressAssignment a owl:Class .

#################################################################
# Hierarchies & Unions & Disjointness
#################################################################

:Cl_Invoice owl:disjointWith :Cl_InvoiceIdentifier , :Cl_InvoiceNumberAssignment , :Cl_InvoiceAmount , :Cl_InvoiceAmountReification , :Cl_InvoiceLine , :Cl_BusinessProcess , :Cl_Assignment , :Cl_InvoiceDetail .
:Cl_InvoiceIdentifier owl:disjointWith :Cl_InvoiceNumberAssignment .
:Cl_InvoiceAmount owl:disjointWith :Cl_InvoiceAmountReification .
:Cl_InvoiceLine owl:disjointWith :Cl_InvoiceAmount , :Cl_InvoiceAmountReification , :Cl_Item .
:Cl_Item owl:disjointWith :Cl_Invoice , :Cl_InvoiceLine .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Customer owl:disjointWith :Cl_Supplier .
:Cl_Company owl:disjointWith :Cl_Supplier , :Cl_Customer .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_SupplierRole owl:disjointWith :Cl_CustomerRole .
:Cl_Organization owl:disjointWith :Cl_Invoice , :Cl_InvoiceRole .
:Cl_Invoice owl:disjointWith :Cl_InvoiceRole .
:Cl_InvoiceParticipant owl:disjointWith :Cl_InvoiceRole .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Actor owl:disjointWith :Cl_Address .
:Cl_Person owl:disjointWith :Cl_Address .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_OrganizationName owl:disjointWith :Cl_OrganizationType , :Cl_OrganizationContactInfo , :Cl_OrganizationRole , :Cl_OrganizationIdentifier , :Cl_OrganizationLocation , :Cl_OrganizationDescription .
:Cl_OrganizationType owl:disjointWith :Cl_OrganizationContactInfo , :Cl_OrganizationRole , :Cl_OrganizationIdentifier , :Cl_OrganizationLocation , :Cl_OrganizationDescription .
:Cl_OrganizationContactInfo owl:disjointWith :Cl_OrganizationRole , :Cl_OrganizationIdentifier , :Cl_OrganizationLocation , :Cl_OrganizationDescription .
:Cl_OrganizationRole owl:disjointWith :Cl_OrganizationIdentifier , :Cl_OrganizationLocation , :Cl_OrganizationDescription .
:Cl_OrganizationIdentifier owl:disjointWith :Cl_OrganizationLocation , :Cl_OrganizationDescription .
:Cl_OrganizationLocation owl:disjointWith :Cl_OrganizationDescription .
:Cl_FileFormat owl:disjointWith :Cl_FileFormatSpecification , :Cl_RequiredElement , :Cl_ValidationRule , :Cl_ElementValueConstraint , :Cl_ValidationInformation , :Cl_ValidationContext , :Cl_FileFormatValidation , :Cl_Requirement .
:Cl_Requirement owl:disjointWith :Cl_FileFormat , :Cl_FileFormatSpecification , :Cl_ValidationInformation , :Cl_ValidationContext , :Cl_FileFormatValidation .
:Cl_ValidationRule owl:disjointWith :Cl_RequiredElement , :Cl_ElementValueConstraint .
:Cl_BusinessProcess owl:disjointWith :Cl_Invoice , :Cl_Document , :Cl_Assignment .
:Cl_Document owl:disjointWith :Cl_Assignment .

:Cl_Item owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( :Cl_Product :Cl_Service )
] .

:Cl_Requirement owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( :Cl_RequiredElement :Cl_ValidationRule :Cl_ElementValueConstraint )
] .

:Cl_BusinessMessage owl:equivalentClass :Cl_EDIFACTMessage .

#################################################################
# Object Properties
#################################################################

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:refersToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product ;
    rdfs:subPropertyOf :refersToItem .

:refersToService a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Service ;
    rdfs:subPropertyOf :refersToItem .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Quantity .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Amount .

:hasUnitPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_UnitPrice .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPrice .

:hasLineNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_InvoiceLineNetPrice .

:forInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLineNetPrice ;
    rdfs:range :Cl_InvoiceLine .

:hasInvoiceAmountReification a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountReification ;
    owl:inverseOf :reifiesInvoice .

:reifiesInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_Invoice .

:reifiesInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceAmountReification ;
    rdfs:range :Cl_InvoiceAmount .

:hasInvoiceNumberAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumberAssignment .

:assignsInvoiceIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_InvoiceIdentifier .

:issuedTo a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer .

:issuedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Supplier .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail .

:hasInvoiceDate a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Date .

:hasStatus a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceStatus .

:hasLinePrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Price .

:hasLineQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Quantity .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range :Cl_Currency .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipant .

:hasParticipantParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

:participantOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipant ;
    rdfs:range :Cl_Organization .

:participantOrganizationParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:participantRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipant ;
    rdfs:range :Cl_InvoiceRole .

:participationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceParticipation .

:buyerInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :isBuyerOfInvoice .

:isBuyerOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Invoice .

:isParticipantIn a owl:ObjectProperty ;
    owl:inverseOf :hasParticipant ;
    rdfs:domain :Cl_InvoiceParticipant ;
    rdfs:range :Cl_Invoice .

:isRoleOfParticipant a owl:ObjectProperty ;
    owl:inverseOf :participantRole ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParticipant .

:isOrganizationOfParticipant a owl:ObjectProperty ;
    owl:inverseOf :participantOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipant .

:hasInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement .

:organizationInvolvementOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Invoice .

:involvedOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Organization .

:involvementRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_OrganizationRole .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Organization ;
    rdfs:subPropertyOf :relatesTo .

:relatesTo a owl:ObjectProperty .

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Invoice .

:hasInvoiceListing a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing" .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    owl:inverseOf :isListedByListing .

:isListedByListing a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceListing .

:listedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "listed in message" ;
    owl:inverseOf :hasInvoiceListing .

:hasOrganizationDisplayInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_InvolvedOrganization ;
    rdfs:range :Cl_OrganizationDisplayInfo .

:displayedOrganizationName a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationName .

:displayedOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationType .

:displayedOrganizationContactInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationContactInfo .

:displayedOrganizationRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationRole .

:displayedOrganizationIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationIdentifier .

:displayedOrganizationLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationLocation .

:displayedOrganizationDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplayInfo ;
    rdfs:range :Cl_OrganizationDescription .

:itemHasDisplayInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemDisplayInfo .

:displayInfoOfItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Item ;
    owl:inverseOf :itemHasDisplayInfo .

:displayInfoHasAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_DisplayAttribute .

:displayedInSale a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Sale .

:itemPriceCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range :Cl_Currency .

:hasFileFormatSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatSpecification .

:specifiesRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_Requirement .

:hasRequiredElement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_RequiredElement ;
    rdfs:subPropertyOf :specifiesRequirement .

:hasValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_ValidationRule ;
    rdfs:subPropertyOf :specifiesRequirement .

:hasElementValueConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredElement ;
    rdfs:range :Cl_ElementValueConstraint ;
    rdfs:subPropertyOf :specifiesRequirement .

:validatesFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range :Cl_FileFormat .

:usesValidationInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range :Cl_ValidationInformation .

:inValidationContext a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range :Cl_ValidationContext .

:fulfillsRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationInformation ;
    rdfs:range :Cl_Requirement .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_Invoice .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_BusinessProcess .

:hasAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Assignment ;
    owl:inverseOf :assignedInvoice .

:processAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Assignment ;
    owl:inverseOf :assignedBusinessProcess .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :isBuyerOf .

:isBuyerOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:inverseOf :isAddressOfAssignment .

:isAddressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment .

#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:invoiceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string .

:invoiceAmountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal .

:invoiceAmountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string .

:invoiceTotalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal .

:lineAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:priceAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range xsd:decimal .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:decimal .

:unitPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_UnitPrice ;
    rdfs:range xsd:decimal .

:netPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal .

:lineNetPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLineNetPrice ;
    rdfs:range xsd:decimal .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

:invoiceDateValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Date ;
    rdfs:range xsd:date .

:statusValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceStatus ;
    rdfs:range xsd:string .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:supplierName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Supplier ;
    rdfs:range xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:serviceName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Service ;
    rdfs:range xsd:string .

:messageIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string .

:listingTimestamp a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range xsd:dateTime .

:organizationNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationName ;
    rdfs:range xsd:string .

:organizationTypeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string .

:organizationContactValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string .

:organizationRoleValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string .

:organizationIdentifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string .

:organizationLocationValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string .

:organizationDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range xsd:string .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemName ;
    rdfs:range xsd:string .

:itemDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemDescription ;
    rdfs:range xsd:string .

:itemPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:anyURI .

:displayAttributeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayAttribute ;
    rdfs:range xsd:string .

:elementName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredElement ;
    rdfs:range xsd:string .

:elementType a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredElement ;
    rdfs:range xsd:string .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ElementValueConstraint ;
    rdfs:range xsd:string .

:validationRuleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range xsd:string .

:requirementDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Requirement ;
    rdfs:range xsd:string .

:contextDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationContext ;
    rdfs:range xsd:string .

:validationInformationDetail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationInformation ;
    rdfs:range xsd:string .

:specificationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range xsd:string .

:fileFormatName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range xsd:string .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime .

:street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

#################################################################
# Restrictions & General Class Axioms
#################################################################

:Cl_EDIFACTMessage owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceListing ;
        owl:allValuesFrom :Cl_InvoiceListing
    ]
] .

:Cl_InvoiceListing owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :listsInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :listedInMessage ; owl:allValuesFrom :Cl_EDIFACTMessage ]
    )
] .

:Cl_InvoiceOrganizationInvolvement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :involvedOrganization ;
    owl:allValuesFrom :Cl_Organization
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvolvement ; owl:someValuesFrom :Cl_InvoiceOrganizationInvolvement ]
        [ a owl:Restriction ; owl:onProperty :hasParticipant ; owl:someValuesFrom :Cl_InvoiceParticipant ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
        [ a owl:Restriction ; owl:onProperty :issuedTo ; owl:allValuesFrom :Cl_Customer ]
        [ a owl:Restriction ; owl:onProperty :issuedBy ; owl:allValuesFrom :Cl_Supplier ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceDate ; owl:allValuesFrom :Cl_Date ]
    )
] .

:Cl_InvoiceParticipant owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :participantOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :participantRole ; owl:someValuesFrom :Cl_InvoiceRole ]
        [ a owl:Restriction ; owl:onProperty :isParticipantIn ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :participantOrganizationParticipation ; owl:allValuesFrom :Cl_Organization ]
    )
] .

:Cl_BuyerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceParticipation
        [ a owl:Restriction ;
          owl:onProperty :participantOrganizationParticipation ;
          owl:allValuesFrom :Cl_Organization
        ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:allValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasLinePrice ; owl:allValuesFrom :Cl_Price ]
        [ a owl:Restriction ; owl:onProperty :hasLineQuantity ; owl:allValuesFrom :Cl_Quantity ]
    )
] .

:Cl_InvoiceAmount owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :invoiceAmountValue ;
    owl:someValuesFrom xsd:decimal
] .

:Cl_InvoiceNumberAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignsInvoiceIdentifier ;
    owl:allValuesFrom :Cl_InvoiceIdentifier
] .

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceNumberAssignment ;
    owl:someValuesFrom :Cl_InvoiceNumberAssignment
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasInvoiceAmountReification ;
    owl:someValuesFrom :Cl_InvoiceAmountReification
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasAssignment ;
    owl:allValuesFrom :Cl_Assignment
] .

:Cl_InvoiceLine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasQuantity ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasUnitPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasLineNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_InvoiceLineNetPrice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :forInvoiceLine ;
    owl:allValuesFrom :Cl_InvoiceLine
] .

:Cl_OrganizationDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationName ; owl:allValuesFrom :Cl_OrganizationName ]
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationType ; owl:allValuesFrom :Cl_OrganizationType ]
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationContactInfo ; owl:allValuesFrom :Cl_OrganizationContactInfo ]
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationRole ; owl:allValuesFrom :Cl_OrganizationRole ]
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationIdentifier ; owl:allValuesFrom :Cl_OrganizationIdentifier ]
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationLocation ; owl:allValuesFrom :Cl_OrganizationLocation ]
        [ a owl:Restriction ; owl:onProperty :displayedOrganizationDescription ; owl:allValuesFrom :Cl_OrganizationDescription ]
    )
] .

:Cl_ItemDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :displayInfoOfItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :displayInfoHasAttribute ; owl:someValuesFrom :Cl_DisplayAttribute ]
    )
] .

:Cl_DisplayAttribute owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( :Cl_ItemName :Cl_ItemDescription :Cl_ItemPrice :Cl_ItemImage )
] .

:Cl_FileFormatSpecification owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasRequiredElement ; owl:someValuesFrom :Cl_RequiredElement ]
        [ a owl:Restriction ; owl:onProperty :hasValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
    )
] .

:Cl_ValidationInformation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :fulfillsRequirement ; owl:someValuesFrom :Cl_Requirement ]
    )
] .

:Cl_FileFormatValidation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :validatesFileFormat ;
    owl:someValuesFrom :Cl_FileFormat
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :usesValidationInformation ;
    owl:someValuesFrom :Cl_ValidationInformation
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :inValidationContext ;
    owl:someValuesFrom :Cl_ValidationContext
] .

:Cl_Buyer owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :isBuyerOf ;
    owl:allValuesFrom :Cl_BuyerAddressAssignment
] .

:Cl_Address owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :isAddressOfAssignment ;
    owl:allValuesFrom :Cl_BuyerAddressAssignment
] .

:Cl_Assignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :assignedInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

#################################################################
# End of Ontology
#################################################################
