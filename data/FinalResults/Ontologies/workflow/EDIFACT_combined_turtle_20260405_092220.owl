    rdfs:label "line total amount" ;
    rdfs:comment "Total amount on the invoice line." .

:invoiceTotalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal ;
    rdfs:label "invoice total amount" ;
    rdfs:comment "Total amount of the invoice." .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Date ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" ;
    rdfs:comment "Date of the invoice." .

:statusLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceStatus ;
    rdfs:range xsd:string ;
    rdfs:label "status label" ;
    rdfs:comment "Label for the invoice status." .

:invoiceNumberValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value" ;
    rdfs:comment "Value of the invoice number." ;
    a owl:FunctionalProperty .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string ;
    rdfs:label "amount currency" ;
    rdfs:comment "Currency of the invoice amount." .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "Date of the assignment." .

:businessProcessName a owl:DatatypeProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range xsd:string ;
    rdfs:label "business process name" ;
    rdfs:comment "Name of the business process." .

:requirementDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "requirement description" ;
    rdfs:comment "Description of the file format requirement." .

:propertyName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatProperty ;
    rdfs:range xsd:string ;
    rdfs:label "property name" ;
    rdfs:comment "Name of the file format property." .

:propertyValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatProperty ;
    rdfs:range xsd:string ;
    rdfs:label "property value" ;
    rdfs:comment "Value of the file format property." .

:validationRule a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationInformation ;
    rdfs:range xsd:string ;
    rdfs:label "validation rule" ;
    rdfs:comment "Validation rule." .

:validationStatus a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range xsd:boolean ;
    rdfs:label "validation status" ;
    rdfs:comment "Status of the validation." .

:validationDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatValidation ;
    rdfs:range xsd:dateTime ;
    rdfs:label "validation date" ;
    rdfs:comment "Date of validation." .

#################################################################
# Restrictions and General Class Axioms
#################################################################

:Cl_InvoiceListing owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :listsInvoice ;
          owl:someValuesFrom :Cl_Invoice
        ]
    )
] .

:Cl_EDIFACTMessage owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceListing ;
          owl:someValuesFrom :Cl_InvoiceListing
        ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasParticipant ;
          owl:someValuesFrom :Cl_Entity ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceParticipation ;
          owl:allValuesFrom :Cl_InvoiceParticipation ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceDetail ;
          owl:allValuesFrom :Cl_InvoiceDetail ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasAssignment ;
          owl:allValuesFrom :Cl_Assignment ]
    )
] .

:Cl_InvoiceRoleAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :Cl_InvoiceRole ]
        [ rdf:type owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoicePartyAssociation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_OrganizationInformationDisplay owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :org_infoAboutOrganization ;
    owl:allValuesFrom :Cl_Organization
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :org_involvesOrganization ;
    owl:someValuesFrom :Cl_Organization
] .

:Cl_BuyerAddressAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
            [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
        )
    ] .

:Cl_InvoiceItem owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Item
] .

:Cl_ItemDisplayInformation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :aboutItem ;
          owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ;
          owl:onProperty :hasAttribute ;
          owl:someValuesFrom :Cl_ItemAttribute ]
    )
] .

:Cl_NetPrice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Price
        [ rdf:type owl:Restriction ;
          owl:onProperty :isNetPrice ;
          owl:hasValue "true"^^xsd:boolean
        ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :lineProduct ; owl:someValuesFrom :Cl_Product ]
        [ rdf:type owl:Restriction ; owl:onProperty :lineQuantity ; owl:someValuesFrom xsd:decimal ]
    )
] .

:Cl_Amount owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :invoiceCurrency ;
          owl:someValuesFrom :Cl_Currency ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :forInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceAmount ;
          owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceIdentification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :identifiesInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceIdentifier ;
          owl:someValuesFrom :Cl_InvoiceIdentifier ]
    )
] .

:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_FileFormat owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasSpecification ;
          owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:intersectionOf (
              :Cl_FileFormatSpecification
              [ rdf:type owl:Restriction ;
                owl:onProperty :hasRequirement ;
                owl:someValuesFrom [
                  rdf:type owl:Class ;
                  owl:intersectionOf (
                    :Cl_FileFormatRequirement
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasValidationInformation ;
                      owl:someValuesFrom :Cl_ValidationInformation
                    ]
                  )
                ]
              ]
            )
          ]
        ]
    )
] .

#################################################################
# General Class Axioms
#################################################################

:Cl_EDIFACTMessage rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceListing ;
    owl:someValuesFrom :Cl_InvoiceListing
] .

:Cl_InvoiceListing rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :listsInvoice ;
    owl:someValuesFrom :Cl_Invoice
] .

:Cl_InvoiceRoleAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :assignedOrganization ;
    owl:someValuesFrom :Cl_Organization
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :assignedRole ;
    owl:someValuesFrom :Cl_InvoiceRole
] .

:Cl_Buyer rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isBuyerOf ;
    owl:someValuesFrom :Cl_BuyerAddressAssignment
] .

:Cl_Address rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isAddressOf ;
    owl:someValuesFrom :Cl_BuyerAddressAssignment
] .

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:someValuesFrom :Cl_Amount
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :issuedDate ;
    owl:someValuesFrom :Cl_Date
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceStatus ;
    owl:someValuesFrom :Cl_InvoiceStatus
] .

:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:someValuesFrom :Cl_NetPrice
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasQuantity ;
    owl:someValuesFrom :Cl_Quantity
] .

#################################################################
# Individuals (Examples)
#################################################################

:Supplier a :Cl_InvoiceRole ;
    rdfs:label "Supplier" ;
    rdfs:comment "A supplier role." .

:Customer a :Cl_InvoiceRole ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer role." .

:Payer a :Cl_InvoiceRole ;
    rdfs:label "Payer" ;
    rdfs:comment "A payer role." .

:Recipient a :Cl_InvoiceRole ;
    rdfs:label "Recipient" ;
    rdfs:comment "A recipient role." .
