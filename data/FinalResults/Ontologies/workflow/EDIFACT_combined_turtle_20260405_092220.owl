    rdfs:range xsd:string ;
    rdfs:label "message identifier" ;
    rdfs:comment "The unique identifier of the EDIFACT message." .

:messageDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:date ;
    rdfs:label "message date" ;
    rdfs:comment "The date the EDIFACT message was created or sent." .

