@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests> a owl:Ontology ;
    rdfs:label "FestS" .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "Superclass for all document types." ;
    rdfs:subClassOf owl:Thing,
        [ a owl:Restriction ;
          owl:onProperty :hasDocumentDate ;
          owl:someValuesFrom :Cl_Date
        ] .

:Cl_FinancialDocument a owl:Class ;
    rdfs:label "Financial Document" ;
    rdfs:comment "A superclass for documents related to financial transactions." ;
    rdfs:subClassOf :Cl_Document .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message formatted according to the EDIFACT standard." ;
    rdfs:subClassOf :Cl_Document .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, relating to a sale transaction and indicating the products, quantities, and agreed prices." ;
    rdfs:subClassOf :Cl_FinancialDocument, :Cl_Entity .

:Cl_InvoiceListing a owl:Class ;
    rdfs:label "Invoice Listing" ;
    rdfs:comment "A reification class representing the listing of invoices within an EDIFACT message." .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Pivot class to model participation of organizations (and/or persons) in an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRoleAssignment a owl:Class ;
    rdfs:label "Invoice Role Assignment" ;
    rdfs:comment "A reification/pivot class representing the assignment of a specific role to an organization in the context of a particular invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A role that an organization can play in relation to an invoice (e.g., supplier, customer, payer, recipient)." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "Superclass for all entities in the invoice ontology." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity such as a company, supplier, or customer involved in the invoice process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "A company organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_NGO a owl:Class ;
    rdfs:label "NGO" ;
    rdfs:comment "A non-governmental organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_GovernmentAgency a owl:Class ;
    rdfs:label "Government Agency" ;
    rdfs:comment "A government agency organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_OrganizationInvolvement a owl:Class ;
    rdfs:label "Organization Involvement" ;
    rdfs:comment "Reification class for involvement context." .

:Cl_OrganizationInformationDisplay a owl:Class ;
    rdfs:label "Organization Information Display" ;
    rdfs:comment "Reification class for displayed info." .

:Cl_Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual involved in the invoice process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Buyer a owl:Class ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person or organization that purchases goods or services." ;
    rdfs:subClassOf :Cl_Person .

:Cl_Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address." .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "An assignment of a buyer to an address." .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An entity representing an item that is sold." .

:Cl_ItemDisplayInformation a owl:Class ;
    rdfs:label "Item Display Information" ;
    rdfs:comment "A reification class representing the information displayed about an item that is sold." .

:Cl_ItemAttribute a owl:Class ;
    rdfs:label "Item Attribute" ;
    rdfs:comment "A superclass for specific attributes of an item." ;
    rdfs:subClassOf owl:Thing .

:Cl_ItemName a owl:Class ;
    rdfs:label "Item Name" ;
    rdfs:comment "The name of an item." ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemPrice a owl:Class ;
    rdfs:label "Item Price" ;
    rdfs:comment "The price of an item." ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemDescription a owl:Class ;
    rdfs:label "Item Description" ;
    rdfs:comment "The description of an item." ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemImage a owl:Class ;
    rdfs:label "Item Image" ;
    rdfs:comment "An image of an item." ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemCategory a owl:Class ;
    rdfs:label "Item Category" ;
    rdfs:comment "A category for an item." ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemStockQuantity a owl:Class ;
    rdfs:label "Item Stock Quantity" ;
    rdfs:comment "Stock quantity for an item." ;
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" ;
    rdfs:comment "A transaction involving the sale of an item." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "A record of an item in an invoice." ;
    rdfs:subClassOf owl:Thing .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item in an invoice." ;
    rdfs:subClassOf :Cl_Amount, :Cl_InvoiceDetail, owl:Thing .

:Cl_Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value." ;
    rdfs:subClassOf owl:Thing .

:Cl_NetPrice a owl:Class ;
    rdfs:label "Net Price" ;
    rdfs:comment "A net price value." ;
    rdfs:subClassOf :Cl_Price .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A superclass for monetary amounts." ;
    rdfs:subClassOf owl:Thing, :Cl_InvoiceDetail .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "The monetary value associated with an invoice." ;
    rdfs:subClassOf :Cl_Amount .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:label "Invoice Amount Assignment" ;
    rdfs:comment "A reification class linking an invoice to its amount." .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "A currency in which amounts are expressed." ;
    rdfs:subClassOf :Cl_InvoiceDetail .

:Cl_Date a owl:Class ;
    rdfs:label "Date" ;
    rdfs:comment "A calendar date." ;
    rdfs:subClassOf :Cl_InvoiceDetail .

:Cl_InvoiceStatus a owl:Class ;
    rdfs:label "Invoice Status" ;
    rdfs:comment "The status of an invoice." ;
    rdfs:subClassOf :Cl_InvoiceDetail .

:Cl_DocumentIdentifier a owl:Class ;
    rdfs:label "Document Identifier" ;
    rdfs:comment "An identifier for a document." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "An identifier for an invoice." ;
    rdfs:subClassOf :Cl_DocumentIdentifier .

:Cl_InvoiceIdentification a owl:Class ;
    rdfs:label "Invoice Identification" ;
    rdfs:comment "Pivot class to relate an Invoice to its Identifier (invoice number)" .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process within an organization." .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment" ;
    rdfs:comment "A reification class representing the assignment of an invoice to a business process." .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format specification." .

:Cl_FileFormatSpecification a owl:Class ;
    rdfs:label "File Format Specification" ;
    rdfs:comment "A specification for a file format." ;
    rdfs:subClassOf :Cl_FileFormat .

:Cl_FileFormatRequirement a owl:Class ;
    rdfs:label "File Format Requirement" ;
    rdfs:comment "A requirement for a file format." ;
    rdfs:subClassOf :Cl_FileFormatComponent .

:Cl_FileFormatProperty a owl:Class ;
    rdfs:label "File Format Property" ;
    rdfs:comment "A property of a file format." ;
    rdfs:subClassOf :Cl_FileFormatComponent .

:Cl_ValidationInformation a owl:Class ;
    rdfs:label "Validation Information" ;
    rdfs:comment "Validation information for a file format." ;
    rdfs:subClassOf :Cl_FileFormatComponent .

:Cl_FileFormatValidation a owl:Class ;
    rdfs:label "File Format Validation" ;
    rdfs:comment "A validation performed on a file format." .

:Cl_FileFormatRequirementValidation a owl:Class ;
    rdfs:label "File Format Requirement Validation" ;
    rdfs:comment "Validation of a file format requirement." .

:Cl_FileFormatComponent a owl:Class ;
    rdfs:label "File Format Component" ;
    rdfs:comment "A component of a file format." ;
    rdfs:subClassOf :Cl_FileFormat .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "A detail of an invoice." ;
    rdfs:subClassOf :Cl_Invoice .

:Cl_Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity value." .

:Cl_Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A product being sold." .

:Cl_Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer entity." .

#################################################################
# Class Hierarchies
#################################################################

:Cl_Organization rdfs:subClassOf :Cl_Entity .
:Cl_Invoice rdfs:subClassOf :Cl_Entity .
:Cl_InvoiceParticipation rdfs:subClassOf :Cl_Entity .
:Cl_InvoiceRoleAssignment rdfs:subClassOf :Cl_Entity .
:Cl_InvoiceRole rdfs:subClassOf :Cl_Entity .
:Cl_Person rdfs:subClassOf :Cl_Entity .
:Cl_Buyer rdfs:subClassOf :Cl_Person .
:Cl_Company rdfs:subClassOf :Cl_Organization .
:Cl_NGO rdfs:subClassOf :Cl_Organization .
:Cl_GovernmentAgency rdfs:subClassOf :Cl_Organization .
:Cl_InvoiceDetail rdfs:subClassOf :Cl_Invoice .
:Cl_InvoiceLine rdfs:subClassOf :Cl_Amount, :Cl_InvoiceDetail, owl:Thing .
:Cl_Amount rdfs:subClassOf :Cl_InvoiceDetail, owl:Thing .
:Cl_Currency rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_Date rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_InvoiceStatus rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_Price rdfs:subClassOf owl:Thing .
:Cl_NetPrice rdfs:subClassOf :Cl_Price .
:Cl_Invoice rdfs:subClassOf owl:Thing .
:Cl_Item rdfs:subClassOf owl:Thing .
:Cl_InvoicePartyAssociation a owl:Class ;
    rdfs:label "Invoice Party Association" ;
    rdfs:comment "A class representing the association between an invoice and a party." ;
    rdfs:subClassOf owl:Thing .

:Cl_BuyerRole a owl:Class ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "Role of a buyer in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_SellerRole a owl:Class ;
    rdfs:label "Seller Role" ;
    rdfs:comment "Role of a seller in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceRole .

#################################################################
# Disjointness and Disjoint Unions
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_Invoice owl:disjointWith :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_InvoiceIdentifier, :Cl_InvoiceDetail, :Cl_BusinessProcess, :Cl_Assignment, :Cl_Item, :Cl_Organization, :Cl_InvoicePartyAssociation, :Cl_InvoiceRoleAssignment, :Cl_InvoiceRole, :Cl_InvoiceListing, :Cl_InvoiceItem, :Cl_InvoiceLine, :Cl_Amount .
:Cl_Organization owl:disjointWith :Cl_Person, :Cl_Invoice, :Cl_InvoiceRoleAssignment, :Cl_Customer, :Cl_InvoiceDetail .
:Cl_Organization owl:disjointWith :Cl_InvoiceRole .
:Cl_Company owl:disjointWith :Cl_NGO, :Cl_GovernmentAgency .
:Cl_NGO owl:disjointWith :Cl_GovernmentAgency .
:Cl_InvoiceRole owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_InvoiceRoleAssignment .
:Cl_InvoiceRoleAssignment owl:disjointWith :Cl_Invoice, :Cl_Organization, :Cl_InvoiceRole .
:Cl_InvoiceListing owl:disjointWith :Cl_Invoice .
:Cl_Invoice owl:disjointWith :Cl_InvoiceItem, :Cl_Item, :Cl_InvoiceLine .
:Cl_InvoiceItem owl:disjointWith :Cl_Item, :Cl_InvoiceLine .
:Cl_ItemName owl:disjointWith :Cl_ItemPrice, :Cl_ItemDescription, :Cl_ItemImage, :Cl_ItemCategory, :Cl_ItemStockQuantity .
:Cl_ItemPrice owl:disjointWith :Cl_ItemDescription, :Cl_ItemImage, :Cl_ItemCategory, :Cl_ItemStockQuantity .
:Cl_ItemDescription owl:disjointWith :Cl_ItemImage, :Cl_ItemCategory, :Cl_ItemStockQuantity .
:Cl_ItemImage owl:disjointWith :Cl_ItemCategory, :Cl_ItemStockQuantity .
:Cl_ItemCategory owl:disjointWith :Cl_ItemStockQuantity .
:Cl_ItemAttribute owl:disjointUnionOf ( :Cl_ItemName :Cl_ItemPrice :Cl_ItemDescription :Cl_ItemImage :Cl_ItemCategory :Cl_ItemStockQuantity ) .
:Cl_Buyer owl:disjointWith :Cl_BuyerAddressAssignment, :Cl_Address .
:Cl_Address owl:disjointWith :Cl_BuyerAddressAssignment .
:Cl_Product owl:disjointWith :Cl_Customer, :Cl_Organization, :Cl_Invoice, :Cl_InvoiceDetail .
:Cl_Customer owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_InvoiceDetail .
:Cl_Invoice owl:disjointWith :Cl_DocumentIdentifier .
:Cl_InvoiceIdentifier owl:disjointWith :Cl_Invoice, :Cl_Document .
:Cl_FileFormatProperty owl:disjointWith :Cl_FileFormatRequirement, :Cl_ValidationInformation .
:Cl_FileFormatRequirement owl:disjointWith :Cl_ValidationInformation .
:Cl_FileFormat owl:disjointWith :Cl_FileFormatRequirementValidation .
:Cl_FileFormatSpecification owl:disjointWith :Cl_FileFormatRequirementValidation .
:Cl_FileFormatComponent owl:disjointUnionOf ( :Cl_FileFormatProperty :Cl_FileFormatRequirement :Cl_ValidationInformation ) .
:Cl_NetPrice owl:disjointWith :Cl_Amount .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Links an EDIFACT message to its invoice listing (reification node)." ;
    owl:inverseOf :hasEDIFACTMessage .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Links an invoice listing to an invoice that is listed in an EDIFACT message." ;
    owl:inverseOf :isListedInInvoiceListing .

:isListedInInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "is listed in invoice listing" ;
    rdfs:comment "Invoice is listed in an invoice listing." ;
    owl:inverseOf :listsInvoice .

:hasEDIFACTMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "has EDIFACT message" ;
    rdfs:comment "Inverse property to hasInvoiceListing." ;
    owl:inverseOf :hasInvoiceListing .

:participationInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "participation in invoice" ;
    rdfs:comment "Relates an InvoiceParticipation to the Invoice." ;
    owl:inverseOf :hasInvoiceParticipation .

:participatingOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "participating organization" ;
    rdfs:comment "The organization participating in the invoice." ;
    owl:inverseOf :organizationParticipation .

:organizationParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "organization participation" ;
    rdfs:comment "Inverse property to participatingOrganization." ;
    owl:inverseOf :participatingOrganization .

:participatingPerson a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Person ;
    rdfs:label "participating person" ;
    rdfs:comment "The person participating in the invoice." ;
    owl:inverseOf :personParticipation .

:personParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Person ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "person participation" ;
    rdfs:comment "Inverse property to participatingPerson." ;
    owl:inverseOf :participatingPerson .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "has invoice participation" ;
    rdfs:comment "Relates an invoice to its participations." ;
    owl:inverseOf :participationInInvoice .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Entity ;
    rdfs:label "has participant" ;
    rdfs:comment "Relates an InvoiceParticipation to an Entity." ;
    owl:inverseOf :isParticipantIn .

:isParticipantIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Entity ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is participant in" ;
    rdfs:comment "Inverse property to hasParticipant." ;
    owl:inverseOf :hasParticipant .

:hasInvoiceRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "has invoice role assignment" ;
    rdfs:comment "Connects an invoice to its role assignments (pivot class)." ;
    owl:inverseOf :isRoleAssignmentOf .

:assignedOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Organization ;
    rdfs:label "assigned organization" ;
    rdfs:comment "Connects a role assignment to the organization playing the role." ;
    owl:inverseOf :isOrganizationOfAssignment .

:assignedRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "assigned role" ;
    rdfs:comment "Connects a role assignment to the invoice role." ;
    owl:inverseOf :isRoleOfAssignment .

:inInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "in invoice" ;
    rdfs:comment "Indicates which invoice the role assignment is related to." ;
    owl:inverseOf :isAssignmentInInvoice .

:isRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is role assignment of" ;
    rdfs:comment "Inverse property to hasInvoiceRoleAssignment." ;
    owl:inverseOf :hasInvoiceRoleAssignment .

:isOrganizationOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "is organization of assignment" ;
    rdfs:comment "Inverse property to assignedOrganization." ;
    owl:inverseOf :assignedOrganization .

:isRoleOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "is role of assignment" ;
    rdfs:comment "Inverse property to assignedRole." ;
    owl:inverseOf :assignedRole .

:isAssignmentInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "is assignment in invoice" ;
    rdfs:comment "Inverse property to inInvoice." ;
    owl:inverseOf :inInvoice .

:hasInvoicePartyAssociation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoicePartyAssociation ;
    rdfs:label "has invoice party association" ;
    rdfs:comment "Associates an invoice with a party association." ;
    owl:inverseOf :isPartyAssociationOfInvoice .

:isPartyAssociationOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssociation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is party association of invoice" ;
    rdfs:comment "Invoice party association is associated with an invoice." ;
    owl:inverseOf :hasInvoicePartyAssociation .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssociation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "The organization involved in the invoice party association." ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoicePartyAssociation ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Inverse property to involvesOrganization." ;
    owl:inverseOf :involvesOrganization .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssociation ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "The invoice role in the association." ;
    owl:inverseOf :isInvoiceRoleInAssociation .

:isInvoiceRoleInAssociation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssociation ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "is invoice role in association" ;
    rdfs:comment "Inverse property to hasInvoiceRole." ;
    owl:inverseOf :hasInvoiceRole .

:org_involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Organization ;
    rdfs:label "org involves organization" ;
    rdfs:comment "Organization involvement involves an organization." ;
    owl:inverseOf :org_hasInvolvement .

:org_hasInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvolvement ;
    rdfs:label "organization has involvement" ;
    rdfs:comment "Organization has an involvement context." ;
    owl:inverseOf :org_involvesOrganization .

:org_displayedInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_OrganizationInformationDisplay ;
    rdfs:label "org displayed information" ;
    rdfs:comment "Displayed information for organization involvement." ;
    owl:inverseOf :org_isDisplayedInformationOf .

:org_isDisplayedInformationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplay ;
    rdfs:range :Cl_OrganizationInvolvement ;
    rdfs:label "is displayed information for" ;
    rdfs:comment "Organization information display is for an involvement context." ;
    owl:inverseOf :org_displayedInformation .

:org_infoAboutOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformationDisplay ;
    rdfs:range :Cl_Organization ;
    rdfs:label "org info about organization" ;
    rdfs:comment "Information display is about an organization." ;
    owl:inverseOf :org_hasInformationDisplay .

:org_hasInformationDisplay a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInformationDisplay ;
    rdfs:label "org has information display" ;
    rdfs:comment "Organization has an information display." ;
    owl:inverseOf :org_infoAboutOrganization .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "has buyer" ;
    rdfs:comment "Assignment has a buyer." ;
    owl:inverseOf :isBuyerOf .

:isBuyerOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "is buyer of" ;
    rdfs:comment "Buyer is assigned in a buyer address assignment." ;
    owl:inverseOf :hasBuyer .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    rdfs:label "has address" ;
    rdfs:comment "Assignment has an address." ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "is address of" ;
    rdfs:comment "Address is assigned in a buyer address assignment." ;
    owl:inverseOf :hasAddress .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:label "has invoice item" ;
    rdfs:comment "Connects an invoice to its invoice-item record." ;
    owl:inverseOf :isInvoiceItemOf .

:isInvoiceItemOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice ;
