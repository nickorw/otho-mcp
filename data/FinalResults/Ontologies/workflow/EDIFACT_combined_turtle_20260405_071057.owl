#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ; rdfs:domain :Cl_Invoice ; rdfs:range xsd:string ; rdfs:label "invoice number" ;
  rdfs:comment "The invoice number as a string." .
:invoiceDate a owl:DatatypeProperty ; rdfs:domain :Cl_Invoice ; rdfs:range xsd:date ; rdfs:label "invoice date" ;
  rdfs:comment "The date of the invoice." .
:invoiceAmount a owl:DatatypeProperty ; rdfs:domain :Cl_Invoice ; rdfs:range xsd:decimal ; rdfs:label "invoice amount" ;
  rdfs:comment "The total amount of the invoice as a decimal." .
:organizationRole a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceParticipation ; rdfs:range xsd:string ;
  rdfs:label "organization role" ;
  rdfs:comment "The role of the organization in the invoice." .
:roleDescription a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationInvoiceRole ; rdfs:range xsd:string ;
  rdfs:label "role description" ;
  rdfs:comment "A description of the organization's role in the invoice." .
:quantity a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceItemEntry ; rdfs:range xsd:integer ;
  rdfs:label "quantity" ;
  rdfs:comment "The quantity in the invoice item entry." .
:unitPrice a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceItemEntry ; rdfs:range xsd:decimal ;
  rdfs:label "unit price" ;
  rdfs:comment "The unit price in the invoice item entry." .
:totalPrice a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceItemEntry ; rdfs:range xsd:decimal ;
  rdfs:label "total price" ;
  rdfs:comment "The total price in the invoice item entry." .
:itemName a owl:DatatypeProperty ; rdfs:domain :Cl_Item ; rdfs:range xsd:string ;
  rdfs:label "item name" ;
  rdfs:comment "The name of the item." .
:itemCode a owl:DatatypeProperty ; rdfs:domain :Cl_Item ; rdfs:range xsd:string ;
  rdfs:label "item code" ;
  rdfs:comment "The code of the item." .
:categoryLabel a owl:DatatypeProperty ; rdfs:domain :Cl_Category ; rdfs:range xsd:string ;
  rdfs:label "category label" ;
  rdfs:comment "The label of the category." .
:priceValue a owl:DatatypeProperty ; rdfs:domain :Cl_Price ; rdfs:range xsd:decimal ;
  rdfs:label "price value" ;
  rdfs:comment "The value of the price." .
:currency a owl:DatatypeProperty ; rdfs:domain :Cl_Price ; rdfs:range xsd:string ;
  rdfs:label "currency" ;
  rdfs:comment "The currency of the price." .
:descriptionText a owl:DatatypeProperty ; rdfs:domain :Cl_Description ; rdfs:range xsd:string ;
  rdfs:label "description text" ;
  rdfs:comment "The text of the description." .
:nameText a owl:DatatypeProperty ; rdfs:domain :Cl_Name ; rdfs:range xsd:string ;
  rdfs:label "name text" ;
  rdfs:comment "The text of the name." .
:imageURL a owl:DatatypeProperty ; rdfs:domain :Cl_Image ; rdfs:range xsd:anyURI ;
  rdfs:label "image URL" ;
  rdfs:comment "The URL of the image." .
:quantityValue a owl:DatatypeProperty ; rdfs:domain :Cl_Quantity ; rdfs:range xsd:decimal ;
  rdfs:label "quantity value" ;
  rdfs:comment "The value of the quantity." .
:currencyCode a owl:DatatypeProperty ; rdfs:domain :Cl_Currency ; rdfs:range xsd:string ;
  rdfs:label "currency code" ;
  rdfs:comment "The code of the currency." .
:invoiceTotalAmount a owl:DatatypeProperty ; rdfs:domain :Cl_Invoice ; rdfs:range xsd:decimal ;
  rdfs:label "invoice total amount" ;
  rdfs:comment "The total amount of the invoice." .
:invoiceDetailDescription a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceDetail ; rdfs:range xsd:string ;
  rdfs:label "invoice detail description" ;
  rdfs:comment "The description of the invoice detail." .
:lineItemQuantity a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceLineItem ; rdfs:range xsd:integer ;
  rdfs:label "line item quantity" ;
  rdfs:comment "The quantity in the invoice line item." .
:lineItemUnitPrice a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceLineItem ; rdfs:range xsd:decimal ;
  rdfs:label "line item unit price" ;
  rdfs:comment "The unit price in the invoice line item." .
:lineItemTotalPrice a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceLineItem ; rdfs:range xsd:decimal ;
  rdfs:label "line item total price" ;
  rdfs:comment "The total price in the invoice line item." .
:productName a owl:DatatypeProperty ; rdfs:domain :Cl_Product ; rdfs:range xsd:string ;
  rdfs:label "product name" ;
  rdfs:comment "The name of the product." .
:productCode a owl:DatatypeProperty ; rdfs:domain :Cl_Product ; rdfs:range xsd:string ;
  rdfs:label "product code" ;
  rdfs:comment "The code of the product." .
:customerName a owl:DatatypeProperty ; rdfs:domain :Cl_Customer ; rdfs:range xsd:string ;
  rdfs:label "customer name" ;
  rdfs:comment "The name of the customer." .
:customerAddress a owl:DatatypeProperty ; rdfs:domain :Cl_Customer ; rdfs:range xsd:string ;
  rdfs:label "customer address" ;
  rdfs:comment "The address of the customer." .
:sellerName a owl:DatatypeProperty ; rdfs:domain :Cl_Seller ; rdfs:range xsd:string ;
  rdfs:label "seller name" ;
  rdfs:comment "The name of the seller." .
:sellerAddress a owl:DatatypeProperty ; rdfs:domain :Cl_Seller ; rdfs:range xsd:string ;
  rdfs:label "seller address" ;
  rdfs:comment "The address of the seller." .
:addressLine a owl:DatatypeProperty ; rdfs:domain :Cl_Address ; rdfs:range xsd:string ;
  rdfs:label "address line" ;
  rdfs:comment "The address line." .
:city a owl:DatatypeProperty ; rdfs:domain :Cl_Address ; rdfs:range xsd:string ;
  rdfs:label "city" ;
  rdfs:comment "The city of the address." .
:postalCode a owl:DatatypeProperty ; rdfs:domain :Cl_Address ; rdfs:range xsd:string ;
  rdfs:label "postal code" ;
  rdfs:comment "The postal code of the address." .
:country a owl:DatatypeProperty ; rdfs:domain :Cl_Address ; rdfs:range xsd:string ;
  rdfs:label "country" ;
  rdfs:comment "The country of the address." .
:organizationNameValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationName ; rdfs:range xsd:string ;
  rdfs:label "organization name value" ;
  rdfs:comment "The value of the organization's name." .
:organizationTypeValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationType ; rdfs:range xsd:string ;
  rdfs:label "organization type value" ;
  rdfs:comment "The value of the organization's type." .
:organizationAddressValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationAddress ; rdfs:range xsd:string ;
  rdfs:label "organization address value" ;
  rdfs:comment "The value of the organization's address." .
:organizationContactValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationContact ; rdfs:range xsd:string ;
  rdfs:label "organization contact value" ;
  rdfs:comment "The value of the organization's contact." .
:organizationDescriptionValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationDescription ; rdfs:range xsd:string ;
  rdfs:label "organization description value" ;
  rdfs:comment "The value of the organization's description." .
:organizationWebsiteValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationWebsite ; rdfs:range xsd:anyURI ;
  rdfs:label "organization website value" ;
  rdfs:comment "The value of the organization's website." .
:organizationIdentifierValue a owl:DatatypeProperty ; rdfs:domain :Cl_OrganizationIdentifier ; rdfs:range xsd:string ;
  rdfs:label "organization identifier value" ;
  rdfs:comment "The value of the organization's identifier." .
:fieldName a owl:DatatypeProperty ; rdfs:domain :Cl_Field ; rdfs:range xsd:string ;
  rdfs:label "field name" ;
  rdfs:comment "The name of the field." .
:datatypeName a owl:DatatypeProperty ; rdfs:domain :Cl_DataType ; rdfs:range xsd:string ;
  rdfs:label "datatype name" ;
  rdfs:comment "The name of the data type." .
:constraintDescription a owl:DatatypeProperty ; rdfs:domain :Cl_Constraint ; rdfs:range xsd:string ;
  rdfs:label "constraint description" ;
  rdfs:comment "The description of the constraint." .
:requirementDescription a owl:DatatypeProperty ; rdfs:domain :Cl_RequirementType ; rdfs:range xsd:string ;
  rdfs:label "requirement description" ;
  rdfs:comment "The description of the requirement type." .
:validationRuleDescription a owl:DatatypeProperty ; rdfs:domain :Cl_ValidationRule ; rdfs:range xsd:string ;
  rdfs:label "validation rule description" ;
  rdfs:comment "The description of the validation rule." .
:formatName a owl:DatatypeProperty ; rdfs:domain :Cl_FileFormat ; rdfs:range xsd:string ;
  rdfs:label "format name" ;
  rdfs:comment "The name of the file format." .
:assignmentDate a owl:DatatypeProperty ; rdfs:domain :Cl_Assignment ; rdfs:range xsd:dateTime ;
  rdfs:label "assignment date" ;
  rdfs:comment "The date of the assignment." .
:invoiceAmount_value a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceAmount ; rdfs:range xsd:decimal ;
  rdfs:label "invoice amount value" ;
  rdfs:comment "The value of the invoice amount." .
:invoiceAmount_currency a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceAmount ; rdfs:range xsd:string ;
  rdfs:label "invoice amount currency" ;
  rdfs:comment "The currency of the invoice amount." .
:invoiceNumberValue a owl:DatatypeProperty ; rdfs:domain :Cl_InvoiceNumber ; rdfs:range xsd:string ; rdf:type owl:FunctionalProperty ;
  rdfs:label "invoice number value" ;
  rdfs:comment "The value of the invoice number." .

#################################################################
# Equivalent Classes & Restrictions
#################################################################

:Cl_EDIFACTInvoiceListing owl:equivalentClass [
  rdf:type owl:Restriction ;
  owl:onProperty :listsInvoice ;
  owl:someValuesFrom :Cl_Invoice
] .
:Cl_EDIFACTMessage owl:equivalentClass [
  rdf:type owl:Restriction ;
  owl:onProperty :hasInvoiceListing ;
  owl:someValuesFrom :Cl_EDIFACTInvoiceListing
] .
:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :participatesInInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .
:Cl_OrganizationInvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceRoleType ; owl:someValuesFrom :Cl_InvoiceRoleType ]
    )
] .
:Cl_BuyerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ;
          owl:onProperty :roleOrganization ;
          owl:allValuesFrom :Cl_Organization
        ]
    )
] .
:Cl_SellerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ;
          owl:onProperty :roleOrganization ;
          owl:allValuesFrom :Cl_Organization
        ]
    )
] .
:Cl_OrganizationInfo_Display owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationName ; owl:someValuesFrom :Cl_OrganizationName ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationType ; owl:someValuesFrom :Cl_OrganizationType ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationAddress ; owl:someValuesFrom :Cl_OrganizationAddress ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationContact ; owl:someValuesFrom :Cl_OrganizationContact ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationDescription ; owl:someValuesFrom :Cl_OrganizationDescription ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationWebsite ; owl:someValuesFrom :Cl_OrganizationWebsite ]
        [ a owl:Restriction ; owl:onProperty :displaysOrganizationIdentifier ; owl:someValuesFrom :Cl_OrganizationIdentifier ]
    )
] .
:Cl_ItemDisplayInfo owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :displayedCategory ; owl:someValuesFrom :Cl_Category ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedPrice ; owl:someValuesFrom :Cl_Price ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedDescription ; owl:someValuesFrom :Cl_Description ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedName ; owl:someValuesFrom :Cl_Name ]
        [ rdf:type owl:Restriction ; owl:onProperty :displayedImage ; owl:someValuesFrom :Cl_Image ]
    )
] .
:Cl_InvoiceItemEntry owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceItemEntry ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .
:Cl_InvoiceItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :refersToItem ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Item ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasQuantity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_Quantity ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasNetPrice ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_NetPrice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasGrossPrice ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Cl_GrossPrice ]
    )
] .
:Cl_NetPrice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :priceValue ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasCurrency ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .
:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTotalNetPrice ;
    owl:someValuesFrom :Cl_NetPrice
] .
:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasLineItem ;
    owl:someValuesFrom :Cl_InvoiceLineItem
] .
:Cl_InvoiceLineItem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :lineItemProduct ;
    owl:allValuesFrom :Cl_Product
] .
:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasCustomer ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasSeller ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
:Cl_InvoiceDetail owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :invoiceDetailDescription ; owl:someValuesFrom xsd:string ]
        [ a owl:Restriction ; owl:onProperty :hasLineItem ; owl:someValuesFrom :Cl_InvoiceLineItem ]
    )
] .
:Cl_BuyerAddressAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasBuyer ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    a owl:Restriction ;
    owl:onProperty :hasAddress ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .
:Cl_FieldRequirement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :requiresField ; owl:someValuesFrom :Cl_Field ]
        [ rdf:type owl:Restriction ; owl:onProperty :requiresDatatype ; owl:someValuesFrom :Cl_DataType ]
        [ rdf:type owl:Restriction ; owl:onProperty :requiresConstraint ; owl:someValuesFrom :Cl_Constraint ]
        [ rdf:type owl:Restriction ; owl:onProperty :belongsToFileFormat ; owl:someValuesFrom :Cl_FileFormat ]
    )
] .
:Cl_FormatValiditySpecification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesFileFormat ; owl:someValuesFrom :Cl_FileFormat ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesRequirement ; owl:someValuesFrom :Cl_InformationRequirement ]
        [ rdf:type owl:Restriction ; owl:onProperty :specifiesRule ; owl:someValuesFrom :Cl_ValidationRule ]
    )
] .
:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedDocument ;
          owl:someValuesFrom :Cl_Document ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .
:Cl_InvoiceAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Assignment
        [ rdf:type owl:Restriction ;
          owl:onProperty :assignedDocument ;
          owl:allValuesFrom :Cl_Invoice ]
    )
] .
:Cl_InvoiceAmountAssignment
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :invoiceAmountAssignment_invoice ;
              owl:allValuesFrom :Cl_Invoice ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :invoiceAmountAssignment_amount ;
              owl:allValuesFrom :Cl_InvoiceAmount ]
        )
    ] .
:Cl_InvoiceReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom :Cl_InvoiceNumber ]
    )
] .
:Cl_InvoiceNumber owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :invoiceNumberValue ;
        owl:allValuesFrom xsd:string
    ]
] .

#################################################################
# General Class Axioms
#################################################################

:Cl_Item rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasDisplayInfo ;
    owl:someValuesFrom :Cl_ItemDisplayInfo
] .
[ rdf:type owl:Restriction ;
  owl:onProperty :hasFieldRequirement ;
  owl:someValuesFrom :Cl_FieldRequirement ;
  rdfs:subClassOf :Cl_FileFormat
] .
[ rdf:type owl:Restriction ;
  owl:onProperty :hasOrganization ;
  owl:someValuesFrom :Cl_Organization ;
  rdfs:subClassOf :Cl_OrganizationInfo_Display
] .
[ rdf:type owl:Restriction ;
  owl:onProperty :hasOrganization ;
  owl:someValuesFrom :Cl_Organization ;
  rdfs:subClassOf :Cl_OrganizationInvoiceRole
] .
[ rdf:type owl:Restriction ;
  owl:onProperty :hasInvoice ;
  owl:someValuesFrom :Cl_Invoice ;
  rdfs:subClassOf :Cl_OrganizationInvoiceRole
] .

#################################################################
# End of ontology
#################################################################