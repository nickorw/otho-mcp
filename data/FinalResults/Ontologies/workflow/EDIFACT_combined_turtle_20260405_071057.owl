@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> a owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "A general entity in the ontology." .
:Cl_Document a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Document" ;
  rdfs:comment "A document entity." .
:Cl_Invoice a owl:Class ; rdfs:subClassOf :Cl_Document ;
  rdfs:label "Invoice" ;
  rdfs:comment "An invoice document." .
:Cl_EDIFACTDocument a owl:Class ; rdfs:subClassOf :Cl_Document ;
  rdfs:label "EDIFACT Document" ;
  rdfs:comment "A document following the EDIFACT standard." .
:Cl_EDIFACTMessage a owl:Class ; rdfs:subClassOf :Cl_EDIFACTDocument ;
  rdfs:label "EDIFACT Message" ; rdfs:comment "A structured message in the EDIFACT standard." .
:Cl_EDIFACTInvoiceListing a owl:Class ; rdfs:label "EDIFACT Invoice Listing" ; rdfs:comment "A pivot class representing the listing of an invoice within an EDIFACT message." .
:Cl_InvoiceEntry a owl:Class ;
  rdfs:label "Invoice Entry" ;
  rdfs:comment "An entry in an invoice." .
:Cl_InvoiceItemEntry a owl:Class ; rdfs:subClassOf :Cl_InvoiceEntry ;
  rdfs:label "Invoice Item Entry" ;
  rdfs:comment "An item entry in an invoice." .
:Cl_Item a owl:Class ; rdfs:label "Item" ; rdfs:subClassOf :Cl_SellableEntity ;
  rdfs:comment "A sellable item." .
:Cl_SellableEntity a owl:Class ; rdfs:label "Sellable Entity" ;
  rdfs:comment "An entity that can be sold." .
:Cl_InvoiceItem rdf:type owl:Class ;
  rdfs:label "Invoice Item" ;
  rdfs:comment "An item listed on an invoice." .
:Cl_Price rdf:type owl:Class ; rdfs:label "Price" ; rdfs:subClassOf owl:Thing ;
  rdfs:comment "A monetary value for an item or service." .
:Cl_NetPrice rdf:type owl:Class ; rdfs:subClassOf :Cl_Price ;
  rdfs:label "Net Price" ;
  rdfs:comment "The net price (excluding taxes)." .
:Cl_GrossPrice rdf:type owl:Class ; rdfs:subClassOf :Cl_Price ;
  rdfs:label "Gross Price" ;
  rdfs:comment "The gross price (including taxes)." .
:Cl_Quantity rdf:type owl:Class ; rdfs:subClassOf owl:Thing ;
  rdfs:label "Quantity" ;
  rdfs:comment "A quantity of items." .
:Cl_Currency rdf:type owl:Class ; rdfs:subClassOf owl:Thing ;
  rdfs:label "Currency" ;
  rdfs:comment "A currency used for pricing." .
:Cl_InvoiceDetail a owl:Class ;
  rdfs:label "Invoice Detail" ;
  rdfs:comment "Details of an invoice." .
:Cl_Product a owl:Class ;
  rdfs:label "Product" ;
  rdfs:comment "A product entity." .
:Cl_InvoiceLineItem a owl:Class ;
  rdfs:label "Invoice Line Item" ;
  rdfs:comment "A line item in an invoice." .
:Cl_InvoiceParticipant a owl:Class ;
  rdfs:label "Invoice Participant" ;
  rdfs:comment "A participant in an invoice." ;
  rdfs:subClassOf :Cl_Entity .
:Cl_Customer a owl:Class ; rdfs:subClassOf :Cl_InvoiceParticipant, :Cl_Organization ;
  rdfs:label "Customer" ;
  rdfs:comment "The customer in an invoice." .
:Cl_Seller a owl:Class ; rdfs:subClassOf :Cl_InvoiceParticipant, :Cl_Organization ;
  rdfs:label "Seller" ;
  rdfs:comment "The seller in an invoice." .
:Cl_Organization a owl:Class ; rdfs:subClassOf :Cl_Entity ; rdfs:label "Organization" ; rdfs:comment "An entity such as a company, business, or institution." .
:Cl_Company a owl:Class ; rdfs:subClassOf :Cl_Organization ;
  rdfs:label "Company" ;
  rdfs:comment "A company organization." .
:Cl_Supplier a owl:Class ; rdfs:subClassOf :Cl_Organization ;
  rdfs:label "Supplier" ;
  rdfs:comment "Supplier organization." .
:Cl_Buyer a owl:Class ; rdfs:subClassOf :Cl_Person ;
  rdfs:label "Buyer" ;
  rdfs:comment "A buyer person." .
:Cl_Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A person entity." .
:Cl_Address a owl:Class ;
  rdfs:label "Address" ;
  rdfs:comment "A postal address." .
:Cl_BuyerAddressAssignment a owl:Class ;
  rdfs:label "Buyer Address Assignment" ;
  rdfs:comment "Assignment of an address to a buyer." .
:Cl_InvoiceParticipation a owl:Class ;
  rdfs:label "Invoice Participation" ;
  rdfs:comment "A participation relationship in an invoice." .
:Cl_OrganizationInvoiceRole a owl:Class ;
  rdfs:label "Organization Invoice Role" ;
  rdfs:comment "A reification class representing the role of an organization in the context of an invoice." .
:Cl_InvoiceRole a owl:Class ; rdfs:label "Invoice Role" ; rdfs:comment "A reification class representing the role of an organization in the context of an invoice." .
:Cl_BuyerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRole ; rdfs:label "Buyer Role" ; rdfs:comment "A role where an organization acts as the buyer in an invoice." .
:Cl_SellerRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRole ; rdfs:label "Seller Role" ; rdfs:comment "A role where an organization acts as the seller in an invoice." .
:Cl_InvoiceRoleType a owl:Class ;
  rdfs:label "Invoice Role Type" ;
  rdfs:comment "A type of invoice role." .
:Cl_Issuer a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType ;
  rdfs:label "Issuer" ;
  rdfs:comment "An issuer role type." .
:Cl_Recipient a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType ;
  rdfs:label "Recipient" ;
  rdfs:comment "A recipient role type." .
:Cl_Payer a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType ;
  rdfs:label "Payer" ;
  rdfs:comment "A payer role type." .
:Cl_Payee a owl:Class ; rdfs:subClassOf :Cl_InvoiceRoleType ;
  rdfs:label "Payee" ;
  rdfs:comment "A payee role type." .
:Cl_OrganizationInfoDisplay a owl:Class ;
  rdfs:label "Organization Info Display" ;
  rdfs:comment "A display of organization information." .
:Cl_OrganizationName a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Name" ;
  rdfs:comment "The name of an organization." .
:Cl_OrganizationType a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Type" ;
  rdfs:comment "The type of an organization." .
:Cl_OrganizationAddress a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Address" ;
  rdfs:comment "The address of an organization." .
:Cl_OrganizationContact a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Contact" ;
  rdfs:comment "Contact information for an organization." .
:Cl_OrganizationDescription a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Description" ;
  rdfs:comment "A description of an organization." .
:Cl_OrganizationWebsite a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Website" ;
  rdfs:comment "A website of an organization." .
:Cl_OrganizationIdentifier a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Organization Identifier" ;
  rdfs:comment "An identifier for an organization." .
:Cl_ItemDisplayInfo a owl:Class ; rdfs:label "Item Display Information" ; rdfs:subClassOf :Cl_DisplayInfoReification ;
  rdfs:comment "Display information for an item." .
:Cl_DisplayInfoReification a owl:Class ; rdfs:label "Display Info Reification" ;
  rdfs:comment "A reification of display information." .
:Cl_Category a owl:Class ; rdfs:label "Category" ; rdfs:subClassOf :Cl_DisplayAttribute ;
  rdfs:comment "A category for display." .
:Cl_DisplayAttribute a owl:Class ; rdfs:label "Display Attribute" ;
  rdfs:comment "An attribute for display purposes." .
:Cl_Description a owl:Class ; rdfs:label "Description" ; rdfs:subClassOf :Cl_DisplayAttribute ;
  rdfs:comment "A textual description." .
:Cl_Name a owl:Class ; rdfs:label "Name" ; rdfs:subClassOf :Cl_DisplayAttribute ;
  rdfs:comment "A name for display." .
:Cl_Image a owl:Class ; rdfs:label "Image" ; rdfs:subClassOf :Cl_DisplayAttribute ;
  rdfs:comment "An image for display." .
:Cl_FileFormat a owl:Class ;
  rdfs:label "File Format" ;
  rdfs:comment "A file format for documents." .
:Cl_InformationRequirement a owl:Class ;
  rdfs:label "Information Requirement" ;
  rdfs:comment "A requirement for information." .
:Cl_RequirementType a owl:Class ; rdfs:subClassOf :Cl_InformationRequirement ;
  rdfs:label "Requirement Type" ;
  rdfs:comment "A type of requirement." .
:Cl_ValidationRule a owl:Class ; rdfs:subClassOf :Cl_InformationRequirement ;
  rdfs:label "Validation Rule" ;
  rdfs:comment "A validation rule for information." .
:Cl_Field a owl:Class ;
  rdfs:label "Field" ;
  rdfs:comment "A field in a file format." .
:Cl_DataType a owl:Class ;
  rdfs:label "Data Type" ;
  rdfs:comment "A data type for a field." .
:Cl_Constraint a owl:Class ; rdfs:subClassOf :Cl_InformationRequirement ;
  rdfs:label "Constraint" ;
  rdfs:comment "A constraint for a field or file format." .
:Cl_FieldRequirement a owl:Class ; rdfs:subClassOf :Cl_InformationRequirement, :Cl_FormatValiditySpecification ;
  rdfs:label "Field Requirement" ;
  rdfs:comment "A requirement for a field." .
:Cl_FormatValiditySpecification a owl:Class ;
  rdfs:label "Format Validity Specification" ;
  rdfs:comment "A specification for format validity." .
:Cl_Assignment a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Assignment" ;
  rdfs:comment "An assignment entity." .
:Cl_BusinessProcess a owl:Class ; rdfs:subClassOf :Cl_Entity ;
  rdfs:label "Business Process" ;
  rdfs:comment "A business process." .
:Cl_InvoiceAssignment a owl:Class ;
  rdfs:label "Invoice Assignment" ;
  rdfs:comment "An assignment related to an invoice." .
:Cl_InvoiceAmount a owl:Class ;
  rdfs:label "Invoice Amount" ;
  rdfs:comment "The amount on an invoice." .
:Cl_InvoiceAmountAssignment a owl:Class ;
  rdfs:label "Invoice Amount Assignment" ;
  rdfs:comment "Assignment of an amount to an invoice." .
:Cl_InvoiceNumber a owl:Class ;
  rdfs:label "Invoice Number" ;
  rdfs:comment "A number identifying an invoice." .
:Cl_InvoiceReification a owl:Class ;
  rdfs:label "Invoice Reification" ;
  rdfs:comment "Reification of an invoice." .

#################################################################
# Disjointness
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_EDIFACTInvoiceListing owl:disjointWith :Cl_EDIFACTMessage, :Cl_Invoice .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Organization owl:disjointWith :Cl_Invoice .
:Cl_OrganizationInvoiceRole owl:disjointWith :Cl_Organization, :Cl_Invoice .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_OrganizationName owl:disjointWith :Cl_OrganizationType, :Cl_OrganizationAddress, :Cl_OrganizationContact, :Cl_OrganizationDescription, :Cl_OrganizationWebsite, :Cl_OrganizationIdentifier .
:Cl_OrganizationType owl:disjointWith :Cl_OrganizationAddress, :Cl_OrganizationContact, :Cl_OrganizationDescription, :Cl_OrganizationWebsite, :Cl_OrganizationIdentifier .
:Cl_OrganizationAddress owl:disjointWith :Cl_OrganizationContact, :Cl_OrganizationDescription, :Cl_OrganizationWebsite, :Cl_OrganizationIdentifier .
:Cl_OrganizationContact owl:disjointWith :Cl_OrganizationDescription, :Cl_OrganizationWebsite, :Cl_OrganizationIdentifier .
:Cl_OrganizationDescription owl:disjointWith :Cl_OrganizationWebsite, :Cl_OrganizationIdentifier .
:Cl_OrganizationWebsite owl:disjointWith :Cl_OrganizationIdentifier .
:Cl_Category owl:disjointWith :Cl_Price, :Cl_Description, :Cl_Name, :Cl_Image .
:Cl_Price owl:disjointWith :Cl_Description, :Cl_Name, :Cl_Image .
:Cl_Description owl:disjointWith :Cl_Name, :Cl_Image .
:Cl_Name owl:disjointWith :Cl_Image .
:Cl_NetPrice owl:disjointWith :Cl_GrossPrice .
:Cl_Invoice owl:disjointWith :Cl_Item, :Cl_InvoiceItemEntry, :Cl_Price, :Cl_Quantity, :Cl_Currency, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_InvoiceNumber, :Cl_InvoiceReification .
:Cl_Item owl:disjointWith :Cl_InvoiceItemEntry .
:Cl_InvoiceAmount owl:disjointWith :Cl_InvoiceAmountAssignment .
:Cl_InvoiceReification owl:disjointWith :Cl_Invoice, :Cl_InvoiceNumber .
:Cl_Field owl:disjointWith :Cl_Constraint .
:Cl_FileFormat owl:disjointWith :Cl_Field, :Cl_Constraint .
:Cl_ValidationRule owl:disjointWith :Cl_RequirementType .
:Cl_DataType owl:disjointWith :Cl_Constraint .
:Cl_FieldRequirement owl:disjointWith :Cl_ValidationRule, :Cl_FileFormat .
:Cl_Document owl:disjointWith :Cl_BusinessProcess .
:Cl_Assignment owl:disjointWith :Cl_Document, :Cl_BusinessProcess .
:Cl_Customer owl:disjointWith :Cl_Seller .
:Cl_Buyer owl:disjointWith :Cl_Address .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ; rdfs:domain :Cl_EDIFACTMessage ; rdfs:range :Cl_EDIFACTInvoiceListing ; rdfs:label "has invoice listing" ; rdfs:comment "Connects an EDIFACT message to an invoice listing pivot." ;
  owl:inverseOf :belongsToMessage .
:listsInvoice a owl:ObjectProperty ; rdfs:domain :Cl_EDIFACTInvoiceListing ; rdfs:range :Cl_Invoice ; rdfs:label "lists invoice" ; rdfs:comment "Connects the invoice listing pivot to the actual invoice." ;
  owl:inverseOf :isListedIn .
:isListedIn a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_EDIFACTInvoiceListing ; rdfs:label "is listed in" ; rdfs:comment "Inverse: connects an invoice to the invoice listing pivot." ;
  owl:inverseOf :listsInvoice .
:belongsToMessage a owl:ObjectProperty ; rdfs:domain :Cl_EDIFACTInvoiceListing ; rdfs:range :Cl_EDIFACTMessage ; rdfs:label "belongs to message" ; rdfs:comment "Inverse: connects the invoice listing pivot to the EDIFACT message." ;
  owl:inverseOf :hasInvoiceListing .
:involvesOrganization a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceParticipation ; rdfs:range :Cl_Organization ;
  rdfs:label "involves organization" ;
  rdfs:comment "Relates an invoice participation to an organization." ;
  owl:inverseOf :hasOrganizationParticipation .
:participatesInInvoice a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceParticipation ; rdfs:range :Cl_Invoice ;
  rdfs:label "participates in invoice" ;
  rdfs:comment "Relates an invoice participation to an invoice." ;
  owl:inverseOf :hasInvoiceParticipation .
:hasInvoiceParticipation a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceParticipation ;
  rdfs:label "has invoice participation" ;
  rdfs:comment "Relates an invoice to its participations." ;
  owl:inverseOf :participatesInInvoice .
:hasOrganizationParticipation a owl:ObjectProperty ; rdfs:domain :Cl_Organization ; rdfs:range :Cl_InvoiceParticipation ;
  rdfs:label "has organization participation" ;
  rdfs:comment "Relates an organization to its invoice participations." ;
  owl:inverseOf :involvesOrganization .
:hasOrganization a owl:ObjectProperty ;
  rdfs:domain :Cl_OrganizationInvoiceRole ;
  rdfs:range :Cl_Organization ;
  rdfs:label "has organization" ;
  rdfs:comment "Relates an invoice role to an organization." ;
  owl:inverseOf :organizationOfRole .
:organizationOfRole a owl:ObjectProperty ;
  rdfs:domain :Cl_Organization ;
  rdfs:range :Cl_OrganizationInvoiceRole ;
  rdfs:label "organization of role" ;
  rdfs:comment "Inverse: relates an organization to the organization invoice role." ;
  owl:inverseOf :hasOrganization .
:hasInvoice a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInvoiceRole ; rdfs:range :Cl_Invoice ;
  rdfs:label "has invoice" ;
  rdfs:comment "Relates an organization invoice role to an invoice." ;
  owl:inverseOf :invoiceOfRole .
:invoiceOfRole a owl:ObjectProperty ;
  rdfs:domain :Cl_Invoice ;
  rdfs:range :Cl_OrganizationInvoiceRole ;
  rdfs:label "invoice of role" ;
  rdfs:comment "Inverse: relates an invoice to the organization invoice role." ;
  owl:inverseOf :hasInvoice .
:hasInvoiceRoleType a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInvoiceRole ; rdfs:range :Cl_InvoiceRoleType ;
  rdfs:label "has invoice role type" ;
  rdfs:comment "Relates an organization invoice role to a role type." ;
  owl:inverseOf :invoiceRoleTypeOf .
:invoiceRoleTypeOf a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceRoleType ; rdfs:range :Cl_OrganizationInvoiceRole ;
  rdfs:label "invoice role type of" ;
  rdfs:comment "Inverse: relates an invoice role type to the organization invoice role." ;
  owl:inverseOf :hasInvoiceRoleType .
:hasInvoiceRole a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceRole ; rdfs:label "has invoice role" ; rdfs:comment "Links an invoice to its associated role instances (such as buyer or seller)." ;
  owl:inverseOf :roleOfInvoice .
:roleOrganization a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceRole ; rdfs:range :Cl_Organization ; rdfs:label "role organization" ; rdfs:comment "Links an invoice role to the organization playing that role." ;
  owl:inverseOf :organizationRoleOf .
:organizationRoleOf a owl:ObjectProperty ; rdfs:domain :Cl_Organization ; rdfs:range :Cl_InvoiceRole ;
  rdfs:label "organization role of" ;
  rdfs:comment "Inverse: links an organization to its invoice roles." ;
  owl:inverseOf :roleOrganization .
:roleOfInvoice a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceRole ; rdfs:range :Cl_Invoice ;
  rdfs:label "role of invoice" ;
  rdfs:comment "Inverse: links an invoice role to the invoice." ;
  owl:inverseOf :hasInvoiceRole .
:hasInvoiceEntry a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceEntry ;
  rdfs:label "has invoice entry" ;
  rdfs:comment "Relates an invoice to its entries." ;
  owl:inverseOf :invoiceEntryOf .
:invoiceEntryOf a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceEntry ; rdfs:range :Cl_Invoice ;
  rdfs:label "invoice entry of" ;
  rdfs:comment "Inverse: relates an invoice entry to its invoice." ;
  owl:inverseOf :hasInvoiceEntry .
:hasInvoiceItemEntry a owl:ObjectProperty ; rdfs:subPropertyOf :hasInvoiceEntry ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceItemEntry ;
  rdfs:label "has invoice item entry" ;
  rdfs:comment "Relates an invoice to its item entries." ;
  owl:inverseOf :belongsToInvoice .
:refersToItem a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceItemEntry ; rdfs:range :Cl_Item ;
  rdfs:label "refers to item" ;
  rdfs:comment "Relates an invoice item entry to an item." ;
  owl:inverseOf :isItemOfEntry .
:isItemOfEntry a owl:ObjectProperty ; rdfs:domain :Cl_Item ; rdfs:range :Cl_InvoiceItemEntry ;
  rdfs:label "is item of entry" ;
  rdfs:comment "Inverse: relates an item to its invoice item entry." ;
  owl:inverseOf :refersToItem .
:belongsToInvoice a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceItemEntry ; rdfs:range :Cl_Invoice ;
  rdfs:label "belongs to invoice" ;
  rdfs:comment "Inverse: relates an invoice item entry to its invoice." ;
  owl:inverseOf :hasInvoiceItemEntry .
:hasInvoiceItem rdf:type owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceItem ;
  rdfs:label "has invoice item" ;
  rdfs:comment "Relates an invoice to its invoice items." ;
  owl:inverseOf :invoiceItemOf .
:invoiceItemOf rdf:type owl:ObjectProperty ; rdfs:domain :Cl_InvoiceItem ; rdfs:range :Cl_Invoice ;
  rdfs:label "invoice item of" ;
  rdfs:comment "Inverse: relates an invoice item to the invoice." ;
  owl:inverseOf :hasInvoiceItem .
:hasQuantity rdf:type owl:ObjectProperty ; rdfs:domain :Cl_InvoiceItem ; rdfs:range :Cl_Quantity ;
  rdfs:label "has quantity" ;
  rdfs:comment "Relates an invoice item to its quantity." ;
  owl:inverseOf :quantityOfInvoiceItem .
:quantityOfInvoiceItem rdf:type owl:ObjectProperty ; rdfs:domain :Cl_Quantity ; rdfs:range :Cl_InvoiceItem ;
  rdfs:label "quantity of invoice item" ;
  rdfs:comment "Inverse: relates a quantity to the invoice item." ;
  owl:inverseOf :hasQuantity .
:hasNetPrice rdf:type owl:ObjectProperty ; rdfs:domain :Cl_InvoiceItem ; rdfs:range :Cl_NetPrice ;
  rdfs:label "has net price" ;
  rdfs:comment "Relates an invoice item to its net price." ;
  owl:inverseOf :netPriceOfInvoiceItem .
:netPriceOfInvoiceItem rdf:type owl:ObjectProperty ; rdfs:domain :Cl_NetPrice ; rdfs:range :Cl_InvoiceItem ;
  rdfs:label "net price of invoice item" ;
  rdfs:comment "Inverse: relates a net price to the invoice item." ;
  owl:inverseOf :hasNetPrice .
:hasGrossPrice rdf:type owl:ObjectProperty ; rdfs:domain :Cl_InvoiceItem ; rdfs:range :Cl_GrossPrice ;
  rdfs:label "has gross price" ;
  rdfs:comment "Relates an invoice item to its gross price." ;
  owl:inverseOf :grossPriceOfInvoiceItem .
:grossPriceOfInvoiceItem rdf:type owl:ObjectProperty ; rdfs:domain :Cl_GrossPrice ; rdfs:range :Cl_InvoiceItem ;
  rdfs:label "gross price of invoice item" ;
  rdfs:comment "Inverse: relates a gross price to the invoice item." ;
  owl:inverseOf :hasGrossPrice .
:hasCurrency rdf:type owl:ObjectProperty ; rdfs:domain :Cl_Price ; rdfs:range :Cl_Currency ;
  rdfs:label "has currency" ;
  rdfs:comment "Relates a price to a currency." ;
  owl:inverseOf :currencyOfPrice .
:currencyOfPrice rdf:type owl:ObjectProperty ; rdfs:domain :Cl_Currency ; rdfs:range :Cl_Price ;
  rdfs:label "currency of price" ;
  rdfs:comment "Inverse: relates a currency to the price." ;
  owl:inverseOf :hasCurrency .
:hasTotalNetPrice rdf:type owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_NetPrice ;
  rdfs:label "has total net price" ;
  rdfs:comment "Relates an invoice to its total net price." ;
  owl:inverseOf :totalNetPriceOfInvoice .
:totalNetPriceOfInvoice rdf:type owl:ObjectProperty ; rdfs:domain :Cl_NetPrice ; rdfs:range :Cl_Invoice ;
  rdfs:label "total net price of invoice" ;
  rdfs:comment "Inverse: relates a net price to the invoice." ;
  owl:inverseOf :hasTotalNetPrice .
:hasInvoiceDetail a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceDetail ;
  rdfs:label "has invoice detail" ;
  rdfs:comment "Relates an invoice to its details." ;
  owl:inverseOf :invoiceDetailOf .
:invoiceDetailOf a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceDetail ; rdfs:range :Cl_Invoice ;
  rdfs:label "invoice detail of" ;
  rdfs:comment "Inverse: relates an invoice detail to the invoice." ;
  owl:inverseOf :hasInvoiceDetail .
:hasCustomer a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_Customer ;
  rdfs:label "has customer" ;
  rdfs:comment "Relates an invoice to its customer." ;
  owl:inverseOf :customerOfInvoice .
:customerOfInvoice a owl:ObjectProperty ; rdfs:domain :Cl_Customer ; rdfs:range :Cl_Invoice ;
  rdfs:label "customer of invoice" ;
  rdfs:comment "Inverse: links a customer to an invoice." ;
  owl:inverseOf :hasCustomer .
:hasSeller a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_Seller ;
  rdfs:label "has seller" ;
  rdfs:comment "Relates an invoice to its seller." ;
  owl:inverseOf :sellerOfInvoice .
:sellerOfInvoice a owl:ObjectProperty ; rdfs:domain :Cl_Seller ; rdfs:range :Cl_Invoice ;
  rdfs:label "seller of invoice" ;
  rdfs:comment "Inverse: links a seller to an invoice." ;
  owl:inverseOf :hasSeller .
:hasLineItem a owl:ObjectProperty ; rdfs:domain :Cl_Invoice ; rdfs:range :Cl_InvoiceLineItem ;
  rdfs:label "has line item" ;
  rdfs:comment "Relates an invoice to its line items." ;
  owl:inverseOf :lineItemOfInvoice .
:lineItemOfInvoice a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceLineItem ; rdfs:range :Cl_Invoice ;
  rdfs:label "line item of invoice" ;
  rdfs:comment "Inverse: links a line item to an invoice." ;
  owl:inverseOf :hasLineItem .
:lineItemProduct a owl:ObjectProperty ; rdfs:domain :Cl_InvoiceLineItem ; rdfs:range :Cl_Product ;
  rdfs:label "line item product" ;
  rdfs:comment "Relates a line item to a product." ;
  owl:inverseOf :productOfLineItem .
:productOfLineItem a owl:ObjectProperty ; rdfs:domain :Cl_Product ; rdfs:range :Cl_InvoiceLineItem ;
