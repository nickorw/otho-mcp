  rdfs:label "organization website displayed by" ;
  rdfs:comment "Inverse: relates OrganizationWebsite to OrganizationInfoDisplay." ;
  owl:inverseOf :displaysOrganizationWebsite .
:displaysOrganizationIdentifier a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInfo_Display ; rdfs:range :Cl_OrganizationIdentifier ;
  rdfs:label "displays organization identifier" ;
