# Naming convention fix: change Cl_OrganizationInfoDisplay to Cl_OrganizationInfo_Display

:Cl_OrganizationInfo_Display a owl:Class ;
  rdfs:label "Organization Info Display" ;
  rdfs:comment "A display of organization information." .

:displaysOrganizationName a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInfo_Display ; rdfs:range :Cl_OrganizationName ;
  rdfs:label "displays organization name" ;
  rdfs:comment "Relates OrganizationInfoDisplay to OrganizationName." ;
  owl:inverseOf :organizationNameDisplayedBy .
:organizationNameDisplayedBy a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationName ; rdfs:range :Cl_OrganizationInfo_Display ;
  rdfs:label "organization name displayed by" ;
  rdfs:comment "Inverse: relates OrganizationName to OrganizationInfoDisplay." ;
  owl:inverseOf :displaysOrganizationName .
:displaysOrganizationType a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInfo_Display ; rdfs:range :Cl_OrganizationType ;
  rdfs:label "displays organization type" ;
  rdfs:comment "Relates OrganizationInfoDisplay to OrganizationType." ;
