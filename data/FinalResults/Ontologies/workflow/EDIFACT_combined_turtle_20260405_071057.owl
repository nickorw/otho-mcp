:organizationTypeDisplayedBy a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationType ; rdfs:range :Cl_OrganizationInfo_Display ;
  rdfs:label "organization type displayed by" ;
  rdfs:comment "Inverse: relates OrganizationType to OrganizationInfoDisplay." ;
