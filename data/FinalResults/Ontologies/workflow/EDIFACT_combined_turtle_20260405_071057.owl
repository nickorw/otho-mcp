  rdfs:label "organization address displayed by" ;
  rdfs:comment "Inverse: relates OrganizationAddress to OrganizationInfoDisplay." ;
  owl:inverseOf :displaysOrganizationAddress .
:displaysOrganizationContact a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInfo_Display ; rdfs:range :Cl_OrganizationContact ;
  rdfs:label "displays organization contact" ;
  rdfs:comment "Relates OrganizationInfoDisplay to OrganizationContact." ;
  owl:inverseOf :organizationContactDisplayedBy .
:organizationContactDisplayedBy a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationContact ; rdfs:range :Cl_OrganizationInfo_Display ;
  rdfs:label "organization contact displayed by" ;
  rdfs:comment "Inverse: relates OrganizationContact to OrganizationInfoDisplay." ;
  owl:inverseOf :displaysOrganizationContact .
:displaysOrganizationDescription a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationInfo_Display ; rdfs:range :Cl_OrganizationDescription ;
  rdfs:label "displays organization description" ;
  rdfs:comment "Relates OrganizationInfoDisplay to OrganizationDescription." ;
  owl:inverseOf :organizationDescriptionDisplayedBy .
:organizationDescriptionDisplayedBy a owl:ObjectProperty ; rdfs:domain :Cl_OrganizationDescription ; rdfs:range :Cl_OrganizationInfo_Display ;
  rdfs:label "organization description displayed by" ;
  rdfs:comment "Inverse: relates OrganizationDescription to OrganizationInfoDisplay." ;
