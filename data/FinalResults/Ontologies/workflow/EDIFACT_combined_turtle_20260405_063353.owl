    rdfs:comment "A rule for validation." .

:valueMin a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueRange ;
    rdfs:range xsd:decimal ;
    rdfs:label "value min" ;
    rdfs:comment "The minimum value in the range." .

:valueMax a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueRange ;
    rdfs:range xsd:decimal ;
    rdfs:label "value max" ;
    rdfs:comment "The maximum value in the range." .

:isRequired a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldPresence ;
    rdfs:range xsd:boolean ;
    rdfs:label "is required" ;
    rdfs:comment "Whether the field is required." .

:formatPattern a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldFormat ;
    rdfs:range xsd:string ;
    rdfs:label "format pattern" ;
    rdfs:comment "The format pattern for the field." .

:itemNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemName ;
    rdfs:range xsd:string ;
    rdfs:label "item name value" ;
    rdfs:comment "The value of the item name." .

:itemPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price value" ;
    rdfs:comment "The value of the item price." .

:itemDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemDescription ;
    rdfs:range xsd:string ;
    rdfs:label "item description value" ;
    rdfs:comment "The value of the item description." .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:string ;
    rdfs:label "item image URL" ;
    rdfs:comment "The URL of the item image." .

:itemCategoryValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemCategory ;
    rdfs:range xsd:string ;
    rdfs:label "item category value" ;
    rdfs:comment "The value of the item category." .

:itemIDValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemID ;
    rdfs:range xsd:string ;
    rdfs:label "item ID value" ;
    rdfs:comment "The value of the item ID." .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization." .

:organizationType a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization type" ;
    rdfs:comment "The type of the organization." .

:organizationDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range xsd:string ;
    rdfs:label "organization description" ;
    rdfs:comment "A description of the organization." .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "address line" ;
    rdfs:comment "The address line." .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "city" ;
    rdfs:comment "The city in the address." .

:state a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "state" ;
    rdfs:comment "The state in the address." .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "postal code" ;
    rdfs:comment "The postal code of the address." .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "country" ;
    rdfs:comment "The country in the address." .

:email a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactDetail ;
    rdfs:range xsd:string ;
    rdfs:label "email" ;
    rdfs:comment "The email address." .

:phoneNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactDetail ;
    rdfs:range xsd:string ;
    rdfs:label "phone number" ;
    rdfs:comment "The phone number." .

:website a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactDetail ;
    rdfs:range xsd:string ;
    rdfs:label "website" ;
    rdfs:comment "The website URL." .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact email" ;
    rdfs:comment "The contact email." .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string ;
    rdfs:label "contact phone" ;
    rdfs:comment "The contact phone number." .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer name" ;
    rdfs:comment "The name of the customer." .

:customerID a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer ID" ;
    rdfs:comment "The identifier of the customer." .

:supplierName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Supplier ;
    rdfs:range xsd:string ;
    rdfs:label "supplier name" ;
    rdfs:comment "The name of the supplier." .

:supplierID a owl:DatatypeProperty ;
    rdfs:domain :Cl_Supplier ;
    rdfs:range xsd:string ;
    rdfs:label "supplier ID" ;
    rdfs:comment "The identifier of the supplier." .

:paymentTermsDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_PaymentTerms ;
    rdfs:range xsd:string ;
    rdfs:label "payment terms description" ;
    rdfs:comment "A description of the payment terms." .

:statusLabel a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceStatus ;
    rdfs:range xsd:string ;
    rdfs:label "status label" ;
    rdfs:comment "The label of the invoice status." .

:itemQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "item quantity" ;
    rdfs:comment "The quantity of the invoice item." .

:itemUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "item unit price" ;
    rdfs:comment "The unit price of the invoice item." .

:itemTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "item total" ;
    rdfs:comment "The total amount for the invoice item." .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "The date of the assignment." .

:dueDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "due date" ;
    rdfs:comment "The due date for the invoice." .

:totalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal ;
    rdfs:label "total amount" ;
    rdfs:comment "The total amount for the invoice." .

#################################################################
# Restrictions, Equivalent Classes, Axioms
#################################################################

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      [ a owl:Restriction ;
        owl:onProperty :invoiceHasInvolvement ;
        owl:someValuesFrom :Cl_InvoiceOrganizationInvolvement
      ]
    )
] .

:Cl_Organization owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      [ a owl:Restriction ;
        owl:onProperty :organizationInvolvedIn ;
        owl:someValuesFrom :Cl_InvoiceOrganizationInvolvement
      ]
    )
] .

:Cl_InvoiceOrganizationInvolvement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
    )
] .

:Cl_InvoiceRoleAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :isRoleAssignmentForInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_EDIFACTMessageInvoiceListing owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :listedInMessage ;
          owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ a owl:Restriction ;
          owl:onProperty :listsInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasBuyer ;
          owl:someValuesFrom :Cl_Buyer
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasAddressAssignment ;
          owl:someValuesFrom :Cl_Address
        ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :refersToItem ;
          owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :lineOfInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceDetails owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceItem ; owl:someValuesFrom :Cl_InvoiceItem ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasCustomer ; owl:someValuesFrom :Cl_Customer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasSupplier ; owl:someValuesFrom :Cl_Supplier ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasPaymentTerms ; owl:someValuesFrom :Cl_PaymentTerms ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasCurrencyForInvoiceDetails ; owl:someValuesFrom :Cl_Currency ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceStatus ; owl:someValuesFrom :Cl_InvoiceStatus ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceAmount ;
          owl:someValuesFrom xsd:decimal ]
    )
] .

:Cl_InvoiceIdentification owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:allValuesFrom :Cl_InvoiceNumber
] .

:Cl_InvoiceNumber owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:allValuesFrom xsd:string
] .

:Cl_FileFormat owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasFileFormatValidationInfo ; owl:someValuesFrom :Cl_FileFormatValidationInfo ]
        [ a owl:Restriction ; owl:onProperty :hasRequiredField ; owl:someValuesFrom :Cl_RequiredField ]
        [ a owl:Restriction ; owl:onProperty :hasConstraint ; owl:someValuesFrom :Cl_Constraint ]
        [ a owl:Restriction ; owl:onProperty :hasValidationRequirement ; owl:someValuesFrom :Cl_ValidationRequirement ]
    )
] .

:Cl_FileComponent owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( :Cl_Field :Cl_Constraint )
] .

:Cl_SoldItemDisplay owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :displayedInformation ;
    owl:allValuesFrom :Cl_Information
] .

:Cl_Item rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :itemHasName ;
    owl:someValuesFrom :Cl_ItemName
] , [
    a owl:Restriction ;
    owl:onProperty :itemHasPrice ;
    owl:someValuesFrom :Cl_ItemPrice
] .

:Cl_OrganizationInformation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasOrganization ;
          owl:allValuesFrom :Cl_Organization
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasAddress ;
          owl:allValuesFrom :Cl_Address
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasContactDetail ;
          owl:allValuesFrom :Cl_ContactDetail
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasRole ;
          owl:allValuesFrom :Cl_OrganizationRole
        ]
    )
] .

:Cl_BuyerRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerRoleOfInvoice ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
          owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerOrganization ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
          owl:allValuesFrom :Cl_Organization ]
    )
] .

:Cl_SellerRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :sellerRoleOfInvoice ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
          owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :sellerOrganization ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
          owl:allValuesFrom :Cl_Organization ]
    )
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

#################################################################
# Disjointness and DisjointUnion
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice , :Cl_EDIFACTMessageInvoiceListing .
:Cl_Invoice owl:disjointWith :Cl_EDIFACTMessageInvoiceListing , :Cl_Organization , :Cl_InvoiceNumber .
:Cl_InvoiceRole owl:disjointWith :Cl_Organization , :Cl_Invoice .
:Cl_Company owl:disjointWith :Cl_Supplier , :Cl_Customer , :Cl_NonProfit , :Cl_GovernmentAgency .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_NonProfit owl:disjointWith :Cl_GovernmentAgency .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Invoice owl:disjointWith :Cl_InvoiceDetails , :Cl_InvoiceItem , :Cl_Customer , :Cl_Supplier , :Cl_Currency , :Cl_PaymentTerms , :Cl_Address , :Cl_ContactInformation , :Cl_InvoiceStatus , :Cl_InvoiceAmountAssignment , :Cl_BusinessProcess .
:Cl_InvoiceAmountAssignment owl:disjointWith :Cl_Invoice .
:Cl_InvoiceIdentification owl:disjointWith :Cl_InvoiceNumber .
:Cl_RequiredField owl:disjointWith :Cl_OptionalField .
:Cl_FieldConstraint owl:disjointWith :Cl_FieldPresence , :Cl_FieldFormat , :Cl_FieldValidation .
:Cl_Information owl:disjointWith :Cl_Item .
:Cl_SoldItemDisplay owl:disjointWith :Cl_Item .
:Cl_NetPrice owl:disjointWith :Cl_GrossPrice .
:Cl_InvoiceLine owl:disjointWith :Cl_Item , :Cl_Price , :Cl_Quantity , :Cl_Currency .
:Cl_Item owl:disjointWith :Cl_Quantity , :Cl_Price , :Cl_Currency .
:Cl_Quantity owl:disjointWith :Cl_Price , :Cl_Currency .
:Cl_Price owl:disjointWith :Cl_Currency .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_InvoiceAssignment owl:disjointWith :Cl_BusinessProcess .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .

:Cl_Information owl:disjointUnionOf (
    :Cl_ItemName
    :Cl_ItemPrice
    :Cl_ItemDescription
    :Cl_ItemImage
    :Cl_ItemCategory
    :Cl_ItemID
) .

:Cl_Price owl:disjointUnionOf ( :Cl_NetPrice :Cl_GrossPrice ) .

:Cl_BusinessParty owl:disjointUnionOf ( :Cl_Customer :Cl_Supplier ) .

:Cl_Person owl:disjointUnionOf ( :Cl_Buyer ) .

#################################################################
# Inverse Properties
#################################################################

:organizationInvolvedIn a owl:ObjectProperty ;
    owl:inverseOf :involvesOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "organization involved in" ;
    rdfs:comment "Inverse: links an organization to its invoice involvements." .

:invoiceHasInvolvement a owl:ObjectProperty ;
    owl:inverseOf :hasInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    rdfs:label "invoice has involvement" ;
    rdfs:comment "Inverse: links an invoice to its organization involvements." .

:lineOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceLine ;
    rdfs:label "line of invoice" ;
    rdfs:comment "Links an invoice line to the invoice it belongs to." .

:itemOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine ;
    owl:inverseOf :hasItem ;
    rdfs:label "item of line" ;
    rdfs:comment "Links an item to the invoice line referencing it." .

#################################################################
# Specialized Role Properties
#################################################################

:invoiceRole_invoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice role invoice" ;
    rdfs:comment "Links an invoice role to an invoice." ;
    owl:inverseOf :roleOfInvoice .

:roleOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "role of invoice" ;
    rdfs:comment "Links an invoice to its role." ;
    owl:inverseOf :invoiceRole_invoice .

:invoiceRole_organization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "invoice role organization" ;
    rdfs:comment "Links an invoice role to an organization." ;
    owl:inverseOf :roleOfOrganization .

:roleOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "role of organization" ;
    rdfs:comment "Links an organization to its role." ;
    owl:inverseOf :invoiceRole_organization .

:buyerRoleOfInvoice a owl:ObjectProperty ;
    rdfs:subPropertyOf :invoiceRole_invoice ;
    rdfs:domain :Cl_BuyerRole ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "buyer role of invoice" ;
    rdfs:comment "Links a buyer role to an invoice." ;
    owl:inverseOf :invoiceOfBuyerRole .

:invoiceOfBuyerRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_BuyerRole ;
    rdfs:label "invoice of buyer role" ;
    rdfs:comment "Links an invoice to its buyer role." ;
    owl:inverseOf :buyerRoleOfInvoice .

:buyerOrganization a owl:ObjectProperty ;
    rdfs:subPropertyOf :invoiceRole_organization ;
    rdfs:domain :Cl_BuyerRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "buyer organization" ;
    rdfs:comment "Links a buyer role to an organization." ;
    owl:inverseOf :organizationOfBuyerRole .

:organizationOfBuyerRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_BuyerRole ;
    rdfs:label "organization of buyer role" ;
    rdfs:comment "Links an organization to its buyer role." ;
    owl:inverseOf :buyerOrganization .

:sellerRoleOfInvoice a owl:ObjectProperty ;
    rdfs:subPropertyOf :invoiceRole_invoice ;
    rdfs:domain :Cl_SellerRole ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "seller role of invoice" ;
    rdfs:comment "Links a seller role to an invoice." ;
    owl:inverseOf :invoiceOfSellerRole .

:invoiceOfSellerRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_SellerRole ;
    rdfs:label "invoice of seller role" ;
    rdfs:comment "Links an invoice to its seller role." ;
    owl:inverseOf :sellerRoleOfInvoice .

:sellerOrganization a owl:ObjectProperty ;
    rdfs:subPropertyOf :invoiceRole_organization ;
    rdfs:domain :Cl_SellerRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "seller organization" ;
    rdfs:comment "Links a seller role to an organization." ;
    owl:inverseOf :organizationOfSellerRole .

:organizationOfSellerRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_SellerRole ;
    rdfs:label "organization of seller role" ;
    rdfs:comment "Links an organization to its seller role." ;
    owl:inverseOf :sellerOrganization .

#################################################################
# End of FestS Ontology
#################################################################