#################################################################

:hasInvoiceIdentification a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice identification string" ;
    rdfs:comment "A unique identification string for the invoice." .

:identifiesInvoice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range xsd:string ;
    rdfs:label "identifies invoice string" ;
    rdfs:comment "Identification string for the invoice." .

:hasInvoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number string" ;
    rdfs:comment "The invoice number as a string." .

:hasTotalNetPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceNetPriceCalculation ;
    rdfs:range xsd:decimal ;
    rdfs:label "total net price value" ;
    rdfs:comment "The total net price for the invoice." .

:hasCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range xsd:string ;
    rdfs:label "currency code string" ;
    rdfs:comment "The currency code for the price." .

:invoiceIdentifier a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice identifier" ;
    rdfs:comment "A unique identifier for the invoice." .

:issueDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "issue date" ;
    rdfs:comment "The date the invoice was issued." .

:messageIdentifier a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "message identifier" ;
    rdfs:comment "A unique identifier for the EDIFACT message." .

:organizationRole a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range xsd:string ;
    rdfs:label "organization role" ;
    rdfs:comment "The role of the organization in the invoice involvement." .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role name" ;
    rdfs:comment "The name of the role, e.g., Seller, Buyer." .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The invoice number as a string." .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" ;
    rdfs:comment "The date of the invoice." .

:quantityValue a owl:DatatypeProperty ;
