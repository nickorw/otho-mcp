@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests>
    a owl:Ontology ;
    owl:versionIRI <http://example.org/fests/1.0> .

#################################################################
# Classes
#################################################################

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured electronic data interchange message, possibly containing multiple invoices." .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial document issued by a seller to a buyer, relating to a sale transaction and indicating the products, quantities, and agreed prices." ;
    rdfs:subClassOf :Cl_Document , :Cl_MessageContent .

:Cl_EDIFACTMessageInvoiceListing a owl:Class ;
    rdfs:label "EDIFACT Message Invoice Listing" ;
    rdfs:comment "A reification class representing the inclusion of an Invoice in an EDIFACT Message." .

:Cl_MessageContent a owl:Class ;
    rdfs:label "Message Content" ;
    rdfs:comment "Superclass for all content types that can be part of a message." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document class." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceOrganizationInvolvement a owl:Class ;
    rdfs:label "Invoice Organization Involvement" ;
    rdfs:comment "A reification class representing the involvement of an organization in an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRoleAssignment a owl:Class ;
    rdfs:label "Invoice Role Assignment" ;
    rdfs:comment "A reification class representing the assignment of a specific role to an organization in the context of a particular invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A role played by an organization in an invoice, such as Seller, Buyer, Payer, Recipient, etc." .

:Cl_InvoiceParticipant a owl:Class ;
    rdfs:label "Invoice Participant" ;
    rdfs:comment "A superclass for entities that can participate in an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company or institution that can participate in invoices." ;
    rdfs:subClassOf :Cl_InvoiceParticipant .

:Cl_Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "A company organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "A supplier organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_BusinessParty a owl:Class ;
    rdfs:label "Business Party" ;
    rdfs:comment "A business party, either a customer or supplier." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in the invoice, representing an item and its details." .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A product or service item." .

:Cl_Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A tangible product." ;
    rdfs:subClassOf :Cl_Item .

:Cl_Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A service item." ;
    rdfs:subClassOf :Cl_Item .

:Cl_Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value." .

:Cl_NetPrice a owl:Class ;
    rdfs:label "Net Price" ;
    rdfs:comment "The net price." ;
    rdfs:subClassOf :Cl_Price .

:Cl_GrossPrice a owl:Class ;
    rdfs:label "Gross Price" ;
    rdfs:comment "The gross price." ;
    rdfs:subClassOf :Cl_Price .

:Cl_Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity value." .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "A currency." .

:Cl_InvoiceNetPriceCalculation a owl:Class ;
    rdfs:label "Invoice Net Price Calculation" ;
    rdfs:comment "Calculation of the total net price of the invoice." .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:label "Invoice Amount Assignment" ;
    rdfs:comment "Assignment of an amount to an invoice." ;
    rdfs:subClassOf :Cl_Assignment .

:Cl_InvoiceIdentification a owl:Class ;
    rdfs:label "Invoice Identification" ;
    rdfs:comment "Identification details for an invoice." .

:Cl_Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A generic identifier." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceNumber a owl:Class ;
    rdfs:label "Invoice Number" ;
    rdfs:comment "The number identifying an invoice." ;
    rdfs:subClassOf :Cl_Identifier .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format definition." .

:Cl_FileComponent a owl:Class ;
    rdfs:label "File Component" ;
    rdfs:comment "A component of a file format." .

:Cl_FormatSpecification a owl:Class ;
    rdfs:label "Format Specification" ;
    rdfs:comment "Specification of a file format." .

:Cl_ValidationRequirement a owl:Class ;
    rdfs:label "Validation Requirement" ;
    rdfs:comment "A requirement for validation." .

:Cl_DataType a owl:Class ;
    rdfs:label "Data Type" ;
    rdfs:comment "A data type definition." .

:Cl_Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint on a field or format." .

:Cl_Field a owl:Class ;
    rdfs:label "Field" ;
    rdfs:comment "A field in a file format." .

:Cl_ValueRange a owl:Class ;
    rdfs:label "Value Range" ;
    rdfs:comment "A range of allowed values." .

:Cl_RequiredField a owl:Class ;
    rdfs:label "Required Field" ;
    rdfs:comment "A required field." ;
    rdfs:subClassOf :Cl_Field .

:Cl_OptionalField a owl:Class ;
    rdfs:label "Optional Field" ;
    rdfs:comment "An optional field." ;
    rdfs:subClassOf :Cl_Field .

:Cl_FieldConstraint a owl:Class ;
    rdfs:label "Field Constraint" ;
    rdfs:comment "A constraint on a field." ;
    rdfs:subClassOf :Cl_Constraint .

:Cl_FieldPresence a owl:Class ;
    rdfs:label "Field Presence" ;
    rdfs:comment "Presence constraint for a field." .

:Cl_FieldFormat a owl:Class ;
    rdfs:label "Field Format" ;
    rdfs:comment "Format constraint for a field." .

:Cl_FieldValidation a owl:Class ;
    rdfs:label "Field Validation" ;
    rdfs:comment "Validation for a field." .

:Cl_FileFormatValidationInfo a owl:Class ;
    rdfs:label "File Format Validation Info" ;
    rdfs:comment "Validation information for a file format." .

:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A generic entity." .

:Cl_SoldItemDisplay a owl:Class ;
    rdfs:label "Sold Item Display" ;
    rdfs:comment "Display information for a sold item." ;
    rdfs:subClassOf :Entity .

:Cl_Information a owl:Class ;
    rdfs:label "Information" ;
    rdfs:comment "Information about an item." ;
    rdfs:subClassOf :Entity .

:Cl_ItemName a owl:Class ;
    rdfs:label "Item Name" ;
    rdfs:comment "The name of an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_ItemPrice a owl:Class ;
    rdfs:label "Item Price" ;
    rdfs:comment "The price of an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_ItemDescription a owl:Class ;
    rdfs:label "Item Description" ;
    rdfs:comment "A description of an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_ItemImage a owl:Class ;
    rdfs:label "Item Image" ;
    rdfs:comment "An image of an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_ItemCategory a owl:Class ;
    rdfs:label "Item Category" ;
    rdfs:comment "A category for an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_ItemID a owl:Class ;
    rdfs:label "Item ID" ;
    rdfs:comment "An identifier for an item." ;
    rdfs:subClassOf :Cl_Information .

:Cl_OrganizationEntity a owl:Class ;
    rdfs:label "Organization Entity" ;
    rdfs:comment "An entity related to an organization." ;
    rdfs:subClassOf :Entity .

:Cl_OrganizationInformation a owl:Class ;
    rdfs:label "Organization Information" ;
    rdfs:comment "Information about an organization." ;
    rdfs:subClassOf :Cl_OrganizationEntity .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "A role within an organization." ;
    rdfs:subClassOf :Cl_OrganizationEntity .

:Cl_Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "An address." ;
    rdfs:subClassOf :Cl_OrganizationEntity .

:Cl_ContactDetail a owl:Class ;
    rdfs:label "Contact Detail" ;
    rdfs:comment "A contact detail for an organization." ;
    rdfs:subClassOf :Cl_OrganizationEntity .

:Cl_NonProfit a owl:Class ;
    rdfs:label "Non-Profit" ;
    rdfs:comment "A non-profit organization." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_GovernmentAgency a owl:Class ;
    rdfs:label "Government Agency" ;
    rdfs:comment "A government agency." ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person." ;
    rdfs:subClassOf :Entity .

:Cl_Buyer a owl:Class ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person who buys goods or services." ;
    rdfs:subClassOf :Cl_Person .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of a buyer to an address." .

:Cl_InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "An item listed in an invoice." .

:Cl_PaymentTerms a owl:Class ;
    rdfs:label "Payment Terms" ;
    rdfs:comment "Terms of payment for an invoice." .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact information for an invoice." .

:Cl_InvoiceStatus a owl:Class ;
    rdfs:label "Invoice Status" ;
    rdfs:comment "Status of an invoice." .

:Cl_InvoiceDetails a owl:Class ;
    rdfs:label "Invoice Details" ;
    rdfs:comment "Details of an invoice." .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process." .

:Cl_Assignment a owl:Class ;
    rdfs:label "Assignment" ;
    rdfs:comment "An assignment of an entity or document." ;
    rdfs:subClassOf :Entity .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:label "Invoice Assignment" ;
    rdfs:comment "Assignment of an invoice to a business process." ;
    rdfs:subClassOf :Cl_Assignment .

:Cl_BuyerRole a owl:Class ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "A role as a buyer in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_SellerRole a owl:Class ;
    rdfs:label "Seller Role" ;
    rdfs:comment "A role as a seller in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceRole .

#################################################################
# Individuals (Roles)
#################################################################

:Seller a :Cl_InvoiceRole ;
    :roleName "Seller" ;
    rdfs:label "Seller" ;
    rdfs:comment "The seller role in an invoice." .

:Buyer a :Cl_InvoiceRole ;
    :roleName "Buyer" ;
    rdfs:label "Buyer" ;
    rdfs:comment "The buyer role in an invoice." .

:Payer a :Cl_InvoiceRole ;
    :roleName "Payer" ;
    rdfs:label "Payer" ;
    rdfs:comment "The payer role in an invoice." .

:Recipient a :Cl_InvoiceRole ;
    :roleName "Recipient" ;
    rdfs:label "Recipient" ;
    rdfs:comment "The recipient role in an invoice." .

:SupplierRole a owl:NamedIndividual ;
    rdfs:label "Supplier" ;
    rdfs:comment "The supplier role." .

:CustomerRole a owl:NamedIndividual ;
    rdfs:label "Customer" ;
    rdfs:comment "The customer role." .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:label "has invoice listing" ;
    rdfs:comment "Connects an EDIFACT message to its invoice listing reification instance." ;
    owl:inverseOf :listedInMessage .

:listedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "listed in message" ;
    rdfs:comment "The EDIFACT message in which the invoice is listed." ;
    owl:inverseOf :hasInvoiceListing .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    rdfs:comment "The invoice that is listed in the EDIFACT message." ;
    owl:inverseOf :listedByMessageInvoiceListing .

:listedByMessageInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_EDIFACTMessageInvoiceListing ;
    rdfs:label "listed by message invoice listing" ;
    rdfs:comment "Inverse property for listsInvoice." ;
    owl:inverseOf :listsInvoice .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links an invoice amount assignment to an invoice." ;
    owl:inverseOf :invoiceHasInvolvement .

:hasInvoiceRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "has invoice role assignment" ;
    rdfs:comment "Links an invoice to its role assignments." ;
    owl:inverseOf :isRoleAssignmentForInvoice .

:isRoleAssignmentForInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceRoleAssignment ;
    rdfs:label "is role assignment for invoice" ;
    rdfs:comment "Inverse property linking role assignment to invoice." .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links a role assignment or involvement to the involved organization." ;
    owl:inverseOf :organizationInvolvedIn .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Links a role assignment to the specific role the organization plays in the invoice." ;
    owl:inverseOf :invoiceRoleAssignmentOfRole .

:invoiceRoleAssignmentOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRoleAssignment ;
    rdfs:label "invoice role assignment of role" ;
    rdfs:comment "Inverse property for hasInvoiceRole." ;
    owl:inverseOf :hasInvoiceRole .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "has invoice line" ;
    rdfs:comment "Links an invoice to its invoice lines." ;
    owl:inverseOf :lineOfInvoice .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item ;
    rdfs:label "has item" ;
    rdfs:comment "Links an invoice line to an item." ;
    owl:inverseOf :itemOfLine .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Quantity ;
    rdfs:label "has quantity" ;
    rdfs:comment "Links an invoice line to a quantity." ;
    owl:inverseOf :quantityOfLine .

:quantityOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "quantity of line" ;
    rdfs:comment "Links a quantity to the invoice line it is used in." ;
    owl:inverseOf :hasQuantity .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice ;
    rdfs:label "has net price" ;
    rdfs:comment "Links an invoice line to a net price." ;
    owl:inverseOf :netPriceOfLine .

:netPriceOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "net price of line" ;
    rdfs:comment "Links a net price to the invoice line it is used in." ;
    owl:inverseOf :hasNetPrice .

:hasGrossPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_GrossPrice ;
    rdfs:label "has gross price" ;
    rdfs:comment "Links an invoice line to a gross price." ;
    owl:inverseOf :grossPriceOfLine .

:grossPriceOfLine a owl:ObjectProperty ;
    rdfs:domain :Cl_GrossPrice ;
    rdfs:range :Cl_InvoiceLine ;
    rdfs:label "gross price of line" ;
    rdfs:comment "Links a gross price to the invoice line it is used in." ;
    owl:inverseOf :hasGrossPrice .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range :Cl_Currency ;
    rdfs:label "has currency" ;
    rdfs:comment "Links a price to its currency." ;
    owl:inverseOf :currencyOfPrice .

:currencyOfPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range :Cl_Price ;
    rdfs:label "currency of price" ;
    rdfs:comment "Links a currency to a price." ;
    owl:inverseOf :hasCurrency .

:hasCurrencyForInvoiceDetails a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetails ;
    rdfs:range :Cl_Currency ;
    rdfs:label "has currency for invoice details" ;
    rdfs:comment "Links invoice details to currency." ;
    owl:inverseOf :currencyOfInvoiceDetails .

:currencyOfInvoiceDetails a owl:ObjectProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range :Cl_InvoiceDetails ;
    rdfs:label "currency of invoice details" ;
    rdfs:comment "Links a currency to invoice details." ;
    owl:inverseOf :hasCurrencyForInvoiceDetails .

:calculatedFromInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNetPriceCalculation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "calculated from invoice" ;
    rdfs:comment "Links a net price calculation to the invoice it is calculated from." ;
    owl:inverseOf :invoiceOfNetPriceCalculation .

:invoiceOfNetPriceCalculation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNetPriceCalculation ;
    rdfs:label "invoice of net price calculation" ;
    rdfs:comment "Links an invoice to its net price calculation." ;
    owl:inverseOf :calculatedFromInvoice .

:hasTotalNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNetPriceCalculation ;
    rdfs:range :Cl_NetPrice ;
    rdfs:label "has total net price" ;
    rdfs:comment "Links a net price calculation to the net price." ;
    owl:inverseOf :totalNetPriceOfCalculation .

:totalNetPriceOfCalculation a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range :Cl_InvoiceNetPriceCalculation ;
    rdfs:label "total net price of calculation" ;
    rdfs:comment "Links a net price to its calculation." ;
    owl:inverseOf :hasTotalNetPrice .

:hasInvoiceIdentification a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentification ;
    rdfs:comment "Links an invoice to its identification pivot class." ;
    rdfs:label "has invoice identification" ;
    owl:inverseOf :identifiesInvoice .

:identifiesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceIdentification ;
    rdfs:comment "Inverse of hasInvoiceIdentification." ;
    rdfs:label "identifies invoice" .

:hasInvoiceNumber a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range :Cl_InvoiceNumber ;
    rdfs:comment "Links the invoice identification to the invoice number." ;
    rdfs:label "has invoice number" ;
    owl:inverseOf :invoiceNumberOfIdentification .

:invoiceNumberOfIdentification a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range :Cl_InvoiceIdentification ;
    rdfs:label "invoice number of identification" ;
    rdfs:comment "Links an invoice number to its identification." ;
    owl:inverseOf :hasInvoiceNumber .

:hasFormatSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FormatSpecification ;
    rdfs:label "has format specification" ;
    rdfs:comment "Links a file format to its specification." ;
    owl:inverseOf :formatSpecificationOfFileFormat .

:formatSpecificationOfFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FormatSpecification ;
    rdfs:range :Cl_FileFormat ;
    rdfs:label "format specification of file format" ;
    rdfs:comment "Links a format specification to its file format." ;
    owl:inverseOf :hasFormatSpecification .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_Field ;
    rdfs:label "has field" ;
    rdfs:comment "Links a file format to its fields." ;
    owl:inverseOf :fieldOfFileFormat .

:fieldOfFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FileFormat ;
    rdfs:label "field of file format" ;
    rdfs:comment "Links a field to its file format." ;
    owl:inverseOf :hasField .

:hasRequiredField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_RequiredField ;
    rdfs:subPropertyOf :hasField ;
    rdfs:label "has required field" ;
    rdfs:comment "Links a file format to its required fields." ;
    owl:inverseOf :requiredFieldOfFileFormat .

:requiredFieldOfFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredField ;
    rdfs:range :Cl_FileFormat ;
    rdfs:label "required field of file format" ;
    rdfs:comment "Links a required field to its file format." ;
    owl:inverseOf :hasRequiredField .

:hasOptionalField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_OptionalField ;
    rdfs:subPropertyOf :hasField ;
    rdfs:label "has optional field" ;
    rdfs:comment "Links a file format to its optional fields." ;
    owl:inverseOf :optionalFieldOfFileFormat .

:optionalFieldOfFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_OptionalField ;
    rdfs:range :Cl_FileFormat ;
    rdfs:label "optional field of file format" ;
    rdfs:comment "Links an optional field to its file format." ;
    owl:inverseOf :hasOptionalField .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_Constraint ;
    rdfs:label "has constraint" ;
    rdfs:comment "Links a file format to its constraints." ;
    owl:inverseOf :constraintOfFileFormat .

:constraintOfFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_Constraint ;
    rdfs:range :Cl_FileFormat ;
    rdfs:label "constraint of file format" ;
    rdfs:comment "Links a constraint to its file format." ;
    owl:inverseOf :hasConstraint .

:hasFieldConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldConstraint ;
    rdfs:subPropertyOf :hasConstraint ;
    rdfs:label "has field constraint" ;
    rdfs:comment "Links a field to its field-level constraints." ;
    owl:inverseOf :fieldConstraintOfField .

:fieldConstraintOfField a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range :Cl_Field ;
    rdfs:label "field constraint of field" ;
    rdfs:comment "Links a field constraint to its field." ;
    owl:inverseOf :hasFieldConstraint .

:hasDataType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_DataType ;
    rdfs:label "has data type" ;
    rdfs:comment "Links a field to its data type." ;
    owl:inverseOf :dataTypeOfField .

:dataTypeOfField a owl:ObjectProperty ;
    rdfs:domain :Cl_DataType ;
    rdfs:range :Cl_Field ;
    rdfs:label "data type of field" ;
    rdfs:comment "Links a data type to its field." ;
    owl:inverseOf :hasDataType .

:hasValueRange a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_ValueRange ;
    rdfs:label "has value range" ;
    rdfs:comment "Links a field to its value range." ;
    owl:inverseOf :valueRangeOfField .

:valueRangeOfField a owl:ObjectProperty ;
    rdfs:domain :Cl_ValueRange ;
    rdfs:range :Cl_Field ;
    rdfs:label "value range of field" ;
