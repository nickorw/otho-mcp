    rdfs:range xsd:decimal ;
    rdfs:label "price value" ;
    rdfs:comment "The value of the price." .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string ;
    rdfs:label "currency code" ;
    rdfs:comment "The code of the currency." .

