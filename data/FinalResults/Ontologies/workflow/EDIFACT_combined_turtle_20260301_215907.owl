#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_InvoiceListing owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :listsInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasCustomer ; owl:someValuesFrom :Cl_Customer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasIssuer ; owl:someValuesFrom :Cl_InvoiceIssuer ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceNumber ; owl:allValuesFrom xsd:string ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:allValuesFrom :Cl_InvoiceNumber ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceElement
        [ rdf:type owl:Restriction ; owl:onProperty :il_item ; owl:allValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :il_invoice ; owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :il_item ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :il_invoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceLineItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :lineItemProduct ; owl:someValuesFrom :Cl_Product ]
        [ rdf:type owl:Restriction ; owl:onProperty :lineItemQuantity ; owl:allValuesFrom xsd:integer ]
        [ rdf:type owl:Restriction ; owl:onProperty :lineItemUnitPrice ; owl:allValuesFrom xsd:decimal ]
    )
] .

:Cl_InvoiceDetail owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasLineItem ; owl:someValuesFrom :Cl_InvoiceLineItem ]
    )
] .

:Cl_InvoiceAmount owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceAmount ; owl:someValuesFrom :Cl_Amount ]
        [ rdf:type owl:Restriction ; owl:onProperty :forInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_RequiredField owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :hasFieldSpecification ; owl:someValuesFrom :Cl_FieldSpecification
] .

:Cl_FieldSpecification owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :hasConstraint ; owl:someValuesFrom :Cl_Constraint
] .

:Cl_Constraint owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasValueDomain ; owl:someValuesFrom :Cl_ValueDomain ]
        [ a owl:Restriction ; owl:onProperty :hasDataType ; owl:someValuesFrom :Cl_DataType ]
    )
] .

:Cl_ItemDisplayInfo owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :displaysInfo ;
    owl:allValuesFrom :Cl_Information
] .

:Cl_NetPriceCalculation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :netPriceValue ;
    owl:allValuesFrom xsd:decimal
] , [
    a owl:Restriction ;
    owl:onProperty :netPriceCurrency ;
    owl:allValuesFrom :Cl_Currency
] .

:Cl_InvoiceLine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :refersToProduct ;
    owl:allValuesFrom :Cl_Product
] , [
    a owl:Restriction ;
    owl:onProperty :hasPrice ;
    owl:allValuesFrom :Cl_Price
] , [
    a owl:Restriction ;
    owl:onProperty :hasQuantity ;
    owl:allValuesFrom :Cl_Quantity
] .

:Cl_ProcessAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_ProcessAssignment
        [ a owl:Restriction ; owl:onProperty :hasDocument ; owl:allValuesFrom :Cl_Document ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasOrganizationType ;
    owl:someValuesFrom :Cl_OrganizationType
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:someValuesFrom :Cl_Organization
] .

:Cl_InvoiceOrganizationRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :playedByOrganization ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :inInvoice ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_InvoiceRole ]
    )
] .

#################################################################
# End of FestS Ontology
#################################################################