:listsInvoice rdfs:label "lists invoice" .
:invoiceListedIn rdfs:label "invoice listed in" .
:invoiceListingOfMessage rdfs:label "invoice listing of message" .
:edifactMessageID rdfs:label "EDIFACT Message ID" .
:invoiceID rdfs:label "Invoice ID" .
:invoiceDate rdfs:label "Invoice Date" .
:invoiceAmount rdfs:label "Invoice Amount" .
:invoiceListingID rdfs:label "Invoice Listing ID" .
:organizationName rdfs:label "organization name" .
:issueDate rdfs:label "issue date" .
:roleDescription rdfs:label "role description" .
:roleName rdfs:label "role name" .
:hasDisplayInfo rdfs:label "has display info" .
:displayedItem rdfs:label "displayed item" .
:displayedName rdfs:label "displayed name" .
:displayedPrice rdfs:label "displayed price" .
:displayedDescription rdfs:label "displayed description" .
:displayedImage rdfs:label "displayed image" .
:displayedCategory rdfs:label "displayed category" .
:displayedAvailability rdfs:label "displayed availability" .
:itemNameValue rdfs:label "item name value" .
:itemPriceValue rdfs:label "item price value" .
:itemDescriptionValue rdfs:label "item description value" .
:itemImageUrl rdfs:label "item image URL" .
:itemCategoryValue rdfs:label "item category value" .
:itemAvailabilityStatus rdfs:label "item availability status" .
:hasValidityRequirement rdfs:label "has validity requirement" .
:requiresField rdfs:label "requires field" .
:requiresConstraint rdfs:label "requires constraint" .
:fieldHasConstraint rdfs:label "field has constraint" .
:fieldName rdfs:label "field name" .
:fieldIsRequired rdfs:label "field is required" .
:constraintExpression rdfs:label "constraint expression" .
:validationDescription rdfs:label "validation description" .
:fieldHasValueType rdfs:label "field has value type" .
:valueTypeName rdfs:label "value type name" .
:assignedInvoice rdfs:label "assigned invoice" .
:assignedBusinessProcess rdfs:label "assigned business process" .
:assignedEntity rdfs:label "assigned entity" .
:isInvoiceAssignmentOf rdfs:label "is invoice assignment of" .
:isBusinessProcessAssignmentOf rdfs:label "is business process assignment of" .
