    rdfs:label "invoice number value" ;
    rdfs:comment "The string value of the invoice number." .

:roleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role description" ;
    rdfs:comment "Description of the invoice role." .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer name" ;
    rdfs:comment "Name of the customer." .

:issuerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceIssuer ;
    rdfs:range xsd:string ;
    rdfs:label "issuer name" ;
    rdfs:comment "Name of the invoice issuer." .

:recipientName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRecipient ;
    rdfs:range xsd:string ;
    rdfs:label "recipient name" ;
    rdfs:comment "Name of the invoice recipient." .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_Price :Cl_MonetaryAmount ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "amount value" ;
    rdfs:comment "Value of the monetary amount or price." .

:currency a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_Price :Cl_MonetaryAmount ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "currency" ;
    rdfs:comment "Currency of the price or monetary amount." .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string ;
    rdfs:label "amount currency" ;
    rdfs:comment "Currency of the invoice amount." .

:listingCreatedAt a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range xsd:dateTime ;
    rdfs:label "listing created at" ;
    rdfs:comment "Date and time the invoice listing was created." .

:edifactMessageId a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "EDIFACT message ID" ;
    rdfs:comment "ID of the EDIFACT message." .

:netPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal ;
    rdfs:label "net price value" ;
    rdfs:comment "Net price value." .

:netPriceCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:string ;
    rdfs:label "net price currency" ;
    rdfs:comment "Currency of the net price." .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:decimal ;
    rdfs:label "quantity value" ;
    rdfs:comment "Value of the quantity." .

:priceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range xsd:decimal ;
    rdfs:label "price value" ;
    rdfs:comment "Value of the price." .

:itemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string ;
    rdfs:label "item name" ;
    rdfs:comment "Name of the item." .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_Item :Cl_TextualAttribute ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "item description" ;
    rdfs:comment "Description of the item." .

:itemPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_NumericAttribute ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price" ;
    rdfs:comment "Price attribute of an item." .

:itemQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_NumericAttribute ;
    rdfs:range xsd:integer ;
    rdfs:label "item quantity" ;
    rdfs:comment "Quantity attribute of an item." .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ImageAttribute ;
    rdfs:range xsd:anyURI ;
    rdfs:label "item image URL" ;
    rdfs:comment "URL of the image attribute." .

:hasOrganizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationName ;
    rdfs:range xsd:string ;
    rdfs:label "has organization name" ;
    rdfs:comment "Organization name property." .

:hasOrganizationType a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string ;
    rdfs:label "has organization type" ;
    rdfs:comment "Organization type property." .

:hasOrganizationContact a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContact ;
    rdfs:range xsd:string ;
    rdfs:label "has organization contact" ;
    rdfs:comment "Organization contact property." .

:hasOrganizationRole a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string ;
    rdfs:label "has organization role" ;
    rdfs:comment "Organization role property." .

:hasOrganizationLocation a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "has organization location" ;
    rdfs:comment "Organization location property." .

:hasOrganizationIdentifier a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "has organization identifier" ;
    rdfs:comment "Organization identifier property." .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Constraint ;
    rdfs:range xsd:string ;
    rdfs:label "constraint description" ;
    rdfs:comment "Description of the constraint." .

:componentName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileComponent ;
    rdfs:range xsd:string ;
    rdfs:label "component name" ;
    rdfs:comment "Name of the file component." .

:metadataKey a owl:DatatypeProperty ;
    rdfs:domain :Cl_Metadata ;
    rdfs:range xsd:string ;
    rdfs:label "metadata key" ;
    rdfs:comment "Key of the metadata." .

:metadataValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Metadata ;
    rdfs:range xsd:string ;
    rdfs:label "metadata value" ;
    rdfs:comment "Value of the metadata." .

:encodingType a owl:DatatypeProperty ;
    rdfs:domain :Cl_Encoding ;
    rdfs:range xsd:string ;
    rdfs:label "encoding type" ;
    rdfs:comment "Type of encoding." .

:dataSectionType a owl:DatatypeProperty ;
    rdfs:domain :Cl_DataSection ;
    rdfs:range xsd:string ;
    rdfs:label "data section type" ;
    rdfs:comment "Type of data section." .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "Date of the assignment." .

:hasUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLineEntry ;
    rdfs:range xsd:decimal ;
    rdfs:label "has unit price" ;
    rdfs:comment "Unit price in invoice line entry." .

:hasLineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLineEntry ;
    rdfs:range xsd:decimal ;
    rdfs:label "has line total" ;
    rdfs:comment "Line total in invoice line entry." .

:hasQuantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLineEntry ;
    rdfs:range xsd:integer ;
    rdfs:label "has quantity value" ;
    rdfs:comment "Quantity value in invoice line entry." .

:invoiceDateValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDate ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date value" ;
    rdfs:comment "Date value for invoice date." .

#################################################################
# Restrictions and Axioms
#################################################################

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_OrganizationInformation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf (
        :Cl_OrganizationName
        :Cl_OrganizationType
        :Cl_OrganizationContact
        :Cl_OrganizationRole
        :Cl_OrganizationLocation
        :Cl_OrganizationIdentifier
    )
] .

:Cl_InvoiceOrganizationParticipation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:allValuesFrom :Cl_Organization
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_InvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRoleType ; owl:someValuesFrom :Cl_InvoiceRoleType ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom :Cl_Quantity ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Cl_Price ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceLineOf ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceDetailReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceLineEntry ; owl:someValuesFrom :Cl_InvoiceLineEntry ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasMonetaryAmount ; owl:allValuesFrom :Cl_MonetaryAmount ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:someValuesFrom :Cl_InvoiceDetailReification ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceDate ; owl:allValuesFrom :Cl_InvoiceDate ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceIssuer ; owl:allValuesFrom :Cl_InvoiceIssuer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceRecipient ; owl:allValuesFrom :Cl_InvoiceRecipient ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceNumber ; owl:allValuesFrom xsd:string ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasTotalAmount ; owl:allValuesFrom :Cl_MonetaryAmount ]
    )
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceIdentifier ;
    owl:allValuesFrom :Cl_InvoiceIdentifier
] , [
    rdf:type owl:Restriction ;
    owl:onProperty [ owl:inverseOf :assignedDocument ] ;
    owl:someValuesFrom :Cl_Assignment
] .

:Cl_InvoiceIdentifier owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:allValuesFrom xsd:string
] .

:Cl_InvoiceAmountRecord owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :refersToInvoice ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
          owl:allValuesFrom :Cl_Invoice
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasAmount ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ;
          owl:allValuesFrom :Cl_InvoiceAmount
        ]
    )
] .

:Cl_NetPriceCalculation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :forInvoice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Invoice
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPriceAmount ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Amount
] .

:Cl_InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Item
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasPrice ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Cl_Price
] .

:Cl_ItemInformationDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :displayedItem ;
          owl:allValuesFrom :Cl_SoldItem
        ]
        [ a owl:Restriction ;
          owl:onProperty :displayedAttribute ;
          owl:allValuesFrom :Cl_InformationAttribute
        ]
    )
] .

:Cl_FileFormat rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasSpecification ;
    owl:someValuesFrom :Cl_FormatSpecification
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasComponent ;
    owl:someValuesFrom :Cl_FileComponent
] .

:Cl_FormatSpecification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :requiresValidation ;
    owl:someValuesFrom :Cl_ValidationRequirement
] .

:Cl_ValidationAssertion rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :isValidFileFormat ;
    owl:someValuesFrom :Cl_FileFormat
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :providesInformation ;
    owl:someValuesFrom :Cl_FileComponent
] ;
rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :fulfillsRequirement ;
    owl:someValuesFrom :Cl_ValidationRequirement
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :assignedDocument ;
    owl:allValuesFrom :Cl_Invoice
] .

#################################################################
# Disjointness
#################################################################

:Cl_Person owl:disjointWith :Cl_Address .
:Cl_BuyerAddressAssignment owl:disjointWith :Cl_Address, :Cl_Buyer .
:Cl_OrganizationName owl:disjointWith :Cl_OrganizationType, :Cl_OrganizationContact, :Cl_OrganizationRole, :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_OrganizationType owl:disjointWith :Cl_OrganizationContact, :Cl_OrganizationRole, :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_OrganizationContact owl:disjointWith :Cl_OrganizationRole, :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_OrganizationRole owl:disjointWith :Cl_OrganizationLocation, :Cl_OrganizationIdentifier .
:Cl_OrganizationLocation owl:disjointWith :Cl_OrganizationIdentifier .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Company owl:disjointWith :Cl_Supplier, :Cl_Customer .
:Cl_Seller owl:disjointWith :Cl_BuyerOrg, :Cl_Recipient .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Invoice owl:disjointWith :Cl_Item , :Cl_Price , :Cl_InvoiceLine , :Cl_NetPriceCalculation , :Cl_Amount , :Cl_InvoiceAmount , :Cl_InvoiceAmountRecord , :Cl_InvoiceIdentifier .
:Cl_Item owl:disjointWith :Cl_Price , :Cl_InvoiceLine , :Cl_NetPriceCalculation , :Cl_Amount .
:Cl_InvoiceLine owl:disjointWith :Cl_Price , :Cl_NetPriceCalculation , :Cl_Amount .
:Cl_Price owl:disjointWith :Cl_NetPriceCalculation , :Cl_Amount .
:Cl_NetPriceCalculation owl:disjointWith :Cl_Amount .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Organization owl:disjointWith :Cl_Person .
:Cl_InvoiceIssuer owl:disjointWith :Cl_InvoiceRecipient .
:Cl_Metadata owl:disjointWith :Cl_DataSection, :Cl_Encoding .
:Cl_DataSection owl:disjointWith :Cl_Encoding .
:Cl_TextualAttribute owl:disjointWith :Cl_NumericAttribute, :Cl_ImageAttribute .
:Cl_NumericAttribute owl:disjointWith :Cl_ImageAttribute .
:Cl_BusinessProcess owl:disjointWith :Cl_Document .
:Cl_Assignment owl:disjointWith :Cl_BusinessProcess, :Cl_Document .
:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_InvoiceListing owl:disjointWith :Cl_Invoice, :Cl_EDIFACTMessage .
:Cl_Invoice owl:disjointWith :Cl_EDIFACTMessage .

#################################################################
# Disjoint Union (where applicable)
#################################################################

:Cl_Document owl:disjointUnionOf ( :Cl_EDIFACTMessage :Cl_InvoiceListing ) .
:Cl_BusinessDocument owl:disjointUnionOf ( :Cl_Invoice ) .

#################################################################
# Individuals (for role types, illustration)
#################################################################

:SellerRole a :Cl_InvoiceRoleType ; rdfs:label "Seller Role" .
:BuyerRole a :Cl_InvoiceRoleType ; rdfs:label "Buyer Role" .
:RecipientRole a :Cl_InvoiceRoleType ; rdfs:label "Recipient Role" .

#################################################################
# Additional axioms to resolve validation issues
#################################################################

:Cl_Entity rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ] .

#################################################################
# Explicitly declare all equivalent properties (P12 fix)
#################################################################

:organizationName owl:equivalentProperty :organization_name .
:invoiceNumber owl:equivalentProperty :invoice_number .
:invoiceDate owl:equivalentProperty :invoice_date .

#################################################################
# Annotation properties corrections (P20 fix)
#################################################################

:isInformationProvidedBy rdfs:label "is information provided by" ;
    rdfs:comment "Inverse of providesInformation." .

:isInvoiceIdentifierOf rdfs:label "is invoice identifier of" ;
    rdfs:comment "Inverse of hasInvoiceIdentifier." .

:isRoleTypeOf rdfs:label "is role type of" ;
    rdfs:comment "Inverse of hasRoleType." .

:isInvoiceAmountRecordOf rdfs:label "is invoice amount record of" ;
    rdfs:comment "Inverse of hasInvoiceAmountRecord." .

#################################################################
# Naming convention fix for isPriceOfInvoiceLine (P22 fix)
#################################################################

:isPriceOfInvoiceLine rdfs:label "isPriceOfInvoiceLine" .

#################################################################
# Explicit inverse relationships for P13 (missing inverses)
#################################################################

:involvesInvoice owl:inverseOf :isInvolvedInInvoiceParticipation .
:isInvolvedInInvoiceParticipation owl:inverseOf :involvesInvoice .
