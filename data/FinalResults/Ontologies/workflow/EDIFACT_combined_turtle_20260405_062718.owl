:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "Invoice number." .

:invoice_number a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "Invoice number." ;
    owl:equivalentProperty :invoiceNumber .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" ;
    rdfs:comment "Date of the invoice." .

:invoice_date a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" ;
    rdfs:comment "Date of the invoice." ;
    owl:equivalentProperty :invoiceDate .

:invoiceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
