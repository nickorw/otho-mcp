@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests> a owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A general superclass for all entities represented in the ontology." ;
    rdfs:subClassOf owl:Thing ;
    rdfs:seeAlso :Cl_Organization, :Cl_Document, :Cl_InvoiceElement .

# New connection to avoid P04 (unconnected element)
:Cl_Entity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :entityHasRepresentation ;
    owl:someValuesFrom :Cl_OrganizationInfoDisplay
] .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "Superclass for all document-related entities." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Invoice a owl:Class ; 
    rdfs:subClassOf :Cl_Document, :Cl_Entity ; 
    rdfs:label "Invoice" ; 
    rdfs:comment "A document issued by a seller to a buyer indicating quantities, prices, and other details for goods or services provided." .

:Cl_InvoiceIdentifier a owl:Class ; 
    rdfs:label "Invoice Identifier" ; 
    rdfs:comment "A unique identifier (number) assigned to an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceDocument a owl:Class ; 
    rdfs:label "Invoice Document" ; 
    rdfs:comment "Superclass for all invoice-related documents." ;
    rdfs:subClassOf :Cl_Document .

:Cl_InvoiceAmount a owl:Class ; 
    rdfs:subClassOf :Cl_MonetaryValue ; 
    rdfs:label "Invoice Amount" ; 
    rdfs:comment "The monetary value stated on an invoice." .

:Cl_InvoiceAmountAssignment a owl:Class ; 
    rdfs:label "Invoice Amount Assignment" ; 
    rdfs:comment "A reification/pivot class linking an invoice to its amount." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceDetailRecord a owl:Class ;
    rdfs:label "Invoice Detail Record" ;
    rdfs:comment "A record of details for an invoice line or element." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "A detail entry in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceLine a owl:Class ; 
    rdfs:subClassOf :Cl_Entity, :Cl_InvoiceElement ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item in an invoice." .

:Cl_InvoiceElement a owl:Class ;
    rdfs:label "Invoice Element" ;
    rdfs:comment "A general superclass for all elements that can appear in an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceParty a owl:Class ;
    rdfs:label "Invoice Party" ;
    rdfs:comment "A party involved in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceParticipation a owl:Class ; 
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Reification class representing the participation of an organization in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceInvolvement a owl:Class ;
    rdfs:label "Invoice Involvement" ;
    rdfs:comment "Reification class representing an organization's involvement in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_InvoiceRole a owl:Class ; 
    rdfs:label "Invoice Role" ;
    rdfs:comment "A role played in the context of an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_BuyerRole a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ; 
    rdfs:label "Buyer Role" ;
    rdfs:comment "The role of buyer in an invoice." .

:Cl_SellerRole a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ; 
    rdfs:label "Seller Role" ;
    rdfs:comment "The role of seller in an invoice." .

:Cl_PayerRole a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Payer Role" ;
    rdfs:comment "The role of payer in an invoice." .

:Cl_PayeeRole a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Payee Role" ;
    rdfs:comment "The role of payee in an invoice." .

:Cl_InvoiceParticipantRole a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceRole ;
    rdfs:label "Invoice Participant Role" ;
    rdfs:comment "A participant role in an invoice." .

:Cl_BusinessMessage a owl:Class ; 
    rdfs:label "Business Message" ; 
    rdfs:comment "A superclass for business-related messages." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_EDIFACTMessage a owl:Class ; 
    rdfs:subClassOf :Cl_BusinessMessage ; 
    rdfs:label "EDIFACT Message" ; 
    rdfs:comment "A structured message conforming to the EDIFACT standard." .

:Cl_EDIFACTMessageContent a owl:Class ; 
    rdfs:label "EDIFACT Message Content" ; 
    rdfs:comment "A pivot class (reification) representing the inclusion of a document (such as Invoice) in an EDIFACT message." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BusinessProcess a owl:Class ; 
    rdfs:label "Business Process" ; 
    rdfs:comment "A business process in the organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Assignment a owl:Class ; 
    rdfs:label "Assignment" ; 
    rdfs:comment "A reification class representing the assignment of a document (e.g., invoice) to a business process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format used for business documents." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FileFormatSpecification a owl:Class ;
    rdfs:label "File Format Specification" ;
    rdfs:comment "A specification for a file format." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_RequiredInformation a owl:Class ;
    rdfs:label "Required Information" ;
    rdfs:comment "Information required by a file format specification." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_FileComponent a owl:Class ;
    rdfs:label "File Component" ;
    rdfs:comment "A component of a file format." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule for validating information in a file format." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InformationRequirement a owl:Class ;
    rdfs:label "Information Requirement" ;
    rdfs:comment "A requirement for information in a file format specification." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_DataType a owl:Class ;
    rdfs:label "Data Type" ;
    rdfs:comment "A data type used in file formats." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint on a validation rule or required information." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ValidFileFormat a owl:Class ;
    rdfs:label "Valid File Format" ;
    rdfs:comment "A file format that meets all validation requirements." ;
    rdfs:subClassOf :Cl_FileFormat .

:Cl_Item a owl:Class ; 
    rdfs:label "Item" ; 
    rdfs:comment "An item that is being sold." ; 
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_SaleDisplayInfo a owl:Class ; 
    rdfs:label "Sale Display Info" ; 
    rdfs:comment "Reification class representing the information displayed about an item being sold." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_ItemAttribute a owl:Class ; 
    rdfs:label "Item Attribute" ; 
    rdfs:comment "A general superclass for all item attributes displayed." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_ItemName a owl:Class ; 
    rdfs:label "Item Name" ; 
    rdfs:comment "The name of the item." ; 
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemPrice a owl:Class ; 
    rdfs:label "Item Price" ; 
    rdfs:comment "The price of the item." ; 
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemDescription a owl:Class ; 
    rdfs:label "Item Description" ; 
    rdfs:comment "The description of the item." ; 
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_ItemImage a owl:Class ; 
    rdfs:label "Item Image" ; 
    rdfs:comment "The image of the item." ; 
    rdfs:subClassOf :Cl_ItemAttribute .

:Cl_Organization a owl:Class ; 
    rdfs:label "Organization" ;
    rdfs:comment "An organization involved in business processes." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Company a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ; 
    rdfs:label "Company" ;
    rdfs:comment "A company as a type of organization." .

:Cl_NonProfit a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ; 
    rdfs:label "NonProfit Organization" ;
    rdfs:comment "A non-profit organization." .

:Cl_GovernmentAgency a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ; 
    rdfs:label "Government Agency" ;
    rdfs:comment "A government agency organization." .

:Cl_OrganizationInfoDisplay a owl:Class ; 
    rdfs:label "Organization Info Display" ;
    rdfs:comment "Reification class representing the display of organization information." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Address a owl:Class ; 
    rdfs:label "Address" ; 
    rdfs:comment "A postal address." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ContactInfo a owl:Class ; 
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact information for an organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Logo a owl:Class ; 
    rdfs:label "Logo" ;
    rdfs:comment "A logo for an organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_OrganizationRole a owl:Class ; 
    rdfs:label "Organization Role" ;
    rdfs:comment "A role played by an organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_OrganizationDescription a owl:Class ; 
    rdfs:label "Organization Description" ;
    rdfs:comment "A textual description of an organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Person a owl:Class ; 
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Person" ;
    rdfs:comment "A person involved in business processes." .

:Cl_Buyer a owl:Class ; 
    rdfs:subClassOf :Cl_Person ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person who buys items." .

:Cl_BuyerAddressAssignment a owl:Class ; 
    rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of an address to a buyer." .

:Cl_Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "A party in a business process." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Customer a owl:Class ; 
    rdfs:subClassOf :Cl_Person, :Cl_Organization ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer (person or organization)." .

:Cl_Supplier a owl:Class ; 
    rdfs:subClassOf :Cl_Organization ;
    rdfs:label "Supplier" ;
    rdfs:comment "A supplier organization." .

:Cl_ProductOrService a owl:Class ;
    rdfs:label "Product Or Service" ;
    rdfs:comment "A product or service referenced in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount" ;
    rdfs:comment "A monetary amount associated with an invoice." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_MonetaryValue a owl:Class ; 
    rdfs:label "Monetary Value" ; 
    rdfs:comment "Superclass for all monetary values." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "A currency used in monetary values." ;
    rdfs:subClassOf :Cl_InvoiceElement .

:Cl_PriceComponent a owl:Class ; 
    rdfs:subClassOf :Cl_InvoiceElement ;
    rdfs:label "Price Component" ;
    rdfs:comment "A component of a price." .

:Cl_NetPriceComponent a owl:Class ; 
    rdfs:subClassOf :Cl_PriceComponent ;
    rdfs:label "Net Price Component" ;
    rdfs:comment "A price component representing the net amount." .

#################################################################
# Class Hierarchies and Disjointness
#################################################################

:Cl_InvoiceName owl:disjointWith :Cl_InvoicePrice, :Cl_InvoiceDescription, :Cl_InvoiceImage .
:Cl_Company owl:disjointWith :Cl_NonProfit, :Cl_GovernmentAgency, :Cl_Supplier, :Cl_Customer .
:Cl_NonProfit owl:disjointWith :Cl_GovernmentAgency .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole, :Cl_PayerRole, :Cl_PayeeRole .
:Cl_SellerRole owl:disjointWith :Cl_PayerRole, :Cl_PayeeRole .
:Cl_PayerRole owl:disjointWith :Cl_PayeeRole .
:Cl_Invoice owl:disjointWith :Cl_InvoiceIdentifier, :Cl_Item, :Cl_InvoiceLine, :Cl_PriceComponent, :Cl_Currency, :Cl_BusinessProcess, :Cl_Assignment, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_EDIFACTMessage, :Cl_Document .
:Cl_Item owl:disjointWith :Cl_InvoiceLine, :Cl_PriceComponent, :Cl_Currency .
:Cl_InvoiceLine owl:disjointWith :Cl_PriceComponent, :Cl_Currency .
:Cl_PriceComponent owl:disjointWith :Cl_Currency .
:Cl_Person owl:disjointWith :Cl_Organization .
:Cl_Customer owl:disjointWith :Cl_Supplier .
:Cl_InvoiceDetailRecord owl:disjointWith :Cl_Invoice .
:Cl_ProductOrService owl:disjointWith :Cl_Invoice .
:Cl_MonetaryAmount owl:disjointWith :Cl_Invoice .
:Cl_Currency owl:disjointWith :Cl_Invoice .
:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_Document .
:Cl_Invoice owl:disjointWith :Cl_EDIFACTMessageContent .
:Cl_EDIFACTMessageContent owl:disjointWith :Cl_Document, :Cl_Invoice .
:Cl_Buyer owl:disjointWith :Cl_Address, :Cl_BuyerAddressAssignment .
:Cl_Address owl:disjointWith :Cl_BuyerAddressAssignment .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment, :Cl_Document .
:Cl_FileFormat owl:disjointWith :Cl_RequiredInformation, :Cl_FileComponent, :Cl_ValidationRule, :Cl_InformationRequirement, :Cl_DataType, :Cl_Constraint .

#################################################################
# Object Properties
#################################################################

# Fix P05: Remove all incorrect owl:inverseOf relationships that are not true inverses.
# Only keep owl:inverseOf where the domain/range are correct and the relationship is truly inverse.

:hasDocument a owl:ObjectProperty ; 
    rdfs:domain :Cl_EDIFACTMessageContent ; 
    rdfs:range :Cl_Document ; 
    rdfs:label "has document" ; 
    rdfs:comment "Links an EDIFACT message content to a document (e.g., invoice) it contains." ;
    owl:inverseOf :isDocumentOfMessageContent .

:isDocumentOfMessageContent a owl:ObjectProperty ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_EDIFACTMessageContent ;
    rdfs:label "is document of message content" ;
    rdfs:comment "Inverse of hasDocument." ;
    owl:inverseOf :hasDocument .

:isDocumentInMessage a owl:ObjectProperty ; 
    rdfs:domain :Cl_EDIFACTMessageContent ; 
    rdfs:range :Cl_EDIFACTMessage ; 
    rdfs:label "is document in message" ; 
    rdfs:comment "Links an EDIFACT message content to the EDIFACT message in which the document appears." ;
    owl:inverseOf :hasMessageContent .

:hasMessageContent a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_EDIFACTMessageContent ;
    rdfs:label "has message content" ;
    rdfs:comment "Inverse of isDocumentInMessage." ;
    owl:inverseOf :isDocumentInMessage .

:hasInvoice a owl:ObjectProperty ; 
    rdfs:domain :Cl_EDIFACTMessage ; 
    rdfs:range :Cl_Invoice ; 
    rdfs:subPropertyOf :hasDocument ; 
    rdfs:label "has invoice" ; 
    rdfs:comment "Directly links an EDIFACT message to an invoice (for convenience, but detailed modeling uses the pivot class)." ;
    owl:inverseOf :listedInMessage .

:listedInMessage a owl:ObjectProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range :Cl_EDIFACTMessage ; 
    rdfs:label "listed in message" ; 
    rdfs:comment "Inverse relation: an invoice is listed in a message." ;
    owl:inverseOf :hasInvoice .

:includesMessageContent a owl:ObjectProperty ; 
    rdfs:domain :Cl_EDIFACTMessage ; 
    rdfs:range :Cl_EDIFACTMessageContent ; 
    rdfs:label "includes message content" ; 
    rdfs:comment "Links an EDIFACT message to its content (pivot class for reification)." .

:isIncludedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessageContent ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "is included in message" ;
    rdfs:comment "Inverse of includesMessageContent." .

:contentDescribesDocument a owl:ObjectProperty ; 
    rdfs:domain :Cl_EDIFACTMessageContent ; 
    rdfs:range :Cl_Document ; 
    rdfs:label "content describes document" ; 
    rdfs:comment "Links the message content to the document it describes (e.g., invoice)." .

:isDescribedByContent a owl:ObjectProperty ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_EDIFACTMessageContent ;
    rdfs:label "is described by content" ;
    rdfs:comment "Inverse of contentDescribesDocument." .

:hasOrganization a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceInvolvement ; 
    rdfs:range :Cl_Organization ; 
    rdfs:label "has organization" ;
    rdfs:comment "Links an invoice involvement to the organization." ;
    owl:inverseOf :isOrganizationOfInvolvement .

:isOrganizationOfInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceInvolvement ;
    rdfs:label "is organization of involvement" ;
    rdfs:comment "Inverse of hasOrganization." ;
    owl:inverseOf :hasOrganization .

:hasOrganizationInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization info" ;
    rdfs:comment "Links organization info display to the organization." ;
    rdfs:seeAlso :Cl_Organization ;
    owl:inverseOf :isOrganizationInfoOf .

:isOrganizationInfoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInfoDisplay ;
    rdfs:label "is organization info of" ;
    rdfs:comment "Inverse of hasOrganizationInfo." ;
    owl:inverseOf :hasOrganizationInfo .

:involvesInvoice a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceInvolvement ; 
    rdfs:range :Cl_Invoice ;
    rdfs:label "involves invoice" ;
    rdfs:comment "Links an invoice involvement to the invoice." ;
    owl:inverseOf :hasInvoiceInvolvement .

:hasInvoiceInvolvement a owl:ObjectProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range :Cl_InvoiceInvolvement ;
    rdfs:label "has invoice involvement" ;
    rdfs:comment "Links an invoice to its involvement(s)." ;
    owl:inverseOf :involvesInvoice .

:hasInvoiceRole a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceInvolvement ; 
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Links an invoice involvement to its invoice role." ;
    owl:inverseOf :isInvoiceRoleOfInvolvement .

:isInvoiceRoleOfInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceInvolvement ;
    rdfs:label "is invoice role of involvement" ;
    rdfs:comment "Inverse of hasInvoiceRole." ;
    owl:inverseOf :hasInvoiceRole .

:performedBy a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceRole ; 
    rdfs:range :Cl_Organization ;
    rdfs:label "performed by" ;
    rdfs:comment "The organization performing this invoice role." ;
    owl:inverseOf :performsRole .

:performsRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "performs role" ;
    rdfs:comment "The invoice role performed by the organization." ;
    owl:inverseOf :performedBy .

:roleType a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceRole ; 
    rdfs:range :Cl_InvoiceParticipantRole ;
    rdfs:label "role type" ;
    rdfs:comment "The type of invoice participant role." ;
    owl:inverseOf :isTypeOfRole .

:isTypeOfRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipantRole ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "is type of role" ;
    rdfs:comment "The invoice role this participant role is a type of." ;
    owl:inverseOf :roleType .

:invoiceParticipant a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceRole ; 
    rdfs:range :Cl_Organization ; 
    rdfs:label "invoice participant" ;
    rdfs:comment "Links an invoice role to the participating organization." ;
    owl:inverseOf :participatesInInvoiceRole .

:participatesInInvoiceRole a owl:ObjectProperty ; 
    rdfs:domain :Cl_Organization ; 
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "participates in invoice role" ;
    rdfs:comment "Links an organization to an invoice role it participates in." ;
    owl:inverseOf :invoiceParticipant .

:inInvoice a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceRole ; 
    rdfs:range :Cl_Invoice ;
    rdfs:label "in invoice" ;
    rdfs:comment "Links an invoice role to the invoice." ;
    owl:inverseOf :hasInvoiceRoleOf .

:hasInvoiceRoleOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role of" ;
    rdfs:comment "Links an invoice to an invoice role." ;
    owl:inverseOf :inInvoice .

:hasInvoiceParticipation a owl:ObjectProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range :Cl_InvoiceParticipation ; 
    rdfs:label "has invoice participation" ;
    rdfs:comment "Links an invoice to its participation(s)." ;
    owl:inverseOf :isParticipationOfInvoice .

:isParticipationOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is participation of invoice" ;
    rdfs:comment "Inverse of hasInvoiceParticipation." ;
    owl:inverseOf :hasInvoiceParticipation .

:involvesOrganization a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceParticipation ; 
    rdfs:range :Cl_Organization ; 
    rdfs:label "involves organization" ;
    rdfs:comment "Links an invoice participation to the involved organization." ;
    owl:inverseOf :isOrganizationInParticipation .

:isOrganizationInParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is organization in participation" ;
    rdfs:comment "Inverse of involvesOrganization." ;
    owl:inverseOf :involvesOrganization .

:hasRole a owl:ObjectProperty ; 
    rdfs:domain :Cl_InvoiceParticipation ; 
    rdfs:range :Cl_InvoiceRole ; 
    rdfs:label "has role in invoice" ;
    rdfs:comment "Links an invoice participation to its invoice role." ;
    owl:inverseOf :isRoleInParticipation .

:isRoleInParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is role in participation" ;
    rdfs:comment "Inverse of hasRole." ;
    owl:inverseOf :hasRole .

:hasAddress a owl:ObjectProperty ; 
    rdfs:domain :Cl_Organization ; 
    rdfs:range :Cl_Address ; 
    rdfs:label "has address" ;
    rdfs:comment "Links an organization to its address." ;
    owl:inverseOf :isAddressOfOrganization .

:isAddressOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is address of organization" ;
    rdfs:comment "Inverse of hasAddress." ;
    owl:inverseOf :hasAddress .

:hasBuyerAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    rdfs:label "has buyer address" ;
    rdfs:comment "Links a buyer address assignment to the address." ;
    owl:inverseOf :isAddressOfAssignment .

:hasContactInfo a owl:ObjectProperty ; 
    rdfs:domain :Cl_Organization ; 
    rdfs:range :Cl_ContactInfo ; 
    rdfs:label "has contact information" ;
    rdfs:comment "Links an organization to its contact information." ;
    owl:inverseOf :isContactInfoOf .

:isContactInfoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_ContactInfo ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is contact info of" ;
    rdfs:comment "Inverse of hasContactInfo." ;
    owl:inverseOf :hasContactInfo .

:hasLogo a owl:ObjectProperty ; 
    rdfs:domain :Cl_Organization ; 
    rdfs:range :Cl_Logo ; 
    rdfs:label "has logo" ;
    rdfs:comment "Links an organization to its logo." ;
    owl:inverseOf :isLogoOf .

:isLogoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Logo ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is logo of" ;
    rdfs:comment "Inverse of hasLogo." ;
    owl:inverseOf :hasLogo .

:hasOrganizationRole a owl:ObjectProperty ; 
    rdfs:domain :Cl_Organization ; 
    rdfs:range :Cl_OrganizationRole ; 
    rdfs:label "has organization role" ;
