#################################################################
# Data Properties
#################################################################

# (No changes required for data properties for P05)

:organizationName a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Organization ; 
    rdfs:range xsd:string ; 
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization." .

:addressLine a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Address ; 
    rdfs:range xsd:string ; 
    rdfs:label "address line" ;
    rdfs:comment "A line in the address." .

:city a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Address ; 
    rdfs:range xsd:string ; 
    rdfs:label "city" ;
    rdfs:comment "The city of the address." .

:postalCode a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Address ; 
    rdfs:range xsd:string ; 
    rdfs:label "postal code" ;
    rdfs:comment "The postal code of the address." .

:country a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Address ; 
    rdfs:range xsd:string ; 
    rdfs:label "country" ;
    rdfs:comment "The country of the address." .

:email a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ContactInfo ; 
    rdfs:range xsd:string ; 
    rdfs:label "email" ;
    rdfs:comment "Email address." .

:phoneNumber a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ContactInfo ; 
    rdfs:range xsd:string ; 
    rdfs:label "phone number" ;
    rdfs:comment "Phone number." .

:website a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ContactInfo ; 
    rdfs:range xsd:string ; 
    rdfs:label "website" ;
    rdfs:comment "Website URL." .

:logoURL a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Logo ; 
    rdfs:range xsd:string ; 
    rdfs:label "logo URL" ;
    rdfs:comment "URL of the logo image." .

:roleName a owl:DatatypeProperty ; 
    rdfs:domain :Cl_OrganizationRole ; 
    rdfs:range xsd:string ; 
    rdfs:label "role name" ;
    rdfs:comment "Name of the organization role." .

:organizationDescriptionText a owl:DatatypeProperty ; 
    rdfs:domain :Cl_OrganizationDescription ; 
    rdfs:range xsd:string ; 
    rdfs:label "organization description text" ;
    rdfs:comment "Textual description of the organization." .

:street a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Address ; 
    rdfs:range xsd:string ;
    rdfs:label "street" ;
    rdfs:comment "Street name and number." .

:invoiceNumber a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The invoice number as a string." .

:invoiceDate a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range xsd:date ;
    rdfs:label "invoice date" ;
    rdfs:comment "The date the invoice was issued." .

:dueDate a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range xsd:date ;
    rdfs:label "due date" ;
    rdfs:comment "The due date for payment on the invoice." .

:description a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ProductOrService ; 
    rdfs:range xsd:string ;
    rdfs:label "description" ;
    rdfs:comment "Description of the product or service." .

:quantity a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceDetailRecord ; 
    rdfs:range xsd:decimal ;
    rdfs:label "quantity" ;
    rdfs:comment "Quantity of product or service in the invoice detail record." .

:unitPrice a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceDetailRecord ; 
    rdfs:range xsd:decimal ;
    rdfs:label "unit price" ;
    rdfs:comment "Unit price in the invoice detail record." .

:lineTotal a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceDetailRecord ; 
    rdfs:range xsd:decimal ;
    rdfs:label "line total" ;
    rdfs:comment "Total amount for the invoice detail record." .

:amountValue a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceAmount ; 
    rdfs:range xsd:decimal ; 
    rdfs:label "amount value" ;
    rdfs:comment "The value of a monetary amount." .

