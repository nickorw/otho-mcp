    rdfs:range xsd:decimal ;
    rdfs:label "total line amount" ;
    rdfs:comment "Total amount for the invoice line." .

:itemNameValue a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ItemName ; 
    rdfs:range xsd:string ; 
    rdfs:label "item name value" ; 
    rdfs:comment "The value of the item's name." .

:itemPriceValue a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ItemPrice ; 
    rdfs:range xsd:decimal ; 
    rdfs:label "item price value" ; 
    rdfs:comment "The value of the item's price." .

:itemDescriptionValue a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ItemDescription ; 
    rdfs:range xsd:string ; 
    rdfs:label "item description value" ; 
    rdfs:comment "The value of the item's description." .

:itemImageURL a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ItemImage ; 
    rdfs:range xsd:anyURI ; 
    rdfs:label "item image URL" ; 
    rdfs:comment "The URL of the item's image." .

:invoiceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ; 
    rdfs:domain :Cl_InvoiceIdentifier ; 
    rdfs:range xsd:string ; 
    rdfs:label "invoice number value" ; 
    rdfs:comment "The actual alphanumeric value of the invoice identifier (number)." .

:assignmentDate a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Assignment ; 
    rdfs:range xsd:dateTime ; 
    rdfs:label "assignment date" ; 
    rdfs:comment "The date and time when the assignment of the invoice to the business process was made." .

:netAmount a owl:DatatypeProperty , owl:FunctionalProperty ; 
    rdfs:domain :Cl_PriceComponent ; 
    rdfs:range xsd:decimal ;
    rdfs:label "net amount" ;
    rdfs:comment "Net amount of the price component." .

:priceComponentType a owl:DatatypeProperty , owl:FunctionalProperty ; 
    rdfs:domain :Cl_PriceComponent ; 
    rdfs:range xsd:string ;
    rdfs:label "price component type" ;
    rdfs:comment "Type of price component." .

:informationName a owl:DatatypeProperty ; 
    rdfs:domain :Cl_RequiredInformation ; 
    rdfs:range xsd:string ;
    rdfs:label "information name" ;
    rdfs:comment "Name of the required information." .

:dataTypeName a owl:DatatypeProperty ; 
    rdfs:domain :Cl_DataType ; 
    rdfs:range xsd:string ;
    rdfs:label "data type name" ;
    rdfs:comment "Name of the data type." .

:constraintExpression a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Constraint ; 
    rdfs:range xsd:string ;
    rdfs:label "constraint expression" ;
    rdfs:comment "Expression of the constraint." .

:validationRuleDescription a owl:DatatypeProperty ; 
    rdfs:domain :Cl_ValidationRule ; 
    rdfs:range xsd:string ;
    rdfs:label "validation rule description" ;
    rdfs:comment "Description of the validation rule." .

:fileFormatName a owl:DatatypeProperty ; 
    rdfs:domain :Cl_FileFormat ; 
    rdfs:range xsd:string ;
    rdfs:label "file format name" ;
    rdfs:comment "Name of the file format." .

:specificationVersion a owl:DatatypeProperty ; 
    rdfs:domain :Cl_FileFormatSpecification ; 
    rdfs:range xsd:string ;
    rdfs:label "specification version" ;
    rdfs:comment "Version of the file format specification." .

:roleLabel a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceRole ; 
    rdfs:range xsd:string ;
    rdfs:label "role label" ;
    rdfs:comment "Label for the invoice role." .

#################################################################
# Restrictions and General Class Axioms
#################################################################

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :invoiceAmountAssignmentOf ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :assignsInvoiceAmount ; owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceIdentifier owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:allValuesFrom xsd:string
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceIdentifier ;
    owl:someValuesFrom :Cl_InvoiceIdentifier
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:someValuesFrom :Cl_InvoiceDetailRecord ]
        [ a owl:Restriction ; owl:onProperty :invoiceNumber ; owl:someValuesFrom xsd:string ]
        [ a owl:Restriction ; owl:onProperty :invoiceDate ; owl:someValuesFrom xsd:date ]
        [ a owl:Restriction ; owl:onProperty :hasSupplier ; owl:someValuesFrom :Cl_Supplier ]
        [ a owl:Restriction ; owl:onProperty :hasCustomer ; owl:someValuesFrom :Cl_Customer ]
    )
] .

:Cl_InvoiceDetailRecord owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involvesProductOrService ; owl:someValuesFrom :Cl_ProductOrService ]
        [ a owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ a owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
        [ a owl:Restriction ; owl:onProperty :lineTotal ; owl:someValuesFrom xsd:decimal ]
    )
] .

:Cl_InvoiceInvolvement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :involvesInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_InvoiceRole owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :performedBy ; owl:allValuesFrom :Cl_Organization
] .
:Cl_InvoiceRole owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :roleType ; owl:allValuesFrom :Cl_InvoiceParticipantRole
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :refersToItem ;
        owl:allValuesFrom :Cl_Item
    ]
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceLine ;
        owl:allValuesFrom :Cl_InvoiceLine
    ]
] .

:Cl_InvoiceLine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasPriceComponent ;
    owl:someValuesFrom :Cl_PriceComponent
] .

:Cl_NetPriceComponent owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :priceComponentType ;
    owl:hasValue "net"
] .

:Cl_OrganizationDescription owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :organizationDescriptionText ;
    owl:allValuesFrom xsd:string
] .

:Cl_Logo owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :logoURL ;
    owl:allValuesFrom xsd:string
] .

:Cl_Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :organizationName ;
    owl:someValuesFrom xsd:string
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :hasBuyer ; owl:allValuesFrom :Cl_Buyer
] .
:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :hasBuyerAddress ; owl:allValuesFrom :Cl_Address
] .

:Cl_EDIFACTMessageContent owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :isDocumentInMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ a owl:Restriction ; owl:onProperty :hasDocument ; owl:someValuesFrom :Cl_Document ]
    )
] .

:Cl_SaleDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :displayedItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasDisplayedAttribute ; owl:someValuesFrom :Cl_ItemAttribute ]
    )
] .

:Cl_ItemAttribute owl:disjointUnionOf ( :Cl_ItemName :Cl_ItemPrice :Cl_ItemDescription :Cl_ItemImage ) .
:Cl_ItemAttribute owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        :Cl_ItemName
        :Cl_ItemPrice
        :Cl_ItemDescription
        :Cl_ItemImage
    )
] .

:Cl_FileFormat owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasSpecification ;
    owl:someValuesFrom :Cl_FileFormatSpecification
] .

:Cl_FileFormatSpecification owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :requiresInformation ;
    owl:someValuesFrom :Cl_InformationRequirement
] .

:Cl_InformationRequirement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :requiredInformation ; owl:someValuesFrom :Cl_RequiredInformation ]
        [ a owl:Restriction ; owl:onProperty :hasValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
        [ a owl:Restriction ; owl:onProperty :specification ; owl:someValuesFrom :Cl_FileFormatSpecification ]
    )
] .

:Cl_ValidFileFormat owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_FileFormat
        [ a owl:Restriction ;
          owl:onProperty :hasSpecification ;
          owl:allValuesFrom [
              a owl:Restriction ;
              owl:onProperty :requiresInformation ;
              owl:allValuesFrom [
                  a owl:Restriction ;
                  owl:onProperty :hasValidationRule ;
                  owl:allValuesFrom :Cl_ValidationRule
              ]
          ]
        ]
    )
] .

:Cl_Assignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignedInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .
:Cl_Assignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :assignedBusinessProcess ;
    owl:allValuesFrom :Cl_BusinessProcess
] .

#################################################################
# Annotation property for P04 connection
#################################################################

:entityHasRepresentation a owl:ObjectProperty ;
    rdfs:domain :Cl_Entity ;
    rdfs:range :Cl_OrganizationInfoDisplay ;
    rdfs:label "entity has representation" ;
    rdfs:comment "A generic connection property for linking entities to their representations (for ontology connectivity)." .

#################################################################
# Naming conventions fix (P22)
#################################################################

# Rename Cl_OrganizationInfoDisplay to Cl_OrganizationInfo_Display
# and hasInvoiceParticipation to hasInvoice_Participation, with respective changes in their usage.

:Cl_OrganizationInfo_Display a owl:Class ;
    rdfs:label "Organization Info Display" ;
    rdfs:comment "Reification class representing the display of organization information." ;
    rdfs:subClassOf :Cl_Entity .

:isOrganizationInfoOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInfo_Display ;
    rdfs:label "is organization info of" ;
    rdfs:comment "Inverse of hasOrganizationInfo." ;
    owl:inverseOf :hasOrganizationInfo .

:hasOrganizationInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfo_Display ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization info" ;
    rdfs:comment "Links organization info display to the organization." ;
    rdfs:seeAlso :Cl_Organization ;
    owl:inverseOf :isOrganizationInfoOf .

:hasInvoice_Participation a owl:ObjectProperty ; 
    rdfs:domain :Cl_Invoice ; 
    rdfs:range :Cl_InvoiceParticipation ; 
    rdfs:label "has invoice participation" ;
    rdfs:comment "Links an invoice to its participation(s)." ;
    owl:inverseOf :isParticipationOfInvoice .

:isParticipationOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is participation of invoice" ;
    rdfs:comment "Inverse of hasInvoice_Participation." ;
    owl:inverseOf :hasInvoice_Participation .

#################################################################
# Annotation property corrections for P20
#################################################################

# Remove or correct misused rdfs:label/rdfs:comment on object properties (examples given)
:isDetailOfInvoice rdfs:label "is detail of invoice" ;
    rdfs:comment "Inverse of hasInvoiceDetail." .

:isDescribedByContent rdfs:label "is described by content" ;
    rdfs:comment "Inverse of contentDescribesDocument." .

:isAddressOfOrganization rdfs:label "is address of organization" ;
    rdfs:comment "Inverse of hasAddress." .

:isIdentifierOfInvoice rdfs:label "is identifier of invoice" ;
    rdfs:comment "Inverse of hasInvoiceIdentifier." .

:invoiceAmountAssignedBy rdfs:label "invoice amount assigned by" ;
    rdfs:comment "Inverse of assignsInvoiceAmount." .

#################################################################
# End of Ontology
#################################################################