    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal ;
    rdfs:label "amount value (monetary amount)" ;
    rdfs:comment "The value of a monetary amount (for Cl_MonetaryAmount)." .

:currency a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceAmount ; 
    rdfs:range xsd:string ; 
    rdfs:label "currency" ;
    rdfs:comment "Currency code for the invoice amount." .

:currencyCode a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Currency ; 
    rdfs:range xsd:string ;
    rdfs:label "currency code" ;
    rdfs:comment "Currency code (e.g., USD, EUR)." .

:itemName a owl:DatatypeProperty ; 
    rdfs:domain :Cl_Item ; 
    rdfs:range xsd:string ;
    rdfs:label "item name" ;
    rdfs:comment "Name of the item." .

:quantitySold a owl:DatatypeProperty ; 
    rdfs:domain :Cl_InvoiceLine ; 
    rdfs:range xsd:integer ;
    rdfs:label "quantity sold" ;
    rdfs:comment "Quantity sold for the invoice line." .

