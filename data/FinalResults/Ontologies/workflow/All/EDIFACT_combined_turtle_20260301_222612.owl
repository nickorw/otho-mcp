@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests>
    a owl:Ontology ;
    owl:versionIRI <http://example.org/fests/v1> .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class ;
    rdfs:label "Document" .

:Cl_FinancialDocument a owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document , :Cl_FinancialDocument ;
    rdfs:label "Invoice" .

:Cl_MessageInvoiceListing a owl:Class .

:Cl_Entity a owl:Class .

:Cl_Actor a owl:Class .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Entity, :Cl_Actor ;
    rdfs:label "Organization" ;
    rdfs:comment "A group such as a company, institution, or association involved in the scenario." .

:Cl_Company a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Supplier a owl:Class ;
    rdfs:subClassOf :Cl_Organization .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Organization, :Cl_Actor .

:Cl_Employee a owl:Class ;
    rdfs:subClassOf :Cl_Actor .

:Cl_InvoiceOrganizationInvolvement a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceRoleAssignment a owl:Class .

:Cl_InvoiceRole a owl:Class .

:Cl_SupplierRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_CustomerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_IssuerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_RecipientRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_InvoiceParticipation a owl:Class .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_OrganizationInfoDisplay a owl:Class ;
    rdfs:label "Organization Info Display" ;
    rdfs:comment "Reification class capturing the information displayed about an involved organization." .

:Cl_OrganizationInfoElement a owl:Class ;
    rdfs:label "Organization Info Element" ;
    rdfs:comment "SuperClass for all pieces of information that can be displayed about an organization." .

:Cl_OrganizationName a owl:Class ;
    rdfs:label "Organization Name" ;
    rdfs:comment "The name of the organization." ;
    rdfs:subClassOf :Cl_OrganizationInfoElement .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "The role or capacity in which the organization is involved." ;
    rdfs:subClassOf :Cl_OrganizationInfoElement .

:Cl_OrganizationContactInfo a owl:Class ;
    rdfs:label "Organization Contact Info" ;
    rdfs:comment "Contact information for the organization." ;
    rdfs:subClassOf :Cl_OrganizationInfoElement .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A textual description of the organization." ;
    rdfs:subClassOf :Cl_OrganizationInfoElement .

:Cl_Person a owl:Class .

:Cl_Stakeholder a owl:Class .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person, :Cl_Stakeholder .

:Cl_Address a owl:Class .

:Cl_BuyerAddressAssignment a owl:Class .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Represents an item that is sold." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "Pivot class representing the sale of an item in an invoice, with quantity, unit price, and net price." .

:Cl_Quantity a owl:Class .

:Cl_Price a owl:Class ;
    rdfs:comment "Superclass for all price-related concepts." .

:Cl_Amount a owl:Class ;
    rdfs:subClassOf :Cl_Price, :Cl_MonetaryValue ;
    rdfs:comment "Represents a monetary amount." .

:Cl_NetPrice a owl:Class ;
    rdfs:subClassOf :Cl_Amount ;
    rdfs:comment "Represents the net price amount for an invoice line." .

:Cl_Currency a owl:Class ;
    rdfs:subClassOf :Cl_Price .

:Cl_MonetaryValue a owl:Class .

:Cl_InvoiceEvent a owl:Class .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceEvent .

:Cl_InvoiceIdentification a owl:Class ;
    rdfs:label "Invoice Identification" ;
    rdfs:comment "Reification class for associating an Invoice with its invoice number." .

:Cl_FileFormat a owl:Class .

:Cl_FileSpecification a owl:Class .

:Cl_Field a owl:Class .

:Cl_FieldConstraint a owl:Class .

:Cl_FieldType a owl:Class .

:Cl_FieldValue a owl:Class .

:Cl_ValidationRule a owl:Class .

:Cl_RequiredField a owl:Class ;
    rdfs:subClassOf :Cl_Field .

:Cl_OptionalField a owl:Class ;
    rdfs:subClassOf :Cl_Field .

:Cl_FormatValidityRequirement a owl:Class .

:Cl_FileFormatValidityInfo a owl:Class .

:Cl_BusinessProcess a owl:Class .

:Cl_Assignment a owl:Class .

:Cl_SaleDisplayInformation a owl:Class ;
    rdfs:label "Sale Display Information" ;
    rdfs:comment "A reification class capturing the information displayed about an item sold." .

:Cl_DisplayableAttribute a owl:Class ;
    rdfs:label "Displayable Attribute" ;
    rdfs:comment "Superclass for all attributes that can be displayed about an item." .

:Cl_ItemName a owl:Class ;
    rdfs:label "Item Name" ;
    rdfs:comment "The name of the item." ;
    rdfs:subClassOf :Cl_DisplayableAttribute .

:Cl_ItemPrice a owl:Class ;
    rdfs:label "Item Price" ;
    rdfs:comment "The price of the item." ;
    rdfs:subClassOf :Cl_DisplayableAttribute .

:Cl_ItemDescription a owl:Class ;
    rdfs:label "Item Description" ;
    rdfs:comment "The description of the item." ;
    rdfs:subClassOf :Cl_DisplayableAttribute .

:Cl_ItemCategory a owl:Class ;
    rdfs:label "Item Category" ;
    rdfs:comment "The category of the item." ;
    rdfs:subClassOf :Cl_DisplayableAttribute .

:Cl_ItemImage a owl:Class ;
    rdfs:label "Item Image" ;
    rdfs:comment "The image of the item." ;
    rdfs:subClassOf :Cl_DisplayableAttribute .

:Cl_InvoiceDetail a owl:Class .

:Cl_Payment a owl:Class .

:Cl_InvoiceDetailReification a owl:Class .

#################################################################
# Disjointness and Disjoint Unions
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_Company owl:disjointWith :Cl_Supplier, :Cl_Customer .
:Cl_Customer owl:disjointWith :Cl_Supplier .
:Cl_Organization owl:disjointWith :Cl_Invoice, :Cl_InvoiceRoleAssignment, :Cl_InvoiceDetailReification .
:Cl_InvoiceRoleAssignment owl:disjointWith :Cl_Invoice, :Cl_InvoiceRole .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Buyer owl:disjointWith :Cl_Address, :Cl_BuyerAddressAssignment .
:Cl_Address owl:disjointWith :Cl_BuyerAddressAssignment .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Amount owl:disjointWith :Cl_Currency .
:Cl_NetPrice owl:disjointWith :Cl_Currency .
:Cl_Invoice owl:disjointWith :Cl_Amount, :Cl_MonetaryValue, :Cl_BusinessProcess, :Cl_Assignment, :Cl_InvoiceIdentification .
:Cl_InvoiceEvent owl:disjointWith :Cl_MonetaryValue .
:Cl_Customer owl:disjointWith :Cl_Employee .
:Cl_Employee owl:disjointWith :Cl_Organization .
:Cl_Field owl:disjointWith :Cl_ValidationRule .
:Cl_FieldType owl:disjointWith :Cl_FieldConstraint .
:Cl_FieldConstraint owl:disjointWith :Cl_ValidationRule .
:Cl_RequiredField owl:disjointWith :Cl_OptionalField .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment .
:Cl_FinancialDocument owl:disjointWith :Cl_BusinessProcess .
:Cl_OrganizationName owl:disjointWith :Cl_OrganizationRole, :Cl_OrganizationContactInfo, :Cl_OrganizationDescription .
:Cl_OrganizationRole owl:disjointWith :Cl_OrganizationContactInfo, :Cl_OrganizationDescription .
:Cl_OrganizationContactInfo owl:disjointWith :Cl_OrganizationDescription .
:Cl_ItemName owl:disjointWith :Cl_ItemPrice, :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage .
:Cl_ItemPrice owl:disjointWith :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage .
:Cl_ItemDescription owl:disjointWith :Cl_ItemCategory, :Cl_ItemImage .
:Cl_ItemCategory owl:disjointWith :Cl_ItemImage .

:Cl_Document owl:disjointUnionOf ( :Cl_EDIFACTMessage :Cl_Invoice ) .
:Cl_Item owl:disjointUnionOf ( :Cl_Product :Cl_Service ) .
:Cl_OrganizationInfoElement owl:disjointUnionOf (
    :Cl_OrganizationName
    :Cl_OrganizationRole
    :Cl_OrganizationContactInfo
    :Cl_OrganizationDescription
) .
:Cl_InvoiceRole owl:disjointUnionOf (:Cl_SupplierRole :Cl_CustomerRole :Cl_IssuerRole :Cl_RecipientRole :Cl_BuyerRole :Cl_SellerRole) .

#################################################################
# Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_MessageInvoiceListing .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_MessageInvoiceListing ;
    rdfs:range :Cl_Invoice .

:isListedInMessage a owl:ObjectProperty ;
    owl:inverseOf :listsInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_MessageInvoiceListing .

:messageReferenceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string .

:messageDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:dateTime .

:hasInvoiceOrganizationInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_InvoiceOrganizationInvolvement :Cl_InvoiceRoleAssignment :Cl_InvoiceParticipation ) ] ;
    rdfs:range :Cl_Organization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_InvoiceOrganizationInvolvement :Cl_InvoiceRoleAssignment :Cl_InvoiceParticipation ) ] ;
    rdfs:range :Cl_Invoice .

:organizationRole a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range xsd:string .

:hasInvoiceRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRoleAssignment .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_InvoiceRole .

:isRoleAssignmentOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceRoleAssignment ;
    rdfs:domain :Cl_InvoiceRoleAssignment ;
    rdfs:range :Cl_Invoice .

:isOrganizationInRoleAssignment a owl:ObjectProperty ;
    owl:inverseOf :involvesOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceRoleAssignment .

:isRoleInAssignment a owl:ObjectProperty ;
    owl:inverseOf :hasRole ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRoleAssignment .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoiceRole .

:isInvoiceParticipationOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceParticipation ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:organizationInParticipation a owl:ObjectProperty ;
    owl:inverseOf :involvesOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation .

:roleInParticipation a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceRole ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceParticipation .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" ;
    rdfs:comment "Links the info display to the organization involved." .

:displaysInfoElement a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInfoDisplay ;
    rdfs:range :Cl_OrganizationInfoElement ;
    rdfs:label "displays info element" .

:displayedIn a owl:ObjectProperty ;
    owl:inverseOf :displaysInfoElement ;
    rdfs:domain :Cl_OrganizationInfoElement ;
    rdfs:range :Cl_OrganizationInfoDisplay ;
    rdfs:label "displayed in" .

:organizationNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationName ;
    rdfs:range xsd:string .

:organizationRoleValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string .

:organizationContactValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationContactInfo ;
    rdfs:range xsd:string .

:organizationDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range xsd:string .

:buyerAddressAssignment_buyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer .

:buyerAddressAssignment_address a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address .

:address_street a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:isInvoiceOf a owl:ObjectProperty ;
    owl:inverseOf :hasInvoiceLine ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice .

:invoiceLineItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:itemOfInvoiceLine a owl:ObjectProperty ;
    owl:inverseOf :invoiceLineItem ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceLine .

:hasQuantity a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Quantity .

:hasPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Price .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_NetPrice ;
    rdfs:subPropertyOf :hasPrice .

:isNetPriceOf a owl:ObjectProperty ;
    owl:inverseOf :hasNetPrice ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range :Cl_Currency .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:integer .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:netPrice_value a owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal .

:currency_code a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string .

:quantityValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Quantity ;
    rdfs:range xsd:decimal .

:priceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Price ;
    rdfs:range xsd:decimal .

:itemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Cl_Invoice :Cl_InvoiceIdentification ) ] ;
    rdfs:range xsd:string .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:displayInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_SaleDisplayInformation ;
    rdfs:label "display information" .

:aboutItem a owl:ObjectProperty ;
    rdfs:domain :Cl_SaleDisplayInformation ;
    rdfs:range :Cl_Item ;
    rdfs:label "about item" .

:hasDisplayableAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_SaleDisplayInformation ;
    rdfs:range :Cl_DisplayableAttribute ;
    rdfs:label "has displayable attribute" .

:attributeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayableAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "attribute value" .

:itemNameValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemName ;
    rdfs:range xsd:string ;
    rdfs:label "item name value" .

:itemPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price value" .

:itemDescriptionValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemDescription ;
    rdfs:range xsd:string ;
    rdfs:label "item description value" .

:itemCategoryValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemCategory ;
    rdfs:range xsd:string ;
    rdfs:label "item category value" .

:itemImageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:anyURI ;
    rdfs:label "item image URL" .

:hasInvoiceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:label "links an invoice to its invoice amount event" .

:relatesToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceAmount ;
    rdfs:label "relates the invoice amount event to the invoice" .

:hasMonetaryValue a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range :Cl_Amount ;
    rdfs:label "links the invoice amount event to the monetary value" .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range xsd:decimal ;
    rdfs:label "the numeric value of the amount" .

:amountCurrency a owl:ObjectProperty ;
    rdfs:domain :Cl_Amount ;
    rdfs:range :Cl_Currency ;
    rdfs:label "the currency of the amount" .

:currencyCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Currency ;
    rdfs:range xsd:string ;
    rdfs:label "ISO code for the currency" .

:hasInvoiceIdentification a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentification ;
    rdfs:comment "Relates an Invoice to its InvoiceIdentification (reification node)." .

:identifiesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceIdentification ;
    rdfs:comment "Inverse of hasInvoiceIdentification." .

:hasSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileSpecification .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileSpecification ;
    rdfs:range :Cl_Field .

:hasFieldType a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldType .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldConstraint .

:hasValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FileSpecification ;
    rdfs:range :Cl_ValidationRule .

:isRequiredField a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_RequiredField .

:isOptionalField a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_OptionalField .

:hasFieldValue a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_FieldValue .

:hasFormatValidityRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FormatValidityRequirement .

:validityInfoForFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityInfo ;
    rdfs:range :Cl_FileFormat .

:includesRequiredField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityInfo ;
    rdfs:range :Cl_RequiredField .

:includesFieldConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityInfo ;
    rdfs:range :Cl_FieldConstraint .

:includesValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityInfo ;
    rdfs:range :Cl_ValidationRule .

:includesFieldType a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityInfo ;
    rdfs:range :Cl_FieldType .

:includesFormatValidityRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatValidityInfo ;
    rdfs:range :Cl_FormatValidityRequirement .

:fieldName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:string .

:fieldTypeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldType ;
    rdfs:range xsd:string .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldConstraint ;
    rdfs:range xsd:string .

:validationRuleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range xsd:string .

:validityRequirementDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_FormatValidityRequirement ;
    rdfs:range xsd:string .

:fieldValueLiteral a owl:DatatypeProperty ;
    rdfs:domain :Cl_FieldValue ;
    rdfs:range xsd:string .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_Invoice .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range :Cl_BusinessProcess .

:isInvoiceOfAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Assignment .

:isBusinessProcessOfAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedBusinessProcess ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_Assignment .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:dateTime .

:assignmentId a owl:DatatypeProperty ;
    rdfs:domain :Cl_Assignment ;
    rdfs:range xsd:string .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetailReification .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range :Cl_Product .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range :Cl_Invoice .

:hasCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer .

:hasEmployee a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Employee .

:hasPayment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Payment .

:totalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal .

:detailQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range xsd:integer .

:detailUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range xsd:decimal .

:detailLineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetailReification ;
    rdfs:range xsd:decimal .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string .

:employeeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Employee ;
    rdfs:range xsd:string .

:paymentAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Payment ;
    rdfs:range xsd:decimal .

:paymentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Payment ;
    rdfs:range xsd:date .

#################################################################
# Restrictions and General Class Axioms
#################################################################

:Cl_MessageInvoiceListing owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :listsInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_EDIFACTMessage owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceListing ;
    owl:someValuesFrom :Cl_MessageInvoiceListing
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceOrganizationInvolvement ;
    owl:someValuesFrom :Cl_InvoiceOrganizationInvolvement
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:allValuesFrom :Cl_InvoiceLine
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:allValuesFrom :Cl_InvoiceDetailReification
] .

:Cl_InvoiceOrganizationInvolvement owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:someValuesFrom :Cl_Organization
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :involvesInvoice ;
    owl:someValuesFrom :Cl_Invoice
] .

:Cl_InvoiceRoleAssignment owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasRole ;
    owl:allValuesFrom :Cl_InvoiceRole
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :involvesOrganization ;
    owl:allValuesFrom :Cl_Organization
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :involvesInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:someValuesFrom :Cl_Organization
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceRole ;
          owl:someValuesFrom :Cl_InvoiceRole
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :isInvoiceParticipationOf ;
          owl:someValuesFrom :Cl_Invoice
        ]
    )
] .

:Cl_BuyerRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ rdf:type owl:Restriction ;
          owl:onProperty :roleInParticipation ;
          owl:someValuesFrom [ 
              rdf:type owl:Restriction ;
              owl:onProperty :isInvoiceParticipationOf ;
              owl:someValuesFrom :Cl_Invoice
          ]
        ]
    )
] .

:Cl_OrganizationInfoDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
            owl:onProperty :hasOrganization ;
            owl:someValuesFrom :Cl_Organization
        ]
        [ a owl:Restriction ;
            owl:onProperty :displaysInfoElement ;
            owl:someValuesFrom :Cl_OrganizationInfoElement
        ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerAddressAssignment_buyer ;
          owl:someValuesFrom :Cl_Buyer ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :buyerAddressAssignment_address ;
          owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceLineItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_SaleDisplayInformation owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasDisplayableAttribute ;
    owl:allValuesFrom :Cl_DisplayableAttribute
] .

:Cl_NetPrice owl:equivalentClass [ 
    rdf:type owl:Restriction ;
    owl:onProperty :netPrice_value ;
    owl:allValuesFrom xsd:decimal 
] .

:Cl_InvoiceAmount owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasMonetaryValue ;
    owl:allValuesFrom :Cl_Amount
] .

:Cl_InvoiceIdentification owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :identifiesInvoice ;
    owl:allValuesFrom :Cl_Invoice
] .

:Cl_FileFormat owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasFormatValidityRequirement ;
    owl:allValuesFrom :Cl_FormatValidityRequirement
] .

:Cl_FileFormatValidityInfo owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ owl:onProperty :validityInfoForFormat ; owl:allValuesFrom :Cl_FileFormat ; a owl:Restriction ]
        [ owl:onProperty :includesRequiredField ; owl:someValuesFrom :Cl_RequiredField ; a owl:Restriction ]
        [ owl:onProperty :includesFieldConstraint ; owl:someValuesFrom :Cl_FieldConstraint ; a owl:Restriction ]
        [ owl:onProperty :includesFieldType ; owl:someValuesFrom :Cl_FieldType ; a owl:Restriction ]
        [ owl:onProperty :includesValidationRule ; owl:someValuesFrom :Cl_ValidationRule ; a owl:Restriction ]
        [ owl:onProperty :includesFormatValidityRequirement ; owl:someValuesFrom :Cl_FormatValidityRequirement ; a owl:Restriction ]
    )
] .

:Cl_Assignment
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ;
              owl:onProperty :assignedInvoice ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
              owl:onClass :Cl_Invoice
            ]
            [ a owl:Restriction ;
              owl:onProperty :assignedBusinessProcess ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
              owl:onClass :Cl_BusinessProcess
            ]
        )
    ] .

:Cl_InvoiceDetailReification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasProduct ; owl:allValuesFrom :Cl_Product ]
    )
] .

#################################################################
# End Ontology FestS
#################################################################
