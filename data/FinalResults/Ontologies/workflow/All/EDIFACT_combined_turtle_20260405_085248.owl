#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "The identifier for an invoice." .

:messageID a owl:DatatypeProperty ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "message ID" ;
    rdfs:comment "The unique identifier for an EDIFACT message." .

:listingDate a owl:DatatypeProperty ;
    rdfs:domain :EDIFACTMessageInvoiceListing ;
    rdfs:range xsd:dateTime ;
    rdfs:label "listing date" ;
    rdfs:comment "The date and time when the invoice listing was created or sent." .

:roleDescription a owl:DatatypeProperty ;
    rdfs:domain :InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role description" ;
    rdfs:comment "A human-readable description of the role." .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization." .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role name" ;
    rdfs:comment "The name of the role, such as 'buyer' or 'seller'." .

:organizationTypeName a owl:DatatypeProperty ;
    rdfs:domain :OrganizationType ;
    rdfs:range xsd:string ;
    rdfs:label "organization type name" ;
    rdfs:comment "The name of the organization type." .

:organizationRoleName a owl:DatatypeProperty ;
    rdfs:domain :OrganizationRole ;
    rdfs:range xsd:string ;
    rdfs:label "organization role name" ;
    rdfs:comment "The name of the organization role." .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact email" ;
    rdfs:comment "Contact email address." .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :OrganizationContactInfo ;
    rdfs:range xsd:string ;
    rdfs:label "contact phone" ;
    rdfs:comment "Contact phone number." .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" ;
    rdfs:comment "The value of the identifier." .

:identifierType a owl:DatatypeProperty ;
    rdfs:domain :OrganizationIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier type" ;
    rdfs:comment "The type of the identifier." .

:locationAddress a owl:DatatypeProperty ;
    rdfs:domain :OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "location address" ;
    rdfs:comment "The address of the location." .

:locationCity a owl:DatatypeProperty ;
    rdfs:domain :OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "location city" ;
    rdfs:comment "The city of the location." .

:locationCountry a owl:DatatypeProperty ;
    rdfs:domain :OrganizationLocation ;
    rdfs:range xsd:string ;
    rdfs:label "location country" ;
