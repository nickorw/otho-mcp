@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests> a owl:Ontology .

#################################################################
# Classes
#################################################################

:InvoiceElement a owl:Class ;
    rdfs:label "Invoice Element" ;
    rdfs:comment "An element of an invoice." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :isInvoiceElementOf ;
        owl:someValuesFrom :Invoice
    ] .

:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document class." ;
    rdfs:subClassOf :InvoiceElement .

:EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "An electronic data interchange message structured according to EDIFACT standards." ;
    rdfs:subClassOf :Document .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A bill or request for payment sent from a supplier to a customer." ;
    rdfs:subClassOf :Document .

:EDIFACTMessageInvoiceListing a owl:Class ;
    rdfs:label "EDIFACT Message Invoice Listing" ;
    rdfs:comment "A pivot class for associating an EDIFACT message with its listed invoices." .

:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A generic entity, superclass for organizations and participants." ;
    rdfs:subClassOf :InvoiceElement .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Any organization involved in invoicing (e.g., supplier, customer, etc.)." ;
    rdfs:subClassOf :Entity, :InvoiceParticipant .

:InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "An entity's participation in an invoice." ;
    rdfs:subClassOf :Entity .

:InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A class representing the role (buyer, seller, etc.) an organization plays in an invoice." ;
    rdfs:subClassOf :InvoiceParticipant .

:InvoiceRoleType a owl:Class ;
    rdfs:label "Invoice Role Type" ;
    rdfs:comment "Type of role an organization can play in an invoice (e.g., Buyer, Seller, Issuer, Recipient)." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceParticipant a owl:Class ;
    rdfs:label "Invoice Participant" ;
    rdfs:comment "Superclass for all entities participating in an invoice." ;
    rdfs:subClassOf :InvoiceElement .

:BuyerRole a owl:Class ;
    rdfs:subClassOf :InvoiceRole ;
    rdfs:label "Buyer Role" ;
    rdfs:comment "A specialized Invoice Role for buyers." .

:BuyerInvoiceParticipation a owl:Class ;
    rdfs:subClassOf :InvoiceParticipation ;
    rdfs:label "Buyer Invoice Participation" ;
    rdfs:comment "Participation of an organization as a buyer in an invoice." .

:OrganizationType a owl:Class ;
    rdfs:label "Organization Type" ;
    rdfs:comment "The type of an organization (e.g., company, government agency, etc.)." .

:OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "Role played by an organization in a business process." .

:OrganizationContactInfo a owl:Class ;
    rdfs:label "Organization Contact Info" ;
    rdfs:comment "Contact information for an organization." .

:OrganizationParticipation a owl:Class ;
    rdfs:label "Organization Participation (Reification)" ;
    rdfs:comment "Reification class to represent participation of an organization." .

:OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "An identifier for an organization." .

:OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "A location associated with an organization." .

:OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A textual description of an organization." .

:OrganizationDisplayInfo a owl:Class ;
    rdfs:label "Organization Display Info (Reification)" ;
    rdfs:comment "Reification class for display information of an organization." .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person (individual human being)." .

:Buyer a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person or organization who buys items." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address." .

:BuyingEvent a owl:Class ;
    rdfs:label "Buying Event" ;
    rdfs:comment "An event representing a purchase." ;
    rdfs:subClassOf :InvoiceElement .

:BuyerAddressAssignment a owl:Class ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of a buyer to an address." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Represents an item that is sold." .

:Product a owl:Class ;
    rdfs:subClassOf :Item ;
    rdfs:label "Product" ;
    rdfs:comment "A tangible product." .

:Service a owl:Class ;
    rdfs:subClassOf :Item ;
    rdfs:label "Service" ;
    rdfs:comment "A non-tangible service." .

:InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line in an invoice, typically representing a sold item." .

:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:comment "A quantity of something." ;
    rdfs:subClassOf :InvoiceElement .

:UnitPrice a owl:Class ;
    rdfs:label "Unit Price" ;
    rdfs:comment "The price per unit of an item." ;
    rdfs:subClassOf :InvoiceElement .

:SoldItemDisplay a owl:Class ;
    rdfs:label "Sold Item Display" ;
    rdfs:comment "Reification class to capture the information displayed about an item sold." .

:ItemAttribute a owl:Class ;
    rdfs:label "Item Attribute" ;
    rdfs:comment "Superclass for all item attributes displayed." .

:ItemName a owl:Class ;
    rdfs:label "Item Name" ;
    rdfs:comment "Represents the name of the item." ;
    rdfs:subClassOf :ItemAttribute .

:ItemPrice a owl:Class ;
    rdfs:label "Item Price" ;
    rdfs:comment "Represents the price of the item." ;
    rdfs:subClassOf :ItemAttribute .

:ItemDescription a owl:Class ;
    rdfs:label "Item Description" ;
    rdfs:comment "Represents the description of the item." ;
    rdfs:subClassOf :ItemAttribute .

:ItemImage a owl:Class ;
    rdfs:label "Item Image" ;
    rdfs:comment "Represents the image associated with the item." ;
    rdfs:subClassOf :ItemAttribute .

:MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount" ;
    rdfs:comment "A monetary value." ;
    rdfs:subClassOf :InvoiceElement .

:Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "A currency unit." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed information of an invoice." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceItem a owl:Class ;
    rdfs:label "Invoice Item" ;
    rdfs:comment "An item listed in an invoice." ;
    rdfs:subClassOf :InvoiceElement .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value." ;
    rdfs:subClassOf :InvoiceElement .

:Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A generic amount value." ;
    rdfs:subClassOf :InvoiceElement .

:Date a owl:Class ;
    rdfs:label "Date" ;
    rdfs:comment "A date value." ;
    rdfs:subClassOf :InvoiceElement .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer entity." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceDetailPivot a owl:Class ;
    rdfs:label "Invoice Detail Pivot" ;
    rdfs:comment "A pivot class for invoice details." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceAmountReification a owl:Class ;
    rdfs:label "Invoice Amount Reification" ;
    rdfs:comment "Reification class for invoice amount." ;
    rdfs:subClassOf :InvoiceElement .

:MonetaryValue a owl:Class ;
    rdfs:label "Monetary Value" ;
    rdfs:comment "A monetary value (amount + currency)." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceIdentification a owl:Class ;
    rdfs:label "Invoice Identification" ;
    rdfs:comment "Identification information for an invoice." ;
    rdfs:subClassOf :InvoiceElement .

:InvoiceNumber a owl:Class ;
    rdfs:label "Invoice Number" ;
    rdfs:comment "A class representing the invoice number." ;
    rdfs:subClassOf :InvoiceElement .

:FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format for business documents." .

:InformationRequirement a owl:Class ;
    rdfs:label "Information Requirement" ;
    rdfs:comment "A requirement on information in a file format." ;
    rdfs:subClassOf :InvoiceElement .

:Field a owl:Class ;
    rdfs:label "Field" ;
    rdfs:comment "A field in a document or file." ;
    rdfs:subClassOf :InvoiceElement .

:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint on a field or document." ;
    rdfs:subClassOf :InvoiceElement .

:ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule used for validation." ;
    rdfs:subClassOf :InvoiceElement .

:FileFormatValidity a owl:Class ;
    rdfs:label "File Format Validity" ;
    rdfs:comment "A class representing the validity of a file format." .

:FieldType a owl:Class ;
    rdfs:label "Field Type" ;
    rdfs:comment "The type of a field." ;
    rdfs:subClassOf :InvoiceElement .

:RequiredField a owl:Class ;
    rdfs:label "Required Field" ;
    rdfs:comment "A required field in a file." ;
    rdfs:subClassOf :Field .

:OptionalField a owl:Class ;
    rdfs:label "Optional Field" ;
    rdfs:comment "An optional field in a file." ;
    rdfs:subClassOf :Field .

:FieldConstraint a owl:Class ;
    rdfs:label "Field Constraint" ;
    rdfs:comment "A constraint specific to a field." ;
    rdfs:subClassOf :Constraint .

:FieldValue a owl:Class ;
    rdfs:label "Field Value" ;
    rdfs:comment "A value assigned to a field." ;
    rdfs:subClassOf :InvoiceElement .

:FileInstance a owl:Class ;
    rdfs:label "File Instance" ;
    rdfs:comment "An instance of a file." .

:FileFormatValidation a owl:Class ;
    rdfs:label "File Format Validation" ;
    rdfs:comment "A validation result for a file format." .

:ValidFileFormatValidation a owl:Class ;
    rdfs:label "Valid File Format Validation" ;
    rdfs:comment "A validation result indicating the file format is valid." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process." ;
    rdfs:subClassOf :InvoiceElement .

:Assignment a owl:Class ;
    rdfs:label "Assignment" ;
    rdfs:comment "A generic assignment." ;
    rdfs:subClassOf :InvoiceElement .

:ProcessAssignment a owl:Class ;
    rdfs:label "Process Assignment" ;
    rdfs:comment "Assignment of a process to an invoice." ;
    rdfs:subClassOf :Assignment .

#################################################################
# Disjointness
#################################################################

:EDIFACTMessage owl:disjointWith :Invoice .
:Organization owl:disjointWith :Invoice, :InvoiceParticipation, :InvoiceRole, :InvoiceRoleType .
:Invoice owl:disjointWith :InvoiceParticipation, :InvoiceRole, :InvoiceRoleType, :MonetaryAmount, :Item, :InvoiceLine, :Customer, :InvoiceDetailPivot, :MonetaryValue, :InvoiceNumber, :BusinessProcess, :ProcessAssignment .
:InvoiceParticipation owl:disjointWith :InvoiceRole, :Organization, :Invoice, :InvoiceRoleType .
:InvoiceRole owl:disjointWith :Invoice, :Organization, :InvoiceParticipation, :InvoiceRoleType .
:InvoiceRoleType owl:disjointWith :Invoice, :Organization, :InvoiceParticipation, :InvoiceRole .
:Product owl:disjointWith :Service .
:InvoiceLine owl:disjointWith :MonetaryAmount, :Invoice, :Item, :Customer, :InvoiceDetailPivot .
:MonetaryAmount owl:disjointWith :Invoice, :Item, :InvoiceLine, :Customer, :InvoiceDetailPivot .
:InvoiceDetailPivot owl:disjointWith :Invoice, :Customer, :Product .
:InvoiceItem owl:disjointWith :Customer, :Product, :Invoice .
:RequiredField owl:disjointWith :OptionalField .
:FieldConstraint owl:disjointWith :ValidationRule .
:InvoiceNumber owl:disjointWith :Invoice, :Document, :InvoiceIdentification .
:InvoiceIdentification owl:disjointWith :InvoiceNumber .
:ProcessAssignment owl:disjointWith :Invoice, :BusinessProcess .
:BusinessProcess owl:disjointWith :Invoice, :ProcessAssignment .
:Buyer owl:disjointWith :Address .
:Person owl:disjointWith :Address .
:OrganizationContactInfo owl:disjointWith :OrganizationIdentifier, :OrganizationLocation, :OrganizationDescription .
:OrganizationIdentifier owl:disjointWith :OrganizationLocation, :OrganizationDescription .
:OrganizationLocation owl:disjointWith :OrganizationDescription .
:ItemName owl:disjointWith :ItemPrice, :ItemDescription, :ItemImage .
:ItemPrice owl:disjointWith :ItemDescription, :ItemImage .
:ItemDescription owl:disjointWith :ItemImage .
:InvoiceAmountReification owl:disjointWith :Invoice, :MonetaryValue .

#################################################################
# Class Hierarchies & Axioms
#################################################################

:OrganizationContactInfo rdfs:subClassOf :OrganizationDisplayInfo .
:OrganizationIdentifier rdfs:subClassOf :OrganizationDisplayInfo .
:OrganizationLocation rdfs:subClassOf :OrganizationDisplayInfo .
:OrganizationDescription rdfs:subClassOf :OrganizationDisplayInfo .

:InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesInvoice ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasParticipatingOrganization ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:InvoiceRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasRoleType ; owl:someValuesFrom :InvoiceRoleType ]
        [ a owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :Invoice ]
        [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasInvoiceRole ] ; owl:someValuesFrom :Organization ]
    )
] .

:BuyerRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :InvoiceRole
        [ a owl:Restriction ; owl:onProperty :roleName ; owl:hasValue "buyer" ]
    )
] .

:BuyerInvoiceParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :InvoiceParticipation
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:allValuesFrom :BuyerRole ]
    )
] .

:Organization owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasDisplayInfo ;
    owl:allValuesFrom :OrganizationDisplayInfo
] .

:OrganizationDisplayInfo owl:disjointUnionOf (
    :OrganizationContactInfo
    :OrganizationIdentifier
    :OrganizationLocation
    :OrganizationDescription
) .

:OrganizationDisplayInfo owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :displayInfoOf ;
    owl:allValuesFrom :Organization
] .

:Buyer owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Person
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasBuyerAddressAssignment ;
          owl:allValuesFrom :BuyerAddressAssignment
        ]
    )
] .

:BuyerAddressAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Buyer ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Address ]
    )
] .

:InvoiceLine rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceLineOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :invoiceLineOf ; owl:someValuesFrom :Invoice ]
    )
] .

:SoldItemDisplay owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :displayedItem ;
          owl:someValuesFrom :Item ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasDisplayedAttribute ;
          owl:someValuesFrom :ItemAttribute ]
    )
] .

:ItemAttribute rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :attributeOf ;
    owl:someValuesFrom :Item
] .

:Item rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasAttribute ;
    owl:someValuesFrom :ItemAttribute
] .

:InvoiceLine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:someValuesFrom :Item
] , [
    a owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:someValuesFrom :MonetaryAmount
] , [
    a owl:Restriction ;
    owl:onProperty :quantity ;
    owl:someValuesFrom xsd:decimal
] , [
    a owl:Restriction ;
    owl:onProperty :unitPrice ;
    owl:someValuesFrom xsd:decimal
] .

:InvoiceLine owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Item ]
        [ a owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ a owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
        [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :MonetaryAmount ]
    )
] .

:Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :InvoiceLine
] .

:Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceDetail ;
        owl:someValuesFrom :InvoiceDetailPivot
    ]
] .

:InvoiceDetailPivot owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceItem ;
        owl:someValuesFrom :InvoiceItem
    ]
] .

:InvoiceItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasProduct ;
        owl:someValuesFrom :Product
    ]
] .

:InvoiceAmountReification owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :refersToInvoice ;
    owl:allValuesFrom :Invoice
] , [
    a owl:Restriction ;
    owl:onProperty :hasMonetaryValue ;
    owl:allValuesFrom :MonetaryValue
] .

:Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceIdentification ;
    owl:allValuesFrom :InvoiceIdentification
] .

:InvoiceIdentification owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:allValuesFrom :InvoiceNumber
] .

:InvoiceNumber owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:allValuesFrom xsd:string
] .

:FileFormatValidity owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :FileFormat
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInformationRequirement ;
          owl:allValuesFrom [
            rdf:type owl:Restriction ;
            owl:onProperty :requiresField ;
            owl:allValuesFrom :RequiredField
          ]
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInformationRequirement ;
          owl:allValuesFrom [
            rdf:type owl:Restriction ;
            owl:onProperty :requiresConstraint ;
            owl:allValuesFrom :Constraint
          ]
        ]
    )
] .

:ValidFileFormatValidation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :FileFormatValidation
        [ rdf:type owl:Restriction ;
          owl:onProperty :validationResult ;
          owl:hasValue "true"^^xsd:boolean
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :missingRequiredField ;
          owl:maxCardinality "0"^^xsd:nonNegativeInteger
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :violatedConstraint ;
          owl:maxCardinality "0"^^xsd:nonNegativeInteger
        ]
    )
] .

#################################################################
# Individuals (role types)
#################################################################

:Buyer a owl:NamedIndividual, :InvoiceRoleType ;
    rdfs:label "Buyer" ;
    rdfs:comment "Role type: Buyer" .
:Seller a owl:NamedIndividual, :InvoiceRoleType ;
    rdfs:label "Seller" ;
    rdfs:comment "Role type: Seller" .
:Issuer a owl:NamedIndividual, :InvoiceRoleType ;
    rdfs:label "Issuer" ;
    rdfs:comment "Role type: Issuer" .
:Recipient a owl:NamedIndividual, :InvoiceRoleType ;
    rdfs:label "Recipient" ;
    rdfs:comment "Role type: Recipient" .

#################################################################
# Object Properties
#################################################################

:hasEDIFACTMessage a owl:ObjectProperty ;
    rdfs:domain :EDIFACTMessageInvoiceListing ;
    rdfs:range :EDIFACTMessage ;
    rdfs:label "has EDIFACT message" ;
    rdfs:comment "Links the invoice listing to the EDIFACT message." ;
    owl:inverseOf :isEDIFACTMessageOf .

:isEDIFACTMessageOf a owl:ObjectProperty ;
    rdfs:domain :EDIFACTMessage ;
    rdfs:range :EDIFACTMessageInvoiceListing ;
    rdfs:label "is EDIFACT message of" ;
    rdfs:comment "Inverse property of hasEDIFACTMessage." .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :EDIFACTMessageInvoiceListing ;
    rdfs:range :Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links the invoice listing to an invoice listed in the EDIFACT message." ;
    owl:inverseOf :isInvoiceOfListing .

:isInvoiceOfListing a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :EDIFACTMessageInvoiceListing ;
    rdfs:label "is invoice of listing" ;
    rdfs:comment "Inverse property of hasInvoice." .

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceParticipation ;
    rdfs:label "organization participates in invoice participation" ;
    rdfs:comment "Links an organization to an invoice participation." ;
    owl:inverseOf :hasParticipatingOrganization .

:hasParticipatingOrganization a owl:ObjectProperty ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Organization ;
    rdfs:label "invoice participation has organization" ;
    rdfs:comment "Links an invoice participation to an organization." ;
    owl:inverseOf :participatesInInvoice .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :InvoiceParticipation ;
    rdfs:range :Invoice ;
    rdfs:label "invoice participation involves invoice" ;
    rdfs:comment "Links an invoice participation to the involved invoice." ;
    owl:inverseOf :hasInvoiceParticipation .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceParticipation ;
    rdfs:label "invoice has invoice participation" ;
    rdfs:comment "Links an invoice to its participations." ;
    owl:inverseOf :involvesInvoice .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Links an organization to its role in a specific invoice." ;
    owl:inverseOf :hasOrganizationInRole .

:hasOrganizationInRole a owl:ObjectProperty ;
    rdfs:domain :InvoiceRole ;
    rdfs:range :Organization ;
    rdfs:label "has organization in role" ;
    rdfs:comment "Links an invoice role to the organization in that role." ;
    owl:inverseOf :hasInvoiceRole .

:inInvoice a owl:ObjectProperty ;
    rdfs:domain :InvoiceRole ;
    rdfs:range :Invoice ;
    rdfs:label "in invoice" ;
    rdfs:comment "Links an invoice role to the invoice in which the role is played." ;
    owl:inverseOf :hasRoleInInvoice .

:hasRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :InvoiceRole ;
    rdfs:label "has role in invoice" ;
    rdfs:comment "Links an invoice to the roles played in it." ;
    owl:inverseOf :inInvoice .

:hasRoleType a owl:ObjectProperty ;
    rdfs:domain :InvoiceRole ;
