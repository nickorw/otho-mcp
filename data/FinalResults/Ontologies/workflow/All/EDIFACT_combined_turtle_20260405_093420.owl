#################################################################
# Disjointness and Disjoint Unions
#################################################################

:Cl_Invoice owl:disjointWith :Cl_InvoiceAmount, :Cl_InvoiceLine, :Cl_InvoiceAmountAssignment, :Cl_InvoiceIdentifier, :Cl_InvoiceNumberAssignment, :Cl_Item, :Cl_InvoiceDetailEntry, :Cl_NetPriceComputation, :Cl_InvoiceDetail, :Cl_Organization, :Cl_OrganizationInvoiceRole, :Cl_InvoiceRole, :Cl_InvoiceParticipation, :Cl_Assignment, :Cl_BusinessProcess, :Cl_EDIFACTMessage, :Cl_EDIFACTMessageDocumentListing .
:Cl_InvoiceAmountAssignment owl:disjointWith :Cl_InvoiceAmount .
:Cl_InvoiceNumberAssignment owl:disjointWith :Cl_InvoiceIdentifier, :Cl_Invoice .
:Cl_InvoiceIdentifier owl:disjointWith :Cl_Invoice .
:Cl_Item owl:disjointWith :Cl_InvoiceLine, :Cl_InvoiceAmount, :Cl_NetPriceComputation, :Cl_InvoiceAmountAssignment, :Cl_InvoiceDetailEntry, :Cl_Information .
:Cl_InvoiceLine owl:disjointWith :Cl_InvoiceAmount, :Cl_NetPriceComputation, :Cl_InvoiceAmountAssignment, :Cl_InvoiceDetailEntry .
:Cl_InvoiceAmount owl:disjointWith :Cl_NetPriceComputation .
:Cl_NetPriceComputation owl:disjointWith :Cl_InvoiceDetailEntry .
:Cl_InvoiceDetailEntry owl:disjointWith :Cl_Product, :Cl_Customer, :Cl_Employee .
:Cl_Product owl:disjointWith :Cl_Customer, :Cl_Employee, :Cl_Service .
:Cl_Customer owl:disjointWith :Cl_Employee .
:Cl_ContactInformation owl:disjointWith :Cl_OrganizationRole, :Cl_OrganizationIdentifier, :Cl_OrganizationLocation, :Cl_OrganizationDescription .
:Cl_OrganizationInformation owl:disjointUnionOf ( :Cl_ContactInformation :Cl_OrganizationRole :Cl_OrganizationIdentifier :Cl_OrganizationLocation :Cl_OrganizationDescription ) .
:Cl_Organization owl:disjointWith :Cl_Invoice, :Cl_InvoiceRole, :Cl_InvoiceParticipation, :Cl_OrganizationInvoiceRole, :Cl_InvoiceDetailEntry .
:Cl_InvoiceRole owl:disjointWith :Cl_Invoice, :Cl_Organization, :Cl_InvoiceParticipation, :Cl_OrganizationInvoiceRole .
:Cl_InvoiceParticipation owl:disjointWith :Cl_Invoice, :Cl_Organization, :Cl_InvoiceRole, :Cl_OrganizationInvoiceRole .
:Cl_OrganizationInvoiceRole owl:disjointWith :Cl_Organization, :Cl_Invoice, :Cl_InvoiceRole .
:Cl_InvoiceRoleType owl:disjointWith :Cl_BuyerRoleType, :Cl_SellerRoleType .
:Cl_BuyerRoleType owl:disjointWith :Cl_SellerRoleType .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Item owl:disjointWith :Cl_Information .
:Cl_Sale owl:disjointWith :Cl_Information .
:Cl_FileFormat owl:disjointWith :Cl_FileComponent, :Cl_ValidationRule, :Cl_RequiredInformation, :Cl_DataType, :Cl_Constraint, :Cl_ValidationRequirement, :Cl_InformationItem, :Cl_FormatSpecification, :Cl_ValueDomain .
:Cl_Invoice owl:disjointWith :Cl_BusinessProcess, :Cl_Assignment .
:Cl_BusinessProcess owl:disjointWith :Cl_Assignment .
:Cl_Document owl:disjointWith :Cl_BusinessProcess .
:Cl_Buyer owl:disjointWith :Cl_Address .

#################################################################
# Disjoint Union of Information subclasses
#################################################################

:Cl_Information owl:disjointUnionOf ( :Cl_ItemInformation :Cl_DisplayInformation ) .

#################################################################
# Restrictions and General Class Axioms
#################################################################

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isInvoiceNumberAssignmentOf ;
    owl:someValuesFrom :Cl_InvoiceNumberAssignment
] .

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isAssignmentOfInvoice ;
    owl:someValuesFrom :Cl_InvoiceNumberAssignment
] .

:Cl_BusinessProcess rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :isAssignedToBusinessProcess ;
    owl:someValuesFrom :Cl_Assignment
] .

#################################################################
# End of Ontology
#################################################################

# --- Corrections for P04 (Unconnected elements) ---
:Cl_Entity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasEntityType ;
    owl:someValuesFrom :Cl_EntityType
] .

:Cl_EntityType a owl:Class ;
    rdfs:label "Entity Type" ;
    rdfs:comment "A type for entities." ;
    rdfs:subClassOf owl:Thing .

:hasEntityType a owl:ObjectProperty ;
    rdfs:domain :Cl_Entity ;
    rdfs:range :Cl_EntityType ;
    rdfs:label "has entity type" ;
    rdfs:comment "Links an entity to its type." .

# --- Corrections for P13 (Inverse relationships not declared) ---
:hasInvoiceAmountAssignment owl:inverseOf :isInvoiceAmountAssignmentOfInvoice .
:isInvoiceAmountAssignmentOfInvoice owl:inverseOf :hasInvoiceAmountAssignment .

# --- Corrections for P20 (Misusing ontology annotations) ---
:isEmployeeOfInvoice rdfs:label "is employee of invoice" ;
    rdfs:comment "Inverse of hasEmployee." .

:isItemReferredByInvoiceLine rdfs:label "is item referred by invoice line" ;
    rdfs:comment "Inverse of refersToItem." .

:isRoleTypeOfInvoiceRole rdfs:label "is role type of invoice role" ;
    rdfs:comment "Inverse of roleType." .

:isNetPriceComputationOfInvoice rdfs:label "is net price computation of invoice" ;
    rdfs:comment "Inverse of hasNetPriceComputation." .

:isProductOfInvoiceDetailEntry rdfs:label "is product of invoice detail entry" ;
    rdfs:comment "Inverse of hasProduct." .

# ... (for all other affected elements, ensure rdfs:label and rdfs:comment are correctly used, not swapped or misused)

# --- Corrections for P22 (Naming conventions) ---
:Cl_OrganizationIdentifier rdfs:label "OrganizationIdentifier" .
:hasInvoiceParticipation rdfs:label "hasInvoiceParticipation" .
