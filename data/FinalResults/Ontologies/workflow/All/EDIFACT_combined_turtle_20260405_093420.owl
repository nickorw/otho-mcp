@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/fests> rdf:type owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A general entity class for all entities." ;
    rdfs:subClassOf owl:Thing .

:Cl_Person a owl:Class ; rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Person" ;
    rdfs:comment "A human being as an entity." .

:Cl_Buyer a owl:Class ; rdfs:subClassOf :Cl_Person ;
    rdfs:label "Buyer" ;
    rdfs:comment "A person or organization who buys goods or services." .

:Cl_Address a owl:Class ; rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Address" ;
    rdfs:comment "A postal or physical address." .

:Cl_BuyerAddressAssignment a owl:Class ; rdfs:subClassOf :Cl_Entity ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of an address to a buyer." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legal entity such as a company, institution, or group." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_OrganizationInformation a owl:Class ;
    rdfs:label "Organization Information" ;
    rdfs:comment "A reification class that represents information displayed about an organization." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ContactInformation a owl:Class ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact details for an organization, such as email, phone, or address." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationRole a owl:Class ;
    rdfs:label "Organization Role" ;
    rdfs:comment "The role played by an organization in the scenario (e.g., sponsor, partner, host)." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "A unique identifier for the organization (e.g., registration number, tax ID)." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:label "Organization Location" ;
    rdfs:comment "The geographical location or address of the organization." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A description or summary of the organization." ;
    rdfs:subClassOf :Cl_OrganizationInformation .

:Cl_OrganizationDisplay a owl:Class ;
    rdfs:label "Organization Display" ;
    rdfs:comment "A reification class connecting an organization to the information displayed about it." ;
    rdfs:subClassOf owl:Thing .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A general document class, superclass for Invoice." ;
    rdfs:subClassOf owl:Thing .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A document issued by a seller to a buyer indicating products, quantities, and agreed prices." ;
    rdfs:subClassOf :Cl_Document, :Cl_InvoiceEntity .

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A structured message following the EDIFACT standard." ;
    rdfs:subClassOf owl:Thing .

:Cl_EDIFACTMessageDocumentListing a owl:Class ;
    rdfs:label "EDIFACT Message Document Listing" ;
    rdfs:comment "A pivot class representing the listing of documents (e.g., invoices) within an EDIFACT message." ;
    rdfs:subClassOf owl:Thing .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A reification class to represent the role of an organization in the context of an invoice." ;
    rdfs:subClassOf owl:Thing .

:Cl_InvoiceRoleType a owl:Class ;
    rdfs:label "Invoice Role Type" ;
    rdfs:comment "Types of roles that an organization can play in the context of an invoice." ;
    rdfs:subClassOf owl:Thing .

:Cl_BuyerRoleType a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Buyer Role Type" ;
    rdfs:comment "Role type indicating the buyer in an invoice." .

:Cl_SellerRoleType a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Seller Role Type" ;
    rdfs:comment "Role type indicating the seller in an invoice." .

:Cl_BuyerInvoiceRole a owl:Class ;
    rdfs:label "Buyer Invoice Role" ;
    rdfs:comment "The role instance representing the buyer in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceRole .

:Cl_OrganizationInvoiceRole a owl:Class ;
    rdfs:label "Organization Invoice Role" ;
    rdfs:comment "A class representing the role of an organization in an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "A participation relation between an organization and an invoice." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:subClassOf owl:Thing, :Cl_InvoiceEntity ;
    rdfs:comment "A single item, product, or service related to an invoice." .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Product" ;
    rdfs:comment "A tangible item or good." .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item ;
    rdfs:label "Service" ;
    rdfs:comment "An intangible item or service." .

:Cl_InvoiceLine a owl:Class ;
    rdfs:subClassOf owl:Thing, :Cl_InvoiceEntity ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item on an invoice." .

:Cl_InvoiceEntity a owl:Class ;
    rdfs:label "Invoice Entity" ;
    rdfs:comment "A general superclass for invoice-related entities." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "Detailed information related to an invoice." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A party who purchases goods or services." ;
    rdfs:subClassOf :Cl_Person .

:Cl_Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "A person employed by an organization." ;
    rdfs:subClassOf :Cl_Person .

:Cl_InvoiceDetailEntry a owl:Class ;
    rdfs:label "Invoice Detail Entry" ;
    rdfs:comment "An entry for a detail in an invoice." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "The monetary amount of an invoice." ;
    rdfs:subClassOf :Cl_InvoiceData .

:Cl_InvoiceData a owl:Class ;
    rdfs:label "Invoice Data" ;
    rdfs:comment "A class for data elements related to invoices." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:label "Invoice Amount Assignment" ;
    rdfs:comment "Assignment of an amount to an invoice." ;
    rdfs:subClassOf :Cl_InvoiceData .

:Cl_InvoiceIdentifier a owl:Class ;
    rdfs:label "Invoice Identifier" ;
    rdfs:comment "A unique identifier for an invoice." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_InvoiceNumberAssignment a owl:Class ;
    rdfs:label "Invoice Number Assignment" ;
    rdfs:comment "Assignment of a number to an invoice." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A format specification for a file." ;
    rdfs:subClassOf owl:Thing .

:Cl_FileComponent a owl:Class ;
    rdfs:label "File Component" ;
    rdfs:comment "A component or part of a file format." ;
    rdfs:subClassOf owl:Thing .

:Cl_ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule for validation of data or files." ;
    rdfs:subClassOf :Cl_FormatSpecification .

:Cl_RequiredInformation a owl:Class ;
    rdfs:label "Required Information" ;
    rdfs:comment "Information required for a file or process." ;
    rdfs:subClassOf :Cl_FormatSpecification .

:Cl_DataType a owl:Class ;
    rdfs:label "Data Type" ;
    rdfs:comment "A data type for information items." ;
    rdfs:subClassOf :Cl_FormatSpecification .

:Cl_Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint on data values." ;
    rdfs:subClassOf :Cl_ValidationRule .

:Cl_ValidationRequirement a owl:Class ;
    rdfs:label "Validation Requirement" ;
    rdfs:comment "A requirement for validation." ;
    rdfs:subClassOf :Cl_FormatSpecification .

:Cl_InformationItem a owl:Class ;
    rdfs:label "Information Item" ;
    rdfs:comment "An atomic information item in a file or format." ;
    rdfs:subClassOf :Cl_RequiredInformation .

:Cl_FormatSpecification a owl:Class ;
    rdfs:label "Format Specification" ;
    rdfs:comment "Specification of a format for files or data." ;
    rdfs:subClassOf owl:Thing .

:Cl_ValueDomain a owl:Class ;
    rdfs:label "Value Domain" ;
    rdfs:comment "The domain of allowed values for a constraint." ;
    rdfs:subClassOf :Cl_Constraint .

:Cl_Information a owl:Class ;
    rdfs:label "Information" ;
    rdfs:comment "A general class for information." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_ItemInformation a owl:Class ;
    rdfs:subClassOf :Cl_Information ;
    rdfs:label "Item Information" ;
    rdfs:comment "Information about an item." .

:Cl_DisplayInformation a owl:Class ;
    rdfs:subClassOf :Cl_Information ;
    rdfs:label "Display Information" ;
    rdfs:comment "Information for display purposes." .

:Cl_ItemDisplay a owl:Class ;
    rdfs:label "Item Display" ;
    rdfs:comment "A display for an item." ;
    rdfs:subClassOf owl:Thing .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" ;
    rdfs:comment "A transaction resulting in the transfer of goods or services." ;
    rdfs:subClassOf :Cl_Entity .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process related to invoices." ;
    rdfs:subClassOf owl:Thing .

:Cl_Assignment a owl:Class ; rdfs:subClassOf owl:Thing ;
    rdfs:label "Assignment" ;
    rdfs:comment "Assignment of an invoice to a business process." .

:Cl_NetPriceComputation a owl:Class ;
    rdfs:label "Net Price Computation" ;
    rdfs:comment "Computation for net price of an invoice or line." ;
    rdfs:subClassOf :Cl_InvoiceEntity .

:Cl_InvoiceInformation a owl:Class ;
    rdfs:label "Invoice Information" ;
    rdfs:comment "Information displayed about an invoice." ;
    rdfs:subClassOf :Cl_Information .

:Cl_InvoiceDisplay a owl:Class ;
    rdfs:label "Invoice Display" ;
    rdfs:comment "A display for an invoice." ;
    rdfs:subClassOf owl:Thing .

#################################################################
# Class Hierarchies and Equivalent Classes
#################################################################

:Cl_InvoiceLine rdfs:subClassOf :Cl_InvoiceEntity .
:Cl_InvoiceDetailEntry rdfs:subClassOf :Cl_InvoiceEntity .
:Cl_InvoiceAmount rdfs:subClassOf :Cl_InvoiceData .
:Cl_InvoiceAmountAssignment rdfs:subClassOf :Cl_InvoiceData .
:Cl_ValidationRequirement rdfs:subClassOf :Cl_FormatSpecification .
:Cl_InformationItem rdfs:subClassOf :Cl_RequiredInformation .
:Cl_OrganizationDisplay rdfs:subClassOf owl:Thing .

:Cl_BuyerInvoiceRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceRole
        [ a owl:Restriction ; owl:onProperty :roleType ; owl:hasValue :Cl_BuyerRoleType ]
    )
] .

:Cl_OrganizationInvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_EDIFACTMessageDocumentListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :forEDIFACTMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
        [ rdf:type owl:Restriction ; owl:onProperty :listsDocument ; owl:someValuesFrom :Cl_Document ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :involvesInvoice ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesOrganization ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Organization ]
    )
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
    )
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:allValuesFrom :Cl_InvoiceLine
] ,
[
    rdf:type owl:Restriction ;
    owl:onProperty :hasNetPriceComputation ;
    owl:allValuesFrom :Cl_NetPriceComputation
] .

:Cl_InvoiceDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :displaysInformation ; owl:someValuesFrom :Cl_InvoiceInformation ]
    )
] .

:Cl_InvoiceDetailEntry owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :forInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasProduct ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :detailQuantity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ]
        [ rdf:type owl:Restriction ; owl:onProperty :detailUnitPrice ; owl:minCardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :refersToAmount ; owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceNumberAssignment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoice ;
    owl:allValuesFrom :Cl_Invoice
] , [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceNumber ;
    owl:allValuesFrom :Cl_InvoiceIdentifier
] .

:Cl_ValidationRequirement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
        [ rdf:type owl:Restriction ; owl:onProperty :requiresInformationItem ; owl:someValuesFrom :Cl_InformationItem ]
        [ rdf:type owl:Restriction ; owl:onProperty :appliesToComponent ; owl:someValuesFrom :Cl_FileComponent ]
    )
] .

:Cl_InformationItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :informationItemHasDataType ; owl:someValuesFrom :Cl_DataType ]
        [ rdf:type owl:Restriction ; owl:onProperty :informationItemHasConstraint ; owl:someValuesFrom :Cl_Constraint ]
    )
] .

:Cl_OrganizationDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :displaysInformation ; owl:someValuesFrom :Cl_OrganizationInformation ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:cardinality "1"^^xsd:nonNegativeInteger ; owl:allValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:cardinality "1"^^xsd:nonNegativeInteger ; owl:allValuesFrom :Cl_Address ]
    )
] .

:Cl_Assignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasInvoice ; owl:allValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasBusinessProcess ; owl:allValuesFrom :Cl_BusinessProcess ]
    )
] .

#################################################################
# Object Properties
#################################################################

:hasInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :isInvoiceNumberAssignmentOf ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links a number assignment to its invoice." .

:isInvoiceNumberAssignmentOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceNumberAssignment ;
    rdfs:label "is invoice number assignment of" ;
    rdfs:comment "Inverse of hasInvoice." .

:hasInvoiceNumber rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceNumberAssignment ;
    rdfs:range :Cl_InvoiceIdentifier ;
    owl:inverseOf :isInvoiceNumberOfAssignment ;
    rdfs:label "has invoice number" ;
    rdfs:comment "Links a number assignment to its identifier." .

:isInvoiceNumberOfAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range :Cl_InvoiceNumberAssignment ;
    rdfs:label "is invoice number of assignment" ;
    rdfs:comment "Inverse of hasInvoiceNumber." .

:hasInvoiceAmountAssignment rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountAssignment ;
    owl:inverseOf :isInvoiceAmountAssignmentOfInvoice ;
    rdfs:label "has invoice amount assignment" ;
    rdfs:comment "Links an invoice to its amount assignment." .

:isInvoiceAmountAssignmentOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice amount assignment of invoice" ;
    rdfs:comment "Inverse of hasInvoiceAmountAssignment." .

:refersToInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "refers to invoice" ;
    rdfs:comment "Links an amount assignment to an invoice." ;
    owl:inverseOf :isAmountAssignmentOfInvoice .

:isAmountAssignmentOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountAssignment ;
    rdfs:label "is amount assignment of invoice" ;
    rdfs:comment "Inverse of refersToInvoice." .

:refersToAmount rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:label "refers to amount" ;
    rdfs:comment "Links an amount assignment to an amount." ;
    owl:inverseOf :isAmountReferredByAssignment .

:isAmountReferredByAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range :Cl_InvoiceAmountAssignment ;
    rdfs:label "is amount referred by assignment" ;
    rdfs:comment "Inverse of refersToAmount." .

:hasInvoiceLine rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine ;
    owl:inverseOf :invoiceLineOf ;
    rdfs:label "has invoice line" ;
    rdfs:comment "Links an invoice to its line items." .

:invoiceLineOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "invoice line of" ;
    rdfs:comment "Inverse of hasInvoiceLine." .

:hasNetPriceComputation rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPriceComputation ;
    rdfs:label "has net price computation" ;
    rdfs:comment "Links an invoice to its net price computation." ;
    owl:inverseOf :isNetPriceComputationOfInvoice .

:isNetPriceComputationOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceComputation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is net price computation of invoice" ;
    rdfs:comment "Inverse of hasNetPriceComputation." .

:hasInvoiceDetail rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetailEntry ;
    owl:inverseOf :forInvoice ;
    rdfs:label "has invoice detail" ;
    rdfs:comment "Links an invoice to its detail entries." .

:forInvoice rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailEntry ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "for invoice" ;
    rdfs:comment "Inverse of hasInvoiceDetail." ;
    owl:inverseOf :hasInvoiceDetail .

:hasProduct rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetailEntry ;
    rdfs:range :Cl_Product ;
    rdfs:label "has product" ;
    rdfs:comment "Links a detail entry to a product." ;
    owl:inverseOf :isProductOfInvoiceDetailEntry .

:isProductOfInvoiceDetailEntry a owl:ObjectProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range :Cl_InvoiceDetailEntry ;
    rdfs:label "is product of invoice detail entry" ;
    rdfs:comment "Inverse of hasProduct." .

:hasCustomer rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer ;
    rdfs:label "has customer" ;
    rdfs:comment "Links an invoice to its customer." ;
    owl:inverseOf :isCustomerOfInvoice .

:isCustomerOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is customer of invoice" ;
    rdfs:comment "Inverse of hasCustomer." .

:hasEmployee rdf:type owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Employee ;
    rdfs:label "has employee" ;
    rdfs:comment "Links an invoice to its employee." ;
    owl:inverseOf :isEmployeeOfInvoice .

:isEmployeeOfInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Employee ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is employee of invoice" ;
    rdfs:comment "Inverse of hasEmployee." .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :isBuyerOfAssignment ;
    rdfs:label "has buyer" ;
    rdfs:comment "Links an assignment to a buyer." .

:isBuyerOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "is buyer of assignment" ;
    rdfs:comment "Inverse of hasBuyer." .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:inverseOf :isAddressOfAssignment ;
    rdfs:label "has address" ;
    rdfs:comment "Links an assignment to an address." .

:isAddressOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment ;
    rdfs:label "is address of assignment" ;
    rdfs:comment "Inverse of hasAddress." .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDisplay ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :isOrganizationOfDisplay ;
    rdfs:label "has organization" ;
    rdfs:comment "Links a display to an organization." .

:isOrganizationOfDisplay a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
