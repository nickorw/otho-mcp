@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests> a owl:Ontology .

#################################################################
# Classes
#################################################################

:Cl_Agent a owl:Class .

:Cl_Person a owl:Class ;
    rdfs:subClassOf :Cl_Agent .

:Cl_Organization a owl:Class ;
    rdfs:subClassOf :Cl_Agent .

:Cl_Buyer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_SellerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoicePartyRole, :Cl_OrganizationRole .

:Cl_BuyerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoicePartyRole, :Cl_OrganizationRole .

:Cl_Address a owl:Class .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document, :Cl_FinancialDocument, :Cl_InvoiceRelatedEntity, :Cl_DisplayedEntity .

:Cl_Document a owl:Class .

:Cl_FinancialDocument a owl:Class ;
    rdfs:subClassOf :Cl_Document .

:Cl_EDIFACTMessage a owl:Class .

:Cl_InvoiceListing a owl:Class ;
    rdfs:comment "Pivot class for reifying the relationship between an EDIFACT message and its listed invoices." .

:Cl_InvoiceRelatedEntity a owl:Class ;
    rdfs:subClassOf :Cl_Entity .

:Cl_Entity a owl:Class .

:Cl_InvoiceOrganizationInvolvement a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRelatedEntity ;
    rdfs:comment "A pivot class to represent the involvement of an organization in an invoice, enabling representation of complex relationships (e.g., roles, dates, etc. if needed in future extensions)." .

:Cl_InvoicePartyRole a owl:Class .

:Cl_InvoiceParty a owl:Class .

:Cl_InvoiceParticipation a owl:Class .

:Cl_InvoiceRole a owl:Class ;
    rdfs:label "Invoice Role" ;
    rdfs:comment "A reification class capturing the specific role an organization plays in an invoice (e.g., supplier, client, payer, recipient)." .

:Cl_InvoiceRoleType a owl:Class ;
    rdfs:label "Invoice Role Type" ;
    rdfs:comment "The type of role an organization can play in the context of an invoice." .

:Cl_SupplierRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Supplier Role" .

:Cl_ClientRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Client Role" .

:Cl_PayerRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Payer Role" .

:Cl_RecipientRole a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceRoleType ;
    rdfs:label "Recipient Role" .

:Cl_InvoiceContent a owl:Class .

:Cl_InvoiceLine a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceContent, :Cl_InvoiceComponent .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item that is sold." ;
    rdfs:subClassOf :Cl_DisplayedEntity .

:Cl_Product a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_Service a owl:Class ;
    rdfs:subClassOf :Cl_Item .

:Cl_InvoiceComponent a owl:Class .

:Cl_InvoiceDetail a owl:Class .

:Cl_InvoiceItem a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceDetail .

:Cl_MonetaryAmount a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceDetail .

:Cl_NetPriceCalculation a owl:Class ;
    rdfs:subClassOf :Cl_InvoiceComponent .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" ;
    rdfs:comment "A sale transaction involving items." ;
    rdfs:subClassOf :Cl_DisplayedEntity .

:Cl_ItemDisplayInfo a owl:Class ;
    rdfs:label "Item Display Info" ;
    rdfs:comment "Information displayed about the item in the sale context." .

:Cl_ItemAttribute a owl:Class ;
    rdfs:label "Item Attribute" ;
    rdfs:comment "A specific attribute of an item (e.g., name, price, description)." .

:Cl_Value a owl:Class ;
    rdfs:label "Value" ;
    rdfs:comment "A value of an attribute (used for reification of attribute-value pairs)." .

:Cl_DisplayedEntity a owl:Class ;
    rdfs:label "Displayed Entity" ;
    rdfs:comment "Superclass for all entities whose information can be displayed." .

:Cl_InvoiceAmount a owl:Class .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:comment "Reification class to relate an invoice with its amount." .

:Cl_InvoiceNumber a owl:Class .

:Cl_InvoiceIdentification a owl:Class .

:Cl_FileFormat a owl:Class .

:Cl_FileFormatSpecification a owl:Class .

:Cl_FileFormatComponent a owl:Class .

:Cl_ValidationRequirement a owl:Class .

:Cl_Field a owl:Class .

:Cl_ValueConstraint a owl:Class .

:Cl_RequiredInformation a owl:Class .

:Cl_RequirementStatement a owl:Class .

:Cl_ValidationContext a owl:Class .

:Cl_FieldValidationRequirement a owl:Class ;
    rdfs:subClassOf :Cl_ValidationRequirement .

:Cl_BusinessProcess a owl:Class .

:Cl_InvoiceAssignment a owl:Class ;
    rdfs:comment "Pivot class representing the assignment of an invoice to a business process, possibly including assignment date and other metadata." .

:Cl_OrganizationType a owl:Class .

:Cl_ContactInformation a owl:Class .

:Cl_OrganizationRole a owl:Class .

:Cl_SponsorRole a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationRole .

:Cl_PartnerRole a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationRole .

:Cl_OrganizerRole a owl:Class ;
    rdfs:subClassOf :Cl_OrganizationRole .

:Cl_InvoiceIssuer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_InvoiceRecipient a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_Customer a owl:Class ;
    rdfs:subClassOf :Cl_Person .

:Cl_Date a owl:Class .

:Cl_BuyerAddressAssignment a owl:Class .

:Cl_Event a owl:Class .

:Cl_OrganizationInvolvement a owl:Class .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:comment "Links an EDIFACT message to its invoice listing (pivot class)." .

:listedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:comment "Links the invoice listing pivot to each invoice included in the EDIFACT message." .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Organization .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceOrganizationInvolvement ;
    rdfs:range :Cl_Invoice .

:invoiceHasInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    owl:inverseOf :involvesInvoice .

:organizationHasInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceOrganizationInvolvement ;
    owl:inverseOf :hasOrganization .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation .

:participationOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:hasPartyRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_InvoicePartyRole .

:isBuyerInInvoice a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasPartyRole ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_BuyerRole .

:isSellerInInvoice a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasPartyRole ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_SellerRole .

:hasInvoiceRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRole ;
    rdfs:label "has invoice role" ;
    rdfs:comment "Connects an invoice to a role that an organization plays in it." .

:roleOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "role organization" ;
    rdfs:comment "Links the invoice role to the organization playing it." .

:roleType a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoiceRoleType ;
    rdfs:label "role type" ;
    rdfs:comment "Specifies the type of role the organization plays in the invoice." .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Product ;
    rdfs:subPropertyOf :refersToItem .

:hasService a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Service ;
    rdfs:subPropertyOf :refersToItem .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Sale ;
    rdfs:range :Cl_Item ;
    rdfs:label "has item" ;
    rdfs:comment "Connects a sale to an item being sold." .

:hasDisplayInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemDisplayInfo ;
    rdfs:label "has display info" ;
    rdfs:comment "Connects an item to its display information." .

:hasAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_ItemAttribute ;
    rdfs:label "has attribute" ;
    rdfs:comment "Connects display info to an item attribute." .

:hasAttributeValue a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Value ;
    rdfs:label "has attribute value" ;
    rdfs:comment "Connects display info to the value of an attribute." .

:displayedAttributeValue a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_ItemAttribute ;
    rdfs:label "displayed attribute value" ;
    rdfs:comment "Connects the display info to the attribute whose value is displayed." .

:displayedValue a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemDisplayInfo ;
    rdfs:range :Cl_Value ;
    rdfs:label "displayed value" ;
    rdfs:comment "Connects the display info to the value displayed for an attribute." .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    rdfs:subPropertyOf :hasInvoiceDetail .

:hasMonetaryAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_MonetaryAmount ;
    rdfs:subPropertyOf :hasInvoiceDetail .

:hasIssuer a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIssuer ;
    owl:inverseOf :issuesInvoice .

:hasRecipient a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceRecipient ;
    owl:inverseOf :receivesInvoice .

:refersToProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Product .

:issuesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIssuer ;
    rdfs:range :Cl_Invoice .

:receivesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRecipient ;
    rdfs:range :Cl_Invoice .

:isCustomerOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range :Cl_InvoiceIssuer .

:hasInvoiceAmountAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAmountAssignment ;
    rdfs:comment "Relates an Invoice to its InvoiceAmountAssignment (reification node)." .

:refersToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:comment "Relates the InvoiceAmountAssignment back to the Invoice." .

:hasAmountValue a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAmountAssignment ;
    rdfs:range :Cl_InvoiceAmount ;
    rdfs:comment "Connects the InvoiceAmountAssignment to the InvoiceAmount node." .

:hasInvoiceIdentification a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentification .

:identifiesInvoiceNumber a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceIdentification ;
    rdfs:range :Cl_InvoiceNumber .

:hasSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatSpecification .

:hasComponent a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_FileFormatComponent .

:hasField a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_Field .

:hasValueConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range :Cl_ValueConstraint .

:hasRequiredInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_RequiredInformation .

:hasRequirementStatement a owl:ObjectProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range :Cl_RequirementStatement .

:hasValidationContext a owl:ObjectProperty ;
    rdfs:domain :Cl_RequirementStatement ;
    rdfs:range :Cl_ValidationContext .

:relatesToField a owl:ObjectProperty ;
    rdfs:domain :Cl_RequirementStatement ;
    rdfs:range :Cl_Field .

:relatesToValueConstraint a owl:ObjectProperty ;
    rdfs:domain :Cl_RequirementStatement ;
    rdfs:range :Cl_ValueConstraint .

:hasFieldValidationRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_FieldValidationRequirement .

:fieldInRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldValidationRequirement ;
    rdfs:range :Cl_Field .

:constraintInRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldValidationRequirement ;
    rdfs:range :Cl_ValueConstraint .

:requirementStatementInRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldValidationRequirement ;
    rdfs:range :Cl_RequirementStatement .

:validationContextInRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_FieldValidationRequirement ;
    rdfs:range :Cl_ValidationContext .

:hasDocument a owl:ObjectProperty .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:subPropertyOf :hasDocument .

:assignedToBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range :Cl_BusinessProcess .

:assignedInvoice a owl:ObjectProperty ;
    owl:inverseOf :hasInvoice ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceAssignment .

:businessProcessAssignment a owl:ObjectProperty ;
    owl:inverseOf :assignedToBusinessProcess ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range :Cl_InvoiceAssignment .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationType .

:hasContactInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_ContactInformation .

:isContactInformationOf a owl:ObjectProperty ;
    owl:inverseOf :hasContactInformation ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range :Cl_Organization .

:hasContactPerson a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Person .

:isInvolvedIn a owl:ObjectProperty ;
    owl:inverseOf :involvesOrganization ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvolvement .

:hasInvolvement a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationInvolvement .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Organization .

:involvesEvent a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_Event .

:involvementRole a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range :Cl_OrganizationRole .

:includesInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_InvoiceLine .

:hasNetPrice a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_MonetaryAmount .

#################################################################
# Data Properties
#################################################################

:edifactMessageId a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:comment "Unique identifier for the EDIFACT message." .

:invoiceId a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:comment "Unique identifier for the Invoice." .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:comment "Date of the Invoice." .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:itemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string ;
    rdfs:label "item name" .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string ;
    rdfs:label "item description" .

:itemPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:decimal ;
    rdfs:label "item price" .

:itemSKU a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string ;
    rdfs:label "item SKU" .

:attributeName a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "attribute name" .

:attributeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_Value ;
    rdfs:range xsd:string ;
    rdfs:label "attribute value" .

:hasInvoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date .

:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string .

:hasQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:integer .

:hasUnitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:hasLineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:hasTotalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal .

:hasTaxAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal .

:hasCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:string .

:netPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal .

:currency a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount, :Cl_InvoiceAmount ;
    rdfs:range xsd:string .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The actual numeric value of the invoice amount." .

:invoiceNumberValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range xsd:string .

:fieldName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:string .

:isFieldRequired a owl:DatatypeProperty ;
    rdfs:domain :Cl_Field ;
    rdfs:range xsd:boolean .

:constraintType a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueConstraint ;
    rdfs:range xsd:string .

:constraintValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValueConstraint ;
    rdfs:range xsd:string .

:requirementDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequirementStatement ;
    rdfs:range xsd:string .

:validationContextDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationContext ;
    rdfs:range xsd:string .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAssignment ;
    rdfs:range xsd:dateTime .

:org_name a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:org_identifier a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:org_description a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:org_establishedDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:date .

:organizationType_label a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range xsd:string .

:contact_email a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:contact_phone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:contact_address a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:organizationRole_label a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range xsd:string .

:involvementDetails a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range xsd:string .

:involvementDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_OrganizationInvolvement ;
    rdfs:range xsd:date .

:roleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string ;
    rdfs:label "role description" ;
    rdfs:comment "A textual description of the role played by the organization in the invoice." .

:address_line1 a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:address_line2 a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:state a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:postal_code a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string .

#################################################################
# Buyer Address Assignment Properties
#################################################################

:buyerAddressAssignment_hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Buyer ;
    owl:inverseOf :isBuyerInAddressAssignment .

:isBuyerInAddressAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssignment .

:buyerAddressAssignment_hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssignment ;
    rdfs:range :Cl_Address ;
    owl:inverseOf :isAddressInBuyerAssignment .

:isAddressInBuyerAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssignment .

#################################################################
# Restrictions, Equivalent Classes, and General Class Axioms
#################################################################

:Cl_EDIFACTMessage owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasInvoiceListing ;
        owl:allValuesFrom :Cl_InvoiceListing
    ]
] .

:Cl_InvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :listedInvoice ;
        owl:someValuesFrom :Cl_Invoice
    ]
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :invoiceHasInvolvement ; owl:allValuesFrom :Cl_InvoiceOrganizationInvolvement ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:allValuesFrom :Cl_InvoiceLine ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceAmountAssignment ; owl:someValuesFrom :Cl_InvoiceAmountAssignment ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceParticipation ; owl:someValuesFrom [
            a owl:Restriction ; owl:onProperty :hasPartyRole ; owl:someValuesFrom :Cl_BuyerRole
        ]]
    )
] .

:Cl_InvoiceOrganizationInvolvement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :involvesInvoice ; owl:allValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :roleOrganization ; owl:allValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :roleType ; owl:allValuesFrom :Cl_InvoiceRoleType ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :participationOrganization ;
        owl:allValuesFrom :Cl_Organization
    ]
] .

:Cl_InvoiceLine owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :refersToItem ;
        owl:allValuesFrom :Cl_Item
    ]
] .

:Cl_NetPriceCalculation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :includesInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom :Cl_MonetaryAmount ]
    )
] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasAmountValue ; owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_InvoiceAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :assignedToBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

:Cl_FileFormat owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasSpecification ;
        owl:allValuesFrom :Cl_FileFormatSpecification
    ]
] .

:Cl_FileFormatSpecification owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :hasField ; owl:someValuesFrom :Cl_Field ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasRequiredInformation ; owl:someValuesFrom :Cl_RequiredInformation ]
    )
] .

:Cl_Field owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :fieldName ; owl:allValuesFrom xsd:string ]
        [ rdf:type owl:Restriction ; owl:onProperty :isFieldRequired ; owl:allValuesFrom xsd:boolean ]
    )
] .

:Cl_RequiredInformation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:Restriction [
        owl:onProperty :hasRequirementStatement ;
        owl:someValuesFrom :Cl_RequirementStatement
    ]
] .

:Cl_RequirementStatement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :relatesToField ; owl:someValuesFrom :Cl_Field ]
        [ rdf:type owl:Restriction ; owl:onProperty :relatesToValueConstraint ; owl:someValuesFrom :Cl_ValueConstraint ]
        [ rdf:type owl:Restriction ; owl:onProperty :hasValidationContext ; owl:someValuesFrom :Cl_ValidationContext ]
    )
] .

:Cl_BuyerAddressAssignment rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :buyerAddressAssignment_hasBuyer ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
], [
    a owl:Restriction ;
    owl:onProperty :buyerAddressAssignment_hasAddress ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :buyerAddressAssignment_hasBuyer ; owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :buyerAddressAssignment_hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:Cl_ItemDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasAttribute ; owl:someValuesFrom :Cl_ItemAttribute ]
        [ a owl:Restriction ; owl:onProperty :hasAttributeValue ; owl:someValuesFrom :Cl_Value ]
    )
] .

:Cl_InvoiceIdentification rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :identifiesInvoiceNumber ;
    owl:allValuesFrom :Cl_InvoiceNumber
] .

:Cl_Invoice rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasInvoiceIdentification ;
    owl:someValuesFrom :Cl_InvoiceIdentification
] .

:Cl_InvoiceNumber rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:allValuesFrom xsd:string
] .

:Cl_Organization owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :org_name ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :involvesEvent ; owl:someValuesFrom :Cl_Event ]
    )
] .

:Cl_OrganizationType owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :hasOrganizationType ;
        owl:allValuesFrom :Cl_OrganizationType
    ]
] .

#################################################################
# Disjointness and Disjoint Unions
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_InvoiceListing .
:Cl_Invoice owl:disjointWith :Cl_InvoiceListing, :Cl_Organization, :Cl_BusinessProcess, :Cl_InvoiceAmountAssignment, :Cl_InvoiceNumber, :Cl_InvoiceIdentification, :Cl_InvoiceItem, :Cl_MonetaryAmount, :Cl_InvoiceAssignment, :Cl_InvoiceRole .
:Cl_InvoiceListing owl:disjointWith :Cl_Invoice .
:Cl_InvoiceAmountAssignment owl:disjointWith :Cl_Invoice, :Cl_InvoiceAmount .
:Cl_InvoiceAmount owl:disjointWith :Cl_Invoice, :Cl_InvoiceAmountAssignment .
:Cl_InvoiceItem owl:disjointWith :Cl_MonetaryAmount, :Cl_Invoice .
:Cl_InvoiceAssignment owl:disjointWith :Cl_Invoice, :Cl_BusinessProcess .
:Cl_InvoiceDetail owl:disjointUnionOf ( :Cl_InvoiceItem :Cl_MonetaryAmount ) .
:Cl_Organization owl:disjointWith :Cl_Person, :Cl_Event, :Cl_ContactInformation, :Cl_Buyer, :Cl_InvoiceNumber, :Cl_InvoiceIdentification .
:Cl_Person owl:disjointWith :Cl_Organization .
:Cl_Buyer owl:disjointWith :Cl_Organization .
:Cl_Address owl:disjointWith :Cl_Person, :Cl_Organization .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_OrganizationRole owl:disjointWith :Cl_OrganizationType .
:Cl_OrganizationRole owl:disjointUnionOf ( :Cl_SponsorRole :Cl_PartnerRole :Cl_OrganizerRole ) .
:Cl_InvoiceRoleType owl:disjointUnionOf ( :Cl_SupplierRole :Cl_ClientRole :Cl_PayerRole :Cl_RecipientRole ) .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_NetPriceCalculation owl:disjointWith :Cl_InvoiceLine, :Cl_Item, :Cl_MonetaryAmount .
:Cl_MonetaryAmount owl:disjointWith :Cl_Item, :Cl_InvoiceLine .
:Cl_Item owl:disjointWith :Cl_ItemDisplayInfo, :Cl_ItemAttribute, :Cl_Value .
:Cl_ItemDisplayInfo owl:disjointWith :Cl_ItemAttribute, :Cl_Value .
:Cl_ItemAttribute owl:disjointWith :Cl_Value .
:Cl_FileFormat owl:disjointWith :Cl_FileFormatComponent .
:Cl_FileFormatComponent owl:disjointWith :Cl_ValidationRequirement .
:Cl_RequiredInformation owl:disjointWith :Cl_Field .
:Cl_ValueConstraint owl:disjointWith :Cl_Field .
:Cl_FieldValidationRequirement owl:disjointWith :Cl_ValidationContext .
:Cl_InvoiceNumber owl:disjointWith :Cl_Invoice, :Cl_InvoiceIdentification, :Cl_Organization, :Cl_InvoiceAmountAssignment .
:Cl_InvoiceIdentification owl:disjointWith :Cl_Invoice, :Cl_Organization, :Cl_InvoiceNumber .
:Cl_InvoiceRole owl:disjointWith :Cl_Invoice .

#################################################################
# Example Individuals (Optional)
#################################################################

:edifactMsg123 a :Cl_EDIFACTMessage ;
    :edifactMessageId "MSG123" ;
    :hasInvoiceListing :invoiceListing123 .

:invoiceListing123 a :Cl_InvoiceListing ;
    :listedInvoice :invoiceA, :invoiceB .

:invoiceA a :Cl_Invoice ;
    :invoiceId "INV-001" ;
    :invoiceDate "2024-05-01"^^xsd:date ;
    :hasInvoiceIdentification :invoiceA_id .

:invoiceA_id a :Cl_InvoiceIdentification ;
    :identifiesInvoiceNumber :invoiceA_number .

:invoiceA_number a :Cl_InvoiceNumber ;
    :invoiceNumberValue "INV-001" .

:invoiceB a :Cl_Invoice ;
    :invoiceId "INV-002" ;
    :invoiceDate "2024-05-02"^^xsd:date ;
    :hasInvoiceIdentification :invoiceB_id .

:invoiceB_id a :Cl_InvoiceIdentification ;
    :identifiesInvoiceNumber :invoiceB_number .

:invoiceB_number a :Cl_InvoiceNumber ;
    :invoiceNumberValue "INV-002" .

:Invoice123 a :Cl_Invoice ;
    :hasInvoiceRole :Invoice123SupplierRole, :Invoice123ClientRole ;
    :hasInvoiceIdentification :Invoice123_id .

:Invoice123_id a :Cl_InvoiceIdentification ;
    :identifiesInvoiceNumber :Invoice123_number .

:Invoice123_number a :Cl_InvoiceNumber ;
    :invoiceNumberValue "INV-123" .

:OrgS a :Cl_Organization ;
    :org_name "OrgS" .

:OrgClient a :Cl_Organization ;
    :org_name "OrgClient" .

:Invoice123SupplierRole a :Cl_InvoiceRole ;
    :roleOrganization :OrgS ;
    :roleType :Cl_SupplierRole ;
    :roleDescription "OrgS acts as the supplier for Invoice123." .

:Invoice123ClientRole a :Cl_InvoiceRole ;
    :roleOrganization :OrgClient ;
    :roleType :Cl_ClientRole ;
    :roleDescription "OrgClient acts as the client for Invoice123." .

:invoice123 a :Cl_Invoice ;
    :hasInvoiceIdentification :invoice123_id .

:invoice123_id a :Cl_InvoiceIdentification ;
    :identifiesInvoiceNumber :invoice123_number .

:invoice123_number a :Cl_InvoiceNumber ;
    :invoiceNumberValue "INV-123A" .

:process456 a :Cl_BusinessProcess .
:assignment789 a :Cl_InvoiceAssignment ;
    :hasInvoice :invoice123 ;
    :assignedToBusinessProcess :process456 ;
    :assignmentDate "2024-06-01T10:00:00"^^xsd:dateTime .
