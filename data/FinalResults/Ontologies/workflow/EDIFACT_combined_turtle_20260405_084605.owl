    rdfs:label "validity status" ;
    rdfs:comment "Validity status of the file format." .

#################################################################
# Restrictions & Equivalent Classes
#################################################################

:Cl_InvoiceListing owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :listsInvoice ; owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_EDIFACTMessage owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoiceListing ; owl:someValuesFrom :Cl_InvoiceListing ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ a owl:Restriction ; owl:onProperty :involvesInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_OrganizationInvoiceRole owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:someValuesFrom :Cl_InvoiceRole ]
    )
] .

:Cl_OrganizationInvolvement owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :hasOrganizationRole ; owl:someValuesFrom :Cl_OrganizationRole ]
        [ a owl:Restriction ; owl:onProperty :hasOrganizationDisplayInfo ; owl:someValuesFrom :Cl_OrganizationDisplayInfo ]
    )
] .

:Cl_OrganizationDisplayInfo owl:disjointUnionOf (
    :Cl_OrganizationContactInfo
    :Cl_OrganizationIdentifier
    :Cl_OrganizationLocation
    :Cl_OrganizationRole
    :Cl_OrganizationType
) .

:Cl_BuyerParticipation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_InvoiceParticipation
        [ a owl:Restriction ; owl:onProperty :hasInvoiceRole ; owl:allValuesFrom :Cl_BuyerRole ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :hasBuyer ; owl:allValuesFrom :Cl_Buyer
] ;
    owl:equivalentClass [
        a owl:Restriction ; owl:onProperty :hasAddress ; owl:allValuesFrom :Cl_Address
    ] .

:Cl_InvoiceItem owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :itemQuantity ; owl:someValuesFrom xsd:decimal ]
        [ a owl:Restriction ; owl:onProperty :itemUnitPrice ; owl:someValuesFrom xsd:decimal ]
    )
] .

:Cl_Item owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( :Cl_Product :Cl_Service )
] .

:Cl_SoldItemDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :aboutItem ; owl:allValuesFrom :Cl_Item ]
        [ a owl:Restriction ; owl:onProperty :hasInformation ; owl:someValuesFrom :Cl_Information ]
    )
] .

:Cl_SoldItemDisplayInfo rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInformation ;
    owl:someValuesFrom :Cl_Information
] .

:Cl_InvoiceLine owl:equivalentClass [
    a owl:Restriction ; owl:onProperty :refersToLineItem ; owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
    owl:equivalentClass [
        a owl:Restriction ; owl:onProperty :hasQuantity ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    owl:equivalentClass [
        a owl:Restriction ; owl:onProperty :hasUnitPrice ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    owl:equivalentClass [
        a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ; owl:onProperty :lineProduct ; owl:someValuesFrom :Cl_Product ]
            [ a owl:Restriction ; owl:onProperty :lineQuantity ; owl:someValuesFrom xsd:integer ]
            [ a owl:Restriction ; owl:onProperty :lineUnitPrice ; owl:someValuesFrom xsd:decimal ]
            [ a owl:Restriction ; owl:onProperty :lineAmount ; owl:someValuesFrom :Cl_Amount ]
        )
    ] .

:Cl_InvoiceDetail owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:someValuesFrom :Cl_InvoiceLine ]
    )
] ;
    owl:equivalentClass [
        a owl:Restriction ; owl:onProperty :hasInvoiceLine ; owl:allValuesFrom :Cl_InvoiceLine
    ] .

:Cl_InvoiceAmountAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :refersToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasAmount ; owl:someValuesFrom :Cl_InvoiceAmount ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_Document
        [ a owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:allValuesFrom :Cl_InvoiceNumber ]
    )
] .

:Cl_InvoiceNumber owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :invoiceNumberValue ; owl:allValuesFrom xsd:string ]
    )
] .

:Cl_FileFormat owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :hasRequirement ;
        owl:someValuesFrom :Cl_FileFormatRequirement
    ]
] .

:Cl_FileFormatRequirement owl:equivalentClass [
    a owl:Class ;
    owl:Restriction [
        owl:onProperty :requiresField ;
        owl:someValuesFrom :Cl_FileFormatField
    ]
] .

:Cl_FileFormatField owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasDataTypeConstraint ; owl:someValuesFrom :Cl_FieldDataType ]
        [ a owl:Restriction ; owl:onProperty :hasCardinalityConstraint ; owl:someValuesFrom :Cl_FieldCardinality ]
    )
] .

:Cl_Assignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :assignedInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :assignedBusinessProcess ; owl:someValuesFrom :Cl_BusinessProcess ]
    )
] .

#################################################################
# Disjointness & Disjoint Union
#################################################################

:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_Organization owl:disjointWith :Cl_Invoice, :Cl_InvoiceRole .
:Cl_Invoice owl:disjointWith :Cl_InvoiceRole, :Cl_InvoiceParticipation, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_Product, :Cl_Customer, :Cl_InvoiceLine, :Cl_Amount, :Cl_Date, :Cl_Item, :Cl_InvoiceComponent, :Cl_InvoiceNumber, :Cl_FileFormatField, :Cl_FileFormatRequirement, :Cl_FileFormat, :Cl_Assignment, :Cl_BusinessProcess .
:Cl_InvoiceRole owl:disjointWith :Cl_Invoice, :Cl_InvoiceParticipation .
:Cl_InvoiceParticipation owl:disjointWith :Cl_InvoiceRole .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_Product owl:disjointWith :Cl_Service, :Cl_Customer, :Cl_InvoiceLine, :Cl_Amount, :Cl_Date .
:Cl_Customer owl:disjointWith :Cl_InvoiceLine, :Cl_Amount, :Cl_Date .
:Cl_InvoiceLine owl:disjointWith :Cl_Quantity, :Cl_UnitPrice, :Cl_NetPrice, :Cl_MonetaryValue, :Cl_Amount, :Cl_Date .
:Cl_Quantity owl:disjointWith :Cl_UnitPrice, :Cl_NetPrice, :Cl_MonetaryValue .
:Cl_UnitPrice owl:disjointWith :Cl_NetPrice .
:Cl_Amount owl:disjointWith :Cl_Date .
:Cl_FieldValueConstraint owl:disjointWith :Cl_FieldDataType, :Cl_FieldCardinality, :Cl_FieldFormatRule .
:Cl_FileFormatRequirement owl:disjointWith :Cl_FileFormatField .
:Cl_FileFormat owl:disjointWith :Cl_FileFormatField, :Cl_FileFormatRequirement .
:Cl_BusinessProcess owl:disjointWith :Cl_Invoice .
:Cl_Assignment owl:disjointWith :Cl_Invoice, :Cl_BusinessProcess .
:Cl_Document owl:disjointUnionOf ( :Cl_EDIFACTMessage :Cl_Invoice ) .
:Cl_InvoiceComponent owl:disjointUnionOf ( :Cl_InvoiceLine :Cl_Amount :Cl_Date ) .

:Cl_Name owl:disjointWith :Cl_Description, :Cl_Price, :Cl_Image, :Cl_Category, :Cl_StockStatus, :Cl_AdditionalAttribute .
:Cl_Description owl:disjointWith :Cl_Price, :Cl_Image, :Cl_Category, :Cl_StockStatus, :Cl_AdditionalAttribute .
:Cl_Price owl:disjointWith :Cl_Image, :Cl_Category, :Cl_StockStatus, :Cl_AdditionalAttribute .
:Cl_Image owl:disjointWith :Cl_Category, :Cl_StockStatus, :Cl_AdditionalAttribute .
:Cl_Category owl:disjointWith :Cl_StockStatus, :Cl_AdditionalAttribute .
:Cl_StockStatus owl:disjointWith :Cl_AdditionalAttribute .
:Cl_Document owl:disjointWith :Cl_InvoiceNumber .

#################################################################
# Naming Convention Alignment
#################################################################

:Cl_BuyerParticipation owl:sameAs :Cl_BuyerParticipation .
:hasInvoiceParticipation owl:sameAs :hasInvoiceParticipation .

#################################################################
# End of ontology
#################################################################