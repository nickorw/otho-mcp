@prefix : <http://example.org/fests#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests>
    a owl:Ontology ;
    rdfs:label "FestS" .

### Classes

:Cl_EDIFACTMessage a owl:Class ;
    rdfs:label "EDIFACT Message" ;
    rdfs:comment "A message formatted according to the EDIFACT standard." .

:Cl_Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A general document class." .

:Cl_Invoice a owl:Class ;
    rdfs:subClassOf :Cl_Document ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice document that may be listed in an EDIFACT message." .

:Cl_MessageContent a owl:Class ;
    rdfs:label "Message Content" ;
    rdfs:comment "A pivot class representing the listing of a document (e.g., invoice) within an EDIFACT message." .

:Cl_Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company, institution, or group involved in the event or context." .

:Cl_InvoiceParticipation a owl:Class ;
    rdfs:label "Invoice Participation" ;
    rdfs:comment "Represents the participation of an organization in an invoice." .

:Cl_Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role played by an entity in a business process or document." .

:Cl_BuyerRole a owl:Class ; rdfs:subClassOf :Cl_Role, :Cl_InvoicePartyRole ; rdfs:label "Buyer Role" ; rdfs:comment "Role of a buyer in an invoice." .
:Cl_SellerRole a owl:Class ; rdfs:subClassOf :Cl_Role, :Cl_InvoicePartyRole ; rdfs:label "Seller Role" ; rdfs:comment "Role of a seller in an invoice." .
:Cl_IssuerRole a owl:Class ; rdfs:subClassOf :Cl_Role ; rdfs:label "Issuer Role" ; rdfs:comment "Role of the issuer in the context of an invoice." .
:Cl_RecipientRole a owl:Class ; rdfs:subClassOf :Cl_Role ; rdfs:label "Recipient Role" ; rdfs:comment "Role of the recipient in the context of an invoice." .

:Cl_RoleInInvoice a owl:Class ;
    rdfs:label "Role in Invoice" ;
    rdfs:comment "A role assigned to an organization in the context of an invoice." .

:Cl_InvoicePartyRole a owl:Class ; rdfs:label "Invoice Party Role" ; rdfs:comment "Role of a party in an invoice." .
:Cl_InvoicePartyAssignment a owl:Class ; rdfs:label "Invoice Party Assignment" ; rdfs:comment "Assignment of a party to a role in an invoice." .

:Cl_InformationDisplay a owl:Class ;
    rdfs:label "Information Display" ;
    rdfs:comment "A reification class representing the display of information about an organization." .

:Cl_InformationDetail a owl:Class ;
    rdfs:label "Information Detail" ;
    rdfs:comment "Superclass for all types of details that can be displayed about an organization." .

:Cl_ContactInformation a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Contact Information" ;
    rdfs:comment "Contact information related to an organization." .

:Cl_OrganizationType a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Organization Type" ;
    rdfs:comment "Type or category of organization (e.g., NGO, company, government)." .

:Cl_OrganizationRole a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Organization Role" ;
    rdfs:comment "Role of the organization in the context (e.g., sponsor, partner, organizer)." .

:Cl_OrganizationLocation a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Organization Location" ;
    rdfs:comment "Location information about an organization." .

:Cl_OrganizationDescription a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Organization Description" ;
    rdfs:comment "A textual description about an organization." .

:Cl_OrganizationIdentifier a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "Identifiers such as registration numbers or codes for organizations." .

:Cl_Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "An individual involved in a business process or document." ;
    rdfs:subClassOf :Cl_Actor .

:Cl_Buyer a owl:Class ; rdfs:subClassOf :Cl_Person ; rdfs:label "Buyer" ; rdfs:comment "A person who buys items." .
:Cl_Seller a owl:Class ; rdfs:subClassOf :Cl_Person ; rdfs:label "Seller" ; rdfs:comment "A person who sells items." .

:Cl_Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address." .

:Cl_Transaction a owl:Class ;
    rdfs:label "Transaction" ;
    rdfs:comment "A transaction involving parties and items." .

:Cl_BuyerAddressAssignment a owl:Class ;
    rdfs:label "Buyer Address Assignment" ;
    rdfs:comment "Assignment of a buyer to an address." .

:Cl_Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A thing that is sold." .

:Cl_Product a owl:Class ; rdfs:subClassOf :Cl_Item ; rdfs:label "Product" ; rdfs:comment "A tangible product." .
:Cl_Service a owl:Class ; rdfs:subClassOf :Cl_Item ; rdfs:label "Service" ; rdfs:comment "An intangible service." .

:Cl_InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "A line item in an invoice." .

:Cl_Amount a owl:Class ;
    rdfs:label "Amount" ;
    rdfs:comment "A monetary amount." .

:Cl_MonetaryValue a owl:Class ;
    rdfs:label "Monetary Value" ;
    rdfs:comment "A value representing money." .

:Cl_PriceComponent a owl:Class ; rdfs:subClassOf :Cl_Amount ; rdfs:label "Price Component" ; rdfs:comment "A component of the price, such as net or tax." .
:Cl_NetPrice a owl:Class ; rdfs:subClassOf :Cl_PriceComponent ; rdfs:label "Net Price" ; rdfs:comment "The net price component." .

:Cl_Sale a owl:Class ;
    rdfs:label "Sale" ;
    rdfs:comment "A sale event involving an item." .

:Cl_ItemInformation a owl:Class ;
    rdfs:label "Item Information" ;
    rdfs:comment "Information displayed about the item sold. Pivot class for reification." .

:Cl_InformationType a owl:Class ;
    rdfs:label "Information Type" ;
    rdfs:comment "Type/category of information displayed about an item (e.g., price, description, name)." .

:Cl_Display a owl:Class ;
    rdfs:label "Display" ;
    rdfs:comment "The act or event of displaying item information." .

:Cl_InvoiceDetail a owl:Class ;
    rdfs:label "Invoice Detail" ;
    rdfs:comment "A pivot class to represent the details of a product or service within an invoice, including quantity, unit price, and total for the line item." .

:Cl_Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A customer who receives an invoice." .

:Cl_Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "An employee involved in a business process." .

:Cl_Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "A generic actor." .

:Cl_Payment a owl:Class ;
    rdfs:label "Payment" ;
    rdfs:comment "A payment transaction." .

:Cl_InvoiceNumber a owl:Class ;
    rdfs:label "Invoice Number" ;
    rdfs:comment "A class representing an invoice number." .

:Cl_InvoiceIdentification a owl:Class ;
    rdfs:label "Invoice Identification" ;
    rdfs:comment "Identification information for an invoice." .

:Cl_InvoiceAmount a owl:Class ;
    rdfs:label "Invoice Amount" ;
    rdfs:comment "The monetary value stated on an invoice." .

:Cl_InvoiceAmountAssignment a owl:Class ;
    rdfs:label "Invoice Amount Assignment" ;
    rdfs:comment "A pivot class representing the assignment of a specific amount to an invoice." .

:Cl_FileFormat a owl:Class ;
    rdfs:label "File Format" ;
    rdfs:comment "A file format definition." .

:Cl_FormatSpecification a owl:Class ;
    rdfs:label "Format Specification" ;
    rdfs:comment "Specification for a file format." .

:Cl_RequiredElement a owl:Class ;
    rdfs:label "Required Element" ;
    rdfs:comment "A required element in a format specification." .

:Cl_ElementConstraint a owl:Class ;
    rdfs:label "Element Constraint" ;
    rdfs:comment "A constraint on an element in a format specification." .

:Cl_ValidationRule a owl:Class ; rdfs:subClassOf :Cl_FormatSpecification ; rdfs:label "Validation Rule" ; rdfs:comment "A rule for validating a file format." .
:Cl_ValidFileFormatInformation a owl:Class ; rdfs:subClassOf :Cl_ValidationContext ; rdfs:label "Valid File Format Information" ; rdfs:comment "Information about a valid file format." .
:Cl_InformationItem a owl:Class ; rdfs:subClassOf :Cl_ValidFileFormatInformation ; rdfs:label "Information Item" ; rdfs:comment "An item of information relevant to file format validation." .
:Cl_ValidationContext a owl:Class ;
    rdfs:label "Validation Context" ;
    rdfs:comment "The context in which validation is performed." .
:Cl_ValidationResult a owl:Class ;
    rdfs:label "Validation Result" ;
    rdfs:comment "The result of a validation check." .
:Cl_FileFormatValidationRequirement a owl:Class ;
    rdfs:label "File Format Validation Requirement" ;
    rdfs:comment "A requirement for validating a file format." .
:Cl_ValidationCheck a owl:Class ;
    rdfs:label "Validation Check" ;
    rdfs:comment "A check performed during validation." .

:Cl_BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process within an organization." .

:Cl_ProcessDocumentAssignment a owl:Class ;
    rdfs:label "Process Document Assignment" ;
    rdfs:comment "A reified relationship linking a business process and a document, possibly with additional attributes such as assignment date." .

:Cl_BuyerInInvoice a owl:Class ;
    rdfs:label "Buyer in Invoice" ;
    rdfs:comment "A buyer as represented in the context of an invoice." .

:Cl_Invoice_Assignment_Restriction a owl:Class ;
    rdfs:label "Invoice Assignment Restriction" ;
    rdfs:comment "Restricts the assignment to only invoices." ;
    rdfs:subClassOf :Cl_ProcessDocumentAssignment .

:Cl_ItemsSoldInInvoice a owl:Class ;
    rdfs:label "Items Sold in Invoice" ;
    rdfs:comment "A class representing the items sold in an invoice." .

#################################################################
# Class Hierarchies
#################################################################

:Cl_Document a owl:Class .
:Cl_Invoice rdfs:subClassOf :Cl_Document .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Item rdfs:subClassOf owl:Thing .
:Cl_InvoiceLine rdfs:subClassOf owl:Thing .
:Cl_Amount rdfs:subClassOf owl:Thing .
:Cl_InvoiceDetail owl:disjointWith :Cl_Invoice, :Cl_Product, :Cl_Customer, :Cl_Employee, :Cl_Organization, :Cl_Payment .
:Cl_ContactInformation owl:disjointWith :Cl_OrganizationType, :Cl_OrganizationRole, :Cl_OrganizationLocation, :Cl_OrganizationDescription, :Cl_OrganizationIdentifier .
:Cl_OrganizationType owl:disjointWith :Cl_OrganizationRole, :Cl_OrganizationLocation, :Cl_OrganizationDescription, :Cl_OrganizationIdentifier .
:Cl_OrganizationRole owl:disjointWith :Cl_OrganizationLocation, :Cl_OrganizationDescription, :Cl_OrganizationIdentifier .
:Cl_OrganizationLocation owl:disjointWith :Cl_OrganizationDescription, :Cl_OrganizationIdentifier .
:Cl_OrganizationDescription owl:disjointWith :Cl_OrganizationIdentifier .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole, :Cl_IssuerRole, :Cl_RecipientRole .
:Cl_SellerRole owl:disjointWith :Cl_IssuerRole, :Cl_RecipientRole .
:Cl_IssuerRole owl:disjointWith :Cl_RecipientRole .
:Cl_BuyerRole owl:disjointWith :Cl_SellerRole .
:Cl_Invoice owl:disjointWith :Cl_Organization, :Cl_InvoiceAmount, :Cl_InvoiceAmountAssignment, :Cl_InvoiceLine, :Cl_Item, :Cl_PriceComponent .
:Cl_InvoiceAmount owl:disjointWith :Cl_InvoiceAmountAssignment .
:Cl_RequiredElement owl:disjointWith :Cl_ElementConstraint .
:Cl_ValidationRule owl:disjointWith :Cl_RequiredElement, :Cl_ElementConstraint .
:Cl_ValidFileFormatInformation owl:disjointWith :Cl_FileFormat, :Cl_FileFormatValidationRequirement .
:Cl_ValidationResult owl:disjointWith :Cl_ValidFileFormatInformation .
:Cl_Item owl:disjointWith :Cl_Sale, :Cl_ItemInformation, :Cl_InformationType, :Cl_Display .
:Cl_Sale owl:disjointWith :Cl_ItemInformation, :Cl_InformationType, :Cl_Display .
:Cl_ItemInformation owl:disjointWith :Cl_InformationType, :Cl_Display .
:Cl_InformationType owl:disjointWith :Cl_Display .
:Cl_BusinessProcess owl:disjointWith :Cl_Document .
:Cl_InvoiceParticipation owl:disjointWith :Cl_Invoice, :Cl_Organization .
:Cl_Invoice owl:disjointWith :Cl_InvoiceNumber, :Cl_InvoiceIdentification .
:Cl_InvoiceIdentification owl:disjointWith :Cl_InvoiceNumber, :Cl_Invoice .
:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice, :Cl_Document .
:Cl_MessageContent owl:disjointWith :Cl_EDIFACTMessage, :Cl_Invoice, :Cl_Document .
:Cl_Buyer owl:disjointWith :Cl_Seller .

#################################################################
# Object Properties

:hasMessageContent a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_MessageContent ;
    rdfs:label "has message content" ;
    rdfs:comment "Associates an EDIFACT message with its message content." ;
    owl:inverseOf :isMessageContentOf .

:isMessageContentOf a owl:ObjectProperty ;
    rdfs:domain :Cl_MessageContent ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "is message content of" ;
    rdfs:comment "Inverse of hasMessageContent." .

:listsDocument a owl:ObjectProperty ;
    rdfs:domain :Cl_MessageContent ;
    rdfs:range :Cl_Document ;
    rdfs:label "lists document" ;
    rdfs:comment "Indicates the document (e.g., invoice) listed in the message content." ;
    owl:inverseOf :isListedInMessageContent .

:isListedInMessageContent a owl:ObjectProperty ;
    rdfs:domain :Cl_Document ;
    rdfs:range :Cl_MessageContent ;
    rdfs:label "is listed in message content" ;
    rdfs:comment "Inverse of listsDocument." .

:listsInvoice a owl:ObjectProperty ;
    rdfs:subPropertyOf :listsDocument ;
    rdfs:domain :Cl_MessageContent ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" ;
    rdfs:comment "Specifically indicates an invoice listed in the message content." ;
    owl:inverseOf :isInvoiceListedInMessageContent .

:isInvoiceListedInMessageContent a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_MessageContent ;
    rdfs:label "is invoice listed in message content" ;
    rdfs:comment "Inverse of listsInvoice." .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Indicates the organization involved in invoice participation." ;
    owl:inverseOf :isOrganizationInvolvedInParticipation .

:isOrganizationInvolvedInParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is organization involved in participation" ;
    rdfs:comment "Inverse of involvesOrganization." .

:involvesInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "involves invoice" ;
    rdfs:comment "Indicates the invoice involved in invoice participation." ;
    owl:inverseOf :isInvoiceInvolvedInParticipation .

:isInvoiceInvolvedInParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    rdfs:label "is invoice involved in participation" ;
    rdfs:comment "Inverse of involvesInvoice." .

:hasInvolvedOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Organization ;
    owl:propertyChainAxiom ( [ owl:inverseOf :involvesInvoice ] :involvesOrganization ) ;
    rdfs:label "has involved organization" ;
    rdfs:comment "Property chain for organizations involved in an invoice." ;
    owl:inverseOf :isInvolvedOrganizationOf .

:isInvolvedOrganizationOf a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is involved organization of" ;
    rdfs:comment "Inverse of hasInvolvedOrganization." .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_RoleInInvoice ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has organization" ;
    rdfs:comment "Links a role in invoice to an organization." ;
    owl:inverseOf :isOrganizationInRoleInInvoice .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_RoleInInvoice ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "has invoice" ;
    rdfs:comment "Links a role in invoice to an invoice." ;
    owl:inverseOf :isInvoiceInRoleInInvoice .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_RoleInInvoice ;
    rdfs:range :Cl_Role ;
    rdfs:label "has role" ;
    rdfs:comment "Links a role in invoice to a role." ;
    owl:inverseOf :isRoleInRoleInInvoice .

:hasOrgRole a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationRole ;
    rdfs:label "has organization role" ;
    rdfs:comment "Role of the organization in the context." ;
    owl:inverseOf :isOrgRoleOfOrganization .

:isOrgRoleOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationRole ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is organization role of organization" ;
    rdfs:comment "Inverse of hasOrgRole." .

:isOrganizationInRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_RoleInInvoice ;
    rdfs:label "is organization in role in invoice" ;
    rdfs:comment "Inverse of hasOrganization." .

:isInvoiceInRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_RoleInInvoice ;
    rdfs:label "is invoice in role in invoice" ;
    rdfs:comment "Inverse of hasInvoice." .

:isRoleInRoleInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range :Cl_RoleInInvoice ;
    rdfs:label "is role in role in invoice" ;
    rdfs:comment "Inverse of hasRole." .

:hasPartyRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssignment ;
    rdfs:range :Cl_InvoicePartyRole ;
    rdfs:label "has party role" ;
    rdfs:comment "Links an invoice party assignment to a party role." ;
    owl:inverseOf :isPartyRoleOfAssignment .

:isPartyRoleOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyRole ;
    rdfs:range :Cl_InvoicePartyAssignment ;
    rdfs:label "is party role of assignment" ;
    rdfs:comment "Inverse of hasPartyRole." .

:hasParty a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssignment ;
    rdfs:range :Cl_Organization ;
    rdfs:label "has party" ;
    rdfs:comment "Links an invoice party assignment to an organization." ;
    owl:inverseOf :isPartyOfAssignment .

:isPartyOfAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoicePartyAssignment ;
    rdfs:label "is party of assignment" ;
    rdfs:comment "Inverse of hasParty." .

:hasBuyerAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoicePartyAssignment ;
    rdfs:label "has buyer assignment" ;
    rdfs:comment "Links an invoice to a buyer party assignment." ;
    owl:inverseOf :isBuyerInAssignment .

:isBuyerInAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoicePartyAssignment ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is buyer in assignment" ;
    rdfs:comment "Inverse of hasBuyerAssignment." .

:displayedInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationDisplay ;
    rdfs:range :Cl_InformationDetail ;
    rdfs:label "displayed information" ;
    rdfs:comment "Information displayed about an organization." ;
    owl:inverseOf :isInformationDisplayedBy .

:isInformationDisplayedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationDetail ;
    rdfs:range :Cl_InformationDisplay ;
    rdfs:label "is information displayed by" ;
    rdfs:comment "Inverse of displayedInformation." .

:displayedItemInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Display ;
    rdfs:range :Cl_ItemInformation ;
    rdfs:label "displayed item information" ;
    rdfs:comment "Information displayed about an item." ;
    owl:inverseOf :isItemInformationDisplayedBy .

:isItemInformationDisplayedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range :Cl_Display ;
    rdfs:label "is item information displayed by" ;
    rdfs:comment "Inverse of displayedItemInformation." .

:aboutOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationDisplay ;
    rdfs:range :Cl_Organization ;
    rdfs:label "about organization" ;
    rdfs:comment "The organization the information display is about." ;
    owl:inverseOf :isOrganizationDescribedBy .

:isOrganizationDescribedBy a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InformationDisplay ;
    rdfs:label "is organization described by" ;
    rdfs:comment "Inverse of aboutOrganization." .

:hasContactInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_ContactInformation ;
    rdfs:label "has contact information" ;
    rdfs:comment "Contact information for an organization." ;
    owl:inverseOf :isContactInformationOfOrganization .

:isContactInformationOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is contact information of organization" ;
    rdfs:comment "Inverse of hasContactInformation." .

:hasOrganizationType a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationType ;
    rdfs:label "has organization type" ;
    rdfs:comment "Type of organization." ;
    owl:inverseOf :isOrganizationTypeOfOrganization .

:isOrganizationTypeOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationType ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is organization type of organization" ;
    rdfs:comment "Inverse of hasOrganizationType." .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationLocation ;
    rdfs:label "has location" ;
    rdfs:comment "Location of the organization." ;
    owl:inverseOf :isLocationOfOrganization .

:isLocationOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationLocation ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is location of organization" ;
    rdfs:comment "Inverse of hasLocation." .

:hasDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationDescription ;
    rdfs:label "has description" ;
    rdfs:comment "Description of the organization." ;
    owl:inverseOf :isDescriptionOfOrganization .

:isDescriptionOfOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationDescription ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is description of organization" ;
    rdfs:comment "Inverse of hasDescription." .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_OrganizationIdentifier ;
    rdfs:label "has identifier" ;
    rdfs:comment "Identifier for the organization." ;
    owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationIdentifier ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Inverse of hasIdentifier." .

:aboutItem a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range :Cl_Item ;
    rdfs:label "about item" ;
    rdfs:comment "The item that the information is about." ;
    owl:inverseOf :isItemAboutItemInformation .

:isItemAboutItemInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_ItemInformation ;
    rdfs:label "is item about item information" ;
    rdfs:comment "Inverse of aboutItem." .

:hasInformationType a owl:ObjectProperty ;
    rdfs:domain :Cl_ItemInformation ;
    rdfs:range :Cl_InformationType ;
    rdfs:label "has information type" ;
    rdfs:comment "Type of information about the item." ;
    owl:inverseOf :isInformationTypeOfItemInformation .

:isInformationTypeOfItemInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationType ;
    rdfs:range :Cl_ItemInformation ;
    rdfs:label "is information type of item information" ;
    rdfs:comment "Inverse of hasInformationType." .

:partOfSale a owl:ObjectProperty ;
    rdfs:domain :Cl_Display ;
    rdfs:range :Cl_Sale ;
    rdfs:label "part of sale" ;
    rdfs:comment "Display is part of a sale." ;
    owl:inverseOf :hasDisplay .

:hasDisplay a owl:ObjectProperty ;
    rdfs:domain :Cl_Sale ;
    rdfs:range :Cl_Display ;
    rdfs:label "has display" ;
    rdfs:comment "Inverse of partOfSale." .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_Transaction ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "has buyer" ;
    rdfs:comment "The buyer in a transaction." ;
    owl:inverseOf :isBuyerOfTransaction .

:isBuyerOfTransaction a owl:ObjectProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_Transaction ;
    rdfs:label "is buyer of transaction" ;
