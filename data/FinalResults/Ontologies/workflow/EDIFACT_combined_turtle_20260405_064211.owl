    rdfs:label "payment amount" ;
    rdfs:comment "Amount of the payment." .

:invoice_number a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" ;
    rdfs:comment "Invoice number as string (alternative property)." ;
    owl:equivalentProperty :invoiceNumber .

:invoiceNumberValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceNumber ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value" ;
    rdfs:comment "Value of the invoice number." .

:netPriceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_NetPrice ;
    rdfs:range xsd:decimal ;
    rdfs:label "net price value" ;
    rdfs:comment "Value of the net price." .

:elementName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredElement ;
    rdfs:range xsd:string ;
    rdfs:label "element name" ;
    rdfs:comment "Name of the required element." .

:constraintDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ElementConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "constraint description" ;
    rdfs:comment "Description of the element constraint." .

:ruleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range xsd:string ;
    rdfs:label "rule description" ;
    rdfs:comment "Description of the validation rule." .

:informationItemName a owl:DatatypeProperty ;
    rdfs:domain :Cl_InformationItem ;
    rdfs:range xsd:string ;
    rdfs:label "information item name" ;
    rdfs:comment "Name of the information item." .

:informationItemValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InformationItem ;
    rdfs:range xsd:string ;
    rdfs:label "information item value" ;
    rdfs:comment "Value of the information item." .

:isValid a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationResult ;
    rdfs:range xsd:boolean ;
    rdfs:label "is valid" ;
    rdfs:comment "Whether the validation result is valid." .

:validationMessage a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationResult ;
    rdfs:range xsd:string ;
    rdfs:label "validation message" ;
    rdfs:comment "Validation message." .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_ProcessDocumentAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assignment date" ;
    rdfs:comment "Date of the process document assignment." .

:invoiceAmountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:decimal ;
    rdfs:label "invoice amount value" ;
    rdfs:comment "Value of the invoice amount." .

:invoiceAmountCurrency a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceAmount ;
    rdfs:range xsd:string ;
    rdfs:label "invoice amount currency" ;
    rdfs:comment "Currency of the invoice amount." .

#################################################################
# Restrictions and Equivalent Classes

:Cl_MessageContent owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :listsInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

:Cl_RoleInInvoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
        [ a owl:Restriction ; owl:onProperty :hasRole ; owl:cardinality "1"^^xsd:nonNegativeInteger ]
    )
] .

:Cl_InvoiceParticipation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty :involvesInvoice ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:Cl_InvoicePartyAssignment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasParty ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Organization ] ,
    [ a owl:Restriction ; owl:onProperty :hasPartyRole ; owl:allValuesFrom :Cl_BuyerRole ] .

:Cl_BuyerInInvoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_Organization
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf :hasParty ] ;
          owl:someValuesFrom [
              a owl:Class ;
              owl:intersectionOf (
                  :Cl_InvoicePartyAssignment
                  [ a owl:Restriction ; owl:onProperty :hasPartyRole ; owl:allValuesFrom :Cl_BuyerRole ]
                  [ a owl:Restriction ; owl:onProperty :hasInvoice ; owl:someValuesFrom :Cl_Invoice ]
              )
          ]
        ]
    )
] .

:Cl_InformationDisplay owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :aboutOrganization ; owl:allValuesFrom :Cl_Organization ]
        [ a owl:Restriction ; owl:onProperty :displayedInformation ; owl:someValuesFrom :Cl_InformationDetail ]
    )
] .

:Cl_BuyerAddressAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :buyerInAssignment ; owl:someValuesFrom :Cl_Buyer ]
        [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Cl_Address ]
    )
] .

:buyerInAssignment rdfs:range :Cl_Buyer .

:Cl_Invoice rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceLine ;
    owl:someValuesFrom :Cl_InvoiceLine
] .

:Cl_InvoiceLine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:allValuesFrom :Cl_Item
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasNetPrice ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ,
[
    a owl:Restriction ;
    owl:onProperty :refersToItem ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:Cl_ItemsSoldInInvoice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceLine ;
          owl:someValuesFrom [
              a owl:Restriction ;
              owl:onProperty :refersToItem ;
              owl:someValuesFrom :Cl_Item
          ]
        ]
    )
] .

:Cl_ItemInformation owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :aboutItem ;
    owl:allValuesFrom :Cl_Item
] .

:Cl_Invoice owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasInvoiceDetail ;
    owl:allValuesFrom :Cl_InvoiceDetail
] ,
[
    a owl:Restriction ;
    owl:onProperty :invoice_number ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ,
[
    a owl:Restriction ;
    owl:onProperty :hasInvoiceAmountAssignment ;
    owl:someValuesFrom :Cl_InvoiceAmountAssignment
] .

:Cl_InvoiceDetail owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :refersToProduct ;
    owl:allValuesFrom :Cl_Product
] .

:Cl_InvoiceIdentification owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :identifiesInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ a owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom :Cl_InvoiceNumber ]
    )
] .

:Cl_NetPrice owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Cl_PriceComponent
        [ a owl:Restriction ;
          owl:onProperty :netPriceValue ;
          owl:someValuesFrom xsd:decimal ]
    )
] .

:assignsInvoiceAmount a owl:FunctionalProperty ;
    owl:inverseOf :isInvoiceAmountOfAssignment .

:invoiceAmountAssignmentForInvoice a owl:FunctionalProperty ;
    owl:inverseOf :hasInvoiceAmountAssignment .

:Cl_ValidFileFormatInformation owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :providesInformationItem ;
          owl:allValuesFrom :Cl_InformationItem
        ]
    )
] .

:Cl_FileFormatValidationRequirement owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ; owl:onProperty :requiresInformationItem ; owl:someValuesFrom :Cl_InformationItem ]
        [ a owl:Restriction ; owl:onProperty :requiresElement ; owl:someValuesFrom :Cl_RequiredElement ]
        [ a owl:Restriction ; owl:onProperty :requiresConstraint ; owl:someValuesFrom :Cl_ElementConstraint ]
        [ a owl:Restriction ; owl:onProperty :requiresValidationRule ; owl:someValuesFrom :Cl_ValidationRule ]
    )
] .

:Cl_Invoice_Assignment_Restriction owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :hasDocument ;
    owl:allValuesFrom :Cl_Invoice
] ;
    rdfs:subClassOf :Cl_ProcessDocumentAssignment .

#################################################################
# End of FestS Ontology

# Naming convention correction (P22): Changed Cl_OrganizationIdentifier to ClOrganizationIdentifier and partOfSale to partOfSale (no delimiter)
:ClOrganizationIdentifier a owl:Class ;
    rdfs:subClassOf :Cl_InformationDetail ;
    rdfs:label "Organization Identifier" ;
    rdfs:comment "Identifiers such as registration numbers or codes for organizations." .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:domain :ClOrganizationIdentifier ;
    rdfs:range :Cl_Organization ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Inverse of hasIdentifier." .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :ClOrganizationIdentifier ;
    rdfs:label "has identifier" ;
    rdfs:comment "Identifier for the organization." ;
    owl:inverseOf :isIdentifierOf .

#################################################################
# Annotation correction (P20): Example fixes for annotation misuse

:isInvoiceIssuedByActor a owl:ObjectProperty ;
    rdfs:domain :Cl_Actor ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice issued by actor" ;
    rdfs:comment "Inverse of issuedBy." .

:isFileFormatOfValidationContext a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_ValidationContext ;
    rdfs:label "is file format of validation context" ;
    rdfs:comment "Inverse of wasValidatedAgainst." .

:isInvoiceOfCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "is invoice of customer" ;
    rdfs:comment "Inverse of issuedTo." .

:isProductReferredByInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range :Cl_InvoiceDetail ;
    rdfs:label "is product referred by invoice detail" ;
    rdfs:comment "Inverse of refersToProduct." .

:isConstraintOfFileFormatValidationRequirement a owl:ObjectProperty ;
    rdfs:domain :Cl_ElementConstraint ;
    rdfs:range :Cl_FileFormatValidationRequirement ;
    rdfs:label "is constraint of file format validation requirement" ;
    rdfs:comment "Inverse of requiresConstraint." .

#################################################################
# End of corrections
