@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/edifact-invoice-story>
    a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Story Ontology" ;
    rdfs:comment "Ontology for representing UN/EDIFACT invoice messages, organizational roles, and procurement scenarios in line with EN 16931-1 and P2P-O." .

#################################################################
#   Classes
#################################################################
:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "Top-level envelope containing one or more messages in an EDIFACT document." .

:Message a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "A business message within an Interchange Envelope, such as an invoice." .

:InvoiceMessage a owl:Class ;
    rdfs:subClassOf :Message ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "A message representing an invoice, composed of header, detail, and summary sections." .

:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "A segment within a message, such as BGM or NAD." .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite element within a segment, grouping multiple simple elements." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A single data value within a composite or segment." .

:HeaderSection a owl:Class ;
    rdfs:label "Header Section" ;
    rdfs:comment "Section of an invoice message containing document metadata and reference numbers." .

:DetailSection a owl:Class ;
    rdfs:label "Detail Section" ;
    rdfs:comment "Section listing individual line items of the invoice." .

:SummarySection a owl:Class ;
    rdfs:label "Summary Section" ;
    rdfs:comment "Section providing totals and summary values for the invoice." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Legal entity involved in a transaction, such as buyer or seller." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in the context of an invoice (e.g., Buyer, Seller, Delivery Party)." .

:OrganizationRoleAssignment a owl:Class ;
    rdfs:label "Organization Role Assignment" ;
    rdfs:comment "Reified relationship linking an organization, its role, and the invoice context." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "Physical or mailing address of an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Product or service listed in the invoice detail section." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "Price information for an item in the invoice." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process, such as Purchase-to-Pay, that an invoice may be aligned with." .

#################################################################
#   Object Properties (with Inverses)
#################################################################
:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contains message" ;
    rdfs:comment "Relates an InterchangeEnvelope to the contained Message(s)." ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :Message ;
    owl:inverseOf :isContainedInEnvelope .

:isContainedInEnvelope a owl:ObjectProperty ;
    rdfs:label "is contained in envelope" ;
    rdfs:comment "Relates a Message to its containing InterchangeEnvelope." ;
    rdfs:domain :Message ;
    rdfs:range :InterchangeEnvelope ;
    owl:inverseOf :containsMessage .

:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:comment "Relates a Message to its Segments." ;
    rdfs:domain :Message ;
    rdfs:range :Segment ;
    owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
    rdfs:label "is segment of" ;
    rdfs:comment "Relates a Segment to its Message." ;
    rdfs:domain :Segment ;
    rdfs:range :Message ;
    owl:inverseOf :hasSegment .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has section" ;
    rdfs:comment "Relates an InvoiceMessage to its header, detail, and summary sections." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ;
    owl:inverseOf :isSectionOfInvoice .

:isSectionOfInvoice a owl:ObjectProperty ;
    rdfs:label "is section of invoice" ;
    rdfs:comment "Relates a Section to its InvoiceMessage." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasSection .

:hasCompositeElement a owl:ObjectProperty ;
    rdfs:label "has composite element" ;
    rdfs:comment "Relates a Segment to its CompositeDataElements." ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :isCompositeElementOf .

:isCompositeElementOf a owl:ObjectProperty ;
    rdfs:label "is composite element of" ;
    rdfs:comment "Relates a CompositeDataElement to its Segment." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment ;
    owl:inverseOf :hasCompositeElement .

:hasSimpleElement a owl:ObjectProperty ;
    rdfs:label "has simple element" ;
    rdfs:comment "Relates a CompositeDataElement to its SimpleDataElements." ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    owl:inverseOf :isSimpleElementOf .

:isSimpleElementOf a owl:ObjectProperty ;
    rdfs:label "is simple element of" ;
    rdfs:comment "Relates a SimpleDataElement to its CompositeDataElement." ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement ;
    owl:inverseOf :hasSimpleElement .

:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role" ;
    rdfs:comment "Relates an Organization to a reified OrganizationRoleAssignment." ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :isRolePlayedBy .

:isRolePlayedBy a owl:ObjectProperty ;
    rdfs:label "is role played by" ;
    rdfs:comment "Relates an OrganizationRoleAssignment to its Organization." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :Organization ;
    owl:inverseOf :playsRole .

:hasAgentRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has agent role" ;
    rdfs:comment "Links an OrganizationRoleAssignment to the AgentRole played." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :AgentRole ;
    owl:inverseOf :isAgentRoleOf .

:isAgentRoleOf a owl:ObjectProperty ;
    rdfs:label "is agent role of" ;
    rdfs:comment "Relates an AgentRole to its OrganizationRoleAssignment." ;
    rdfs:domain :AgentRole ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :hasAgentRole .

:inInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in invoice" ;
    rdfs:comment "Links an OrganizationRoleAssignment to the InvoiceMessage context." ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :hasRoleAssignment .

:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:label "has role assignment" ;
    rdfs:comment "Relates an InvoiceMessage to its OrganizationRoleAssignments." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    owl:inverseOf :inInvoice .

:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Relates an Organization to its Address." ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:label "is address of" ;
    rdfs:comment "Relates an Address to its Organization." ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    owl:inverseOf :hasAddress .

:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:comment "Relates a DetailSection to its listed Items." ;
    rdfs:domain :DetailSection ;
    rdfs:range :Item ;
    owl:inverseOf :isItemOfDetailSection .

:isItemOfDetailSection a owl:ObjectProperty ;
    rdfs:label "is item of detail section" ;
    rdfs:comment "Relates an Item to its DetailSection." ;
    rdfs:domain :Item ;
    rdfs:range :DetailSection ;
    owl:inverseOf :hasItem .

:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has price" ;
    rdfs:comment "Relates an Item to its Price." ;
    rdfs:domain :Item ;
    rdfs:range :Price ;
    owl:inverseOf :isPriceOfItem .

:isPriceOfItem a owl:ObjectProperty ;
    rdfs:label "is price of item" ;
    rdfs:comment "Relates a Price to its Item." ;
    rdfs:domain :Price ;
    rdfs:range :Item ;
    owl:inverseOf :hasPrice .

:isAlignedWithStandard a owl:ObjectProperty ;
    rdfs:label "is aligned with standard" ;
    rdfs:comment "Indicates alignment of the invoice message with a business process or standard." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    owl:inverseOf :hasAlignedInvoice .

:hasAlignedInvoice a owl:ObjectProperty ;
    rdfs:label "has aligned invoice" ;
    rdfs:comment "Relates a BusinessProcess to its aligned InvoiceMessage." ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    owl:inverseOf :isAlignedWithStandard .

#################################################################
#   Data Properties
#################################################################
:hasNetPrice a owl:DatatypeProperty ;
    rdfs:label "has net price" ;
    rdfs:comment "Net price of an item." ;
    rdfs:domain :Item ;
    rdfs:range xsd:decimal .

:hasQuantity a owl:DatatypeProperty ;
    rdfs:label "has quantity" ;
    rdfs:comment "Quantity of the item listed in the invoice." ;
    rdfs:domain :Item ;
    rdfs:range xsd:decimal .

:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "Total amount of the invoice." ;
    rdfs:domain :SummarySection ;
    rdfs:range xsd:decimal .

:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has invoice number" ;
    rdfs:comment "Unique number identifying the invoice." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:string .

:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has document date" ;
    rdfs:comment "Date the invoice document was issued." ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:dateTime .

:hasGLN a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has GLN" ;
    rdfs:comment "Global Location Number identifying the organization." ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .

:hasMandatoryIdentifier a owl:DatatypeProperty ;
    rdfs:label "has mandatory identifier" ;
    rdfs:comment "A mandatory identifier required by the D96A directory for file validity." ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string .

:hasRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has role" ;
    rdfs:comment "The role name (e.g., Buyer, Seller) of an agent role." ;
    rdfs:domain :AgentRole ;
    rdfs:range xsd:string .

#################################################################
#   Disjoint Classes
#################################################################
:InvoiceMessage owl:disjointWith :Segment, :Organization, :AgentRole, :Address, :Item, :Price, :BusinessProcess .

#################################################################
#   Complex Axioms & Restrictions
#################################################################
:OrganizationRoleAssignment owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:someValuesFrom :AgentRole ]
        [ a owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :InvoiceMessage ]
    )
] .

:InvoiceMessage owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom [ a owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ]
        [ a owl:Restriction ; owl:onProperty :hasMandatoryIdentifier ; owl:someValuesFrom xsd:string ]
    )
] .
