@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://www.example.org/ontology#> .

<http://www.example.org/ontology/edifact-invoice-ontology>
    a owl:Ontology ;
    rdfs:label "EDIFACT Invoice Ontology" ;
    rdfs:comment "Ontology for representing UN/EDIFACT invoice messages, organizations, roles, line items, and business process context in industrial procurement scenarios, aligned with EN 16931-1 and P2P-O." .

#################################################################
# Classes
#################################################################

:InterchangeEnvelope a owl:Class ;
    rdfs:label "Interchange Envelope" ;
    rdfs:comment "The envelope at the top of the EDIFACT hierarchy, containing messages." .

:Message a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "A digital business document contained in an Interchange Envelope." .

:InvoiceMessage a owl:Class ;
    rdfs:subClassOf :Message ;
    rdfs:label "Invoice Message" ;
    rdfs:comment "An EDIFACT INVOIC message representing an invoice transaction." .

:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "A structural component of an EDIFACT message, such as BGM or NAD." .

:CompositeDataElement a owl:Class ;
    rdfs:label "Composite Data Element" ;
    rdfs:comment "A composite element within a segment, grouping simple data elements." .

:SimpleDataElement a owl:Class ;
    rdfs:label "Simple Data Element" ;
    rdfs:comment "A basic data value within a composite data element." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A party involved in the invoice, e.g., buyer, seller, delivery party." .

:AgentRole a owl:Class ;
    rdfs:label "Agent Role" ;
    rdfs:comment "A role played by an organization in the context of an invoice, such as Buyer or DeliveryParty." .

:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal or physical address associated with an organization." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A good or service described in the invoice." .

:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:comment "A price value associated with an item or invoice." .

:LineItem a owl:Class ;
    rdfs:label "Line Item" ;
    rdfs:comment "A line in the invoice detail section, describing an item, its quantity, and price." .

:HeaderSection a owl:Class ;
    rdfs:label "Header Section" ;
    rdfs:comment "The header section of an invoice, containing meta-information like dates and reference numbers." .

:DetailSection a owl:Class ;
    rdfs:label "Detail Section" ;
    rdfs:comment "The section of the invoice listing all line items." .

:SummarySection a owl:Class ;
    rdfs:label "Summary Section" ;
    rdfs:comment "The section of the invoice summarizing totals such as tax and invoice amount." .

:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A business process to which an invoice can be assigned." .

:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "A unique identifier for organizations, such as a Global Location Number." .

:OrganizationRoleAssignment a owl:Class ;
    rdfs:label "Organization Role Assignment" ;
    rdfs:comment "A reification class linking an organization, its role, and the invoice context." .

#################################################################
# Object Properties
#################################################################

:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :InterchangeEnvelope ;
    rdfs:range :Message ;
    rdfs:label "contains message" ;
    rdfs:comment "Links an interchange envelope to the messages it contains." ;
    owl:inverseOf :isContainedInEnvelope .

:isContainedInEnvelope a owl:ObjectProperty ;
    rdfs:domain :Message ;
    rdfs:range :InterchangeEnvelope ;
    rdfs:label "is contained in envelope" ;
    rdfs:comment "Inverse of containsMessage: links a message to its containing envelope." ;
    owl:inverseOf :containsMessage .

:hasSegment a owl:ObjectProperty ;
    rdfs:domain :Message ;
    rdfs:range :Segment ;
    rdfs:label "has segment" ;
    rdfs:comment "Links a message to its segments." ;
    owl:inverseOf :isSegmentOf .

:isSegmentOf a owl:ObjectProperty ;
    rdfs:domain :Segment ;
    rdfs:range :Message ;
    rdfs:label "is segment of" ;
    rdfs:comment "Inverse of hasSegment: links a segment to its parent message." ;
    owl:inverseOf :hasSegment .

:hasCompositeDataElement a owl:ObjectProperty ;
    rdfs:domain :Segment ;
    rdfs:range :CompositeDataElement ;
    rdfs:label "has composite data element" ;
    rdfs:comment "Links a segment to its composite data elements." ;
    owl:inverseOf :isCompositeDataElementOf .

:isCompositeDataElementOf a owl:ObjectProperty ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :Segment ;
    rdfs:label "is composite data element of" ;
    rdfs:comment "Inverse of hasCompositeDataElement: links a composite data element to its parent segment." ;
    owl:inverseOf :hasCompositeDataElement .

:hasSimpleDataElement a owl:ObjectProperty ;
    rdfs:domain :CompositeDataElement ;
    rdfs:range :SimpleDataElement ;
    rdfs:label "has simple data element" ;
    rdfs:comment "Links a composite data element to its simple data elements." ;
    owl:inverseOf :isSimpleDataElementOf .

:isSimpleDataElementOf a owl:ObjectProperty ;
    rdfs:domain :SimpleDataElement ;
    rdfs:range :CompositeDataElement ;
    rdfs:label "is simple data element of" ;
    rdfs:comment "Inverse of hasSimpleDataElement: links a simple data element to its parent composite." ;
    owl:inverseOf :hasSimpleDataElement .

:hasHeaderSection a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :HeaderSection ;
    rdfs:label "has header section" ;
    rdfs:comment "Links an invoice message to its header section." ;
    owl:inverseOf :isHeaderSectionOf .

:isHeaderSectionOf a owl:ObjectProperty ;
    rdfs:domain :HeaderSection ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is header section of" ;
    rdfs:comment "Inverse of hasHeaderSection: links a header section to its parent invoice message." ;
    owl:inverseOf :hasHeaderSection .

:hasDetailSection a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :DetailSection ;
    rdfs:label "has detail section" ;
    rdfs:comment "Links an invoice message to its detail section." ;
    owl:inverseOf :isDetailSectionOf .

:isDetailSectionOf a owl:ObjectProperty ;
    rdfs:domain :DetailSection ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is detail section of" ;
    rdfs:comment "Inverse of hasDetailSection: links a detail section to its parent invoice message." ;
    owl:inverseOf :hasDetailSection .

:hasSummarySection a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :SummarySection ;
    rdfs:label "has summary section" ;
    rdfs:comment "Links an invoice message to its summary section." ;
    owl:inverseOf :isSummarySectionOf .

:isSummarySectionOf a owl:ObjectProperty ;
    rdfs:domain :SummarySection ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is summary section of" ;
    rdfs:comment "Inverse of hasSummarySection: links a summary section to its parent invoice message." ;
    owl:inverseOf :hasSummarySection .

:listsLineItem a owl:ObjectProperty ;
    rdfs:domain :DetailSection ;
    rdfs:range :LineItem ;
    rdfs:label "lists line item" ;
    rdfs:comment "Links a detail section to its line items." ;
    owl:inverseOf :isLineItemOf .

:isLineItemOf a owl:ObjectProperty ;
    rdfs:domain :LineItem ;
    rdfs:range :DetailSection ;
    rdfs:label "is line item of" ;
    rdfs:comment "Inverse of listsLineItem: links a line item to its parent detail section." ;
    owl:inverseOf :listsLineItem .

:describesItem a owl:ObjectProperty ;
    rdfs:domain :LineItem ;
    rdfs:range :Item ;
    rdfs:label "describes item" ;
    rdfs:comment "Links a line item to the item it describes." ;
    owl:inverseOf :isDescribedByLineItem .

:isDescribedByLineItem a owl:ObjectProperty ;
    rdfs:domain :Item ;
    rdfs:range :LineItem ;
    rdfs:label "is described by line item" ;
    rdfs:comment "Inverse of describesItem: links an item to the line item that describes it." ;
    owl:inverseOf :describesItem .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Identifier ;
    rdfs:label "has identifier" ;
    rdfs:comment "Links an organization to its identifier." ;
    owl:inverseOf :isIdentifierOf .

:isIdentifierOf a owl:ObjectProperty ;
    rdfs:domain :Identifier ;
    rdfs:range :Organization ;
    rdfs:label "is identifier of" ;
    rdfs:comment "Inverse of hasIdentifier: links an identifier to its organization." ;
    owl:inverseOf :hasIdentifier .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Address ;
    rdfs:label "has address" ;
    rdfs:comment "Links an organization to its address." ;
    owl:inverseOf :isAddressOf .

:isAddressOf a owl:ObjectProperty ;
    rdfs:domain :Address ;
    rdfs:range :Organization ;
    rdfs:label "is address of" ;
    rdfs:comment "Inverse of hasAddress: links an address to its organization." ;
    owl:inverseOf :hasAddress .

:organizationRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    rdfs:label "organization role assignment" ;
    rdfs:comment "Links an invoice message to an organization-role assignment." ;
    owl:inverseOf :isOrganizationRoleAssignmentOf .

:isOrganizationRoleAssignmentOf a owl:ObjectProperty ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is organization role assignment of" ;
    rdfs:comment "Inverse of organizationRoleAssignment: links an organization role assignment to its invoice message." ;
    owl:inverseOf :organizationRoleAssignment .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :Organization ;
    rdfs:label "involves organization" ;
    rdfs:comment "Links an organization role assignment to the involved organization." ;
    owl:inverseOf :isOrganizationInvolvedIn .

:isOrganizationInvolvedIn a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationRoleAssignment ;
    rdfs:label "is organization involved in" ;
    rdfs:comment "Inverse of involvesOrganization: links an organization to its organization role assignments." ;
    owl:inverseOf :involvesOrganization .

:organizationRole a owl:ObjectProperty ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :AgentRole ;
    rdfs:label "organization role" ;
    rdfs:comment "Links an organization role assignment to the agent role." ;
    owl:inverseOf :isRoleOfOrganizationAssignment .

:isRoleOfOrganizationAssignment a owl:ObjectProperty ;
    rdfs:domain :AgentRole ;
    rdfs:range :OrganizationRoleAssignment ;
    rdfs:label "is role of organization assignment" ;
    rdfs:comment "Inverse of organizationRole: links an agent role to its organization role assignments." ;
    owl:inverseOf :organizationRole .

:appliesToInvoice a owl:ObjectProperty ;
    rdfs:domain :OrganizationRoleAssignment ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "applies to invoice" ;
    rdfs:comment "Links an organization role assignment to the invoice it applies to." ;
    owl:inverseOf :hasOrganizationRoleAssignment .

:hasOrganizationRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :OrganizationRoleAssignment ;
    rdfs:label "has organization role assignment" ;
    rdfs:comment "Inverse of appliesToInvoice: links an invoice message to its organization role assignments." ;
    owl:inverseOf :appliesToInvoice .

:hasBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range :BusinessProcess ;
    rdfs:label "has business process" ;
    rdfs:comment "Links an invoice message to a business process." ;
    owl:inverseOf :isBusinessProcessOf .

:isBusinessProcessOf a owl:ObjectProperty ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :InvoiceMessage ;
    rdfs:label "is business process of" ;
    rdfs:comment "Inverse of hasBusinessProcess: links a business process to its invoice message." ;
    owl:inverseOf :hasBusinessProcess .

# Link Price to LineItem (to fix P04)
:hasPrice a owl:ObjectProperty ;
    rdfs:domain :LineItem ;
    rdfs:range :Price ;
    rdfs:label "has price" ;
    rdfs:comment "Links a line item to its price (fixes unconnected Price class)." ;
    owl:inverseOf :isPriceOf .

:isPriceOf a owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:range :LineItem ;
    rdfs:label "is price of" ;
    rdfs:comment "Inverse of hasPrice: links a price to its line item." ;
    owl:inverseOf :hasPrice .

#################################################################
# Data Properties
#################################################################

:hasNetPrice a owl:DatatypeProperty ;
    rdfs:domain :LineItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "has net price" ;
    rdfs:comment "The net price of an item in a line item." .

:hasQuantity a owl:DatatypeProperty ;
    rdfs:domain :LineItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "has quantity" ;
    rdfs:comment "The quantity of an item in a line item." .

:hasInvoiceAmount a owl:DatatypeProperty ;
    rdfs:domain :SummarySection ;
    rdfs:range xsd:decimal ;
    rdfs:label "has invoice amount" ;
    rdfs:comment "The total invoice amount in the summary section." .

:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :InvoiceMessage ;
    rdfs:range xsd:string ;
    rdfs:label "has invoice number" ;
    rdfs:comment "The unique number of an invoice message." .

:hasDate a owl:DatatypeProperty ;
    rdfs:domain :HeaderSection ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has date" ;
    rdfs:comment "A date value in the header section, such as document date." .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" ;
    rdfs:comment "The actual identifier string, e.g., GLN." .

#################################################################
# Restrictions & GCAs
#################################################################

:Buyer a :AgentRole ;
    rdfs:label "Buyer" ;
    rdfs:comment "The agent role representing the buyer in an invoice." .

:DeliveryParty a :AgentRole ;
    rdfs:label "Delivery Party" ;
    rdfs:comment "The agent role representing the delivery party in an invoice." .

[ a owl:Restriction ;
  owl:onProperty :organizationRole ;
  owl:someValuesFrom :Buyer ;
  rdfs:subClassOf :OrganizationRoleAssignment
] .

#################################################################
# Disjointness
#################################################################

:Organization owl:disjointWith :Address, :Item .
:InvoiceMessage owl:disjointWith :Organization .

#################################################################
# DisjointUnion
#################################################################

:Message owl:disjointUnionOf ( :InvoiceMessage ) .

#################################################################
# End of Ontology
#################################################################
