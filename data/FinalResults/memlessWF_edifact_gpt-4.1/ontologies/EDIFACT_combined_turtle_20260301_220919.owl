@prefix : <http://example.org/fests#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fests>
    rdf:type owl:Ontology ;
    owl:versionIRI <http://example.org/fests/1.0> ;
    rdfs:label "FestS" .

#################################################################
# Classes
#################################################################

:Cl_Document a owl:Class .
:Cl_BusinessDocument a owl:Class .
:Cl_BusinessProcess a owl:Class ; rdfs:label "Business Process" .
:Cl_ProcessAssignment a owl:Class ; rdfs:label "Process Assignment" ; rdfs:subClassOf :Cl_Assignment .
:Cl_Assignment a owl:Class ; rdfs:label "Assignment" .
:Cl_EDIFACTMessage a owl:Class ; rdfs:subClassOf :Cl_Message ; rdfs:label "EDIFACT Message" .
:Cl_Message a owl:Class ; rdfs:label "Message" .
:Cl_Invoice a owl:Class ; rdfs:subClassOf :Cl_Document, :Cl_BusinessDocument ; rdfs:label "Invoice" .
:Cl_InvoiceListing a owl:Class ; rdfs:label "Invoice Listing" .
:Cl_InvoiceParticipation a owl:Class .
:Cl_InvoiceRole a owl:Class .
:Cl_InvoicePartyRole a owl:Class ; rdfs:subClassOf :Cl_InvoiceRole .
:Cl_InvoiceTransaction a owl:Class .
:Cl_InvoiceLine a owl:Class .
:Cl_InvoiceDetail a owl:Class ; rdfs:subClassOf :Cl_Entity ; rdfs:label "Invoice Detail" .
:Cl_InvoiceAmountStatement a owl:Class ; rdfs:subClassOf :Cl_Document .
:Cl_InvoiceIdentifier a owl:Class ; rdfs:label "Invoice Identifier" .
:Cl_Entity a owl:Class .
:Cl_Actor a owl:Class .
:Cl_Organization a owl:Class ; rdfs:subClassOf :Cl_Actor .
:Cl_Company a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Supplier a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_Customer a owl:Class ; rdfs:subClassOf :Cl_Organization, :Cl_Entity .
:Cl_NonProfit a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_GovernmentAgency a owl:Class ; rdfs:subClassOf :Cl_Organization .
:Cl_OrganizationInvolvement a owl:Class .
:Cl_OrganizationInformation a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_OrganizationDetails a owl:Class .
:Cl_ContactInformation a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_Location a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_Logo a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_Website a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_Description a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_Role a owl:Class ; rdfs:subClassOf :Cl_OrganizationDetails .
:Cl_Buyer a owl:Class ; rdfs:subClassOf :Cl_Person ; rdfs:label "Buyer" .
:Cl_Person a owl:Class ; rdfs:subClassOf :Cl_Agent ; rdfs:label "Person" .
:Cl_Agent a owl:Class ; rdfs:label "Agent" .
:Cl_Address a owl:Class ; rdfs:label "Address" .
:Cl_BuyerAddressAssociation a owl:Class ; rdfs:label "Buyer-Address Association" .
:Cl_Item a owl:Class ; rdfs:label "Item" ; rdfs:comment "Represents an item that is sold." .
:Cl_Product a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_Service a owl:Class ; rdfs:subClassOf :Cl_Item .
:Cl_InvoiceItem a owl:Class ; rdfs:subClassOf :Cl_InvoiceDetail .
:Cl_SaleDisplayInfo a owl:Class ; rdfs:label "Sale Display Information" .
:Cl_ItemName a owl:Class ; rdfs:subClassOf :Cl_DisplayAttribute ; rdfs:label "Item Name" .
:Cl_ItemPrice a owl:Class ; rdfs:subClassOf :Cl_DisplayAttribute ; rdfs:label "Item Price" .
:Cl_ItemDescription a owl:Class ; rdfs:subClassOf :Cl_DisplayAttribute ; rdfs:label "Item Description" .
:Cl_ItemCategory a owl:Class ; rdfs:subClassOf :Cl_DisplayAttribute ; rdfs:label "Item Category" .
:Cl_ItemImage a owl:Class ; rdfs:subClassOf :Cl_DisplayAttribute ; rdfs:label "Item Image" .
:Cl_ItemIdentifier a owl:Class ; rdfs:subClassOf :Cl_DisplayAttribute ; rdfs:label "Item Identifier" .
:Cl_DisplayAttribute a owl:Class ; rdfs:label "Display Attribute" .
:Cl_MonetaryAmount a owl:Class .
:Cl_NetPriceCalculation a owl:Class .
:Cl_FileFormat a owl:Class .
:Cl_FileFormatSpecification a owl:Class ; rdfs:subClassOf :Cl_FileFormat .
:Cl_FileFormatComponent a owl:Class ; rdfs:subClassOf :Cl_FileFormatSpecification .
:Cl_RequiredInformation a owl:Class ; rdfs:subClassOf :Cl_FileFormatComponent .
:Cl_ValidationRule a owl:Class ; rdfs:subClassOf :Cl_FileFormatComponent .
:Cl_InformationProvision a owl:Class .

#################################################################
# Hierarchies and Disjointness
#################################################################

:Cl_Invoice owl:disjointWith :Cl_InvoiceDetail, :Cl_Customer, :Cl_Item, :Cl_InvoiceAmountStatement, :Cl_InvoiceIdentifier, :Cl_BusinessProcess, :Cl_ProcessAssignment .
:Cl_InvoiceItem owl:disjointWith :Cl_Invoice, :Cl_Customer, :Cl_Product, :Cl_Service .
:Cl_Product owl:disjointWith :Cl_Service .
:Cl_Supplier owl:disjointWith :Cl_Customer .
:Cl_Invoice owl:disjointWith :Cl_Organization .
:Cl_InvoiceParticipation owl:disjointWith :Cl_Invoice, :Cl_Organization .
:Cl_InvoiceRole owl:disjointWith :Cl_Invoice, :Cl_Organization .
:Cl_EDIFACTMessage owl:disjointWith :Cl_Invoice .
:Cl_InvoiceListing owl:disjointWith :Cl_EDIFACTMessage, :Cl_Invoice .
:Cl_Company owl:disjointWith :Cl_NonProfit, :Cl_GovernmentAgency .
:Cl_NonProfit owl:disjointWith :Cl_GovernmentAgency .
:Cl_ContactInformation owl:disjointWith :Cl_Location, :Cl_Logo, :Cl_Website, :Cl_Description, :Cl_Role .
:Cl_Location owl:disjointWith :Cl_Logo, :Cl_Website, :Cl_Description, :Cl_Role .
:Cl_Logo owl:disjointWith :Cl_Website, :Cl_Description, :Cl_Role .
:Cl_Website owl:disjointWith :Cl_Description, :Cl_Role .
:Cl_Description owl:disjointWith :Cl_Role .
:Cl_Buyer owl:disjointWith :Cl_Address .
:Cl_Address owl:disjointWith :Cl_Person .
:Cl_InvoiceLine owl:disjointWith :Cl_Item, :Cl_NetPriceCalculation .
:Cl_MonetaryAmount owl:disjointWith :Cl_Item, :Cl_InvoiceLine, :Cl_Invoice .
:Cl_ItemName owl:disjointWith :Cl_ItemPrice, :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage, :Cl_ItemIdentifier .
:Cl_ItemPrice owl:disjointWith :Cl_ItemDescription, :Cl_ItemCategory, :Cl_ItemImage, :Cl_ItemIdentifier .
:Cl_ItemDescription owl:disjointWith :Cl_ItemCategory, :Cl_ItemImage, :Cl_ItemIdentifier .
:Cl_ItemCategory owl:disjointWith :Cl_ItemImage, :Cl_ItemIdentifier .
:Cl_ItemImage owl:disjointWith :Cl_ItemIdentifier .
:Cl_RequiredInformation owl:disjointWith :Cl_ValidationRule .
:Cl_FileFormat owl:disjointWith :Cl_RequiredInformation .
:Cl_InvoiceAmountStatement owl:disjointWith :Cl_Invoice .
:Cl_BusinessProcess owl:disjointWith :Cl_ProcessAssignment .
:Cl_BusinessDocument owl:disjointWith :Cl_BusinessProcess .

#################################################################
# Object Properties
#################################################################

:hasInvoiceListing a owl:ObjectProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range :Cl_InvoiceListing ;
    rdfs:label "has invoice listing" .

:listsInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_Invoice ;
    rdfs:label "lists invoice" .

:isListedInMessage a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceListing ;
    rdfs:range :Cl_EDIFACTMessage ;
    rdfs:label "is listed in message" ;
    owl:inverseOf :hasInvoiceListing .

:organizationInvolved a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Organization .

:involvedInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Invoice .

:hasInvoiceParticipation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :involvedInInvoice .

:participatesInInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceParticipation ;
    owl:inverseOf :organizationInvolved .

:asSupplier a owl:ObjectProperty ;
    rdfs:subPropertyOf :organizationInvolved ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Supplier .

:asCustomer a owl:ObjectProperty ;
    rdfs:subPropertyOf :organizationInvolved ;
    rdfs:domain :Cl_InvoiceParticipation ;
    rdfs:range :Cl_Customer .

:hasInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Invoice .

:involvesOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_Organization .

:hasPartyRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range :Cl_InvoicePartyRole .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceTransaction ;
    rdfs:range :Cl_Entity .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceTransaction ;
    rdfs:range :Cl_Role .

:relatesToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceTransaction, :Cl_InvoiceAmountStatement ;
    rdfs:range :Cl_Invoice .

:buyerOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceTransaction ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :isBuyerInTransaction .

:isBuyerInTransaction a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceTransaction .

:sellerOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceTransaction ;
    rdfs:range :Cl_Organization ;
    owl:inverseOf :isSellerInTransaction .

:isSellerInTransaction a owl:ObjectProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range :Cl_InvoiceTransaction .

:hasInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceItem ;
    owl:inverseOf :isInvoiceItemOf .

:isInvoiceItemOf a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Invoice .

:refersToItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range :Cl_Item ;
    owl:inverseOf :isItemOfInvoiceItem .

:isItemOfInvoiceItem a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_InvoiceItem .

:displayedInfo a owl:ObjectProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range :Cl_SaleDisplayInfo ;
    rdfs:label "displayed info" ;
    owl:inverseOf :aboutItem .

:aboutItem a owl:ObjectProperty ;
    rdfs:domain :Cl_SaleDisplayInfo ;
    rdfs:range :Cl_Item ;
    rdfs:label "about item" ;
    owl:inverseOf :displayedInfo .

:hasDisplayAttribute a owl:ObjectProperty ;
    rdfs:domain :Cl_SaleDisplayInfo ;
    rdfs:range :Cl_DisplayAttribute ;
    rdfs:label "has display attribute" .

:hasInvoiceLine a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceLine .

:hasItem a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_Item .

:hasNetPriceCalculation a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_NetPriceCalculation .

:calculatesNetPriceFor a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_Invoice .

:hasNetPriceAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_NetPriceCalculation ;
    rdfs:range :Cl_MonetaryAmount .

:hasLineAmount a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceLine ;
    rdfs:range :Cl_MonetaryAmount .

:hasInvoiceDetail a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceDetail ;
    rdfs:label "has invoice detail" .

:belongsToInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasInvoiceDetail ;
    rdfs:label "belongs to invoice" .

:involvesProduct a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Product ;
    rdfs:label "involves product" .

:involvesService a owl:ObjectProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range :Cl_Service ;
    rdfs:label "involves service" .

:hasCustomer a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_Customer ;
    rdfs:label "has customer" .

:hasInvoiceIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_InvoiceIdentifier ;
    rdfs:label "has invoice identifier" .

:hasOrganization a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range :Cl_Organization .

:hasContactInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range :Cl_ContactInformation .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range :Cl_Location .

:hasLogo a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range :Cl_Logo .

:hasWebsite a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range :Cl_Website .

:hasDescription a owl:ObjectProperty ;
    rdfs:domain :Cl_OrganizationInformation ;
    rdfs:range :Cl_Description .

:hasBuyer a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssociation ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "has buyer" .

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Cl_BuyerAddressAssociation ;
    rdfs:range :Cl_Address ;
    rdfs:label "has address" .

:buyerHasAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_Address ;
    rdfs:label "buyer has address" .

:addressOfBuyer a owl:ObjectProperty ;
    owl:inverseOf :buyerHasAddress ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_Buyer ;
    rdfs:label "address of buyer" .

:buyerInAssociation a owl:ObjectProperty ;
    owl:inverseOf :hasBuyer ;
    rdfs:domain :Cl_Buyer ;
    rdfs:range :Cl_BuyerAddressAssociation ;
    rdfs:label "buyer in association" .

:addressInAssociation a owl:ObjectProperty ;
    owl:inverseOf :hasAddress ;
    rdfs:domain :Cl_Address ;
    rdfs:range :Cl_BuyerAddressAssociation ;
    rdfs:label "address in association" .

:hasSpecification a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range :Cl_FileFormatSpecification .

:hasComponent a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatSpecification ;
    rdfs:range :Cl_FileFormatComponent ;
    rdfs:subPropertyOf :hasSpecification .

:requiresInformation a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponent ;
    rdfs:range :Cl_RequiredInformation ;
    rdfs:subPropertyOf :hasComponent .

:hasValidationRule a owl:ObjectProperty ;
    rdfs:domain :Cl_FileFormatComponent ;
    rdfs:range :Cl_ValidationRule ;
    rdfs:subPropertyOf :hasComponent .

:informationProvision a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationProvision ;
    rdfs:range :Cl_RequiredInformation .

:forFileFormat a owl:ObjectProperty ;
    rdfs:domain :Cl_InformationProvision ;
    rdfs:range :Cl_FileFormat .

:validatesWith a owl:ObjectProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range :Cl_RequiredInformation .

:hasProcessAssignment a owl:ObjectProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range :Cl_ProcessAssignment ;
    rdfs:label "links an invoice to its assignment to a business process" .

:assignedInvoice a owl:ObjectProperty ;
    rdfs:domain :Cl_ProcessAssignment ;
    rdfs:range :Cl_Invoice ;
    owl:inverseOf :hasProcessAssignment ;
    rdfs:label "the invoice that is assigned in the process assignment" .

:assignedBusinessProcess a owl:ObjectProperty ;
    rdfs:domain :Cl_ProcessAssignment ;
    rdfs:range :Cl_BusinessProcess ;
    rdfs:label "the business process to which the invoice is assigned" .

#################################################################
# Data Properties
#################################################################

:invoiceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number" .

:invoiceDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:date ;
    rdfs:label "invoice date" .

:messageReferenceNumber a owl:DatatypeProperty ;
    rdfs:domain :Cl_EDIFACTMessage ;
    rdfs:range xsd:string ;
    rdfs:label "message reference number" .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem, :Cl_InvoiceLine ;
    rdfs:range xsd:decimal .

:unitPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem, :Cl_InvoiceLine, :Cl_InvoiceDetail ;
    rdfs:range xsd:decimal .

:totalPrice a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceItem ;
    rdfs:range xsd:decimal .

:itemDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:itemCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Item ;
    rdfs:range xsd:string .

:amountValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:decimal .

:currency a owl:DatatypeProperty ;
    rdfs:domain :Cl_MonetaryAmount ;
    rdfs:range xsd:string .

:totalAmount a owl:DatatypeProperty ;
    rdfs:domain :Cl_Invoice ;
    rdfs:range xsd:decimal ;
    rdfs:label "total amount" .

:itemQuantity a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range xsd:integer ;
    rdfs:label "item quantity" .

:lineTotal a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceDetail ;
    rdfs:range xsd:decimal ;
    rdfs:label "line total" .

:customerName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer name" .

:customerID a owl:DatatypeProperty ;
    rdfs:domain :Cl_Customer ;
    rdfs:range xsd:string ;
    rdfs:label "customer ID" .

:productName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Product ;
    rdfs:range xsd:string ;
    rdfs:label "product name" .

:serviceName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Service ;
    rdfs:range xsd:string ;
    rdfs:label "service name" .

:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceAmountStatement ;
    rdfs:range xsd:decimal .

:invoiceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Cl_InvoiceIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "invoice number value" .

:organizationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Organization ;
    rdfs:range xsd:string .

:contactEmail a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:domain :Cl_ContactInformation ;
    rdfs:range xsd:string .

:locationAddress a owl:DatatypeProperty ;
    rdfs:domain :Cl_Location ;
    rdfs:range xsd:string .

:logoURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Logo ;
    rdfs:range xsd:string .

:websiteURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_Website ;
    rdfs:range xsd:string .

:descriptionText a owl:DatatypeProperty ;
    rdfs:domain :Cl_Description ;
    rdfs:range xsd:string .

:roleName a owl:DatatypeProperty ;
    rdfs:domain :Cl_Role ;
    rdfs:range xsd:string .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "address line" .

:city a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "city" .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "postal code" .

:country a owl:DatatypeProperty ;
    rdfs:domain :Cl_Address ;
    rdfs:range xsd:string ;
    rdfs:label "country" .

:hasRoleType a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceRole ;
    rdfs:range xsd:string .

:attributeValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_DisplayAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "attribute value" .

:priceValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemPrice ;
    rdfs:range xsd:decimal ;
    rdfs:label "price value" .

:imageURL a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemImage ;
    rdfs:range xsd:anyURI ;
    rdfs:label "image URL" .

:identifierValue a owl:DatatypeProperty ;
    rdfs:domain :Cl_ItemIdentifier ;
    rdfs:range xsd:string ;
    rdfs:label "identifier value" .

:assignmentDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_ProcessAssignment ;
    rdfs:range xsd:date ;
    rdfs:label "date when the invoice was assigned to the business process" .

:businessProcessName a owl:DatatypeProperty ;
    rdfs:domain :Cl_BusinessProcess ;
    rdfs:range xsd:string ;
    rdfs:label "name of the business process" .

:informationName a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string .

:informationType a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:string .

:isMandatory a owl:DatatypeProperty ;
    rdfs:domain :Cl_RequiredInformation ;
    rdfs:range xsd:boolean .

:ruleDescription a owl:DatatypeProperty ;
    rdfs:domain :Cl_ValidationRule ;
    rdfs:range xsd:string .

:componentOrder a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormatComponent ;
    rdfs:range xsd:integer .

:fileFormatName a owl:DatatypeProperty ;
    rdfs:domain :Cl_FileFormat ;
    rdfs:range xsd:string .

:transactionDate a owl:DatatypeProperty ;
    rdfs:domain :Cl_InvoiceTransaction ;
    rdfs:range xsd:dateTime .

#################################################################
# Restrictions and Equivalent Classes
#################################################################

:Cl_InvoiceListing owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :listsInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :isListedInMessage ; owl:someValuesFrom :Cl_EDIFACTMessage ]
    )
] .

:Cl_InvoiceParticipation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :organizationInvolved ;
          owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvedInInvoice ;
          owl:allValuesFrom :Cl_Invoice ]
    )
] .

:Cl_InvoiceRole owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesOrganization ;
          owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasRoleType ;
          owl:someValuesFrom xsd:string ]
    )
] .

:Cl_InvoiceTransaction owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :relatesToInvoice ; owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ; owl:onProperty :buyerOrganization ; owl:someValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ; owl:onProperty :sellerOrganization ; owl:someValuesFrom :Cl_Organization ]
    )
] .

:Cl_InvoiceItem owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Cl_Item ]
        [ rdf:type owl:Restriction ; owl:onProperty :quantity ; owl:someValuesFrom xsd:decimal ]
        [ rdf:type owl:Restriction ; owl:onProperty :unitPrice ; owl:someValuesFrom xsd:decimal ]
    )
] .

:Cl_SaleDisplayInfo owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :aboutItem ;
          owl:someValuesFrom :Cl_Item
        ]
        [ a owl:Restriction ;
          owl:onProperty :hasDisplayAttribute ;
          owl:someValuesFrom :Cl_DisplayAttribute
        ]
    )
] .

:Cl_NetPriceCalculation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :calculatesNetPriceFor ;
          owl:someValuesFrom :Cl_Invoice ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasNetPriceAmount ;
          owl:someValuesFrom :Cl_MonetaryAmount ]
    )
] .

:Cl_Invoice owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :hasNetPriceCalculation ;
          owl:someValuesFrom :Cl_NetPriceCalculation ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceDetail ;
          owl:someValuesFrom :Cl_InvoiceDetail ]
        [ a owl:Restriction ;
          owl:onProperty :hasInvoiceIdentifier ;
          owl:allValuesFrom :Cl_InvoiceIdentifier ]
        [ a owl:Restriction ;
          owl:onProperty :hasProcessAssignment ;
          owl:allValuesFrom :Cl_ProcessAssignment ]
    )
] .

:Cl_InvoiceDetail owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesProduct ;
          owl:someValuesFrom :Cl_Product ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :involvesService ;
          owl:someValuesFrom :Cl_Service ]
    )
] .

:Cl_InvoiceDetail rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :belongsToInvoice ;
    owl:someValuesFrom :Cl_Invoice
] .

:Cl_InvoiceAmountStatement owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Cl_Document
        [ rdf:type owl:Restriction ;
          owl:onProperty :relatesToInvoice ;
          owl:someValuesFrom :Cl_Invoice
        ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasInvoiceAmount ;
          owl:someValuesFrom xsd:decimal
        ]
    )
] .

:Cl_InvoiceIdentifier owl:equivalentClass [
    a owl:Restriction ;
    owl:onProperty :invoiceNumberValue ;
    owl:allValuesFrom xsd:string
] .

:Cl_OrganizationInformation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasOrganization ;
          owl:allValuesFrom :Cl_Organization ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasContactInformation ;
          owl:allValuesFrom :Cl_ContactInformation ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasLocation ;
          owl:allValuesFrom :Cl_Location ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasLogo ;
          owl:allValuesFrom :Cl_Logo ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasWebsite ;
          owl:allValuesFrom :Cl_Website ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasDescription ;
          owl:allValuesFrom :Cl_Description ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasRole ;
          owl:allValuesFrom :Cl_Role ]
    )
] .

:Cl_BuyerAddressAssociation
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Buyer ]
            [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Cl_Address ]
        )
    ] .

:Cl_InformationProvision owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ rdf:type owl:Restriction ;
          owl:onProperty :forFileFormat ;
          owl:someValuesFrom :Cl_FileFormat ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :informationProvision ;
          owl:allValuesFrom :Cl_RequiredInformation ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :informationProvision ;
          owl:someValuesFrom :Cl_RequiredInformation ]
        [ rdf:type owl:Restriction ;
          owl:onProperty :informationProvision ;
          owl:someValuesFrom [
            rdf:type owl:Restriction ;
            owl:onProperty :isMandatory ;
            owl:hasValue true
          ]
        ]
    )
] .

:Cl_ProcessAssignment owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        [ a owl:Restriction ;
          owl:onProperty :assignedBusinessProcess ;
          owl:someValuesFrom :Cl_BusinessProcess ]
        [ a owl:Restriction ;
          owl:onProperty :assignedInvoice ;
          owl:someValuesFrom :Cl_Invoice ]
    )
] .

#################################################################
# End of ontology
#################################################################
