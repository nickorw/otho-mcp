2026-03-04 07:53:20 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-ontology>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, organizations, roles, line items, and business process context in industrial procurement scenarios, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The envelope at the top of the EDIFACT hierarchy, containing messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A digital business document contained in an Interchange Envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message representing an invoice transaction.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A structural component of an EDIFACT message, such as BGM or NAD.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite element within a segment, grouping simple data elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A basic data value within a composite data element.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A party involved in the invoice, e.g., buyer, seller, delivery party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice, such as Buyer or DeliveryParty.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A good or service described in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value associated with an item or invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line in the invoice detail section, describing an item, its quantity, and price.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header section of an invoice, containing meta-information like dates and reference numbers.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The section of the invoice listing all line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The section of the invoice summarizing totals such as tax and invoice amount.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A unique identifier for organizations, such as a Global Location Number.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A reification class linking an organization, its role, and the invoice context.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to the messages it contains.\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage: links a message to its containing envelope.\" ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment: links a segment to its parent message.\" ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeDataElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite data element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    owl:inverseOf :isCompositeDataElementOf .\n\n:isCompositeDataElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite data element of\" ;\n    rdfs:comment \"Inverse of hasCompositeDataElement: links a composite data element to its parent segment.\" ;\n    owl:inverseOf :hasCompositeDataElement .\n\n:hasSimpleDataElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    owl:inverseOf :isSimpleDataElementOf .\n\n:isSimpleDataElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple data element of\" ;\n    rdfs:comment \"Inverse of hasSimpleDataElement: links a simple data element to its parent composite.\" ;\n    owl:inverseOf :hasSimpleDataElement .\n\n:hasHeaderSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :HeaderSection ;\n    rdfs:label \"has header section\" ;\n    rdfs:comment \"Links an invoice message to its header section.\" ;\n    owl:inverseOf :isHeaderSectionOf .\n\n:isHeaderSectionOf a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is header section of\" ;\n    rdfs:comment \"Inverse of hasHeaderSection: links a header section to its parent invoice message.\" ;\n    owl:inverseOf :hasHeaderSection .\n\n:hasDetailSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"has detail section\" ;\n    rdfs:comment \"Links an invoice message to its detail section.\" ;\n    owl:inverseOf :isDetailSectionOf .\n\n:isDetailSectionOf a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is detail section of\" ;\n    rdfs:comment \"Inverse of hasDetailSection: links a detail section to its parent invoice message.\" ;\n    owl:inverseOf :hasDetailSection .\n\n:hasSummarySection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"has summary section\" ;\n    rdfs:comment \"Links an invoice message to its summary section.\" ;\n    owl:inverseOf :isSummarySectionOf .\n\n:isSummarySectionOf a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is summary section of\" ;\n    rdfs:comment \"Inverse of hasSummarySection: links a summary section to its parent invoice message.\" ;\n    owl:inverseOf :hasSummarySection .\n\n:listsLineItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"lists line item\" ;\n    rdfs:comment \"Links a detail section to its line items.\" ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of listsLineItem: links a line item to its parent detail section.\" ;\n    owl:inverseOf :listsLineItem .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a line item to the item it describes.\" ;\n    owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is described by line item\" ;\n    rdfs:comment \"Inverse of describesItem: links an item to the line item that describes it.\" ;\n    owl:inverseOf :describesItem .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifier.\" ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier: links an identifier to its organization.\" ;\n    owl:inverseOf :hasIdentifier .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress: links an address to its organization.\" ;\n    owl:inverseOf :hasAddress .\n\n:organizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"organization role assignment\" ;\n    rdfs:comment \"Links an invoice message to an organization-role assignment.\" ;\n    owl:inverseOf :isOrganizationRoleAssignmentOf .\n\n:isOrganizationRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is organization role assignment of\" ;\n    rdfs:comment \"Inverse of organizationRoleAssignment: links an organization role assignment to its invoice message.\" ;\n    owl:inverseOf :organizationRoleAssignment .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an organization role assignment to the involved organization.\" ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Inverse of involvesOrganization: links an organization to its organization role assignments.\" ;\n    owl:inverseOf :involvesOrganization .\n\n:organizationRole a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"organization role\" ;\n    rdfs:comment \"Links an organization role assignment to the agent role.\" ;\n    owl:inverseOf :isRoleOfOrganizationAssignment .\n\n:isRoleOfOrganizationAssignment a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is role of organization assignment\" ;\n    rdfs:comment \"Inverse of organizationRole: links an agent role to its organization role assignments.\" ;\n    owl:inverseOf :organizationRole .\n\n:appliesToInvoice a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"applies to invoice\" ;\n    rdfs:comment \"Links an organization role assignment to the invoice it applies to.\" ;\n    owl:inverseOf :hasOrganizationRoleAssignment .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Inverse of appliesToInvoice: links an invoice message to its organization role assignments.\" ;\n    owl:inverseOf :appliesToInvoice .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice message to a business process.\" ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Inverse of hasBusinessProcess: links a business process to its invoice message.\" ;\n    owl:inverseOf :hasBusinessProcess .\n\n# Link Price to LineItem (to fix P04)\n:hasPrice a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a line item to its price (fixes unconnected Price class).\" ;\n    owl:inverseOf :isPriceOf .\n\n:isPriceOf a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is price of\" ;\n    rdfs:comment \"Inverse of hasPrice: links a price to its line item.\" ;\n    owl:inverseOf :hasPrice .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of an item in a line item.\" .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of an item in a line item.\" .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total invoice amount in the summary section.\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The unique number of an invoice message.\" .\n\n:hasDate a owl:DatatypeProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"A date value in the header section, such as document date.\" .\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The actual identifier string, e.g., GLN.\" .\n\n#################################################################\n# Restrictions & GCAs\n#################################################################\n\n:Buyer a :AgentRole ;\n    rdfs:label \"Buyer\" ;\n    rdfs:comment \"The agent role representing the buyer in an invoice.\" .\n\n:DeliveryParty a :AgentRole ;\n    rdfs:label \"Delivery Party\" ;\n    rdfs:comment \"The agent role representing the delivery party in an invoice.\" .\n\n[ a owl:Restriction ;\n  owl:onProperty :organizationRole ;\n  owl:someValuesFrom :Buyer ;\n  rdfs:subClassOf :OrganizationRoleAssignment\n] .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:Organization owl:disjointWith :Address, :Item .\n:InvoiceMessage owl:disjointWith :Organization .\n\n#################################################################\n# DisjointUnion\n#################################################################\n\n:Message owl:disjointUnionOf ( :InvoiceMessage ) .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
