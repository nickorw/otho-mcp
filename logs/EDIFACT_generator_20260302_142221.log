2026-03-02 14:37:43 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A Invoice Ontology\" ;\n    rdfs:comment \"A profoundly structured OWL2 ontology for UN/EDIFACT D96A Invoice (INVOIC) messages, supporting EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message, a subclass of Message.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:DTMSegment a owl:Class ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment. Contains qualifier and value.\" ;\n    rdfs:subClassOf :Segment .\n\n:MOASegment a owl:Class ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment. Contains qualifier and amount value.\" ;\n    rdfs:subClassOf :Segment .\n\n:RFFSegment a owl:Class ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment for reference numbers.\" ;\n    rdfs:subClassOf :Segment .\n\n:LOCSegment a owl:Class ;\n    rdfs:label \"LOC Segment\" ;\n    rdfs:comment \"Location segment for delivery or other locations.\" ;\n    rdfs:subClassOf :Segment .\n\n:LINSegment a owl:Class ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line Item segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:PRISegment a owl:Class ;\n    rdfs:label \"PRI Segment\" ;\n    rdfs:comment \"Price segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:QTYSegment a owl:Class ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:TAXSegment a owl:Class ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:CUXSegment a owl:Class ;\n    rdfs:label \"CUX Segment\" ;\n    rdfs:comment \"Currency segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:UNSSegment a owl:Class ;\n    rdfs:label \"UNS Segment\" ;\n    rdfs:comment \"Section control segment (header/detail/summary separator).\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice message.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice message.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice message.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A legal entity involved in the transaction.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization (e.g., Buyer, Supplier, Delivery Party).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An itemized entry in the invoice detail section.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or good referenced in the invoice.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item or invoice.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax applied to the invoice or line item.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for the invoice or related documents.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process such as Purchase-to-Pay.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validation, e.g., SHACL shape.\" .\n\n:GLNIdentifier a owl:Class ;\n    rdfs:label \"GLN Identifier\" ;\n    rdfs:comment \"A Global Location Number identifier.\" ;\n    rdfs:subClassOf :SimpleDataElement .\n\n:EN16931Alignment a owl:Class ;\n    rdfs:label \"EN 16931 Alignment\" ;\n    rdfs:comment \"Alignment to EN 16931-1 semantic model.\" .\n\n:P2POAlignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment to Purchase-to-Pay Ontology (P2P-O).\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A reified relationship linking an organization to a role in the invoice context.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an Interchange Envelope to one or more Messages.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:inverseOf :isContainedBy .\n\n:isContainedBy a owl:ObjectProperty ;\n    rdfs:label \"is contained by\" ;\n    rdfs:comment \"Links a Message to its containing InterchangeEnvelope.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Links a Segment to its containing Message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    owl:inverseOf :hasSegment .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an Invoice Message to its header section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n    rdfs:label \"is header of\" ;\n    rdfs:comment \"Links InvoiceHeader to its InvoiceMessage.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasHeader .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links an Invoice Message to its detail section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n    rdfs:label \"is detail of\" ;\n    rdfs:comment \"Links InvoiceDetail to its InvoiceMessage.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasDetail .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links an Invoice Message to its summary section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n    rdfs:label \"is summary of\" ;\n    rdfs:comment \"Links InvoiceSummary to its InvoiceMessage.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasSummary .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links an Invoice Detail to its Line Items.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Links LineItem to its InvoiceDetail.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :hasLineItem .\n\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a Line Item to the Item it describes.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:inverseOf :isDescribedBy .\n\n:isDescribedBy a owl:ObjectProperty ;\n    rdfs:label \"is described by\" ;\n    rdfs:comment \"Links Item to its describing LineItem.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :describesItem .\n\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a Line Item to its net Price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n    rdfs:label \"is net price of\" ;\n    rdfs:comment \"Links Price to its LineItem.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasNetPrice .\n\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of an item in a line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:hasTax a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links an Invoice Summary to a Tax instance.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax ;\n    owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n    rdfs:label \"is tax of\" ;\n    rdfs:comment \"Links Tax to its InvoiceSummary.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :hasTax .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total invoice amount in the summary.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number in the header.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Links an Invoice Header to a Reference Number.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :ReferenceNumber ;\n    owl:inverseOf :isReferenceNumberOf .\n\n:isReferenceNumberOf a owl:ObjectProperty ;\n    rdfs:label \"is reference number of\" ;\n    rdfs:comment \"Links ReferenceNumber to its InvoiceHeader.\" ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :hasReferenceNumber .\n\n:hasDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"A generic date property (use DTMSegment for qualified dates).\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an Invoice Message to an involved Organization.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isInvolvedIn .\n\n:isInvolvedIn a owl:ObjectProperty ;\n    rdfs:label \"is involved in\" ;\n    rdfs:comment \"Links Organization to the InvoiceMessage it is involved in.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an Invoice Message to a RoleAssignment instance.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is role assignment of\" ;\n    rdfs:comment \"Links RoleAssignment to its InvoiceMessage.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasAgentRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a RoleAssignment to an AgentRole.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isAgentRoleOf .\n\n:isAgentRoleOf a owl:ObjectProperty ;\n    rdfs:label \"is agent role of\" ;\n    rdfs:comment \"Links AgentRole to its RoleAssignment.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :hasAgentRole .\n\n:hasParticipant a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has participant\" ;\n    rdfs:comment \"Links a RoleAssignment to the Organization in that role.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isParticipantOf .\n\n:isParticipantOf a owl:ObjectProperty ;\n    rdfs:label \"is participant of\" ;\n    rdfs:comment \"Links Organization to its RoleAssignment.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :hasParticipant .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Links Address to its Organization.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasGLN a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"The Global Location Number of an Organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:alignedWithEN16931 a owl:ObjectProperty ;\n    rdfs:label \"aligned with EN 16931\" ;\n    rdfs:comment \"Links an Invoice Message to EN16931Alignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931Alignment ;\n    owl:inverseOf :isEN16931AlignmentOf .\n\n:isEN16931AlignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is EN 16931 alignment of\" ;\n    rdfs:comment \"Links EN16931Alignment to its InvoiceMessage.\" ;\n    rdfs:domain :EN16931Alignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :alignedWithEN16931 .\n\n:alignedWithP2PO a owl:ObjectProperty ;\n    rdfs:label \"aligned with P2P-O\" ;\n    rdfs:comment \"Links an Invoice Message to P2POAlignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2POAlignment ;\n    owl:inverseOf :isP2POAlignmentOf .\n\n:isP2POAlignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is P2P-O alignment of\" ;\n    rdfs:comment \"Links P2POAlignment to its InvoiceMessage.\" ;\n    rdfs:domain :P2POAlignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :alignedWithP2PO .\n\n:validatesWith a owl:ObjectProperty ;\n    rdfs:label \"validates with\" ;\n    rdfs:comment \"Links an Invoice Message to a ValidationConstraint (e.g. SHACL).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    owl:inverseOf :isValidationConstraintOf .\n\n:isValidationConstraintOf a owl:ObjectProperty ;\n    rdfs:label \"is validation constraint of\" ;\n    rdfs:comment \"Links ValidationConstraint to its InvoiceMessage.\" ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :validatesWith .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an Invoice Message to a Business Process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Links BusinessProcess to its InvoiceMessage.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasBusinessProcess .\n\n# Segment-specific object properties\n:hasDTM a owl:ObjectProperty ;\n    rdfs:label \"has DTM segment\" ;\n    rdfs:comment \"Links header or detail to a DTMSegment (qualified date/time).\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :DTMSegment ;\n    owl:inverseOf :isDTMSegmentOf .\n\n:isDTMSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is DTM segment of\" ;\n    rdfs:comment \"Links DTMSegment to its InvoiceHeader.\" ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :hasDTM .\n\n:hasMOA a owl:ObjectProperty ;\n    rdfs:label \"has MOA segment\" ;\n    rdfs:comment \"Links summary or line item to a MOASegment (qualified amount).\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :MOASegment ;\n    owl:inverseOf :isMOASegmentOf .\n\n:isMOASegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is MOA segment of\" ;\n    rdfs:comment \"Links MOASegment to its InvoiceSummary.\" ;\n    rdfs:domain :MOASegment ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :hasMOA .\n\n:hasRFF a owl:ObjectProperty ;\n    rdfs:label \"has RFF segment\" ;\n    rdfs:comment \"Links header or detail to a RFFSegment (reference).\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :RFFSegment ;\n    owl:inverseOf :isRFFSegmentOf .\n\n:isRFFSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is RFF segment of\" ;\n    rdfs:comment \"Links RFFSegment to its InvoiceHeader.\" ;\n    rdfs:domain :RFFSegment ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :hasRFF .\n\n:hasLOC a owl:ObjectProperty ;\n    rdfs:label \"has LOC segment\" ;\n    rdfs:comment \"Links detail or line item to a LOCSegment (location).\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LOCSegment ;\n    owl:inverseOf :isLOCSegmentOf .\n\n:isLOCSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is LOC segment of\" ;\n    rdfs:comment \"Links LOCSegment to its InvoiceDetail.\" ;\n    rdfs:domain :LOCSegment ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :hasLOC .\n\n:hasLIN a owl:ObjectProperty ;\n    rdfs:label \"has LIN segment\" ;\n    rdfs:comment \"Links detail to a LINSegment (line item).\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LINSegment ;\n    owl:inverseOf :isLINSegmentOf .\n\n:isLINSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is LIN segment of\" ;\n    rdfs:comment \"Links LINSegment to its InvoiceDetail.\" ;\n    rdfs:domain :LINSegment ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :hasLIN .\n\n:hasPRI a owl:ObjectProperty ;\n    rdfs:label \"has PRI segment\" ;\n    rdfs:comment \"Links line item to a PRISegment (price).\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :PRISegment ;\n    owl:inverseOf :isPRISegmentOf .\n\n:isPRISegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is PRI segment of\" ;\n    rdfs:comment \"Links PRISegment to its LineItem.\" ;\n    rdfs:domain :PRISegment ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasPRI .\n\n:hasQTY a owl:ObjectProperty ;\n    rdfs:label \"has QTY segment\" ;\n    rdfs:comment \"Links line item to a QTYSegment (quantity).\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :QTYSegment ;\n    owl:inverseOf :isQTYSegmentOf .\n\n:isQTYSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is QTY segment of\" ;\n    rdfs:comment \"Links QTYSegment to its LineItem.\" ;\n    rdfs:domain :QTYSegment ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasQTY .\n\n:hasTAX a owl:ObjectProperty ;\n    rdfs:label \"has TAX segment\" ;\n    rdfs:comment \"Links summary or line item to a TAXSegment (tax info).\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :TAXSegment ;\n    owl:inverseOf :isTAXSegmentOf .\n\n:isTAXSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is TAX segment of\" ;\n    rdfs:comment \"Links TAXSegment to its InvoiceSummary.\" ;\n    rdfs:domain :TAXSegment ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :hasTAX .\n\n:hasCUX a owl:ObjectProperty ;\n    rdfs:label \"has CUX segment\" ;\n    rdfs:comment \"Links summary or line item to a CUXSegment (currency info).\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :CUXSegment ;\n    owl:inverseOf :isCUXSegmentOf .\n\n:isCUXSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is CUX segment of\" ;\n    rdfs:comment \"Links CUXSegment to its InvoiceSummary.\" ;\n    rdfs:domain :CUXSegment ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :hasCUX .\n\n:hasUNS a owl:ObjectProperty ;\n    rdfs:label \"has UNS segment\" ;\n    rdfs:comment \"Links summary to a UNSSegment (section control).\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :UNSSegment ;\n    owl:inverseOf :isUNSSegmentOf .\n\n:isUNSSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is UNS segment of\" ;\n    rdfs:comment \"Links UNSSegment to its InvoiceSummary.\" ;\n    rdfs:domain :UNSSegment ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :hasUNS .\n\n#################################################################\n# Data Properties (Qualifiers & Values)\n#################################################################\n\n:dtmQualifier a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"DTM qualifier\" ;\n    rdfs:comment \"Qualifier code for DTMSegment (e.g., 137=Document date).\" ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range xsd:string .\n\n:dtmValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"DTM value\" ;\n    rdfs:comment \"Date/time value for DTMSegment.\" ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range xsd:string .\n\n:moaQualifier a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"MOA qualifier\" ;\n    rdfs:comment \"Qualifier code for MOASegment (e.g., 9=Invoice amount).\" ;\n    rdfs:domain :MOASegment ;\n    rdfs:range xsd:string .\n\n:moaValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"MOA value\" ;\n    rdfs:comment \"Monetary value for MOASegment.\" ;\n    rdfs:domain :MOASegment ;\n    rdfs:range xsd:decimal .\n\n#################################################################\n# Disjointness Axioms\n#################################################################\n\n[] a owl:AllDisjointClasses ;\n    owl:members ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\n\n[] a owl:AllDisjointClasses ;\n    owl:members ( :Organization :AgentRole :Address :LineItem :Item :Price :Tax :ReferenceNumber :BusinessProcess ) .\n\n#################################################################\n# Pivot Class Reification\n#################################################################\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A reified n-ary relationship linking an Organization to an AgentRole in the context of an Invoice Message.\" .\n\n:hasAgentRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a RoleAssignment to an AgentRole.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isAgentRoleOf .\n\n:isAgentRoleOf a owl:ObjectProperty ;\n    rdfs:label \"is agent role of\" ;\n    rdfs:comment \"Links AgentRole to its RoleAssignment.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :hasAgentRole .\n\n:hasParticipant a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has participant\" ;\n    rdfs:comment \"Links a RoleAssignment to the Organization in that role.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isParticipantOf .\n\n:isParticipantOf a owl:ObjectProperty ;\n    rdfs:label \"is participant of\" ;\n    rdfs:comment \"Links Organization to its RoleAssignment.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :hasParticipant .\n\n#################################################################\n# Class Equivalence and Restrictions\n#################################################################\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"A role indicating buying party in the invoice.\" ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:hasValue :Buyer ] .\n\n:InvoiceWithEN16931Alignment a owl:Class ;\n    rdfs:label \"Invoice with EN 16931 Alignment\" ;\n    rdfs:comment \"An Invoice Message aligned with EN 16931.\" ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :alignedWithEN16931 ; owl:someValuesFrom :EN16931Alignment ] ."
