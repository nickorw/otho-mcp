        "arguments": "{\"key\":\"cq_coverage\",\"value\":{\"CQ1\":\"Invoices listed: InvoiceMessage (INVOIC), containsMessage, hasHeader, hasDetail, hasSummary, UNH_Segment, UNT_Segment.\",\"CQ2\":\"Organizations involved: involvesOrganization, Organization class, hasAgentRole, RoleAssignment (pivot), NAD_Segment.\",\"CQ3\":\"Role of organization S: RoleAssignment (pivot), assignedRole, assignedToOrganization, assignedInContext, NAD_Segment.\",\"CQ4\":\"Buyer identification: AgentRole, RoleAssignment (pivot), assignedRole, assignedToOrganization, hasAgentRole, NAD_Segment.\",\"CQ5\":\"Organization info: hasAddress, hasIdentifier, hasAgentRole, Address, Identifier, NAD_Segment.\",\"CQ6\":\"Buyer address: Address, hasAddress, Organization, RoleAssignment (pivot), AgentRole, NAD_Segment.\",\"CQ7\":\"Items sold: LineItem (pivot), describesItem, Item class, hasLineItem, LIN_Segment, IMD_Segment, PIA_Segment.\",\"CQ8\":\"Item info: describesItem, hasNetPrice, hasQuantity, Item, Price, LIN_Segment, IMD_Segment, PIA_Segment, PAC_Segment, MEA_Segment.\",\"CQ9\":\"Net price: hasNetPrice, PRI_Segment, LineItem (pivot).\",\"CQ10\":\"Invoice details: InvoiceHeader, InvoiceDetail, InvoiceSummary, hasHeader, hasDetail, hasSummary, DTM_Segment, MOA_Segment, QTY_Segment, PRI_Segment, TAX_Segment, RFF_Segment, ALC_Segment, CUX_Segment, TOD_Segment, LOC_Segment, FTX_Segment, PAT_Segment, PCD_Segment, TDT_Segment, MEA_Segment.\",\"CQ11\":\"Invoice amount: hasTotalAmount, MOA_Segment, InvoiceSummary.\",\"CQ12\":\"Invoice number: hasInvoiceNumber, RFF_Segment, InvoiceHeader, UNH_Segment.\",\"CQ13\":\"File format validity: ValidationConstraint, hasValidationConstraint, hasMandatoryIdentifier, Identifier, hasGLN, OWL restrictions, cross-segment axioms.\",\"CQ14\":\"Business process assignment: isAssignedToBusinessProcess, BusinessProcess.\"}}",
