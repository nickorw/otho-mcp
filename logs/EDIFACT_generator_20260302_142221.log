        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#INVOIC-Ontology> a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT D96A INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A comprehensive OWL2 ontology for UN/EDIFACT D96A INVOIC messages, covering all mandatory segments, roles, and validation constraints for semantic interoperability and compliance with EN 16931-1.\\\" .\\n\\n###################################################################\\n# CLASSES\\n###################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A business message within the interchange envelope, e.g., INVOIC.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message (INVOIC)\\\" ;\\n    rdfs:comment \\\"The INVOIC message for global trade, subclass of Message.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment in an EDIFACT message, e.g., BGM, NAD, DTM, etc.\\\" .\\n\\n# Segment subclasses\\n:UNH_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"UNH Segment\\\" ; rdfs:comment \\\"Message header segment (UNH) for INVOIC.\\\" .\\n:UNT_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"UNT Segment\\\" ; rdfs:comment \\\"Message trailer segment (UNT) for INVOIC.\\\" .\\n:BGM_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"BGM Segment\\\" ; rdfs:comment \\\"Beginning of message segment (BGM).\\\" .\\n:NAD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"NAD Segment\\\" ; rdfs:comment \\\"Name and address segment (NAD) for parties and roles.\\\" .\\n:DTM_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"DTM Segment\\\" ; rdfs:comment \\\"Date/time/period segment (DTM), e.g., invoice date, delivery date.\\\" .\\n:MOA_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"MOA Segment\\\" ; rdfs:comment \\\"Monetary amount segment (MOA), e.g., invoice total, line totals.\\\" .\\n:QTY_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"QTY Segment\\\" ; rdfs:comment \\\"Quantity segment (QTY), e.g., item quantity.\\\" .\\n:PRI_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PRI Segment\\\" ; rdfs:comment \\\"Price segment (PRI), e.g., net price per item.\\\" .\\n:TAX_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"TAX Segment\\\" ; rdfs:comment \\\"Tax segment (TAX), e.g., VAT details.\\\" .\\n:RFF_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"RFF Segment\\\" ; rdfs:comment \\\"Reference segment (RFF), e.g., invoice number, order reference.\\\" .\\n:ALC_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"ALC Segment\\\" ; rdfs:comment \\\"Allowance/charge segment (ALC) for discounts, surcharges.\\\" .\\n:LIN_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"LIN Segment\\\" ; rdfs:comment \\\"Line item identifier segment (LIN).\\\" .\\n:IMD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"IMD Segment\\\" ; rdfs:comment \\\"Item description segment (IMD).\\\" .\\n:PIA_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PIA Segment\\\" ; rdfs:comment \\\"Additional product ID segment (PIA).\\\" .\\n:PAC_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PAC Segment\\\" ; rdfs:comment \\\"Packaging segment (PAC).\\\" .\\n:CUX_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"CUX Segment\\\" ; rdfs:comment \\\"Currency segment (CUX) for currency details.\\\" .\\n:TOD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"TOD Segment\\\" ; rdfs:comment \\\"Terms of delivery segment (TOD).\\\" .\\n:LOC_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"LOC Segment\\\" ; rdfs:comment \\\"Location segment (LOC) for logistics.\\\" .\\n:FTX_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"FTX Segment\\\" ; rdfs:comment \\\"Free text segment (FTX) for invoice notes and legal text.\\\" .\\n:PAT_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PAT Segment\\\" ; rdfs:comment \\\"Payment terms segment (PAT) for due dates, terms, penalties.\\\" .\\n:PCD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PCD Segment\\\" ; rdfs:comment \\\"Percentage details segment (PCD) for discounts, surcharges.\\\" .\\n:TDT_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"TDT Segment\\\" ; rdfs:comment \\\"Transport details segment (TDT) for shipping/transport.\\\" .\\n:MEA_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"MEA Segment\\\" ; rdfs:comment \\\"Measurement segment (MEA) for weights, dimensions.\\\" .\\n\\n# Data structure classes\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite or segment.\\\" .\\n\\n# Pivot and core business classes\\n:InvoiceHeader a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"Header section of the invoice, containing document dates and references.\\\" .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"Detail section listing individual line items.\\\" .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"Summary section providing totals, taxes, and payment terms.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Line Item (pivot)\\\" ;\\n    rdfs:comment \\\"Pivot class for line-level reification (item, price, quantity, etc.).\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A business entity involved in the invoice (buyer, supplier, etc.).\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role that an organization plays in the invoice (buyer, delivery party, etc.).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment (pivot)\\\" ;\\n    rdfs:comment \\\"Pivot class for reifying the assignment of a role to an organization within a message context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address associated with an organization.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A monetary price, e.g., for an item or invoice total.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax entity, e.g., VAT.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"An identifier such as Global Location Number (GLN).\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A SHACL or OWL-based validation constraint for the invoice.\\\" .\\n\\n###################################################################\\n# OBJECT PROPERTIES\\n###################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an Interchange Envelope to its contained Message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a Message to its Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a Segment to its Composite Data Elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a Composite Data Element to its Simple Data Elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to its header section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader ;\\n    owl:FunctionalProperty .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to its detail section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:FunctionalProperty .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to its summary section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:FunctionalProperty .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to involved Organizations.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Organization .\\n\\n:hasAgentRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has agent role\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Agent Roles.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :AgentRole .\\n\\n:assignedRole a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"Links a RoleAssignment to its AgentRole.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:FunctionalProperty .\\n\\n:assignedToOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned to organization\\\" ;\\n    rdfs:comment \\\"Links a RoleAssignment to the Organization playing the role.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:FunctionalProperty .\\n\\n:assignedInContext a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned in context\\\" ;\\n    rdfs:comment \\\"Links a RoleAssignment to the Invoice Message context.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:FunctionalProperty .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Identifier (e.g., GLN).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    owl:FunctionalProperty .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links an InvoiceDetail to its LineItems.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :LineItem .\\n\\n:describesItem a owl:ObjectProperty ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Links a LineItem to the Item it describes.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    owl:FunctionalProperty .\\n\\n:hasQuantity a owl:ObjectProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its QTY_Segment.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :QTY_Segment .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PRI_Segment (net price).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PRI_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasTotalTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has total tax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TAX_Segment (total tax).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TAX_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasTotalAmount a owl:ObjectProperty ;\\n    rdfs:label \\\"has total amount\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its MOA_Segment (total amount).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :MOA_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasInvoiceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its RFF_Segment (invoice number).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :RFF_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasDocumentDate a owl:ObjectProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its DTM_Segment (document date).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :DTM_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its RFF_Segment (reference number).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :RFF_Segment ;\\n    owl:FunctionalProperty .\\n\\n:isAssignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned to business process\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a BusinessProcess.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n\\n:hasValidationConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has validation constraint\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a ValidationConstraint (e.g., for SHACL/OWL validation).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint .\\n\\n:hasMandatoryIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has mandatory identifier\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to mandatory Identifiers (e.g., GLN).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Identifier .\\n\\n:hasAllowanceOrCharge a owl:ObjectProperty ;\\n    rdfs:label \\\"has allowance or charge\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its ALC_Segment (allowances/charges).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :ALC_Segment .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TAX_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TAX_Segment .\\n\\n:hasReference a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its RFF_Segment (other references).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :RFF_Segment .\\n\\n:hasMessageHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has message header\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its UNH_Segment (message header).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNH_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasMessageTrailer a owl:ObjectProperty ;\\n    rdfs:label \\\"has message trailer\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its UNT_Segment (message trailer).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNT_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasLineIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has line identifier\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its LIN_Segment (line identifier).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :LIN_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasItemDescription a owl:ObjectProperty ;\\n    rdfs:label \\\"has item description\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its IMD_Segment (item description).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :IMD_Segment .\\n\\n:hasAdditionalProductID a owl:ObjectProperty ;\\n    rdfs:label \\\"has additional product ID\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PIA_Segment (additional product IDs).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PIA_Segment .\\n\\n:hasPackaging a owl:ObjectProperty ;\\n    rdfs:label \\\"has packaging\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PAC_Segment (packaging).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PAC_Segment .\\n\\n:hasCurrency a owl:ObjectProperty ;\\n    rdfs:label \\\"has currency\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its CUX_Segment (currency details).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :CUX_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasTermsOfDelivery a owl:ObjectProperty ;\\n    rdfs:label \\\"has terms of delivery\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TOD_Segment (terms of delivery).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TOD_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasLocation a owl:ObjectProperty ;\\n    rdfs:label \\\"has location\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its LOC_Segment (location/logistics).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :LOC_Segment .\\n\\n:hasFreeText a owl:ObjectProperty ;\\n    rdfs:label \\\"has free text\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its FTX_Segment(s) (free text/legal notes).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :FTX_Segment .\\n\\n:hasFreeTextLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has free text line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its FTX_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :FTX_Segment .\\n\\n:hasReferenceLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its RFF_Segment(s) (line-level references).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :RFF_Segment .\\n\\n:hasDateLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has date line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its DTM_Segment(s) (line-level dates).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DTM_Segment .\\n\\n:hasAllowanceOrChargeLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has allowance or charge line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its ALC_Segment(s) (allowance/charge details).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :ALC_Segment .\\n\\n:hasPaymentTerms a owl:ObjectProperty ;\\n    rdfs:label \\\"has payment terms\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its PAT_Segment (payment terms).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :PAT_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasPercentageDetails a owl:ObjectProperty ;\\n    rdfs:label \\\"has percentage details\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its PCD_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :PCD_Segment .\\n\\n:hasTransportDetails a owl:ObjectProperty ;\\n    rdfs:label \\\"has transport details\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TDT_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TDT_Segment .\\n\\n:hasMeasurement a owl:ObjectProperty ;\\n    rdfs:label \\\"has measurement\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its MEA_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :MEA_Segment .\\n\\n:hasPaymentTermsLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has payment terms line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PAT_Segment(s) (payment terms).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PAT_Segment .\\n\\n:hasPercentageDetailsLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has percentage details line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PCD_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PCD_Segment .\\n\\n:hasTransportDetailsLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has transport details line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its TDT_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :TDT_Segment .\\n\\n:hasMeasurementLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has measurement line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its MEA_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :MEA_Segment .\\n\\n###################################################################\\n# DATA PROPERTIES\\n###################################################################\\n\\n:hasGLN a owl:DatatypeProperty ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Links an Identifier to its Global Location Number (GLN) as a string.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n###################################################################\\n# COMPLEX AXIOMS & RESTRICTIONS\\n###################################################################\\n\\n# Example: InvoiceSummary must have at least one total amount (MOA_Segment)\\n:InvoiceSummary rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasTotalAmount ;\\n    owl:someValuesFrom :MOA_Segment\\n] .\\n\\n# Example: LineItem must have at least one quantity (QTY_Segment)\\n:LineItem rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasQuantity ;\\n    owl:someValuesFrom :QTY_Segment\\n] .\\n\\n# Example: LineItem must have at least one net price (PRI_Segment)\\n:LineItem rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasNetPrice ;\\n    owl:someValuesFrom :PRI_Segment\\n] .\\n\\n# Example: InvoiceMessage must have a message header (UNH_Segment)\\n:InvoiceMessage rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasMessageHeader ;\\n    owl:someValuesFrom :UNH_Segment\\n] .\\n\\n# Example: ValidationConstraint for arithmetic consistency\\n:ValidationConstraint rdfs:comment \\\"Constraint: The sum of all LineItem net amounts (MOA_Segment) must equal the InvoiceSummary total amount (MOA_Segment).\\\" .\\n\\n###################################################################\\n# DISJOINTNESS\\n###################################################################\\n\\n:Organization owl:disjointWith :Address .\\n:Message owl:disjointWith :Segment .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n\\n###################################################################\\n# ANNOTATIONS (for all classes/properties above)\\n###################################################################\\n# (Already included inline for each class/property)\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
    {
      "id": "call_nDMGG9iLkYfRsepchuMl6TC6",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#INVOIC-Ontology> a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT D96A INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A comprehensive OWL2 ontology for UN/EDIFACT D96A INVOIC messages, covering all mandatory segments, roles, and validation constraints for semantic interoperability and compliance with EN 16931-1.\\\" .\\n\\n###################################################################\\n# CLASSES\\n###################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A business message within the interchange envelope, e.g., INVOIC.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message (INVOIC)\\\" ;\\n    rdfs:comment \\\"The INVOIC message for global trade, subclass of Message.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment in an EDIFACT message, e.g., BGM, NAD, DTM, etc.\\\" .\\n\\n# Segment subclasses\\n:UNH_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"UNH Segment\\\" ; rdfs:comment \\\"Message header segment (UNH) for INVOIC.\\\" .\\n:UNT_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"UNT Segment\\\" ; rdfs:comment \\\"Message trailer segment (UNT) for INVOIC.\\\" .\\n:BGM_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"BGM Segment\\\" ; rdfs:comment \\\"Beginning of message segment (BGM).\\\" .\\n:NAD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"NAD Segment\\\" ; rdfs:comment \\\"Name and address segment (NAD) for parties and roles.\\\" .\\n:DTM_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"DTM Segment\\\" ; rdfs:comment \\\"Date/time/period segment (DTM), e.g., invoice date, delivery date.\\\" .\\n:MOA_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"MOA Segment\\\" ; rdfs:comment \\\"Monetary amount segment (MOA), e.g., invoice total, line totals.\\\" .\\n:QTY_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"QTY Segment\\\" ; rdfs:comment \\\"Quantity segment (QTY), e.g., item quantity.\\\" .\\n:PRI_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PRI Segment\\\" ; rdfs:comment \\\"Price segment (PRI), e.g., net price per item.\\\" .\\n:TAX_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"TAX Segment\\\" ; rdfs:comment \\\"Tax segment (TAX), e.g., VAT details.\\\" .\\n:RFF_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"RFF Segment\\\" ; rdfs:comment \\\"Reference segment (RFF), e.g., invoice number, order reference.\\\" .\\n:ALC_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"ALC Segment\\\" ; rdfs:comment \\\"Allowance/charge segment (ALC) for discounts, surcharges.\\\" .\\n:LIN_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"LIN Segment\\\" ; rdfs:comment \\\"Line item identifier segment (LIN).\\\" .\\n:IMD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"IMD Segment\\\" ; rdfs:comment \\\"Item description segment (IMD).\\\" .\\n:PIA_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PIA Segment\\\" ; rdfs:comment \\\"Additional product ID segment (PIA).\\\" .\\n:PAC_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PAC Segment\\\" ; rdfs:comment \\\"Packaging segment (PAC).\\\" .\\n:CUX_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"CUX Segment\\\" ; rdfs:comment \\\"Currency segment (CUX) for currency details.\\\" .\\n:TOD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"TOD Segment\\\" ; rdfs:comment \\\"Terms of delivery segment (TOD).\\\" .\\n:LOC_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"LOC Segment\\\" ; rdfs:comment \\\"Location segment (LOC) for logistics.\\\" .\\n:FTX_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"FTX Segment\\\" ; rdfs:comment \\\"Free text segment (FTX) for invoice notes and legal text.\\\" .\\n:PAT_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PAT Segment\\\" ; rdfs:comment \\\"Payment terms segment (PAT) for due dates, terms, penalties.\\\" .\\n:PCD_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"PCD Segment\\\" ; rdfs:comment \\\"Percentage details segment (PCD) for discounts, surcharges.\\\" .\\n:TDT_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"TDT Segment\\\" ; rdfs:comment \\\"Transport details segment (TDT) for shipping/transport.\\\" .\\n:MEA_Segment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \\\"MEA Segment\\\" ; rdfs:comment \\\"Measurement segment (MEA) for weights, dimensions.\\\" .\\n\\n# Data structure classes\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite or segment.\\\" .\\n\\n# Pivot and core business classes\\n:InvoiceHeader a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"Header section of the invoice, containing document dates and references.\\\" .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"Detail section listing individual line items.\\\" .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"Summary section providing totals, taxes, and payment terms.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Line Item (pivot)\\\" ;\\n    rdfs:comment \\\"Pivot class for line-level reification (item, price, quantity, etc.).\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A business entity involved in the invoice (buyer, supplier, etc.).\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role that an organization plays in the invoice (buyer, delivery party, etc.).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment (pivot)\\\" ;\\n    rdfs:comment \\\"Pivot class for reifying the assignment of a role to an organization within a message context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address associated with an organization.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A monetary price, e.g., for an item or invoice total.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax entity, e.g., VAT.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"An identifier such as Global Location Number (GLN).\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A SHACL or OWL-based validation constraint for the invoice.\\\" .\\n\\n###################################################################\\n# OBJECT PROPERTIES\\n###################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an Interchange Envelope to its contained Message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a Message to its Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a Segment to its Composite Data Elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a Composite Data Element to its Simple Data Elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to its header section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader ;\\n    owl:FunctionalProperty .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to its detail section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:FunctionalProperty .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to its summary section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:FunctionalProperty .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Links an Invoice Message to involved Organizations.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Organization .\\n\\n:hasAgentRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has agent role\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Agent Roles.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :AgentRole .\\n\\n:assignedRole a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"Links a RoleAssignment to its AgentRole.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:FunctionalProperty .\\n\\n:assignedToOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned to organization\\\" ;\\n    rdfs:comment \\\"Links a RoleAssignment to the Organization playing the role.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:FunctionalProperty .\\n\\n:assignedInContext a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned in context\\\" ;\\n    rdfs:comment \\\"Links a RoleAssignment to the Invoice Message context.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:FunctionalProperty .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Identifier (e.g., GLN).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    owl:FunctionalProperty .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links an InvoiceDetail to its LineItems.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :LineItem .\\n\\n:describesItem a owl:ObjectProperty ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Links a LineItem to the Item it describes.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    owl:FunctionalProperty .\\n\\n:hasQuantity a owl:ObjectProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its QTY_Segment.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :QTY_Segment .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PRI_Segment (net price).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PRI_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasTotalTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has total tax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TAX_Segment (total tax).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TAX_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasTotalAmount a owl:ObjectProperty ;\\n    rdfs:label \\\"has total amount\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its MOA_Segment (total amount).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :MOA_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasInvoiceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its RFF_Segment (invoice number).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :RFF_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasDocumentDate a owl:ObjectProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its DTM_Segment (document date).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :DTM_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its RFF_Segment (reference number).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :RFF_Segment ;\\n    owl:FunctionalProperty .\\n\\n:isAssignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned to business process\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a BusinessProcess.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n\\n:hasValidationConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has validation constraint\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a ValidationConstraint (e.g., for SHACL/OWL validation).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint .\\n\\n:hasMandatoryIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has mandatory identifier\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to mandatory Identifiers (e.g., GLN).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Identifier .\\n\\n:hasAllowanceOrCharge a owl:ObjectProperty ;\\n    rdfs:label \\\"has allowance or charge\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its ALC_Segment (allowances/charges).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :ALC_Segment .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TAX_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TAX_Segment .\\n\\n:hasReference a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference\\\" ;\\n    rdfs:comment \\\"Links an InvoiceHeader to its RFF_Segment (other references).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :RFF_Segment .\\n\\n:hasMessageHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has message header\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its UNH_Segment (message header).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNH_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasMessageTrailer a owl:ObjectProperty ;\\n    rdfs:label \\\"has message trailer\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its UNT_Segment (message trailer).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNT_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasLineIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has line identifier\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its LIN_Segment (line identifier).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :LIN_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasItemDescription a owl:ObjectProperty ;\\n    rdfs:label \\\"has item description\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its IMD_Segment (item description).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :IMD_Segment .\\n\\n:hasAdditionalProductID a owl:ObjectProperty ;\\n    rdfs:label \\\"has additional product ID\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PIA_Segment (additional product IDs).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PIA_Segment .\\n\\n:hasPackaging a owl:ObjectProperty ;\\n    rdfs:label \\\"has packaging\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PAC_Segment (packaging).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PAC_Segment .\\n\\n:hasCurrency a owl:ObjectProperty ;\\n    rdfs:label \\\"has currency\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its CUX_Segment (currency details).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :CUX_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasTermsOfDelivery a owl:ObjectProperty ;\\n    rdfs:label \\\"has terms of delivery\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TOD_Segment (terms of delivery).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TOD_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasLocation a owl:ObjectProperty ;\\n    rdfs:label \\\"has location\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its LOC_Segment (location/logistics).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :LOC_Segment .\\n\\n:hasFreeText a owl:ObjectProperty ;\\n    rdfs:label \\\"has free text\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its FTX_Segment(s) (free text/legal notes).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :FTX_Segment .\\n\\n:hasFreeTextLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has free text line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its FTX_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :FTX_Segment .\\n\\n:hasReferenceLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its RFF_Segment(s) (line-level references).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :RFF_Segment .\\n\\n:hasDateLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has date line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its DTM_Segment(s) (line-level dates).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DTM_Segment .\\n\\n:hasAllowanceOrChargeLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has allowance or charge line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its ALC_Segment(s) (allowance/charge details).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :ALC_Segment .\\n\\n:hasPaymentTerms a owl:ObjectProperty ;\\n    rdfs:label \\\"has payment terms\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its PAT_Segment (payment terms).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :PAT_Segment ;\\n    owl:FunctionalProperty .\\n\\n:hasPercentageDetails a owl:ObjectProperty ;\\n    rdfs:label \\\"has percentage details\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its PCD_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :PCD_Segment .\\n\\n:hasTransportDetails a owl:ObjectProperty ;\\n    rdfs:label \\\"has transport details\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its TDT_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TDT_Segment .\\n\\n:hasMeasurement a owl:ObjectProperty ;\\n    rdfs:label \\\"has measurement\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its MEA_Segment(s).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :MEA_Segment .\\n\\n:hasPaymentTermsLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has payment terms line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PAT_Segment(s) (payment terms).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PAT_Segment .\\n\\n:hasPercentageDetailsLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has percentage details line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its PCD_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PCD_Segment .\\n\\n:hasTransportDetailsLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has transport details line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its TDT_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :TDT_Segment .\\n\\n:hasMeasurementLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has measurement line\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its MEA_Segment(s).\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :MEA_Segment .\\n\\n###################################################################\\n# DATA PROPERTIES\\n###################################################################\\n\\n:hasGLN a owl:DatatypeProperty ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Links an Identifier to its Global Location Number (GLN) as a string.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n###################################################################\\n# COMPLEX AXIOMS & RESTRICTIONS\\n###################################################################\\n\\n# Example: InvoiceSummary must have at least one total amount (MOA_Segment)\\n:InvoiceSummary rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasTotalAmount ;\\n    owl:someValuesFrom :MOA_Segment\\n] .\\n\\n# Example: LineItem must have at least one quantity (QTY_Segment)\\n:LineItem rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasQuantity ;\\n    owl:someValuesFrom :QTY_Segment\\n] .\\n\\n# Example: LineItem must have at least one net price (PRI_Segment)\\n:LineItem rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasNetPrice ;\\n    owl:someValuesFrom :PRI_Segment\\n] .\\n\\n# Example: InvoiceMessage must have a message header (UNH_Segment)\\n:InvoiceMessage rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasMessageHeader ;\\n    owl:someValuesFrom :UNH_Segment\\n] .\\n\\n# Example: ValidationConstraint for arithmetic consistency\\n:ValidationConstraint rdfs:comment \\\"Constraint: The sum of all LineItem net amounts (MOA_Segment) must equal the InvoiceSummary total amount (MOA_Segment).\\\" .\\n\\n###################################################################\\n# DISJOINTNESS\\n###################################################################\\n\\n:Organization owl:disjointWith :Address .\\n:Message owl:disjointWith :Segment .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n\\n###################################################################\\n# ANNOTATIONS (for all classes/properties above)\\n###################################################################\\n# (Already included inline for each class/property)\\n\"}",
        "name": "check_pitfalls_tool"
      },
      "type": "function"
    }
  ],
  "refusal": null
}
