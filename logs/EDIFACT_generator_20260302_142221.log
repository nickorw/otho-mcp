###################################\\n\\n[] a owl:AllDisjointClasses ;\\n    owl:members ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\\n\\n[] a owl:AllDisjointClasses ;\\n    owl:members ( :Organization :AgentRole :Address :LineItem :Item :Price :Tax :ReferenceNumber :BusinessProcess ) .\\n\\n#################################################################\\n# Pivot Class Reification\\n#################################################################\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified n-ary relationship linking an Organization to an AgentRole in the context of an Invoice Message.\\\" .\\n\\n:hasAgentRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has agent role\\\" ;\\n    rdfs:comment \\\"Links RoleAssignment to AgentRole.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:FunctionalProperty .\\n\\n:hasParticipant a owl:ObjectProperty ;\\n    rdfs:label \\\"has participant\\\" ;\\n    rdfs:comment \\\"Links RoleAssignment to Organization.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:FunctionalProperty .\\n\\n#################################################################\\n# Class Equivalence and Restrictions\\n#################################################################\\n\\n:BuyerRole a owl:Class ;\\n    rdfs:label \\\"Buyer Role\\\" ;\\n    rdfs:comment \\\"A role indicating buying party in the invoice.\\\" ;\\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:hasValue :Buyer ] .\\n\\n:InvoiceWithEN16931Alignment a owl:Class ;\\n    rdfs:label \\\"Invoice with EN 16931 Alignment\\\" ;\\n    rdfs:comment \\\"An Invoice Message aligned with EN 16931.\\\" ;\\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :alignedWithEN16931 ; owl:someValuesFrom :EN16931_Alignment ] .\"}",
