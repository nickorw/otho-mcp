      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A Invoice Ontology\" ;\n    rdfs:comment \"A profoundly structured OWL2 ontology for UN/EDIFACT D96A Invoice (INVOIC) messages, supporting EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message, a subclass of Message.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:DTM_Segment a owl:Class ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment. Contains qualifier and value.\" ;\n    rdfs:subClassOf :Segment .\n\n:MOA_Segment a owl:Class ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment. Contains qualifier and amount value.\" ;\n    rdfs:subClassOf :Segment .\n\n:RFF_Segment a owl:Class ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment for reference numbers.\" ;\n    rdfs:subClassOf :Segment .\n\n:LOC_Segment a owl:Class ;\n    rdfs:label \"LOC Segment\" ;\n    rdfs:comment \"Location segment for delivery or other locations.\" ;\n    rdfs:subClassOf :Segment .\n\n:LIN_Segment a owl:Class ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line Item segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:PRI_Segment a owl:Class ;\n    rdfs:label \"PRI Segment\" ;\n    rdfs:comment \"Price segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:QTY_Segment a owl:Class ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:TAX_Segment a owl:Class ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:CUX_Segment a owl:Class ;\n    rdfs:label \"CUX Segment\" ;\n    rdfs:comment \"Currency segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:UNS_Segment a owl:Class ;\n    rdfs:label \"UNS Segment\" ;\n    rdfs:comment \"Section control segment (header/detail/summary separator).\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice message.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice message.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice message.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A legal entity involved in the transaction.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization (e.g., Buyer, Supplier, Delivery Party).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An itemized entry in the invoice detail section.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or good referenced in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item or invoice.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax applied to the invoice or line item.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for the invoice or related documents.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process such as Purchase-to-Pay.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validation, e.g., SHACL shape.\" .\n\n:GLN_Identifier a owl:Class ;\n    rdfs:label \"GLN Identifier\" ;\n    rdfs:comment \"A Global Location Number identifier.\" .\n\n:EN16931_Alignment a owl:Class ;\n    rdfs:label \"EN 16931 Alignment\" ;\n    rdfs:comment \"Alignment to EN 16931-1 semantic model.\" .\n\n:P2PO_Alignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment to Purchase-to-Pay Ontology (P2P-O).\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A reified relationship linking an organization to a role in the invoice context.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n   