l:ObjectProperty ;\\n    rdfs:label \\\"has TAX segment\\\" ;\\n    rdfs:comment \\\"Links summary or line item to a TAX_Segment (tax info).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TAX_Segment .\\n\\n:hasCUX a owl:ObjectProperty ;\\n    rdfs:label \\\"has CUX segment\\\" ;\\n    rdfs:comment \\\"Links summary or line item to a CUX_Segment (currency info).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :CUX_Segment .\\n\\n:hasUNS a owl:ObjectProperty ;\\n    rdfs:label \\\"has UNS segment\\\" ;\\n    rdfs:comment \\\"Links summary to a UNS_Segment (section control).\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :UNS_Segment .\\n\\n#################################################################\\n# Data Properties (Qualifiers & Values)\\n#################################################################\\n\\n:dtmQualifier a owl:DatatypeProperty ;\\n    rdfs:label \\\"DTM qualifier\\\" ;\\n    rdfs:comment \\\"Qualifier code for DTM segment (e.g., 137=Document date).\\\" ;\\n    rdfs:domain :DTM_Segment ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:dtmValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"DTM value\\\" ;\\n    rdfs:comment \\\"Date/time value for DTM segment.\\\" ;\\n    rdfs:domain :DTM_Segment ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:moaQualifier a owl:DatatypeProperty ;\\n    rdfs:label \\\"MOA qualifier\\\" ;\\n    rdfs:comment \\\"Qualifier code for MOA segment (e.g., 9=Invoice amount).\\\" ;\\n    rdfs:domain :MOA_Segment ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:moaValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"MOA value\\\" ;\\n    rdfs:comment \\\"Monetary value for MOA segment.\\\" ;\\n    rdfs:domain :MOA_Segment ;\\n    rdfs:range xsd:decimal ;\\n    owl:FunctionalProperty .\\n\\n#################################################################\\n# Disjointness Axioms\\n###############################################