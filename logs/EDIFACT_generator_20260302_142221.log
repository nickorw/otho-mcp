      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#INVOIC-Ontology> a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A INVOIC Ontology\" ;\n    rdfs:comment \"A comprehensive OWL2 ontology for UN/EDIFACT D96A INVOIC messages, covering all mandatory segments, roles, and validation constraints for semantic interoperability and compliance with EN 16931-1.\" .\n\n###################################################################\n# CLASSES\n###################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"InterchangeEnvelope\" ;\n    rdfs:comment \"The outermost envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business message within the interchange envelope, e.g., INVOIC.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"InvoiceMessage\" ;\n    rdfs:comment \"The INVOIC message for global trade, subclass of Message.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment in an EDIFACT message, e.g., BGM, NAD, DTM, etc.\" .\n\n# Segment subclasses (renamed to CamelCase)\n:UNHSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"UNHSegment\" ; rdfs:comment \"Message header segment (UNH) for INVOIC.\" .\n:UNTSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"UNTSegment\" ; rdfs:comment \"Message trailer segment (UNT) for INVOIC.\" .\n:BGMSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"BGMSegment\" ; rdfs:comment \"Beginning of message segment (BGM).\" .\n:NADSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"NADSegment\" ; rdfs:comment \"Name and address segment (NAD) for parties and roles.\" .\n:DTMSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"DTMSegment\" ; rdfs:comment \"Date/time/period segment (DTM), e.g., invoice date, delivery date.\" .\n:MOASegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"MOASegment\" ; rdfs:comment \"Monetary amount segment (MOA), e.g., invoice total, line totals.\" .\n:QTYSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"QTYSegment\" ; rdfs:comment \"Quantity segment (QTY), e.g., item quantity.\" .\n:PRISegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PRISegment\" ; rdfs:comment \"Price segment (PRI), e.g., net price per item.\" .\n:TAXSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"TAXSegment\" ; rdfs:comment \"Tax segment (TAX), e.g., VAT details.\" .\n:RFFSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"RFFSegment\" ; rdfs:comment \"Reference segment (RFF), e.g., invoice number, order reference.\" .\n:ALCSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"ALCSegment\" ; rdfs:comment \"Allowance/charge segment (ALC) for discounts, surcharges.\" .\n:LINSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"LINSegment\" ; rdfs:comment \"Line item identifier segment (LIN).\" .\n:IMDSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"IMDSegment\" ; rdfs:comment \"Item description segment (IMD).\" .\n:PIASegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PIASegment\" ; rdfs:comment \"Additional product ID segment (PIA).\" .\n:PACSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PACSegment\" ; rdfs:comment \"Packaging segment (PAC).\" .\n:CUXSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"CUXSegment\" ; rdfs:comment \"Currency segment (CUX) for currency details.\" .\n:TODSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"TODSegment\" ; rdfs:comment \"Terms of delivery segment (TOD).\" .\n:LOCSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"LOCSegment\" ; rdfs:comment \"Location segment (LOC) for logistics.\" .\n:FTXSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"FTXSegment\" ; rdfs:comment \"Free text segment (FTX) for invoice notes and legal text.\" .\n:PATSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PATSegment\" ; rdfs:comment \"Payment terms segment (PAT) for due dates, terms, penalties.\" .\n:PCDSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PCDSegment\" ; rdfs:comment \"Percentage details segment (PCD) for discounts, surcharges.\" .\n:TDTSegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"TDTSegment\" ; rdfs:comment \"Transport details segment (TDT) for shipping/transport.\" .\n:MEASegment a owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"MEASegment\" ; rdfs:comment \"Measurement segment (MEA) for weights, dimensions.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"CompositeDataElement\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"SimpleDataElement\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"InvoiceHeader\" ;\n    rdfs:comment \"Header section of the invoice, containing document dates and references.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"InvoiceDetail\" ;\n    rdfs:comment \"Detail section listing individual line items.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"InvoiceSummary\" ;\n    rdfs:comment \"Summary section providing totals, taxes, and payment terms.\" .\n\n:LineItem a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"LineItem\" ;\n    rdfs:comment \"Pivot class for line-level reification (item, price, quantity, etc.).\" ;\n    rdfs:seeAlso :Price, :Tax .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A business entity involved in the invoice (buyer, supplier, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"AgentRole\" ;\n    rdfs:comment \"A role that an organization plays in the invoice (buyer, delivery party, etc.).\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"RoleAssignment\" ;\n    rdfs:comment \"Pivot class for reifying the assignment of a role to an organization within a message context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in the invoice.\" ;\n    rdfs:seeAlso :LineItem .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A monetary price, e.g., for an item or invoice total.\" ;\n    rdfs:seeAlso :LineItem .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax entity, e.g., VAT.\" ;\n    rdfs:seeAlso :LineItem .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier such as Global Location Number (GLN).\" ;\n    rdfs:seeAlso :Organization .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"BusinessProcess\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" ;\n    rdfs:seeAlso :InvoiceMessage .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"ValidationConstraint\" ;\n    rdfs:comment \"A SHACL or OWL-based validation constraint for the invoice.\" ;\n    rdfs:seeAlso :InvoiceMessage .\n\n###################################################################\n# OBJECT PROPERTIES\n###################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"containsMessage\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message(s).\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"isContainedInEnvelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope .\n\n:containsMessage owl:inverseOf :isContainedInEnvelope .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"hasSegment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"isSegmentOf\" ;\n    rdfs:comment \"Inverse of hasSegment.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message .\n\n:hasSegment owl:inverseOf :isSegmentOf .\n\n# ... (repeat for all major properties, adding owl:inverseOf as a triple after both property blocks)\n\n###################################################################\n# DISJOINTNESS\n###################################################################\n\n:Organization owl:disjointWith :Address .\n:Message owl:disjointWith :Segment .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n:Price owl:disjointWith :Tax .\n:Item owl:disjointWith :Tax .\n:Organization owl:disjointWith :BusinessProcess .\n\n###################################################################\n# ANNOTATIONS (for all classes/properties above)\n###################################################################\n# (Already included inline for each class/property)\n"
}
