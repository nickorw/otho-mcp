fs:comment \"A region containing cities.\" .\n:Country rdf:type owl:Class ; rdfs:label \"Country\" ; rdfs:comment \"A country containing regions.\" .\n# Pivot Classes\n:BandMembership rdf:type owl:Class ; rdfs:label \"Band Membership\" ; rdfs:comment \"A person's membership in a band over time.\" .\n:BandRoleAssignment rdf:type owl:Class ; rdfs:label \"Band Role Assignment\" ; rdfs:comment \"A person's role in a band over a time period.\" .\n:AlbumRecording rdf:type owl:Class ; rdfs:label \"Album Recording\" ; rdfs:comment \"The recording process of an album by a band.\" .\n:TrackInAlbum rdf:type owl:Class ; rdfs:label \"Track In Album\" ; rdfs:comment \"A track's inclusion in an album, with its number.\" .\n:SongComposition rdf:type owl:Class ; rdfs:label \"Song Composition\" ; rdfs:comment \"The composition event of a song.\" .\n:PerformanceSong rdf:type owl:Class ; rdfs:label \"Performance Song\" ; rdfs:comment \"A song performed in a specific performance.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n:playsInstrument rdf:type owl:ObjectProperty ; rdfs:label \"plays instrument\" ; rdfs:comment \"Relates a person to an instrument they play.\" ; rdfs:domain :Person ; rdfs:range :Instrument .\n:hasBandMembership rdf:type owl:ObjectProperty ; rdfs:label \"has band membership\" ; rdfs:comment \"Relates a person to their band membership.\" ; rdfs:domain :Person ; rdfs:range :BandMembership .\n:memberOfBand rdf:type owl:ObjectProperty ; rdfs:label \"member of band\" ; rdfs:comment \"Relates a band membership to a band.\" ; rdfs:domain :BandMembership ; rdfs:range :Band .\n:hasRoleAssignment rdf:type owl:ObjectProperty ; rdfs:label \"has role assignment\" ; rdfs:comment \"Relates a person to a role assignment in a band.\" ; rdfs:domain :Person ; rdfs:range :BandRoleAssignment .\n:roleInBand rdf:type owl:ObjectProperty ; rdfs:label \"role in band\" ; rdfs:comment \"Relates a role assignment to a role.\" ; rdfs:domain :BandRoleAssignment ; rdfs:range :Role .\n:roleBand rdf:type owl:ObjectProperty ; rdfs:label \"role band\" ; rdfs:comment \"Relates a role assignment to a band.\" ; rdfs:domain :BandRoleAssignment ; rdfs:range :Band .\n:recordedAlbum rdf:type owl:ObjectProperty ; rdfs:label \"recorded album\" ; rdfs:comment \"Relates a band to an album recording.\" ; rdfs:domain :Band ; rdfs:range :AlbumRecording .\n:albumRecorded rdf:type owl:ObjectProperty ; rdfs:label \"album recorded\" ; rdfs:comment \"Relates an album recording to the album.\" ; rdfs:domain :AlbumRecording ; rdfs:range :Album .\n:hasTrackInAlbum rdf:type owl:ObjectProperty ; rdfs:label \"has track in album\" ; rdfs:comment \"Relates an album to its tracks-in-album.\" ; rdfs:domain :Album ; rdfs:range :TrackInAlbum .\n:trackOfAlbum rdf:type owl:ObjectProperty ; rdfs:label \"track of album\" ; rdfs:comment \"Relates a track-in-album to the track.\" ; rdfs:domain :TrackInAlbum ; rdfs:range :Track .\n:recordingOfSong rdf:type owl:ObjectProperty ; rdfs:label \"recording of song\" ; rdfs:comment \"Relates a track to the song it records.\" ; rdfs:domain :Track ; rdfs:range :Song .\n:hasSongComposition rdf:type owl:ObjectProperty ; rdfs:label \"has song composition\" ; rdfs:comment \"Relates a song to its composition event.\" ; rdfs:domain :Song ; rdfs:range :SongComposition .\n:hasCritique rdf:type owl:ObjectProperty ; rdfs:label \"has critique\" ; rdfs:comment \"Relates an album to a critique.\" ; rdfs:domain :Album ; rdfs:range :Critique .\n:critiqueBy rdf:type owl:ObjectProperty ; rdfs:label \"critique by\" ; rdfs:comment \"Relates a critique to its critic.\" ; rdfs:domain :Critique ; rdfs:range :Critic .\n:hasPerformance rdf:type owl:ObjectProperty ; rdfs:label \"has performance\" ; rdfs:comment \"Relates a band to a performance.\" ; rdfs:domain :Band ; rdfs:range :Performance .\n:performanceLocation rdf:type owl:ObjectProperty ; rdfs:label \"performance location\" ; rdfs:comment \"Relates a performance to the city where it occurred.\" ; rdfs:domain :Performance ; rdfs:range :City .\n:performedSong rdf:type owl:ObjectProperty ; rdfs:label \"performed song\" ; rdfs:comment \"Relates a performance song to the song performed.\" ; rdfs:domain :PerformanceSong ; rdfs:range :Song .\n:songPerformance rdf:type owl:ObjectProperty ; rdfs:label \"song performance\" ; rdfs:comment \"Relates a performance to a performance-song instance.\" ; rdfs:domain :Performance ; rdfs:range :PerformanceSong .\n:cityInRegion rdf:type owl:ObjectProperty ; rdfs:label \"city in region\" ; rdfs:comment \"Relates a city to its region.\" ; rdfs:domain :City ; rdfs:range :Region .\n:regionInCountry rdf:type owl:ObjectProperty ; rdfs:label \"region in country\" ; rdfs:comment \"Relates a region to its country.\" ; rdfs:domain :Region ; rdfs:range :Country .\n\n# Property Characteristics\n:playsInstrument rdf:type owl:FunctionalProperty .\n:hasBandMembership rdf:type owl:FunctionalProperty .\n:hasRoleAssignment rdf:type owl:FunctionalProperty .\n:recordedAlbum rdf:type owl:FunctionalProperty .\n:recordingOfSong rdf:type owl:FunctionalProperty .\n:critiqueBy rdf:type owl:FunctionalProperty .\n:performanceLocation rdf:type owl:FunctionalProperty .\n:cityInRegion rdf:type owl:FunctionalProperty .\n:regionInCountry rdf:type owl:FunctionalProperty .\n:trackNumber rdf:type owl:FunctionalProperty .\n:compositionDate rdf:type owl:FunctionalProperty .\n:critiqueContent rdf:type owl:FunctionalProperty .\n:performanceDate rdf:type owl:FunctionalProperty .\n\n#################################################################\n# Data Properties\n#################################################################\n:membershipStart rdf:type owl:DatatypeProperty ; rdfs:label \"membership start\" ; rdfs:comment \"Start date of a band membership.\" ; rdfs:domain :BandMembership ; rdfs:range xsd:date .\n:membershipEnd rdf:type owl:DatatypeProperty ; rdfs:label \"membership end\" ; rdfs:comment \"End date of a band membership.\" ; rdfs:domain :BandMembership ; rdfs:range xsd:date .\n:roleStart rdf:type owl:DatatypeProperty ; rdfs:label \"role start\" ; rdfs:comment \"Start date of a role assignment.\" ; rdfs:domain :BandRoleAssignment ; rdfs:range xsd:date .\n:roleEnd rdf:type owl:DatatypeProperty ; rdfs:label \"role end\" ; rdfs:comment \"End date of a role assignment.\" ; rdfs:domain :BandRoleAssignment ; rdfs:range xsd:date .\n:recordingStart rdf:type owl:DatatypeProperty ; rdfs:label \"recording start\" ; rdfs:comment \"Start date of an album recording.\" ; rdfs:domain :AlbumRecording ; rdfs:range xsd:date .\n:recordingEnd rdf:type owl:DatatypeProperty ; rdfs:label \"recording end\" ; rdfs:comment \"End date of an album recording.\" ; rdfs:domain :AlbumRecording ; rdfs:range xsd:date .\n:trackNumber rdf:type owl:DatatypeProperty ; rdfs:label \"track number\" ; rdfs:comment \"The number of a track in an album.\" ; rdfs:domain :TrackInAlbum ; rdfs:range xsd:integer .\n:compositionDate rdf:type owl:DatatypeProperty ; rdfs:label \"composition date\" ; rdfs:comment \"The date a song was composed.\" ; rdfs:domain :SongComposition ; rdfs:range xsd:date .\n:critiqueContent rdf:type owl:DatatypeProperty ; rdfs:label \"critique content\" ; rdfs:comment \"The content of a critique.\" ; rdfs:domain :Critique ; rdfs:range xsd:string .\n:performanceDate rdf:type owl:DatatypeProperty ; rdfs:label \"performance date\" ; rdfs:comment \"The date a performance took place.\" ; rdfs:domain :Performance ; rdfs:range xsd:date .\n\n#################################################################\n# Class Disjointness\n#################################################################\n:Person owl:disjointWith :Band .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Track .\n:Song owl:disjointWith :Track .\n:Critic owl:disjointWith :Band .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n\n#################################################################\n# General Class Axioms and Restrictions\n#################################################################\n:Album owl:equivalentClass [ rdf:type owl:Class ; owl:onProperty :hasTrackInAlbum ; owl:someValuesFrom :TrackInAlbum ] ; rdfs:label \"Album with tracks\" ; rdfs:comment \"An album always contains at least one track.\" .\n"
}
