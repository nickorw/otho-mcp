        "arguments": "{\"owl_content\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:Band a owl:Class ;\\n  rdfs:label \\\"Band\\\" ;\\n  rdfs:comment \\\"A musical group consisting of members.\\\" ;\\n  owl:disjointWith :Person, :Instrument, :Role, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n\\n:Person a owl:Class ;\\n  rdfs:label \\\"Person\\\" ;\\n  rdfs:comment \\\"A human individual, such as a musician or critic.\\\" ;\\n  owl:disjointWith :Instrument, :Role, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n\\n:Instrument a owl:Class ;\\n  rdfs:label \\\"Instrument\\\" ;\\n  rdfs:comment \\\"A musical instrument played by a person.\\\" ;\\n  owl:disjointWith :Role, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n\\n:Role a owl:Class ;\\n  rdfs:label \\\"Role\\\" ;\\n  rdfs:comment \\\"A musical or functional role within a band (e.g., vocalist, drummer).\\\" ;\\n  owl:disjointWith :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n\\n:Album a owl:Class ;\\n  rdfs:label \\\"Album\\\" ;\\n  rdfs:comment \\\"A collection of recorded music tracks.\\\" ;\\n  owl:disjointWith :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n\\n:Track a owl:Class ;\\n  rdfs:label \\\"Track\\\" ;\\n  rdfs:comment \\\"A single recording on an album.\\\" ;\\n  owl:disjointWith :Song, :Critic, :Performance, :City, :Region, :Country .\\n\\n:Song a owl:Class ;\\n  rdfs:label \\\"Song\\\" ;\\n  rdfs:comment \\\"A musical composition.\\\" ;\\n  owl:disjointWith :Critic, :Performance, :City, :Region, :Country .\\n\\n:Critic a owl:Class ;\\n  rdfs:label \\\"Critic\\\" ;\\n  rdfs:comment \\\"A person who reviews music albums.\\\" ;\\n  owl:disjointWith :Performance, :City, :Region, :Country .\\n\\n:Performance a owl:Class ;\\n  rdfs:label \\\"Performance\\\" ;\\n  rdfs:comment \\\"A live musical event.\\\" ;\\n  owl:disjointWith :City, :Region, :Country .\\n\\n:City a owl:Class ;\\n  rdfs:label \\\"City\\\" ;\\n  rdfs:comment \\\"A city where performances take place.\\\" ;\\n  owl:disjointWith :Region, :Country .\\n\\n:Region a owl:Class ;\\n  rdfs:label \\\"Region\\\" ;\\n  rdfs:comment \\\"A geographic region containing cities.\\\" ;\\n  owl:disjointWith :Country .\\n\\n:Country a owl:Class ;\\n  rdfs:label \\\"Country\\\" ;\\n  rdfs:comment \\\"A country containing regions.\\\" .\\n\\n#################################################################\\n# Pivot Classes (Reification)\\n#################################################################\\n\\n:UserBandMembership a owl:Class ;\\n  rdfs:label \\\"User Band Membership\\\" ;\\n  rdfs:comment \\\"The membership of a person in a band at a certain time.\\\" .\\n\\n:UserRoleAssignment a owl:Class ;\\n  rdfs:label \\\"User Role Assignment\\\" ;\\n  rdfs:comment \\\"The assignment of a role to a person in a band at a certain time.\\\" .\\n\\n:AlbumRecordingPeriod a owl:Class ;\\n  rdfs:label \\\"Album Recording Period\\\" ;\\n  rdfs:comment \\\"The period during which an album was recorded.\\\" .\\n\\n:AlbumRelease a owl:Class ;\\n  rdfs:label \\\"Album Release\\\" ;\\n  rdfs:comment \\\"The release event for an album, with a release date.\\\" .\\n\\n:TrackSongAssociation a owl:Class ;\\n  rdfs:label \\\"Track Song Association\\\" ;\\n  rdfs:comment \\\"Association between a track and the song it records.\\\" .\\n\\n:SongComposition a owl:Class ;\\n  rdfs:label \\\"Song Composition\\\" ;\\n  rdfs:comment \\\"The event of a song being composed at a certain date.\\\" .\\n\\n:CriticReview a owl:Class ;\\n  rdfs:label \\\"Critic Review\\\" ;\\n  rdfs:comment \\\"A review of an album by a critic.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n  rdfs:label \\\"Performance Song\\\" ;\\n  rdfs:comment \\\"The association of a song performed at a performance.\\\" .\\n\\n:PerformanceLocation a owl:Class ;\\n  rdfs:label \\\"Performance Location\\\" ;\\n  rdfs:comment \\\"The association of a performance with its city location.\\\" .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n\\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"plays instrument\\\" ;\\n  rdfs:comment \\\"The instrument played by a person.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :Instrument ;\\n  owl:inverseOf :isPlayedBy .\\n\\n:isPlayedBy a owl:ObjectProperty ;\\n  rdfs:label \\\"is played by\\\" ;\\n  rdfs:comment \\\"Inverse of playsInstrument: links an instrument to the person who plays it.\\\" ;\\n  rdfs:domain :Instrument ;\\n  rdfs:range :Person .\\n\\n:hasMember a owl:ObjectProperty ;\\n  rdfs:label \\\"has member\\\" ;\\n  rdfs:comment \\\"Links a band to a membership event.\\\" ;\\n  rdfs:domain :Band ;\\n  rdfs:range :UserBandMembership ;\\n  owl:inverseOf :memberOfBand .\\n\\n:memberOfBand a owl:ObjectProperty ;\\n  rdfs:label \\\"member of band\\\" ;\\n  rdfs:comment \\\"Inverse of hasMember: links a membership event to a band.\\\" ;\\n  rdfs:domain :UserBandMembership ;\\n  rdfs:range :Band .\\n\\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"member person\\\" ;\\n  rdfs:comment \\\"The person involved in a band membership.\\\" ;\\n  rdfs:domain :UserBandMembership ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :hasBandMembership .\\n\\n:hasBandMembership a owl:ObjectProperty ;\\n  rdfs:label \\\"has band membership\\\" ;\\n  rdfs:comment \\\"Inverse of memberPerson: links a person to their band memberships.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :UserBandMembership .\\n\\n:membershipStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"membership start\\\" ;\\n  rdfs:comment \\\"Start date of a band membership.\\\" ;\\n  rdfs:domain :UserBandMembership ;\\n  rdfs:range xsd:date .\\n\\n:membershipEnd a owl:DatatypeProperty ;\\n  rdfs:label \\\"membership end\\\" ;\\n  rdfs:comment \\\"End date of a band membership.\\\" ;\\n  rdfs:domain :UserBandMembership ;\\n  rdfs:range xsd:date .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n  rdfs:label \\\"has role assignment\\\" ;\\n  rdfs:comment \\\"Links a band to a role assignment event.\\\" ;\\n  rdfs:domain :Band ;\\n  rdfs:range :UserRoleAssignment ;\\n  owl:inverseOf :roleAssignmentOfBand .\\n\\n:roleAssignmentOfBand a owl:ObjectProperty ;\\n  rdfs:label \\\"role assignment of band\\\" ;\\n  rdfs:comment \\\"Inverse of hasRoleAssignment: links a role assignment to the band.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range :Band .\\n\\n:assignedPerson a owl:ObjectProperty ;\\n  rdfs:label \\\"assigned person\\\" ;\\n  rdfs:comment \\\"The person assigned to a role.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :hasRoleAssignmentEvent .\\n\\n:hasRoleAssignmentEvent a owl:ObjectProperty ;\\n  rdfs:label \\\"has role assignment event\\\" ;\\n  rdfs:comment \\\"Inverse of assignedPerson: links a person to their role assignments.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :UserRoleAssignment .\\n\\n:assignedRole a owl:ObjectProperty ;\\n  rdfs:label \\\"assigned role\\\" ;\\n  rdfs:comment \\\"The role assigned to a person in a band.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range :Role ;\\n  owl:inverseOf :roleAssignment .\\n\\n:roleAssignment a owl:ObjectProperty ;\\n  rdfs:label \\\"role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of assignedRole: links a role to its assignments.\\\" ;\\n  rdfs:domain :Role ;\\n  rdfs:range :UserRoleAssignment .\\n\\n:roleAssignmentStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"role assignment start\\\" ;\\n  rdfs:comment \\\"Start date of a role assignment.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range xsd:date .\\n\\n:roleAssignmentEnd a owl:DatatypeProperty ;\\n  rdfs:label \\\"role assignment end\\\" ;\\n  rdfs:comment \\\"End date of a role assignment.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range xsd:date .\\n\\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"recorded album\\\" ;\\n  rdfs:comment \\\"The album recorded during a recording period.\\\" ;\\n  rdfs:domain :AlbumRecordingPeriod ;\\n  rdfs:range :Album ;\\n  owl:inverseOf :hasRecordingPeriod .\\n\\n:hasRecordingPeriod a owl:ObjectProperty ;\\n  rdfs:label \\\"has recording period\\\" ;\\n  rdfs:comment \\\"Inverse of recordedAlbum: links an album to its recording periods.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :AlbumRecordingPeriod .\\n\\n:recordingStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"recording start\\\" ;\\n  rdfs:comment \\\"Start date of album recording.\\\" ;\\n  rdfs:domain :AlbumRecordingPeriod ;\\n  rdfs:range xsd:date .\\n\\n:recordingEnd a owl:DatatypeProperty ;\\n  rdfs:label \\\"recording end\\\" ;\\n  rdfs:comment \\\"End date of album recording.\\\" ;\\n  rdfs:domain :AlbumRecordingPeriod ;\\n  rdfs:range xsd:date .\\n\\n:albumHasTrack a owl:ObjectProperty ;\\n  rdfs:label \\\"album has track\\\" ;\\n  rdfs:comment \\\"Links an album to its tracks.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :Track ;\\n  owl:inverseOf :trackOnAlbum .\\n\\n:trackOnAlbum a owl:ObjectProperty ;\\n  rdfs:label \\\"track on album\\\" ;\\n  rdfs:comment \\\"Inverse of albumHasTrack: links a track to its album.\\\" ;\\n  rdfs:domain :Track ;\\n  rdfs:range :Album .\\n\\n:trackSongAssociation a owl:ObjectProperty ;\\n  rdfs:label \\\"track song association\\\" ;\\n  rdfs:comment \\\"Links a track-song association to a track.\\\" ;\\n  rdfs:domain :TrackSongAssociation ;\\n  rdfs:range :Track ;\\n  owl:inverseOf :hasTrackSongAssociation .\\n\\n:hasTrackSongAssociation a owl:ObjectProperty ;\\n  rdfs:label \\\"has track song association\\\" ;\\n  rdfs:comment \\\"Inverse of trackSongAssociation: links a track to its track-song associations.\\\" ;\\n  rdfs:domain :Track ;\\n  rdfs:range :TrackSongAssociation .\\n\\n:associatedSong a owl:ObjectProperty ;\\n  rdfs:label \\\"associated song\\\" ;\\n  rdfs:comment \\\"Links a track-song association to a song.\\\" ;\\n  rdfs:domain :TrackSongAssociation ;\\n  rdfs:range :Song ;\\n  owl:inverseOf :trackSongAssociationOfSong .\\n\\n:trackSongAssociationOfSong a owl:ObjectProperty ;\\n  rdfs:label \\\"track song association of song\\\" ;\\n  rdfs:comment \\\"Inverse of associatedSong: links a song to its track-song associations.\\\" ;\\n  rdfs:domain :Song ;\\n  rdfs:range :TrackSongAssociation .\\n\\n:songComposedOn a owl:DatatypeProperty ;\\n  rdfs:label \\\"song composed on\\\" ;\\n  rdfs:comment \\\"Date a song was composed.\\\" ;\\n  rdfs:domain :SongComposition ;\\n  rdfs:range xsd:date .\\n\\n:composedSong a owl:ObjectProperty ;\\n  rdfs:label \\\"composed song\\\" ;\\n  rdfs:comment \\\"The song that was composed.\\\" ;\\n  rdfs:domain :SongComposition ;\\n  rdfs:range :Song ;\\n  owl:inverseOf :hasCompositionEvent .\\n\\n:hasCompositionEvent a owl:ObjectProperty ;\\n  rdfs:label \\\"has composition event\\\" ;\\n  rdfs:comment \\\"Inverse of composedSong: links a song to its composition events.\\\" ;\\n  rdfs:domain :Song ;\\n  rdfs:range :SongComposition .\\n\\n:criticReviewAbout a owl:ObjectProperty ;\\n  rdfs:label \\\"critic review about\\\" ;\\n  rdfs:comment \\\"The album reviewed in a critic review.\\\" ;\\n  rdfs:domain :CriticReview ;\\n  rdfs:range :Album ;\\n  owl:inverseOf :hasCriticReview .\\n\\n:hasCriticReview a owl:ObjectProperty ;\\n  rdfs:label \\\"has critic review\\\" ;\\n  rdfs:comment \\\"Inverse of criticReviewAbout: links an album to its critic reviews.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :CriticReview .\\n\\n:reviewedBy a owl:ObjectProperty ;\\n  rdfs:label \\\"reviewed by\\\" ;\\n  rdfs:comment \\\"The critic who wrote a review.\\\" ;\\n  rdfs:domain :CriticReview ;\\n  rdfs:range :Critic ;\\n  owl:inverseOf :wroteReview .\\n\\n:wroteReview a owl:ObjectProperty ;\\n  rdfs:label \\\"wrote review\\\" ;\\n  rdfs:comment \\\"Inverse of reviewedBy: links a critic to reviews they wrote.\\\" ;\\n  rdfs:domain :Critic ;\\n  rdfs:range :CriticReview .\\n\\n:reviewText a owl:DatatypeProperty ;\\n  rdfs:label \\\"review text\\\" ;\\n  rdfs:comment \\\"The text of a critic's review.\\\" ;\\n  rdfs:domain :CriticReview ;\\n  rdfs:range xsd:string .\\n\\n:performanceOfAlbum a owl:ObjectProperty ;\\n  rdfs:label \\\"performance of album\\\" ;\\n  rdfs:comment \\\"The album featured in a performance.\\\" ;\\n  rdfs:domain :Performance ;\\n  rdfs:range :Album ;\\n  owl:inverseOf :performedAt .\\n\\n:performedAt a owl:ObjectProperty ;\\n  rdfs:label \\\"performed at\\\" ;\\n  rdfs:comment \\\"Inverse of performanceOfAlbum: links an album to performances.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :Performance .\\n\\n:performanceDate a owl:DatatypeProperty ;\\n  rdfs:label \\\"performance date\\\" ;\\n  rdfs:comment \\\"Date of a performance.\\\" ;\\n  rdfs:domain :Performance ;\\n  rdfs:range xsd:date .\\n\\n:performanceSong a owl:ObjectProperty ;\\n  rdfs:label \\\"performance song\\\" ;\\n  rdfs:comment \\\"The song performed in a performance.\\\" ;\\n  rdfs:domain :PerformanceSong ;\\n  rdfs:range :Song ;\\n  owl:inverseOf :songPerformedAt .\\n\\n:songPerformedAt a owl:ObjectProperty ;\\n  rdfs:label \\\"song performed at\\\" ;\\n  rdfs:comment \\\"Inverse of performanceSong: links a song to performance song events.\\\" ;\\n  rdfs:domain :Song ;\\n  rdfs:range :PerformanceSong .\\n\\n:performanceSongPerformedAt a owl:ObjectProperty ;\\n  rdfs:label \\\"performance song performed at\\\" ;\\n  rdfs:comment \\\"The performance at which a song was performed.\\\" ;\\n  rdfs:domain :PerformanceSong ;\\n  rdfs:range :Performance ;\\n  owl:inverseOf :hasPerformanceSong .\\n\\n:hasPerformanceSong a owl:ObjectProperty ;\\n  rdfs:label \\\"has performance song\\\" ;\\n  rdfs:comment \\\"Inverse of performanceSongPerformedAt: links a performance to its performance song events.\\\" ;\\n  rdfs:domain :Performance ;\\n  rdfs:range :PerformanceSong .\\n\\n:performanceLocation a owl:ObjectProperty ;\\n  rdfs:label \\\"performance location\\\" ;\\n  rdfs:comment \\\"The city where a performance took place.\\\" ;\\n  rdfs:domain :PerformanceLocation ;\\n  rdfs:range :City ;\\n  owl:inverseOf :locationOfPerformance .\\n\\n:locationOfPerformance a owl:ObjectProperty ;\\n  rdfs:label \\\"location of performance\\\" ;\\n  rdfs:comment \\\"Inverse of performanceLocation: links a city to performance locations.\\\" ;\\n  rdfs:domain :City ;\\n  rdfs:range :PerformanceLocation .\\n\\n:performanceLocationFor a owl:ObjectProperty ;\\n  rdfs:label \\\"performance location for\\\" ;\\n  rdfs:comment \\\"The performance that took place at a location.\\\" ;\\n  rdfs:domain :PerformanceLocation ;\\n  rdfs:range :Performance ;\\n  owl:inverseOf :hasPerformanceLocation .\\n\\n:hasPerformanceLocation a owl:ObjectProperty ;\\n  rdfs:label \\\"has performance location\\\" ;\\n  rdfs:comment \\\"Inverse of performanceLocationFor: links a performance to its location associations.\\\" ;\\n  rdfs:domain :Performance ;\\n  rdfs:range :PerformanceLocation .\\n\\n:cityInRegion a owl:ObjectProperty ;\\n  rdfs:label \\\"city in region\\\" ;\\n  rdfs:comment \\\"The region containing a city.\\\" ;\\n  rdfs:domain :City ;\\n  rdfs:range :Region ;\\n  owl:inverseOf :regionHasCity .\\n\\n:regionHasCity a owl:ObjectProperty ;\\n  rdfs:label \\\"region has city\\\" ;\\n  rdfs:comment \\\"Inverse of cityInRegion: links a region to its cities.\\\" ;\\n  rdfs:domain :Region ;\\n  rdfs:range :City .\\n\\n:regionInCountry a owl:ObjectProperty ;\\n  rdfs:label \\\"region in country\\\" ;\\n  rdfs:comment \\\"The country containing a region.\\\" ;\\n  rdfs:domain :Region ;\\n  rdfs:range :Country ;\\n  owl:inverseOf :countryHasRegion .\\n\\n:countryHasRegion a owl:ObjectProperty ;\\n  rdfs:label \\\"country has region\\\" ;\\n  rdfs:comment \\\"Inverse of regionInCountry: links a country to its regions.\\\" ;\\n  rdfs:domain :Country ;\\n  rdfs:range :Region .\\n\\n#################################################################\\n# AlbumRelease connection and properties\\n#################################################################\\n\\n:releasedAlbum a owl:ObjectProperty ;\\n  rdfs:label \\\"released album\\\" ;\\n  rdfs:comment \\\"Connects AlbumRelease event to the Album released.\\\" ;\\n  rdfs:domain :AlbumRelease ;\\n  rdfs:range :Album ;\\n  owl:inverseOf :hasReleaseEvent .\\n\\n:hasReleaseEvent a owl:ObjectProperty ;\\n  rdfs:label \\\"has release event\\\" ;\\n  rdfs:comment \\\"Inverse of releasedAlbum: links an Album to its AlbumRelease event.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :AlbumRelease .\\n\\n:releaseDate a owl:DatatypeProperty ;\\n  rdfs:label \\\"release date\\\" ;\\n  rdfs:comment \\\"Date the album was released.\\\" ;\\n  rdfs:domain :AlbumRelease ;\\n  rdfs:range xsd:date .\\n\\n#################################################################\\n# Restrictions & Advanced Axioms\\n#################################################################\\n\\n:Album rdfs:subClassOf [\\n  a owl:Restriction ;\\n  owl:onProperty :albumHasTrack ;\\n  owl:someValuesFrom :Track\\n] .\\n\\n# Album must have at least one track (CQ 15)\\n\\n#################################################################\\n# End of Ontology\\n#################################################################\\n\"}",
