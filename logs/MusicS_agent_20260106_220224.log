d memberships.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :UserBandMembership .\\n\\n:membershipStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"membership start\\\" ;\\n  rdfs:comment \\\"Start date of a band membership.\\\" ;\\n  rdfs:domain :UserBandMembership ;\\n  rdfs:range xsd:date .\\n\\n:membershipEnd a owl:DatatypeProperty ;\\n  rdfs:label \\\"membership end\\\" ;\\n  rdfs:comment \\\"End date of a band membership.\\\" ;\\n  rdfs:domain :UserBandMembership ;\\n  rdfs:range xsd:date .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n  rdfs:label \\\"has role assignment\\\" ;\\n  rdfs:comment \\\"Links a band to a role assignment event.\\\" ;\\n  rdfs:domain :Band ;\\n  rdfs:range :UserRoleAssignment ;\\n  owl:inverseOf :roleAssignmentOfBand .\\n\\n:roleAssignmentOfBand a owl:ObjectProperty ;\\n  rdfs:label \\\"role assignment of band\\\" ;\\n  rdfs:comment \\\"Inverse of hasRoleAssignment: links a role assignment to the band.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range :Band .\\n\\n:assignedPerson a owl:ObjectProperty ;\\n  rdfs:label \\\"assigned person\\\" ;\\n  rdfs:comment \\\"The person assigned to a role.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :hasRoleAssignmentEvent .\\n\\n:hasRoleAssignmentEvent a owl:ObjectProperty ;\\n  rdfs:label \\\"has role assignment event\\\" ;\\n  rdfs:comment \\\"Inverse of assignedPerson: links a person to their role assignments.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :UserRoleAssignment .\\n\\n:assignedRole a owl:ObjectProperty ;\\n  rdfs:label \\\"assigned role\\\" ;\\n  rdfs:comment \\\"The role assigned to a person in a band.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range :Role ;\\n  owl:inverseOf :roleAssignment .\\n\\n:roleAssignment a owl:ObjectProperty ;\\n  rdfs:label \\\"role assignment\\\" ;\\n  rdfs:comment \\\"Inverse of assignedRole: links a role to its assignments.\\\" ;\\n  rdfs:domain :Role ;\\n  rdfs:range :UserRoleAssignment .\\n\\n:roleAssignmentStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"role assignment start\\\" ;\\n  rdfs:comment \\\"Start date of a role assignment.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range xsd:date .\\n\\n:roleAssignmentEnd a owl:DatatypeProperty ;\\n  rdfs:label \\\"role assignment end\\\" ;\\n  rdfs:comment \\\"End date of a role assignment.\\\" ;\\n  rdfs:domain :UserRoleAssignment ;\\n  rdfs:range xsd:date .\\n\\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"recorded album\\\" ;\\n  rdfs:comment \\\"The album recorded during a recording period.\\\" ;\\n  rdfs:domain :AlbumRecordingPeriod ;\\n  rdfs:range :Album ;\\n  owl:inverseOf :hasRecordingPeriod .\\n\\n:hasRecordingPeriod a owl:ObjectProperty ;\\n  rdfs:label \\\"has recording period\\\" ;\\n  rdfs:comment \\\"Inverse of recordedAlbum: links an album to its recording periods.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :AlbumRecordingPeriod .\\n\\n:recordingStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"recording start\\\" ;\\n  rdfs:comment \\\"Start date of album recording.\\\" ;\\n  rdfs:domain :AlbumRecordingPeriod ;\\n  rdfs:range xsd:date .\\n\\n:recordingEnd a owl:DatatypeProperty ;\\n  rdfs:label \\\"recording end\\\" ;\\n  rdfs:comment \\\"End date of album recording.\\\" ;\\n  rdfs:domain :AlbumRecordingPeriod ;\\n  rdfs:range xsd:date .\\n\\n:albumHasTrack a owl:ObjectProperty ;\\n  rdfs:label \\\"album has track\\\" ;\\n  rdfs:comment \\\"Links an album to its tracks.\\\" ;\\n  rdfs:domain :Album ;\\n  rdfs:range :Track ;\\n  owl:inverseOf :trackOnAlbum .\\n\\n:trackOnAlbum a owl:ObjectProperty ;\\n  rdfs:label \\\"track on album\\\" ;\\n  rdfs:comment \\\"Inverse of albumHasTrack: links a track to its album.\\\" ;\\n  rdfs:domain :Track ;\\n  rdfs:range :Album .\\n\\n:trackSongAssociation a owl:ObjectProperty ;\\n  rdfs:label \\\"track song association\\\" ;\\n  rdfs:comment \\\"Links a track-song association to a track.\\