2026-01-14 20:33:31 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/theatre-productions>\n    a owl:Ontology ;\n    rdfs:label \"Theatre Productions Ontology\" ;\n    rdfs:comment \"Ontology describing theatre festivals, productions, plays, ensembles, roles, actors, and related entities in Italy.\" .\n\n### Classes\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where theatres and festivals are located.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing cities.\" .\n\n:Theatre a owl:Class ;\n    rdfs:label \"Theatre\" ;\n    rdfs:comment \"A building or institution where productions are held.\" .\n\n:TheatreFestival a owl:Class ;\n    rdfs:label \"Theatre Festival\" ;\n    rdfs:comment \"An event featuring theatre productions, held in a city.\" .\n\n:Play a owl:Class ;\n    rdfs:label \"Play\" ;\n    rdfs:comment \"A dramatic composition performed in a theatre.\" .\n\n:Production a owl:Class ;\n    rdfs:label \"Production\" ;\n    rdfs:comment \"A specific staging of a play at a theatre.\" .\n\n:Ensemble a owl:Class ;\n    rdfs:label \"Ensemble\" ;\n    rdfs:comment \"A group of people performing in a production.\" .\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual involved in theatre productions.\" .\n\n:Actor a owl:Class ;\n    rdfs:subClassOf :Person ;\n    owl:disjointWith :Author ;\n    rdfs:label \"Actor\" ;\n    rdfs:comment \"A person who performs roles in productions.\" .\n\n:Author a owl:Class ;\n    rdfs:subClassOf :Person ;\n    owl:disjointWith :Actor ;\n    rdfs:label \"Author\" ;\n    rdfs:comment \"A person who writes plays.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A character or part played in a production.\" .\n\n:Review a owl:Class ;\n    rdfs:label \"Review\" ;\n    rdfs:comment \"A published review of a production.\" .\n\n:Newspaper a owl:Class ;\n    rdfs:label \"Newspaper\" ;\n    rdfs:comment \"A newspaper that publishes reviews.\" .\n\n:Act a owl:Class ;\n    rdfs:label \"Act\" ;\n    rdfs:comment \"An act within a play.\" .\n\n:ProductionRoleAssignment a owl:Class ;\n    rdfs:label \"Production Role Assignment\" ;\n    rdfs:comment \"A reified relation linking a production, actor, and role, possibly with a date.\" .\n\n:EnsembleMembership a owl:Class ;\n    rdfs:label \"Ensemble Membership\" ;\n    rdfs:comment \"A reified relation linking a person, ensemble, and membership period.\" .\n\n### Object Properties\n\n:festivalLocation a owl:ObjectProperty ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range :City ;\n    rdfs:label \"festival location\" ;\n    rdfs:comment \"Links a festival to the city where it takes place.\" ;\n    owl:inverseOf :locationOfFestival .\n\n:locationOfFestival a owl:ObjectProperty ;\n    rdfs:domain :City ;\n    rdfs:range :TheatreFestival ;\n    rdfs:label \"location of festival\" ;\n    rdfs:comment \"Inverse: links a city to the festivals held there.\" ;\n    owl:inverseOf :festivalLocation .\n\n:theatreLocation a owl:ObjectProperty ;\n    rdfs:domain :Theatre ;\n    rdfs:range :City ;\n    rdfs:label \"theatre location\" ;\n    rdfs:comment \"Links a theatre to the city where it is located.\" ;\n    owl:inverseOf :locationOfTheatre .\n\n:locationOfTheatre a owl:ObjectProperty ;\n    rdfs:domain :City ;\n    rdfs:range :Theatre ;\n    rdfs:label \"location of theatre\" ;\n    rdfs:comment \"Inverse: links a city to the theatres located there.\" ;\n    owl:inverseOf :theatreLocation .\n\n:takesPlaceInCountry a owl:ObjectProperty ;\n    rdfs:domain :City ;\n    rdfs:range :Country ;\n    rdfs:label \"takes place in country\" ;\n    rdfs:comment \"Links a city to the country it is located in.\" ;\n    owl:inverseOf :countryHasCity .\n\n:countryHasCity a owl:ObjectProperty ;\n    rdfs:domain :Country ;\n    rdfs:range :City ;\n    rdfs:label \"country has city\" ;\n    rdfs:comment \"Inverse: links a country to its cities.\" ;\n    owl:inverseOf :takesPlaceInCountry .\n\n:featuresPlay a owl:ObjectProperty ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range :Play ;\n    rdfs:label \"features play\" ;\n    rdfs:comment \"Links a festival to the plays performed.\" ;\n    owl:inverseOf :isFeaturedInFestival .\n\n:isFeaturedInFestival a owl:ObjectProperty ;\n    rdfs:domain :Play ;\n    rdfs:range :TheatreFestival ;\n    rdfs:label \"is featured in festival\" ;\n    rdfs:comment \"Inverse: links a play to the festivals where it is performed.\" ;\n    owl:inverseOf :featuresPlay .\n\n:hasTheatre a owl:ObjectProperty ;\n    rdfs:domain :Production ;\n    rdfs:range :Theatre ;\n    rdfs:label \"has theatre\" ;\n    rdfs:comment \"Links a production to the theatre where it is performed.\" ;\n    owl:inverseOf :isTheatreOfProduction .\n\n:isTheatreOfProduction a owl:ObjectProperty ;\n    rdfs:domain :Theatre ;\n    rdfs:range :Production ;\n    rdfs:label \"is theatre of production\" ;\n    rdfs:comment \"Inverse: links a theatre to its productions.\" ;\n    owl:inverseOf :hasTheatre .\n\n:hasEnsemble a owl:ObjectProperty ;\n    rdfs:domain :Production ;\n    rdfs:range :Ensemble ;\n    rdfs:label \"has ensemble\" ;\n    rdfs:comment \"Links a production to the ensemble performing.\" ;\n    owl:inverseOf :isEnsembleOfProduction .\n\n:isEnsembleOfProduction a owl:ObjectProperty ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :Production ;\n    rdfs:label \"is ensemble of production\" ;\n    rdfs:comment \"Inverse: links an ensemble to the productions it performs in.\" ;\n    owl:inverseOf :hasEnsemble .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :Person ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Links an ensemble to its members.\" ;\n    owl:inverseOf :isMemberOfEnsemble .\n\n:isMemberOfEnsemble a owl:ObjectProperty ;\n    rdfs:domain :Person ;\n    rdfs:range :Ensemble ;\n    rdfs:label \"is member of ensemble\" ;\n    rdfs:comment \"Inverse: links a person to the ensembles they belong to.\" ;\n    owl:inverseOf :hasMember .\n\n:wrotePlay a owl:ObjectProperty ;\n    rdfs:domain :Author ;\n    rdfs:range :Play ;\n    rdfs:label \"wrote play\" ;\n    rdfs:comment \"Links an author to plays they wrote.\" ;\n    owl:inverseOf :isWrittenBy .\n\n:isWrittenBy a owl:ObjectProperty ;\n    rdfs:domain :Play ;\n    rdfs:range :Author ;\n    rdfs:label \"is written by\" ;\n    rdfs:comment \"Inverse: links a play to its author.\" ;\n    owl:inverseOf :wrotePlay .\n\n:hasAct a owl:ObjectProperty ;\n    rdfs:domain :Play ;\n    rdfs:range :Act ;\n    rdfs:label \"has act\" ;\n    rdfs:comment \"Links a play to its acts.\" ;\n    owl:inverseOf :isActOfPlay .\n\n:isActOfPlay a owl:ObjectProperty ;\n    rdfs:domain :Act ;\n    rdfs:range :Play ;\n    rdfs:label \"is act of play\" ;\n    rdfs:comment \"Inverse: links an act to the play it belongs to.\" ;\n    owl:inverseOf :hasAct .\n\n:hasProduction a owl:ObjectProperty ;\n    rdfs:domain :Play ;\n    rdfs:range :Production ;\n    rdfs:label \"has production\" ;\n    rdfs:comment \"Links a play to its productions.\" ;\n    owl:inverseOf :isProductionOfPlay .\n\n:isProductionOfPlay a owl:ObjectProperty ;\n    rdfs:domain :Production ;\n    rdfs:range :Play ;\n    rdfs:label \"is production of play\" ;\n    rdfs:comment \"Inverse: links a production to its play.\" ;\n    owl:inverseOf :hasProduction .\n\n:hasReview a owl:ObjectProperty ;\n    rdfs:domain :Production ;\n    rdfs:range :Review ;\n    rdfs:label \"has review\" ;\n    rdfs:comment \"Links a production to its reviews.\" ;\n    owl:inverseOf :isReviewOfProduction .\n\n:isReviewOfProduction a owl:ObjectProperty ;\n    rdfs:domain :Review ;\n    rdfs:range :Production ;\n    rdfs:label \"is review of production\" ;\n    rdfs:comment \"Inverse: links a review to the production it reviews.\" ;\n    owl:inverseOf :hasReview .\n\n:reviewedBy a owl:ObjectProperty ;\n    rdfs:domain :Review ;\n    rdfs:range :Newspaper ;\n    rdfs:label \"reviewed by\" ;\n    rdfs:comment \"Links a review to the newspaper that published it.\" ;\n    owl:inverseOf :reviews .\n\n:reviews a owl:ObjectProperty ;\n    rdfs:domain :Newspaper ;\n    rdfs:range :Review ;\n    rdfs:label \"reviews\" ;\n    rdfs:comment \"Inverse: links a newspaper to the reviews it publishes.\" ;\n    owl:inverseOf :reviewedBy .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Production ;\n    rdfs:range :ProductionRoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links a production to its role assignments.\" ;\n    owl:inverseOf :roleAssignmentOfProduction .\n\n:roleAssignmentOfProduction a owl:ObjectProperty ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Production ;\n    rdfs:label \"role assignment of production\" ;\n    rdfs:comment \"Inverse: links a role assignment to its production.\" ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Role ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a role assignment to the role.\" ;\n    owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:domain :Role ;\n    rdfs:range :ProductionRoleAssignment ;\n    rdfs:label \"is role of assignment\" ;\n    rdfs:comment \"Inverse: links a role to its assignment.\" ;\n    owl:inverseOf :hasRole .\n\n:hasActor a owl:ObjectProperty ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Actor ;\n    rdfs:label \"has actor\" ;\n    rdfs:comment \"Links a role assignment to the actor.\" ;\n    owl:inverseOf :isActorOfAssignment .\n\n:isActorOfAssignment a owl:ObjectProperty ;\n    rdfs:domain :Actor ;\n    rdfs:range :ProductionRoleAssignment ;\n    rdfs:label \"is actor of assignment\" ;\n    rdfs:comment \"Inverse: links an actor to their role assignments.\" ;\n    owl:inverseOf :hasActor .\n\n:membershipInEnsemble a owl:ObjectProperty ;\n    rdfs:domain :Person ;\n    rdfs:range :EnsembleMembership ;\n    rdfs:label \"membership in ensemble\" ;\n    rdfs:comment \"Links a person to their ensemble membership.\" ;\n    owl:inverseOf :hasEnsembleMembership .\n\n:hasEnsembleMembership a owl:ObjectProperty ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range :Person ;\n    rdfs:label \"has ensemble membership\" ;\n    rdfs:comment \"Inverse: links an ensemble membership to the person.\" ;\n    owl:inverseOf :membershipInEnsemble .\n\n:memberOfEnsemble a owl:ObjectProperty ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range :Ensemble ;\n    rdfs:label \"member of ensemble\" ;\n    rdfs:comment \"Links an ensemble membership to the ensemble.\" ;\n    owl:inverseOf :hasEnsembleMember .\n\n:hasEnsembleMember a owl:ObjectProperty ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :EnsembleMembership ;\n    rdfs:label \"has ensemble member\" ;\n    rdfs:comment \"Inverse: links an ensemble to its ensemble memberships.\" ;\n    owl:inverseOf :memberOfEnsemble .\n\n### Data Properties\n\n:festivalStartDate a owl:DatatypeProperty ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"festival start date\" ;\n    rdfs:comment \"Start date of a festival.\" .\n\n:festivalEndDate a owl:DatatypeProperty ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"festival end date\" ;\n    rdfs:comment \"End date of a festival.\" .\n\n:productionStartDate a owl:DatatypeProperty ;\n    rdfs:domain :Production ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"production start date\" ;\n    rdfs:comment \"Start date of a production.\" .\n\n:productionEndDate a owl:DatatypeProperty ;\n    rdfs:domain :Production ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"production end date\" ;\n    rdfs:comment \"End date of a production.\" .\n\n:premierDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Production ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"premier date\" ;\n    rdfs:comment \"Date of the premier of a production.\" .\n\n:starRating a owl:DatatypeProperty ;\n    rdfs:domain :Review ;\n    rdfs:range xsd:integer ;\n    rdfs:label \"star rating\" ;\n    rdfs:comment \"Star rating given in a review.\" .\n\n:employmentStartDate a owl:DatatypeProperty ;\n    rdfs:domain :Actor ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"employment start date\" ;\n    rdfs:comment \"Date when an actor started working at a theatre.\" .\n\n:numberOfActs a owl:DatatypeProperty ;\n    rdfs:domain :Play ;\n    rdfs:range xsd:integer ;\n    rdfs:label \"number of acts\" ;\n    rdfs:comment \"Number of acts in a play.\" .\n\n:writtenStartDate a owl:DatatypeProperty ;\n    rdfs:domain :Play ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"written start date\" ;\n    rdfs:comment \"Start date of writing a play.\" .\n\n:writtenEndDate a owl:DatatypeProperty ;\n    rdfs:domain :Play ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"written end date\" ;\n    rdfs:comment \"End date of writing a play.\" .\n\n:assignmentDate a owl:DatatypeProperty ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"assignment date\" ;\n    rdfs:comment \"Date of the role assignment.\" .\n\n:membershipStartDate a owl:DatatypeProperty ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"membership start date\" ;\n    rdfs:comment \"Start date of ensemble membership.\" .\n\n:membershipEndDate a owl:DatatypeProperty ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"membership end date\" ;\n    rdfs:comment \"End date of ensemble membership.\" .\n\n### Disjointness\n\n:TheatreFestival owl:disjointWith :Production .\n:Theatre owl:disjointWith :City .\n:Play owl:disjointWith :Production .\n\n### Restrictions & Axioms\n\n:Production rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasRoleAssignment ;\n    owl:allValuesFrom :ProductionRoleAssignment\n] .\n:Ensemble rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasMember ;\n    owl:allValuesFrom :Person\n] .\n:Play rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasAct ;\n    owl:allValuesFrom :Act\n] .\n:Production owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasProduction ; owl:someValuesFrom :Play ]\n        [ a owl:Restriction ; owl:onProperty :hasTheatre ; owl:someValuesFrom :Theatre ]\n    )\n] .\n"
}
