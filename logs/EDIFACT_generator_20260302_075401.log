sProcess\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"BusinessProcess\",\"characteristics\":[\"Functional\"],\"label\":\"has business process\",\"comment\":\"Connects an InvoiceMessage to its associated BusinessProcess.\"},{\"name\":\"hasValidationConstraint\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"ValidationConstraint\",\"characteristics\":[],\"label\":\"has validation constraint\",\"comment\":\"Connects an InvoiceMessage to its validation constraints.\"},{\"name\":\"hasRoleAssignment\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"PivotOrganizationRole\",\"characteristics\":[],\"label\":\"has role assignment\",\"comment\":\"Connects an InvoiceMessage to a PivotOrganizationRole instance for reification.\"},{\"name\":\"roleOfOrganization\",\"type\":\"object\",\"domain\":\"PivotOrganizationRole\",\"range\":\"Organization\",\"characteristics\":[],\"label\":\"role of organization\",\"comment\":\"The Organization involved in a PivotOrganizationRole.\"},{\"name\":\"roleType\",\"type\":\"object\",\"domain\":\"PivotOrganizationRole\",\"range\":\"AgentRole\",\"characteristics\":[],\"label\":\"role type\",\"comment\":\"The role type (Buyer, Supplier, Delivery Party, etc.) assigned in a PivotOrganizationRole.\"},{\"name\":\"roleContext\",\"type\":\"object\",\"domain\":\"PivotOrganizationRole\",\"range\":\"InvoiceMessage\",\"characteristics\":[],\"label\":\"role context\",\"comment\":\"The InvoiceMessage context for the PivotOrganizationRole.\"},{\"name\":\"hasBGM\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"BGM_BeginningOfMessage\",\"characteristics\":[\"Functional\"],\"label\":\"has BGM segment\",\"comment\":\"Connects a HeaderSection to its BGM_BeginningOfMessage segment.\"},{\"name\":\"hasDTM\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"DTM_DateTimePeriod\",\"characteristics\":[],\"label\":\"has DTM segment\",\"comment\":\"Connects a HeaderSection to its DTM_DateTimePeriod segments.\"},{\"name\":\"hasMOA\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"MOA_MonetaryAmount\",\"characteristics\":[],\"label\":\"has MOA segment\",\"comment\":\"Connects a SummarySection to its MOA_MonetaryAmount segments.\"},{\"name\":\"hasTAX\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"TAX_DutyTaxFeeDetails\",\"characteristics\":[],\"label\":\"has TAX segment\",\"comment\":\"Connects a SummarySection to its TAX_DutyTaxFeeDetails segments.\"},{\"name\":\"hasQTY\",\"type\":\"object\",\"domain\":\"DetailSection\",\"range\":\"QTY_Quantity\",\"characteristics\":[],\"label\":\"has QTY segment\",\"comment\":\"Connects a DetailSection to its QTY_Quantity segments.\"},{\"name\":\"hasLIN\",\"type\":\"object\",\"domain\":\"DetailSection\",\"range\":\"LIN_LineItem\",\"characteristics\":[],\"label\":\"has LIN segment\",\"comment\":\"Connects a DetailSection to its LIN_LineItem segments.\"},{\"name\":\"hasSegmentGroup1\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"SegmentGroup1\",\"characteristics\":[],\"label\":\"has Segment Group 1\",\"comment\":\"Connects an InvoiceMessage to SegmentGroup1 (hierarchical grouping).\"},{\"name\":\"hasSegmentGroup2\",\"type\":\"object\",\"domain\":\"SegmentGroup1\",\"range\":\"SegmentGroup2\",\"characteristics\":[],\"label\":\"has Segment Group 2\",\"comment\":\"Connects a SegmentGroup1 to SegmentGroup2 (nested grouping).\"},{\"name\":\"hasNAD_Buyer\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"NAD_Buyer\",\"characteristics\":[\"Functional\"],\"label\":\"has NAD Buyer segment\",\"comment\":\"Connects a HeaderSection to its NAD_Buyer segment.\"},{\"name\":\"hasNAD_Supplier\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"NAD_Supplier\",\"characteristics\":[\"Functional\"],\"label\":\"has NAD Supplier segment\",\"comment\":\"Connects a HeaderSection to its NAD_Supplier segment.\"},{\"name\":\"hasNAD_Invoicee\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"NAD_Invoicee\",\"characteristics\":[],\"label\":\"has NAD Invoicee segment\",\"comment\":\"Connects a HeaderSection to its NAD_Invoicee segment.\"},{\"name\":\"hasNAD_DeliveryParty\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"NAD_DeliveryParty\",\"characteristics\":[],\"label\":\"has NAD Delivery Party segment\",\"comment\":\"Connects a HeaderSection to its NAD_DeliveryParty segment.\"}],\"disjoint_unions\":[{\"name\":\"SegmentSections\",\"members\":[\"HeaderSection\",\"DetailSection\",\"SummarySection\"]},{\"name\":\"NADRoles\",\"members\":[\"NAD_Buyer\",\"NAD_Supplier\",\"NAD_Invoicee\",\"NAD_DeliveryParty\"]}]}}",
        "name": "update_scratchpad"
      },
      "type": "function"
