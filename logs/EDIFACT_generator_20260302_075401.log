      "function": {
        "arguments": "{\"owl_content\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#EDIFACTInvoiceOntology> a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"A deeply structured OWL2 DL ontology for UN/EDIFACT D96A INVOIC messages, including mandatory segment roles, qualifiers, and strict cardinality constraints as required by EANCOM and EN 16931-1.\\\" .\\n\\n#################################################################\\n# CLASSES\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message, parent of InvoiceMessage.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"A D96A INVOIC message representing a digital invoice.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A logical block within an EDIFACT message, such as BGM, DTM, NAD, etc.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an invoice, containing document identifiers and parties.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The detail section containing line items and quantities.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section with invoice totals and taxes.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element in an EDIFACT segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element in an EDIFACT segment.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A party involved in the invoice, such as Buyer, Supplier, etc.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role (Buyer, Supplier, Delivery Party, etc.) assigned to an Organization.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"An address associated with an Organization.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:subClassOf :SimpleDataElement ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A unique identifier for an Organization's location. Must be present for Buyer and Supplier roles.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service line in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value, such as net price or total amount.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity associated with an Item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax applied to the invoice or line item.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:subClassOf :SimpleDataElement ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A document reference number, such as invoice number or order reference.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for validating invoice compliance (e.g., SHACL rules).\\\" .\\n\\n:PivotOrganizationRole a owl:Class ;\\n    rdfs:label \\\"Pivot Organization Role\\\" ;\\n    rdfs:comment \\\"A reification class linking an Organization, its Role, and Invoice context.\\\" .\\n\\n:BGM_BeginningOfMessage a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Beginning Of Message\\\" ;\\n    rdfs:comment \\\"The BGM segment identifying the document type and number.\\\" .\\n\\n:DTM_DateTimePeriod a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"DTM Date/Time/Period\\\" ;\\n    rdfs:comment \\\"The DTM segment specifying document dates and periods.\\\" .\\n\\n:MOA_MonetaryAmount a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"MOA Monetary Amount\\\" ;\\n    rdfs:comment \\\"The MOA segment specifying monetary amounts (totals, subtotals).\\\" .\\n\\n:TAX_DutyTaxFeeDetails a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"TAX Duty/Tax/Fee Details\\\" ;\\n    rdfs:comment \\\"The TAX segment specifying tax information.\\\" .\\n\\n:QTY_Quantity a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"QTY Quantity\\\" ;\\n    rdfs:comment \\\"The QTY segment specifying quantities (e.g., invoiced quantity).\\\" .\\n\\n:LIN_LineItem a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"LIN Line Item\\\" ;\\n    rdfs:comment \\\"The LIN segment specifying a line item in the invoice.\\\" .\\n\\n:SegmentGroup1 a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Segment Group 1\\\" ;\\n    rdfs:comment \\\"A hierarchical grouping of segments (e.g., for parties).\\\" .\\n\\n:SegmentGroup2 a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Segment Group 2\\\" ;\\n    rdfs:comment \\\"A nested grouping of segments (e.g., for line items).\\\" .\\n\\n:NAD_NameAndAddress a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Name and Address\\\" ;\\n    rdfs:comment \\\"The NAD segment specifying party identification and address.\\\" .\\n\\n:NAD_Buyer a owl:Class ;\\n    rdfs:subClassOf :NAD_NameAndAddress ;\\n    rdfs:label \\\"NAD Buyer\\\" ;\\n    rdfs:comment \\\"NAD+BY segment for Buyer role. Must have exactly one Global Location Number.\\\" .\\n\\n:NAD_Supplier a owl:Class ;\\n    rdfs:subClassOf :NAD_NameAndAddress ;\\n    rdfs:label \\\"NAD Supplier\\\" ;\\n    rdfs:comment \\\"NAD+SU segment for Supplier role. Must have exactly one Global Location Number.\\\" .\\n\\n:NAD_Invoicee a owl:Class ;\\n    rdfs:subClassOf :NAD_NameAndAddress ;\\n    rdfs:label \\\"NAD Invoicee\\\" ;\\n    rdfs:comment \\\"NAD+IV segment for Invoicee role.\\\" .\\n\\n:NAD_DeliveryParty a owl:Class ;\\n    rdfs:subClassOf :NAD_NameAndAddress ;\\n    rdfs:label \\\"NAD Delivery Party\\\" ;\\n    rdfs:comment \\\"NAD+DP segment for Delivery Party role.\\\" .\\n\\n:RFF_Reference a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"RFF Reference\\\" ;\\n    rdfs:comment \\\"The RFF segment specifying document or transaction references.\\\" .\\n\\n:ALC_AllowanceCharge a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"ALC Allowance/Charge\\\" ;\\n    rdfs:comment \\\"The ALC segment specifying allowances or charges applied.\\\" .\\n\\n:PRI_Price a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"PRI Price\\\" ;\\n    rdfs:comment \\\"The PRI segment specifying price details at the line item level.\\\" .\\n\\n:SegmentSections a owl:Class ;\\n    owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) ;\\n    rdfs:label \\\"Segment Sections\\\" ;\\n    rdfs:comment \\\"Disjoint union of header, detail, and summary sections.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:NADRoles a owl:Class ;\\n    owl:disjointUnionOf ( :NAD_Buyer :NAD_Supplier :NAD_Invoicee :NAD_DeliveryParty ) ;\\n    rdfs:label \\\"NAD Roles\\\" ;\\n    rdfs:comment \\\"Disjoint union of NAD role subclasses.\\\" ;\\n    rdfs:subClassOf :NAD_NameAndAddress .\\n\\n#################################################################\\n# DISJOINT CLASSES\\n#################################################################\\n\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n:Organization owl:disjointWith :AgentRole, :Address .\\n:AgentRole owl:disjointWith :Organization .\\n:Address owl:disjointWith :Organization .\\n:Item owl:disjointWith :Price, :Quantity .\\n:Price owl:disjointWith :Item, :Quantity .\\n:Quantity owl:disjointWith :Item, :Price .\\n:SegmentGroup1 owl:disjointWith :SegmentGroup2 .\\n:NAD_Buyer owl:disjointWith :NAD_Supplier, :NAD_Invoicee, :NAD_DeliveryParty .\\n:NAD_Supplier owl:disjointWith :NAD_Buyer, :NAD_Invoicee, :NAD_DeliveryParty .\\n:NAD_Invoicee owl:disjointWith :NAD_Buyer, :NAD_Supplier, :NAD_DeliveryParty .\\n:NAD_DeliveryParty owl:disjointWith :NAD_Buyer, :NAD_Supplier, :NAD_Invoicee .\\n\\n#################################################################\\n# PROPERTIES\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Connects an InterchangeEnvelope to its contained Message.\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :isContainedByEnvelope .\\n\\n:isContainedByEnvelope a owl:ObjectProperty ;\\n    rdfs:label \\\"is contained by envelope\\\" ;\\n    rdfs:comment \\\"Inverse property of containsMessage.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Connects a Message to its constituent Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasSegment.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasHeaderSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has header section\\\" ;\\n    rdfs:comment \\\"Connects an InvoiceMessage to its HeaderSection.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :HeaderSection ;\\n    owl:inverseOf :isHeaderSectionOf .\\n\\n:isHeaderSectionOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is header section of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasHeaderSection.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasHeaderSection .\\n\\n:hasDetailSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has detail section\\\" ;\\n    rdfs:comment \\\"Connects an InvoiceMessage to its DetailSection.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    owl:inverseOf :isDetailSectionOf .\\n\\n:isDetailSectionOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is detail section of\\\" ;\\n    rdfs:comment \\\"Inverse property of hasDetailSection.\\\" ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasDetailSection .\\n\\n:hasSummarySection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has summary section\\\" ;\\n    rdfs:comment \\\"Connects an InvoiceMessage to its SummarySection.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SummarySection ;\\n    owl:inverseOf :isSummarySectionOf .\\n\\n:isSummarySectionOf a owl:ObjectProperty ;\\n    rdf