      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-d96a>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC D96A Ontology\" ;\n    rdfs:comment \"A profoundly structured OWL ontology for UN/EDIFACT D96A INVOIC messages, covering all mandatory segments, roles, and attributes as per EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The UN/EDIFACT interchange envelope containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message, such as INVOIC.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An INVOIC message instance within an interchange envelope.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A structural segment in an EDIFACT message (e.g., BGM, NAD, LIN, MOA, etc.).\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header section of an invoice message, containing document identification and dates.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The detail section of an invoice message, listing line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The summary section of an invoice message, providing totals, taxes, and payment terms.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment, grouping simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A business entity participating in the invoice (buyer, supplier, delivery party, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the business process (buyer, seller, etc.).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A physical or legal address associated with an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier for an organization or document (e.g., GLN, VAT number).\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A monetary value assigned to an item or line.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax or duty applied to the invoice or line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint or rule for validating invoice data (e.g., SHACL shape).\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A single line item in the invoice detail section.\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A pivot/reification class linking an organization to a specific role in a context (e.g., buyer, seller).\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A standardized identifier for physical locations (GLN).\" .\n\n:MonetaryAmount a owl:Class ;\n    rdfs:subClassOf :MonetaryAmountSegment ;\n    rdfs:label \"Monetary Amount\" ;\n    rdfs:comment \"A monetary value, as per MOA segment, such as line net, tax, or invoice total.\" .\n\n:DateTimePeriod a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Date/Time Period\" ;\n    rdfs:comment \"A date or period relevant to the document (e.g., invoice date).\" .\n\n:ReferenceDocument a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Reference Document\" ;\n    rdfs:comment \"A referenced document (e.g., order, delivery note) in the invoice.\" .\n\n:AllowanceCharge a owl:Class ;\n    rdfs:subClassOf :AllowanceChargeSegment ;\n    rdfs:label \"Allowance/Charge\" ;\n    rdfs:comment \"Discounts or surcharges applied at document or line level.\" .\n\n:TransportDetails a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Transport Details\" ;\n    rdfs:comment \"Information about transport arrangements (TOD segment).\" .\n\n:Quantity a owl:Class ;\n    rdfs:subClassOf :QuantitySegment ;\n    rdfs:label \"Quantity\" ;\n    rdfs:comment \"A quantity value as per QTY segment.\" .\n\n:PriceDetails a owl:Class ;\n    rdfs:subClassOf :PriceDetailsSegment ;\n    rdfs:label \"Price Details\" ;\n    rdfs:comment \"Details of pricing at line or document level, as per PRI segment.\" .\n\n:DutyTaxFeeDetails a owl:Class ;\n    rdfs:subClassOf :TaxSegment ;\n    rdfs:label \"Duty/Tax/Fee Details\" ;\n    rdfs:comment \"Details of tax, duty, or fee as per TAX segment.\" .\n\n:Package a owl:Class ;\n    rdfs:subClassOf :PackageSegment ;\n    rdfs:label \"Package\" ;\n    rdfs:comment \"Packaging details as per PAC segment.\" .\n\n:AdditionalProductID a owl:Class ;\n    rdfs:subClassOf :AdditionalProductIDSegment ;\n    rdfs:label \"Additional Product ID\" ;\n    rdfs:comment \"Alternative or additional identifiers for an item (PIA segment).\" .\n\n:ItemDescription a owl:Class ;\n    rdfs:subClassOf :ItemDescriptionSegment ;\n    rdfs:label \"Item Description\" ;\n    rdfs:comment \"Descriptive information about an item (IMD segment).\" .\n\n:VATBreakdown a owl:Class ;\n    rdfs:subClassOf :SummarySection ;\n    rdfs:label \"VAT Breakdown\" ;\n    rdfs:comment \"Breakdown of VAT rates and amounts per EN 16931-1.\" .\n\n:PaymentTerms a owl:Class ;\n    rdfs:subClassOf :HeaderSection ;\n    rdfs:label \"Payment Terms\" ;\n    rdfs:comment \"Terms of payment for the invoice.\" .\n\n:DocumentTotals a owl:Class ;\n    rdfs:subClassOf :SummarySection ;\n    rdfs:label \"Document Totals\" ;\n    rdfs:comment \"Aggregated totals for the invoice as per EN 16931-1.\" .\n\n# Segment-level classes for explicit modeling\n:PriceDetailsSegment a owl:Class ;\n    rdfs:label \"Price Details Segment\" ;\n    rdfs:comment \"Explicit PRI segment structure for price details.\" .\n\n:TaxSegment a owl:Class ;\n    rdfs:label \"Tax Segment\" ;\n    rdfs:comment \"Explicit TAX segment structure for duty/tax/fee details.\" .\n\n:PackageSegment a owl:Class ;\n    rdfs:label \"Package Segment\" ;\n    rdfs:comment \"Explicit PAC segment structure for packaging details.\" .\n\n:AdditionalProductIDSegment a owl:Class ;\n    rdfs:label \"Additional Product ID Segment\" ;\n    rdfs:comment \"Explicit PIA segment structure for additional product IDs.\" .\n\n:ItemDescriptionSegment a owl:Class ;\n    rdfs:label \"Item Description Segment\" ;\n    rdfs:comment \"Explicit IMD segment structure for item descriptions.\" .\n\n:MonetaryAmountSegment a owl:Class ;\n    rdfs:label \"Monetary Amount Segment\" ;\n    rdfs:comment \"Explicit MOA segment structure for monetary amounts.\" .\n\n:QuantitySegment a owl:Class ;\n    rdfs:label \"Quantity Segment\" ;\n    rdfs:comment \"Explicit QTY segment structure for quantities.\" .\n\n:AllowanceChargeSegment a owl:Class ;\n    rdfs:label \"Allowance/Charge Segment\" ;\n    rdfs:comment \"Explicit ALC segment structure for allowances/charges.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to its contained message.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its constituent segments.\" .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Segment ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an invoice message to its header, detail, and summary sections.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    owl:SymmetricProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Indicates organizations involved in the invoice.\" .\n\n:playsRole a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    owl:FunctionalProperty ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Links an organization to its role assignment(s).\" .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Specifies the role played in a given assignment.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifier(s).\" .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links the detail section to its line items.\" .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:FunctionalProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a line item to the item described.\" .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a line item to its net price.\" .\n\n:hasQuantity a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Quantity ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Links a line item to its quantity.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links the summary section to tax details.\" .\n\n:hasTotalAmount a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :MonetaryAmount ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has total amount\" ;\n    rdfs:comment \"Links the summary section to the invoice total amount.\" .\n\n:assignedToProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:FunctionalProperty ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Assigns an invoice message to a business process.\" .\n\n:conformsToStandard a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    rdfs:label \"conforms to standard\" ;\n    rdfs:comment \"Indicates that the invoice conforms to a validation constraint or standard.\" .\n\n:hasWarehouseAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has warehouse address\" ;\n    rdfs:comment \"Links an organization to its warehouse address.\" .\n\n:hasReferenceDocument a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ReferenceDocument ;\n    rdfs:label \"has reference document\" ;\n    rdfs:comment \"Links an invoice message to a referenced document (order, delivery note, etc.).\" .\n\n:hasAllowanceCharge a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :AllowanceCharge ;\n    rdfs:label \"has allowance/charge\" ;\n    rdfs:comment \"Links an invoice message to allowances or charges.\" .\n\n:hasTransportDetails a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :TransportDetails ;\n    rdfs:label \"has transport details\" ;\n    rdfs:comment \"Links an invoice message to transport details.\" .\n\n:hasPriceDetails a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :PriceDetails ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has price details\" ;\n    rdfs:comment \"Links a line item to its price details (PRI segment).\" .\n\n:hasDutyTaxFeeDetails a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DutyTaxFeeDetails ;\n    rdfs:label \"has duty/tax/fee details\" ;\n    rdfs:comment \"Links a line item to its tax/duty/fee details (TAX segment).\" .\n\n:hasPackage a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Package ;\n    rdfs:label \"has package\" ;\n    rdfs:comment \"Links a line item to packaging details (PAC segment).\" .\n\n:hasAdditionalProductID a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :AdditionalProductID ;\n    rdfs:label \"has additional product ID\" ;\n    rdfs:comment \"Links an item to its additional product IDs (PIA segment).\" .\n\n:hasItemDescription a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :ItemDescription ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has item description\" ;\n    rdfs:comment \"Links an item to its description (IMD segment).\" .\n\n:hasVATBreakdown a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :VATBreakdown ;\n    rdfs:label \"has VAT breakdown\" ;\n    rdfs:comment \"Links the summary section to its VAT breakdown (EN 16931-1).\" .\n\n:hasPaymentTerms a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :PaymentTerms ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has payment terms\" ;\n    rdfs:comment \"Links the header section to payment terms.\" .\n\n:hasDocumentTotals a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :DocumentTotals ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has document totals\" ;\n    rdfs:comment \"Links the summary section to document-level totals (EN 16931-1).\" .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"GLN identifier for an organization/location.\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number assigned to the document.\" .\n\n#################################################################\n# INDIVIDUALS (OPTIONAL, OMITTED FOR STRUCTURE)\n#################################################################\n\n# ...\n"
}
