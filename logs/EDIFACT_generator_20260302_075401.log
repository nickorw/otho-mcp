ilsOfInvoiceMessage a owl:ObjectProperty ;\\n    rdfs:domain :TransportDetails ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"Transport Details of Invoice Message\\\" ;\\n    rdfs:comment \\\"The transport details are associated with the invoice message (inverse of hasTransportDetails).\\\" .\\n\\n:hasPriceDetails a owl:ObjectProperty ;\\n    rdf:type owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :PriceDetails ;\\n    rdfs:label \\\"has price details\\\" ;\\n    rdfs:comment \\\"Links a line item to its price details (PRI segment).\\\" ;\\n    owl:inverseOf :isPriceDetailsOfLineItem .\\n\\n:isPriceDetailsOfLineItem a owl:ObjectProperty ;\\n    rdfs:domain :PriceDetails ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"Price Details of Line Item\\\" ;\\n    rdfs:comment \\\"The price details are associated with a line item (inverse of hasPriceDetails).\\\" .\\n\\n:hasDutyTaxFeeDetails a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DutyTaxFeeDetails ;\\n    rdfs:label \\\"has duty/tax/fee details\\\" ;\\n    rdfs:comment \\\"Links a line item to its tax/duty/fee details (TAX segment).\\\" ;\\n    owl:inverseOf :isDutyTaxFeeDetailsOfLineItem .\\n\\n:isDutyTaxFeeDetailsOfLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DutyTaxFeeDetails ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"Duty/Tax/Fee Details of Line Item\\\" ;\\n    rdfs:comment \\\"The duty/tax/fee details are associated with a line item (inverse of hasDutyTaxFeeDetails).\\\" .\\n\\n:hasPackage a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Package ;\\n    rdfs:label \\\"has package\\\" ;\\n    rdfs:comment \\\"Links a line item to packaging details (PAC segment).\\\" ;\\n    owl:inverseOf :isPackageOfLineItem .\\n\\n:isPackageOfLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Package ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"Package of Line Item\\\" ;\\n    rdfs:comment \\\"The package is associated with a line item (inverse of hasPackage).\\\" .\\n\\n:hasAdditionalProductID a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :AdditionalProductID ;\\n    rdfs:label \\\"has additional product ID\\\" ;\\n    rdfs:comment \\\"Links an item to its additional product IDs (PIA segment).\\\" ;\\n    owl:inverseOf :isAdditionalProductIDOfItem .\\n\\n:isAdditionalProductIDOfItem a owl:ObjectProperty ;\\n    rdfs:domain :AdditionalProductID ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"Additional Product ID of Item\\\" ;\\n    rdfs:comment \\\"The additional product ID is associated with an item (inverse of hasAdditionalProductID).\\\" .\\n\\n:hasItemDescription a owl:ObjectProperty ;\\n    rdf:type owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :ItemDescription ;\\n    rdfs:label \\\"has item description\\\" ;\\n    rdfs:comment \\\"Links an item to its description (IMD segment).\\\" ;\\n    owl:inverseOf :isItemDescriptionOfItem .\\n\\n:isItemDescriptionOfItem a owl:ObjectProperty ;\\n    rdfs:domain :ItemDescription ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"Item Description of Item\\\" ;\\n    rdfs:comment \\\"The item description is associated with an item (inverse of hasItemDescription).\\\" .\\n\\n:hasVATBreakdown a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :VATBreakdown ;\\n    rdfs:label \\\"has VAT breakdown\\\" ;\\n    rdfs:comment \\\"Links the summary section to its VAT breakdown (EN 16931-1).\\\" ;\\n    owl:inverseOf :isVATBreakdownOfSummarySection .\\n\\n:isVATBreakdownOfSummarySection a owl:ObjectProperty ;\\n    rdfs:domain :VATBreakdown ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"VAT Breakdown of Summary Section\\\" ;\\n    rdfs:comment \\\"The VAT breakdown is associated with a summary section (inverse of hasVATBreakdown).\\\" .\\n\\n:hasPaymentTerms a owl:ObjectProperty ;\\n    rdf:type owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :Pa