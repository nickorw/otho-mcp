Connects a DetailSection to its Items.\"},{\"name\":\"hasPrice\",\"type\":\"object\",\"domain\":\"Item\",\"range\":\"Price\",\"characteristics\":[\"Functional\"],\"label\":\"has price\",\"comment\":\"Connects an Item to its Price.\"},{\"name\":\"hasQuantity\",\"type\":\"object\",\"domain\":\"Item\",\"range\":\"Quantity\",\"characteristics\":[\"Functional\"],\"label\":\"has quantity\",\"comment\":\"Connects an Item to its Quantity.\"},{\"name\":\"hasTax\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"Tax\",\"characteristics\":[\"Functional\"],\"label\":\"has tax\",\"comment\":\"Connects a SummarySection to its Tax.\"},{\"name\":\"hasReferenceNumber\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"ReferenceNumber\",\"characteristics\":[\"Functional\"],\"label\":\"has reference number\",\"comment\":\"Connects a HeaderSection to its ReferenceNumber.\"},{\"name\":\"hasInvoiceAmount\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"Price\",\"characteristics\":[\"Functional\"],\"label\":\"has invoice amount\",\"comment\":\"Connects a SummarySection to the total invoice Price.\"},{\"name\":\"hasInvoiceNumber\",\"type\":\"data\",\"domain\":\"InvoiceMessage\",\"range\":\"xsd:string\",\"characteristics\":[\"Functional\"],\"label\":\"has invoice number\",\"comment\":\"Invoice number of an InvoiceMessage.\"},{\"name\":\"hasBusinessProcess\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"BusinessProcess\",\"characteristics\":[\"Functional\"],\"label\":\"has business process\",\"comment\":\"Connects an InvoiceMessage to its associated BusinessProcess.\"},{\"name\":\"hasValidationConstraint\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"ValidationConstraint\",\"characteristics\":[],\"label\":\"has validation constraint\",\"comment\":\"Connects an InvoiceMessage to its validation constraints.\"},{\"name\":\"hasRoleAssignment\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"Pivot_OrganizationRole\",\"characteristics\":[],\"label\":\"has role assignment\",\"comment\":\"Connects an InvoiceMessage to a Pivot_OrganizationRole instance for reification.\"},{\"name\":\"roleOfOrganization\",\"type\":\"object\",\"domain\":\"Pivot_OrganizationRole\",\"range\":\"Organization\",\"characteristics\":[],\"label\":\"role of organization\",\"comment\":\"The Organization involved in a Pivot_OrganizationRole.\"},{\"name\":\"roleType\",\"type\":\"object\",\"domain\":\"Pivot_OrganizationRole\",\"range\":\"AgentRole\",\"characteristics\":[],\"label\":\"role type\",\"comment\":\"The role type (Buyer, Supplier, Delivery Party, etc.) assigned in a Pivot_OrganizationRole.\"},{\"name\":\"roleContext\",\"type\":\"object\",\"domain\":\"Pivot_OrganizationRole\",\"range\":\"InvoiceMessage\",\"characteristics\":[],\"label\":\"role context\",\"comment\":\"The InvoiceMessage context for the Pivot_OrganizationRole.\"},{\"name\":\"hasBGM\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"BGM_BeginningOfMessage\",\"characteristics\":[\"Functional\"],\"label\":\"has BGM segment\",\"comment\":\"Connects a HeaderSection to its BGM_BeginningOfMessage segment.\"},{\"name\":\"hasDTM\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"DTM_DateTimePeriod\",\"characteristics\":[],\"label\":\"has DTM segment\",\"comment\":\"Connects a HeaderSection to its DTM_DateTimePeriod segments.\"},{\"name\":\"hasMOA\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"MOA_MonetaryAmount\",\"characteristics\":[],\"label\":\"has MOA segment\",\"comment\":\"Connects a SummarySection to its MOA_MonetaryAmount segments.\"},{\"name\":\"hasTAX\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"TAX_DutyTaxFeeDetails\",\"characteristics\":[],\"label\":\"has TAX segment\",\"comment\":\"Connects a SummarySection to its TAX_DutyTaxFeeDetails segments.\"},{\"name\":\"hasQTY\",\"type\":\"object\",\"domain\":\"DetailSection\",\"range\":\"QTY_Quantity\",\"characteristics\":[],\"label\":\"has QTY segment\",\"comment\":\"Connects a DetailSection to its QTY_Quantity segments.\"},{\"name\":\"hasLIN\",\"type\":\"object\",\"domain\":\"DetailSection\",\"range\":\"LIN_LineItem\",\"characteristics\":[],\"label\":\"has LIN segment\",\"comment\":\"Connects a DetailSection to its LIN_LineItem segments.\"},{\"name\":\"hasSegmentGroup1\",\"type\":\"object\",\"domain\":\"InvoiceMessage\",\"range\":\"SegmentGroup1\",\"characteristics\":[],\"label\":\"has Segment Group 1\",\"comment\":\"Connects an InvoiceMessage to SegmentGroup1 (hierarchical grouping).\"},{\"name\":\"hasSegmentGroup2\",\"type\":\"object\",\"domain\":\"SegmentGroup1\",\"range\":\"SegmentGroup2\",\"characteristics\":[],\"label\":\"has Segment Group 2\",\"comment\":\"Connects a SegmentGroup1 to SegmentGroup2 (nested grouping).\"},{\"name\":\"hasNAD\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"NAD_NameAndAddress\",\"characteristics\":[],\"label\":\"has NAD segment\",\"comment\":\"Connects a HeaderSection to its NAD_NameAndAddress segments.\"},{\"name\":\"hasRFF\",\"type\":\"object\",\"domain\":\"HeaderSection\",\"range\":\"RFF_Reference\",\"characteristics\":[],\"label\":\"has RFF segment\",\"comment\":\"Connects a HeaderSection to its RFF_Reference segments.\"},{\"name\":\"hasALC\",\"type\":\"object\",\"domain\":\"SummarySection\",\"range\":\"ALC_AllowanceCharge\",\"characteristics\":[],\"label\":\"has ALC segment\",\"comment\":\"Connects a SummarySection to its ALC_AllowanceCharge segments.\"},{\"name\":\"hasPRI\",\"type\":\"object\",\"domain\":\"DetailSection\",\"range\":\"PRI_Price\",\"characteristics\":[],\"label\":\"has PRI segment\",\"comment\":\"Connects a DetailSection to its PRI_Price segments.\"}],\"disjoint_unions\":[{\"name\":\"SegmentSections\",\"members\":[\"HeaderSection\",\"DetailSection\",\"SummarySection\"]}]}}",
        "name": "update_scratchpad"
