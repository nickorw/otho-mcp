      "id": "call_rFAyzmOPjfqf38til0azUIZw",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#edifact-invoice>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"A deeply structured ontology for UN/EDIFACT invoice messages, organizations, roles, and procurement alignment.\\\" .\\n\\n#################################################################\\n#   Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope in an EDIFACT transmission, containing messages.\\\" .\\n\\n:EDIFACTMessage a owl:Class ;\\n    rdfs:label \\\"EDIFACT Message\\\" ;\\n    rdfs:comment \\\"A message within an interchange envelope, e.g., INVOIC.\\\" .\\n\\n:INVOICMessage a owl:Class ;\\n    rdfs:label \\\"INVOIC Message\\\" ;\\n    rdfs:comment \\\"The EDIFACT message for invoices.\\\" ;\\n    rdfs:subClassOf :EDIFACTMessage .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment in an EDIFACT message, such as BGM or NAD.\\\" .\\n\\n:BGM_Segment a owl:Class ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"The Beginning of Message segment identifying the document.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:NAD_Segment a owl:Class ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"The Name and Address segment for participant details.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment, grouping simple elements.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite or segment.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"A business document representing a request for payment.\\\" .\\n\\n:InvoiceHeader a owl:Class ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"The header section of an invoice, with dates and reference numbers.\\\" .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"The detail section of an invoice, listing line items.\\\" .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"The summary section of an invoice, providing totals and taxes.\\\" .\\n\\n:InvoiceLineItem a owl:Class ;\\n    rdfs:label \\\"Invoice Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the invoice, with item, quantity, and price.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An entity involved in the transaction, e.g., buyer or seller.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the invoice, such as Buyer or Delivery Party.\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified association linking an organization, its role, address, and identifiers within a specific invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"An address associated with an organization in a specific role.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A generic identifier for organizations or other entities.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number (GLN)\\\" ;\\n    rdfs:comment \\\"A standardized location identifier as per EDIFACT.\\\" ;\\n    rdfs:subClassOf :Identifier .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A process to which the invoice is assigned, e.g., Purchase-to-Pay.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price amount, linked to line items or totals.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax entry in the invoice summary.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service being invoiced.\\\" .\\n\\n:UnitOfMeasure a owl:Class ;\\n    rdfs:label \\\"Unit of Measure\\\" ;\\n    rdfs:comment \\\"A unit for item quantity, e.g., pieces, kilograms.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number for the invoice, e.g., invoice number.\\\" .\\n\\n:Date a owl:Class ;\\n    rdfs:label \\\"Date\\\" ;\\n    rdfs:comment \\\"A calendar date, such as invoice date or delivery date.\\\" .\\n\\n:EN16931Alignment a owl:Class ;\\n    rdfs:label \\\"EN 16931 Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the European Standard EN 16931-1 for electronic invoicing.\\\" .\\n\\n:P2POAlignment a owl:Class ;\\n    rdfs:label \\\"P2P-O Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n:SHACLConstraint a owl:Class ;\\n    rdfs:label \\\"SHACL Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for automated validation, e.g., sum of item prices.\\\" .\\n\\n#################################################################\\n#   Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an interchange envelope to its contained EDIFACT message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :EDIFACTMessage ;\\n    owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a message to its segments.\\\" ;\\n    rdfs:domain :EDIFACTMessage ;\\n    rdfs:range :Segment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite data element to its simple data elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:representsInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"represents invoice\\\" ;\\n    rdfs:comment \\\"Links an INVOIC message to the corresponding invoice.\\\" ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :Invoice ;\\n    owl:FunctionalProperty .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Links an invoice to its header section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceHeader ;\\n    owl:FunctionalProperty .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Links an invoice to its detail section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:FunctionalProperty .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Links an invoice to its summary section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:FunctionalProperty .\\n\\n:containsLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"contains line item\\\" ;\\n    rdfs:comment \\\"Links the invoice detail section to its contained line items.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :InvoiceLineItem .\\n\\n:hasParticipant a owl:ObjectProperty ;\\n    rdfs:label \\\"has participant\\\" ;\\n    rdfs:comment \\\"Links an invoice to a reified organization-role assignment.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :OrganizationRoleAssignment .\\n\\n:hasRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to the agent role (e.g., Buyer, Seller).\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:FunctionalProperty .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to the involved organization.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:FunctionalProperty .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an address.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an identifier.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Identifier .\\n\\n:hasGLN a owl:ObjectProperty ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to a Global Location Number.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :GlobalLocationNumber ;\\n    owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Links an invoice header to its reference number.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :ReferenceNumber ;\\n    owl:FunctionalProperty .\\n\\n:hasDate a owl:ObjectProperty ;\\n    rdfs:label \\\"has date\\\" ;\\n    rdfs:comment \\\"Links an invoice header to a date.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :Date ;\\n    owl:FunctionalProperty .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links an invoice line item to an item/product.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range :Item ;\\n    owl:FunctionalProperty .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Links an invoice line item to its net price.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range :Price ;\\n    owl:FunctionalProperty .\\n\\n:hasUnitOfMeasure a owl:ObjectProperty ;\\n    rdfs:label \\\"has unit of measure\\\" ;\\n    rdfs:comment \\\"Links an invoice line item to its unit of measure.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range :UnitOfMeasure ;\\n    owl:FunctionalProperty .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the invoice summary to its tax entries.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :Tax .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process (e.g., Purchase-to-Pay).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess .\\n\\n:isAlignedWithEN16931 a owl:ObjectProperty ;\\n    rdfs:label \\\"is aligned with EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates alignment of an invoice with EN 16931-1.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :EN16931Alignment .\\n\\n:isAlignedWithP2PO a owl:ObjectProperty ;\\n    rdfs:label \\\"is aligned with P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates alignment of an invoice with the Purchase-to-Pay Ontology.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :P2POAlignment .\\n\\n:hasSHACLConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has SHACL constraint\\\" ;\\n    rdfs:comment \\\"Links an invoice to a SHACL constraint for validation.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :SHACLConstraint .\\n\\n#################################################################\\n#   Data Properties\\n#################################################################\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of an item in a line item.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"The total invoice amount in the summary.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal ;\\n    owl:FunctionalProperty .\\n\\n:elementCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"element code\\\" ;\\n    rdfs:comment \\\"The code of a simple data element as per EDIFACT specification.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:elementValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"element value\\\" ;\\n    rdfs:comment \\\"The value/content of a simple data element.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n#   Restrictions & Advanced Axioms\\n#################################################################\\n\\n# Invoice must have exactly one header, detail, and summary\\n:Invoice a owl:Class ;\\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:cardinality 1 ] .\\n\\n# OrganizationRoleAssignment must have exactly one role and organization\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRole ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality 1 ] .\\n\\n# InvoiceLineItem must have exactly one Item and Price\\n:InvoiceLineItem a owl:Class ;\\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItem ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:cardinality 1 ] .\\n\\n# Disjointness axioms\\n:Organization owl:disjointWith :Address, :Invoice, :Item .\\n:Segment owl:disjointWith :Invoice, :Organization .\\n\\n# DisjointUnion for Identifier\\n:Identifier owl:disjointUnionOf ( :GlobalLocationNumber ) .\\n\\n#################################################################\\n#   Example Individuals (for illustration)\\n#################################################################\\n\\n:Buyer a :AgentRole ;\\n    rdfs:label \\\"Buyer\\\" ;\\n    rdfs:comment \\\"The agent role of buyer in a transaction.\\\" .\\n\\n:Seller a :AgentRole ;\\n    rdfs:label \\\"Seller\\\" ;\\n    rdfs:comment \\\"The agent role of seller in a transaction.\\\" .\\n\\n:DeliveryParty a :AgentRole ;\\n    rdfs:label \\\"Delivery Party\\\" ;\\n    rdfs:comment \\\"The agent role of delivery party in a transaction.\\\" .\\n\\n# (Further code mappings, technical vocabulary, and EDIFACT elements can be expanded as needed)\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
    {
      "id": "call_Hw1nh2ctx05BU9kaBicqvuJD",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#edifact-invoice>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"A deeply structured ontology for UN/EDIFACT invoice messages, organizations, roles, and procurement alignment.\\\" .\\n\\n#################################################################\\n#   Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope in an EDIFACT transmission, containing messages.\\\" .\\n\\n:EDIFACTMessage a owl:Class ;\\n    rdfs:label \\\"EDIFACT Message\\\" ;\\n    rdfs:comment \\\"A message within an interchange envelope, e.g., INVOIC.\\\" .\\n\\n:INVOICMessage a owl:Class ;\\n    rdfs:label \\\"INVOIC Message\\\" ;\\n    rdfs:comment \\\"The EDIFACT message for invoices.\\\" ;\\n    rdfs:subClassOf :EDIFACTMessage .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment in an EDIFACT message, such as BGM or NAD.\\\" .\\n\\n:BGM_Segment a owl:Class ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"The Beginning of Message segment identifying the document.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:NAD_Segment a owl:Class ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"The Name and Address segment for participant details.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment, grouping simple elements.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite or segment.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"A business document representing a request for payment.\\\" .\\n\\n:InvoiceHeader a owl:Class ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"The header section of an invoice, with dates and reference numbers.\\\" .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"The detail section of an invoice, listing line items.\\\" .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"The summary section of an invoice, providing totals and taxes.\\\" .\\n\\n:InvoiceLineItem a owl:Class ;\\n    rdfs:label \\\"Invoice Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the invoice, with item, quantity, and price.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An entity involved in the transaction, e.g., buyer or seller.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the invoice, such as Buyer or Delivery Party.\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified association linking an organization, its role, address, and identifiers within a specific invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"An address associated with an organization in a specific role.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A generic identifier for organizations or other entities.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number (GLN)\\\" ;\\n    rdfs:comment \\\"A standardized location identifier as per EDIFACT.\\\" ;\\n    rdfs:subClassOf :Identifier .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A process to which the invoice is assigned, e.g., Purchase-to-Pay.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price amount, linked to line items or totals.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax entry in the invoice summary.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service being invoiced.\\\" .\\n\\n:UnitOfMeasure a owl:Class ;\\n    rdfs:label \\\"Unit of Measure\\\" ;\\n    rdfs:comment \\\"A unit for item quantity, e.g., pieces, kilograms.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number for the invoice, e.g., invoice number.\\\" .\\n\\n:Date a owl:Class ;\\n    rdfs:label \\\"Date\\\" ;\\n    rdfs:comment \\\"A calendar date, such as invoice date or delivery date.\\\" .\\n\\n:EN16931Alignment a owl:Class ;\\n    rdfs:label \\\"EN 16931 Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the European Standard EN 16931-1 for electronic invoicing.\\\" .\\n\\n:P2POAlignment a owl:Class ;\\n    rdfs:label \\\"P2P-O Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n:SHACLConstraint a owl:Class ;\\n    rdfs:label \\\"SHACL Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for automated validation, e.g., sum of item prices.\\\" .\\n\\n#################################################################\\n#   Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an interchange envelope to its contained EDIFACT message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :EDIFACTMessage ;\\n    owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a message to its segments.\\\" ;\\n    rdfs:domain :EDIFACTMessage ;\\n    rdfs:range :Segment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite data element to its simple data elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:representsInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"represents invoice\\\" ;\\n    rdfs:comment \\\"Links an INVOIC message to the corresponding invoice.\\\" ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :Invoice ;\\n    owl:FunctionalProperty .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Links an invoice to its header section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceHeader ;\\n    owl:FunctionalProperty .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Links an invoice to its detail section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:FunctionalProperty .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Links an invoice to its summary section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:FunctionalProperty .\\n\\n:containsLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"contains line item\\\" ;\\n    rdfs:comment \\\"Links the invoice detail section to its contained line items.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :InvoiceLineItem .\\n\\n:hasParticipant a owl:ObjectProperty ;\\n    rdfs:label \\\"has participant\\\" ;\\n    rdfs:comment \\\"Links an invoice to a reified organization-role assignment.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :OrganizationRoleAssignment .\\n\\n:hasRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to the agent role (e.g., Buyer, Seller).\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:FunctionalProperty .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to the involved organization.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:FunctionalProperty .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an address.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an identifier.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Identifier .\\n\\n:hasGLN a owl:ObjectProperty ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to a Global Location Number.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :GlobalLocationNumber ;\\n    owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:ObjectProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Links an invoice header to its reference number.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :ReferenceNumber ;\\n    owl:FunctionalProperty .\\n\\n:hasDate a owl:ObjectProperty ;\\n    rdfs:label \\\"has date\\\" ;\\n    rdfs:comment \\\"Links an invoice header to a date.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :Date ;\\n    owl:FunctionalProperty .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links an invoice line item to an item/product.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range :Item ;\\n    owl:FunctionalProperty .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Links an invoice line item to its net price.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range :Price ;\\n    owl:FunctionalProperty .\\n\\n:hasUnitOfMeasure a owl:ObjectProperty ;\\n    rdfs:label \\\"has unit of measure\\\" ;\\n    rdfs:comment \\\"Links an invoice line item to its unit of measure.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range :UnitOfMeasure ;\\n    owl:FunctionalProperty .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the invoice summary to its tax entries.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :Tax .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process (e.g., Purchase-to-Pay).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess .\\n\\n:isAlignedWithEN16931 a owl:ObjectProperty ;\\n    rdfs:label \\\"is aligned with EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates alignment of an invoice with EN 16931-1.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :EN16931Alignment .\\n\\n:isAlignedWithP2PO a owl:ObjectProperty ;\\n    rdfs:label \\\"is aligned with P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates alignment of an invoice with the Purchase-to-Pay Ontology.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :P2POAlignment .\\n\\n:hasSHACLConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has SHACL constraint\\\" ;\\n    rdfs:comment \\\"Links an invoice to a SHACL constraint for validation.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :SHACLConstraint .\\n\\n#################################################################\\n#   Data Properties\\n#################################################################\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of an item in a line item.\\\" ;\\n    rdfs:domain :InvoiceLineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"The total invoice amount in the summary.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal ;\\n    owl:FunctionalProperty .\\n\\n:elementCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"element code\\\" ;\\n    rdfs:comment \\\"The code of a simple data element as per EDIFACT specification.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range xsd:string ;\\n    owl:FunctionalProperty .\\n\\n:elementValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"element value\\\" ;\\n    rdfs:comment \\\"The value/content of a simple data element.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n#   Restrictions & Advanced Axioms\\n#################################################################\\n\\n# Invoice must have exactly one header, detail, and summary\\n:Invoice a owl:Class ;\\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:cardinality 1 ] .\\n\\n# OrganizationRoleAssignment must have exactly one role and organization\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRole ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality 1 ] .\\n\\n# InvoiceLineItem must have exactly one Item and Price\\n:InvoiceLineItem a owl:Class ;\\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItem ; owl:cardinality 1 ] ,\\n                    [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:cardinality 1 ] .\\n\\n# Disjointness axioms\\n:Organization owl:disjointWith :Address, :Invoice, :Item .\\n:Segment owl:disjointWith :Invoice, :Organization .\\n\\n# DisjointUnion for Identifier\\n:Identifier owl:disjointUnionOf ( :GlobalLocationNumber ) .\\n\\n#################################################################\\n#   Example Individuals (for illustration)\\n#################################################################\\n\\n:Buyer a :AgentRole ;\\n    rdfs:label \\\"Buyer\\\" ;\\n    rdfs:comment \\\"The agent role of buyer in a transaction.\\\" .\\n\\n:Seller a :AgentRole ;\\n    rdfs:label \\\"Seller\\\" ;\\n    rdfs:comment \\\"The agent role of seller in a transaction.\\\" .\\n\\n:DeliveryParty a :AgentRole ;\\n    rdfs:label \\\"Delivery Party\\\" ;\\n    rdfs:comment \\\"The agent role of delivery party in a transaction.\\\" .\\n\\n# (Further code mappings, technical vocabulary, and EDIFACT elements can be expanded as needed)\\n\"}",
