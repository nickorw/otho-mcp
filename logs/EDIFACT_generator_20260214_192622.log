      "key": "current_owl_draft",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/EDIFACTScenario>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Scenario Ontology\" ;\n    rdfs:comment \"A deep and profoundly structured ontology for representing EDIFACT invoice messages, organizations, roles, items, technical vocabulary, and business processes.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"An EDIFACT message containing segments and invoices.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"A commercial document issued by a seller to a buyer, relating to a sale transaction in the EDIFACT context.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A legal entity involved in an invoice, such as buyer or seller.\" .\n\n:OrganizationRole a owl:Class ;\n    rdfs:label \"Organization Role\" ;\n    rdfs:comment \"A role that an organization may play in the context of an invoice (e.g., buyer, seller).\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"The role of an organization as a buyer in an invoice.\" ;\n    rdfs:subClassOf :OrganizationRole .\n\n:SellerRole a owl:Class ;\n    rdfs:label \"Seller Role\" ;\n    rdfs:comment \"The role of an organization as a seller in an invoice.\" ;\n    rdfs:subClassOf :OrganizationRole .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in an invoice.\" .\n\n:InvoiceItem a owl:Class ;\n    rdfs:label \"Invoice Item\" ;\n    rdfs:comment \"An itemized entry in an invoice.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detailed information about an invoice, such as payment terms or references.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process with which an invoice can be associated.\" .\n\n:EDIFACTSegment a owl:Class ;\n    rdfs:label \"EDIFACT Segment\" ;\n    rdfs:comment \"A structural unit of an EDIFACT message, consisting of elements.\" .\n\n:EDIFACTElement a owl:Class ;\n    rdfs:label \"EDIFACT Element\" ;\n    rdfs:comment \"A data element within an EDIFACT segment.\" .\n\n:EDIFACTCode a owl:Class ;\n    rdfs:label \"EDIFACT Code\" ;\n    rdfs:comment \"A code used in EDIFACT elements for standardized values.\" .\n\n:FileFormatRequirement a owl:Class ;\n    rdfs:label \"File Format Requirement\" ;\n    rdfs:comment \"A requirement that must be fulfilled for the EDIFACT file format to be valid.\" .\n\n:InvoiceParticipation a owl:Class ;\n    rdfs:label \"Invoice Participation\" ;\n    rdfs:comment \"A pivot class reifying the participation of an organization in an invoice with a specific role.\" .\n\n:InvoiceItemDetail a owl:Class ;\n    rdfs:label \"Invoice Item Detail\" ;\n    rdfs:comment \"A pivot class reifying details about an item in an invoice, such as net price.\" .\n\n#################################################################\n# Disjoint Unions\n#################################################################\n\n:OrganizationRole owl:disjointUnionOf ( :BuyerRole :SellerRole ) .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:hasInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice\" ;\n    rdfs:comment \"Relates an EDIFACT message to an invoice.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Invoice .\n\n:hasParticipation a owl:ObjectProperty ;\n    rdfs:label \"has participation\" ;\n    rdfs:comment \"Relates an invoice to an invoice participation (organization in a role).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceParticipation .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Relates an invoice participation to the involved organization.\" ;\n    rdfs:domain :InvoiceParticipation ;\n    rdfs:range :Organization .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Relates an invoice participation to an organization role.\" ;\n    rdfs:domain :InvoiceParticipation ;\n    rdfs:range :OrganizationRole .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its postal address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates an invoice to its invoice items.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceItem .\n\n:itemDetails a owl:ObjectProperty ;\n    rdfs:label \"item details\" ;\n    rdfs:comment \"Relates an invoice item to its details (pivot class).\" ;\n    rdfs:domain :InvoiceItem ;\n    rdfs:range :InvoiceItemDetail .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Relates invoice item detail to the described item.\" ;\n    rdfs:domain :InvoiceItemDetail ;\n    rdfs:range :Item .\n\n:hasInvoiceDetail a owl:ObjectProperty ;\n    rdfs:label \"has invoice detail\" ;\n    rdfs:comment \"Relates an invoice to its detail information.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Relates an invoice to a business process.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess .\n\n:hasEDIFACTSegment a owl:ObjectProperty ;\n    rdfs:label \"has EDIFACT segment\" ;\n    rdfs:comment \"Relates an EDIFACT message to its segments.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTSegment .\n\n:hasEDIFACTElement a owl:ObjectProperty ;\n    rdfs:label \"has EDIFACT element\" ;\n    rdfs:comment \"Relates an EDIFACT segment to its elements.\" ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :EDIFACTElement .\n\n:hasEDIFACTCode a owl:ObjectProperty ;\n    rdfs:label \"has EDIFACT code\" ;\n    rdfs:comment \"Relates an EDIFACT element to its code.\" ;\n    rdfs:domain :EDIFACTElement ;\n    rdfs:range :EDIFACTCode .\n\n:hasFileFormatRequirement a owl:ObjectProperty ;\n    rdfs:label \"has file format requirement\" ;\n    rdfs:comment \"Relates an EDIFACT message to its file format requirements.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :FileFormatRequirement .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates invoice item detail to its net price.\" ;\n    rdfs:domain :InvoiceItemDetail ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Relates an invoice to its amount.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Relates an invoice to its invoice number.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string .\n\n#################################################################\n# Property Characteristics\n#################################################################\n\n:hasInvoice a owl:FunctionalProperty .\n:hasInvoiceNumber a owl:FunctionalProperty .\n:hasInvoiceAmount a owl:FunctionalProperty .\n:hasAddress a owl:FunctionalProperty .\n:involvesOrganization a owl:FunctionalProperty .\n:hasRole a owl:FunctionalProperty .\n:describesItem a owl:FunctionalProperty .\n:hasNetPrice a owl:FunctionalProperty .\n\n#################################################################\n# Restrictions and GCAs\n#################################################################\n\n:BuyerRole owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        :OrganizationRole\n        [ a owl:Restriction ;\n          owl:onProperty :hasRole ;\n          owl:allValuesFrom :BuyerRole ]\n    )\n] .\n\n:SellerRole owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        :OrganizationRole\n        [ a owl:Restriction ;\n          owl:onProperty :hasRole ;\n          owl:allValuesFrom :SellerRole ]\n    )\n] .\n\n#################################################################\n# Annotations for EDIFACT Technical Vocabulary\n#################################################################\n\n# Example: UNH segment, BGM segment, etc. (add more as needed)\n:UNH a :EDIFACTSegment ;\n    rdfs:label \"UNH Segment\" ;\n    rdfs:comment \"Message header segment in EDIFACT.\" .\n\n:BGM a :EDIFACTSegment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of message segment in EDIFACT.\" .\n\n:LIN a :EDIFACTSegment ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line item segment in EDIFACT.\" .\n\n:DTM a :EDIFACTSegment ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/time/period segment in EDIFACT.\" .\n\n# Example EDIFACT element and code\n:D_1001 a :EDIFACTElement ;\n    rdfs:label \"Document name code\" ;\n    rdfs:comment \"EDIFACT element 1001: Document name code.\" .\n\n:C_0020 a :EDIFACTElement ;\n    rdfs:label \"Document/message number\" ;\n    rdfs:comment \"EDIFACT element 0020: Document/message number.\" .\n\n:Code_380 a :EDIFACTCode ;\n    rdfs:label \"Invoice code 380\" ;\n    rdfs:comment \"EDIFACT code 380: Commercial invoice.\" .\n\n#################################################################\n# File Format Requirements (example)\n#################################################################\n:MandatoryUNH a :FileFormatRequirement ;\n    rdfs:label \"Mandatory UNH Segment\" ;\n    rdfs:comment \"The UNH segment is mandatory in a valid EDIFACT file.\" .\n"
}
