ice participation to an organization role.\\\" ;\\n    rdfs:domain :InvoiceParticipation ;\\n    rdfs:range :OrganizationRole ;\\n    owl:inverseOf :isRoleOfParticipation .\\n\\n:isRoleOfParticipation a owl:ObjectProperty ;\\n    rdfs:label \\\"is role of participation\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an organization role to an invoice participation.\\\" ;\\n    rdfs:domain :OrganizationRole ;\\n    rdfs:range :InvoiceParticipation .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Relates an organization to its postal address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    owl:inverseOf :isAddressOfOrganization .\\n\\n:isAddressOfOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"is address of organization\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an address to the organization it belongs to.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its invoice items.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceItem ;\\n    owl:inverseOf :isItemOfInvoice .\\n\\n:isItemOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"is item of invoice\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an invoice item to the invoice it is part of.\\\" ;\\n    rdfs:domain :InvoiceItem ;\\n    rdfs:range :Invoice .\\n\\n:itemDetails a owl:ObjectProperty ;\\n    rdfs:label \\\"item details\\\" ;\\n    rdfs:comment \\\"Relates an invoice item to its details (pivot class).\\\" ;\\n    rdfs:domain :InvoiceItem ;\\n    rdfs:range :InvoiceItemDetail ;\\n    owl:inverseOf :isDetailOfItem .\\n\\n:isDetailOfItem a owl:ObjectProperty ;\\n    rdfs:label \\\"is detail of item\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an invoice item detail to the invoice item.\\\" ;\\n    rdfs:domain :InvoiceItemDetail ;\\n    rdfs:range :InvoiceItem .\\n\\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Relates invoice item detail to the described item.\\\" ;\\n    rdfs:domain :InvoiceItemDetail ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isDescribedByDetail .\\n\\n:isDescribedByDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"is described by detail\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an item to the invoice item detail describing it.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceItemDetail .\\n\\n:hasInvoiceDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice detail\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its detail information.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:inverseOf :isDetailOfInvoice .\\n\\n:isDetailOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"is detail of invoice\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an invoice detail to its invoice.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :Invoice .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Relates an invoice to a business process.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess ;\\n    owl:inverseOf :isBusinessProcessOfInvoice .\\n\\n:isBusinessProcessOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"is business process of invoice\\\" ;\\n    rdfs:comment \\\"Inverse: Relates a business process to its invoice.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :Invoice .\\n\\n:hasEDIFACTSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has EDIFACT segment\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its segments.\\\" ;\\n    rdfs:domain :EDIFACTMessage ;\\n    rdfs:range :EDIFACTSegment ;\\n    owl:inverseOf :isSegmentOfMessage .\\n\\n:isSegmentOfMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"is segment of message\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an EDIFACT segment to the message it is part of.\\\" ;\\n    rdfs:domain :EDIFACTSegment ;\\n    rdfs:range :EDIFACTMessage .\\n\\n:hasEDIFACTElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has EDIFACT element\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT segment to its elements.\\\" ;\\n    rdfs:domain :EDIFACTSegment ;\\n    rdfs:range :EDIFACTElement ;\\n    owl:inverseOf :isElementOfSegment .\\n\\n:isElementOfSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"is element of segment\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an EDIFACT element to its segment.\\\" ;\\n    rdfs:domain :EDIFACTElement ;\\n    rdfs:range :EDIFACTSegment .\\n\\n:hasEDIFACTCode a owl:ObjectProperty ;\\n    rdfs:label \\\"has EDIFACT code\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT element to its code.\\\" ;\\n    rdfs:domain :EDIFACTElement ;\\n    rdfs:range :EDIFACTCode ;\\n    owl:inverseOf :isCodeOfElement .\\n\\n:isCodeOfElement a owl:ObjectProperty ;\\n    rdfs:label \\\"is code of element\\\" ;\\n    rdfs:comment \\\"Inverse: Relates a code to its EDIFACT element.\\\" ;\\n    rdfs:domain :EDIFACTCode ;\\n    rdfs:range :EDIFACTElement .\\n\\n:hasFileFormatRequirement a owl:ObjectProperty ;\\n    rdfs:label \\\"has file format requirement\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its file format requirements.\\\" ;\\n    rdfs:domain :EDIFACTMessage ;\\n    rdfs:range :FileFormatRequirement ;\\n    owl:inverseOf :isFileFormatRequirementOfMessage .\\n\\n:isFileFormatRequirementOfMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"is file format requirement of message\\\" ;\\n    rdfs:comment \\\"Inverse: Relates a file format requirement to the EDIFACT message.\\\" ;\\n    rdfs:domain :FileFormatRequirement ;\\n    rdfs:range :EDIFACTMessage .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Relates invoice item detail to its net price.\\\" ;\\n    rdfs:domain :InvoiceItemDetail ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its amount.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its invoice number.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Restrictions and GCAs (refactored)\\n#################################################################\\n# Removed recursive equivalentClass definitions for BuyerRole and SellerRole to avoid P24.\\n\\n#################################################################\\n# Annotations for EDIFACT Technical Vocabulary\\n#################################################################\\n\\n# Example: UNH segment, BGM segment, etc. (add more as needed)\\n:UNH a :EDIFACTSegment ;\\n    rdfs:label \\\"UNH Segment\\\" ;\\n    rdfs:comment \\\"Message header segment in EDIFACT.\\\" .\\n\\n:BGM a :EDIFACTSegment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of message segment in EDIFACT.\\\" .\\n\\n:LIN a :EDIFACTSegment ;\\n    rdfs:label \\\"LIN Segment\\\" ;\\n    rdfs:comment \\\"Line item segment in EDIFACT.\\\" .\\n\\n:DTM a :EDIFACTSegment ;\\n    rdfs:label \\\"DTM Segment\\\" ;\\n    rdfs:comment \\\"Date/time/period segment in EDIFACT.\\\" .\\n\\n# Example EDIFACT element and code\\n:D_1001 a :EDIFACTElement ;\\n    rdfs:label \\\"Document name code\\\" ;\\n    rdfs:comment \\\"EDIFACT element 1001: Document name code.\\\" .\\n\\n:C_0020 a :EDIFACTElement ;\\n    rdfs:label \\\"Document/message number\\\" ;\\n    rdfs:comment \\\"EDIFACT element 0020: Document/message number.\\\" .\\n\\n:Code_380 a :EDIFACTCode ;\\n    rdfs:label \\\"Invoice code 380\\\" ;\\n    rdfs:comment \\\"EDIFACT code 380: Commercial invoice.\\\" .\\n\\n#################################################################\\n# File Format Requirements (example)\\n#################################################################\\n:MandatoryUNH a :FileFormatRequirement ;\\n    rdfs:label \\\"Mandatory UNH Segment\\\" ;\\n    rdfs:comment \\\"The UNH segment is mandatory in a valid EDIFACT file.\\\" .\\n\"}",
