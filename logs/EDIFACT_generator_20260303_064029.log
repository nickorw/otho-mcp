      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#EDIFACTInvoiceOntology> a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A/EANCOM Invoice Ontology\" ;\n    rdfs:comment \"Ontology for modeling UN/EDIFACT D96A/EANCOM INVOIC messages, compliant with EN 16931-1 and P2P-O alignment.\" .\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A message within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An invoice message (e.g., INVOIC) within the interchange.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"EDIFACT Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:DTMSegment a owl:Class ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment. Mandatory for document and delivery dates.\" ;\n    rdfs:subClassOf :Segment .\n\n:PaymentTermsSegment a owl:Class ;\n    rdfs:label \"Payment Terms Segment\" ;\n    rdfs:comment \"Segment describing payment terms.\" ;\n    rdfs:subClassOf :Segment .\n\n:TaxSegment a owl:Class ;\n    rdfs:label \"Tax Segment\" ;\n    rdfs:comment \"Segment for tax breakdowns.\" ;\n    rdfs:subClassOf :Segment .\n\n:AllowanceChargeSegment a owl:Class ;\n    rdfs:label \"Allowance/Charge Segment\" ;\n    rdfs:comment \"Segment for allowances and charges.\" ;\n    rdfs:subClassOf :Segment .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section of the invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section containing line items.\" ;\n    rdfs:subClassOf :Segment .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section with totals and tax.\" ;\n    rdfs:subClassOf :Segment .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the invoice detail section.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice (buyer, supplier, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the invoice context.\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"The role of buyer in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"The role of delivery party in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address.\" .\n\n:WarehouseAddress a owl:Class ;\n    rdfs:label \"Warehouse Address\" ;\n    rdfs:comment \"A warehouse address for delivery.\" ;\n    rdfs:subClassOf :Address .\n\n:HeadquartersAddress a owl:Class ;\n    rdfs:label \"Headquarters Address\" ;\n    rdfs:comment \"The main headquarters address of an organization.\" ;\n    rdfs:subClassOf :Address .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A GLN identifying an organization.\" ;\n    rdfs:subClassOf :SimpleDataElement .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service being sold.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value for an item or invoice.\" ;\n    rdfs:subClassOf :SimpleDataElement .\n\n:NetPrice a owl:Class ;\n    rdfs:label \"Net Price\" ;\n    rdfs:comment \"The net price of a line item.\" ;\n    rdfs:subClassOf :Price .\n\n:TaxAmount a owl:Class ;\n    rdfs:label \"Tax Amount\" ;\n    rdfs:comment \"The total tax amount for the invoice.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"The total invoice amount.\" .\n\n:DocumentReference a owl:Class ;\n    rdfs:label \"Document Reference\" ;\n    rdfs:comment \"Reference to a document, such as an invoice number.\" .\n\n:BusinessProcessAssignment a owl:Class ;\n    rdfs:label \"Business Process Assignment\" ;\n    rdfs:comment \"Assignment of the invoice to a business process.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validating document structure/content.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element in a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element in a composite.\" .\n\n:EDIFACTDelimiter a owl:Class ;\n    rdfs:label \"EDIFACT Delimiter\" ;\n    rdfs:comment \"A delimiter used in EDIFACT message syntax.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Reifies the assignment of a role to an organization within a message context.\" .\n\n:InvoiceLineItemAssignment a owl:Class ;\n    rdfs:label \"Invoice Line Item Assignment\" ;\n    rdfs:comment \"Reifies assignment of line items to the invoice.\" .\n\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to a contained Message.\" .\n:containedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" .\n:segmentOfMessage a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"segment of message\" ;\n    rdfs:comment \"Inverse of hasSegment.\" ;\n    owl:inverseOf :hasSegment .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Segment ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an InvoiceMessage to its Header, Detail, and Summary sections.\" .\n:sectionOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"section of invoice\" ;\n    rdfs:comment \"Inverse of hasSection.\" ;\n    owl:inverseOf :hasSection .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links a DetailSection to its LineItems.\" .\n:lineItemOfSection a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"line item of section\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" ;\n    owl:inverseOf :hasLineItem .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an InvoiceMessage to an involved Organization.\" .\n:organizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"organization involved in\" ;\n    rdfs:comment \"Inverse of involvesOrganization.\" ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an InvoiceMessage to OrganizationRoleAssignments (pivot class for reification of organization roles).\" .\n:roleAssignmentOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"role assignment of invoice\" ;\n    rdfs:comment \"Inverse of hasRoleAssignment.\" ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links an OrganizationRoleAssignment to an AgentRole.\" .\n:roleOfAssignment a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"role of assignment\" ;\n    rdfs:comment \"Inverse of hasRole.\" ;\n    owl:inverseOf :hasRole .\n\n:forOrganization a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"for organization\" ;\n    rdfs:comment \"Links an OrganizationRoleAssignment to the Organization playing the role.\" .\n:organizationHasAssignment a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"organization has assignment\" ;\n    rdfs:comment \"Inverse of forOrganization.\" ;\n    owl:inverseOf :forOrganization .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to its Address.\" .\n:addressOfOrganization a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"address of organization\" ;\n    rdfs:comment \"Inverse of hasAddress.\" ;\n    owl:inverseOf :hasAddress .\n\n:hasGlobalLocationNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"The Global Location Number identifying the organization.\" .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a LineItem to the sold Item.\" .\n:itemOfLineItem a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"item of line item\" ;\n    rdfs:comment \"Inverse of hasItem.\" ;\n    owl:inverseOf :hasItem .\n\n:hasNetPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :NetPrice ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a LineItem to its net price.\" .\n:netPriceOfLineItem a owl:ObjectProperty ;\n    rdfs:domain :NetPrice ;\n    rdfs:range :LineItem ;\n    rdfs:label \"net price of line item\" ;\n    rdfs:comment \"Inverse of hasNetPrice.\" ;\n    owl:inverseOf :hasNetPrice .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of items in a LineItem.\" .\n\n:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceAmount ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Links the SummarySection to the total invoice amount.\" .\n:invoiceAmountOfSummary a owl:ObjectProperty ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"invoice amount of summary\" ;\n    rdfs:comment \"Inverse of hasInvoiceAmount.\" ;\n    owl:inverseOf :hasInvoiceAmount .\n\n:hasTaxAmount a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :TaxAmount ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"Links the SummarySection to the total tax amount.\" .\n:taxAmountOfSummary a owl:ObjectProperty ;\n    rdfs:domain :TaxAmount ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"tax amount of summary\" ;\n    rdfs:comment \"Inverse of hasTaxAmount.\" ;\n    owl:inverseOf :hasTaxAmount .\n\n:hasDocumentReference a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :DocumentReference ;\n    rdfs:label \"has document reference\" ;\n    rdfs:comment \"Links the HeaderSection to document references such as invoice number.\" .\n:documentReferenceOfHeader a owl:ObjectProperty ;\n    rdfs:domain :DocumentReference ;\n    rdfs:range :HeaderSection ;\n    rdfs:label \"document reference of header\" ;\n    rdfs:comment \"Inverse of hasDocumentReference.\" ;\n    owl:inverseOf :hasDocumentReference .\n\n:hasReferenceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :DocumentReference ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Reference number for a document (e.g., invoice number).\" .\n\n:hasDateQualifier a owl:DatatypeProperty ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has date qualifier\" ;\n    rdfs:comment \"Qualifier indicating the type of date (e.g., document date, delivery date).\" .\n\n:hasDateValue a owl:DatatypeProperty ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has date value\" ;\n    rdfs:comment \"Date value in the DTM segment.\" .\n\n:hasDate a owl:DatatypeProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"Date associated with the document.\" .\n\n:isAssignedTo a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLineItemAssignment ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is assigned to\" ;\n    rdfs:comment \"Links a pivot assignment to a LineItem.\" .\n:assignmentOfLineItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceLineItemAssignment ;\n    rdfs:label \"assignment of line item\" ;\n    rdfs:comment \"Inverse of isAssignedTo.\" ;\n    owl:inverseOf :isAssignedTo .\n\n:hasBusinessProcessAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcessAssignment ;\n    rdfs:label \"has business process assignment\" ;\n    rdfs:comment \"Links an InvoiceMessage to a BusinessProcessAssignment.\" .\n:businessProcessAssignmentOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcessAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"business process assignment of invoice\" ;\n    rdfs:comment \"Inverse of hasBusinessProcessAssignment.\" ;\n    owl:inverseOf :hasBusinessProcessAssignment .\n\n:hasValidationConstraint a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    rdfs:label \"has validation constraint\" ;\n    rdfs:comment \"Links an InvoiceMessage to a ValidationConstraint (for SHACL-style validation knowledge).\" .\n:validationConstraintOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"validation constraint of invoice\" ;\n    rdfs:comment \"Inverse of hasValidationConstraint.\" ;\n    owl:inverseOf :hasValidationConstraint .\n\n:hasCompositeDataElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite data element\" ;\n    rdfs:comment \"Links a Segment to its CompositeDataElements.\" .\n:compositeDataElementOfSegment a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"composite data element of segment\" ;\n    rdfs:comment \"Inverse of hasCompositeDataElement.\" ;\n    owl:inverseOf :hasCompositeDataElement .\n\n:hasSimpleDataElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Links a CompositeDataElement to its SimpleDataElements.\" .\n:simpleDataElementOfComposite a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"simple data element of composite\" ;\n    rdfs:comment \"Inverse of hasSimpleDataElement.\" ;\n    owl:inverseOf :hasSimpleDataElement .\n\n:hasDelimiter a owl:ObjectProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :EDIFACTDelimiter ;\n    rdfs:label \"has delimiter\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to its delimiter definitions.\" .\n:delimiterOfEnvelope a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTDelimiter ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"delimiter of envelope\" ;\n    rdfs:comment \"Inverse of hasDelimiter.\" ;\n    owl:inverseOf :hasDelimiter .\n\n:hasPaymentTerms a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :PaymentTermsSegment ;\n    rdfs:label \"has payment terms\" ;\n    rdfs:comment \"Links an InvoiceMessage to its PaymentTerms segment.\" .\n:paymentTermsOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :PaymentTermsSegment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"payment terms of invoice\" ;\n    rdfs:comment \"Inverse of hasPaymentTerms.\" ;\n    owl:inverseOf :hasPaymentTerms .\n\n:hasTaxSegment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :TaxSegment ;\n    rdfs:label \"has tax segment\" ;\n    rdfs:comment \"Links an InvoiceMessage to its Tax segment for breakdowns.\" .\n:taxSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :TaxSegment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"tax segment of invoice\" ;\n    rdfs:comment \"Inverse of hasTaxSegment.\" ;\n    owl:inverseOf :hasTaxSegment .\n\n:hasAllowanceCharge a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :AllowanceChargeSegment ;\n    rdfs:label \"has allowance/charge\" ;\n    rdfs:comment \"Links an InvoiceMessage to Allowance/Charge segments.\" .\n:allowanceChargeOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :AllowanceChargeSegment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"allowance/charge of invoice\" ;\n    rdfs:comment \"Inverse of hasAllowanceCharge.\" ;\n    owl:inverseOf :hasAllowanceCharge .\n\n:BGMSegment owl:disjointWith :NADSegment, :DTMSegment, :PaymentTermsSegment, :TaxSegment, :AllowanceChargeSegment .\n:NADSegment owl:disjointWith :DTMSegment, :PaymentTermsSegment, :TaxSegment, :AllowanceChargeSegment .\n:DTMSegment owl:disjointWith :PaymentTermsSegment, :TaxSegment, :AllowanceChargeSegment .\n:PaymentTermsSegment owl:disjointWith :TaxSegment, :AllowanceChargeSegment .\n:TaxSegment owl:disjointWith :AllowanceChargeSegment .\n\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\n:WarehouseAddress owl:disjointWith :HeadquartersAddress .\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n\n:AgentRole owl:disjointUnionOf (:BuyerRole :DeliveryPartyRole) .\n"
}
