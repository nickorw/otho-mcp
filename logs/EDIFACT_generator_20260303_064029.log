2026-03-03 06:48:58 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACT_INVOIC_StoryOntology rdf:type owl:Ontology ;\n  rdfs:label \"EDIFACT INVOIC Ontology for E/D/E Industrial Procurement\" ;\n  rdfs:comment \"A deep and profoundly structured OWL ontology representing the full EDIFACT D96A INVOIC message, including all mandatory segments, segment groups, business roles, and procurement context for semantic interoperability.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope rdf:type owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"EDIFACT envelope containing one or more messages.\" .\n\n:Message rdf:type owl:Class ;\n  rdfs:label \"EDIFACT Message\" ;\n  rdfs:comment \"A business document within an interchange envelope, e.g., INVOIC.\" .\n\n:Invoice rdf:type owl:Class ;\n  rdfs:label \"Invoice\" ;\n  rdfs:comment \"A commercial invoice message, compliant with EN 16931-1 and P2P-O.\" .\n\n:Segment rdf:type owl:Class ;\n  rdfs:label \"EDIFACT Segment\" ;\n  rdfs:comment \"Atomic structural unit in EDIFACT messages, e.g., BGM, NAD, LIN.\" .\n\n:BGM_Segment rdf:type owl:Class ;\n  rdfs:label \"Beginning of Message Segment (BGM)\" ;\n  rdfs:comment \"Identifies the type and number of the message.\" ;\n  rdfs:subClassOf :Segment .\n\n:NAD_Segment rdf:type owl:Class ;\n  rdfs:label \"Name and Address Segment (NAD)\" ;\n  rdfs:comment \"Details of organizations and their roles in the transaction.\" ;\n  rdfs:subClassOf :Segment .\n\n:DTM_Segment rdf:type owl:Class ;\n  rdfs:label \"Date/Time/Period Segment (DTM)\" ;\n  rdfs:comment \"Captures dates/times with EDIFACT qualifiers.\" ;\n  rdfs:subClassOf :Segment .\n\n:MOA_Segment rdf:type owl:Class ;\n  rdfs:label \"Monetary Amount Segment (MOA)\" ;\n  rdfs:comment \"Monetary breakdowns, totals, and amounts.\" ;\n  rdfs:subClassOf :Segment .\n\n:RFF_Segment rdf:type owl:Class ;\n  rdfs:label \"Reference Segment (RFF)\" ;\n  rdfs:comment \"References to related documents, e.g., PO, Delivery Note.\" ;\n  rdfs:subClassOf :Segment .\n\n:TAX_Segment rdf:type owl:Class ;\n  rdfs:label \"Tax Segment (TAX)\" ;\n  rdfs:comment \"Tax details, rates, and types.\" ;\n  rdfs:subClassOf :Segment .\n\n:MEA_Segment rdf:type owl:Class ;\n  rdfs:label \"Measurement Segment (MEA)\" ;\n  rdfs:comment \"Measurements relevant to items or logistics.\" ;\n  rdfs:subClassOf :Segment .\n\n:QTY_Segment rdf:type owl:Class ;\n  rdfs:label \"Quantity Segment (QTY)\" ;\n  rdfs:comment \"Quantities for items or totals.\" ;\n  rdfs:subClassOf :Segment .\n\n:ALC_Segment rdf:type owl:Class ;\n  rdfs:label \"Allowance/Charge Segment (ALC)\" ;\n  rdfs:comment \"Details of allowances and charges.\" ;\n  rdfs:subClassOf :Segment .\n\n:CUX_Segment rdf:type owl:Class ;\n  rdfs:label \"Currency Segment (CUX)\" ;\n  rdfs:comment \"Currency details for the invoice.\" ;\n  rdfs:subClassOf :Segment .\n\n:PRI_Segment rdf:type owl:Class ;\n  rdfs:label \"Price Segment (PRI)\" ;\n  rdfs:comment \"Price details for line items.\" ;\n  rdfs:subClassOf :Segment .\n\n:IMD_Segment rdf:type owl:Class ;\n  rdfs:label \"Item Description Segment (IMD)\" ;\n  rdfs:comment \"Describes items in detail.\" ;\n  rdfs:subClassOf :Segment .\n\n:LIN_Segment rdf:type owl:Class ;\n  rdfs:label \"Line Item Number Segment (LIN)\" ;\n  rdfs:comment \"Anchor for line item hierarchy and numbering.\" ;\n  rdfs:subClassOf :Segment .\n\n:PIA_Segment rdf:type owl:Class ;\n  rdfs:label \"Additional Product Identification Segment (PIA)\" ;\n  rdfs:comment \"Additional identifiers for products.\" ;\n  rdfs:subClassOf :Segment .\n\n:PAC_Segment rdf:type owl:Class ;\n  rdfs:label \"Packaging Segment (PAC)\" ;\n  rdfs:comment \"Packaging details for items.\" ;\n  rdfs:subClassOf :Segment .\n\n:LOC_Segment rdf:type owl:Class ;\n  rdfs:label \"Location Segment (LOC)\" ;\n  rdfs:comment \"Location details for delivery, warehouse, etc.\" ;\n  rdfs:subClassOf :Segment .\n\n:DOC_Segment rdf:type owl:Class ;\n  rdfs:label \"Document/Message Details Segment (DOC)\" ;\n  rdfs:comment \"Document or message references and context.\" ;\n  rdfs:subClassOf :Segment .\n\n:UNS_Segment rdf:type owl:Class ;\n  rdfs:label \"Section Control Segment (UNS)\" ;\n  rdfs:comment \"Marks transition from detail to summary section.\" ;\n  rdfs:subClassOf :Segment .\n\n:CNT_Segment rdf:type owl:Class ;\n  rdfs:label \"Control Total Segment (CNT)\" ;\n  rdfs:comment \"Totals for control and validation.\" ;\n  rdfs:subClassOf :Segment .\n\n:CTA_Segment rdf:type owl:Class ;\n  rdfs:label \"Contact Segment (CTA)\" ;\n  rdfs:comment \"Contact details for organizations.\" ;\n  rdfs:subClassOf :Segment .\n\n:COM_Segment rdf:type owl:Class ;\n  rdfs:label \"Communication Segment (COM)\" ;\n  rdfs:comment \"Communication details (phone, email, etc.).\" ;\n  rdfs:subClassOf :Segment .\n\n:TDT_Segment rdf:type owl:Class ;\n  rdfs:label \"Transport Segment (TDT)\" ;\n  rdfs:comment \"Transport details for delivery.\" ;\n  rdfs:subClassOf :Segment .\n\n:TOD_Segment rdf:type owl:Class ;\n  rdfs:label \"Terms of Delivery Segment (TOD)\" ;\n  rdfs:comment \"Terms and conditions for delivery.\" ;\n  rdfs:subClassOf :Segment .\n\n:SG2_ReferenceGroup rdf:type owl:Class ;\n  rdfs:label \"Segment Group 2: Reference Group (RFF+DTM)\" ;\n  rdfs:comment \"Repeating group for document references and dates.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:SG6_TaxGroup rdf:type owl:Class ;\n  rdfs:label \"Segment Group 6: Tax Group (TAX+MOA)\" ;\n  rdfs:comment \"Repeating group for header tax and monetary details.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:SG8_AllowanceChargeGroup rdf:type owl:Class ;\n  rdfs:label \"Segment Group 8: Allowance/Charge Group (ALC+MOA)\" ;\n  rdfs:comment \"Repeating group for header allowances/charges.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:CompositeDataElement rdf:type owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite element grouping multiple simple elements.\" .\n\n:SimpleDataElement rdf:type owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A single atomic value in a segment.\" .\n\n:Organization rdf:type owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"A company or party involved in the invoice.\" .\n\n:AgentRole rdf:type owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"Role played by an organization in the invoice.\" .\n\n:Buyer rdf:type owl:Class ;\n  rdfs:label \"Buyer\" ;\n  rdfs:comment \"The organization acting as buyer.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:Supplier rdf:type owl:Class ;\n  rdfs:label \"Supplier\" ;\n  rdfs:comment \"The organization acting as supplier.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:DeliveryParty rdf:type owl:Class ;\n  rdfs:label \"Delivery Party\" ;\n  rdfs:comment \"The organization acting as delivery party.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:OrganizationRoleAssignment rdf:type owl:Class ;\n  rdfs:label \"Organization Role Assignment\" ;\n  rdfs:comment \"Reified relation linking an organization to its role for a given invoice.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:Address rdf:type owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"Address (headquarters, warehouse, etc.) for organizations.\" .\n\n:GlobalLocationNumber rdf:type owl:Class ;\n  rdfs:label \"Global Location Number\" ;\n  rdfs:comment \"Identifier for organization locations.\" .\n\n:HeaderSection rdf:type owl:Class ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Header section of the invoice message.\" ;\n  rdfs:subClassOf :Message .\n\n:DetailSection rdf:type owl:Class ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Detail section listing line items.\" ;\n  rdfs:subClassOf :Message .\n\n:SummarySection rdf:type owl:Class ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Summary section with totals, taxes, and summary data.\" ;\n  rdfs:subClassOf :Message .\n\n:LineItem rdf:type owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A single invoice line, anchored by LIN_Segment.\" ;\n  rdfs:subClassOf :DetailSection .\n\n:Item rdf:type owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"Product or service sold in the invoice.\" .\n\n:Price rdf:type owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"Price details for an item.\" .\n\n:Quantity rdf:type owl:Class ;\n  rdfs:label \"Quantity\" ;\n  rdfs:comment \"Quantity of item sold.\" .\n\n:Tax rdf:type owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"Tax applicable to the invoice or line item.\" .\n\n:ReferenceNumber rdf:type owl:Class ;\n  rdfs:label \"Reference Number\" ;\n  rdfs:comment \"Reference number for invoice, PO, etc.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"Business process context for the invoice.\" .\n\n:InvoiceAmount rdf:type owl:Class ;\n  rdfs:label \"Invoice Amount\" ;\n  rdfs:comment \"Total amount for the invoice.\" .\n\n:InvoiceNumber rdf:type owl:Class ;\n  rdfs:label \"Invoice Number\" ;\n  rdfs:comment \"Unique identifier for the invoice.\" .\n\n#################################################################\n# Properties\n#################################################################\n\n:containsMessage rdf:type owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Envelope contains one or more messages.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Message includes segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasSection rdf:type owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Message includes header, detail, and summary sections.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :HeaderSection, :DetailSection, :SummarySection .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Detail section includes line items.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n\n:hasLIN rdf:type owl:ObjectProperty ;\n  rdfs:label \"has LIN segment\" ;\n  rdfs:comment \"Line item is anchored by a LIN segment.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :LIN_Segment .\n\n:hasPIA rdf:type owl:ObjectProperty ;\n  rdfs:label \"has PIA segment\" ;\n  rdfs:comment \"Line item has additional product identification.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PIA_Segment .\n\n:hasPAC rdf:type owl:ObjectProperty ;\n  rdfs:label \"has PAC segment\" ;\n  rdfs:comment \"Line item has packaging details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PAC_Segment .\n\n:hasLOC rdf:type owl:ObjectProperty ;\n  rdfs:label \"has LOC segment\" ;\n  rdfs:comment \"Line item has location details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :LOC_Segment .\n\n:hasDOC rdf:type owl:ObjectProperty ;\n  rdfs:label \"has DOC segment\" ;\n  rdfs:comment \"Header section includes document/message details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :DOC_Segment .\n\n:hasUNS rdf:type owl:ObjectProperty ;\n  rdfs:label \"has UNS segment\" ;\n  rdfs:comment \"Summary section includes UNS segment for section control.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :UNS_Segment .\n\n:hasCNT rdf:type owl:ObjectProperty ;\n  rdfs:label \"has CNT segment\" ;\n  rdfs:comment \"Summary section includes CNT segment for control totals.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :CNT_Segment .\n\n:hasItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Line item references the sold item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n\n:hasNetPrice rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Net price for a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:hasQuantity rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Quantity for a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:integer .\n\n:hasInvoiceAmount rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Invoice total amount.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasInvoiceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"Invoice unique number.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasTax rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Tax amount for summary section.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasReferenceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Reference number in header section.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasDate rdf:type owl:ObjectProperty ;\n  rdfs:label \"has date segment\" ;\n  rdfs:comment \"Header section includes date/time/period segment.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :DTM_Segment .\n\n:hasOrganization rdf:type owl:ObjectProperty ;\n  rdfs:label \"has organization\" ;\n  rdfs:comment \"Invoice includes participating organizations.\" ;\n  rdfs:domain :Invoice ;\n  rdfs:range :Organization .\n\n:hasAgentRoleAssignment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has agent role assignment\" ;\n  rdfs:comment \"Organization has assigned roles for invoice context.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleAssignment .\n\n:playsRole rdf:type owl:ObjectProperty ;\n  rdfs:label \"plays role\" ;\n  rdfs:comment \"Organization role assignment links to a role.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Organization has a specific address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasGLN rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has GLN\" ;\n  rdfs:comment \"Organization's global location number.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string .\n\n:hasBusinessProcess rdf:type owl:ObjectProperty ;\n  rdfs:label \"has business process\" ;\n  rdfs:comment \"Invoice is assigned to a business process.\" ;\n  rdfs:domain :Invoice ;\n  rdfs:range :BusinessProcess .\n\n:hasMonetaryAmount rdf:type owl:ObjectProperty ;\n  rdfs:label \"has monetary amount segment\" ;\n  rdfs:comment \"Summary section has monetary breakdowns.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :MOA_Segment .\n\n:hasLineMonetaryAmount rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line monetary amount segment\" ;\n  rdfs:comment \"Line item has monetary breakdowns.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :MOA_Segment .\n\n:hasReference rdf:type owl:ObjectProperty ;\n  rdfs:label \"has reference segment\" ;\n  rdfs:comment \"Header section references related documents.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :RFF_Segment .\n\n:hasTaxDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has tax segment\" ;\n  rdfs:comment \"Summary section has tax details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :TAX_Segment .\n\n:hasLineTaxDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line tax segment\" ;\n  rdfs:comment \"Line item has tax details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :TAX_Segment .\n\n:hasMeasurement rdf:type owl:ObjectProperty ;\n  rdfs:label \"has measurement segment\" ;\n  rdfs:comment \"Line item has measurement details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :MEA_Segment .\n\n:hasQuantityDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has quantity segment\" ;\n  rdfs:comment \"Line item has quantity details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :QTY_Segment .\n\n:hasAllowanceOrCharge rdf:type owl:ObjectProperty ;\n  rdfs:label \"has allowance/charge segment\" ;\n  rdfs:comment \"Summary section has allowance/charge details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :ALC_Segment .\n\n:hasHeaderAllowanceOrCharge rdf:type owl:ObjectProperty ;\n  rdfs:label \"has header allowance/charge group\" ;\n  rdfs:comment \"Header section has allowance/charge group (SG8).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :SG8_AllowanceChargeGroup .\n\n:hasHeaderTax rdf:type owl:ObjectProperty ;\n  rdfs:label \"has header tax group\" ;\n  rdfs:comment \"Header section has tax group (SG6).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :SG6_TaxGroup .\n\n:hasReferenceGroup rdf:type owl:ObjectProperty ;\n  rdfs:label \"has reference group\" ;\n  rdfs:comment \"Header section has reference group (SG2).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :SG2_ReferenceGroup .\n\n:hasCurrency rdf:type owl:ObjectProperty ;\n  rdfs:label \"has currency segment\" ;\n  rdfs:comment \"Header section has currency details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :CUX_Segment .\n\n:hasPriceDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has price segment\" ;\n  rdfs:comment \"Line item has price details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PRI_Segment .\n\n:hasItemDescription rdf:type owl:ObjectProperty ;\n  rdfs:label \"has item description segment\" ;\n  rdfs:comment \"Line item has item description details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :IMD_Segment .\n\n:hasContact rdf:type owl:ObjectProperty ;\n  rdfs:label \"has contact segment\" ;\n  rdfs:comment \"Header section has contact details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :CTA_Segment .\n\n:hasCommunication rdf:type owl:ObjectProperty ;\n  rdfs:label \"has communication segment\" ;\n  rdfs:comment \"Contact segment has communication details.\" ;\n  rdfs:domain :CTA_Segment ;\n  rdfs:range :COM_Segment .\n\n:hasTransport rdf:type owl:ObjectProperty ;\n  rdfs:label \"has transport segment\" ;\n  rdfs:comment \"Header section has transport details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :TDT_Segment .\n\n:hasTermsOfDelivery rdf:type owl:ObjectProperty ;\n  rdfs:label \"has terms of delivery segment\" ;\n  rdfs:comment \"Header section has terms of delivery details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :TOD_Segment .\n\n#################################################################\n# Advanced Axioms & Restrictions\n#################################################################\n\n:LineItem rdf:type owl:Class ;\n  owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasLIN ; owl:allValuesFrom :LIN_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom xsd:decimal ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:allValuesFrom xsd:integer ] .\n\n:OrganizationRoleAssignment rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ] .\n\n:Invoice rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasBusinessProcess ; owl:allValuesFrom :BusinessProcess ] .\n\n:HeaderSection rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasDate ; owl:someValuesFrom :DTM_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasReferenceGroup ; owl:someValuesFrom :SG2_ReferenceGroup ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasHeaderTax ; owl:someValuesFrom :SG6_TaxGroup ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasHeaderAllowanceOrCharge ; owl:someValuesFrom :SG8_AllowanceChargeGroup ] .\n\n:SummarySection rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasUNS ; owl:allValuesFrom :UNS_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasCNT ; owl:allValuesFrom :CNT_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasMonetaryAmount ; owl:someValuesFrom :MOA_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasTaxDetail ; owl:someValuesFrom :TAX_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasAllowanceOrCharge ; owl:someValuesFrom :ALC_Segment ] .\n\n#################################################################\n# Property Characteristics (FunctionalProperty, etc.)\n#################################################################\n\n:hasGLN rdf:type owl:FunctionalProperty .\n:hasAddress rdf:type owl:FunctionalProperty .\n:containsMessage rdf:type owl:FunctionalProperty .\n:hasLIN rdf:type owl:FunctionalProperty .\n:hasUNS rdf:type owl:FunctionalProperty .\n:hasCNT rdf:type owl:FunctionalProperty .\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\n:hasInvoiceAmount rdf:type owl:FunctionalProperty .\n:hasNetPrice rdf:type owl:FunctionalProperty .\n:hasQuantity rdf:type owl:FunctionalProperty .\n:hasBusinessProcess rdf:type owl:FunctionalProperty .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection .\n:DetailSection owl:disjointWith :SummarySection .\n:SummarySection owl:disjointWith :HeaderSection .\n:Organization owl:disjointWith :Address .\n:Segment owl:disjointWith :CompositeDataElement .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n\n#################################################################\n# Annotations (rdfs:label, rdfs:comment for all classes/properties)\n#################################################################\n# (Already included above for all classes and properties)\n"
}
2026-03-03 06:48:58 | DEBUG    |   Tool 2: check_pitfalls_tool
2026-03-03 06:48:58 | DEBUG    |     ID: call_J2AvP4wiCrEpu17fiw45MUtJ
2026-03-03 06:48:58 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACT_INVOIC_StoryOntology rdf:type owl:Ontology ;\n  rdfs:label \"EDIFACT INVOIC Ontology for E/D/E Industrial Procurement\" ;\n  rdfs:comment \"A deep and profoundly structured OWL ontology representing the full EDIFACT D96A INVOIC message, including all mandatory segments, segment groups, business roles, and procurement context for semantic interoperability.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope rdf:type owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"EDIFACT envelope containing one or more messages.\" .\n\n:Message rdf:type owl:Class ;\n  rdfs:label \"EDIFACT Message\" ;\n  rdfs:comment \"A business document within an interchange envelope, e.g., INVOIC.\" .\n\n:Invoice rdf:type owl:Class ;\n  rdfs:label \"Invoice\" ;\n  rdfs:comment \"A commercial invoice message, compliant with EN 16931-1 and P2P-O.\" .\n\n:Segment rdf:type owl:Class ;\n  rdfs:label \"EDIFACT Segment\" ;\n  rdfs:comment \"Atomic structural unit in EDIFACT messages, e.g., BGM, NAD, LIN.\" .\n\n:BGM_Segment rdf:type owl:Class ;\n  rdfs:label \"Beginning of Message Segment (BGM)\" ;\n  rdfs:comment \"Identifies the type and number of the message.\" ;\n  rdfs:subClassOf :Segment .\n\n:NAD_Segment rdf:type owl:Class ;\n  rdfs:label \"Name and Address Segment (NAD)\" ;\n  rdfs:comment \"Details of organizations and their roles in the transaction.\" ;\n  rdfs:subClassOf :Segment .\n\n:DTM_Segment rdf:type owl:Class ;\n  rdfs:label \"Date/Time/Period Segment (DTM)\" ;\n  rdfs:comment \"Captures dates/times with EDIFACT qualifiers.\" ;\n  rdfs:subClassOf :Segment .\n\n:MOA_Segment rdf:type owl:Class ;\n  rdfs:label \"Monetary Amount Segment (MOA)\" ;\n  rdfs:comment \"Monetary breakdowns, totals, and amounts.\" ;\n  rdfs:subClassOf :Segment .\n\n:RFF_Segment rdf:type owl:Class ;\n  rdfs:label \"Reference Segment (RFF)\" ;\n  rdfs:comment \"References to related documents, e.g., PO, Delivery Note.\" ;\n  rdfs:subClassOf :Segment .\n\n:TAX_Segment rdf:type owl:Class ;\n  rdfs:label \"Tax Segment (TAX)\" ;\n  rdfs:comment \"Tax details, rates, and types.\" ;\n  rdfs:subClassOf :Segment .\n\n:MEA_Segment rdf:type owl:Class ;\n  rdfs:label \"Measurement Segment (MEA)\" ;\n  rdfs:comment \"Measurements relevant to items or logistics.\" ;\n  rdfs:subClassOf :Segment .\n\n:QTY_Segment rdf:type owl:Class ;\n  rdfs:label \"Quantity Segment (QTY)\" ;\n  rdfs:comment \"Quantities for items or totals.\" ;\n  rdfs:subClassOf :Segment .\n\n:ALC_Segment rdf:type owl:Class ;\n  rdfs:label \"Allowance/Charge Segment (ALC)\" ;\n  rdfs:comment \"Details of allowances and charges.\" ;\n  rdfs:subClassOf :Segment .\n\n:CUX_Segment rdf:type owl:Class ;\n  rdfs:label \"Currency Segment (CUX)\" ;\n  rdfs:comment \"Currency details for the invoice.\" ;\n  rdfs:subClassOf :Segment .\n\n:PRI_Segment rdf:type owl:Class ;\n  rdfs:label \"Price Segment (PRI)\" ;\n  rdfs:comment \"Price details for line items.\" ;\n  rdfs:subClassOf :Segment .\n\n:IMD_Segment rdf:type owl:Class ;\n  rdfs:label \"Item Description Segment (IMD)\" ;\n  rdfs:comment \"Describes items in detail.\" ;\n  rdfs:subClassOf :Segment .\n\n:LIN_Segment rdf:type owl:Class ;\n  rdfs:label \"Line Item Number Segment (LIN)\" ;\n  rdfs:comment \"Anchor for line item hierarchy and numbering.\" ;\n  rdfs:subClassOf :Segment .\n\n:PIA_Segment rdf:type owl:Class ;\n  rdfs:label \"Additional Product Identification Segment (PIA)\" ;\n  rdfs:comment \"Additional identifiers for products.\" ;\n  rdfs:subClassOf :Segment .\n\n:PAC_Segment rdf:type owl:Class ;\n  rdfs:label \"Packaging Segment (PAC)\" ;\n  rdfs:comment \"Packaging details for items.\" ;\n  rdfs:subClassOf :Segment .\n\n:LOC_Segment rdf:type owl:Class ;\n  rdfs:label \"Location Segment (LOC)\" ;\n  rdfs:comment \"Location details for delivery, warehouse, etc.\" ;\n  rdfs:subClassOf :Segment .\n\n:DOC_Segment rdf:type owl:Class ;\n  rdfs:label \"Document/Message Details Segment (DOC)\" ;\n  rdfs:comment \"Document or message references and context.\" ;\n  rdfs:subClassOf :Segment .\n\n:UNS_Segment rdf:type owl:Class ;\n  rdfs:label \"Section Control Segment (UNS)\" ;\n  rdfs:comment \"Marks transition from detail to summary section.\" ;\n  rdfs:subClassOf :Segment .\n\n:CNT_Segment rdf:type owl:Class ;\n  rdfs:label \"Control Total Segment (CNT)\" ;\n  rdfs:comment \"Totals for control and validation.\" ;\n  rdfs:subClassOf :Segment .\n\n:CTA_Segment rdf:type owl:Class ;\n  rdfs:label \"Contact Segment (CTA)\" ;\n  rdfs:comment \"Contact details for organizations.\" ;\n  rdfs:subClassOf :Segment .\n\n:COM_Segment rdf:type owl:Class ;\n  rdfs:label \"Communication Segment (COM)\" ;\n  rdfs:comment \"Communication details (phone, email, etc.).\" ;\n  rdfs:subClassOf :Segment .\n\n:TDT_Segment rdf:type owl:Class ;\n  rdfs:label \"Transport Segment (TDT)\" ;\n  rdfs:comment \"Transport details for delivery.\" ;\n  rdfs:subClassOf :Segment .\n\n:TOD_Segment rdf:type owl:Class ;\n  rdfs:label \"Terms of Delivery Segment (TOD)\" ;\n  rdfs:comment \"Terms and conditions for delivery.\" ;\n  rdfs:subClassOf :Segment .\n\n:SG2_ReferenceGroup rdf:type owl:Class ;\n  rdfs:label \"Segment Group 2: Reference Group (RFF+DTM)\" ;\n  rdfs:comment \"Repeating group for document references and dates.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:SG6_TaxGroup rdf:type owl:Class ;\n  rdfs:label \"Segment Group 6: Tax Group (TAX+MOA)\" ;\n  rdfs:comment \"Repeating group for header tax and monetary details.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:SG8_AllowanceChargeGroup rdf:type owl:Class ;\n  rdfs:label \"Segment Group 8: Allowance/Charge Group (ALC+MOA)\" ;\n  rdfs:comment \"Repeating group for header allowances/charges.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:CompositeDataElement rdf:type owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite element grouping multiple simple elements.\" .\n\n:SimpleDataElement rdf:type owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A single atomic value in a segment.\" .\n\n:Organization rdf:type owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"A company or party involved in the invoice.\" .\n\n:AgentRole rdf:type owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"Role played by an organization in the invoice.\" .\n\n:Buyer rdf:type owl:Class ;\n  rdfs:label \"Buyer\" ;\n  rdfs:comment \"The organization acting as buyer.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:Supplier rdf:type owl:Class ;\n  rdfs:label \"Supplier\" ;\n  rdfs:comment \"The organization acting as supplier.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:DeliveryParty rdf:type owl:Class ;\n  rdfs:label \"Delivery Party\" ;\n  rdfs:comment \"The organization acting as delivery party.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:OrganizationRoleAssignment rdf:type owl:Class ;\n  rdfs:label \"Organization Role Assignment\" ;\n  rdfs:comment \"Reified relation linking an organization to its role for a given invoice.\" ;\n  rdfs:subClassOf :AgentRole .\n\n:Address rdf:type owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"Address (headquarters, warehouse, etc.) for organizations.\" .\n\n:GlobalLocationNumber rdf:type owl:Class ;\n  rdfs:label \"Global Location Number\" ;\n  rdfs:comment \"Identifier for organization locations.\" .\n\n:HeaderSection rdf:type owl:Class ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Header section of the invoice message.\" ;\n  rdfs:subClassOf :Message .\n\n:DetailSection rdf:type owl:Class ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Detail section listing line items.\" ;\n  rdfs:subClassOf :Message .\n\n:SummarySection rdf:type owl:Class ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Summary section with totals, taxes, and summary data.\" ;\n  rdfs:subClassOf :Message .\n\n:LineItem rdf:type owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A single invoice line, anchored by LIN_Segment.\" ;\n  rdfs:subClassOf :DetailSection .\n\n:Item rdf:type owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"Product or service sold in the invoice.\" .\n\n:Price rdf:type owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"Price details for an item.\" .\n\n:Quantity rdf:type owl:Class ;\n  rdfs:label \"Quantity\" ;\n  rdfs:comment \"Quantity of item sold.\" .\n\n:Tax rdf:type owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"Tax applicable to the invoice or line item.\" .\n\n:ReferenceNumber rdf:type owl:Class ;\n  rdfs:label \"Reference Number\" ;\n  rdfs:comment \"Reference number for invoice, PO, etc.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"Business process context for the invoice.\" .\n\n:InvoiceAmount rdf:type owl:Class ;\n  rdfs:label \"Invoice Amount\" ;\n  rdfs:comment \"Total amount for the invoice.\" .\n\n:InvoiceNumber rdf:type owl:Class ;\n  rdfs:label \"Invoice Number\" ;\n  rdfs:comment \"Unique identifier for the invoice.\" .\n\n#################################################################\n# Properties\n#################################################################\n\n:containsMessage rdf:type owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Envelope contains one or more messages.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Message includes segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasSection rdf:type owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Message includes header, detail, and summary sections.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :HeaderSection, :DetailSection, :SummarySection .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Detail section includes line items.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n\n:hasLIN rdf:type owl:ObjectProperty ;\n  rdfs:label \"has LIN segment\" ;\n  rdfs:comment \"Line item is anchored by a LIN segment.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :LIN_Segment .\n\n:hasPIA rdf:type owl:ObjectProperty ;\n  rdfs:label \"has PIA segment\" ;\n  rdfs:comment \"Line item has additional product identification.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PIA_Segment .\n\n:hasPAC rdf:type owl:ObjectProperty ;\n  rdfs:label \"has PAC segment\" ;\n  rdfs:comment \"Line item has packaging details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PAC_Segment .\n\n:hasLOC rdf:type owl:ObjectProperty ;\n  rdfs:label \"has LOC segment\" ;\n  rdfs:comment \"Line item has location details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :LOC_Segment .\n\n:hasDOC rdf:type owl:ObjectProperty ;\n  rdfs:label \"has DOC segment\" ;\n  rdfs:comment \"Header section includes document/message details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :DOC_Segment .\n\n:hasUNS rdf:type owl:ObjectProperty ;\n  rdfs:label \"has UNS segment\" ;\n  rdfs:comment \"Summary section includes UNS segment for section control.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :UNS_Segment .\n\n:hasCNT rdf:type owl:ObjectProperty ;\n  rdfs:label \"has CNT segment\" ;\n  rdfs:comment \"Summary section includes CNT segment for control totals.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :CNT_Segment .\n\n:hasItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Line item references the sold item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n\n:hasNetPrice rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Net price for a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:hasQuantity rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Quantity for a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:integer .\n\n:hasInvoiceAmount rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Invoice total amount.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasInvoiceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"Invoice unique number.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasTax rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Tax amount for summary section.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasReferenceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Reference number in header section.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasDate rdf:type owl:ObjectProperty ;\n  rdfs:label \"has date segment\" ;\n  rdfs:comment \"Header section includes date/time/period segment.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :DTM_Segment .\n\n:hasOrganization rdf:type owl:ObjectProperty ;\n  rdfs:label \"has organization\" ;\n  rdfs:comment \"Invoice includes participating organizations.\" ;\n  rdfs:domain :Invoice ;\n  rdfs:range :Organization .\n\n:hasAgentRoleAssignment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has agent role assignment\" ;\n  rdfs:comment \"Organization has assigned roles for invoice context.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleAssignment .\n\n:playsRole rdf:type owl:ObjectProperty ;\n  rdfs:label \"plays role\" ;\n  rdfs:comment \"Organization role assignment links to a role.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Organization has a specific address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasGLN rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has GLN\" ;\n  rdfs:comment \"Organization's global location number.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string .\n\n:hasBusinessProcess rdf:type owl:ObjectProperty ;\n  rdfs:label \"has business process\" ;\n  rdfs:comment \"Invoice is assigned to a business process.\" ;\n  rdfs:domain :Invoice ;\n  rdfs:range :BusinessProcess .\n\n:hasMonetaryAmount rdf:type owl:ObjectProperty ;\n  rdfs:label \"has monetary amount segment\" ;\n  rdfs:comment \"Summary section has monetary breakdowns.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :MOA_Segment .\n\n:hasLineMonetaryAmount rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line monetary amount segment\" ;\n  rdfs:comment \"Line item has monetary breakdowns.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :MOA_Segment .\n\n:hasReference rdf:type owl:ObjectProperty ;\n  rdfs:label \"has reference segment\" ;\n  rdfs:comment \"Header section references related documents.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :RFF_Segment .\n\n:hasTaxDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has tax segment\" ;\n  rdfs:comment \"Summary section has tax details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :TAX_Segment .\n\n:hasLineTaxDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line tax segment\" ;\n  rdfs:comment \"Line item has tax details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :TAX_Segment .\n\n:hasMeasurement rdf:type owl:ObjectProperty ;\n  rdfs:label \"has measurement segment\" ;\n  rdfs:comment \"Line item has measurement details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :MEA_Segment .\n\n:hasQuantityDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has quantity segment\" ;\n  rdfs:comment \"Line item has quantity details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :QTY_Segment .\n\n:hasAllowanceOrCharge rdf:type owl:ObjectProperty ;\n  rdfs:label \"has allowance/charge segment\" ;\n  rdfs:comment \"Summary section has allowance/charge details.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :ALC_Segment .\n\n:hasHeaderAllowanceOrCharge rdf:type owl:ObjectProperty ;\n  rdfs:label \"has header allowance/charge group\" ;\n  rdfs:comment \"Header section has allowance/charge group (SG8).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :SG8_AllowanceChargeGroup .\n\n:hasHeaderTax rdf:type owl:ObjectProperty ;\n  rdfs:label \"has header tax group\" ;\n  rdfs:comment \"Header section has tax group (SG6).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :SG6_TaxGroup .\n\n:hasReferenceGroup rdf:type owl:ObjectProperty ;\n  rdfs:label \"has reference group\" ;\n  rdfs:comment \"Header section has reference group (SG2).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :SG2_ReferenceGroup .\n\n:hasCurrency rdf:type owl:ObjectProperty ;\n  rdfs:label \"has currency segment\" ;\n  rdfs:comment \"Header section has currency details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :CUX_Segment .\n\n:hasPriceDetail rdf:type owl:ObjectProperty ;\n  rdfs:label \"has price segment\" ;\n  rdfs:comment \"Line item has price details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :PRI_Segment .\n\n:hasItemDescription rdf:type owl:ObjectProperty ;\n  rdfs:label \"has item description segment\" ;\n  rdfs:comment \"Line item has item description details.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :IMD_Segment .\n\n:hasContact rdf:type owl:ObjectProperty ;\n  rdfs:label \"has contact segment\" ;\n  rdfs:comment \"Header section has contact details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :CTA_Segment .\n\n:hasCommunication rdf:type owl:ObjectProperty ;\n  rdfs:label \"has communication segment\" ;\n  rdfs:comment \"Contact segment has communication details.\" ;\n  rdfs:domain :CTA_Segment ;\n  rdfs:range :COM_Segment .\n\n:hasTransport rdf:type owl:ObjectProperty ;\n  rdfs:label \"has transport segment\" ;\n  rdfs:comment \"Header section has transport details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :TDT_Segment .\n\n:hasTermsOfDelivery rdf:type owl:ObjectProperty ;\n  rdfs:label \"has terms of delivery segment\" ;\n  rdfs:comment \"Header section has terms of delivery details.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :TOD_Segment .\n\n#################################################################\n# Advanced Axioms & Restrictions\n#################################################################\n\n:LineItem rdf:type owl:Class ;\n  owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasLIN ; owl:allValuesFrom :LIN_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom xsd:decimal ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasQuantity ; owl:allValuesFrom xsd:integer ] .\n\n:OrganizationRoleAssignment rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ] .\n\n:Invoice rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasBusinessProcess ; owl:allValuesFrom :BusinessProcess ] .\n\n:HeaderSection rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasDate ; owl:someValuesFrom :DTM_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasReferenceGroup ; owl:someValuesFrom :SG2_ReferenceGroup ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasHeaderTax ; owl:someValuesFrom :SG6_TaxGroup ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasHeaderAllowanceOrCharge ; owl:someValuesFrom :SG8_AllowanceChargeGroup ] .\n\n:SummarySection rdf:type owl:Class ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasUNS ; owl:allValuesFrom :UNS_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasCNT ; owl:allValuesFrom :CNT_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasMonetaryAmount ; owl:someValuesFrom :MOA_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasTaxDetail ; owl:someValuesFrom :TAX_Segment ] ;\n  rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasAllowanceOrCharge ; owl:someValuesFrom :ALC_Segment ] .\n\n#################################################################\n# Property Characteristics (FunctionalProperty, etc.)\n#################################################################\n\n:hasGLN rdf:type owl:FunctionalProperty .\n:hasAddress rdf:type owl:FunctionalProperty .\n:containsMessage rdf:type owl:FunctionalProperty .\n:hasLIN rdf:type owl:FunctionalProperty .\n:hasUNS rdf:type owl:FunctionalProperty .\n:hasCNT rdf:type owl:FunctionalProperty .\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\n:hasInvoiceAmount rdf:type owl:FunctionalProperty .\n:hasNetPrice rdf:type owl:FunctionalProperty .\n:hasQuantity rdf:type owl:FunctionalProperty .\n:hasBusinessProcess rdf:type owl:FunctionalProperty .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection .\n:DetailSection owl:disjointWith :SummarySection .\n:SummarySection owl:disjointWith :HeaderSection .\n:Organization owl:disjointWith :Address .\n:Segment owl:disjointWith :CompositeDataElement .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n\n#################################################################\n# Annotations (rdfs:label, rdfs:comment for all classes/properties)\n#################################################################\n# (Already included above for all classes and properties)\n"
}
