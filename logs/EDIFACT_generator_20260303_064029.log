ty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Price ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"Links the summary section to the total invoice amount.\" .\n\n:hasBusinessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice message to its business process context.\" .\n\n:validatesWith a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    rdfs:label \"validates with\" ;\n    rdfs:comment \"Links an invoice message to its validation constraints (e.g. SHACL).\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The string value of an identifier.\" .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The street or address line.\" .\n\n:city a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city of the address.\" .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"The postal code of the address.\" .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"The country code of the address.\" .\n\n:priceValue a owl:DatatypeProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"price value\" ;\n    rdfs:comment \"The value of a price.\" .\n\n:quantityValue a owl:DatatypeProperty ;\n 