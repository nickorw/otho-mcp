ent \\\"A price amount.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity of items.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"Tax information for the invoice.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"The business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for automated validation, e.g., SHACL shapes.\\\" .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an InterchangeEnvelope to its contained Messages.\\\" ;\\n    owl:FunctionalProperty .\\n\\n:hasSection a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Section ;\\n    rdfs:label \\\"has section\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its header, detail, or summary section.\\\" ;\\n    owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a message to its segments.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite element to its simple elements.\\\"