bel \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element in a segment.\\\" .\\n\\n:Section a owl:Class ;\\n    rdfs:label \\\"Section\\\" ;\\n    rdfs:comment \\\"A logical section of the invoice (header, detail, summary).\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Section ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"Section containing document dates and references.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Section ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"Section listing individual line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Section ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"Section providing totals such as tax and invoice amount.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice (buyer, supplier, etc.).\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"The role an organization plays in the invoice (e.g., Buyer, Seller, Delivery Party).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"Reification class linking an organization to a role for a given invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A generic identifier for organizations, items, etc.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:subClassOf :Identifier ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"GLN identifier for organizations as per D96A.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"An item listed in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price amount.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity of items.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"Tax information for the invoice.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"The business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for automated validation, e.g., SHACL shapes.\\\" .\\n\\n#################################################################\\n# Object Properties with Inverses\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an InterchangeEnvelope to its contained Messages.\\\" ;\\n    owl:inverseOf :isContainedInEnvelope .\\n\\n:isContainedInEnvelope a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is contained in envelope\\\" ;\\n    rdfs:comment \\\"Links a Message to its InterchangeEnvelope.\\\" ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSection a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Section ;\\n    rdfs:label \\\"has section\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its header, detail, or summary section.\\\" ;\\n    owl:inverseOf :isSectionOf .\\n\\n:isSectionOf a owl:ObjectProperty ;\\n    rdfs:domain :Section ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is section of\\\" ;\\n    rdfs:comment \\\"Links a Section to its InvoiceMessage.\\\" ;\\n    owl:inverseOf :hasSection .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a message to its segments.\\\" ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Links a Segment to its Message.\\\" ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" ;\\n    owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"is composite element of\\\" ;\\n    rdfs:comment \\\"Links a composite element to its segment.\\\" ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite element to its simple elements.\\\" ;\\n    owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple element of\\\" ;\\n    rdfs:comment \\\"Links a simple element to its composite element.\\\" ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n:representsOrganization a owl:ObjectProperty ;\\n    rdfs:domain :NADSegment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"represents organization\\\" ;\\n    rdfs:comment \\\"Links a NAD segment to an organization.\\\" ;\\n    owl:inverseOf :isRepresentedByNAD .\\n\\n:isRepresentedByNAD a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :NADSegment ;\\n    rdfs:label \\\"is represented by NAD\\\" ;\\n    rdfs:comment \\\"Links an organization to its representing NAD segment.\\\" ;\\n    owl:inverseOf :representsOrganization .\\n\\n:hasRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Specifies the role in a RoleAssignment.\\\" ;\\n    owl:inverseOf :isRoleOfAssignment .\\n\\n:isRoleOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"is role of assignment\\\" ;\\n    rdfs:comment \\\"Links an AgentRole to its RoleAssignment.\\\" ;\\n    owl:inverseOf :hasRole .\\n\\n:assignedTo a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"assigned to\\\" ;\\n    rdfs:comment \\\"Specifies the organization in a RoleAssignment.\\\" ;\\n    owl:inverseOf :hasAssignment .\\n\\n:hasAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"has assignment\\\" ;\\n    rdfs:comment \\\"Links an organization to its RoleAssignments.\\\" ;\\n    owl:inverseOf :assignedTo .\\n\\n:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization to its address.\\\" ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is address of\\\" ;\\n    rdfs:comment \\\"Links an address to its organization.\\\" ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an organization to its identifiers.\\\" ;\\n    owl:inverseOf :isIdentifierOf .\\n\\n:isIdentifierOf a owl:ObjectProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is identifier of\\\" ;\\n    rdfs:comment \\\"Links an identifier to its organization.\\\" ;\\n    owl:inverseOf :hasIdentifier .\\n\\n:hasGlobalLocationNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :GlobalLocationNumber ;\\n    rdfs:label \\\"has global location number\\\" ;\\n    rdfs:comment \\\"Links an organization to its GLN identifier.\\\" ;\\n    owl:inverseOf :isGlobalLocationNumberOf .\\n\\n:isGlobalLocationNumberOf a owl:ObjectProperty ;\\n    rdfs:domain :GlobalLocationNumber ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is global location number of\\\" ;\\n    rdfs:comment \\\"Links a GLN to its organization.\\\" ;\\n    owl:inverseOf :hasGlobalLocationNumber .\\n\\n:hasAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"has assignment\\\" ;\\n    rdfs:comment \\\"Links an organization to its role assignments.\\\" ;\\n    owl:inverseOf :assignedTo .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links the detail section to items sold.\\\" ;\\n    owl:inverseOf :isItemOfDetailSection .\\n\\n:isItemOfDetailSection a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"is item of detail section\\\" ;\\n    rdfs:comment \\\"Links an item to its detail section.\\\" ;\\n    owl:inverseOf :hasItem .\\n\\n:itemPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"item price\\\" ;\\n    rdfs:comment \\\"Links an item to its price.\\\" ;\\n    owl:inverseOf :isPriceOfItem .\\n\\n:isPriceOfItem a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"is price of item\\\" ;\\n    rdfs:comment \\\"Links a price to its item.\\\" ;\\n    owl:inverseOf :itemPrice .\\n\\n:itemQuantity a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Quantity ;\\n    rdfs:label \\\"item quantity\\\" ;\\n    rdfs:comment \\\"Links an item to its quantity.\\\" ;\\n    owl:inverseOf :isQuantityOfItem .\\n\\n:isQuantityOfItem a owl:ObjectProperty ;\\n    rdfs:domain :Quantity ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"is quantity of item\\\" ;\\n    rdfs:comment \\\"Links a quantity to its item.\\\" ;\\n    owl:inverseOf :itemQuantity .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the summary section to tax information.\\\" ;\\n    owl:inverseOf :isTaxOfSummarySection .\\n\\n:isTaxOfSummarySection a owl:ObjectProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is tax of summary section\\\" ;\\n    rdfs:comment \\\"Links tax to its summary section.\\\" ;\\n    owl:inverseOf :hasTax .\\n\\n:invoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"invoice amount\\\" ;\\n    rdfs:comment \\\"Links the summary section to the total invoice amount.\\\" ;\\n    owl:inverseOf :isInvoiceAmountOf .\\n\\n:isInvoiceAmountOf a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is invoice amount of\\\" ;\\n    rdfs:comment \\\"Links the invoice amount to its summary section.\\\" ;\\n    owl:inverseOf :invoiceAmount .\\n\\n:hasBusinessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its business process context.\\\" ;\\n    owl:inverseOf :isBusinessProcessOf .\\n\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is business process of\\\" ;\\n    rdfs:comment \\\"Links a business process to its invoice message.\\\" ;\\n    owl:inverseOf :hasBusinessProcess .\\n\\n:validatesWith a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    rdfs:label \\\"validates with\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its validation constraints (e.g. SHACL).\\\" ;\\n    owl:inverseOf :isValidationConstraintFor .\\n\\n:isValidationConstraintFor a owl:ObjectProperty ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is validation constraint for\\\" ;\\n    rdfs:comment \\\"Links a validation constraint to its invoice message.\\\" ;\\n    owl:inverseOf :validatesWith .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:identifierValue a owl:DatatypeProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"identifier value\\\" ;\\n    rdfs:comment \\\"The string value of an identifier.\\\" .\\n\\n:addressLine a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"address line\\\" ;\\n    rdfs:comment \\\"The street or address line.\\\" .\\n\\n:city a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"city\\\" ;\\n    rdfs:comment \\\"The city of the address.\\\" .\\n\\n:postalCode a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"postal code\\\" ;\\n    rdfs:comment \\\"The postal code of the address.\\\" .\\n\\n:countryCode a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"country code\\\" ;\\n    rdfs:comment \\\"The country code of the address.\\\" .\\n\\n:priceValue a owl:DatatypeProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"price value\\\" ;\\n    rdfs:comment \\\"The value of a price.\\\" .\\n\\n:quantityValue a owl:DatatypeProperty ;\\n    rdfs:domain :Quantity ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"quantity value\\\" ;\\n    rdfs:comment \\\"The quantity value for an item.\\\" .\\n\\n:taxValue a owl:DatatypeProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"tax value\\\" ;\\n    rdfs:comment \\\"The tax amount.\\\" .\\n\\n:invoiceNumber a owl:DatatypeProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number.\\\" .\\n\\n:documentDate a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"The document date.\\\" .\\n\\n:referenceNumber a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"reference number\\\" ;\\n    rdfs:comment \\\"A reference number in the header.\\\" .\\n\\n#################################################################\\n# Disjointness & Advanced Axioms\\n#################################################################\\n\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :Address, :Item, :Segment, :Section, :BusinessProcess .\\n\\n#################################################################\\n# General Class Axioms & Restrictions\\n#################################################################\\n\\n:RoleAssignment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :assignedTo ; owl:qualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :Organization ] ,\\n                                 [ a owl:Restriction ; owl:onProperty :hasRole ; owl:qualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :AgentRole ] .\\n\\n:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:maxQualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :Address ] ,\\n                              [ a owl:Restriction ; owl:onProperty :hasGlobalLocationNumber ; owl:maxQualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :GlobalLocationNumber ] .\\n\\n:Item rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :itemPrice ; owl:qualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :Price ] ,\\n                      [ a owl:Restriction ; owl:onProperty :itemQuantity ; owl:qualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :Quantity ] .\\n\\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :HeaderSection ] ,\\n                                [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :DetailSection ] ,\\n                                [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :SummarySection ] .\\n\\n#################################################################\\n# End of ontology\\n#################################################################\\n\"}",
