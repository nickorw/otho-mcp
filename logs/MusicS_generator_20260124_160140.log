        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/music-production>\\n    a owl:Ontology ;\\n    rdfs:label \\\"Music Production Ontology\\\" ;\\n    rdfs:comment \\\"An ontology modeling music production, bands, albums, performances, and related entities.\\\" .\\n\\n### Classes\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A person, such as a musician or critic.\\\" .\\n\\n:Band a owl:Class ;\\n    rdfs:label \\\"Band\\\" ;\\n    rdfs:comment \\\"A musical group or band.\\\" .\\n\\n:Instrument a owl:Class ;\\n    rdfs:label \\\"Instrument\\\" ;\\n    rdfs:comment \\\"A musical instrument.\\\" .\\n\\n:Role a owl:Class ;\\n    rdfs:label \\\"Role\\\" ;\\n    rdfs:comment \\\"A role a person can have in a band, such as vocalist or drummer.\\\" .\\n\\n:Album a owl:Class ;\\n    rdfs:label \\\"Album\\\" ;\\n    rdfs:comment \\\"A music album.\\\" .\\n\\n:Track a owl:Class ;\\n    rdfs:label \\\"Track\\\" ;\\n    rdfs:comment \\\"A track on an album.\\\" .\\n\\n:Song a owl:Class ;\\n    rdfs:label \\\"Song\\\" ;\\n    rdfs:comment \\\"A musical composition.\\\" .\\n\\n:Critic a owl:Class ;\\n    rdfs:label \\\"Critic\\\" ;\\n    rdfs:comment \\\"A person who reviews albums.\\\" .\\n\\n:Performance a owl:Class ;\\n    rdfs:label \\\"Performance\\\" ;\\n    rdfs:comment \\\"A live performance event.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where performances take place.\\\" .\\n\\n:Region a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A geographical region.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country.\\\" .\\n\\n### Pivot/Reification Classes\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A reification class for a person's membership in a band, possibly with a role and time period.\\\" .\\n\\n:TrackRecording a owl:Class ;\\n    rdfs:label \\\"Track Recording\\\" ;\\n    rdfs:comment \\\"A reification class for the recording of a track as a song.\\\" .\\n\\n:AlbumRecordingPeriod a owl:Class ;\\n    rdfs:label \\\"Album Recording Period\\\" ;\\n    rdfs:comment \\\"A reification class for the period a band records an album.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"A reification class for the performance of a song during a performance event.\\\" .\\n\\n### Disjointness\\n:Person owl:disjointWith :Band, :Instrument .\\n:Album owl:disjointWith :Track, :Song, :Performance .\\n:Track owl:disjointWith :Song .\\n\\n### Object Properties and Inverses\\n:playsInstrument a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Links a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :instrumentPlayedBy .\\n\\n:instrumentPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"instrument played by\\\" ;\\n    rdfs:comment \\\"Inverse: links an instrument to a person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Links a band to its band membership instance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberOfBand .\\n\\n:memberOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"member of band\\\" ;\\n    rdfs:comment \\\"Inverse: links a band membership to the band.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMember .\\n\\n:memberPerson a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"member person\\\" ;\\n    rdfs:comment \\\"Links a band membership to the person.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :personMembership .\\n\\n:personMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"person membership\\\" ;\\n    rdfs:comment \\\"Inverse: links a person to their band memberships.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberPerson .\\n\\n:memberRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"member role\\\" ;\\n    rdfs:comment \\\"Links a band membership to the role.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleMembership .\\n\\n:roleMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role membership\\\" ;\\n    rdfs:comment \\\"Inverse: links a role to band memberships with that role.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberRole .\\n\\n:recordsAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"records album\\\" ;\\n    rdfs:comment \\\"Links a band to an album recording period.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :AlbumRecordingPeriod ;\\n    owl:inverseOf :recordedByBand .\\n\\n:recordedByBand a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded by band\\\" ;\\n    rdfs:comment \\\"Inverse: links an album recording period to the band.\\\" ;\\n    rdfs:domain :AlbumRecordingPeriod ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :recordsAlbum .\\n\\n:albumRecorded a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"album recorded\\\" ;\\n    rdfs:comment \\\"Links an album recording period to the album.\\\" ;\\n    rdfs:domain :AlbumRecordingPeriod ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :recordedInPeriod .\\n\\n:recordedInPeriod a owl:ObjectProperty ;\\n    rdfs:label