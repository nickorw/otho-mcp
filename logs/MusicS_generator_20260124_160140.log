n### Pivot/Reification Classes\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A reification class for a person's membership in a band, possibly with a role and time period.\\\" .\\n\\n:TrackRecording a owl:Class ;\\n    rdfs:label \\\"Track Recording\\\" ;\\n    rdfs:comment \\\"A reification class for the recording of a track as a song.\\\" .\\n\\n:AlbumRecordingPeriod a owl:Class ;\\n    rdfs:label \\\"Album Recording Period\\\" ;\\n    rdfs:comment \\\"A reification class for the period a band records an album.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"A reification class for the performance of a song during a performance event.\\\" .\\n\\n### Disjointness\\n:Person owl:disjointWith :Band, :Instrument .\\n:Album owl:disjointWith :Track, :Song, :Performance .\\n:Track owl:disjointWith :Song .\\n\\n### Object Properties and Inverses\\n:playsInstrument a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Links a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :instrumentPlayedBy .\\n\\n:instrumentPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"instrument played by\\\" ;\\n    rdfs:comment \\\"Inverse: links an instrument to a person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Links a band to its band membership instance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberOfBand .\\n\\n:memberOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"member of band\\\" ;\\n    rdfs:comment \\\"Inverse: links a band membership to the band.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMember .\\n\\n:memberPerson a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"member person\\\" ;\\n    rdfs:comment \\\"Links a band membership to the person.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :personMembership .\\n\\n:personMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"person membership\\\" ;\\n    rdfs:comment \\\"Inverse: links a person to their band memberships.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberPerson .\\n\\n:memberRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"member role\\\" ;\\n    rdfs:comment \\\"Links a band membership to the role.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleMembership .\\n\\n:roleMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role membership\\\" ;\\n    rdfs:comment \\\"Inverse: links a role to band memberships with that role.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberRole .\\n\\n:recordsAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"records album\\\" ;\\n    rdfs:comment \\\"Links a band to an album recording period.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :AlbumRecordingPeriod ;\\n    owl:inverseOf :recordedByBand .\\n\\n:recordedByBand a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded by band\\\" ;\\n    rdfs:comment \\\"Inverse: links an album recording period to the band.\\\" ;\\n    rdfs:domain :AlbumRecordingPeriod ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :recordsAlbum .\\n\\n:albumRecorded a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"album recorded\\\" ;\\n    rdfs:comment \\\"Links an album recording period to the album.\\\" ;\\n    rdfs:domain :AlbumRecordingPeriod ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :recordedInPeriod .\\n\\n:recordedInPeriod a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded in period\\\" ;\\n    rdfs:comment \\\"Inverse: links an album to its recording period.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :AlbumRecordingPeriod ;\\n    owl:inverseOf :albumRecorded .\\n\\n:hasTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"has track\\\" ;\\n    rdfs:comment \\\"Links an album to its tracks.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOfAlbum .\\n\\n:trackOfAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"track of album\\\" ;\\n    rdfs:comment \\\"Inverse: links a track to the album it is on.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :hasTrack .\\n\\n:trackRecording a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"track recording\\\" ;\\n    rdfs:comment \\\"Links a track to its recording event.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :TrackRecording ;\\n    owl:inverseOf :recordingOfTrack .\\n\\n:recordingOfTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"recording of track\\\" ;\\n    rdfs:comment \\\"Inverse: links a track recording to the track.\\\" ;\\n    rdfs:domain :TrackRecording ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackRecording .\\n\\n:recordedSong a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"recorded song\\\" ;\\n    rdfs:comment \\\"Links a track recording to the recorded song.\\\" ;\\n    rdfs:domain :TrackRecording ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songRecordedIn .\\n\\n:songRecordedIn a owl:ObjectProperty ;\\n    rdfs:label \\\"song recorded in\\\" ;\\n    rdfs:comment \\\"Inverse: links a song to its track recording.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :TrackRecording ;\\n    owl:inverseOf :recordedSong .\\n\\n:criticReview a owl:ObjectProperty ;\\n    rdfs:label \\\"critic review\\\" ;\\n    rdfs:comment \\\"Links a critic to an album they reviewed.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :reviewedByCritic .\\n\\n:reviewedByCritic a owl:ObjectProperty ;\\n    rdfs:label \\\"reviewed by critic\\\" ;\\n    rdfs:comment \\\"Inverse: links an album to its critic(s).\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :criticReview .\\n\\n:performanceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"performance of\\\" ;\\n    rdfs:comment \\\"Links a performance to the album it features.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumPerformedAt .\\n\\n:albumPerformedAt a owl:ObjectProperty ;\\n    rdfs:label \\\"album performed at\\\" ;\\n    rdfs:comment \\\"Inverse: links an album to performances that feature it.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceOf .\\n\\n:performanceLocation a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"City where a performance took place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :locationOfPerformance .\\n\\n:locationOfPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"location of performance\\\" ;\\n    rdfs:comment \\\"Inverse: links a city to performances held there.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceLocation .\\n\\n:performedSong a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"performed song\\\" ;\\n    rdfs:comment \\\"Links a performance song to the performed song.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songPerformedAt .\\n\\n:songPerformedAt a owl:ObjectProperty ;\\n    rdfs:label \\\"song performed at\\\" ;\\n    rdfs:comment \\\"Inverse: links a song to its performance song instance.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performedSong .\\n\\n:performanceInstance a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"performance instance\\\" ;\\n    rdfs:comment \\\"Links a performance song to the performance event.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :hasPerformanceSong .\\n\\n:hasPerformanceSong a owl:ObjectProperty ;\\n    rdfs:label \\\"has performance song\\\" ;\\n    rdfs:comment \\\"Inverse: links a performance to its performance song instance(s).\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceInstance .\\n\\n:cityInRegion a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"city in region\\\" ;\\n    rdfs:comment \\\"Links a city to its region.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionHasCity .\\n\\n:regionHasCity a owl:ObjectProperty ;\\n    rdfs:label \\\"region has city\\\" ;\\n    rdfs:comment \\\"Inverse: links a region to its cities.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityInRegion .\\n\\n:regionInCountry a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"region in country\\\" ;\\n    rdfs:comment \\\"Links a region to its country.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country ;\\n    owl:inverseOf :countryHasRegion .\\n\\n:countryHasRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"country has region\\\" ;\\n    rdfs:comment \\\"Inverse: links a country to its regions.\\\" ;\\n    rdfs:domain :Country ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionInCountry .\\n\\n### Data Properties\\n:trackNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"track number\\\" ;\\n    rdfs:comment \\\"The number of a track on an album.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range xsd:integer .\\n\\n:membershipStart a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"membership start\\\" ;\\n    rdfs:comment \\\"Start date of a band membership.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:membershipEnd a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"membership end\\\" ;\\n    rdfs:comment \\\"End date of a band membership.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingStart a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"recording start\\\" ;\\n    rdfs:comment \\\"Start date of an album recording period.\\\" ;\\n    rdfs:domain :AlbumRecordingPeriod ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingEnd a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"recording end\\\" ;\\n    rdfs:comment \\\"End date of an album recording period.\\\" ;\\n    rdfs:domain :AlbumRecordingPeriod ;\\n    rdfs:range xsd:dateTime .\\n\\n:songComposedOn a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"song composed on\\\" ;\\n    rdfs:comment \\\"Date a song was composed.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range xsd:dateTime .\\n\\n:reviewText a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"review text\\\" ;\\n    rdfs:comment \\\"Text of a critic's review.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range xsd:string .\\n\\n:albumReleaseDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"album release date\\\" ;\\n    rdfs:comment \\\"Release date of an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:dateTime .\\n\\n:performanceDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"performance date\\\" ;\\n    rdfs:comment \\\"Date of a performance event.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:dateTime .\\n\\n### Restrictions\\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:someValuesFrom :Track ] .\\n\"}",
