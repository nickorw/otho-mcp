 invoice listing an item, quantity, and price.\\\" ;\\n  rdfs:subClassOf :InvoiceLineItem .\\n:InvoiceLineItem a owl:Class ;\\n  rdfs:label \\\"Invoice Line Item\\\" ;\\n  rdfs:comment \\\"A pivot class capturing an item, its quantity, and net price in an invoice line.\\\" .\\n\\n#################################################################\\n# Disjointness\\n#################################################################\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :Address .\\n:Item owl:disjointWith :Organization .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"contains message\\\" ;\\n  rdfs:comment \\\"Relates an Interchange to its contained Message.\\\" ;\\n  rdfs:domain :Interchange ;\\n  rdfs:range :Message ;\\n  owl:inverseOf :isContainedInInterchange .\\n:isContainedInInterchange a owl:ObjectProperty ;\\n  rdfs:label \\\"is contained in interchange\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a Message to its Interchange envelope.\\\" ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Interchange ;\\n  owl:inverseOf :containsMessage .\\n:hasSegment a owl:ObjectProperty ;\\n  rdfs:label \\\"has segment\\\" ;\\n  rdfs:comment \\\"Relates a Message to its Segments.\\\" ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  owl:inverseOf :isSegmentOf .\\n:isSegmentOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is segment of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a Segment to its Message.\\\" ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :Message ;\\n  owl:inverseOf :hasSegment .\\n:hasSection a owl:ObjectProperty ;\\n  rdfs:label \\\"has section\\\" ;\\n  rdfs:comment \\\"Relates a Message to its major sections (header, detail, summary).\\\" ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  owl:inverseOf :isSectionOf .\\n:isSectionOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is section of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a Segment to its Message as a section.\\\" ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :Message ;\\n  owl:inverseOf :hasSection .\\n:hasCompositeElement a owl:ObjectProperty ;\\n  rdfs:label \\\"has composite element\\\" ;\\n  rdfs:comment \\\"Relates a Segment to its Composite Data Elements.\\\" ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  owl:inverseOf :isCompositeElementOf .\\n:isCompositeElementOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is composite element of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a Composite Data Element to its Segment.\\\" ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :Segment ;\\n  owl:inverseOf :hasCompositeElement .\\n:hasSimpleElement a owl:ObjectProperty ;\\n  rdfs:label \\\"has simple element\\\" ;\\n  rdfs:comment \\\"Relates a Composite Data Element to its Simple Data Elements.\\\" ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  owl:inverseOf :isSimpleElementOf .\\n:isSimpleElementOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is simple element of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a Simple Data Element to its Composite Data Element.\\\" ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range :CompositeDataElement ;\\n  owl:inverseOf :hasSimpleElement .\\n:hasOrganizationInRole a owl:ObjectProperty ;\\n  rdfs:label \\\"has organization in role\\\" ;\\n  rdfs:comment \\\"Relates an InvoiceMessage to an OrganizationInRole pivot class.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :OrganizationInRole ;\\n  owl:inverseOf :isOrganizationInRoleOf .\\n:isOrganizationInRoleOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is organization in role of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an OrganizationInRole to its InvoiceMessage.\\\" ;\\n  rdfs:domain :OrganizationInRole ;\\n  rdfs:range :InvoiceMessage ;\\n  owl:inverseOf :hasOrganizationInRole .\\n:playsRole a owl:ObjectProperty ;\\n  rdfs:label \\\"plays role\\\" ;\\n  rdfs:comment \\\"Relates an OrganizationInRole to an AgentRole (e.g., Buyer, Seller).\\\" ;\\n  rdfs:domain :OrganizationInRole ;\\n  rdfs:range :AgentRole ;\\n  owl:inverseOf :isRoleOf .\\n:isRoleOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is role of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an AgentRole to an OrganizationInRole.\\\" ;\\n  rdfs:domain :AgentRole ;\\n  rdfs:range :OrganizationInRole ;\\n  owl:inverseOf :playsRole .\\n:hasOrganization a owl:ObjectProperty ;\\n  rdfs:label \\\"has organization\\\" ;\\n  rdfs:comment \\\"Relates an OrganizationInRole to the Organization.\\\" ;\\n  rdfs:domain :OrganizationInRole ;\\n  rdfs:range :Organization ;\\n  owl:inverseOf :isOrganizationOfRole .\\n:isOrganizationOfRole a owl:ObjectProperty ;\\n  rdfs:label \\\"is organization of role\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an Organization to OrganizationInRole.\\\" ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :OrganizationInRole ;\\n  owl:inverseOf :hasOrganization .\\n:hasAddress a owl:ObjectProperty ;\\n  rdfs:label \\\"has address\\\" ;\\n  rdfs:comment \\\"Relates an OrganizationInRole to an Address.\\\" ;\\n  rdfs:domain :OrganizationInRole ;\\n  rdfs:range :Address ;\\n  owl:inverseOf :isAddressOfRole .\\n:isAddressOfRole a owl:ObjectProperty ;\\n  rdfs:label \\\"is address of role\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an Address to OrganizationInRole.\\\" ;\\n  rdfs:domain :Address ;\\n  rdfs:range :OrganizationInRole ;\\n  owl:inverseOf :hasAddress .\\n:hasIdentifier a owl:ObjectProperty ;\\n  rdfs:label \\\"has identifier\\\" ;\\n  rdfs:comment \\\"Relates an OrganizationInRole to an Identifier (e.g., GLN).\\\" ;\\n  rdfs:domain :OrganizationInRole ;\\n  rdfs:range :Identifier ;\\n  owl:inverseOf :isIdentifierOfRole .\\n:isIdentifierOfRole a owl:ObjectProperty ;\\n  rdfs:label \\\"is identifier of role\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an Identifier to OrganizationInRole.\\\" ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range :OrganizationInRole ;\\n  owl:inverseOf :hasIdentifier .\\n:hasInvoiceLineItem a owl:ObjectProperty ;\\n  rdfs:label \\\"has invoice line item\\\" ;\\n  rdfs:comment \\\"Relates an InvoiceMessage to its InvoiceLineItem entries.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceLineItem ;\\n  owl:inverseOf :isInvoiceLineItemOf .\\n:isInvoiceLineItemOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is invoice line item of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an InvoiceLineItem to its InvoiceMessage.\\\" ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :InvoiceMessage ;\\n  owl:inverseOf :hasInvoiceLineItem .\\n:refersToItem a owl:ObjectProperty ;\\n  rdfs:label \\\"refers to item\\\" ;\\n  rdfs:comment \\\"Relates an InvoiceLineItem to the Item it describes.\\\" ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range :Item ;\\n  owl:inverseOf :isItemOfInvoiceLine .\\n:isItemOfInvoiceLine a owl:ObjectProperty ;\\n  rdfs:label \\\"is item of invoice line\\\" ;\\n  rdfs:comment \\\"Inverse property: relates an Item to InvoiceLineItem.\\\" ;\\n  rdfs:domain :Item ;\\n  rdfs:range :InvoiceLineItem ;\\n  owl:inverseOf :refersToItem .\\n:isValidForBusinessProcess a owl:ObjectProperty ;\\n  rdfs:label \\\"is valid for business process\\\" ;\\n  rdfs:comment \\\"Relates an InvoiceMessage to a BusinessProcess.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  owl:inverseOf :validatesInvoiceMessage .\\n:validatesInvoiceMessage a owl:ObjectProperty ;\\n  rdfs:label \\\"validates invoice message\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a BusinessProcess to an InvoiceMessage.\\\" ;\\n  rdfs:domain :BusinessProcess ;\\n  rdfs:range :InvoiceMessage ;\\n  owl:inverseOf :isValidForBusinessProcess .\\n:hasValidationConstraint a owl:ObjectProperty ;\\n  rdfs:label \\\"has validation constraint\\\" ;\\n  rdfs:comment \\\"Relates an InvoiceMessage to a ValidationConstraint for compliance checks.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint ;\\n  owl:inverseOf :isValidationConstraintOf .\\n:isValidationConstraintOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is validation constraint of\\\" ;\\n  rdfs:comment \\\"Inverse property: relates a ValidationConstraint to InvoiceMessage.\\\" ;\\n  rdfs:domain :ValidationConstraint ;\\n  rdfs:range :InvoiceMessage ;\\n  owl:inverseOf :hasValidationConstraint .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:hasNetPrice a owl:DatatypeProperty ;\\n  rdfs:label \\\"has net price\\\" ;\\n  rdfs:comment \\\"The net price of an item in an invoice line.\\\" ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range xsd:decimal .\\n:hasQuantity a owl:DatatypeProperty ;\\n  rdfs:label \\\"has quantity\\\" ;\\n  rdfs:comment \\\"The quantity of the item in an invoice line.\\\" ;\\n  rdfs:domain :InvoiceLineItem ;\\n  rdfs:range xsd:decimal .\\n:hasTotalAmount a owl:DatatypeProperty ;\\n  rdfs:label \\\"has total amount\\\" ;\\n  rdfs:comment \\\"The total amount of the invoice.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range xsd:decimal .\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n  rdfs:label \\\"has invoice number\\\" ;\\n  rdfs:comment \\\"The invoice number.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range xsd:string .\\n:hasDate a owl:DatatypeProperty ;\\n  rdfs:label \\\"has date\\\" ;\\n  rdfs:comment \\\"The date associated with the invoice (issue, due, etc.).\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range xsd:dateTime .\\n\\n#################################################################\\n# Restrictions and GCAs\\n#################################################################\\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOrganizationInRole ; owl:someValuesFrom :OrganizationInRole ] .\\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasInvoiceLineItem ; owl:someValuesFrom :InvoiceLineItem ] .\\n:InvoiceLineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :refersToItem ; owl:someValuesFrom :Item ] .\\n:InvoiceLineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom xsd:decimal ] .\\n:InvoiceLineItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom xsd:decimal ] .\\n:OrganizationInRole rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ] .\\n:OrganizationInRole rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ] .\\n:OrganizationInRole rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:someValuesFrom :Address ] .\\n:OrganizationInRole rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasIdentifier ; owl:someValuesFrom :Identifier ] .\\n\"}",
