:type owl:ObjectProperty ;\\n    rdfs:label \\\"union role of membership\\\" ; rdfs:comment \\\"Inverse: relates a union role to a union membership.\\\" ;\\n    rdfs:domain :UnionRole ; rdfs:range :UnionMembership ;\\n    owl:inverseOf :hasUnionRole .\\n\\n:unionRoleOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"union role of\\\" ; rdfs:comment \\\"Relates a union role to a person.\\\" ;\\n    rdfs:domain :UnionRole ; rdfs:range :Person ;\\n    owl:inverseOf :hasUnionRolePerson .\\n:hasUnionRolePerson rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has union role person\\\" ; rdfs:comment \\\"Inverse: relates a person to their union role.\\\" ;\\n    rdfs:domain :Person ; rdfs:range :UnionRole ;\\n    owl:inverseOf :unionRoleOf .\\n\\n:evaluatedBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"evaluated by\\\" ; rdfs:comment \\\"Relates an employee evaluation to a doctor.\\\" ;\\n    rdfs:domain :EmployeeEvaluation ; rdfs:range :Doctor ;\\n    owl:inverseOf :evaluates .\\n:evaluates rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"evaluates\\\" ; rdfs:comment \\\"Relates a doctor to an employee evaluation.\\\" ;\\n    rdfs:domain :Doctor ; rdfs:range :EmployeeEvaluation ;\\n    owl:inverseOf :evaluatedBy .\\n\\n:evaluationOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"evaluation of\\\" ; rdfs:comment \\\"Relates an employee evaluation to the employee.\\\" ;\\n    rdfs:domain :EmployeeEvaluation ; rdfs:range :Person ;\\n    owl:inverseOf :hasEvaluation .\\n:hasEvaluation rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has evaluation\\\" ; rdfs:comment \\\"Relates a person to an employee evaluation.\\\" ;\\n    rdfs:domain :Person ; rdfs:range :EmployeeEvaluation ;\\n    owl:inverseOf :evaluationOf .\\n\\n:composedOf rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"composed of\\\" ; rdfs:comment \\\"Relates an article collection to its articles.\\\" ;\\n    rdfs:domain :ArticleCollection ; rdfs:range :Article ;\\n    owl:inverseOf :partOfCollection .\\n:partOfCollection rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"part of collection\\\" ; rdfs:comment \\\"Inverse: relates an article to the article collection it is part of.\\\" ;\\n    rdfs:domain :Article ; rdfs:range :ArticleCollection ;\\n    owl:inverseOf :composedOf .\\n\\n:presentedAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"presented at\\\" ; rdfs:comment \\\"Relates a seminar presentation to a seminar.\\\" ;\\n    rdfs:domain :SeminarPresentation ; rdfs:range :Seminar ;\\n    owl:inverseOf :seminarPresentationOf .\\n:seminarPresentationOf rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"seminar presentation of\\\" ; rdfs:comment \\\"Relates a seminar to its presentations.\\\" ;\\n    rdfs:domain :Seminar ; rdfs:range :SeminarPresentation ;\\n    owl:inverseOf :presentedAt .\\n\\n:presentsArticle rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"presents article\\\" ; rdfs:comment \\\"Relates a seminar presentation to an article.\\\" ;\\n    rdfs:domain :SeminarPresentation ; rdfs:range :Article ;\\n    owl:inverseOf :presentedIn .\\n:presentedIn rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"presented in\\\" ; rdfs:comment \\\"Inverse: relates an article to the seminar presentation.\\\" ;\\n    rdfs:domain :Article ; rdfs:range :SeminarPresentation ;\\n    owl:inverseOf :presentsArticle .\\n\\n:heldAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"held at\\\" ; rdfs:comment \\\"Relates a seminar to the hospital where it is held.\\\" ;\\n    rdfs:domain :Seminar ; rdfs:range :Hospital ;\\n    owl:inverseOf :hostsSeminar .\\n:hostsSeminar rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"hosts seminar\\\" ; rdfs:comment \\\"Inverse: relates a hospital to a seminar.\\\" ;\\n    rdfs:domain :Hospital ; rdfs:range :Seminar ;\\n    owl:inverseOf :heldAt .\\n\\n### Data Properties\\n:degreeDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"degree date\\\" ; rdfs:comment \\\"The date a degree was obtained.\\\" ; rdfs:domain :Degree ; rdfs:range xsd:date .\\n:studyStartDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"study start date\\\" ; rdfs:comment \\\"Start date of a study period.\\\" ; rdfs:domain :StudyPeriod ; rdfs:range xsd:date .\\n:studyEndDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"study end date\\\" ; rdfs:comment \\\"End date of a study period.\\\" ; rdfs:domain :StudyPeriod ; rdfs:range xsd:date .\\n:employmentStartDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"employment start date\\\" ; rdfs:comment \\\"Start date of employment.\\\" ; rdfs:domain :Employment ; rdfs:range xsd:date .\\n:employmentEndDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"employment end date\\\" ; rdfs:comment \\\"End date of employment.\\\" ; rdfs:domain :Employment ; rdfs:range xsd:date .\\n:unionMembershipStartDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"union membership start date\\\" ; rdfs:comment \\\"Start date of union membership.\\\" ; rdfs:domain :UnionMembership ; rdfs:range xsd:date .\\n:unionMembershipEndDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"union membership end date\\\" ; rdfs:comment \\\"End date of union membership.\\\" ; rdfs:domain :UnionMembership ; rdfs:range xsd:date .\\n:evaluationStatement rdf:type owl:DatatypeProperty ; rdfs:label \\\"evaluation statement\\\" ; rdfs:comment \\\"Text of the evaluation statement.\\\" ; rdfs:domain :EmployeeEvaluation ; rdfs:range xsd:string .\\n:publicationDateBook rdf:type owl:DatatypeProperty ; rdfs:label \\\"publication date (book)\\\" ; rdfs:comment \\\"Publication date of a book.\\\" ; rdfs:domain :Book ; rdfs:range xsd:date .\\n:publicationDateCD rdf:type owl:DatatypeProperty ; rdfs:label \\\"publication date (CD)\\\" ; rdfs:comment \\\"Publication date of a CD.\\\" ; rdfs:domain :CD ; rdfs:range xsd:date .\\n:pageCount rdf:type owl:DatatypeProperty ; rdfs:label \\\"page count\\\" ; rdfs:comment \\\"Number of pages in a book.\\\" ; rdfs:domain :Book ; rdfs:range xsd:integer .\\n:seminarDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"seminar date\\\" ; rdfs:comment \\\"Date of a seminar.\\\" ; rdfs:domain :Seminar ; rdfs:range xsd:date .\\n\\n### GCAs and Restrictions\\n:Seminar rdf:type owl:Class ;\\n    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :seminarPresentationOf ; owl:someValuesFrom [ rdf:type owl:Restriction ; owl:onProperty :presentsArticle ; owl:someValuesFrom :Article ] ] ;\\n    rdfs:label \\\"Seminar\\\" ; rdfs:comment \\\"A seminar held at a hospital for presenting articles.\\\" .\\n\"}",
