e owl:DatatypeProperty ; rdfs:label \"employment end date\" ; rdfs:comment \"End date of employment.\" ; rdfs:domain :Employment ; rdfs:range xsd:date .\n:unionMembershipStartDate rdf:type owl:DatatypeProperty ; rdfs:label \"union membership start date\" ; rdfs:comment \"Start date of union membership.\" ; rdfs:domain :UnionMembership ; rdfs:range xsd:date .\n:unionMembershipEndDate rdf:type owl:DatatypeProperty ; rdfs:label \"union membership end date\" ; rdfs:comment \"End date of union membership.\" ; rdfs:domain :UnionMembership ; rdfs:range xsd:date .\n:evaluationStatement rdf:type owl:DatatypeProperty ; rdfs:label \"evaluation statement\" ; rdfs:comment \"Text of the evaluation statement.\" ; rdfs:domain :EmployeeEvaluation ; rdfs:range xsd:string .\n:publicationDate rdf:type owl:DatatypeProperty ; rdfs:label \"publication date\" ; rdfs:comment \"Publication date of a book or CD.\" ; rdfs:domain :Book, :CD ; rdfs:range xsd:date .\n:pageCount rdf:type owl:DatatypeProperty ; rdfs:label \"page count\" ; rdfs:comment \"Number of pages in a book.\" ; rdfs:domain :Book ; rdfs:range xsd:integer .\n:seminarDate rdf:type owl:DatatypeProperty ; rdfs:label \"seminar date\" ; rdfs:comment \"Date of a seminar.\" ; rdfs:domain :Seminar ; rdfs:range xsd:date .\n\n### Property Characteristics\n:hasDegree rdf:type owl:FunctionalProperty .\n:hasMember rdf:type owl:FunctionalProperty .\n:employedAt rdf:type owl:FunctionalProperty .\n:locatedIn rdf:type owl:FunctionalProperty .\n:inCountry rdf:type owl:FunctionalProperty .\n:unionRoleOf rdf:type owl:FunctionalProperty .\n:evaluatedBy rdf:type owl:FunctionalProperty .\n:evaluationOf rdf:type owl:FunctionalProperty .\n:presentedAt rdf:type owl:FunctionalProperty .\n:presentsArticle rdf:type owl:FunctionalProperty .\n:heldAt rdf:type owl:FunctionalProperty .\n\n### GCAs and Restrictions\n:Seminar rdf:type owl:Class ;\n    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :seminarPresentationOf ; owl:someValuesFrom [ rd