2026-01-10 12:56:21 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:HospitalStoryOntology rdf:type owl:Ontology ;\n    rdfs:label \"Hospital Story Ontology\" ;\n    rdfs:comment \"Ontology for hospital staff, unions, degrees, employment, articles, seminars, and evaluations as described in the provided story.\" .\n\n### Classes\n:Person rdf:type owl:Class ; rdfs:label \"Person\" ; rdfs:comment \"A human involved in the hospital context.\" .\n:Doctor rdf:type owl:Class ; rdfs:label \"Doctor\" ; rdfs:comment \"A medical doctor.\" ; rdfs:subClassOf :Person .\n:Nurse rdf:type owl:Class ; rdfs:label \"Nurse\" ; rdfs:comment \"A nurse working in the hospital.\" ; rdfs:subClassOf :Person .\n:NursingAssistant rdf:type owl:Class ; rdfs:label \"Nursing Assistant\" ; rdfs:comment \"A person trained as a nursing assistant.\" ; rdfs:subClassOf :Nurse .\n:CertifiedNurse rdf:type owl:Class ; rdfs:label \"Certified Nurse\" ; rdfs:comment \"A nurse with a certification.\" ; rdfs:subClassOf :Nurse .\n:Staff rdf:type owl:Class ; rdfs:label \"Staff\" ; rdfs:comment \"Hospital staff member.\" ; rdfs:subClassOf :Person .\n:Degree rdf:type owl:Class ; rdfs:label \"Degree\" ; rdfs:comment \"A medical degree or certification.\" .\n:StudyPeriod rdf:type owl:Class ; rdfs:label \"Study Period\" ; rdfs:comment \"A period during which a person studies for a degree.\" .\n:Employment rdf:type owl:Class ; rdfs:label \"Employment\" ; rdfs:comment \"A period of employment at a hospital.\" .\n:Hospital rdf:type owl:Class ; rdfs:label \"Hospital\" ; rdfs:comment \"A hospital where people work and seminars are held.\" .\n:City rdf:type owl:Class ; rdfs:label \"City\" ; rdfs:comment \"A city where hospitals are located.\" .\n:Country rdf:type owl:Class ; rdfs:label \"Country\" ; rdfs:comment \"A country where cities are located.\" .\n:Union rdf:type owl:Class ; rdfs:label \"Union\" ; rdfs:comment \"A union organizing hospital staff.\" .\n:UnionMembership rdf:type owl:Class ; rdfs:label \"Union Membership\" ; rdfs:comment \"A person's membership in a union during a time period.\" .\n:UnionRole rdf:type owl:Class ; rdfs:label \"Union Role\" ; rdfs:comment \"A role held by a person within a union.\" .\n:EmployeeEvaluation rdf:type owl:Class ; rdfs:label \"Employee Evaluation\" ; rdfs:comment \"A written evaluation by a doctor for an employee.\" .\n:Article rdf:type owl:Class ; rdfs:label \"Article\" ; rdfs:comment \"A research article.\" .\n:ArticleCollection rdf:type owl:Class ; rdfs:label \"Article Collection\" ; rdfs:comment \"A collection of articles, available as books or CDs.\" .\n:Book rdf:type owl:Class ; rdfs:label \"Book\" ; rdfs:comment \"A book containing articles.\" ; rdfs:subClassOf :ArticleCollection .\n:CD rdf:type owl:Class ; rdfs:label \"CD\" ; rdfs:comment \"A CD containing articles.\" ; rdfs:subClassOf :ArticleCollection .\n:Seminar rdf:type owl:Class ; rdfs:label \"Seminar\" ; rdfs:comment \"A seminar held at a hospital for presenting articles.\" .\n:SeminarPresentation rdf:type owl:Class ; rdfs:label \"Seminar Presentation\" ; rdfs:comment \"A presentation of an article at a seminar.\" .\n\n### Disjointness\n:Doctor owl:disjointWith :Nurse .\n:Book owl:disjointWith :CD .\n\n### DisjointUnion\n:Nurse owl:disjointUnionOf (:NursingAssistant :CertifiedNurse) .\n\n### Object Properties with Inverses\n:hasDegree rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has degree\" ; rdfs:comment \"Relates a person to a degree.\" ;\n    rdfs:domain :Person ; rdfs:range :Degree ;\n    owl:inverseOf :degreeOf .\n:degreeOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"degree of\" ; rdfs:comment \"Inverse: relates a degree to the person who holds it.\" ;\n    rdfs:domain :Degree ; rdfs:range :Person ;\n    owl:inverseOf :hasDegree .\n\n:studiedDuring rdf:type owl:ObjectProperty ;\n    rdfs:label \"studied during\" ; rdfs:comment \"Relates a person to the study period for a degree.\" ;\n    rdfs:domain :Person ; rdfs:range :StudyPeriod ;\n    owl:inverseOf :studyPeriodOf .\n:studyPeriodOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"study period of\" ; rdfs:comment \"Inverse: relates a study period to the person.\" ;\n    rdfs:domain :StudyPeriod ; rdfs:range :Person ;\n    owl:inverseOf :studiedDuring .\n\n:forDegree rdf:type owl:ObjectProperty ;\n    rdfs:label \"for degree\" ; rdfs:comment \"Relates a study period to a degree.\" ;\n    rdfs:domain :StudyPeriod ; rdfs:range :Degree ;\n    owl:inverseOf :degreeStudyPeriod .\n:degreeStudyPeriod rdf:type owl:ObjectProperty ;\n    rdfs:label \"degree study period\" ; rdfs:comment \"Inverse: relates a degree to a study period.\" ;\n    rdfs:domain :Degree ; rdfs:range :StudyPeriod ;\n    owl:inverseOf :forDegree .\n\n:employmentOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"employment of\" ; rdfs:comment \"Relates a person to their employment.\" ;\n    rdfs:domain :Person ; rdfs:range :Employment ;\n    owl:inverseOf :employedPerson .\n:employedPerson rdf:type owl:ObjectProperty ;\n    rdfs:label \"employed person\" ; rdfs:comment \"Inverse: relates employment to person.\" ;\n    rdfs:domain :Employment ; rdfs:range :Person ;\n    owl:inverseOf :employmentOf .\n\n:employedAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"employed at\" ; rdfs:comment \"Relates an employment to a hospital.\" ;\n    rdfs:domain :Employment ; rdfs:range :Hospital ;\n    owl:inverseOf :employs .\n:employs rdf:type owl:ObjectProperty ;\n    rdfs:label \"employs\" ; rdfs:comment \"Inverse: relates a hospital to employment.\" ;\n    rdfs:domain :Hospital ; rdfs:range :Employment ;\n    owl:inverseOf :employedAt .\n\n:locatedIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"located in\" ; rdfs:comment \"Relates a hospital to a city.\" ;\n    rdfs:domain :Hospital ; rdfs:range :City ;\n    owl:inverseOf :hasHospital .\n:hasHospital rdf:type owl:ObjectProperty ;\n    rdfs:label \"has hospital\" ; rdfs:comment \"Inverse: relates a city to a hospital.\" ;\n    rdfs:domain :City ; rdfs:range :Hospital ;\n    owl:inverseOf :locatedIn .\n\n:inCountry rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"in country\" ; rdfs:comment \"Relates a city to a country.\" ;\n    rdfs:domain :City ; rdfs:range :Country ;\n    owl:inverseOf :hasCity .\n:hasCity rdf:type owl:ObjectProperty ;\n    rdfs:label \"has city\" ; rdfs:comment \"Inverse: relates a country to a city.\" ;\n    rdfs:domain :Country ; rdfs:range :City ;\n    owl:inverseOf :inCountry .\n\n:hasMember rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has member\" ; rdfs:comment \"Relates a union to its membership.\" ;\n    rdfs:domain :Union ; rdfs:range :UnionMembership ;\n    owl:inverseOf :memberOfUnion .\n:memberOfUnion rdf:type owl:ObjectProperty ;\n    rdfs:label \"member of union\" ; rdfs:comment \"Relates a union membership to a union.\" ;\n    rdfs:domain :UnionMembership ; rdfs:range :Union ;\n    owl:inverseOf :hasMember .\n\n:hasUnionRole rdf:type owl:ObjectProperty ;\n    rdfs:label \"has union role\" ; rdfs:comment \"Relates a union membership to a union role.\" ;\n    rdfs:domain :UnionMembership ; rdfs:range :UnionRole ;\n    owl:inverseOf :unionRoleOfMembership .\n:unionRoleOfMembership rdf:type owl:ObjectProperty ;\n    rdfs:label \"union role of membership\" ; rdfs:comment \"Inverse: relates a union role to a union membership.\" ;\n    rdfs:domain :UnionRole ; rdfs:range :UnionMembership ;\n    owl:inverseOf :hasUnionRole .\n\n:unionRoleOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"union role of\" ; rdfs:comment \"Relates a union role to a person.\" ;\n    rdfs:domain :UnionRole ; rdfs:range :Person ;\n    owl:inverseOf :has