egree .\n\n:studiedDuring rdf:type owl:ObjectProperty ;\n    rdfs:label \"studied during\" ; rdfs:comment \"Relates a person to the study period for a degree.\" ;\n    rdfs:domain :Person ; rdfs:range :StudyPeriod ;\n    owl:inverseOf :studyPeriodOf .\n:studyPeriodOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"study period of\" ; rdfs:comment \"Inverse: relates a study period to the person.\" ;\n    rdfs:domain :StudyPeriod ; rdfs:range :Person ;\n    owl:inverseOf :studiedDuring .\n\n:forDegree rdf:type owl:ObjectProperty ;\n    rdfs:label \"for degree\" ; rdfs:comment \"Relates a study period to a degree.\" ;\n    rdfs:domain :StudyPeriod ; rdfs:range :Degree ;\n    owl:inverseOf :degreeStudyPeriod .\n:degreeStudyPeriod rdf:type owl:ObjectProperty ;\n    rdfs:label \"degree study period\" ; rdfs:comment \"Inverse: relates a degree to a study period.\" ;\n    rdfs:domain :Degree ; rdfs:range :StudyPeriod ;\n    owl:inverseOf :forDegree .\n\n:employmentOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"employment of\" ; rdfs:comment \"Relates a person to their employment.\" ;\n    rdfs:domain :Person ; rdfs:range :Employment ;\n    owl:inverseOf :employedPerson .\n:employedPerson rdf:type owl:ObjectProperty ;\n    rdfs:label \"employed person\" ; rdfs:comment \"Inverse: relates employment to person.\" ;\n    rdfs:domain :Employment ; rdfs:range :Person ;\n    owl:inverseOf :employmentOf .\n\n:employedAt rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"employed at\" ; rdfs:comment \"Relates an employment to a hospital.\" ;\n    rdfs:domain :Employment ; rdfs:range :Hospital ;\n    owl:inverseOf :employs .\n:employs rdf:type owl:ObjectProperty ;\n    rdfs:label \"employs\" ; rdfs:comment \"Inverse: relates a hospital to employment.\" ;\n    rdfs:domain :Hospital ; rdfs:range :Employment ;\n    owl:inverseOf :employedAt .\n\n:locatedIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"located in\" ; rdfs:comment \"Rela