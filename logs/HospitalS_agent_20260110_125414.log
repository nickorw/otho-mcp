m [ rdf:type owl:Restriction ; owl:onProperty :presentsArticle ; owl:someValuesFrom :Article ] ] ;\n    rdfs:label \"Seminar\" ; rdfs:comment \"A seminar held at a hospital for presenting articles.\" .\n"
