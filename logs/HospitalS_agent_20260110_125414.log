"page count\\\" ; rdfs:comment \\\"Number of pages in a book.\\\" ; rdfs:domain :Book ; rdfs:range xsd:integer .\\n:seminarDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"seminar date\\\" ; rdfs:comment \\\"Date of a seminar.\\\" ; rdfs:domain :Seminar ; rdfs:range xsd:date .\\n\\n### GCAs and Restrictions\\n:Seminar rdf:type owl:Class ;\\n    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :seminarPresentationOf ; owl:someValuesFrom [ rdf:type owl:Restriction ; owl:onProperty :presentsArticle ; owl:someValuesFrom :Article ] ] ;\\n    rdfs:label \\\"Seminar\\\" ; rdfs:comment \\\"A seminar held at a hospital for presenting articles.\\\" .\\n\"}",
