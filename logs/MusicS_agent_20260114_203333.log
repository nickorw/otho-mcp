"album track count\" ;\n    rdfs:comment \"The number of tracks contained in an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:integer .\n\n#################################################################\n#    Class Axioms and Restrictions\n#################################################################\n\n# Album must have at least one track\n:Album rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasTrack ;\n    owl:someValuesFrom :Track\n] .\n\n# TrackSongRelation links exactly one track and one song\n:TrackSongRelation rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :track ;\n    owl:cardinality 1\n] , [\n    a owl:Restriction ;\n    owl:onProperty :isRecordingOf ;\n    owl:cardinality 1\n] .\n\n# PerformanceSong links exactly one performance and one song\n:PerformanceSong rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :performance ;\n    owl:cardinality 1\n] , [\n    a owl:Restriction ;\n    owl:onProperty :performanceOf ;\n    owl:cardinality 1\n] .\n\n#################################################################\n#    Disjointness\n#################################################################\n\n:Person owl:disjointWith :Band , :Instrument .\n:Band owl:disjointWith :Instrument .\n:Album owl:disjointWith :Track .\n:Song owl:disjointWith :Album .\n:Critic owl:disjointWith :Person .\n:Performance owl:disjointWith :Band .\n\n#################################################################\n#    End of Ontology\n#################################################################\n"
