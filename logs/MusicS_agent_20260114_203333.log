        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/music-production>\\n    a owl:Ontology ;\\n    rdfs:label \\\"Music Production Ontology\\\" ;\\n    rdfs:comment \\\"An ontology modeling music production, band membership, recordings, tracks, performances, and related concepts based on the Red Hot Chili Peppers story.\\\" .\\n\\n#################################################################\\n#    Classes\\n#################################################################\\n\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual involved in music production, performance, or critique.\\\" .\\n\\n:Band a owl:Class ;\\n    rdfs:label \\\"Band\\\" ;\\n    rdfs:comment \\\"A group of musicians performing and recording together.\\\" .\\n\\n:Instrument a owl:Class ;\\n    rdfs:label \\\"Instrument\\\" ;\\n    rdfs:comment \\\"A musical instrument played by a person.\\\" .\\n\\n:Role a owl:Class ;\\n    rdfs:label \\\"Role\\\" ;\\n    rdfs:comment \\\"A function or part played by a person in a band, such as 'guitarist' or 'vocalist'.\\\" .\\n\\n:Album a owl:Class ;\\n    rdfs:label \\\"Album\\\" ;\\n    rdfs:comment \\\"A collection of tracks released together as a record.\\\" .\\n\\n:Track a owl:Class ;\\n    rdfs:label \\\"Track\\\" ;\\n    rdfs:comment \\\"A single audio recording that is part of an album.\\\" .\\n\\n:Song a owl:Class ;\\n    rdfs:label \\\"Song\\\" ;\\n    rdfs:comment \\\"A musical composition that may be recorded as a track.\\\" .\\n\\n:Critic a owl:Class ;\\n    rdfs:label \\\"Critic\\\" ;\\n    rdfs:comment \\\"A person who reviews and critiques albums.\\\" .\\n\\n:Performance a owl:Class ;\\n    rdfs:label \\\"Performance\\\" ;\\n    rdfs:comment \\\"A live musical event given by a band.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where performances are held and which is part of a region.\\\" .\\n\\n:Region a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A region containing cities, located in a country.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n# Pivot/Reification Classes\\n\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A n-ary relation linking a person, a band, their role, and membership time interval.\\\" .\\n\\n:AlbumRecording a owl:Class ;\\n    rdfs:label \\\"Album Recording\\\" ;\\n    rdfs:comment \\\"A n-ary relation linking an album and its recording time interval.\\\" .\\n\\n:TrackSongRelation a owl:Class ;\\n    rdfs:label \\\"Track Song Relation\\\" ;\\n    rdfs:comment \\\"A n-ary relation linking a track to the song it records.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"A n-ary relation linking a performance and a song played.\\\" .\\n\\n#################################################################\\n#    Object Properties + Inverses\\n#################################################################\\n\\n:playsInstrument a owl:ObjectProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Relates a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :instrumentPlayedBy .\\n\\n:instrumentPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"instrument played by\\\" ;\\n    rdfs:comment \\\"Inverse of playsInstrument: relates an instrument to a person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Relates a band to a band membership instance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberOfBand .\\n\\n:memberOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"member of band\\\" ;\\n    rdfs:comment \\\"Inverse of hasMember: relates a band membership to the band.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMember .\\n\\n:memberPerson a owl:ObjectProperty ;\\n    rdfs:label \\\"member person\\\" ;\\n    rdfs:comment \\\"Relates a band membership to the person who is a member.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :personMembership .\\n\\n:personMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"person membership\\\" ;\\n    rdfs:comment \\\"Inverse of memberPerson: relates a person to their band membership.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberPerson .\\n\\n:memberRole a owl:ObjectProperty ;\\n    rdfs:label \\\"member role\\\" ;\\n    rdfs:comment \\\"Relates a band membership to the role played by the member.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleOfMembership .\\n\\n:roleOfMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role of membership\\\" ;\\n    rdfs:comment \\\"Inverse of memberRole: relates a role to the band membership.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberRole .\\n\\n:recordedAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded album\\\" ;\\n    rdfs:comment \\\"Relates an album recording to the album.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumRecording .\\n\\n:albumRecording a owl:ObjectProperty ;\\n    rdfs:label \\\"album recording\\\" ;\\n    rdfs:comment \\\"Inverse of recordedAlbum: relates an album to its recording event.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :AlbumRecording ;\\n    owl:inverseOf :recordedAlbum .\\n\\n:hasTrack a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has track\\\" ;\\n    rdfs:comment \\\"Relates an album to a track it contains.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOfAlbum .\\n\\n:trackOfAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"track of album\\\" ;\\n    rdfs:comment \\\"Inverse of hasTrack: relates a track to the album it is part of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :hasTrack .\\n\\n:trackNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"track number\\\" ;\\n    rdfs:comment \\\"The number of a track within an album.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range xsd:integer .\\n\\n:isRecordingOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is recording of\\\" ;\\n    rdfs:comment \\\"Relates a track-song relation to the song being recorded.\\\" ;\\n    rdfs:domain :TrackSongRelation ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :recordedByTrack .\\n\\n:recordedByTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded by track\\\" ;\\n    rdfs:comment \\\"Inverse of isRecordingOf: relates a song to its track-song relation.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :TrackSongRelation ;\\n    owl:inverseOf :isRecordingOf .\\n\\n:track a owl:ObjectProperty ;\\n    rdfs:label \\\"track\\\" ;\\n    rdfs:comment \\\"Relates a track-song relation to the track.\\\" ;\\n    rdfs:domain :TrackSongRelation ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackSongRelation .\\n\\n:trackSongRelation a owl:ObjectProperty ;\\n    rdfs:label \\\"track song relation\\\" ;\\n    rdfs:comment \\\"Inverse of track: relates a track to its track-song relation.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :TrackSongRelation ;\\n    owl:inverseOf :track .\\n\\n:songComposedOn a owl:DatatypeProperty ;\\n    rdfs:label \\\"song composed on\\\" ;\\n    rdfs:comment \\\"The date/time a song was composed.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range xsd:dateTime .\\n\\n:criticReview a owl:ObjectProperty ;\\n    rdfs:label \\\"critic review\\\" ;\\n    rdfs:comment \\\"Relates a critic to an album they reviewed.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :reviewedByCritic .\\n\\n:reviewedByCritic a owl:ObjectProperty ;\\n    rdfs:label \\\"reviewed by critic\\\" ;\\n    rdfs:comment \\\"Inverse of criticReview: relates an album to the critic who reviewed it.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :criticReview .\\n\\n:reviewText a owl:DatatypeProperty ;\\n    rdfs:label \\\"review text\\\" ;\\n    rdfs:comment \\\"The textual review by a critic of an album.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range xsd:string .\\n\\n:performanceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"performance of\\\" ;\\n    rdfs:comment \\\"Relates a performance-song to the song performed.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :performedAtPerformance .\\n\\n:performedAtPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"performed at performance\\\" ;\\n    rdfs:comment \\\"Inverse of performanceOf: relates a song to the performance-song relation.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceOf .\\n\\n:performance a owl:ObjectProperty ;\\n    rdfs:label \\\"performance\\\" ;\\n    rdfs:comment \\\"Relates a performance-song to the performance event.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceSongRelation .\\n\\n:performanceSongRelation a owl:ObjectProperty ;\\n    rdfs:label \\\"performance song relation\\\" ;\\n    rdfs:comment \\\"Inverse of performance: relates a performance to its performance-song relation.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performance .\\n\\n:performanceDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"performance date\\\" ;\\n    rdfs:comment \\\"The date/time of a performance.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:dateTime .\\n\\n:performanceLocation a owl:ObjectProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"Relates a performance to the city where it took place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityPerformance .\\n\\n:cityPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"city performance\\\" ;\\n    rdfs:comment \\\"Inverse of performanceLocation: relates a city to performances held there.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceLocation .\\n\\n:cityInRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"city in region\\\" ;\\n    rdfs:comment \\\"Relates a city to the region it is in.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionHasCity .\\n\\n:regionHasCity a owl:ObjectProperty ;\\n    rdfs:label \\\"region has city\\\" ;\\n    rdfs:comment \\\"Inverse of cityInRegion: relates a region to the cities it contains.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityInRegion .\\n\\n:regionInCountry a owl:ObjectProperty ;\\n    rdfs:label \\\"region in country\\\" ;\\n    rdfs:comment \\\"Relates a region to the country it is in.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country ;\\n    owl:inverseOf :countryHasRegion .\\n\\n:countryHasRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"country has region\\\" ;\\n    rdfs:comment \\\"Inverse of regionInCountry: relates a country to its regions.\\\" ;\\n    rdfs:domain :Country ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionInCountry .\\n\\n:albumReleaseDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"album release date\\\" ;\\n    rdfs:comment \\\"The release date of an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:dateTime .\\n\\n:albumTrackCount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"album track count\\\" ;\\n    rdfs:comment \\\"The number of tracks contained in an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:integer .\\n\\n#################################################################\\n#    Class Axioms and Restrictions\\n#################################################################\\n\\n:Album rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasTrack ;\\n    owl:someValuesFrom :Track\\n] .\\n\\n:TrackSongRelation rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :track ;\\n    owl:cardinality 1\\n] , [\\n    a owl:Restriction ;\\n    owl:onProperty :isRecordingOf ;\\n    owl:cardinality 1\\n] .\\n\\n:PerformanceSong rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :performance ;\\n    owl:cardinality 1\\n] , [\\n    a owl:Restriction ;\\n    owl:onProperty :performanceOf ;\\n    owl:cardinality 1\\n] .\\n\\n#################################################################\\n#    Disjointness\\n#################################################################\\n\\n:Person owl:disjointWith :Band , :Instrument .\\n:Band owl:disjointWith :Instrument .\\n:Album owl:disjointWith :Track .\\n:Song owl:disjointWith :Album .\\n:Critic owl:disjointWith :Person .\\n:Performance owl:disjointWith :Band .\\n\\n#################################################################\\n#    End of Ontology\\n#################################################################\\n\"}",
