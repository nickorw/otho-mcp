2026-03-04 06:30:37 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, organizations, roles, and line items as described in the story.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level envelope in an EDIFACT message, containing messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business message contained in an Interchange Envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A type of message representing an invoice, composed of header, detail, and summary sections.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite data element or segment.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header section of an invoice message containing document dates and reference numbers.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The detail section listing line items in the invoice.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The summary section providing total tax and invoice amounts.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the detail section, referencing an item, quantity, and net price.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item sold in the invoice.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice, such as buyer or delivery party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of the invoice (e.g., Buyer, Delivery Party).\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A pivot class reifying the assignment of a role and address to an organization in an invoice.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address (e.g., headquarters or warehouse) associated with an organization role assignment.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A formal identifier such as a Global Location Number used in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value associated with a line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n#################################################################\n# Object Properties (with inverses and new connections)\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an Interchange Envelope to the contained Message(s).\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range rdf:Resource ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an invoice message to one of its sections (header, detail, summary).\" ;\n    owl:inverseOf :isSectionOfInvoice .\n\n:isSectionOfInvoice a owl:ObjectProperty ;\n    rdfs:domain rdf:Resource ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is section of invoice\" ;\n    rdfs:comment \"Inverse of hasSection.\" .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :HeaderSection ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an invoice message to its header section.\" ;\n    owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is header of\" ;\n    rdfs:comment \"Inverse of hasHeader.\" .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links an invoice message to its detail section.\" ;\n    owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is detail of\" ;\n    rdfs:comment \"Inverse of hasDetail.\" .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links an invoice message to its summary section.\" ;\n    owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is summary of\" ;\n    rdfs:comment \"Inverse of hasSummary.\" .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links a detail section to its line items.\" ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" .\n\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a line item to the item being sold.\" ;\n    owl:inverseOf :isItemOfLineItem .\n\n:isItemOfLineItem a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is item of line item\" ;\n    rdfs:comment \"Inverse of hasItem.\" .\n\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a line item to its net price.\" ;\n    owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice.\" .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Links an invoice message to an organization role assignment (pivot class).\" ;\n    owl:inverseOf :isOrganizationRoleAssignmentOf .\n\n:isOrganizationRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is organization role assignment of\" ;\n    rdfs:comment \"Inverse of hasOrganizationRoleAssignment.\" .\n\n:involvesOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an organization role assignment to the involved organization.\" ;\n    owl:inverseOf :isOrganizationInRoleAssignment .\n\n:isOrganizationInRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is organization in role assignment\" ;\n    rdfs:comment \"Inverse of involvesOrganization.\" .\n\n:hasAgentRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links an organization role assignment to the agent role played.\" ;\n    owl:inverseOf :isAgentRoleInAssignment .\n\n:isAgentRoleInAssignment a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is agent role in assignment\" ;\n    rdfs:comment \"Inverse of hasAgentRole.\" .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization role assignment to an address (e.g., headquarters or warehouse).\" ;\n    owl:inverseOf :isAddressInRoleAssignment .\n\n:isAddressInRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is address in role assignment\" ;\n    rdfs:comment \"Inverse of hasAddress.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization role assignment to an identifier (e.g., GLN).\" ;\n    owl:inverseOf :isIdentifierForRoleAssignment .\n\n:isIdentifierForRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is identifier for role assignment\" ;\n    rdfs:comment \"Inverse of hasIdentifier.\" .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice message to a business process.\" ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Inverse of hasBusinessProcess.\" .\n\n# New connections for CompositeDataElement and SimpleDataElement\n:hasCompositeDataElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite data element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    owl:inverseOf :isCompositeDataElementOf .\n\n:isCompositeDataElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite data element of\" ;\n    rdfs:comment \"Inverse of hasCompositeDataElement.\" .\n\n:hasSimpleDataElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    owl:inverseOf :isSimpleDataElementOf .\n\n:isSimpleDataElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple data element of\" ;\n    rdfs:comment \"Inverse of hasSimpleDataElement.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:roleType a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string ;\n    rdfs:label \"role type\" ;\n    rdfs:comment \"The type of role played by an agent (e.g., Buyer, Delivery Party).\" .\n\n:addressLine a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The address line of an address.\" .\n\n:city a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city of an address.\" .\n\n:postalCode a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"The postal code of an address.\" .\n\n:countryCode a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"The country code of an address.\" .\n\n:identifierValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of an identifier (e.g., GLN number).\" .\n\n:identifierScheme a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier scheme\" ;\n    rdfs:comment \"The scheme or type of identifier (e.g., GLN, VAT).\" .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of the item in the line item.\" .\n\n:itemDescription a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"A description of the item sold.\" .\n\n:priceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"price amount\" ;\n    rdfs:comment \"The net price amount for a line item.\" .\n\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"The invoice total amount.\" .\n\n:totalTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"total tax amount\" ;\n    rdfs:comment \"Total tax amount in the summary section.\" .\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The invoice number in the header section.\" .\n\n:invoiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"invoice date\" ;\n    rdfs:comment \"The invoice date in the header section.\" .\n\n#################################################################\n# Restrictions and Axioms\n#################################################################\n\n# InvoiceMessage must have exactly one header, detail, and summary section\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasHeader ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasDetail ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasSummary ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n# DetailSection must have at least one line item\n:DetailSection rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasLineItem ;\n    owl:minCardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n# OrganizationRoleAssignment must have exactly one organization, one agent role, and one address\n:OrganizationRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :involvesOrganization ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasAgentRole ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasAddress ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n# Disjointness axioms\n:Organization owl:disjointWith :Item , :Address , :AgentRole .\n:Message owl:disjointWith :Segment .\n:Segment owl:disjointWith :CompositeDataElement .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n"
