] .\\n\\n# DetailSection must have at least one line item\\n:DetailSection rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasLineItem ;\\n    owl:minCardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] .\\n\\n# OrganizationRoleAssignment must have exactly one organization, one agent role, and one address\\n:OrganizationRoleAssignment rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :involvesOrganization ;\\n    owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] , [\\n    a owl:Restriction ;\\n    owl:onProperty :hasAgentRole ;\\n    owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] , [\\n    a owl:Restriction ;\\n    owl:onProperty :hasAddress ;\\n    owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] .\\n\\n# Disjointness axioms\\n:Organization owl:disjointWith :Item , :Address , :AgentRole .\\n:Message owl:disjointWith :Segment .\\n:Segment owl:disjointWith :CompositeDataElement .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n\"}",
