      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoic-d96a>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC D96A Ontology\" ;\n    rdfs:comment \"An ontology for the UN/EDIFACT INVOIC message structure, supporting D96A, EN 16931-1, and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope that contains one or more EDIFACT Messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT Message container.\" .\n\n:INVOICMessage a owl:Class ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"INVOIC message for global trade transactions.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment in an EDIFACT message.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:DTM_Segment a owl:Class ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment for document, delivery, and payment dates.\" ;\n    rdfs:subClassOf :Segment .\n\n:TAX_Segment a owl:Class ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax segment for tax details.\" ;\n    rdfs:subClassOf :Segment .\n\n:MOA_Segment a owl:Class ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment for invoice, tax, and line totals.\" ;\n    rdfs:subClassOf :Segment .\n\n:ALC_Segment a owl:Class ;\n    rdfs:label \"ALC Segment\" ;\n    rdfs:comment \"Allowance or Charge segment for discounts and surcharges.\" ;\n    rdfs:subClassOf :Segment .\n\n:MEA_Segment a owl:Class ;\n    rdfs:label \"MEA Segment\" ;\n    rdfs:comment \"Measurement segment for quantities, weights, and measures.\" ;\n    rdfs:subClassOf :Segment .\n\n:RFD_Segment a owl:Class ;\n    rdfs:label \"RFD Segment\" ;\n    rdfs:comment \"Reference segment for external and internal references.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"Composite data element in a segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"Atomic data element in a composite.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section of an INVOIC message.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section with invoice lines.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section with invoice totals.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization participating in the transaction.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the invoice context.\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role of buyer in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"Role of delivery party in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Address of an organization.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"GLN identifier for organizations.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or good sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Price of an item in the invoice.\" .\n\n:Quantity a owl:Class ;\n    rdfs:label \"Quantity\" ;\n    rdfs:comment \"Quantity of an item in the invoice.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"The invoice document itself.\" .\n\n:InvoiceLine a owl:Class ;\n    rdfs:label \"Invoice Line\" ;\n    rdfs:comment \"A line item in the invoice.\" ;\n    rdfs:subClassOf :DetailSection .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Reference number for the invoice or document.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for reifying the assignment of a role to an organization in a message context.\" .\n\n:InvoiceItemAssignment a owl:Class ;\n    rdfs:label \"Invoice Item Assignment\" ;\n    rdfs:comment \"Pivot class for reifying the assignment of an item to an invoice line.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to the Messages it contains.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n:containsMessage rdf:type owl:TransitiveProperty .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Associates a Message with its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Associates an INVOICMessage with its sections (header, detail, summary).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range [ owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] .\n:hasSection rdf:type owl:FunctionalProperty .\n\n:hasDataElement a owl:ObjectProperty ;\n    rdfs:label \"has data element\" ;\n    rdfs:comment \"Associates a Segment with its CompositeDataElements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleDataElement a owl:ObjectProperty ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Associates a CompositeDataElement with its SimpleDataElements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Relates an INVOICMessage to its OrganizationRoleAssignment instances.\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:assignsRole a owl:ObjectProperty ;\n    rdfs:label \"assigns role\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to an AgentRole.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n:assignsRole rdf:type owl:FunctionalProperty .\n\n:assignedToOrganization a owl:ObjectProperty ;\n    rdfs:label \"assigned to organization\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to an Organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n:assignedToOrganization rdf:type owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n:hasAddress rdf:type owl:FunctionalProperty .\n\n:hasInvoice a owl:ObjectProperty ;\n    rdfs:label \"has invoice\" ;\n    rdfs:comment \"Links an INVOICMessage to an Invoice.\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :Invoice .\n:hasInvoice rdf:type owl:FunctionalProperty .\n\n:hasInvoiceLine a owl:ObjectProperty ;\n    rdfs:label \"has invoice line\" ;\n    rdfs:comment \"Links an Invoice to its InvoiceLines.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceLine .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links an InvoiceLine to an Item.\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Item .\n:hasItem rdf:type owl:FunctionalProperty .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links an InvoiceLine to a Price.\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Price .\n:hasPrice rdf:type owl:FunctionalProperty .\n\n:hasQuantity a owl:ObjectProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Links an InvoiceLine to a Quantity.\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Quantity .\n:hasQuantity rdf:type owl:FunctionalProperty .\n\n:hasDTMSegment a owl:ObjectProperty ;\n    rdfs:label \"has DTM segment\" ;\n    rdfs:comment \"Links an INVOICMessage to its DTM_Segment(s).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :DTM_Segment .\n\n:hasTAXSegment a owl:ObjectProperty ;\n    rdfs:label \"has TAX segment\" ;\n    rdfs:comment \"Links an INVOICMessage to its TAX_Segment(s).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :TAX_Segment .\n\n:hasMOASegment a owl:ObjectProperty ;\n    rdfs:label \"has MOA segment\" ;\n    rdfs:comment \"Links an INVOICMessage to its MOA_Segment(s).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :MOA_Segment .\n\n:hasALCSegment a owl:ObjectProperty ;\n    rdfs:label \"has ALC segment\" ;\n    rdfs:comment \"Links an INVOICMessage to its ALC_Segment(s).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :ALC_Segment .\n\n:hasMEASegment a owl:ObjectProperty ;\n    rdfs:label \"has MEA segment\" ;\n    rdfs:comment \"Links an INVOICMessage to its MEA_Segment(s).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :MEA_Segment .\n\n:hasRFDSegment a owl:ObjectProperty ;\n    rdfs:label \"has RFD segment\" ;\n    rdfs:comment \"Links an INVOICMessage to its RFD_Segment(s).\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :RFD_Segment .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"GLN identifier for an Organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n:hasGlobalLocationNumber rdf:type owl:FunctionalProperty .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Reference number of a document or invoice.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n:hasReferenceNumber rdf:type owl:FunctionalProperty .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Date of the document (string, ISO format).\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n:hasDocumentDate rdf:type owl:FunctionalProperty .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n:hasInvoiceAmount rdf:type owl:FunctionalProperty .\n\n:hasTaxTotal a owl:DatatypeProperty ;\n    rdfs:label \"has tax total\" ;\n    rdfs:comment \"Total tax amount in the summary.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n:hasTaxTotal rdf:type owl:FunctionalProperty .\n\n#################################################################\n# Restrictions and GCAs\n#################################################################\n\n:BuyerRole owl:equivalentClass [\n    a owl:Restriction ;\n    owl:onProperty :assignsRole ;\n    owl:someValuesFrom :Organization\n] .\n\n:INVOICMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasSection ;\n    owl:allValuesFrom [ owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ]\n] .\n\n:InvoiceLine rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasItem ;\n    owl:someValuesFrom :Item\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasPrice ;\n    owl:someValuesFrom :Price\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasQuantity ;\n    owl:someValuesFrom :Quantity\n] .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\n:Organization owl:disjointWith :Item .\n:AgentRole owl:disjointWith :Organization .\n\n#################################################################\n# Disjoint Union\n#################################################################\n\n:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\n"
}
