      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production> a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology describing music production, bands, albums, performances, and related entities.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual, such as a musician or critic.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A musical group or band.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A role that a person can have in a band or performance (e.g., vocalist, drummer).\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A music album released by a band or artist.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A track included in an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition (can be recorded as a track).\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews or critiques music albums.\" ;\n    owl:disjointWith :Person .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live music performance event.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances can take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes for Reification\n\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A membership relation between a person and a band, with role and temporal information.\" .\n\n:Contribution a owl:Class ;\n    rdfs:label \"Contribution\" ;\n    rdfs:comment \"A contribution relation of a person to a band in a certain role and time.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"An event of recording an album, with temporal information.\" .\n\n:TrackRecording a owl:Class ;\n    rdfs:label \"Track Recording\" ;\n    rdfs:comment \"An event of recording a track as a recording of a song.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reification class linking a performance and the song performed.\" .\n\n#################################################################\n# Object Properties and Inverses\n#################################################################\n\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a Person to the Instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:inverseOf :instrumentPlayedBy .\n\n:instrumentPlayedBy a owl:ObjectProperty ;\n    rdfs:label \"instrument played by\" ;\n    rdfs:comment \"Inverse of playsInstrument. Relates an Instrument to the Person who plays it.\" ;\n    rdfs:domain :Instrument ;\n    rdfs:range :Person ;\n    owl:inverseOf :playsInstrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member (pivot)\" ;\n    rdfs:comment \"Relates a Band to a BandMembership instance.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :membershipOf .\n\n:membershipOf a owl:ObjectProperty ;\n    rdfs:label \"membership of\" ;\n    rdfs:comment \"Inverse of hasMember. Relates a BandMembership to the Band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:inverseOf :hasMember .\n\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"member person\" ;\n    rdfs:comment \"Relates a BandMembership to the Person who is a member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person ;\n    owl:inverseOf :personMembership .\n\n:personMembership a owl:ObjectProperty ;\n    rdfs:label \"person membership\" ;\n    rdfs:comment \"Inverse of memberPerson. Relates a Person to their BandMembership(s).\" ;\n    rdfs:domain :Person ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :memberPerson .\n\n:memberRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"member role\" ;\n    rdfs:comment \"Relates a BandMembership to the Role the person has in the band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role ;\n    owl:inverseOf :roleOfMembership .\n\n:roleOfMembership a owl:ObjectProperty ;\n    rdfs:label \"role of membership\" ;\n    rdfs:comment \"Inverse of memberRole. Relates a Role to BandMembership(s).\" ;\n    rdfs:domain :Role ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :memberRole .\n\n:contributesTo a owl:ObjectProperty ;\n    rdfs:label \"contributes to (pivot)\" ;\n    rdfs:comment \"Relates a Person to a Contribution instance.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Contribution ;\n    owl:inverseOf :contributionBy .\n\n:contributionBy a owl:ObjectProperty ;\n    rdfs:label \"contribution by\" ;\n    rdfs:comment \"Inverse of contributesTo. Relates a Contribution to the Person.\" ;\n    rdfs:domain :Contribution ;\n    rdfs:range :Person ;\n    owl:inverseOf :contributesTo .\n\n:contributionBand a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contribution band\" ;\n    rdfs:comment \"Relates a Contribution to a Band.\" ;\n    rdfs:domain :Contribution ;\n    rdfs:range :Band ;\n    owl:inverseOf :bandContribution .\n\n:bandContribution a owl:ObjectProperty ;\n    rdfs:label \"band contribution\" ;\n    rdfs:comment \"Inverse of contributionBand. Relates a Band to Contribution(s).\" ;\n    rdfs:domain :Band ;\n    rdfs:range :Contribution ;\n    owl:inverseOf :contributionBand .\n\n:contributionRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contribution role\" ;\n    rdfs:comment \"Relates a Contribution to a Role.\" ;\n    rdfs:domain :Contribution ;\n    rdfs:range :Role ;\n    owl:inverseOf :roleOfContribution .\n\n:roleOfContribution a owl:ObjectProperty ;\n    rdfs:label \"role of contribution\" ;\n    rdfs:comment \"Inverse of contributionRole. Relates a Role to Contribution(s).\" ;\n    rdfs:domain :Role ;\n    rdfs:range :Contribution ;\n    owl:inverseOf :contributionRole .\n\n:recordsAlbum a owl:ObjectProperty ;\n    rdfs:label \"records album (pivot)\" ;\n    rdfs:comment \"Relates a Band to an AlbumRecording event.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :albumRecordingBy .\n\n:albumRecordingBy a owl:ObjectProperty ;\n    rdfs:label \"album recording by\" ;\n    rdfs:comment \"Inverse of recordsAlbum. Relates an AlbumRecording to the Band.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Band ;\n    owl:inverseOf :recordsAlbum .\n\n:albumBeingRecorded a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"album being recorded\" ;\n    rdfs:comment \"Relates an AlbumRecording to the Album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album ;\n    owl:inverseOf :recordedInAlbumRecording .\n\n:recordedInAlbumRecording a owl:ObjectProperty ;\n    rdfs:label \"recorded in album recording\" ;\n    rdfs:comment \"Inverse of albumBeingRecorded. Relates an Album to AlbumRecording(s).\" ;\n    rdfs:domain :Album ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :albumBeingRecorded .\n\n:containsTrack a owl:ObjectProperty ;\n    rdfs:label \"contains track\" ;\n    rdfs:comment \"Relates an Album to its Tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track ;\n    owl:inverseOf :trackContainedIn .\n\n:trackContainedIn a owl:ObjectProperty ;\n    rdfs:label \"track contained in\" ;\n    rdfs:comment \"Inverse of containsTrack. Relates a Track to the Album(s) it is contained in.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album ;\n    owl:inverseOf :containsTrack .\n\n:trackBeingRecorded a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"track being recorded\" ;\n    rdfs:comment \"Relates a TrackRecording to the Track.\" ;\n    rdfs:domain :TrackRecording ;\n    rdfs:range :Track ;\n    owl:inverseOf :recordedByTrackRecording .\n\n:recordedByTrackRecording a owl:ObjectProperty ;\n    rdfs:label \"recorded by track recording\" ;\n    rdfs:comment \"Inverse of trackBeingRecorded. Relates a Track to TrackRecording(s).\" ;\n    rdfs:domain :Track ;\n    rdfs:range :TrackRecording ;\n    owl:inverseOf :trackBeingRecorded .\n\n:trackRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"track recording of\" ;\n    rdfs:comment \"Relates a TrackRecording to the Song it records.\" ;\n    rdfs:domain :TrackRecording ;\n    rdfs:range :Song ;\n    owl:inverseOf :songRecordedBy .\n\n:songRecordedBy a owl:ObjectProperty ;\n    rdfs:label \"song recorded by\" ;\n    rdfs:comment \"Inverse of trackRecordingOf. Relates a Song to TrackRecording(s).\" ;\n    rdfs:domain :Song ;\n    rdfs:range :TrackRecording ;\n    owl:inverseOf :trackRecordingOf .\n\n:criticReview a owl:ObjectProperty ;\n    rdfs:label \"critic review\" ;\n    rdfs:comment \"Relates a Critic to an Album they reviewed.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :Album ;\n    owl:inverseOf :reviewedByCritic .\n\n:reviewedByCritic a owl:ObjectProperty ;\n    rdfs:label \"reviewed by critic\" ;\n    rdfs:comment \"Inverse of criticReview. Relates an Album to the Critic(s) who reviewed it.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critic ;\n    owl:inverseOf :criticReview .\n\n:performedAt a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performed at\" ;\n    rdfs:comment \"Relates a Performance to the City where it took place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City ;\n    owl:inverseOf :locationOfPerformance .\n\n:locationOfPerformance a owl:ObjectProperty ;\n    rdfs:label \"location of performance\" ;\n    rdfs:comment \"Inverse of performedAt. Relates a City to Performance(s) held there.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Performance ;\n    owl:inverseOf :performedAt .\n\n:performanceSong a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance song\" ;\n    rdfs:comment \"Relates a PerformanceSong to the Song performed.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song ;\n    owl:inverseOf :performedInPerformance .\n\n:performedInPerformance a owl:ObjectProperty ;\n    rdfs:label \"performed in performance\" ;\n    rdfs:comment \"Inverse of performanceSong. Relates a Song to PerformanceSong(s) in which it was performed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performanceSong .\n\n:performanceInstance a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance instance\" ;\n    rdfs:comment \"Relates a PerformanceSong to the Performance.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance ;\n    owl:inverseOf :songPerformedAt .\n\n:songPerformedAt a owl:ObjectProperty ;\n    rdfs:label \"song performed at\" ;\n    rdfs:comment \"Inverse of performanceInstance. Relates a Performance to the PerformanceSong(s) (song-performances) it includes.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performanceInstance .\n\n:locatedInRegion a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"located in region\" ;\n    rdfs:comment \"Relates a City to the Region it is located in.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region ;\n    owl:inverseOf :regionHasCity .\n\n:regionHasCity a owl:ObjectProperty ;\n    rdfs:label \"region has city\" ;\n    rdfs:comment \"Inverse of locatedInRegion. Relates a Region to City(ies) it contains.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :City ;\n    owl:inverseOf :locatedInRegion .\n\n:regionInCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"region in country\" ;\n    rdfs:comment \"Relates a Region to the Country it is located in.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country ;\n    owl:inverseOf :countryHasRegion .\n\n:countryHasRegion a owl:ObjectProperty ;\n    rdfs:label \"country has region\" ;\n    rdfs:comment \"Inverse of regionInCountry. Relates a Country to Region(s) it contains.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :Region ;\n    owl:inverseOf :regionInCountry .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:membershipStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"membership start\" ;\n    rdfs:comment \"Start time of membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:dateTime .\n\n:membershipEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"membership end\" ;\n    rdfs:comment \"End time of membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:dateTime .\n\n:contributionStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"contribution start\" ;\n    rdfs:comment \"Start time of contribution.\" ;\n    rdfs:domain :Contribution ;\n    rdfs:range xsd:dateTime .\n\n:contributionEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"contribution end\" ;\n    rdfs:comment \"End time of contribution.\" ;\n    rdfs:domain :Contribution ;\n    rdfs:range xsd:dateTime .\n\n:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"Start date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"End date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:trackRecordingDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"track recording date\" ;\n    rdfs:comment \"Date a track was recorded.\" ;\n    rdfs:domain :TrackRecording ;\n    rdfs:range xsd:dateTime .\n\n:songComposedDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"song composed date\" ;\n    rdfs:comment \"Date a song was composed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:dateTime .\n\n:reviewText a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"review text\" ;\n    rdfs:comment \"Review text provided by a Critic.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range xsd:string .\n\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"Date a Performance took place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:dateTime .\n\n#################################################################\n# Axioms and Restrictions\n#################################################################\n\n# Album must have at least one track (CQ15)\n:Album rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :containsTrack ;\n    owl:someValuesFrom :Track\n] .\n\n# Disjointness\n:Person owl:disjointWith :Band, :Critic .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Song .\n:Track owl:disjointWith :Song .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n\n# End of ontology"
}
