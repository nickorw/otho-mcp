 rdfs:comment \"Links a city to its country.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Country .\n\n:basisOfProduction a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"basis of production\" ;\n    rdfs:comment \"Links a production to the play it is based on.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :Play .\n\n:hasEnsemble a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has ensemble\" ;\n    rdfs:comment \"Links a production to its ensemble.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :Ensemble .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Links an ensemble to its members.\" ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :Person .\n\n:hasAuthor a owl:ObjectProperty ;\n    rdfs:label \"has author\" ;\n    rdfs:comment \"Links a play to its author.\" ;\n    rdfs:domain :Play ;\n    rdfs:range :Author .\n\n:hasAct a owl:ObjectProperty ;\n    rdfs:label \"has act\" ;\n    rdfs:comment \"Links a play to its acts.\" ;\n    rdfs:domain :Play ;\n    rdfs:range :Act .\n\n:hasReview a owl:ObjectProperty ;\n    rdfs:label \"has review\" ;\n    rdfs:comment \"Links a production to a review.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :Review .\n\n:givenBy a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"given by\" ;\n    rdfs:comment \"Links a review to the newspaper that published it.\" ;\n    rdfs:domain :Review ;\n    rdfs:range :Newspaper .\n\n:hasProductionRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has production role assignment\" ;\n    rdfs:comment \"Links a production to a production role assignment instance.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :ProductionRoleAssignment .\n\n:productionRoleActor a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"production role actor\" ;\n    rdfs:comment \"Links a production role assignment to the actor.\" ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Actor .\n\n:productionRoleRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"production role role\" ;\n    rdfs:comment \"Links a production role assignment to the role.\" ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Role .\n\n:hasEnsembleMembership a owl:ObjectProperty ;\n    rdfs:label \"has ensemble membership\" ;\n    rdfs:comment \"Links an ensemble to an ensemble membership instance.\" ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :EnsembleMembership .\n\n:ensembleMember a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"ensemble member\" ;\n    rdfs:comment \"Links an ensemble membership to the person.\" ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range :Person .\n\n### Data Properties\n:heldInYear a owl:DatatypeProperty ;\n    rdfs:label \"held in year\" ;\n    rdfs:comment \"The year in which a festival is held.\" ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range xsd:gYear .\n\n:writtenDuring a owl:DatatypeProperty ;\n    rdfs:label \"written during\" ;\n    rdfs:comment \"The period during which a play was written.\" ;\n    rdfs:domain :Play ;\n    rdfs:range xsd:string .\n\n:actNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"act number\" ;\n    rdfs:comment \"The number of an act within a play.\" ;\n    rdfs:domain :Act ;\n    rdfs:range xsd:integer .\n\n:hasPremier a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has premier\" ;\n    rdfs:comment \"The date and time of the premier of a production.\" ;\n    rdfs:domain :Production ;\n    rdfs:range xsd:dateTime .\n\n:starRating a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"star rating\" ;\n    rdfs:comment \"The star rating given in a review.\" ;\n    rdfs:domain :Review ;\n    rdfs:range xsd:integer .\n\n:employedSince a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"employed since\" ;\n    rdfs:comment \"The date and time when an actor started working at a theatre.\" ;\n    rdfs:domain :Actor ;\n    rdfs:range xsd:dateTime .\n\n:productionRoleTime a owl:DatatypeProperty ;\n    rdfs:label \"production role time\" ;\n    rdfs:comment \"The time period for which a production role assignment is valid.\" ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range xsd:string .\n\n:ensembleMembershipTime a owl:DatatypeProperty ;\n    rdfs:label \"ensemble membership time\" ;\n    rdfs:comment \"The time period for which an ensemble membership is valid.\" ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range xsd:string .\n\n### Restrictions and Axioms\n:Production rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasPremier ;\n    owl:cardinality 1\n] .\n"
}
