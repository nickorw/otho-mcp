      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/theatre-productions>\n    a owl:Ontology ;\n    rdfs:label \"Theatre Productions Ontology\" ;\n    rdfs:comment \"Ontology for representing theatre festivals, productions, plays, people, and reviews in Italy as described in the theatre productions story.\" .\n\n### Classes\n:TheatreFestival a owl:Class ;\n    rdfs:label \"Theatre Festival\" ;\n    rdfs:comment \"A festival event where multiple theatre productions are performed.\" .\n\n:Theatre a owl:Class ;\n    rdfs:label \"Theatre\" ;\n    rdfs:comment \"A physical location where theatre productions are held.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city in which theatres or festivals are located.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing cities.\" .\n\n:Play a owl:Class ;\n    rdfs:label \"Play\" ;\n    rdfs:comment \"A dramatic work that can be performed as a theatre production.\" .\n\n:Production a owl:Class ;\n    rdfs:label \"Production\" ;\n    rdfs:comment \"A specific staging or setup of a play.\" .\n\n:Ensemble a owl:Class ;\n    rdfs:label \"Ensemble\" ;\n    rdfs:comment \"A group of people performing together in a production.\" .\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual participating in theatre events.\" .\n\n:Actor a owl:Class ;\n    rdfs:label \"Actor\" ;\n    rdfs:comment \"A person who acts in a production.\" ;\n    rdfs:subClassOf :Person .\n\n:Author a owl:Class ;\n    rdfs:label \"Author\" ;\n    rdfs:comment \"A person who writes plays.\" ;\n    rdfs:subClassOf :Person .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A character or function performed by an actor in a production.\" .\n\n:Review a owl:Class ;\n    rdfs:label \"Review\" ;\n    rdfs:comment \"A critical evaluation of a production.\" .\n\n:Newspaper a owl:Class ;\n    rdfs:label \"Newspaper\" ;\n    rdfs:comment \"A periodical publication that may publish reviews.\" .\n\n:Act a owl:Class ;\n    rdfs:label \"Act\" ;\n    rdfs:comment \"A major division within a play.\" .\n\n:ProductionRoleAssignment a owl:Class ;\n    rdfs:label \"Production Role Assignment\" ;\n    rdfs:comment \"A reified relation linking an actor, a role, a production, and a time period.\" .\n\n:EnsembleMembership a owl:Class ;\n    rdfs:label \"Ensemble Membership\" ;\n    rdfs:comment \"A reified relation linking a person to an ensemble with a time period.\" .\n\n### Disjointness\n:Actor owl:disjointWith :Author .\n:Person owl:disjointWith :Theatre , :TheatreFestival , :City , :Country , :Play , :Production , :Ensemble , :Review , :Newspaper , :Act .\n\n### Object Properties\n:hasLocation a owl:ObjectProperty ;\n    rdfs:label \"has location\" ;\n    rdfs:comment \"Links a theatre festival to the city where it is held.\" ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range :City .\n\ntakesPlaceIn a owl:ObjectProperty ;\n    rdfs:label \"takes place in\" ;\n    rdfs:comment \"Alternative property linking a theatre festival to its city.\" ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range :City .\n\n:featuresPlay a owl:ObjectProperty ;\n    rdfs:label \"features play\" ;\n    rdfs:comment \"Links a festival to plays that are performed.\" ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range :Play .\n\n:locatedInCity a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"located in city\" ;\n    rdfs:comment \"Links a theatre to the city where it is located.\" ;\n    rdfs:domain :Theatre ;\n    rdfs:range :City .\n\n:locatedInCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"located in country\" ;\n    rdfs:comment \"Links a city to its country.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Country .\n\n:basisOfProduction a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"basis of production\" ;\n    rdfs:comment \"Links a production to the play it is based on.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :Play .\n\n:hasEnsemble a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has ensemble\" ;\n    rdfs:comment \"Links a production to its ensemble.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :Ensemble .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Links an ensemble to its members.\" ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :Person .\n\n:hasAuthor a owl:ObjectProperty ;\n    rdfs:label \"has author\" ;\n    rdfs:comment \"Links a play to its author.\" ;\n    rdfs:domain :Play ;\n    rdfs:range :Author .\n\n:hasAct a owl:ObjectProperty ;\n    rdfs:label \"has act\" ;\n    rdfs:comment \"Links a play to its acts.\" ;\n    rdfs:domain :Play ;\n    rdfs:range :Act .\n\n:hasReview a owl:ObjectProperty ;\n    rdfs:label \"has review\" ;\n    rdfs:comment \"Links a production to a review.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :Review .\n\n:givenBy a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"given by\" ;\n    rdfs:comment \"Links a review to the newspaper that published it.\" ;\n    rdfs:domain :Review ;\n    rdfs:range :Newspaper .\n\n:hasProductionRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has production role assignment\" ;\n    rdfs:comment \"Links a production to a production role assignment instance.\" ;\n    rdfs:domain :Production ;\n    rdfs:range :ProductionRoleAssignment .\n\n:productionRoleActor a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"production role actor\" ;\n    rdfs:comment \"Links a production role assignment to the actor.\" ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Actor .\n\n:productionRoleRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"production role role\" ;\n    rdfs:comment \"Links a production role assignment to the role.\" ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range :Role .\n\n:hasEnsembleMembership a owl:ObjectProperty ;\n    rdfs:label \"has ensemble membership\" ;\n    rdfs:comment \"Links an ensemble to an ensemble membership instance.\" ;\n    rdfs:domain :Ensemble ;\n    rdfs:range :EnsembleMembership .\n\n:ensembleMember a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"ensemble member\" ;\n    rdfs:comment \"Links an ensemble membership to the person.\" ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range :Person .\n\n### Data Properties\n:heldInYear a owl:DatatypeProperty ;\n    rdfs:label \"held in year\" ;\n    rdfs:comment \"The year in which a festival is held.\" ;\n    rdfs:domain :TheatreFestival ;\n    rdfs:range xsd:gYear .\n\n:writtenDuring a owl:DatatypeProperty ;\n    rdfs:label \"written during\" ;\n    rdfs:comment \"The period during which a play was written.\" ;\n    rdfs:domain :Play ;\n    rdfs:range xsd:string .\n\n:actNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"act number\" ;\n    rdfs:comment \"The number of an act within a play.\" ;\n    rdfs:domain :Act ;\n    rdfs:range xsd:integer .\n\n:hasPremier a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has premier\" ;\n    rdfs:comment \"The date and time of the premier of a production.\" ;\n    rdfs:domain :Production ;\n    rdfs:range xsd:dateTime .\n\n:starRating a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"star rating\" ;\n    rdfs:comment \"The star rating given in a review.\" ;\n    rdfs:domain :Review ;\n    rdfs:range xsd:integer .\n\n:employedSince a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"employed since\" ;\n    rdfs:comment \"The date and time when an actor started working at a theatre.\" ;\n    rdfs:domain :Actor ;\n    rdfs:range xsd:dateTime .\n\n:productionRoleTime a owl:DatatypeProperty ;\n    rdfs:label \"production role time\" ;\n    rdfs:comment \"The time period for which a production role assignment is valid.\" ;\n    rdfs:domain :ProductionRoleAssignment ;\n    rdfs:range xsd:string .\n\n:ensembleMembershipTime a owl:DatatypeProperty ;\n    rdfs:label \"ensemble membership time\" ;\n    rdfs:comment \"The time period for which an ensemble membership is valid.\" ;\n    rdfs:domain :EnsembleMembership ;\n    rdfs:range xsd:string .\n\n### Restrictions and Axioms\n:Production rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasPremier ;\n    owl:cardinality 1\n] .\n"
}
