      "id": "call_JyXCcS2WbDMoNhO0boVP9iVK",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/hospital-story-1> a owl:Ontology ;\\n    rdfs:label \\\"Hospital Story Ontology\\\" ;\\n    rdfs:comment \\\"An ontology modeling hospital staff, unions, evaluations, academic activities, and events based on a narrative scenario.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual, such as staff or authors.\\\" .\\n\\n:Nurse a owl:Class ;\\n    rdfs:label \\\"Nurse\\\" ;\\n    rdfs:comment \\\"A person who is a nurse.\\\" ;\\n    rdfs:subClassOf :Person .\\n\\n:Doctor a owl:Class ;\\n    rdfs:label \\\"Doctor\\\" ;\\n    rdfs:comment \\\"A person who is a medical doctor.\\\" ;\\n    rdfs:subClassOf :Person ;\\n    owl:disjointWith :Nurse .\\n\\n:NursingAssistant a owl:Class ;\\n    rdfs:label \\\"Nursing Assistant\\\" ;\\n    rdfs:comment \\\"A nurse who is a nursing assistant.\\\" ;\\n    rdfs:subClassOf :Nurse .\\n\\n:CertifiedNurse a owl:Class ;\\n    rdfs:label \\\"Certified Nurse\\\" ;\\n    rdfs:comment \\\"A nurse who is certified.\\\" ;\\n    rdfs:subClassOf :Nurse .\\n\\n:Employee a owl:Class ;\\n    rdfs:label \\\"Employee\\\" ;\\n    rdfs:comment \\\"A person who is employed at a hospital.\\\" ;\\n    rdfs:subClassOf :Person .\\n\\n:Degree a owl:Class ;\\n    rdfs:label \\\"Degree\\\" ;\\n    rdfs:comment \\\"A formal qualification awarded to a person.\\\" .\\n\\n:Hospital a owl:Class ;\\n    rdfs:label \\\"Hospital\\\" ;\\n    rdfs:comment \\\"A medical institution.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where a hospital may be located.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country in which a city is located.\\\" .\\n\\n:Union a owl:Class ;\\n    rdfs:label \\\"Union\\\" ;\\n    rdfs:comment \\\"A union organizing hospital staff.\\\" .\\n\\n:UnionMembership a owl:Class ;\\n    rdfs:label \\\"Union Membership\\\" ;\\n    rdfs:comment \\\"A reified membership of a person in a union, possibly with a role and time period.\\\" .\\n\\n:UnionRole a owl:Class ;\\n    rdfs:label \\\"Union Role\\\" ;\\n    rdfs:comment \\\"A role a person can have within a union (e.g., representative).\\\" .\\n\\n:StudyPeriod a owl:Class ;\\n    rdfs:label \\\"Study Period\\\" ;\\n    rdfs:comment \\\"A period during which a person studies for a degree.\\\" .\\n\\n:Employment a owl:Class ;\\n    rdfs:label \\\"Employment\\\" ;\\n    rdfs:comment \\\"A reified employment relation between a person and a hospital, with start date.\\\" .\\n\\n:Evaluation a owl:Class ;\\n    rdfs:label \\\"Evaluation\\\" ;\\n    rdfs:comment \\\"A written evaluation statement provided by a doctor for an employee.\\\" .\\n\\n:Article a owl:Class ;\\n    rdfs:label \\\"Article\\\" ;\\n    rdfs:comment \\\"A research article.\\\" .\\n\\n:ArticleCollection a owl:Class ;\\n    rdfs:label \\\"Article Collection\\\" ;\\n    rdfs:comment \\\"A collection of research articles, as a book or CD.\\\" .\\n\\n:Book a owl:Class ;\\n    rdfs:label \\\"Book\\\" ;\\n    rdfs:comment \\\"A book version of an article collection.\\\" ;\\n    rdfs:subClassOf :ArticleCollection ;\\n    owl:disjointWith :CD .\\n\\n:CD a owl:Class ;\\n    rdfs:label \\\"CD\\\" ;\\n    rdfs:comment \\\"A CD version of an article collection.\\\" ;\\n    rdfs:subClassOf :ArticleCollection ;\\n    owl:disjointWith :Book .\\n\\n:Seminar a owl:Class ;\\n    rdfs:label \\\"Seminar\\\" ;\\n    rdfs:comment \\\"A seminar event held at a hospital to present articles.\\\" .\\n\\n:SeminarPresentation a owl:Class ;\\n    rdfs:label \\\"Seminar Presentation\\\" ;\\n    rdfs:comment \\\"A reified presentation of an article at a seminar.\\\" .\\n\\n#################################################################\\n# Object Properties (with inverses)\\n#################################################################\\n\\n:hasDegree a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Degree ;\\n    rdfs:label \\\"has degree\\\" ;\\n    rdfs:comment \\\"Links a person to a medical degree they hold.\\\" ;\\n    owl:inverseOf :degreeOf .\\n:degreeOf a owl:ObjectProperty ;\\n    rdfs:domain :Degree ;\\n    rdfs:range :Person ;\\n    rdfs:label \\\"degree of\\\" ;\\n    rdfs:comment \\\"Links a degree to the person who holds it.\\\" ;\\n    owl:inverseOf :hasDegree .\\n\\n:studiedFor a owl:ObjectProperty ;\\n    rdfs:domain :StudyPeriod ;\\n    rdfs:range :Degree ;\\n    rdfs:label \\\"studied for\\\" ;\\n    rdfs:comment \\\"Links a study period to the degree being studied.\\\" ;\\n    owl:inverseOf :studiedDuring .\\n:studiedDuring a owl:ObjectProperty ;\\n    rdfs:domain :Degree ;\\n    rdfs:range :StudyPeriod ;\\n    rdfs:label \\\"studied during\\\" ;\\n    rdfs:comment \\\"Links a degree to the study period.\\\" ;\\n    owl:inverseOf :studiedFor .\\n\\n:hasStudyPeriod a owl:ObjectProperty ;\\n    rdfs:domain :Person ;\\n    rdfs:range :StudyPeriod ;\\n    rdfs:label \\\"has study period\\\" ;\\n    rdfs:comment \\\"Links a person to their study periods.\\\" ;\\n    owl:inverseOf :studyPeriodOf .\\n:studyPeriodOf a owl:ObjectProperty ;\\n    rdfs:domain :StudyPeriod ;\\n    rdfs:range :Person ;\\n    rdfs:label \\\"study period of\\\" ;\\n    rdfs:comment \\\"Links a study period to the person.\\\" ;\\n    owl:inverseOf :hasStudyPeriod .\\n\\n:employedAt a owl:ObjectProperty ;\\n    rdfs:domain :Employment ;\\n    rdfs:range :Hospital ;\\n    rdfs:label \\\"employed at\\\" ;\\n    rdfs:comment \\\"Links an employment record to a hospital.\\\" ;\\n    owl:inverseOf :employmentOf .\\n:employmentOf a owl:ObjectProperty ;\\n    rdfs:domain :Hospital ;\\n    rdfs:range :Employment ;\\n    rdfs:label \\\"employment of\\\" ;\\n    rdfs:comment \\\"Links a hospital to an employment record.\\\" ;\\n    owl:inverseOf :employedAt .\\n\\n:hasEmployment a owl:ObjectProperty ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Employment ;\\n    rdfs:label \\\"has employment\\\" ;\\n    rdfs:comment \\\"Links a person to their employment records.\\\" ;\\n    owl:inverseOf :employmentOfPerson .\\n:employmentOfPerson a owl:ObjectProperty ;\\n    rdfs:domain :Employment ;\\n    rdfs:range :Person ;\\n    rdfs:label \\\"employment of person\\\" ;\\n    rdfs:comment \\\"Links an employment record to the person.\\\" ;\\n    owl:inverseOf :hasEmployment .\\n\\n:locatedIn a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Hospital ;\\n    rdfs:range :City ;\\n    rdfs:label \\\"located in\\\" ;\\n    rdfs:comment \\\"Links a hospital to the city where it is located.\\\" ;\\n    owl:inverseOf :hasHospital .\\n:hasHospital a owl:ObjectProperty ;\\n    rdfs:domain :City ;\\n    rdfs:range :Hospital ;\\n    rdfs:label \\\"has hospital\\\" ;\\n    rdfs:comment \\\"Links a city to a hospital located within it.\\\" ;\\n    owl:inverseOf :locatedIn .\\n\\n:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :City ;\\n    rdfs:range :Country ;\\n    rdfs:label \\\"in country\\\" ;\\n    rdfs:comment \\\"Links a city to the country where it is located.\\\" ;\\n    owl:inverseOf :hasCity .\\n:hasCity a owl:ObjectProperty ;\\n    rdfs:domain :Country ;\\n    rdfs:range :City ;\\n    rdfs:label \\\"has city\\\" ;\\n    rdfs:comment \\\"Links a country to its cities.\\\" ;\\n    owl:inverseOf :inCountry .\\n\\n:memberOf a owl:ObjectProperty ;\\n    rdfs:domain :UnionMembership ;\\n    rdfs:range :Union ;\\n    rdfs:label \\\"member of\\\" ;\\n    rdfs:comment \\\"Links a union membership to a union.\\\" ;\\n    owl:inverseOf :hasMember .\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:domain :Union ;\\n    rdfs:range :UnionMembership ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Links a union to a union membership.\\\" ;\\n    owl:inverseOf :memberOf .\\n\\n:hasUnionMembership a owl:ObjectProperty ;\\n    rdfs:domain :Person ;\\n    rdfs:range :UnionMembership ;\\n    rdfs:label \\\"has union membership\\\" ;\\n    rdfs:comment \\\"Links a person to their union memberships.\\\" ;\\n    owl:inverseOf :unionMembershipOf .\\n:unionMembershipOf a owl:ObjectProperty ;\\n    rdfs:domain :UnionMembership ;\\n    rdfs:range :Person ;\\n    rdfs:label \\\"union membership of\\\" ;\\n    rdfs:comment \\\"Links a union membership to the person.\\\" ;\\n    owl:inverseOf :hasUnionMembership .\\n\\n:hasUnionRole a owl:ObjectProperty ;\\n    rdfs:domain :UnionMembership ;\\n    rdfs:range :UnionRole ;\\n    rdfs:label \\\"has union role\\\" ;\\n    rdfs:comment \\\"Links a union membership to a role.\\\" ;\\n    owl:inverseOf :unionRoleOf .\\n:unionRoleOf a owl:ObjectProperty ;\\n    rdfs:domain :UnionRole ;\\n    rdfs:range :UnionMembership ;\\n    rdfs:label \\\"union role of\\\" ;\\n    rdfs:comment \\\"Links a union role to the union membership.\\\" ;\\n    owl:inverseOf :hasUnionRole .\\n\\n:evaluatedBy a owl:ObjectProperty ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range :Doctor ;\\n    rdfs:label \\\"evaluated by\\\" ;\\n    rdfs:comment \\\"Links an evaluation to the doctor who performed it.\\\" ;\\n    owl:inverseOf :evaluates .\\n:evaluates a owl:ObjectProperty ;\\n    rdfs:domain :Doctor ;\\n    rdfs:range :Evaluation ;\\n    rdfs:label \\\"evaluates\\\" ;\\n    rdfs:comment \\\"Links a doctor to the evaluations they have performed.\\\" ;\\n    owl:inverseOf :evaluatedBy .\\n\\n:evaluatedEmployee a owl:ObjectProperty ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range :Employee ;\\n    rdfs:label \\\"evaluated employee\\\" ;\\n    rdfs:comment \\\"Links an evaluation to the employee being evaluated.\\\" ;\\n    owl:inverseOf :evaluationOf .\\n:evaluationOf a owl:ObjectProperty ;\\n    rdfs:domain :Employee ;\\n    rdfs:range :Evaluation ;\\n    rdfs:label \\\"evaluation of\\\" ;\\n    rdfs:comment \\\"Links an employee to their evaluation.\\\" ;\\n    owl:inverseOf :evaluatedEmployee .\\n\\n:hasEvaluation a owl:ObjectProperty ;\\n    rdfs:domain :Employee ;\\n    rdfs:range :Evaluation ;\\n    rdfs:label \\\"has evaluation\\\" ;\\n    rdfs:comment \\\"Links an employee to their evaluations.\\\" ;\\n    owl:inverseOf :evaluationOfEmployee .\\n:evaluationOfEmployee a owl:ObjectProperty ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range :Employee ;\\n    rdfs:label \\\"evaluation of employee\\\" ;\\n    rdfs:comment \\\"Links an evaluation to the employee.\\\" ;\\n    owl:inverseOf :hasEvaluation .\\n\\n:composedOf a owl:ObjectProperty ;\\n    rdfs:domain :ArticleCollection ;\\n    rdfs:range :Article ;\\n    rdfs:label \\\"composed of\\\" ;\\n    rdfs:comment \\\"Links an article collection to the articles it contains.\\\" ;\\n    owl:inverseOf :partOfCollection .\\n:partOfCollection a owl:ObjectProperty ;\\n    rdfs:domain :Article ;\\n    rdfs:range :ArticleCollection ;\\n    rdfs:label \\\"part of collection\\\" ;\\n    rdfs:comment \\\"Links an article to the collection it is in.\\\" ;\\n    owl:inverseOf :composedOf .\\n\\n:presentedIn a owl:ObjectProperty ;\\n    rdfs:domain :SeminarPresentation ;\\n    rdfs:range :Seminar ;\\n    rdfs:label \\\"presented in\\\" ;\\n    rdfs:comment \\\"Links a seminar presentation to the seminar where it occurred.\\\" ;\\n    owl:inverseOf :hasPresentation .\\n:hasPresentation a owl:ObjectProperty ;\\n    rdfs:domain :Seminar ;\\n    rdfs:range :SeminarPresentation ;\\n    rdfs:label \\\"has presentation\\\" ;\\n    rdfs:comment \\\"Links a seminar to its presentations.\\\" ;\\n    owl:inverseOf :presentedIn .\\n\\n:presentsArticle a owl:ObjectProperty ;\\n    rdfs:domain :SeminarPresentation ;\\n    rdfs:range :Article ;\\n    rdfs:label \\\"presents article\\\" ;\\n    rdfs:comment \\\"Links a seminar presentation to the article presented.\\\" ;\\n    owl:inverseOf :presentedAt .\\n:presentedAt a owl:ObjectProperty ;\\n    rdfs:domain :Article ;\\n    rdfs:range :SeminarPresentation ;\\n    rdfs:label \\\"presented at\\\" ;\\n    rdfs:comment \\\"Links an article to a seminar presentation.\\\" ;\\n    owl:inverseOf :presentsArticle .\\n\\n:heldAt a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Seminar ;\\n    rdfs:range :Hospital ;\\n    rdfs:label \\\"held at\\\" ;\\n    rdfs:comment \\\"Links a seminar to the hospital where it is held.\\\" ;\\n    owl:inverseOf :hasSeminar .\\n:hasSeminar a owl:ObjectProperty ;\\n    rdfs:domain :Hospital ;\\n    rdfs:range :Seminar ;\\n    rdfs:label \\\"has seminar\\\" ;\\n    rdfs:comment \\\"Links a hospital to the seminars held there.\\\" ;\\n    owl:inverseOf :heldAt .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:startDate a owl:DatatypeProperty ;\\n    rdfs:domain [ owl:unionOf ( :StudyPeriod :Employment :UnionMembership :Seminar ) ] ;\\n    rdfs:range xsd:date ;\\n    rdfs:label \\\"start date\\\" ;\\n    rdfs:comment \\\"The start date of a period or event.\\\" .\\n\\n:endDate a owl:DatatypeProperty ;\\n    rdfs:domain [ owl:unionOf ( :StudyPeriod :Employment :UnionMembership ) ] ;\\n    rdfs:range xsd:date ;\\n    rdfs:label \\\"end date\\\" ;\\n    rdfs:comment \\\"The end date of a period or event.\\\" .\\n\\n:evaluationStatement a owl:DatatypeProperty ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"evaluation statement\\\" ;\\n    rdfs:comment \\\"The content of an evaluation statement.\\\" .\\n\\n:pageCount a owl:DatatypeProperty ;\\n    rdfs:domain :Book ;\\n    rdfs:range xsd:integer ;\\n    rdfs:label \\\"page count\\\" ;\\n    rdfs:comment \\\"The number of pages in a book.\\\" .\\n\\n:publicationDate a owl:DatatypeProperty ;\\n    rdfs:domain [ owl:unionOf ( :Book :CD ) ] ;\\n    rdfs:range xsd:date ;\\n    rdfs:label \\\"publication date\\\" ;\\n    rdfs:comment \\\"The publication date of a book or CD.\\\" .\\n\\n:title a owl:DatatypeProperty ;\\n    rdfs:domain [ owl:unionOf ( :Article :ArticleCollection :Book :CD :Seminar ) ] ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"title\\\" ;\\n    rdfs:comment \\\"The title of an article, article collection, book, CD, or seminar.\\\" .\\n\\n#################################################################\\n# General Class Axioms and Restrictions\\n#################################################################\\n\\n# At least one article must be presented at each seminar (CQ15)\\n:Seminar rdfs:subClassOf [ a owl:Restriction ;\\n    owl:onProperty :hasPresentation ;\\n    owl:someValuesFrom [ a owl:Restriction ; owl:onProperty :presentsArticle ; owl:someValuesFrom :Article ] ] .\\n\"}",
