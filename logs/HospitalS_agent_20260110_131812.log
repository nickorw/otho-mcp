      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/hospital-story-1> a owl:Ontology ;\n    rdfs:label \"Hospital Story Ontology\" ;\n    rdfs:comment \"An ontology modeling hospital staff, unions, evaluations, academic activities, and events based on a narrative scenario.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual, such as staff or authors.\" .\n\n:Nurse a owl:Class ;\n    rdfs:label \"Nurse\" ;\n    rdfs:comment \"A person who is a nurse.\" ;\n    rdfs:subClassOf :Person .\n\n:Doctor a owl:Class ;\n    rdfs:label \"Doctor\" ;\n    rdfs:comment \"A person who is a medical doctor.\" ;\n    rdfs:subClassOf :Person ;\n    owl:disjointWith :Nurse .\n\n:NursingAssistant a owl:Class ;\n    rdfs:label \"Nursing Assistant\" ;\n    rdfs:comment \"A nurse who is a nursing assistant.\" ;\n    rdfs:subClassOf :Nurse .\n\n:CertifiedNurse a owl:Class ;\n    rdfs:label \"Certified Nurse\" ;\n    rdfs:comment \"A nurse who is certified.\" ;\n    rdfs:subClassOf :Nurse .\n\n:Employee a owl:Class ;\n    rdfs:label \"Employee\" ;\n    rdfs:comment \"A person who is employed at a hospital.\" ;\n    rdfs:subClassOf :Person .\n\n:Degree a owl:Class ;\n    rdfs:label \"Degree\" ;\n    rdfs:comment \"A formal qualification awarded to a person.\" .\n\n:Hospital a owl:Class ;\n    rdfs:label \"Hospital\" ;\n    rdfs:comment \"A medical institution.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where a hospital may be located.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country in which a city is located.\" .\n\n:Union a owl:Class ;\n    rdfs:label \"Union\" ;\n    rdfs:comment \"A union organizing hospital staff.\" .\n\n:UnionMembership a owl:Class ;\n    rdfs:label \"Union Membership\" ;\n    rdfs:comment \"A reified membership of a person in a union, possibly with a role and time period.\" .\n\n:UnionRole a owl:Class ;\n    rdfs:label \"Union Role\" ;\n    rdfs:comment \"A role a person can have within a union (e.g., representative).\" .\n\n:StudyPeriod a owl:Class ;\n    rdfs:label \"Study Period\" ;\n    rdfs:comment \"A period during which a person studies for a degree.\" .\n\n:Employment a owl:Class ;\n    rdfs:label \"Employment\" ;\n    rdfs:comment \"A reified employment relation between a person and a hospital, with start date.\" .\n\n:Evaluation a owl:Class ;\n    rdfs:label \"Evaluation\" ;\n    rdfs:comment \"A written evaluation statement provided by a doctor for an employee.\" .\n\n:Article a owl:Class ;\n    rdfs:label \"Article\" ;\n    rdfs:comment \"A research article.\" .\n\n:ArticleCollection a owl:Class ;\n    rdfs:label \"Article Collection\" ;\n    rdfs:comment \"A collection of research articles, as a book or CD.\" .\n\n:Book a owl:Class ;\n    rdfs:label \"Book\" ;\n    rdfs:comment \"A book version of an article collection.\" ;\n    rdfs:subClassOf :ArticleCollection ;\n    owl:disjointWith :CD .\n\n:CD a owl:Class ;\n    rdfs:label \"CD\" ;\n    rdfs:comment \"A CD version of an article collection.\" ;\n    rdfs:subClassOf :ArticleCollection ;\n    owl:disjointWith :Book .\n\n:Seminar a owl:Class ;\n    rdfs:label \"Seminar\" ;\n    rdfs:comment \"A seminar event held at a hospital to present articles.\" .\n\n:SeminarPresentation a owl:Class ;\n    rdfs:label \"Seminar Presentation\" ;\n    rdfs:comment \"A reified presentation of an article at a seminar.\" .\n\n#################################################################\n# Object Properties (with inverses)\n#################################################################\n\n:hasDegree a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Person ;\n    rdfs:range :Degree ;\n    rdfs:label \"has degree\" ;\n    rdfs:comment \"Links a person to a medical degree they hold.\" ;\n    owl:inverseOf :degreeOf .\n:degreeOf a owl:ObjectProperty ;\n    rdfs:domain :Degree ;\n    rdfs:range :Person ;\n    rdfs:label \"degree of\" ;\n    rdfs:comment \"Links a degree to the person who holds it.\" ;\n    owl:inverseOf :hasDegree .\n\n:studiedFor a owl:ObjectProperty ;\n    rdfs:domain :StudyPeriod ;\n    rdfs:range :Degree ;\n    rdfs:label \"studied for\" ;\n    rdfs:comment \"Links a study period to the degree being studied.\" ;\n    owl:inverseOf :studiedDuring .\n:studiedDuring a owl:ObjectProperty ;\n    rdfs:domain :Degree ;\n    rdfs:range :StudyPeriod ;\n    rdfs:label \"studied during\" ;\n    rdfs:comment \"Links a degree to the study period.\" ;\n    owl:inverseOf :studiedFor .\n\n:hasStudyPeriod a owl:ObjectProperty ;\n    rdfs:domain :Person ;\n    rdfs:range :StudyPeriod ;\n    rdfs:label \"has study period\" ;\n    rdfs:comment \"Links a person to their study periods.\" ;\n    owl:inverseOf :studyPeriodOf .\n:studyPeriodOf a owl:ObjectProperty ;\n    rdfs:domain :StudyPeriod ;\n    rdfs:range :Person ;\n    rdfs:label \"study period of\" ;\n    rdfs:comment \"Links a study period to the person.\" ;\n    owl:inverseOf :hasStudyPeriod .\n\n:employedAt a owl:ObjectProperty ;\n    rdfs:domain :Employment ;\n    rdfs:range :Hospital ;\n    rdfs:label \"employed at\" ;\n    rdfs:comment \"Links an employment record to a hospital.\" ;\n    owl:inverseOf :employmentOf .\n:employmentOf a owl:ObjectProperty ;\n    rdfs:domain :Hospital ;\n    rdfs:range :Employment ;\n    rdfs:label \"employment of\" ;\n    rdfs:comment \"Links a hospital to an employment record.\" ;\n    owl:inverseOf :employedAt .\n\n:hasEmployment a owl:ObjectProperty ;\n    rdfs:domain :Person ;\n    rdfs:range :Employment ;\n    rdfs:label \"has employment\" ;\n    rdfs:comment \"Links a person to their employment records.\" ;\n    owl:inverseOf :employmentOfPerson .\n:employmentOfPerson a owl:ObjectProperty ;\n    rdfs:domain :Employment ;\n    rdfs:range :Person ;\n    rdfs:label \"employment of person\" ;\n    rdfs:comment \"Links an employment record to the person.\" ;\n    owl:inverseOf :hasEmployment .\n\n:locatedIn a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Hospital ;\n    rdfs:range :City ;\n    rdfs:label \"located in\" ;\n    rdfs:comment \"Links a hospital to the city where it is located.\" ;\n    owl:inverseOf :hasHospital .\n:hasHospital a owl:ObjectProperty ;\n    rdfs:domain :City ;\n    rdfs:range :Hospital ;\n    rdfs:label \"has hospital\" ;\n    rdfs:comment \"Links a city to a hospital located within it.\" ;\n    owl:inverseOf :locatedIn .\n\n:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :City ;\n    rdfs:range :Country ;\n    rdfs:label \"in country\" ;\n    rdfs:comment \"Links a city to the country where it is located.\" ;\n    owl:inverseOf :hasCity .\n:hasCity a owl:ObjectProperty ;\n    rdfs:domain :Country ;\n    rdfs:range :City ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"Links a country to its cities.\" ;\n    owl:inverseOf :inCountry .\n\n:memberOf a owl:ObjectProperty ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :Union ;\n    rdfs:label \"member of\" ;\n    rdfs:comment \"Links a union membership to a union.\" ;\n    owl:inverseOf :hasMember .\n:hasMember a owl:ObjectProperty ;\n    rdfs:domain :Union ;\n    rdfs:range :UnionMembership ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Links a union to a union membership.\" ;\n    owl:inverseOf :memberOf .\n\n:hasUnionMembership a owl:ObjectProperty ;\n    rdfs:domain :Person ;\n    rdfs:range :UnionMembership ;\n    rdfs:label \"has union membership\" ;\n    rdfs:comment \"Links a person to their union memberships.\" ;\n 