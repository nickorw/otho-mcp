      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/hospital-story-1> a owl:Ontology ;\n    rdfs:label \"Hospital Story Ontology\" ;\n    rdfs:comment \"An ontology modeling hospital staff, unions, evaluations, academic activities, and events based on a narrative scenario.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual, such as staff or authors.\" .\n\n:Nurse a owl:Class ;\n    rdfs:label \"Nurse\" ;\n    rdfs:comment \"A person who is a nurse.\" ;\n    rdfs:subClassOf :Person .\n\n:Doctor a owl:Class ;\n    rdfs:label \"Doctor\" ;\n    rdfs:comment \"A person who is a medical doctor.\" ;\n    rdfs:subClassOf :Person ;\n    owl:disjointWith :Nurse .\n\n:NursingAssistant a owl:Class ;\n    rdfs:label \"Nursing Assistant\" ;\n    rdfs:comment \"A nurse who is a nursing assistant.\" ;\n    rdfs:subClassOf :Nurse .\n\n:CertifiedNurse a owl:Class ;\n    rdfs:label \"Certified Nurse\" ;\n    rdfs:comment \"A nurse who is certified.\" ;\n    rdfs:subClassOf :Nurse .\n\n:Employee a owl:Class ;\n    rdfs:label \"Employee\" ;\n    rdfs:comment \"A person who is employed at a hospital.\" ;\n    rdfs:subClassOf :Person .\n\n:Degree a owl:Class ;\n    rdfs:label \"Degree\" ;\n    rdfs:comment \"A formal qualification awarded to a person.\" .\n\n:Hospital a owl:Class ;\n    rdfs:label \"Hospital\" ;\n    rdfs:comment \"A medical institution.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where a hospital may be located.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    r