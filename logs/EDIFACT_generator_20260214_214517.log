      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, organizations, roles, items, and validation as described in the procurement and global trade scenario.\" .\n\n# Core EDIFACT Structure\n:EDIFACTInterchange a owl:Class ;\n    rdfs:label \"EDIFACT Interchange\" ;\n    rdfs:comment \"The top-level envelope containing messages in an EDIFACT transmission.\" .\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A specific message within an EDIFACT interchange, e.g., an invoice.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :EDIFACTMessage ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An invoice message (e.g., INVOIC) in the EDIFACT standard.\" .\n\n:EDIFACTSegment a owl:Class ;\n    rdfs:label \"EDIFACT Segment\" ;\n    rdfs:comment \"A segment in an EDIFACT message, such as BGM or NAD.\" .\n\n:EDIFACTHeaderSection a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"EDIFACT Header Section\" ;\n    rdfs:comment \"The header section of an EDIFACT message, containing document metadata.\" .\n\n:EDIFACTDetailSection a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"EDIFACT Detail Section\" ;\n    rdfs:comment \"The detail section of an EDIFACT message, containing line items.\" .\n\n:EDIFACTSummarySection a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"EDIFACT Summary Section\" ;\n    rdfs:comment \"The summary section of an EDIFACT message, containing totals and closing information.\" .\n\n:EDIFACTCompositeElement a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"EDIFACT Composite Element\" ;\n    rdfs:comment \"A composite element within an EDIFACT segment, grouping simple elements.\" .\n\n:EDIFACTSimpleElement a owl:Class ;\n    rdfs:subClassOf :EDIFACTCompositeElement ;\n    rdfs:label \"EDIFACT Simple Element\" ;\n    rdfs:comment \"A simple data element within a composite element of an EDIFACT segment.\" .\n\n:EDIFACTDelimiter a owl:Class ;\n    rdfs:label \"EDIFACT Delimiter\" ;\n    rdfs:comment \"A delimiter (such as + or :) used in EDIFACT messages to separate elements.\" .\n\n# Organization, Roles, and Addresses\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An entity participating in a transaction, e.g., Buyer, Seller, Delivery Party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role that an organization can play in a transaction (e.g., Buyer, Seller, Delivery Party).\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A reified relation linking an organization to a specific role within a message context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier for an organization, such as a GLN.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A specific type of identifier used for global location referencing.\" .\n\n# Invoice Lines, Items, and Pricing\n:InvoiceLine a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"Invoice Line\" ;\n    rdfs:comment \"A line item in an invoice, describing a purchased item, quantity, and price.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or good referenced in an invoice line.\" .\n\n:Price a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an invoice line or total.\" .\n\n:Tax a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax entry associated with an invoice or invoice line.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for identifying documents or transactions.\" .\n\n# Business Process, Validation, Standards\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice or message is assigned.\" .\n\n:Standard a owl:Class ;\n    rdfs:label \"Standard\" ;\n    rdfs:comment \"A standard (e.g., EN 16931-1) to which a document conforms.\" .\n\n:ValidationRule a owl:Class ;\n    rdfs:label \"Validation Rule\" ;\n    rdfs:comment \"A rule used to validate the structure or content of an invoice.\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"A SHACL constraint used for automated validation.\" .\n\n# Object Properties\n:hasMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :EDIFACTInterchange ;\n    rdfs:range :EDIFACTMessage ;\n    rdfs:label \"has message\" ;\n    rdfs:comment \"Associates an Interchange with its contained Message.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTSegment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTSegment ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links a message to its header, detail, and summary sections.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :EDIFACTCompositeElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTCompositeElement ;\n    rdfs:range :EDIFACTSimpleElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite element to its simple data elements.\" .\n\n:hasDelimiter a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :EDIFACTDelimiter ;\n    rdfs:label \"has delimiter\" ;\n    rdfs:comment \"Links a segment to its delimiters.\" .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to role assignments for organizations.\" .\n\n:hasAgentRole a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a role assignment to an agent role (e.g., Buyer, Seller).\" .\n\n:hasOrganization a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"has organization\" ;\n    rdfs:comment \"Links a role assignment to an organization.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifiers.\" .\n\n:hasGLN a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :GlobalLocationNumber ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Links an identifier to a Global Location Number.\" .\n\n:hasInvoiceLine a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceLine ;\n    rdfs:label \"has invoice line\" ;\n    rdfs:comment \"Links an invoice message to its invoice lines.\" .\n\n:hasItem a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Item ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links an invoice line to its item.\" .\n\n:hasNetPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links an invoice line to its net price.\" .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Specifies the quantity for an invoice line.\" .\n\n:hasReferenceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ReferenceNumber ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Links an invoice to its reference number.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links an invoice to its tax details.\" .\n\n:hasInvoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Specifies the total amount of the invoice.\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Specifies the invoice number.\" .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice to its associated business process.\" .\n\n:conformsToStandard a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Standard ;\n    rdfs:label \"conforms to standard\" ;\n    rdfs:comment \"Indicates the standard to which the invoice conforms.\" .\n\n:validatedBy a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationRule ;\n    rdfs:label \"validated by\" ;\n    rdfs:comment \"Indicates the validation rules applied to the invoice.\" .\n\n:hasSHACLConstraint a owl:ObjectProperty ;\n    rdfs:domain :ValidationRule ;\n    rdfs:range :SHACLConstraint ;\n    rdfs:label \"has SHACL constraint\" ;\n    rdfs:comment \"Links a validation rule to a SHACL constraint.\" .\n\n# Data Properties\n:addressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line of an address.\" .\n\n:city a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city of the address.\" .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" .\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of the identifier.\" .\n\n:itemName a owl:DatatypeProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item name\" ;\n    rdfs:comment \"The name of the item.\" .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"A description of the item.\" .\n\n:priceAmount a owl:DatatypeProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"price amount\" ;\n    rdfs:comment \"The amount of the price.\" .\n\n:taxAmount a owl:DatatypeProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"The amount of tax.\" .\n\n:taxRate a owl:DatatypeProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"tax rate\" ;\n    rdfs:comment \"The rate of tax.\" .\n\n:referenceNumberValue a owl:DatatypeProperty ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range xsd:string ;\n    rdfs:label \"reference number value\" ;\n    rdfs:comment \"The value of the reference number.\" .\n\n# Disjointness and Unions\n:Organization owl:disjointWith :Item, :Address, :RoleAssignment, :AgentRole .\n:Address owl:disjointWith :Item .\n:EDIFACTSegment owl:disjointWith :EDIFACTDelimiter .\n:EDIFACTHeaderSection owl:disjointWith :EDIFACTDetailSection, :EDIFACTSummarySection .\n:EDIFACTDetailSection owl:disjointWith :EDIFACTSummarySection .\n:RoleAssignment owl:disjointWith :AgentRole .\n:EDIFACTSegment owl:disjointUnionOf (:EDIFACTHeaderSection :EDIFACTDetailSection :EDIFACTSummarySection :EDIFACTCompositeElement) .\n\n# Example Complex Axioms and Restrictions\n:BuyerRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role representing a buyer in a transaction.\" .\n\n:RoleAssignmentWithBuyer a owl:Class ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:allValuesFrom :BuyerRole ] ;\n    rdfs:subClassOf :RoleAssignment ;\n    rdfs:label \"Role Assignment With Buyer\" ;\n    rdfs:comment \"A role assignment where the agent role is Buyer.\" .\n\n:InvoiceWithStandard a owl:Class ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :conformsToStandard ; owl:someValuesFrom :Standard ] ;\n    rdfs:subClassOf :InvoiceMessage ;\n    rdfs:label \"Invoice With Standard\" ;\n    rdfs:comment \"An invoice message that conforms to at least one standard.\" .\n\n# EDIFACT-specific annotations\n:INVOIC a owl:Class ;\n    rdfs:subClassOf :InvoiceMessage ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"An invoice message type as defined by EDIFACT.\" .\n"
}
