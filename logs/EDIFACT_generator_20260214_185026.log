nment a owl:Class ;\n    rdfs:label \"Invoice Item Assignment\" ;\n    rdfs:comment \"Reifies the assignment of an item to an invoice, including net price.\" .\n\n:hasInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Invoice ;\n    rdfs:label \"has invoice\" ;\n    rdfs:comment \"Relates an EDIFACT message to an invoice it contains.\" ;\n    owl:inverseOf :isInvoiceOf .\n\n:isInvoiceOf a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :EDIFACTMessage ;\n    rdfs:label \"is invoice of\" ;\n    rdfs:comment \"Inverse property of hasInvoice.\" ;\n    owl:inverseOf :hasInvoice .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Indicates an organization involved in an invoice.\" ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Inverse property of involvesOrganization.\" ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Role ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Relates an organization to a role it plays.\" ;\n    owl:inverseOf :isRoleOf .\n\n:isRoleOf a owl:ObjectProperty ;\n    rdfs:domain :Role ;\n    rdfs:range :Organization ;\n    rdfs:label \"is role of\" ;\n    rdfs:comment \"Inverse property of hasRole.\" ;\n    owl:inverseOf :hasRole .\n\n:playsRoleInInvoice a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    rdfs:label \"plays role in invoice\" ;\n    rdfs:comment \"Relates an organization to an invoice where it plays a role.\" ;\n    owl:inverseOf :hasRolePlayer .\n\n:hasRolePlayer a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdfs:label \"has role player\" ;\n    rdfs:comment \"Inverse property of playsRoleInInvoice.\" ;\n    owl:inverseOf :playsRoleInInvoice .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse property of hasAddress.\" ;\n    owl:inverseOf :hasAddress .\n\n:hasItemAssignment a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceItemAssignment ;\n    rdfs:label \"has item assignment\" ;\n    rdfs:comment \"Relates an invoice to an item assignment (reification).\" ;\n    owl:inverseOf :isItemAssignmentOf .\n\n:isItemAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceItemAssignment ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is item assignment of\" ;\n    rdfs:comment \"Inverse property of hasItemAssignment.\" ;\n    owl:inverseOf :hasItemAssignment .\n\n:assignedItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceItemAssignment ;\n    rdfs:range :Item ;\n    rdfs:label \"assigned item\" ;\n    rdfs:comment \"Relates an item assignment to the assigned item.\" ;\n    owl:inverseOf :isAssignedTo .\n\n:isAssignedTo a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :InvoiceItemAssignment ;\n    rdfs:label \"is assigned to\" ;\n    rdfs:comment \"Inverse property of assignedItem.\" ;\n    owl:inverseOf :assignedItem .\n\n:netPrice a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceItemAssignment ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"The net price of an item in an invoice.\" .\n\n:hasInvoiceDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"has invoice detail\" ;\n    rdfs:comment \"Relates an invoice to its details.\" ;\n    owl:inverseOf :isInvoiceDetailOf .\n\n:isInvoiceDetailOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is invoice detail of\" ;\n    rdfs:comment \"Inverse property of hasInvoiceDetail.\" ;\n    owl:inverseOf :hasInvoiceDetail .\n\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" .\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The invoice number.\" .\n\n:partOfBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"part of business process\" ;\n    rdfs:comment \"Assigns an invoice to a business process.\" ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Inverse property of partOfBusinessProcess.\" ;\n    owl:inverseOf :partOfBusinessProcess .\n\n:buyer a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdfs:label \"buyer\" ;\n    rdfs:comment \"The buyer organization in the invoice.\" ;\n    owl:inverseOf :isBuyerOf .\n\n:isBuyerOf a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is buyer of\" ;\n    rdfs:comment \"Inverse property of buyer.\" ;\n    owl:inverseOf :buyer .\n\n:seller a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdfs:label \"seller\" ;\n    rdfs:comment \"The seller organization in the invoice.\" ;\n    owl:inverseOf :isSellerOf .\n\n:isSellerOf a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is seller of\" ;\n    rdfs:comment \"Inverse property of seller.\" ;\n    owl:inverseOf :seller .\n\n:organizationName a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"The name of the organization.\" .\n\n:addressLine a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The address line of the address.\" .\n\n:itemDescription a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"A description of the item sold.\" .\n"
