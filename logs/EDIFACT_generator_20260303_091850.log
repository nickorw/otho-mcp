2026-03-03 09:27:39 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#edifact-invoic-ontology> a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A INVOIC Ontology\" ;\n    rdfs:comment \"A deep, structured ontology for UN/EDIFACT D96A INVOIC messages, covering all mandatory segments, roles, and validation mechanisms per EN 16931 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope in an EDIFACT transmission, containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message instance within an interchange.\" .\n\n:INVOICMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message containing invoice data for global trade.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A generic EDIFACT segment, the building block of messages.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NADSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment, specifying parties involved and their roles.\" .\n\n:DTMSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment, e.g., invoice date, delivery date, tax point date.\" .\n\n:MOASegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment, e.g., invoice amount, line amount.\" .\n\n:TAXSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax segment, specifying tax type, rate, and amount.\" .\n\n:CUXSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"CUX Segment\" ;\n    rdfs:comment \"Currency segment, specifying currency for the invoice.\" .\n\n:RFFSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment, specifying reference numbers and qualifiers.\" .\n\n:UNSSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"UNS Segment\" ;\n    rdfs:comment \"Section control segment, marking section boundaries in the message.\" .\n\n:LINSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line Item segment, specifying line item numbers and identifiers.\" .\n\n:QTYSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment, specifying quantities for line items.\" .\n\n:PRISegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PRI Segment\" ;\n    rdfs:comment \"Price segment, specifying unit prices for line items.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment, grouping related simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A single, atomic data element within a composite or segment.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"The business document representing a commercial invoice.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A legal entity involved in the invoice process.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"The role played by an organization in a transaction, e.g., Buyer, Supplier, Delivery Party.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A single line in the invoice, representing an item sold.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service described in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"The net price of an item on the invoice.\" .\n\n:TaxTotal a owl:Class ;\n    rdfs:label \"Tax Total\" ;\n    rdfs:comment \"The total tax amount for the invoice.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"The total amount due on the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice may be assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier for organizations, addresses, or documents.\" .\n\n:GLNIdentifier a owl:Class ;\n    rdfs:subClassOf :Identifier ;\n    rdfs:label \"GLN Identifier\" ;\n    rdfs:comment \"A Global Location Number used to identify parties in the supply chain.\" .\n\n:EN16931Compliance a owl:Class ;\n    rdfs:label \"EN 16931 Compliance\" ;\n    rdfs:comment \"Compliance with the European Standard EN 16931 for electronic invoicing.\" .\n\n:P2POAlignment a owl:Class ;\n    rdfs:label \"Purchase-to-Pay Ontology Alignment\" ;\n    rdfs:comment \"Alignment with the Purchase-to-Pay Ontology (P2P-O).\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"A SHACL constraint used for validating invoice data.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A pivot class for reifying the assignment of an agent role to an organization within an invoice context.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an interchange envelope to a message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage: Relates a message to the envelope containing it.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a message to its constituent segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment: Relates a segment to its parent message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement: Relates a composite data element to its parent segment.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement: Relates a simple data element to its parent composite data element.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :hasSimpleElement .\n\n:representsInvoice a owl:ObjectProperty ;\n    rdfs:label \"represents invoice\" ;\n    rdfs:comment \"Relates an INVOIC message to the invoice it represents.\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :isRepresentedByMessage .\n\n:isRepresentedByMessage a owl:ObjectProperty ;\n    rdfs:label \"is represented by message\" ;\n    rdfs:comment \"Inverse of representsInvoice: Relates an invoice to the message that represents it.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :INVOICMessage ;\n    owl:inverseOf :representsInvoice .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Relates an invoice to organizations involved in it.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Inverse of involvesOrganization: Relates an organization to the invoice it is involved in.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Relates an invoice to an organization role assignment.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :isRoleAssignmentOfInvoice .\n\n:isRoleAssignmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is role assignment of invoice\" ;\n    rdfs:comment \"Inverse of hasRoleAssignment: Relates an organization role assignment to its invoice.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasAgentRole a owl:ObjectProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Relates an organization role assignment to an agent role.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isAgentRoleOfAssignment .\n\n:isAgentRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:label \"is agent role of assignment\" ;\n    rdfs:comment \"Inverse of hasAgentRole: Relates an agent role to its organization role assignment.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :hasAgentRole .\n\n:hasOrganization a owl:ObjectProperty ;\n    rdfs:label \"has organization\" ;\n    rdfs:comment \"Relates an organization role assignment to an organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isOrganizationOfAssignment .\n\n:isOrganizationOfAssignment a owl:ObjectProperty ;\n    rdfs:label \"is organization of assignment\" ;\n    rdfs:comment \"Inverse of hasOrganization: Relates an organization to its organization role assignment.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :hasOrganization .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to an address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOfOrganization .\n\n:isAddressOfOrganization a owl:ObjectProperty ;\n    rdfs:label \"is address of organization\" ;\n    rdfs:comment \"Inverse of hasAddress: Relates an address to its organization.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Relates an organization to its identifier(s).\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    owl:inverseOf :isIdentifierOfOrganization .\n\n:isIdentifierOfOrganization a owl:ObjectProperty ;\n    rdfs:label \"is identifier of organization\" ;\n    rdfs:comment \"Inverse of hasIdentifier: Relates an identifier to its organization.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasIdentifier .\n\n:hasBuyer a owl:ObjectProperty ;\n    rdfs:label \"has buyer\" ;\n    rdfs:comment \"Relates an invoice to the buyer organization.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isBuyerOfInvoice .\n\n:isBuyerOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is buyer of invoice\" ;\n    rdfs:comment \"Inverse of hasBuyer: Relates a buyer organization to its invoice.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasBuyer .\n\n:hasDeliveryParty a owl:ObjectProperty ;\n    rdfs:label \"has delivery party\" ;\n    rdfs:comment \"Relates an invoice to the delivery party organization.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isDeliveryPartyOfInvoice .\n\n:isDeliveryPartyOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is delivery party of invoice\" ;\n    rdfs:comment \"Inverse of hasDeliveryParty: Relates a delivery party organization to its invoice.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasDeliveryParty .\n\n:listsLineItem a owl:ObjectProperty ;\n    rdfs:label \"lists line item\" ;\n    rdfs:comment \"Relates an invoice to its line items.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isLineItemOfInvoice .\n\n:isLineItemOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is line item of invoice\" ;\n    rdfs:comment \"Inverse of listsLineItem: Relates a line item to its invoice.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :listsLineItem .\n\n:lineItemOf a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n    rdfs:label \"line item of\" ;\n    rdfs:comment \"Inverse: Relates a line item to the invoice it belongs to.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :listsLineItem .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Relates a line item to the item it describes.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem a owl:ObjectProperty ;\n    rdfs:label \"is described by line item\" ;\n    rdfs:comment \"Inverse of describesItem: Relates an item to its describing line item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :describesItem .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates a line item to its net price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isNetPriceOfLineItem .\n\n:isNetPriceOfLineItem a owl:ObjectProperty ;\n    rdfs:label \"is net price of line item\" ;\n    rdfs:comment \"Inverse of hasNetPrice: Relates a price to its line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasNetPrice .\n\n:hasQuantity a owl:ObjectProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Relates a line item to its quantity.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    owl:inverseOf :isQuantityOfLineItem .\n\n:isQuantityOfLineItem a owl:ObjectProperty ;\n    rdfs:label \"is quantity of line item\" ;\n    rdfs:comment \"Inverse of hasQuantity: Relates a quantity to its line item.\" ;\n    rdfs:domain xsd:decimal ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasQuantity .\n\n:hasTaxTotal a owl:ObjectProperty ;\n    rdfs:label \"has tax total\" ;\n    rdfs:comment \"Relates an invoice to its total tax amount.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :TaxTotal ;\n    owl:inverseOf :isTaxTotalOfInvoice .\n\n:isTaxTotalOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is tax total of invoice\" ;\n    rdfs:comment \"Inverse of hasTaxTotal: Relates a tax total to its invoice.\" ;\n    rdfs:domain :TaxTotal ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasTaxTotal .\n\n:hasInvoiceAmount a owl:ObjectProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Relates an invoice to its total amount.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceAmount ;\n    owl:inverseOf :isInvoiceAmountOfInvoice .\n\n:isInvoiceAmountOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is invoice amount of invoice\" ;\n    rdfs:comment \"Inverse of hasInvoiceAmount: Relates an invoice amount to its invoice.\" ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasInvoiceAmount .\n\n:assignedToBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"assigned to business process\" ;\n    rdfs:comment \"Relates an invoice to a business process.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isBusinessProcessOfInvoice .\n\n:isBusinessProcessOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is business process of invoice\" ;\n    rdfs:comment \"Inverse of assignedToBusinessProcess: Relates a business process to its invoice.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :assignedToBusinessProcess .\n\n:alignedToStandard a owl:ObjectProperty ;\n    rdfs:label \"aligned to standard\" ;\n    rdfs:comment \"Relates an invoice to its EN 16931 compliance declaration.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :EN16931Compliance ;\n    owl:inverseOf :isStandardAlignmentOfInvoice .\n\n:isStandardAlignmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is standard alignment of invoice\" ;\n    rdfs:comment \"Inverse of alignedToStandard: Relates an EN16931Compliance to its invoice.\" ;\n    rdfs:domain :EN16931Compliance ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :alignedToStandard .\n\n:alignedToP2PO a owl:ObjectProperty ;\n    rdfs:label \"aligned to P2P-O\" ;\n    rdfs:comment \"Relates an invoice to its P2P-O alignment declaration.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :P2POAlignment ;\n    owl:inverseOf :isP2POAlignmentOfInvoice .\n\n:isP2POAlignmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is P2P-O alignment of invoice\" ;\n    rdfs:comment \"Inverse of alignedToP2PO: Relates a P2POAlignment to its invoice.\" ;\n    rdfs:domain :P2POAlignment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :alignedToP2PO .\n\n:validatedBy a owl:ObjectProperty ;\n    rdfs:label \"validated by\" ;\n    rdfs:comment \"Relates an invoice to a SHACL constraint for validation.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :SHACLConstraint ;\n    owl:inverseOf :validatesInvoice .\n\n:validatesInvoice a owl:ObjectProperty ;\n    rdfs:label \"validates invoice\" ;\n    rdfs:comment \"Inverse of validatedBy: Relates a SHACL constraint to the invoice it validates.\" ;\n    rdfs:domain :SHACLConstraint ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :validatedBy .\n\n# Segment-level linking properties\n:hasDateSegment a owl:ObjectProperty ;\n    rdfs:label \"has date segment\" ;\n    rdfs:comment \"Links an invoice to its DTM segments (dates).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :DTMSegment ;\n    owl:inverseOf :isDateSegmentOfInvoice .\n\n:isDateSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is date segment of invoice\" ;\n    rdfs:comment \"Inverse of hasDateSegment: Relates a DTM segment to its invoice.\" ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasDateSegment .\n\n:hasMonetaryAmountSegment a owl:ObjectProperty ;\n    rdfs:label \"has monetary amount segment\" ;\n    rdfs:comment \"Links an invoice to its MOA segments (monetary amounts).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :MOASegment ;\n    owl:inverseOf :isMonetaryAmountSegmentOfInvoice .\n\n:isMonetaryAmountSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is monetary amount segment of invoice\" ;\n    rdfs:comment \"Inverse of hasMonetaryAmountSegment: Relates a MOA segment to its invoice.\" ;\n    rdfs:domain :MOASegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasMonetaryAmountSegment .\n\n:hasTaxSegment a owl:ObjectProperty ;\n    rdfs:label \"has tax segment\" ;\n    rdfs:comment \"Links an invoice to its TAX segments (taxes).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :TAXSegment ;\n    owl:inverseOf :isTaxSegmentOfInvoice .\n\n:isTaxSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is tax segment of invoice\" ;\n    rdfs:comment \"Inverse of hasTaxSegment: Relates a TAX segment to its invoice.\" ;\n    rdfs:domain :TAXSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasTaxSegment .\n\n:hasCurrencySegment a owl:ObjectProperty ;\n    rdfs:label \"has currency segment\" ;\n    rdfs:comment \"Links an invoice to its CUX segments (currencies).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :CUXSegment ;\n    owl:inverseOf :isCurrencySegmentOfInvoice .\n\n:isCurrencySegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is currency segment of invoice\" ;\n    rdfs:comment \"Inverse of hasCurrencySegment: Relates a CUX segment to its invoice.\" ;\n    rdfs:domain :CUXSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasCurrencySegment .\n\n:hasReferenceSegment a owl:ObjectProperty ;\n    rdfs:label \"has reference segment\" ;\n    rdfs:comment \"Links an invoice to its RFF segments (references).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :RFFSegment ;\n    owl:inverseOf :isReferenceSegmentOfInvoice .\n\n:isReferenceSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is reference segment of invoice\" ;\n    rdfs:comment \"Inverse of hasReferenceSegment: Relates a RFF segment to its invoice.\" ;\n    rdfs:domain :RFFSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasReferenceSegment .\n\n:hasControlSegment a owl:ObjectProperty ;\n    rdfs:label \"has control segment\" ;\n    rdfs:comment \"Links an invoice to its UNS segments (section control).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :UNSSegment ;\n    owl:inverseOf :isControlSegmentOfInvoice .\n\n:isControlSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is control segment of invoice\" ;\n    rdfs:comment \"Inverse of hasControlSegment: Relates a UNS segment to its invoice.\" ;\n    rdfs:domain :UNSSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasControlSegment .\n\n:hasLineSegment a owl:ObjectProperty ;\n    rdfs:label \"has line segment\" ;\n    rdfs:comment \"Links an invoice to its LIN segments (line items).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :LINSegment ;\n    owl:inverseOf :isLineSegmentOfInvoice .\n\n:isLineSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is line segment of invoice\" ;\n    rdfs:comment \"Inverse of hasLineSegment: Relates a LIN segment to its invoice.\" ;\n    rdfs:domain :LINSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasLineSegment .\n\n:hasQuantitySegment a owl:ObjectProperty ;\n    rdfs:label \"has quantity segment\" ;\n    rdfs:comment \"Links an invoice to its QTY segments (quantities).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :QTYSegment ;\n    owl:inverseOf :isQuantitySegmentOfInvoice .\n\n:isQuantitySegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is quantity segment of invoice\" ;\n    rdfs:comment \"Inverse of hasQuantitySegment: Relates a QTY segment to its invoice.\" ;\n    rdfs:domain :QTYSegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasQuantitySegment .\n\n:hasPriceSegment a owl:ObjectProperty ;\n    rdfs:label \"has price segment\" ;\n    rdfs:comment \"Links an invoice to its PRI segments (prices).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :PRISegment ;\n    owl:inverseOf :isPriceSegmentOfInvoice .\n\n:isPriceSegmentOfInvoice a owl:ObjectProperty ;\n    rdfs:label \"is price segment of invoice\" ;\n    rdfs:comment \"Inverse of hasPriceSegment: Relates a PRI segment to its invoice.\" ;\n    rdfs:domain :PRISegment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasPriceSegment .\n\n#################################################################\n# Data Properties (UNCHANGED)\n#################################################################\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string .\n\n:hasDate a owl:DatatypeProperty ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"The date of the invoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Reference number for the invoice or message.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The street address or PO Box.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code for the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code for the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of an identifier (e.g., GLN, VAT).\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string .\n\n:itemName a owl:DatatypeProperty ;\n    rdfs:label \"item name\" ;\n    rdfs:comment \"The name of an item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"The description of an item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:priceValue a owl:DatatypeProperty ;\n    rdfs:label \"price value\" ;\n    rdfs:comment \"The value of a price.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:taxValue a owl:DatatypeProperty ;\n    rdfs:label \"tax value\" ;\n    rdfs:comment \"The value of the total tax.\" ;\n    rdfs:domain :TaxTotal ;\n    rdfs:range xsd:decimal .\n\n:invoiceAmountValue a owl:DatatypeProperty ;\n    rdfs:label \"invoice amount value\" ;\n    rdfs:comment \"The value of the total invoice amount.\" ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range xsd:decimal .\n\n:dtmQualifier a owl:DatatypeProperty ;\n    rdfs:label \"DTM qualifier\" ;\n    rdfs:comment \"Qualifier for the DTM segment (e.g., 137=Invoice date).\" ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range xsd:string .\n\n:dtmValue a owl:DatatypeProperty ;\n    rdfs:label \"DTM value\" ;\n    rdfs:comment \"The value for the date/time/period.\" ;\n    rdfs:domain :DTMSegment ;\n    rdfs:range xsd:string .\n\n:moaQualifier a owl:DatatypeProperty ;\n    rdfs:label \"MOA qualifier\" ;\n    rdfs:comment \"Qualifier for the MOA segment (e.g., 79=Invoice amount).\" ;\n    rdfs:domain :MOASegment ;\n    rdfs:range xsd:string .\n\n:moaValue a owl:DatatypeProperty ;\n    rdfs:label \"MOA value\" ;\n    rdfs:comment \"Monetary amount value in MOA segment.\" ;\n    rdfs:domain :MOASegment ;\n    rdfs:range xsd:decimal .\n\n:taxQualifier a owl:DatatypeProperty ;\n    rdfs:label \"TAX qualifier\" ;\n    rdfs:comment \"Qualifier for the TAX segment.\" ;\n    rdfs:domain :TAXSegment ;\n    rdfs:range xsd:string .\n\n:taxType a owl:DatatypeProperty ;\n    rdfs:label \"tax type\" ;\n    rdfs:comment \"Type of tax (e.g., VAT).\" ;\n    rdfs:domain :TAXSegment ;\n    rdfs:range xsd:string .\n\n:taxRate a owl:DatatypeProperty ;\n    rdfs:label \"tax rate\" ;\n    rdfs:comment \"Tax rate percentage.\" ;\n    rdfs:domain :TAXSegment ;\n    rdfs:range xsd:decimal .\n\n:currencyQualifier a owl:DatatypeProperty ;\n    rdfs:label \"currency qualifier\" ;\n    rdfs:comment \"Qualifier for the CUX segment.\" ;\n    rdfs:domain :CUXSegment ;\n    rdfs:range xsd:string .\n\n:currencyCode a owl:DatatypeProperty ;\n    rdfs:label \"currency code\" ;\n    rdfs:comment \"Currency code (e.g., EUR, USD).\" ;\n    rdfs:domain :CUXSegment ;\n    rdfs:range xsd:string .\n\n:referenceQualifier a owl:DatatypeProperty ;\n    rdfs:label \"reference qualifier\" ;\n    rdfs:comment \"Qualifier for the RFF segment.\" ;\n    rdfs:domain :RFFSegment ;\n    rdfs:range xsd:string .\n\n:referenceValue a owl:DatatypeProperty ;\n    rdfs:label \"reference value\" ;\n    rdfs:comment \"Reference value for the RFF segment.\" ;\n    rdfs:domain :RFFSegment ;\n    rdfs:range xsd:string .\n\n:unsQualifier a owl:DatatypeProperty ;\n    rdfs:label \"UNS qualifier\" ;\n    rdfs:comment \"Qualifier for the UNS segment.\" ;\n    rdfs:domain :UNSSegment ;\n    rdfs:range xsd:string .\n\n:lineNumber a owl:DatatypeProperty ;\n    rdfs:label \"line number\" ;\n    rdfs:comment \"Line item number in LIN segment.\" ;\n    rdfs:domain :LINSegment ;\n    rdfs:range xsd:string .\n\n:itemIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"item identifier\" ;\n    rdfs:comment \"Item identifier in LIN segment.\" ;\n    rdfs:domain :LINSegment ;\n    rdfs:range xsd:string .\n\n:qtyQualifier a owl:DatatypeProperty ;\n    rdfs:label \"quantity qualifier\" ;\n    rdfs:comment \"Qualifier for the QTY segment.\" ;\n    rdfs:domain :QTYSegment ;\n    rdfs:range xsd:string .\n\n:qtyValue a owl:DatatypeProperty ;\n    rdfs:label \"quantity value\" ;\n    rdfs:comment \"Quantity value in QTY segment.\" ;\n    rdfs:domain :QTYSegment ;\n    rdfs:range xsd:decimal .\n\n:priceQualifier a owl:DatatypeProperty ;\n    rdfs:label \"price qualifier\" ;\n    rdfs:comment \"Qualifier for the PRI segment.\" ;\n    rdfs:domain :PRISegment ;\n    rdfs:range xsd:string .\n\n:priceAmount a owl:DatatypeProperty ;\n    rdfs:label \"price amount\" ;\n    rdfs:comment \"Price amount in PRI segment.\" ;\n    rdfs:domain :PRISegment ;\n    rdfs:range xsd:decimal .\n\n#################################################################\n# Restrictions & Axioms (Examples)\n#################################################################\n\n:Invoice a owl:Class ;\n    owl:equivalentClass [\n        a owl:Class ;\n        owl:intersectionOf (\n            [ a owl:Restriction ; owl:onProperty :hasInvoiceNumber ; owl:someValuesFrom xsd:string ]\n            [ a owl:Restriction ; owl:onProperty :listsLineItem ; owl:someValuesFrom :LineItem ]\n            [ a owl:Restriction ; owl:onProperty :hasBuyer ; owl:someValuesFrom :Organization ]\n            [ a owl:Restriction ; owl:onProperty :hasDateSegment ; owl:someValuesFrom :DTMSegment ]\n            [ a owl:Restriction ; owl:onProperty :hasMonetaryAmountSegment ; owl:someValuesFrom :MOASegment ]\n        )\n    ] .\n\n:OrganizationRoleAssignment a owl:Class ;\n    owl:equivalentClass [\n        a owl:Class ;\n        owl:intersectionOf (\n            [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:someValuesFrom :AgentRole ]\n            [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ]\n        )\n    ] .\n\n# Disjointness axioms\n:BGMSegment owl:disjointWith :NADSegment, :DTMSegment, :MOASegment, :TAXSegment, :CUXSegment, :RFFSegment, :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:NADSegment owl:disjointWith :DTMSegment, :MOASegment, :TAXSegment, :CUXSegment, :RFFSegment, :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:DTMSegment owl:disjointWith :MOASegment, :TAXSegment, :CUXSegment, :RFFSegment, :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:MOASegment owl:disjointWith :TAXSegment, :CUXSegment, :RFFSegment, :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:TAXSegment owl:disjointWith :CUXSegment, :RFFSegment, :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:CUXSegment owl:disjointWith :RFFSegment, :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:RFFSegment owl:disjointWith :UNSSegment, :LINSegment, :QTYSegment, :PRISegment .\n:UNSSegment owl:disjointWith :LINSegment, :QTYSegment, :PRISegment .\n:LINSegment owl:disjointWith :QTYSegment, :PRISegment .\n:QTYSegment owl:disjointWith :PRISegment .\n\n:Invoice owl:disjointWith :Organization .\n:Item owl:disjointWith :Organization .\n:Address owl:disjointWith :Organization .\n\n# DisjointUnionOf\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :DTMSegment :MOASegment :TAXSegment :CUXSegment :RFFSegment :UNSSegment :LINSegment :QTYSegment :PRISegment) .\n"
}
