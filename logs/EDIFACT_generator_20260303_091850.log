bel \"has tax\" ;\n  rdfs:comment \"Links the summary section to tax information.\" .\n\n:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :InvoiceAmount ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Links the summary section to the total invoice amount.\" .\n\n:hasReferenceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :ReferenceNumber ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Links the header section to its reference number.\" .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  rdfs:label \"has business process\" ;\n  rdfs:comment \"Links an invoice to its associated business process.\" .\n\n:hasSegmentData a owl:ObjectProperty ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement ;\n  rdfs:label \"has segment data\" ;\n  rdfs:comment \"Links a segment to its composite data elements.\" .\n\n:hasCompositeDataElement a owl:ObjectProperty ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement ;\n  rdfs:label \"has composite data element\" ;\n  rdfs:comment \"Links a composite data element to its simple data elements.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasGlobalLocationNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has Global Location Number\" ;\n  rdfs:comment \"The Global Location Number (GLN) for an organization.\" .\n\n:hasQuantity a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Item ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"The quantity of the item invoiced.\" .\n\n:hasValue a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :SimpleDataElement ;\n  rdfs: