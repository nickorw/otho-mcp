ts headquarters address.\\\" .\\n\\n:hasItem a owl:ObjectProperty ;\\n  rdfs:domain :DetailSection ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"has item\\\" ;\\n  rdfs:comment \\\"Links a detail section to its listed items.\\\" .\\n\\n:hasNetPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :Item ;\\n  rdfs:range :Price ;\\n  rdfs:label \\\"has net price\\\" ;\\n  rdfs:comment \\\"Links an item to its net price.\\\" .\\n\\n:hasTax a owl:ObjectProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"has tax\\\" ;\\n  rdfs:comment \\\"Links the summary section to tax information.\\\" .\\n\\n:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range :InvoiceAmount ;\\n  rdfs:label \\\"has invoice amount\\\" ;\\n  rdfs:comment \\\"Links the summary section to the total invoice amount.\\\" .\\n\\n:hasReferenceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range :ReferenceNumber ;\\n  rdfs:label \\\"has reference number\\\" ;\\n  rdfs:comment \\\"Links the header section to its reference number.\\\" .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"has business process\\\" ;\\n  rdfs:comment \\\"Links an invoice to its associated business process.\\\" .\\n\\n:hasSegmentData a owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has segment data\\\" ;\\n  rdfs:comment \\\"Links a segment to its composite data elements.\\\" .\\n\\n:hasCompositeDataElement a owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has composite data element\\\" ;\\n  rdfs:comment \\\"Links a composite data element to its simple data elements.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Global Location Number\\\" ;\\n  rdfs:comment \\\"The Global Location Number (GLN) for an organization.\\\" .\\n\\n:hasQuantity a owl:DatatypeProperty, owl:FunctionalProperty ;\\n  rdfs:domain :Item ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"has quantity\\\" ;\\n  rdfs:comment \\\"The quantity of the item invoiced.\\\" .\\n\\n:hasValue a owl:DatatypeProperty, owl:FunctionalProperty ;\\n  rdfs:domain :SimpleDataElement ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has value\\\" ;\\n  rdfs:comment \\\"The value of a simple data element.\\\" .\\n\\n:hasDocumentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has document date\\\" ;\\n  rdfs:comment \\\"The date of the document (string format).\\\" .\\n\\n#################################################################\\n# Hierarchies and Disjointness\\n#################################################################\\n\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :AgentRole, :Item .\\n:AgentRole owl:disjointWith :Item .\\n:Item owl:disjointWith :Price .\\n\\n:Segment owl:disjointUnionOf ( :BGM_Segment :NAD_Segment :HeaderSection :DetailSection :SummarySection ) .\\n\\n#################################################################\\n# Complex Restrictions & Axioms\\n#################################################################\\n\\n:InvoiceMessage owl:equivalentClass [\\n  a owl:Class ;\\n  owl:intersectionOf (\\n    :Message\\n    [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :HeaderSection ]\\n    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :DetailSection ]\\n    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :SummarySection ]\\n  )\\n] .\\n\\n:Pivot_OrganizationRoleAssignment owl:equivalentClass [\\n  a owl:Class ;\\n  owl:intersectionOf (\\n    [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ]\\n    [ a owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Organization ]\\n    [ a owl:Restriction ; owl:onProperty :roleContext ; owl:someValuesFrom :InvoiceMessage ]\\n  )\\n] .\\n\\n#################################################################\\n# Property Characteristics\\n#################################################################\\n# Already modeled above using owl:FunctionalProperty in property typing.\\n\\n#################################################################\\n# Annotations\\n#################################################################\\n# All classes and properties have rdfs:label and rdfs:comment as above.\\n\"}",
