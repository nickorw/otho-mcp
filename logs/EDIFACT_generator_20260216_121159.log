\\n    rdfs:subClassOf :Segment .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section of an EDIFACT message, containing totals and taxes.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment, grouping related simple elements.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in an EDIFACT transaction, such as buyer or seller.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the context of an EDIFACT message (e.g., Buyer, Seller, Delivery Party).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified assignment of a role to an organization in a specific message context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address for an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization, such as a GLN (Global Location Number).\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in an invoice.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the detail section of an invoice, referencing an item, quantity, and price.\\\" ;\\n    rdfs:subClassOf :DetailSection .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A monetary value associated with an item or invoice.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity of items in a line item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax applied to the invoice or line items.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint used for automated validation of the document (e.g., SHACL shapes).\\\" .\\n\\n:Standard a owl:Class ;\\n    rdfs:label \\\"Standard\\\" ;\\n    rdfs:comment \\\"A standard to which the message conforms (e.g., EN 16931-1).\\\" .\\n\\n:PurchaseToPayOntologyReference a owl:Class ;\\n    rdfs:label \\\"Purchase-to-Pay Ontology Reference\\\" ;\\n    rdfs:comment \\\"A reference to the Purchase-to-Pay Ontology (P2P-O).\\\" ;\\n    rdfs:subClassOf :Standard .\\n\\n#################################################################\\n# OBJECT PROPERTIES (with inverses)\\n#################################################################\\n\\n:hasMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT interchange to its contained messages.\\\" ;\\n    rdfs:domain :EdifactInterchange ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :isMessageOf .\\n\\n:isMessageOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is message of\\\" ;\\n    rdfs:comment \\\"Inverse of hasMessage; relates a message to its interchange.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :EdifactInterchange ;\\n    owl:inverseOf :hasMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its segments.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment; relates a segment to its message.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasHeaderSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has header section\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its header section.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :HeaderSection ;\\n    owl:inverseOf :isHeaderSectionOf .\\n\\n:isHeaderSectionOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is header section of\\\" ;\\n    rdfs:comment \\\"Inverse of hasHeaderSection; relates a header section to its message.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasHeaderSection .\\n\\n:hasDetailSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has detail section\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its detail section.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :DetailSection ;\\n    owl:inverseOf :isDetailSectionOf .\\n\\n:isDetailSectionOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is detail section of\\\" ;\\n    rdfs:comment \\\"Inverse of hasDetailSection; relates a detail section to its message.\\\" ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasDetailSection .\\n\\n:hasSummarySection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has summary section\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its summary section.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :SummarySection ;\\n    owl:inverseOf :isSummarySectionOf .\\n\\n:isSummarySectionOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is summary section of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSummarySection; relates a summary section to its message.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasSummarySection .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is composite element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasCompositeElement; relates a composite element to its segment.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a composite data element to its simple elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is simple element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleElement; relates a simple element to its composite data element.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n:hasOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to an involved organization.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :isOrganizationOf .\\n\\n:isOrganizationOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is organization of\\\" ;\\n    rdfs:comment \\\"Inverse of hasOrganization; relates an organization to the message it is involved in.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasOrganization .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Relates an organization to a role assignment (pivot class).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :RoleAssignment ;\\n    owl:inverseOf :isRoleAssignmentOf .\\n\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is role assignment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasRoleAssignment; relates a role assignment to its organization.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:label \\\"plays role\\\" ;\\n    rdfs:comment \\\"Relates a role assignment to an agent role.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:inverseOf :isRolePlayedBy .\\n\\n:isRolePlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"is role played by\\\" ;\\n    rdfs:comment \\\"Inverse of playsRole; relates an agent role to the role assignment.\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :RoleAssignment ;\\n    owl:inverseOf :playsRole .\\n\\n:inMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"in message\\\" ;\\n    rdfs:comment \\\"Relates a role assignment to the message context.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasRoleAssignmentIn .\\n\\n:hasRoleAssignmentIn a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment in\\\" ;\\n    rdfs:comment \\\"Inverse of inMessage; relates a message to its role assignments.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :RoleAssignment ;\\n    owl:inverseOf :inMessage .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Relates an organization to its address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is address of\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress; relates an address to the organization.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Relates an organization to its identifier (e.g., GLN).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    owl:inverseOf :isIdentifierOf .\\n\\n:isIdentifierOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is identifier of\\\" ;\\n    rdfs:comment \\\"Inverse of hasIdentifier; relates an identifier to its organization.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasIdentifier .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to an item.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isItemOfInvoice .\\n\\n:isItemOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"is item of invoice\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem; relates an item to the invoice message.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasItem .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Relates a detail section to its line items.\\\" ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    owl:inverseOf :isLineItemOf .\\n\\n:isLineItemOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is line item of\\\" ;\\n    rdfs:comment \\\"Inverse of hasLineItem; relates a line item to the detail section.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DetailSection ;\\n    owl:inverseOf :hasLineItem .\\n\\n:itemOf a owl:ObjectProperty ;\\n    rdfs:label \\\"item of\\\" ;\\n    rdfs:comment \\\"Relates a line item to the item it references.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isLineItemFor .\\n\\n:isLineItemFor a owl:ObjectProperty ;\\n    rdfs:label \\\"is line item for\\\" ;\\n    rdfs:comment \\\"Inverse of itemOf; relates an item to the line item.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    owl:inverseOf :itemOf .\\n\\n:hasQuantity a owl:ObjectProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Relates a line item to a quantity.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Quantity ;\\n    owl:inverseOf :isQuantityOf .\\n\\n:isQuantityOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is quantity of\\\" ;\\n    rdfs:comment \\\"Inverse of hasQuantity; relates a quantity to the line item.\\\" ;\\n    rdfs:domain :Quantity ;\\n    rdfs:range :LineItem ;\\n    owl:inverseOf :hasQuantity .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Relates a line item to its net price.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    owl:inverseOf :isNetPriceOf .\\n\\n:isNetPriceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is net price of\\\" ;\\n    rdfs:comment \\\"Inverse of hasNetPrice; relates a price to the line item.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    owl:inverseOf :hasNetPrice .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Relates a summary section to a tax.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax ;\\n    owl:inverseOf :isTaxOf .\\n\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is tax of\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax; relates a tax to the summary section.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :SummarySection ;\\n    owl:inverseOf :hasTax .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to a business process.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    owl:inverseOf :isBusinessProcessOf .\\n\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is business process of\\\" ;\\n    rdfs:comment \\\"Inverse of hasBusinessProcess; relates a business process to the invoice message.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasBusinessProcess .\\n\\n:conformsToStandard a owl:ObjectProperty ;\\n    rdfs:label \\\"conforms to standard\\\" ;\\n    rdfs:comment \\\"Indicates the standard to which an EDIFACT message conforms.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :Standard ;\\n    owl:inverseOf :isStandardFor .\\n\\n:isStandardFor a owl:ObjectProperty ;\\n    rdfs:label \\\"is standard for\\\" ;\\n    rdfs:comment \\\"Inverse of conformsToStandard; relates a standard to the message.\\\" ;\\n    rdfs:domain :Standard ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :conformsToStandard .\\n\\n:refersToP2PO a owl:ObjectProperty ;\\n    rdfs:label \\\"refers to P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates a reference to the Purchase-to-Pay Ontology (P2P-O).\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :PurchaseToPayOntologyReference ;\\n    owl:inverseOf :isP2POReferenceOf .\\n\\n:isP2POReferenceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is P2P-O reference of\\\" ;\\n    rdfs:comment \\\"Inverse of refersToP2PO; relates a P2P-O reference to the message.\\\" ;\\n    rdfs:domain :PurchaseToPayOntologyReference ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :refersToP2PO .\\n\\n:hasValidationConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has validation constraint\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its validation constraints (e.g., SHACL shapes).\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    owl:inverseOf :isValidationConstraintOf .\\n\\n:isValidationConstraintOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is validation constraint of\\\" ;\\n    rdfs:comment \\\"Inverse of hasValidationConstraint; relates a validation constraint to the message.\\\" ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasValidationConstraint .\\n\\n#################################################################\\n# DATA PROPERTIES\\n#################################################################\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The unique invoice number.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n:hasDocumentDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The date of the document (as a string, due to OWL2 DL constraints).\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"A reference number for the document.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# HIERARCHY & DISJOINTS\\n#################################################################\\n\\n:RoleAssignment owl:disjointWith :Organization, :AgentRole, :Address, :Identifier .\\n\\n# Disjoint unions for core concepts\\n[ a owl:Class ; owl:disjointUnionOf (:Organization :AgentRole :RoleAssignment) ] .\\n[ a owl:Class ; owl:disjointUnionOf (:Segment :CompositeDataElement :SimpleDataElement) ] .\\n\"}",
        "name": "update_scratchpad"
      },
