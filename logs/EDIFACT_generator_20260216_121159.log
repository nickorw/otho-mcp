uantity .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates a line item to its net price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n    rdfs:label \"is net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice; relates a price to the line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasNetPrice .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Relates a summary section to a tax.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax ;\n    owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n    rdfs:label \"is tax of\" ;\n    rdfs:comment \"Inverse of hasTax; relates a tax to the summary section.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range :SummarySection ;\n    owl:inverseOf :hasTax .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Relates an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Inverse of hasBusinessProcess; relates a business process to the invoice message.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasBusinessProcess .\n\n:conformsToStandard a owl:ObjectProperty ;\n    rdfs:label \"conforms to standard\" ;\n    rdfs:comment \"Indicates the standard to which an EDIFACT message conforms.\" ;\n    rdfs:domain :EdifactMessage ;\n    rdfs:range :Standard ;\n    owl:inverseOf :isStandardFor .\n\n:isStandardFor a owl:ObjectProperty ;\n    rdfs:label \"is standard for\" ;\n    rdfs:comment \"Inverse of conformsToStandard; relates a standard to the message.\" ;\n    rdfs:domain :Standard ;\n    rdfs:rang