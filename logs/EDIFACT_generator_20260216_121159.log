ationConstraint .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The unique invoice number.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The date of the document (as a string, due to OWL2 DL constraints).\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"A reference number for the document.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n#################################################################\n# HIERARCHY & DISJOINTS\n#################################################################\n\n:RoleAssignment owl:disjointWith :Organization, :AgentRole, :Address, :Identifier .\n\n# Disjoint unions for core concepts\n[ a owl:Class ; owl:disjointUnionOf (:Organization :AgentRole :RoleAssignment) ] .\n[ a owl:Class ; owl:disjointUnionOf (:Segment :CompositeDataElement :SimpleDataElement) ] .\n"
