        "arguments": "{\"owl_content\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#EDIFACT-Ontology>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Ontology\\\" ;\\n    rdfs:comment \\\"An ontology representing the structure and semantics of UN/EDIFACT business documents, including invoices, segments, roles, and validation constraints.\\\" .\\n\\n#################################################################\\n# CLASSES\\n#################################################################\\n\\n:EdifactInterchange a owl:Class ;\\n    rdfs:label \\\"EDIFACT Interchange\\\" ;\\n    rdfs:comment \\\"The highest-level envelope for an EDIFACT document containing one or more messages.\\\" .\\n\\n:EdifactMessage a owl:Class ;\\n    rdfs:label \\\"EDIFACT Message\\\" ;\\n    rdfs:comment \\\"A message within an EDIFACT interchange, such as an invoice.\\\" ;\\n    rdfs:subClassOf :EdifactInterchange .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"A specific EDIFACT message representing an invoice transaction.\\\" ;\\n    rdfs:subClassOf :EdifactMessage .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message, such as BGM or NAD.\\\" ;\\n    rdfs:subClassOf :EdifactMessage .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an EDIFACT message, containing document dates and reference numbers.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The detail section of an EDIFACT message, containing line items.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section of an EDIFACT message, containing totals and taxes.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment, grouping related simple elements.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in an EDIFACT transaction, such as buyer or seller.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the context of an EDIFACT message (e.g., Buyer, Seller, Delivery Party).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified assignment of a role to an organization in a specific message context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address for an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization, such as a GLN (Global Location Number).\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in an invoice.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the detail section of an invoice, referencing an item, quantity, and price.\\\" ;\\n    rdfs:subClassOf :DetailSection .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A monetary value associated with an item or invoice.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity of items in a line item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax applied to the invoice or line items.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint used for automated validation of the document (e.g., SHACL shapes).\\\" .\\n\\n:Standard a owl:Class ;\\n    rdfs:label \\\"Standard\\\" ;\\n    rdfs:comment \\\"A standard to which the message conforms (e.g., EN 16931-1).\\\" .\\n\\n:PurchaseToPayOntologyReference a owl:Class ;\\n    rdfs:label \\\"Purchase-to-Pay Ontology Reference\\\" ;\\n    rdfs:comment \\\"A reference to the Purchase-to-Pay Ontology (P2P-O).\\\" ;\\n    rdfs:subClassOf :Standard .\\n\\n#################################################################\\n# OBJECT PROPERTIES (with inverses)\\n#################################################################\\n\\n:hasMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT interchange to its contained messages.\\\" ;\\n    rdfs:domain :EdifactInterchange ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :isMessageOf .\\n\\n:isMessageOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is message of\\\" ;\\n    rdfs:comment \\\"Inverse of hasMessage; relates a message to its interchange.\\\" ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :EdifactInterchange ;\\n    owl:inverseOf :hasMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its segments.\\\" ;\\n    rdfs:domain :Edifact