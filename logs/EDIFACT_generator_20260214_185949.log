######################\n# Object Properties\n#################################################################\n\n:containsInvoice a owl:ObjectProperty ;\n  rdfs:domain :EDIFACTMessage ;\n  rdfs:range :Invoice ;\n  owl:propertyDisjointWith :involvesParticipation ;\n  owl:IrreflexiveProperty true ;\n  rdfs:label \"contains invoice\" ;\n  rdfs:comment \"Associates an EDIFACT message with the invoices it contains.\" .\n\n:involvesParticipation a owl:ObjectProperty ;\n  rdfs:domain :Invoice ;\n  rdfs:range :InvoiceParticipation ;\n  rdfs:label \"involves participation\" ;\n  rdfs:comment \"Associates an invoice with the participations (roles played by organizations in the invoice).\" .\n\n:hasParticipant a owl:ObjectProperty ;\n  rdfs:domain :InvoiceParticipation ;\n  rdfs:range :Organization ;\n  owl:FunctionalProperty true ;\n  rdfs:label \"has participant\" ;\n  rdfs:comment \"Specifies which organization participates in an invoice.\" .\n\n:hasRole a owl:ObjectProperty ;\n  rdfs:domain :InvoiceParticipation ;\n  rdfs:range :OrganizationRole ;\n  owl:FunctionalProperty true ;\n  rdfs:label \"has role\" ;\n  rdfs:comment \"Specifies the role of the organization in the invoice.\" .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address ;\n  owl:FunctionalProperty true ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization to its address.\" .\n\n:includesItem a owl:ObjectProperty ;\n  rdfs:domain :Invoice ;\n  rdfs:range :InvoiceItem ;\n  rdfs:label \"includes item\" ;\n  rdfs:comment \"Associates an invoice with the items it includes.\" .\n\n:refersToItem a owl:ObjectProperty ;\n  rdfs:domain :InvoiceItem ;\n  rdfs:range :Item ;\n  owl:FunctionalProperty true ;\n  rdfs:label \"refers to item\" ;\n  rdfs:comment \"Links an invoice item to the item being sold.\" .\n\n:assignedToProcess a owl:ObjectProperty ;\n  rdfs:domain :Invoice ;\n  rdfs:range :BusinessProcess ;\n  rdfs:label \"assigned to process\" ;\n  rdfs:comment \"Associates an invoice to a business process.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:netPrice a owl:DatatypeProperty ;\n  rdfs:domain :InvoiceItem ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"net price\" ;\n  rdfs:comment \"Net price of the invoice item.\" .\n\n:invoiceAmount a owl:DatatypeProperty ;\n  rdfs:domain :Invoice ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"invoice amount\" ;\n  rdfs:comment \"Total amount of the invoice.\" .\n\n:invoiceNumber a owl:DatatypeProperty ;\n  rdfs:domain :Invoice ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty true ;\n  rdfs:label \"invoice number\" ;\n  rdfs:comment \"Unique number of the invoice.\" .\n\n:orgName a owl:DatatypeProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty true ;\n  rdfs:label \"organization name\" ;\n  rdfs:comment \"The name of the organization.\" .\n\n:street a owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"street\" ;\n  rdfs:comment \"Street name of the address.\" .\n\n:city a owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"city\" ;\n  rdfs:comment \"City of the address.\" .\n\n:country a owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"country\" ;\n  rdfs:comment \"Country of the address.\" .\n\n:itemDescription a owl:DatatypeProperty ;\n  rdfs:domain :Item ;\n  rdfs:range xsd:string ;\n  rdfs:label \"item description\" ;\n  rdfs:comment \"Description of the item.\" .\n\n#################################################################\n# Hierarchy & Disjointness\n#################################################################\n\n:EDIFACTMessage owl:disjointWith :Invoice .\n:Organization owl:disjointWith :Item, :Address .\n:Address owl:disjointWith :Organization .\n:Item owl:disjointWith :Organization .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n\n:BuyerParticipation a owl:Class ;\n  owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      :InvoiceParticipation\n      [ a owl:Restriction ;\n        owl:onProperty :hasRole ;\n        owl:hasValue :Buyer\n      ]\n    )\n  ] ;\n  rdfs:label \"Buyer Participation\" ;\n  rdfs:comment \"Defines buyer participation as an invoice participation with role 'Buyer'.\" .\n\n:InvoiceParticipation rdfs:subClassOf [\n  a owl:Restriction ;\n  owl:onProperty :hasParticipant ;\n  owl:allValuesFrom :Organization\n] , [\n  a owl:Restriction ;\n  owl:onProperty :hasRole ;\n  owl:allValuesFrom :OrganizationRole\n] .\n"
