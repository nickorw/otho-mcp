        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/edifact-invoice-story>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"Ontology for representing UN/EDIFACT invoice messages, roles, and structure for procurement scenarios as described in the story.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"A digital envelope containing messages in an EDIFACT transmission.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A business message within an interchange envelope.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"A message representing an invoice (e.g., INVOIC) in EDIFACT.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within a message, such as BGM or NAD.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite element grouping simple data elements.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A basic data element within a composite or segment.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An entity involved in the business process (e.g., buyer, seller, delivery party).\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the context of an invoice (e.g., buyer, seller, delivery party).\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A physical or logical address associated with an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A mandatory identifier (e.g., Global Location Number).\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified association linking an organization, its role, address, and identifiers within an invoice.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service being invoiced.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value associated with an item or invoice line.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"An itemized line in the invoice, specifying item, quantity, and price.\\\" .\\n\\n:InvoiceLineAssociation a owl:Class ;\\n    rdfs:label \\\"Invoice Line Association\\\" ;\\n    rdfs:comment \\\"A reified association linking an invoice message to its line items.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an invoice, containing dates, reference numbers, etc.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The section of an invoice listing all line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section with totals, tax, and invoice amount.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice can be assigned.\\\" .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:hasMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Relates an interchange envelope to the message(s) it contains.\\\" ;\\n    owl:inverseOf :isMessageOf .\\n:isMessageOf a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is message of\\\" ;\\n    rdfs:comment \\\"Inverse of hasMessage.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its constituent segments.\\\" ;\\n    owl:inverseOf :isSegmentOf .\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n    owl:inverseOf :isCompositeElementOf .\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"is composite element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasCompositeElement.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" ;\\n    owl:inverseOf :isSimpleElementOf .\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleElement.\\\" .\\n\\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"has organization role assignment\\\" ;\\n    rdfs:comment \\\"Links an invoice message to an organization role assignment (reified role pattern).\\\" ;\\n    owl:inverseOf :isOrganizationRoleAssignmentOf .\\n:isOrganizationRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is organization role assignment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasOrganizationRoleAssignment.\\\" .\\n\\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Specifies the agent role in a role assignment.\\\" ;\\n    owl:inverseOf :isRoleOf .\\n:isRoleOf a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"is role of\\\" ;\\n    rdfs:comment \\\"Inverse of hasRole.\\\" .\\n\\n:hasOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Specifies the organization in a role assignment.\\\" ;\\n    owl:inverseOf :isOrganizationOfAssignment .\\n:isOrganizationOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"is organization of assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasOrganization.\\\" .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Specifies the address associated with a role assignment.\\\" ;\\n    owl:inverseOf :isAddressOfAssignment .\\n:isAddressOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"is address of assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress.\\\" .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Identifier ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Specifies an identifier associated with a role assignment.\\\" ;\\n    owl:inverseOf :isIdentifierOfAssignment .\\n:isIdentifierOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"is identifier of assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasIdentifier.\\\" .\\n\\n:hasLineAssociation a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceLineAssociation ;\\n    rdfs:label \\\"has line association\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its line associations (reified line pattern).\\\" ;\\n    owl:inverseOf :isLineAssociationOf .\\n:isLineAssociationOf a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceLineAssociation ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is line association of\\\" ;\\n    rdfs:comment \\\"Inverse of hasLineAssociation.\\\" .\\n\\n:hasLineItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceLineAssociation ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Specifies the line item in an invoice line association.\\\" ;\\n    owl:inverseOf :isLineItemOf .\\n:isLineItemOf a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :InvoiceLineAssociation ;\\n    rdfs:label \\\"is line item of\\\" ;\\n    rdfs:comment \\\"Inverse of hasLineItem.\\\" .\\n\\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Specifies the item in a line item.\\\" ;\\n    owl:inverseOf :isItemOf .\\n:isItemOf a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is item of\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem.\\\" .\\n\\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Specifies the price in a line item.\\\" ;\\n    owl:inverseOf :isPriceOf .\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is price of\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice.\\\" .\\n\\n:hasBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process.\\\" ;\\n    owl:inverseOf :isBusinessProcessOf .\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is business process of\\\" ;\\n    rdfs:comment \\\"Inverse of hasBusinessProcess.\\\" .\\n\\n# Added to connect DetailSection\\n:hasDetailSection a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail section\\\" ;\\n    rdfs:comment \\\"Connects an invoice message to its detail section.\\\" ;\\n    owl:inverseOf :isDetailSectionOf .\\n:isDetailSectionOf a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is detail section of\\\" ;\\n    rdfs:comment \\\"Inverse of hasDetailSection.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"The total invoice amount in the summary section.\\\" .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number in the header section.\\\" .\\n\\n:hasNetPrice a owl:DatatypeProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"The net price of an item.\\\" .\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of items in a line item.\\\" .\\n\\n:hasDate a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:dateTime ;\\n    rdfs:label \\\"has date\\\" ;\\n    rdfs:comment \\\"Document date in the header section.\\\" .\\n\\n:hasName a owl:DatatypeProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has name\\\" ;\\n    rdfs:comment \\\"The name of an organization.\\\" .\\n\\n:hasAddressLine a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has address line\\\" ;\\n    rdfs:comment \\\"The address line of an address.\\\" .\\n\\n:hasTaxTotal a owl:DatatypeProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has tax total\\\" ;\\n    rdfs:comment \\\"The total tax amount in the summary section.\\\" .\\n\\n:hasMandatoryIdentifier a owl:DatatypeProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has mandatory identifier\\\" ;\\n    rdfs:comment \\\"A mandatory identifier value (e.g., GLN).\\\" .\\n\\n#################################################################\\n# Class Hierarchies and Disjointness\\n#################################################################\\n\\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :Item , :Address .\\n:Item owl:disjointWith :Address .\\n\\n:InvoiceMessage owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n      :Message\\n      [ a owl:Restriction ; owl:onProperty :hasOrganizationRoleAssignment ; owl:someValuesFrom :OrganizationRoleAssignment ]\\n      [ a owl:Restriction ; owl:onProperty :hasLineAssociation ; owl:someValuesFrom :InvoiceLineAssociation ]\\n      [ a owl:Restriction ; owl:onProperty :hasBusinessProcess ; owl:allValuesFrom :BusinessProcess ]\\n    )\\n] .\\n\"}",
