2026-03-03 09:04:02 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#edifact-invoic-ontology> a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A INVOIC Ontology\" ;\n    rdfs:comment \"A deeply structured OWL2 ontology for D96A EANCOM INVOIC messages, supporting full segment and qualifier coverage, party roles, and regulatory alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Top-level UN/EDIFACT interchange envelope containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message container.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An INVOIC message as defined in UN/EDIFACT D96A.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"Generic EDIFACT segment (BGM, NAD, DTM, etc.).\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NAD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" .\n\n:DTM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment (e.g., Document Date, Invoice Date).\" .\n\n:MOA_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment (e.g., invoice totals, line item amounts).\" .\n\n:TAX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax information segment (rates, amounts, types).\" .\n\n:QTY_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment (e.g., line item quantities).\" .\n\n:RFF_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment (e.g., Invoice Number, Order Number, VAT/Fiscal Reference).\" .\n\n:LIN_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line Item segment for item identification.\" .\n\n:PIA_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PIA Segment\" ;\n    rdfs:comment \"Additional Product Id segment for item reference alternatives.\" .\n\n:IMD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"IMD Segment\" ;\n    rdfs:comment \"Item Description segment for item characteristics.\" .\n\n:ALC_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"ALC Segment\" ;\n    rdfs:comment \"Allowance/Charge segment for discounts, surcharges, etc.\" .\n\n:ALC_Detail_Group a owl:Class ;\n    rdfs:label \"Allowance/Charge Detail Group\" ;\n    rdfs:comment \"Group for associating ALC with PCD, MOA, TAX segments for calculation basis.\" .\n\n:UNS_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"UNS Segment\" ;\n    rdfs:comment \"Section Control segment for header/detail/summary separation.\" .\n\n:CNT_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"CNT Segment\" ;\n    rdfs:comment \"Control segment for document totals and counts.\" .\n\n:PAC_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PAC Segment\" ;\n    rdfs:comment \"Packaging segment for number and type of packages shipped.\" .\n\n:PCD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PCD Segment\" ;\n    rdfs:comment \"Percentage Details segment for allowance/charge calculations.\" .\n\n:TOD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TOD Segment\" ;\n    rdfs:comment \"Terms of Delivery or Transport segment.\" .\n\n:CUX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"CUX Segment\" ;\n    rdfs:comment \"Currency segment for document and line-level currency codes.\" .\n\n:FTX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"FTX Segment\" ;\n    rdfs:comment \"Free Text segment for additional information.\" .\n\n:LOC_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"LOC Segment\" ;\n    rdfs:comment \"Location segment for places related to delivery, dispatch, etc.\" .\n\n:MEA_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"MEA Segment\" ;\n    rdfs:comment \"Measurement segment for weights, dimensions, etc.\" .\n\n:PRI_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PRI Segment\" ;\n    rdfs:comment \"Price Details segment for price types and values.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Section containing header-level segments and references.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Section containing line items and associated segments.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Section containing summary-level amounts, taxes, and controls.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"Business entity involved in the invoice (buyer, supplier, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"Role played by an organization in a transaction (buyer, supplier, etc.).\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role of buyer in the invoice.\" .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"Role of delivery party in the invoice.\" .\n\n:Warehouse a owl:Class ;\n    rdfs:label \"Warehouse\" ;\n    rdfs:comment \"Warehouse location associated with an organization.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Postal address for an organization or warehouse.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"GLN identifier for organizations and locations.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"Product or service sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Net price or unit price of an item.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:InvoiceNumber a owl:Class ;\n    rdfs:label \"Invoice Number\" ;\n    rdfs:comment \"Unique identifier for the invoice document.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"Business process associated with the invoice (e.g., procurement).\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"SHACL shape for automated validation of the invoice.\" .\n\n:EN16931Alignment a owl:Class ;\n    rdfs:label \"EN 16931-1 Alignment\" ;\n    rdfs:comment \"Alignment with the European e-Invoicing Standard EN 16931-1.\" .\n\n:P2P_O_Alignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment with the Purchase-to-Pay Ontology (P2P-O).\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"Individual line item in the invoice detail section.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Generic reference number (invoice, order, etc.).\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for associating organizations with roles in a transaction.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"EDIFACT composite data element grouping simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"EDIFACT simple data element.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n:Organization owl:disjointWith :AgentRole, :Segment, :Item, :Address, :Price, :InvoiceAmount, :InvoiceNumber, :BusinessProcess .\n:AgentRole owl:disjointWith :Segment, :Item, :Address, :Price, :InvoiceAmount, :InvoiceNumber, :BusinessProcess .\n:Segment owl:disjointWith :Item, :Address, :Price, :InvoiceAmount, :InvoiceNumber, :BusinessProcess .\n\n#################################################################\n# DisjointUnion\n#################################################################\n:AgentRole owl:disjointUnionOf (:BuyerRole :DeliveryPartyRole) .\n\n#################################################################\n# Properties\n#################################################################\n:containsMessage a owl:ObjectProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Envelope contains one or more messages.\" ;\n    owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Message has segment (BGM, NAD, etc.).\" .\n\n:hasHeader a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :HeaderSection ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Invoice message has header section.\" ;\n    owl:FunctionalProperty .\n\n:hasDetail a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Invoice message has detail section.\" ;\n    owl:FunctionalProperty .\n\n:hasSummary a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Invoice message has summary section.\" ;\n    owl:FunctionalProperty .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Detail section has line item.\" .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Line item describes a product or service.\" ;\n    owl:FunctionalProperty .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Line item has net price.\" ;\n    owl:FunctionalProperty .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Quantity of item in line item.\" ;\n    owl:FunctionalProperty .\n\n:hasInvoiceAmount a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceAmount ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Summary section has invoice total amount.\" ;\n    owl:FunctionalProperty .\n\n:hasInvoiceNumber a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :InvoiceNumber ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Header section has invoice number.\" ;\n    owl:FunctionalProperty .\n\n:hasReferenceNumber a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :ReferenceNumber ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Header section has reference number (order, delivery note, etc.).\" ;\n    owl:FunctionalProperty .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Invoice message links to organization-role assignments.\" .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Role assignment involves an organization.\" ;\n    owl:FunctionalProperty .\n\n:hasAgentRole a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Role assignment specifies the agent role (buyer, delivery party, etc.).\" ;\n    owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Organization has address.\" ;\n    owl:FunctionalProperty .\n\n:hasWarehouse a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Warehouse ;\n    rdfs:label \"has warehouse\" ;\n    rdfs:comment \"Organization has warehouse location(s).\" .\n\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"Organization has Global Location Number (GLN).\" ;\n    owl:FunctionalProperty .\n\n:hasName a owl:DatatypeProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has name\" ;\n    rdfs:comment \"Organization name.\" ;\n    owl:FunctionalProperty .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Document date (DTM+137) in header.\" ;\n    owl:FunctionalProperty .\n\n:isAlignedWithEN16931 a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931Alignment ;\n    rdfs:label \"is aligned with EN 16931\" ;\n    rdfs:comment \"Invoice message is aligned with EN 16931-1 standard.\" .\n\n:isAlignedWithP2PO a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2P_O_Alignment ;\n    rdfs:label \"is aligned with P2P-O\" ;\n    rdfs:comment \"Invoice message is aligned with Purchase-to-Pay Ontology.\" .\n\n:isValidatedBySHACL a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SHACLConstraint ;\n    rdfs:label \"is validated by SHACL\" ;\n    rdfs:comment \"Invoice message is validated by a SHACL shape.\" .\n\n:hasSimpleDataElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Composite data element contains simple elements.\" .\n\n:hasDTMSegment a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :DTM_Segment ;\n    rdfs:label \"has DTM segment\" ;\n    rdfs:comment \"Header section has DTM segment(s) for dates.\" .\n\n:hasMOASegment a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :MOA_Segment ;\n    rdfs:label \"has MOA segment\" ;\n    rdfs:comment \"Summary section has MOA segment(s) for amounts.\" .\n\n:hasTAXSegment a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :TAX_Segment ;\n    rdfs:label \"has TAX segment\" ;\n    rdfs:comment \"Summary section has TAX segment(s).\" .\n\n:hasQTYSegment a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :QTY_Segment ;\n    rdfs:label \"has QTY segment\" ;\n    rdfs:comment \"Line item has QTY segment(s).\" .\n\n:hasRFFSegment a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :RFF_Segment ;\n    rdfs:label \"has RFF segment\" ;\n    rdfs:comment \"Header section has RFF segment(s) for references.\" .\n\n:hasLINSegment a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :LIN_Segment ;\n    rdfs:label \"has LIN segment\" ;\n    rdfs:comment \"Line item has LIN segment for item identification.\" .\n\n:hasPIASegment a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :PIA_Segment ;\n    rdfs:label \"has PIA segment\" ;\n    rdfs:comment \"Line item has PIA segment for alternate item IDs.\" .\n\n:hasIMDSegment a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :IMD_Segment ;\n    rdfs:label \"has IMD segment\" ;\n    rdfs:comment \"Line item has IMD segment for item description.\" .\n\n:hasALCSegment a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :ALC_Segment ;\n    rdfs:label \"has ALC segment\" ;\n    rdfs:comment \"Summary section has ALC segment(s) for allowances/charges.\" .\n\n:hasALCDetailGroup a owl:ObjectProperty ;\n    rdfs:domain :ALC_Segment ;\n    rdfs:range :ALC_Detail_Group ;\n    rdfs:label \"has ALC detail group\" ;\n    rdfs:comment \"ALC segment has detail group for calculation basis.\" .\n\n:hasUNSSegment a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :UNS_Segment ;\n    rdfs:label \"has UNS segment\" ;\n    rdfs:comment \"Summary section has section control segment.\" .\n\n:hasCNTSegment a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :CNT_Segment ;\n    rdfs:label \"has CNT segment\" ;\n    rdfs:comment \"Summary section has control segment for totals.\" .\n\n:hasPACSegment a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :PAC_Segment ;\n    rdfs:label \"has PAC segment\" ;\n    rdfs:comment \"Detail section has packaging segment.\" .\n\n:hasPCDSegment a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :PCD_Segment ;\n    rdfs:label \"has PCD segment\" ;\n    rdfs:comment \"Summary section has percentage details segment.\" .\n\n:hasTODSegment a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :TOD_Segment ;\n    rdfs:label \"has TOD segment\" ;\n    rdfs:comment \"Header section has terms of delivery segment.\" .\n\n:hasCUXSegment a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :CUX_Segment ;\n    rdfs:label \"has CUX segment\" ;\n    rdfs:comment \"Header section has currency segment.\" .\n\n:hasFTXSegment a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :FTX_Segment ;\n    rdfs:label \"has FTX segment\" ;\n    rdfs:comment \"Header section has free text segment.\" .\n\n:hasLOCSegment a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :LOC_Segment ;\n    rdfs:label \"has LOC segment\" ;\n    rdfs:comment \"Header section has location segment.\" .\n\n:hasMEASegment a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :MEA_Segment ;\n    rdfs:label \"has MEA segment\" ;\n    rdfs:comment \"Line item has measurement segment.\" .\n\n:hasPRISegment a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :PRI_Segment ;\n    rdfs:label \"has PRI segment\" ;\n    rdfs:comment \"Line item has price details segment.\" .\n\n:taxRegistrationReference a owl:ObjectProperty ;\n    rdfs:domain :NAD_Segment ;\n    rdfs:range :RFF_Segment ;\n    rdfs:label \"tax registration reference\" ;\n    rdfs:comment \"NAD segment has RFF child for VAT/Fiscal registration (RFF+VA/FC).\" ;\n    owl:FunctionalProperty .\n"
