        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/edifact-invoice-story>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"Ontology for representing EDIFACT invoice messages, segments, roles, and validation constraints, aligned with D96A and EN 16931-1.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The envelope that contains one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"A message representing an invoice, such as INVOIC.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGM_Segment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment, used for document identification.\\\" .\\n\\n:NAD_Segment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment, used for participant details.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element in a segment. Parent of HeaderSection, DetailSection, SummarySection, ItemLine.\\\" ;\\n    rdfs:seeAlso :HeaderSection, :DetailSection, :SummarySection, :ItemLine .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element in a segment. Used as a component of CompositeDataElement.\\\" ;\\n    rdfs:seeAlso :CompositeDataElement .\\n\\n:hasSimpleDataElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple data element\\\" ;\\n    rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" .\\n\\n:isSimpleDataElementOf a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple data element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleDataElement.\\\" ;\\n    owl:inverseOf :hasSimpleDataElement .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"Section of the invoice containing document dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"Section of the invoice containing line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"Section of the invoice containing totals and tax information.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the transaction (buyer, seller, delivery party, etc.).\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the invoice (e.g., buyer, seller, delivery party).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"A reified relationship assigning a specific AgentRole to an Organization within an InvoiceMessage.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal address associated with an organization.\\\" .\\n\\n:LocationIdentifier a owl:Class ;\\n    rdfs:label \\\"Location Identifier\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization location (e.g., GLN).\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service described in the invoice.\\\" .\\n\\n:ItemLine a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Item Line\\\" ;\\n    rdfs:comment \\\"A line in the invoice detail section describing an item, its quantity, and price.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value associated with an item line.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"Tax information for the invoice or item.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number such as invoice number or document reference.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint (e.g., SHACL) for validating invoice data completeness and correctness.\\\" .\\n\\n#################################################################\\n# Object Properties (with inverses)\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an envelope to the message(s) it contains.\\\" .\\n\\n:isContainedInEnvelope a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is contained in envelope\\\" ;\\n    rdfs:comment \\\"Inverse of containsMessage.\\\" ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its segments.\\\" .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment.\\\" ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its header section.\\\" .\\n\\n:isHeaderOf a owl:ObjectProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is header of\\\" ;\\n    rdfs:comment \\\"Inverse of hasHeader.\\\" ;\\n    owl:inverseOf :hasHeader .\\n\\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its detail section.\\\" .\\n\\n:isDetailOf a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is detail of\\\" ;\\n    rdfs:comment \\\"Inverse of hasDetail.\\\" ;\\n    owl:inverseOf :hasDetail .\\n\\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its summary section.\\\" .\\n\\n:isSummaryOf a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is summary of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSummary.\\\" ;\\n    owl:inverseOf :hasSummary .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to a role assignment (pivot class).\\\" .\\n\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is role assignment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasRoleAssignment.\\\" ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:assignedRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"The agent role assigned in a role assignment.\\\" .\\n\\n:isAssignedRoleOf a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"is assigned role of\\\" ;\\n    rdfs:comment \\\"Inverse of assignedRole.\\\" ;\\n    owl:inverseOf :assignedRole .\\n\\n:involvesOrganization a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"The organization involved in a role assignment.\\\" .\\n\\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"is organization involved in\\\" ;\\n    rdfs:comment \\\"Inverse of involvesOrganization.\\\" ;\\n    owl:inverseOf :involvesOrganization .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Associates an organization with its address.\\\" .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is address of\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress.\\\" ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasLocationIdentifier a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :LocationIdentifier ;\\n    rdfs:label \\\"has location identifier\\\" ;\\n    rdfs:comment \\\"Associates an organization with its GLN or other identifier.\\\" .\\n\\n:isLocationIdentifierOf a owl:ObjectProperty ;\\n    rdfs:domain :LocationIdentifier ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is location identifier of\\\" ;\\n    rdfs:comment \\\"Inverse of hasLocationIdentifier.\\\" ;\\n    owl:inverseOf :hasLocationIdentifier .\\n\\n:buyerRoleOf a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"buyer role of\\\" ;\\n    rdfs:comment \\\"Indicates that this agent role is that of a buyer for a message.\\\" .\\n\\n:hasBuyerRole a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"has buyer role\\\" ;\\n    rdfs:comment \\\"Inverse of buyerRoleOf.\\\" ;\\n    owl:inverseOf :buyerRoleOf .\\n\\n:deliveryPartyRoleOf a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"delivery party role of\\\" ;\\n    rdfs:comment \\\"Indicates that this agent role is that of a delivery party for a message.\\\" .\\n\\n:hasDeliveryPartyRole a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"has delivery party role\\\" ;\\n    rdfs:comment \\\"Inverse of deliveryPartyRoleOf.\\\" ;\\n    owl:inverseOf :deliveryPartyRoleOf .\\n\\n:hasItemLine a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :ItemLine ;\\n    rdfs:label \\\"has item line\\\" ;\\n    rdfs:comment \\\"Links the detail section to its item lines.\\\" .\\n\\n:isItemLineOf a owl:ObjectProperty ;\\n    rdfs:domain :ItemLine ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"is item line of\\\" ;\\n    rdfs:comment \\\"Inverse of hasItemLine.\\\" ;\\n    owl:inverseOf :hasItemLine .\\n\\n:referencesItem a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :ItemLine ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"references item\\\" ;\\n    rdfs:comment \\\"Indicates which item is described by this item line.\\\" .\\n\\n:isReferencedItemOf a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :ItemLine ;\\n    rdfs:label \\\"is referenced item of\\\" ;\\n    rdfs:comment \\\"Inverse of referencesItem.\\\" ;\\n    owl:inverseOf :referencesItem .\\n\\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :ItemLine ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links an item line to its price.\\\" .\\n\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :ItemLine ;\\n    rdfs:label \\\"is price of\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice.\\\" ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the summary section to tax details.\\\" .\\n\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is tax of\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax.\\\" ;\\n    owl:inverseOf :hasTax .\\n\\n:hasReferenceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :ReferenceNumber ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Links the header section to a reference number (e.g., invoice number).\\\" .\\n\\n:isReferenceNumberOf a owl:ObjectProperty ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"is reference number of\\\" ;\\n    rdfs:comment \\\"Inverse of hasReferenceNumber.\\\" ;\\n    owl:inverseOf :hasReferenceNumber .\\n\\n:assignedToBusinessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"assigned to business process\\\" ;\\n    rdfs:comment \\\"Assigns the invoice message to a business process.\\\" .\\n\\n:isBusinessProcessAssignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is business process assignment of\\\" ;\\n    rdfs:comment \\\"Inverse of assignedToBusinessProcess.\\\" ;\\n    owl:inverseOf :assignedToBusinessProcess .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:documentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"The date of the document (string for extensibility).\\\" .\\n\\n:netPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"net price\\\" ;\\n    rdfs:comment \\\"Net price of the item.\\\" .\\n\\n:quantity a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :ItemLine ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"quantity\\\" ;\\n    rdfs:comment \\\"Quantity of the item in the item line.\\\" .\\n\\n:invoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"invoice amount\\\" ;\\n    rdfs:comment \\\"Total amount of the invoice.\\\" .\\n\\n:taxAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"tax amount\\\" ;\\n    rdfs:comment \\\"Amount of tax.\\\" .\\n\\n:invoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number.\\\" .\\n\\n:organizationName a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"organization name\\\" ;\\n    rdfs:comment \\\"Name of the organization.\\\" .\\n\\n:addressLine a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"address line\\\" ;\\n    rdfs:comment \\\"Street and number of the address.\\\" .\\n\\n:postalCode a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"postal code\\\" ;\\n    rdfs:comment \\\"Postal code of the address.\\\" .\\n\\n:city a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"city\\\" ;\\n    rdfs:comment \\\"City of the address.\\\" .\\n\\n:countryCode a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"country code\\\" ;\\n    rdfs:comment \\\"Country code of the address.\\\" .\\n\\n:locationIdentifierValue a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :LocationIdentifier ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"location identifier value\\\" ;\\n    rdfs:comment \\\"The value of the location identifier (e.g., GLN).\\\" .\\n\\n:itemDescription a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"item description\\\" ;\\n    rdfs:comment \\\"Description of the item.\\\" .\\n\\n:referenceValue a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"reference value\\\" ;\\n    rdfs:comment \\\"Value of the reference number (e.g., invoice number).\\\" .\\n\\n:constraintDescription a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"constraint description\\\" ;\\n    rdfs:comment \\\"Description of the validation constraint (e.g., SHACL rule).\\\" .\\n\\n#################################################################\\n# Class Disjointness\\n#################################################################\\n\\n:Organization owl:disjointWith :Item, :Address, :ItemLine, :AgentRole .\\n:InvoiceMessage owl:disjointWith :Organization, :ItemLine .\\n:RoleAssignment owl:disjointWith :Organization, :AgentRole, :Address .\\n:Segment owl:disjointUnionOf (:BGM_Segment :NAD_Segment) .\\n\"}",
