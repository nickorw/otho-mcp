address\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is address of\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress: Address is for an Organization.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Identifier(s).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    owl:inverseOf :isIdentifierOf .\\n\\n:isIdentifierOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is identifier of\\\" ;\\n    rdfs:comment \\\"Inverse of hasIdentifier: Identifier identifies an Organization.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasIdentifier .\\n\\n:hasGlobalLocationNumber a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has Global Location Number\\\" ;\\n    rdfs:comment \\\"Links an Organization to its GLN.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :GlobalLocationNumber ;\\n    owl:inverseOf :isGlobalLocationNumberOf .\\n\\n:isGlobalLocationNumberOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is Global Location Number of\\\" ;\\n    rdfs:comment \\\"Inverse of hasGlobalLocationNumber: GlobalLocationNumber is for an Organization.\\\" ;\\n    rdfs:domain :GlobalLocationNumber ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasGlobalLocationNumber .\\n\\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links a LineItem to the Item being sold.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isItemOf .\\n\\n:isItemOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is item of\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem: Item is part of a LineItem.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    owl:inverseOf :hasItem .\\n\\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its Price.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    owl:inverseOf :isPriceOf .\\n\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is price of\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice: Price is for a LineItem.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its Tax information.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :Tax ;\\n    owl:inverseOf :isTaxOf .\\n\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is tax of\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax: Tax is part of an InvoiceSummary.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:inverseOf :hasTax .\\n\\n:assignedToProcess a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned to process\\\" ;\\n    rdfs:comment \\\"Links an Invoice to a BusinessProcess.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess ;\\n    owl:inverseOf :isProcessAssignmentFor .\\n\\n:isProcessAssignmentFor a owl:ObjectProperty ;\\n    rdfs:label \\\"is process assignment for\\\" ;\\n    rdfs:comment \\\"Inverse of assignedToProcess: BusinessProcess is assigned for an Invoice.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :assignedToProcess .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"The date the document was issued (as string for OWL2 DL compliance).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"reference number\\\" ;\\n    rdfs:comment \\\"A reference number for the document.\\\" ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range xsd:string .\\n\\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"The official invoice number.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:netPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"net price\\\" ;\\n    rdfs:comment \\\"Net price for a line item.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal .\\n\\n:quantity a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"quantity\\\" ;\\n    rdfs:comment \\\"Quantity of items in a line item.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"tax amount\\\" ;\\n    rdfs:comment \\\"Total tax amount in the invoice summary.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range xsd:decimal .\\n\\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"invoice amount\\\" ;\\n    rdfs:comment \\\"Total invoice amount in the summary.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:addressLine a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"address line\\\" ;\\n    rdfs:comment \\\"Address line(s) of an address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:organizationName a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"organization name\\\" ;\\n    rdfs:comment \\\"Name of the organization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Class Hierarchies and Disjointness\\n#################################################################\\n:Segment owl:disjointWith :CompositeDataElement .\\n:Organization owl:disjointWith :Address .\\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n\\n#################################################################\\n# Complex Axioms\\n#################################################################\\n:INVOICMessage owl:equivalentClass [ a owl:Class ; owl:Restriction [ owl:onProperty :representsInvoice ; owl:allValuesFrom :Invoice ] ] .\\n:OrganizationRoleAssignment owl:equivalentClass [ a owl:Class ; owl:Restriction [ owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ] ] .\\n\"}",
