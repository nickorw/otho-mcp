2026-03-03 09:17:54 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, segments, roles, and business constraints as described in the story and CQs.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The highest-level envelope in an EDIFACT transmission, containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business document instance within an Interchange Envelope, such as an INVOIC message.\" .\n\n:INVOICMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"An invoice message as defined by EDIFACT, containing segments for transactional data.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A structural component of a message, containing composite and simple data elements.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment, identifies the document type and number.\" .\n\n:NadSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment, provides details about parties involved in the transaction.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment, grouping several simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element, the basic unit of information in a segment.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"A business document representing a request for payment, modeled as the core subject of the INVOIC message.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An entity (company, customer, supplier) involved in the transaction.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role (such as Buyer or Delivery Party) that an Organization can assume in a transaction.\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role for an Organization acting as the buyer.\" .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"Role for an Organization acting as the delivery party.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A location (such as headquarters or warehouse) associated with an Organization.\" .\n\n:GLNIdentifier a owl:Class ;\n    rdfs:label \"GLN Identifier\" ;\n    rdfs:comment \"A Global Location Number identifying an Organization.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of the invoice, containing document-level information such as date and reference numbers.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of the invoice, containing line items.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of the invoice, containing totals such as tax and invoice amount.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An itemized entry in the invoice, representing a product or service sold.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service referenced in a line item.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A monetary value associated with an item or line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax amount or rate applied to the invoice or line items.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice may be assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint or rule for automated validation of the invoice, e.g., via SHACL.\" .\n\n:EN16931Alignment a owl:Class ;\n    rdfs:label \"EN 16931 Alignment\" ;\n    rdfs:comment \"Alignment anchor to the European Standard EN 16931-1 for electronic invoicing.\" .\n\n:P2POCoreClass a owl:Class ;\n    rdfs:label \"P2P-O Core Class\" ;\n    rdfs:comment \"Alignment anchor to the Purchase-to-Pay Ontology (P2P-O) core classes.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for reifying the assignment of a role to an organization within a specific invoice context.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an Interchange Envelope to the Message(s) it contains.\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its Segments.\" ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its Composite Data Elements.\" ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a Composite Data Element to its Simple Data Elements.\" ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement.\" ;\n    owl:inverseOf :hasSimpleElement .\n\n:identifiesInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :BGMSegment ;\n    rdfs:range :Invoice ;\n    rdfs:label \"identifies invoice\" ;\n    rdfs:comment \"Relates a BGM Segment to the Invoice it identifies.\" ;\n    owl:inverseOf :isIdentifiedByBGM .\n\n:isIdentifiedByBGM a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BGMSegment ;\n    rdfs:label \"is identified by BGM\" ;\n    rdfs:comment \"Inverse of identifiesInvoice.\" ;\n    owl:inverseOf :identifiesInvoice .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Relates an Invoice to the organizations involved, via OrganizationRoleAssignment.\" ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Inverse of involvesOrganization.\" ;\n    owl:inverseOf :involvesOrganization .\n\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"Assigns a role (such as Buyer or Delivery Party) to an OrganizationRoleAssignment.\" ;\n    owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is role of assignment\" ;\n    rdfs:comment \"Inverse of assignedRole.\" ;\n    owl:inverseOf :assignedRole .\n\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"Assigns an Organization to an OrganizationRoleAssignment.\" ;\n    owl:inverseOf :isOrganizationAssignmentOf .\n\n:isOrganizationAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is organization assignment of\" ;\n    rdfs:comment \"Inverse of assignedOrganization.\" ;\n    owl:inverseOf :assignedOrganization .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an Organization to its Address(es).\" ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress.\" ;\n    owl:inverseOf :hasAddress .\n\n:hasGLN a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :GLNIdentifier ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Relates an Organization to its Global Location Number.\" ;\n    owl:inverseOf :isGLNOf .\n\n:isGLNOf a owl:ObjectProperty ;\n    rdfs:domain :GLNIdentifier ;\n    rdfs:range :Organization ;\n    rdfs:label \"is GLN of\" ;\n    rdfs:comment \"Inverse of hasGLN.\" ;\n    owl:inverseOf :hasGLN .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates the Invoice Detail section to its Line Items.\" ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" ;\n    owl:inverseOf :hasLineItem .\n\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Relates a Line Item to the Item it describes.\" ;\n    owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is described by line item\" ;\n    rdfs:comment \"Inverse of describesItem.\" ;\n    owl:inverseOf :describesItem .\n\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates a Line Item to its net price.\" ;\n    owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice.\" ;\n    owl:inverseOf :hasNetPrice .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Relates the Invoice Summary to the Tax information.\" ;\n    owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range :InvoiceSummary ;\n    rdfs:label \"is tax of\" ;\n    rdfs:comment \"Inverse of hasTax.\" ;\n    owl:inverseOf :hasTax .\n\n:assignedToBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to business process\" ;\n    rdfs:comment \"Relates an Invoice to the Business Process it is part of.\" ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Inverse of assignedToBusinessProcess.\" ;\n    owl:inverseOf :assignedToBusinessProcess .\n\n:alignsWithEN16931 a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :EN16931Alignment ;\n    rdfs:label \"aligns with EN16931\" ;\n    rdfs:comment \"Relates an Invoice to its EN 16931 alignment anchor.\" ;\n    owl:inverseOf :isEN16931AlignmentOf .\n\n:isEN16931AlignmentOf a owl:ObjectProperty ;\n    rdfs:domain :EN16931Alignment ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is EN16931 alignment of\" ;\n    rdfs:comment \"Inverse of alignsWithEN16931.\" ;\n    owl:inverseOf :alignsWithEN16931 .\n\n:alignsWithP2PO a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :P2POCoreClass ;\n    rdfs:label \"aligns with P2P-O\" ;\n    rdfs:comment \"Relates an Invoice to its P2P-O alignment anchor.\" ;\n    owl:inverseOf :isP2POAlignmentOf .\n\n:isP2POAlignmentOf a owl:ObjectProperty ;\n    rdfs:domain :P2POCoreClass ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is P2P-O alignment of\" ;\n    rdfs:comment \"Inverse of alignsWithP2PO.\" ;\n    owl:inverseOf :alignsWithP2PO .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number as shown in the document.\" .\n\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The date of the invoice document (string, for OWL 2 DL compliance).\" .\n\n#################################################################\n# HIERARCHY & DISJOINTNESS\n#################################################################\n:Organization owl:disjointWith :Item, :Invoice .\n:Segment owl:disjointWith :CompositeDataElement .\n:AgentRole owl:disjointWith :Address .\n:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\n\n#################################################################\n# RESTRICTIONS & GCAs\n#################################################################\n:OrganizationRoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      [ a owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Organization ]\n      [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ]\n    )\n] .\n\n:Invoice owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :OrganizationRoleAssignment ]\n      [ a owl:Restriction ; owl:onProperty :assignedToBusinessProcess ; owl:someValuesFrom :BusinessProcess ]\n    )\n] .\n\n#################################################################\n# CONNECTING VALIDATIONCONSTRAINT\n#################################################################\n:Invoice rdfs:seeAlso :ValidationConstraint .\n:ValidationConstraint rdfs:seeAlso :Invoice .\n\n#################################################################\n# ANNOTATIONS\n#################################################################\n# All classes and properties have rdfs:label and rdfs:comment as required.\n"
}
