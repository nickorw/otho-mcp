nt.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An itemized entry in the invoice, representing a product or service sold.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service referenced in a line item.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A monetary value associated with an item or line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax amount or rate applied to the invoice or line items.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice may be assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint or rule for automated validation of the invoice, e.g., via SHACL.\" .\n\n:EN16931_Alignment a owl:Class ;\n    rdfs:label \"EN 16931 Alignment\" ;\n    rdfs:comment \"Alignment anchor to the European Standard EN 16931-1 for electronic invoicing.\" .\n\n:P2PO_CoreClass a owl:Class ;\n    rdfs:label \"P2P-O Core Class\" ;\n    rdfs:comment \"Alignment anchor to the Purchase-to-Pay Ontology (P2P-O) core classes.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for reifying the assignment of a role to an organization within a specific invoice context.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an Interchange Envelope to the Message(s) it contains.\" .\n\n:hasSegment a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdf