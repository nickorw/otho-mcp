      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/storyid> a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Deep Ontology\" ;\n    rdfs:comment \"A deeply structured ontology for UN/EDIFACT INVOIC messages, supporting D96A/EANCOM, EN 16931-1, and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope containing one or more messages as per EDIFACT structure.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message container.\" .\n\n:INVOICMessage a owl:Class ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"Specific message type for invoices in EDIFACT.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element in a segment, grouping simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple, atomic data element in a composite element.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"A business invoice as represented in an INVOIC message.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice, containing dates and references.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice, listing line items.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice, providing totals.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An individual line item in the invoice.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A business entity involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Supplier).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Physical or logical address of an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"Generic identifier for organizations or documents.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"GLN as a specific identifier for organizations.\" ;\n    rdfs:subClassOf :Identifier .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A process to which an invoice may be assigned.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Price details for a line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information in an invoice summary.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Reference number for documents or transactions.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item or product sold in an invoice.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Reified relation assigning a role to an organization in the context of an invoice.\" .\n\n#################################################################\n# Object Properties and Inverses\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message(s).\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage: Message is contained in an InterchangeEnvelope.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a Segment to its Composite Data Elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a Composite Data Element to its Simple Data Elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :hasSimpleElement .\n\n:representsInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"represents invoice\" ;\n    rdfs:comment \"Links an INVOICMessage to the Invoice it describes.\" ;\n    rdfs:domain :INVOICMessage ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :isRepresentedByMessage .\n\n:isRepresentedByMessage a owl:ObjectProperty ;\n    rdfs:label \"is represented by message\" ;\n    rdfs:comment \"Inverse of representsInvoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :INVOICMessage ;\n    owl:inverseOf :representsInvoice .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an Invoice to its Header section.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n    rdfs:label \"is header of\" ;\n    rdfs:comment \"Inverse of hasHeader.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasHeader .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links an Invoice to its Detail section.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n    rdfs:label \"is detail of\" ;\n    rdfs:comment \"Inverse of hasDetail.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasDetail .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links an Invoice to its Summary section.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n    rdfs:label \"is summary of\" ;\n    rdfs:comment \"Inverse of hasSummary.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :hasSummary .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links an InvoiceDetail to its LineItems.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :hasLineItem .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an Invoice to an OrganizationRoleAssignment (pivot for reified roles).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Inverse of involvesOrganization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links an OrganizationRoleAssignment to an AgentRole.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:label \"is role of assignment\" ;\n    rdfs:comment \"Inverse of hasRole.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :hasRole .\n\n:isRoleOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is role of\" ;\n    rdfs:comment \"Links an OrganizationRoleAssignment to an Organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Inverse of isRoleOf.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :isRoleOf .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an Organization to its Identifier(s).\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasIdentifier .\n\n:hasGlobalLocationNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has Global Location Number\" ;\n    rdfs:comment \"Links an Organization to its GLN.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber ;\n    owl:inverseOf :isGlobalLocationNumberOf .\n\n:isGlobalLocationNumberOf a owl:ObjectProperty ;\n    rdfs:label \"is Global Location Number of\" ;\n    rdfs:comment \"Inverse of hasGlobalLocationNumber.\" ;\n    rdfs:domain :GlobalLocationNumber ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasGlobalLocationNumber .\n\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a LineItem to the Item being sold.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:inverseOf :isItemOf .\n\n:isItemOf a owl:ObjectProperty ;\n    rdfs:label \"is item of\" ;\n    rdfs:comment \"Inverse of hasItem.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasItem .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a LineItem to its Price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isPriceOf .\n\n:isPriceOf a owl:ObjectProperty ;\n    rdfs:label \"is price of\" ;\n    rdfs:comment \"Inverse of hasPrice.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasPrice .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links an InvoiceSummary to its Tax information.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax ;\n    owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n    rdfs:label \"is tax of\" ;\n    rdfs:comment \"Inverse of hasTax.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :hasTax .\n\n:assignedToProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Links an Invoice to a BusinessProcess.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isProcessAssignmentFor .\n\n:isProcessAssignmentFor a owl:ObjectProperty ;\n    rdfs:label \"is process assignment for\" ;\n    rdfs:comment \"Inverse of assignedToProcess.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :Invoice ;\n    owl:inverseOf :assignedToProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n:documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"document date\" ;\n    rdfs:comment \"The date the document was issued (as string for OWL2 DL compliance).\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"reference number\" ;\n    rdfs:comment \"A reference number for the document.\" ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range xsd:string .\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The official invoice number.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:netPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"Net price for a line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:quantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"Quantity of items in a line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"Total tax amount in the invoice summary.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal .\n\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"Total invoice amount in the summary.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:addressLine a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"Address line(s) of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:organizationName a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"Name of the organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n#################################################################\n# Class Hierarchies and Disjointness\n#################################################################\n:Segment owl:disjointWith :CompositeDataElement .\n:Organization owl:disjointWith :Address .\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n\n#################################################################\n# Complex Axioms\n#################################################################\n:INVOICMessage owl:equivalentClass [ a owl:Class ; owl:Restriction [ owl:onProperty :representsInvoice ; owl:allValuesFrom :Invoice ] ] .\n:OrganizationRoleAssignment owl:equivalentClass [ a owl:Class ; owl:Restriction [ owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ] ] .\n"
}
