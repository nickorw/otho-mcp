2026-01-10 17:23:27 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology for representing music production, band membership, albums, tracks, performances, and related entities.\" .\n\n### Classes\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual, such as a musician or critic.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A group of musicians performing together.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A musical or organizational role in a band (e.g., vocalist, guitarist).\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A collection of tracks released as a record.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"An individual track or recording on an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition that may be recorded as a track.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews or critiques music albums.\" ;\n    rdfs:subClassOf :Person .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live performance event by a band or artist.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes for reification\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A reified relation representing a person's membership in a band with a role and time interval.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A reified event representing the recording of an album with start and end dates.\" .\n\n:TrackSongMapping a owl:Class ;\n    rdfs:label \"Track-Song Mapping\" ;\n    rdfs:comment \"A reified relation mapping a track to the song it records.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reified relation linking a performance to the songs played.\" .\n\n### Object Properties\n:playsInstrument a owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Relates a band to a BandMembership instance.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership .\n\n:memberPerson a owl:ObjectProperty ;\n    rdfs:label \"member person\" ;\n    rdfs:comment \"Relates a BandMembership to the Person member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person ;\n    owl:FunctionalProperty .\n\n:memberRole a owl:ObjectProperty ;\n    rdfs:label \"member role\" ;\n    rdfs:comment \"Relates a BandMembership to the Role played by the member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role .\n\n:membershipStart a owl:DatatypeProperty ;\n    rdfs:label \"membership start\" ;\n    rdfs:comment \"The start date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:date .\n\n:membershipEnd a owl:DatatypeProperty ;\n    rdfs:label \"membership end\" ;\n    rdfs:comment \"The end date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:date .\n\n:memberOfBand a owl:ObjectProperty ;\n    rdfs:label \"member of band\" ;\n    rdfs:comment \"Relates a BandMembership to the Band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:FunctionalProperty .\n\n:recordedAlbum a owl:ObjectProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"Relates an AlbumRecording to the Album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album ;\n    owl:FunctionalProperty .\n\n:recordingStart a owl:DatatypeProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"The start date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:date .\n\n:recordingEnd a owl:DatatypeProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"The end date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:date .\n\n:albumHasTrack a owl:ObjectProperty ;\n    rdfs:label \"album has track\" ;\n    rdfs:comment \"Relates an album to its tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track .\n\n:trackSongMapping a owl:ObjectProperty ;\n    rdfs:label \"track song mapping\" ;\n    rdfs:comment \"Relates a TrackSongMapping to the Song.\" ;\n    rdfs:domain :TrackSongMapping ;\n    rdfs:range :Song ;\n    owl:FunctionalProperty .\n\n:trackOfAlbum a owl:ObjectProperty ;\n    rdfs:label \"track of album\" ;\n    rdfs:comment \"Relates a Track to the Album it is part of.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album ;\n    owl:FunctionalProperty .\n\n:composedOn a owl:DatatypeProperty ;\n    rdfs:label \"composed on\" ;\n    rdfs:comment \"The date a song was composed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:date .\n\n:hasCriticReview a owl:ObjectProperty ;\n    rdfs:label \"has critic review\" ;\n    rdfs:comment \"Relates an album to a critic who reviewed it.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critic .\n\n:reviewText a owl:Datatype