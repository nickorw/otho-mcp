\"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes for reification\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A reified relation representing a person's membership in a band with a role and time interval.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A reified event representing the recording of an album with start and end dates.\" .\n\n:TrackSongMapping a owl:Class ;\n    rdfs:label \"Track-Song Mapping\" ;\n    rdfs:comment \"A reified relation mapping a track to the song it records.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reified relation linking a performance to the songs played.\" .\n\n### Object Properties\n:playsInstrument a owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Relates a band to a BandMembership instance.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership .\n\n:memberPerson a owl:ObjectProperty ;\n    rdfs:label \"member person\" ;\n    rdfs:comment \"Relates a BandMembership to the Person member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person .\n:memberPerson a owl:FunctionalProperty .\n\n:memberRole a owl:ObjectProperty ;\n    rdfs:label \"member role\" ;\n    rdfs:comment \"Relates a BandMembership to the Role played by the member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role .\n\n:membershipStart a owl:DatatypeProperty ;\n    rdfs:label \"membership start\" ;\n    rdfs:comment \"The start date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:date .\n\n:membershipEnd a owl:DatatypeProperty ;\n    rdfs:label \"membership end\" ;\n    rdfs:comment \"The end date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:date .\n\n:memberOfBand a owl:ObjectProperty ;\n    rdfs:label \"member of band\" ;\n    rdfs:comment \"Relates a BandMembership to the Band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band .\n:memberOfBand a owl:FunctionalProperty .\n\n:recordedAlbum a owl:ObjectProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"Relates an AlbumRecording to the Album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album .\n:recordedAlbum a owl:FunctionalProperty .\n\n:recordingStart a owl:DatatypeProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"The start date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:date .\n\n:recordingEnd a owl:DatatypeProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"The end date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:date .\n\n:albumHasTrack a owl:ObjectProperty ;\n    rdfs:label \"album has track\" ;\n    rdfs:comment \"Relates an album to its tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track .\n\n:trackSongMapping a owl:ObjectProperty ;\n    rdfs:label \"track song mapping\" ;\n    rdfs:comment \"Relates a TrackSongMapping to the Song.\" ;\n    rdfs:domain :TrackSongMapping ;\n    rdfs:range :Song .\n:trackSongMapping a owl:FunctionalProperty .\n\n:trackOfAlbum a owl:ObjectProperty ;\n    rdfs:label \"track of album\" ;\n    rdfs:comment \"Relates a Track to the Album it is part of.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album .\n:trackOfAlbum a owl:FunctionalProperty .\n\n:composedOn a owl:DatatypeProperty ;\n    rdfs:label \"composed on\" ;\n    rdfs:comment \"The date a song was composed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:date .\n\n:hasCriticReview a owl:ObjectProperty ;\n    rdfs:label \"has critic review\" ;\n    rdfs:comment \"Relates an album to a critic who reviewed it.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critic .\n\n:reviewText a owl:DatatypeProperty ;\n    rdfs:label \"review text\" ;\n    rdfs:comment \"The text of a critic's review.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range xsd:string .\n\n:performedAt a owl:ObjectProperty ;\n    rdfs:label \"performed at\" ;\n    rdfs:comment \"Relates a performance to the city where it occurred.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City .\n:performedAt a owl:FunctionalProperty .\n\n:performanceDate a owl:DatatypeProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"The date of a performance.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:date .\n\n:performanceSong a owl:ObjectProperty ;\n    rdfs:label \"performance song\" ;\n    rdfs:comment \"Relates a PerformanceSong to a Song.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song .\n:performanceSong a owl:FunctionalProperty .\n\n:performanceOf a owl:ObjectProperty ;\n    rdfs:label \"performance of\" ;\n    rdfs:comment \"Relates a PerformanceSong to a Performance.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance .\n:performanceOf a owl:FunctionalProperty .\n\n:cityInRegion a owl:ObjectProperty ;\n    rdfs:label \"city in region\" ;\n    rdfs:comment \"Relates a city to its region.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region .\n:cityInRegion a owl:FunctionalProperty .\n\n:regionInCountry a owl:ObjectProperty ;\n    rdfs:label \"region in country\" ;\n    rdfs:comment \"Relates a region to its country.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country .\n:regionInCountry a owl:FunctionalProperty .\n\n:albumReleaseDate a owl:DatatypeProperty ;\n    rdfs:label \"album release date\" ;\n    rdfs:comment \"The release date of an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:date .\n\n:trackNumber a owl:DatatypeProperty ;\n    rdfs:label \"track number\" ;\n    rdfs:comment \"The number of a track on an album.\" ;\n    rdfs:domain :Track ;\n    rdfs:range xsd:integer .\n\n:albumTrackCount a owl:DatatypeProperty ;\n    rdfs:label \"album track count\" ;\n    rdfs:comment \"The number of tracks on an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:integer .\n:albumTrackCount a owl:FunctionalProperty .\n\n### Restrictions and Axioms\n# Album must have at least one track\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumHasTrack ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumTrackCount ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ] .\n\n# Disjointness axioms\n:Person owl:disjointWith :Band .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Song .\n:Track owl:disjointWith :Song .\n:Critic owl:disjointWith :Performance .\n:Performance owl:disjointWith :Album .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n"
}
