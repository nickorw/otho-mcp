      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology for representing music production, band membership, albums, tracks, performances, and related entities.\" .\n\n### Classes\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual, such as a musician or critic.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A group of musicians performing together.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A musical or organizational role in a band (e.g., vocalist, guitarist).\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A collection of tracks released as a record.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"An individual track or recording on an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition that may be recorded as a track.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews or critiques music albums.\" ;\n    rdfs:subClassOf :Person .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live performance event by a band or artist.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes for reification\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A reified relation representing a person's membership in a band with a role and time interval.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A reified event representing the recording of an album with start and end dates.\" .\n\n:TrackSongMapping a owl:Class ;\n    rdfs:label \"Track-Song Mapping\" ;\n    rdfs:comment \"A reified relation mapping a track to the song it records.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reified relation linking a performance to the songs played.\" .\n\n### Object Properties and Inverses\n:playsInstrument a owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:inverseOf :playedBy .\n:playedBy a owl:ObjectProperty ;\n    rdfs:label \"played by\" ;\n    rdfs:comment \"Relates an instrument to the person who plays it.\" ;\n    rdfs:domain :Instrument ;\n    rdfs:range :Person ;\n    owl:inverseOf :playsInstrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Relates a band to a BandMembership instance.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :membershipOf .\n:membershipOf a owl:ObjectProperty ;\n    rdfs:label \"membership of\" ;\n    rdfs:comment \"Relates a BandMembership to the Band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:inverseOf :hasMember .\n\n:memberPerson a owl:ObjectProperty ;\n    rdfs:label \"member person\" ;\n    rdfs:comment \"Relates a BandMembership to the Person member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person ;\n    owl:inverseOf :personMembership .\n:memberPerson a owl:FunctionalProperty .\n:personMembership a owl:ObjectProperty ;\n    rdfs:label \"person membership\" ;\n    rdfs:comment \"Relates a Person to their BandMembership.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :memberPerson .\n\n:memberRole a owl:ObjectProperty ;\n    rdfs:label \"member role\" ;\n    rdfs:comment \"Relates a BandMembership to the Role played by the member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role ;\n    owl:inverseOf :roleInMembership .\n:roleInMembership a owl:ObjectProperty ;\n    rdfs:label \"role in membership\" ;\n    rdfs:comment \"Relates a Role to BandMemberships in which it is played.\" ;\n    rdfs:domain :Role ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :memberRole .\n\n:recordedAlbum a owl:ObjectProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"Relates an AlbumRecording to the Album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album ;\n    owl:inverseOf :albumRecording .\n:recordedAlbum a owl:FunctionalProperty .\n:albumRecording a owl:ObjectProperty ;\n    rdfs:label \"album recording\" ;\n    rdfs:comment \"Relates an Album to its AlbumRecording.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :recordedAlbum .\n\n:albumHasTrack a owl:ObjectProperty ;\n    rdfs:label \"album has track\" ;\n    rdfs:comment \"Relates an album to its tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track ;\n    owl:inverseOf :trackOfAlbum .\n:trackOfAlbum a owl:ObjectProperty ;\n    rdfs:label \"track of album\" ;\n    rdfs:comment \"Relates a Track to the Album it is part of.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album ;\n    owl:inverseOf :albumHasTrack .\n:trackOfAlbum a owl:FunctionalProperty .\n\n:trackSongMapping a owl:ObjectProperty ;\n    rdfs:label \"track song mapping\" ;\n    rdfs:comment \"Relates a TrackSongMapping to the Song.\" ;\n    rdfs:domain :TrackSongMapping ;\n    rdfs:range :Song ;\n    owl:inverseOf :songTrackMapping .\n:trackSongMapping a owl:FunctionalProperty .\n:songTrackMapping a owl:ObjectProperty ;\n    rdfs:label \"song track mapping\" ;\n    rdfs:comment \"Relates a Song to its TrackSongMapping.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :TrackSongMapping ;\n    owl:inverseOf :trackSongMapping .\n\n:hasCriticReview a owl:ObjectProperty ;\n    rdfs:label \"has critic review\" ;\n    rdfs:comment \"Relates an album to a critic who reviewed it.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critic ;\n    owl:inverseOf :reviewedAlbum .\n:reviewedAlbum a owl:ObjectProperty ;\n    rdfs:label \"reviewed album\" ;\n    rdfs:comment \"Relates a Critic to the Album they reviewed.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :Album ;\n    owl:inverseOf :hasCriticReview .\n\n:performedAt a owl:ObjectProperty ;\n    rdfs:label \"performed at\" ;\n    rdfs:comment \"Relates a performance to the city where it occurred.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City ;\n    owl:inverseOf :cityPerformance .\n:performedAt a owl:FunctionalProperty .\n:cityPerformance a owl:ObjectProperty ;\n    rdfs:label \"city performance\" ;\n    rdfs:comment \"Relates a City to performances held in it.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Performance ;\n    owl:inverseOf :performedAt .\n\n:performanceSong a owl:ObjectProperty ;\n    rdfs:label \"performance song\" ;\n    rdfs:comment \"Relates a PerformanceSong to a Song.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song ;\n    owl:inverseOf :songPerformance .\n:performanceSong a owl:FunctionalProperty .\n:songPerformance a owl:ObjectProperty ;\n    rdfs:label \"song performance\" ;\n    rdfs:comment \"Relates a Song to PerformanceSong in which it is played.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performanceSong .\n\n:performanceOf a owl:ObjectProperty ;\n    rdfs:label \"performance of\" ;\n    rdfs:comment \"Relates a PerformanceSong to a Performance.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance ;\n    owl:inverseOf :hasPerformanceSong .\n:performanceOf a owl:FunctionalProperty .\n:hasPerformanceSong a owl:ObjectProperty ;\n    rdfs:label \"has performance song\" ;\n    rdfs:comment \"Relates a Performance to its PerformanceSong instances.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performanceOf .\n\n:cityInRegion a owl:ObjectProperty ;\n    rdfs:label \"city in region\" ;\n    rdfs:comment \"Relates a city to its region.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region ;\n    owl:inverseOf :regionHasCity .\n:cityInRegion a owl:FunctionalProperty .\n:regionHasCity a owl:ObjectProperty ;\n    rdfs:label \"region has city\" ;\n    rdfs:comment \"Relates a Region to its Cities.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :City ;\n    owl:inverseOf :cityInRegion .\n\n:regionInCountry a owl:ObjectProperty ;\n    rdfs:label \"region in country\" ;\n    rdfs:comment \"Relates a region to its country.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country ;\n    owl:inverseOf :countryHasRegion .\n:regionInCountry a owl:FunctionalProperty .\n:countryHasRegion a owl:ObjectProperty ;\n    rdfs:label \"country has region\" ;\n    rdfs:comment \"Relates a Country to its Regions.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :Region ;\n    owl:inverseOf :regionInCountry .\n\n### Data Properties\n:membershipStart a owl:DatatypeProperty ;\n    rdfs:label \"membership start\" ;\n    rdfs:comment \"The start date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:date .\n\n:membershipEnd a owl:DatatypeProperty ;\n    rdfs:label \"membership end\" ;\n    rdfs:comment \"The end date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:date .\n\n:recordingStart a owl:DatatypeProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"The start date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:date .\n\n:recordingEnd a owl:DatatypeProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"The end date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:date .\n\n:composedOn a owl:DatatypeProperty ;\n    rdfs:label \"composed on\" ;\n    rdfs:comment \"The date a song was composed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:date .\n\n:reviewText a owl:DatatypeProperty ;\n    rdfs:label \"review text\" ;\n    rdfs:comment \"The text of a critic's review.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range xsd:string .\n\n:albumReleaseDate a owl:DatatypeProperty ;\n    rdfs:label \"album release date\" ;\n    rdfs:comment \"The release date of an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:date .\n\n:trackNumber a owl:DatatypeProperty ;\n    rdfs:label \"track number\" ;\n    rdfs:comment \"The number of a track on an album.\" ;\n    rdfs:domain :Track ;\n    rdfs:range xsd:integer .\n\n:albumTrackCount a owl:DatatypeProperty ;\n    rdfs:label \"album track count\" ;\n    rdfs:comment \"The number of tracks on an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:integer .\n:albumTrackCount a owl:FunctionalProperty .\n\n### Restrictions and Axioms\n# Album must have at least one track\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumHasTrack ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :albumTrackCount ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ] .\n\n# Disjointness axioms\n:Person owl:disjointWith :Band .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Song .\n:Track owl:disjointWith :Song .\n:Critic owl:disjointWith :Performance .\n:Performance owl:disjointWith :Album .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n"
}
