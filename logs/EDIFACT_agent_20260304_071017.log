        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#UNEDIFACTInvoiceStory> a owl:Ontology ;\\n    rdfs:label \\\"UN/EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"An ontology for representing UN/EDIFACT invoice messages, their structure, and organizational roles, aligned with EN 16931-1 and P2P-O.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outer envelope of an EDIFACT message, containing one or more messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A message within an interchange envelope, such as INVOIC.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"A specific message representing an invoice transaction.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message, e.g., BGM, NAD.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in an invoice, such as buyer or delivery party.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in a transaction, such as Buyer or Delivery Party.\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"The reification class linking an organization, its role, and the invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or warehouse address associated with an organization.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:InvoiceHeaderSection a owl:Class ;\\n    rdfs:label \\\"Invoice Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an invoice, containing identification and dates.\\\" ;\\n    rdfs:subClassOf :Invoice .\\n\\n:InvoiceDetailSection a owl:Class ;\\n    rdfs:label \\\"Invoice Detail Section\\\" ;\\n    rdfs:comment \\\"The detail section of an invoice, listing line items.\\\" ;\\n    rdfs:subClassOf :Invoice .\\n\\n:InvoiceSummarySection a owl:Class ;\\n    rdfs:label \\\"Invoice Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section of an invoice, providing totals and taxes.\\\" ;\\n    rdfs:subClassOf :Invoice .\\n\\n:InvoiceItemLine a owl:Class ;\\n    rdfs:label \\\"Invoice Item Line\\\" ;\\n    rdfs:comment \\\"A reification class representing one line in the invoice detail section, linking an item, price, and quantity.\\\" ;\\n    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ] [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom xsd:decimal ] [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom xsd:integer ] [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ] ) ] .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value, such as a net or total amount.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax value applied in the invoice summary.\\\" .\\n\\n#################################################################\\n# Disjointness & DisjointUnion\\n#################################################################\\n\\n:InvoiceHeaderSection owl:disjointWith :InvoiceDetailSection, :InvoiceSummarySection .\\n:InvoiceDetailSection owl:disjointWith :InvoiceSummarySection .\\n:Organization owl:disjointWith :AgentRole .\\n:Item owl:disjointWith :Price .\\n\\n#################################################################\\n# Properties\\n#################################################################\\n\\n:hasMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Relates an interchange envelope to a message.\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message .\\n:hasMessage rdf:type owl:FunctionalProperty .\\n:messageInEnvelope a owl:ObjectProperty ;\\n    rdfs:label \\\"message in envelope\\\" ;\\n    rdfs:comment \\\"Inverse of hasMessage, relates a message to its envelope.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    owl:inverseOf :hasMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment .\\n:segmentOfMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"segment of message\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment, relates a segment to its parent message.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasCompositeDataElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite data element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n:compositeElementOfSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"composite element of segment\\\" ;\\n    rdfs:comment \\\"Inverse of hasCompositeDataElement, relates a composite data element to its segment.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :hasCompositeDataElement .\\n\\n:hasSimpleDataElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple data element\\\" ;\\n    rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n:simpleElementOfComposite a owl:ObjectProperty ;\\n    rdfs:label \\\"simple element of composite\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleDataElement, relates a simple data element to its composite.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :hasSimpleDataElement .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Links an invoice to an organization-role assignment (pivot class).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :OrganizationRoleAssignment .\\n:roleAssignmentForInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"role assignment for invoice\\\" ;\\n    rdfs:comment \\\"Inverse of hasRoleAssignment, relates a role assignment to its invoice.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:hasOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an organization.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization .\\n:hasOrganization rdf:type owl:FunctionalProperty .\\n:organizationRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"organization role assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasOrganization, relates an organization to its role assignments.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :hasOrganization .\\n\\n:hasAgentRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has agent role\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an agent role.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole .\\n:hasAgentRole rdf:type owl:FunctionalProperty .\\n:agentRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"agent role assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasAgentRole, relates an agent role to its role assignments.\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :hasAgentRole .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization to its address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n:hasAddress rdf:type owl:FunctionalProperty .\\n:addressOfOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"address of organization\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress, relates an address to its organization.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has Global Location Number\\\" ;\\n    rdfs:comment \\\"A GLN identifier for an organization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n:hasGlobalLocationNumber rdf:type owl:FunctionalProperty .\\n\\n:hasInvoiceSection a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice section\\\" ;\\n    rdfs:comment \\\"Links an invoice to its sections (header, detail, summary).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range owl:Thing .\\n:invoiceSectionOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"invoice section of invoice\\\" ;\\n    rdfs:comment \\\"Inverse of hasInvoiceSection, relates a section to its invoice.\\\" ;\\n    rdfs:domain owl:Thing ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :hasInvoiceSection .\\n\\n:hasItemLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has item line\\\" ;\\n    rdfs:comment \\\"Links a detail section to its invoice item lines.\\\" ;\\n    rdfs:domain :InvoiceDetailSection ;\\n    rdfs:range :InvoiceItemLine .\\n:itemLineOfDetailSection a owl:ObjectProperty ;\\n    rdfs:label \\\"item line of detail section\\\" ;\\n    rdfs:comment \\\"Inverse of hasItemLine, relates an item line to its detail section.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range :InvoiceDetailSection ;\\n    owl:inverseOf :hasItemLine .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links an invoice item line to an item.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range :Item .\\n:hasItem rdf:type owl:FunctionalProperty .\\n:itemOfInvoiceLine a owl:ObjectProperty ;\\n    rdfs:label \\\"item of invoice line\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem, relates an item to its invoice item lines.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceItemLine ;\\n    owl:inverseOf :hasItem .\\n\\n:hasPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links an invoice item line to its price.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range :Price .\\n:priceOfInvoiceLine a owl:ObjectProperty ;\\n    rdfs:label \\\"price of invoice line\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice, relates a price to its invoice item lines.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range :InvoiceItemLine ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasNetPrice a owl:DatatypeProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"The net price of an item in an invoice item line.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range xsd:decimal .\\n:hasNetPrice rdf:type owl:FunctionalProperty .\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of an item in an invoice item line.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range xsd:integer .\\n:hasQuantity rdf:type owl:FunctionalProperty .\\n\\n:hasTotalAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"has total amount\\\" ;\\n    rdfs:comment \\\"The total amount for the invoice in the summary section.\\\" ;\\n    rdfs:domain :InvoiceSummarySection ;\\n    rdfs:range xsd:decimal .\\n:hasTotalAmount rdf:type owl:FunctionalProperty .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the invoice summary section to its tax value(s).\\\" ;\\n    rdfs:domain :InvoiceSummarySection ;\\n    rdfs:range :Tax .\\n:taxOfSummarySection a owl:ObjectProperty ;\\n    rdfs:label \\\"tax of summary section\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax, relates a tax value to its summary section.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :InvoiceSummarySection ;\\n    owl:inverseOf :hasTax .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeaderSection ;\\n    rdfs:range xsd:string .\\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\\n\\n:hasDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"has date\\\" ;\\n    rdfs:comment \\\"The date of the invoice in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeaderSection ;\\n    rdfs:range xsd:dateTime .\\n:hasDate rdf:type owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"A reference number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeaderSection ;\\n    rdfs:range xsd:string .\\n:hasReferenceNumber rdf:type owl:FunctionalProperty .\\n\\n:assignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned to business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess .\\n:assignedToBusinessProcess rdf:type owl:FunctionalProperty .\\n:businessProcessOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"business process of invoice\\\" ;\\n    rdfs:comment \\\"Inverse of assignedToBusinessProcess, relates a business process to its invoices.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :assignedToBusinessProcess .\\n\\n#################################################################\\n# Complex Axioms\\n#################################################################\\n\\n:Invoice owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        :Message\\n        [ a owl:Restriction ; owl:onProperty :hasInvoiceSection ; owl:allValuesFrom [ a owl:Class ; owl:unionOf ( :InvoiceHeaderSection :InvoiceDetailSection :InvoiceSummarySection ) ] ]\\n    )\\n] .\\n\\n:OrganizationRoleAssignment rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasAgentRole ;\\n    owl:someValuesFrom :AgentRole\\n] .\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
    {
      "id": "call_3YyUwyMCffqV4J65bfnUU07p",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#UNEDIFACTInvoiceStory> a owl:Ontology ;\\n    rdfs:label \\\"UN/EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"An ontology for representing UN/EDIFACT invoice messages, their structure, and organizational roles, aligned with EN 16931-1 and P2P-O.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outer envelope of an EDIFACT message, containing one or more messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A message within an interchange envelope, such as INVOIC.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"A specific message representing an invoice transaction.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message, e.g., BGM, NAD.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in an invoice, such as buyer or delivery party.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in a transaction, such as Buyer or Delivery Party.\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"The reification class linking an organization, its role, and the invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or warehouse address associated with an organization.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:InvoiceHeaderSection a owl:Class ;\\n    rdfs:label \\\"Invoice Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an invoice, containing identification and dates.\\\" ;\\n    rdfs:subClassOf :Invoice .\\n\\n:InvoiceDetailSection a owl:Class ;\\n    rdfs:label \\\"Invoice Detail Section\\\" ;\\n    rdfs:comment \\\"The detail section of an invoice, listing line items.\\\" ;\\n    rdfs:subClassOf :Invoice .\\n\\n:InvoiceSummarySection a owl:Class ;\\n    rdfs:label \\\"Invoice Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section of an invoice, providing totals and taxes.\\\" ;\\n    rdfs:subClassOf :Invoice .\\n\\n:InvoiceItemLine a owl:Class ;\\n    rdfs:label \\\"Invoice Item Line\\\" ;\\n    rdfs:comment \\\"A reification class representing one line in the invoice detail section, linking an item, price, and quantity.\\\" ;\\n    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ] [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom xsd:decimal ] [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom xsd:integer ] [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ] ) ] .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price value, such as a net or total amount.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax value applied in the invoice summary.\\\" .\\n\\n#################################################################\\n# Disjointness & DisjointUnion\\n#################################################################\\n\\n:InvoiceHeaderSection owl:disjointWith :InvoiceDetailSection, :InvoiceSummarySection .\\n:InvoiceDetailSection owl:disjointWith :InvoiceSummarySection .\\n:Organization owl:disjointWith :AgentRole .\\n:Item owl:disjointWith :Price .\\n\\n#################################################################\\n# Properties\\n#################################################################\\n\\n:hasMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Relates an interchange envelope to a message.\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message .\\n:hasMessage rdf:type owl:FunctionalProperty .\\n:messageInEnvelope a owl:ObjectProperty ;\\n    rdfs:label \\\"message in envelope\\\" ;\\n    rdfs:comment \\\"Inverse of hasMessage, relates a message to its envelope.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    owl:inverseOf :hasMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment .\\n:segmentOfMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"segment of message\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment, relates a segment to its parent message.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasCompositeDataElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite data element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n:compositeElementOfSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"composite element of segment\\\" ;\\n    rdfs:comment \\\"Inverse of hasCompositeDataElement, relates a composite data element to its segment.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :hasCompositeDataElement .\\n\\n:hasSimpleDataElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple data element\\\" ;\\n    rdfs:comment \\\"Relates a composite data element to its simple data elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\nsimpleElementOfComposite a owl:ObjectProperty ;\\n    rdfs:label \\\"simple element of composite\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleDataElement, relates a simple data element to its composite.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :hasSimpleDataElement .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Links an invoice to an organization-role assignment (pivot class).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :OrganizationRoleAssignment .\\n:roleAssignmentForInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"role assignment for invoice\\\" ;\\n    rdfs:comment \\\"Inverse of hasRoleAssignment, relates a role assignment to its invoice.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:hasOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an organization.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization .\\n:hasOrganization rdf:type owl:FunctionalProperty .\\n:organizationRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"organization role assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasOrganization, relates an organization to its role assignments.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :hasOrganization .\\n\\n:hasAgentRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has agent role\\\" ;\\n    rdfs:comment \\\"Links an organization-role assignment to an agent role.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole .\\n:hasAgentRole rdf:type owl:FunctionalProperty .\\n:agentRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"agent role assignment\\\" ;\\n    rdfs:comment \\\"Inverse of hasAgentRole, relates an agent role to its role assignments.\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :hasAgentRole .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization to its address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n:hasAddress rdf:type owl:FunctionalProperty .\\n:addressOfOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"address of organization\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress, relates an address to its organization.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has Global Location Number\\\" ;\\n    rdfs:comment \\\"A GLN identifier for an organization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n:hasGlobalLocationNumber rdf:type owl:FunctionalProperty .\\n\\n:hasInvoiceSection a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice section\\\" ;\\n    rdfs:comment \\\"Links an invoice to its sections (header, detail, summary).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range owl:Thing .\\n:invoiceSectionOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"invoice section of invoice\\\" ;\\n    rdfs:comment \\\"Inverse of hasInvoiceSection, relates a section to its invoice.\\\" ;\\n    rdfs:domain owl:Thing ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :hasInvoiceSection .\\n\\n:hasItemLine a owl:ObjectProperty ;\\n    rdfs:label \\\"has item line\\\" ;\\n    rdfs:comment \\\"Links a detail section to its invoice item lines.\\\" ;\\n    rdfs:domain :InvoiceDetailSection ;\\n    rdfs:range :InvoiceItemLine .\\n:itemLineOfDetailSection a owl:ObjectProperty ;\\n    rdfs:label \\\"item line of detail section\\\" ;\\n    rdfs:comment \\\"Inverse of hasItemLine, relates an item line to its detail section.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range :InvoiceDetailSection ;\\n    owl:inverseOf :hasItemLine .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links an invoice item line to an item.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range :Item .\\n:hasItem rdf:type owl:FunctionalProperty .\\n:itemOfInvoiceLine a owl:ObjectProperty ;\\n    rdfs:label \\\"item of invoice line\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem, relates an item to its invoice item lines.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceItemLine ;\\n    owl:inverseOf :hasItem .\\n\\n:hasPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links an invoice item line to its price.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range :Price .\\n:priceOfInvoiceLine a owl:ObjectProperty ;\\n    rdfs:label \\\"price of invoice line\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice, relates a price to its invoice item lines.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range :InvoiceItemLine ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasNetPrice a owl:DatatypeProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"The net price of an item in an invoice item line.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range xsd:decimal .\\n:hasNetPrice rdf:type owl:FunctionalProperty .\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of an item in an invoice item line.\\\" ;\\n    rdfs:domain :InvoiceItemLine ;\\n    rdfs:range xsd:integer .\\n:hasQuantity rdf:type owl:FunctionalProperty .\\n\\n:hasTotalAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"has total amount\\\" ;\\n    rdfs:comment \\\"The total amount for the invoice in the summary section.\\\" ;\\n    rdfs:domain :InvoiceSummarySection ;\\n    rdfs:range xsd:decimal .\\n:hasTotalAmount rdf:type owl:FunctionalProperty .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the invoice summary section to its tax value(s).\\\" ;\\n    rdfs:domain :InvoiceSummarySection ;\\n    rdfs:range :Tax .\\n:taxOfSummarySection a owl:ObjectProperty ;\\n    rdfs:label \\\"tax of summary section\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax, relates a tax value to its summary section.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :InvoiceSummarySection ;\\n    owl:inverseOf :hasTax .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeaderSection ;\\n    rdfs:range xsd:string .\\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\\n\\n:hasDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"has date\\\" ;\\n    rdfs:comment \\\"The date of the invoice in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeaderSection ;\\n    rdfs:range xsd:dateTime .\\n:hasDate rdf:type owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"A reference number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeaderSection ;\\n    rdfs:range xsd:string .\\n:hasReferenceNumber rdf:type owl:FunctionalProperty .\\n\\n:assignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned to business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess .\\n:assignedToBusinessProcess rdf:type owl:FunctionalProperty .\\nbusinessProcessOfInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"business process of invoice\\\" ;\\n    rdfs:comment \\\"Inverse of assignedToBusinessProcess, relates a business process to its invoices.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :Invoice ;\\n    owl:inverseOf :assignedToBusinessProcess .\\n\\n#################################################################\\n# Complex Axioms\\n#################################################################\\n\\n:Invoice owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        :Message\\n        [ a owl:Restriction ; owl:onProperty :hasInvoiceSection ; owl:allValuesFrom [ a owl:Class ; owl:unionOf ( :InvoiceHeaderSection :InvoiceDetailSection :InvoiceSummarySection ) ] ]\\n    )\\n] .\\n\\n:OrganizationRoleAssignment rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasAgentRole ;\\n    owl:someValuesFrom :AgentRole\\n] .\\n\"}",
