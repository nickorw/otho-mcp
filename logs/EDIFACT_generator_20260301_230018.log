      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoiceStory>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for modeling UN/EDIFACT invoice messages, organizations, roles, and procurement scenarios as described in the provided story.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A digital business document, such as an invoice, in the EDIFACT standard.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A message representing an invoice, compliant with UN/EDIFACT and EN 16931-1.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A section of a message, such as header, detail, or summary.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header segment with document dates and reference numbers.\" ;\n    rdfs:subClassOf :Segment .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail segment listing line items.\" ;\n    rdfs:subClassOf :Segment .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary segment with totals and tax amounts.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite grouping of data elements within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A basic data element within a composite.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A company or party involved in the invoice process.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role, such as Buyer or Delivery Party, played by an organization.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Reified assignment of an organization to a role within an invoice context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in the invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A single line in the invoice detail, describing an item, quantity, and price.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with a line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A unique identifier, such as a Global Location Number.\" .\n\n#################################################################\n# Disjointness and DisjointUnion\n#################################################################\n\n:Organization owl:disjointWith :AgentRole, :Address, :Item .\n:Message owl:disjointWith :Segment .\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n:Segment owl:disjointUnionOf (:InvoiceHeader :InvoiceDetail :InvoiceSummary) .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an Interchange Envelope to its contained messages.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope .\n\n:containsSegment a owl:ObjectProperty ;\n    rdfs:label \"contains segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:isContainedInMessage a owl:ObjectProperty ;\n    rdfs:label \"is contained in message\" ;\n    rdfs:comment \"Inverse of containsSegment.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to an organization-role assignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:involvesOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links a role assignment to the involved organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a role assignment to the agent role.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its addresses.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifiers.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links an invoice detail to its line items.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem .\n\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a line item to the item it describes.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item .\n\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a line item to its net price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n\n:partOfBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"part of business process\" ;\n    rdfs:comment \"Links an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:documentDate a owl:DatatypeProperty ;\n    rdfs:label \"document date\" ;\n    rdfs:comment \"Date of the invoice document.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:dateTime .\n\n:referenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"reference number\" ;\n    rdfs:comment \"Reference number for the invoice document.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:invoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"Invoice number assigned to the document.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:organizationName a owl:DatatypeProperty ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"The name of the organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line of the postal address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of the identifier, e.g., Global Location Number.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"Description of the item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:quantity a owl:DatatypeProperty ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"Quantity of the item in the line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:netAmount a owl:DatatypeProperty ;\n    rdfs:label \"net amount\" ;\n    rdfs:comment \"Net price amount for a line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:totalTaxAmount a owl:DatatypeProperty ;\n    rdfs:label \"total tax amount\" ;\n    rdfs:comment \"Total tax amount for the invoice.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:invoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"Total invoice amount including taxes.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :containsSegment ; owl:someValuesFrom :InvoiceHeader ],\n    [ a owl:Restriction ; owl:onProperty :containsSegment ; owl:someValuesFrom :InvoiceDetail ],\n    [ a owl:Restriction ; owl:onProperty :containsSegment ; owl:someValuesFrom :InvoiceSummary ] .\n\n:OrganizationRoleAssignment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:allValuesFrom :Organization ],\n    [ a owl:Restriction ; owl:onProperty :hasRole ; owl:allValuesFrom :AgentRole ] .\n"
