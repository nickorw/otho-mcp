      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#EDIFACT_Story_Ontology> a owl:Ontology ;\n    rdfs:label \"EDIFACT Story Ontology\" ;\n    rdfs:comment \"Ontology representing the structure and semantics of UN/EDIFACT invoice messages, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope containing one or more messages in an EDIFACT transmission.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business message contained within an Interchange Envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A message representing an invoice, such as EDIFACT INVOIC.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite data element.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice, such as a buyer or seller.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction, such as Buyer or Delivery Party.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with a line item in the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"The header section of an invoice, containing general information such as dates and reference numbers.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"The detail section of an invoice, containing line items.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"The summary section of an invoice, containing totals and taxes.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"An individual line item in the invoice detail section.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier for organizations or items, such as a Global Location Number.\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A pivot class representing the assignment of a role to an organization in a specific context (reification pattern).\" .\n\n#################################################################\n# Object Properties (with inverses)\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an Interchange Envelope to the Message(s) it contains.\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its Segments.\" ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its Composite Data Elements.\" ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a Composite Data Element to its Simple Data Elements.\" ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement.\" .\n\n:hasHeader a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Relates an Invoice Message to its header section.\" ;\n    owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is header of\" ;\n    rdfs:comment \"Inverse of hasHeader.\" .\n\n:hasDetail a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Relates an Invoice Message to its detail section.\" ;\n    owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is detail of\" ;\n    rdfs:comment \"Inverse of hasDetail.\" .\n\n:hasSummary a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummary ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Relates an Invoice Message to its summary section.\" ;\n    owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is summary of\" ;\n    rdfs:comment \"Inverse of hasSummary.\" .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates an Invoice Detail to its Line Items.\" ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Relates a Line Item to the Item it describes.\" ;\n    owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is described by line item\" ;\n    rdfs:comment \"Inverse of describesItem.\" .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates a Line Item to its net Price.\" ;\n    owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice.\" .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Relates an Invoice Message to a RoleAssignment (reification of organization-role-context).\" ;\n    owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is role assignment of\" ;\n    rdfs:comment \"Inverse of hasRoleAssignment.\" .\n\n:playedBy a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"played by\" ;\n    rdfs:comment \"Indicates the Organization playing a role in a RoleAssignment.\" ;\n    owl:inverseOf :playsRoleAssignment .\n\n:playsRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"plays role assignment\" ;\n    rdfs:comment \"Inverse of playedBy.\" .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Indicates the AgentRole assigned in a RoleAssignment.\" ;\n    owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"is role of assignment\" ;\n    rdfs:comment \"Inverse of hasRole.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an Organization to its Address(es).\" ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Relates an Organization to its Identifier(s).\" ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier.\" .\n\n:assignedToProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Assigns an Invoice Message to a Business Process.\" ;\n    owl:inverseOf :processHasInvoice .\n\n:processHasInvoice a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"process has invoice\" ;\n    rdfs:comment \"Inverse of assignedToProcess.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of an identifier (e.g., GLN).\" .\n\n:identifierType a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier type\" ;\n    rdfs:comment \"The type of identifier (e.g., GLN, VAT).\" .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line in the postal address.\" .\n\n:city a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city of the address.\" .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"The postal code of the address.\" .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"The country code of the address (ISO 3166-1 alpha-2).\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number.\" .\n\n:hasInvoiceDate a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"has invoice date\" ;\n    rdfs:comment \"The date of the invoice.\" .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"A reference number in the invoice header.\" .\n\n:totalTaxAmount a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"total tax amount\" ;\n    rdfs:comment \"The total tax amount in the invoice summary.\" .\n\n:totalInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"total invoice amount\" ;\n    rdfs:comment \"The total invoice amount in the invoice summary.\" .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of items in a line item.\" .\n\n#################################################################\n# Restrictions and Axioms\n#################################################################\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasRoleAssignment ;\n    owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :RoleAssignment\n] .\n:LineItem rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :describesItem ;\n    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :Item\n] .\n:RoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :playedBy ;\n    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :Organization\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasRole ;\n    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :AgentRole\n] .\n:Organization rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasIdentifier ;\n    owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :Identifier\n] .\n:Organization owl:disjointWith :Address, :Item, :Price, :InvoiceMessage .\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n"
}
