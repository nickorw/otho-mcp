2026-01-24 15:58:43 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology for modeling music production, band membership, performances, albums, tracks, and related entities.\" .\n\n### Classes\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human being involved in music production, performance, or critique.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A musical group consisting of one or more people.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A musical or organizational role a person can have in a band.\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A published collection of tracks.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A single audio recording on an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition that can be recorded as a track.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews or critiques music albums.\" .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live presentation of music by a band or artist.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances can take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A geographical region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes (for reification)\n\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A reified relation representing a person's membership in a band at a given time and role.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A reified relation representing the recording of an album, including time period.\" .\n\n:TrackSongRelation a owl:Class ;\n    rdfs:label \"Track-Song Relation\" ;\n    rdfs:comment \"A reified relation linking a track to the song it records.\" .\n\n:CriticReview a owl:Class ;\n    rdfs:label \"Critic Review\" ;\n    rdfs:comment \"A reified relation representing a critic's review of an album.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reified relation representing a specific song performed in a performance.\" .\n\n### Object Properties\n\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Relates a band to its membership events (BandMembership).\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership .\n\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"member person\" ;\n    rdfs:comment \"Relates a BandMembership to the Person who is a member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person .\n\n:memberRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"member role\" ;\n    rdfs:comment \"Relates a BandMembership to the Role a person has.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role .\n\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"Relates an AlbumRecording event to the Album recorded.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album .\n\n:hasTrack a owl:ObjectProperty ;\n    rdfs:label \"has track\" ;\n    rdfs:comment \"Relates an Album to its Tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track .\n\n:trackSong a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"track song\" ;\n    rdfs:comment \"Relates a TrackSongRelation to the Song it records.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Song .\n\n:trackInAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"track in album\" ;\n    rdfs:comment \"Relates a TrackSongRelation to the Track.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Track .\n\n:reviewedBy a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"reviewed by\" ;\n    rdfs:comment \"Relates a CriticReview to the Critic.\" ;\n    rdfs:domain :CriticReview ;\n    rdfs:range :Critic .\n\n:reviewedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"reviewed album\" ;\n    rdfs:comment \"Relates a CriticReview to the Album.\" ;\n    rdfs:domain :CriticReview ;\n    rdfs:range :Album .\n\n:performanceOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance of\" ;\n    rdfs:comment \"Relates a PerformanceSong to the Performance.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance .\n\n:performedSong a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performed song\" ;\n    rdfs:comment \"Relates a PerformanceSong to the Song performed.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song .\n\n:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance location\" ;\n    rdfs:comment \"Relates a Performance to the City where it takes place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City .\n\n:cityInRegion a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"city in region\" ;\n    rdfs:comment \"Relates a City to the Region it is located in.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region .\n\n:regionInCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"region in country\" ;\n    rdfs:comment \"Relates a Region to the Country it is located in.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country .\n\n### Data Properties\n\n:membershipTime a owl:DatatypeProperty ;\n    rdfs:label \"membership time\" ;\n    rdfs:comment \"The time period of a BandMembership (e.g., as a string or interval).\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:string .\n\n:recordingStart a owl:DatatypeProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"The start date of an AlbumRecording (as xsd:string for OWL2 compliance).\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:string .\n\n:recordingEnd a owl:DatatypeProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"The end date of an AlbumRecording (as xsd:string for OWL2 compliance).\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:string .\n\n:trackCount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"track count\" ;\n    rdfs:comment \"The number of tracks on an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:nonNegativeInteger .\n\n:releaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"release date\" ;\n    rdfs:comment \"The release date of an album (as xsd:string for OWL2 compliance).\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:string .\n\n:songComposedOn a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"song composed on\" ;\n    rdfs:comment \"The date a song was composed (as xsd:string for OWL2 compliance).\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:string .\n\n:reviewText a owl:DatatypeProperty ;\n    rdfs:label \"review text\" ;\n    rdfs:comment \"The text of a critic's review.\" ;\n    rdfs:domain :CriticReview ;\n    rdfs:range xsd:string .\n\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"The date of a performance (as xsd:string for OWL2 compliance).\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:string .\n\n### General Class Axioms and Restrictions\n\n:Album owl:equivalentClass [\n    a owl:Restriction ;\n    owl:onProperty :hasTrack ;\n    owl:someValuesFrom :Track\n] ;\n    rdfs:comment \"Every album has at least one track.\" .\n\n### Disjointness\n\n:Person owl:disjointWith :Band .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Song .\n:Performance owl:disjointWith :Critic .\n:City owl:disjointWith :Country .\n:Region owl:disjointWith :Country .\n"
}
