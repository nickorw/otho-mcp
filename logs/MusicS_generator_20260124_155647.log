ion a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A geographical region containing cities.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n# Pivot Classes (for reification)\\n\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A reified relation representing a person's membership in a band at a given time and role.\\\" .\\n\\n:AlbumRecording a owl:Class ;\\n    rdfs:label \\\"Album Recording\\\" ;\\n    rdfs:comment \\\"A reified relation representing the recording of an album, including time period.\\\" .\\n\\n:TrackSongRelation a owl:Class ;\\n    rdfs:label \\\"Track-Song Relation\\\" ;\\n    rdfs:comment \\\"A reified relation linking a track to the song it records.\\\" .\\n\\n:CriticReview a owl:Class ;\\n    rdfs:label \\\"Critic Review\\\" ;\\n    rdfs:comment \\\"A reified relation representing a critic's review of an album.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"A reified relation representing a specific song performed in a performance.\\\" .\\n\\n### Object Properties (with inverses)\\n\\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Relates a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :instrumentPlayedBy .\\n\\n:instrumentPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"instrument played by\\\" ;\\n    rdfs:comment \\\"Inverse: Relates an instrument to the person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Relates a band to its membership events (BandMembership).\\\" ;\\n    rdfs:domain :Band ;\\n 