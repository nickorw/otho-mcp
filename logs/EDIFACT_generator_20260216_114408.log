      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Ontology\" ;\n    rdfs:comment \"An OWL2-DL ontology for representing EDIFACT business documents, their structure, and semantics, including Invoice, Segments, Data Elements, Roles, and compliance requirements.\" .\n\n#################################################################\n# Section: Classes\n#################################################################\n\n:EdifactInterchange a owl:Class ;\n    rdfs:label \"EDIFACT Interchange\" ;\n    rdfs:comment \"The envelope for a set of EDIFACT messages, including delimiters and message references.\" .\n\n:EdifactMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A message within an EDIFACT Interchange, such as INVOIC.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :EdifactMessage ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A specific EDIFACT message representing an invoice (INVOIC).\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment in an EDIFACT message, e.g., BGM, NAD.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment, identifies the document type and number.\" .\n\n:NAD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment, identifies organizations and their roles.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Section of the invoice containing general document information such as dates and reference numbers.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Section containing line items for products or services.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Section summarizing totals, taxes, and overall amounts.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A data element composed of several simple elements, used in EDIFACT segments.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A basic data element (string, code, number) in EDIFACT.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A legal entity involved in the business process, such as buyer or seller.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role an organization plays in a transaction, e.g., Buyer, Seller, Delivery Party.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization or role.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A unique identifier for an organization location, such as a GLN.\" .\n\n:InvoiceLine a owl:Class ;\n    rdfs:label \"Invoice Line\" ;\n    rdfs:comment \"A single line item in the invoice, describing a product or service sold.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service referenced in an invoice line.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"The price associated with an invoice line or item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax amount applied to an invoice or line item.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference or document number, such as invoice number or order reference.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A process context to which the invoice or message is assigned.\" .\n\n:EN16931Compliance a owl:Class ;\n    rdfs:label \"EN 16931 Compliance\" ;\n    rdfs:comment \"Compliance with the European Standard EN 16931-1 for electronic invoicing.\" .\n\n:P2P_O_Alignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Alignment with the Purchase-to-Pay Ontology (P2P-O) for procurement semantics.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for automated validation, such as SHACL shapes.\" .\n\n:EDIFACTDelimiter a owl:Class ;\n    rdfs:label \"EDIFACT Delimiter\" ;\n    rdfs:comment \"A delimiter character used in EDIFACT messages (e.g., '+', ':', ''').\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A reified relationship assigning an AgentRole to an Organization within a message context.\" .\n\n:InvoiceLineItemRole a owl:Class ;\n    rdfs:label \"Invoice Line Item Role\" ;\n    rdfs:comment \"A pivot class for complex roles within invoice lines, e.g., supplier for a line item.\" .\n\n#################################################################\n# Section: Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n    rdfs:domain :EdifactInterchange ;\n    rdfs:range :EdifactMessage ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange to the messages it contains.\" ;\n    owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :EdifactMessage ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its constituent segments.\" .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range [ owl:unionOf (:HeaderSection :DetailSection :SummarySection) ] ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an invoice message to its sections (header, detail, summary).\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple elements.\" .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an invoice message to the organizations involved.\" .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to its organization-role assignments.\" .\n\n:assignedRole a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"The role assigned to an organization in a specific context.\" .\n\n:assignedOrganization a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"The organization receiving a specific role assignment.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" .\n\n:hasGlobalLocationNumber a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Links an organization to its Global Location Number (GLN).\" ;\n    owl:FunctionalProperty .\n\n:hasInvoiceLine a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :InvoiceLine ;\n    rdfs:label \"has invoice line\" ;\n    rdfs:comment \"Links the detail section to its invoice lines.\" .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links an invoice line to the item it describes.\" .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :InvoiceLineItemRole ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links an invoice line to its specific item role assignment.\" .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links an invoice line to its price.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links the summary section to taxes applied.\" .\n\n:hasReferenceNumber a owl:ObjectProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :ReferenceNumber ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Links the header section to reference numbers such as invoice number.\" .\n\n:partOfBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"part of business process\" ;\n    rdfs:comment \"Associates an invoice message with a business process context.\" .\n\n:alignedWithP2PO a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2P_O_Alignment ;\n    rdfs:label \"aligned with P2P-O\" ;\n    rdfs:comment \"Indicates alignment with the Purchase-to-Pay Ontology (P2P-O).\" .\n\n:compliesWithEN16931 a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931Compliance ;\n    rdfs:label \"complies with EN16931\" ;\n    rdfs:comment \"Indicates compliance with the EN 16931-1 standard.\" .\n\n:usesDelimiter a owl:ObjectProperty ;\n    rdfs:domain :EdifactInterchange ;\n    rdfs:range :EDIFACTDelimiter ;\n    rdfs:label \"uses delimiter\" ;\n    rdfs:comment \"Links an interchange to the delimiters it uses.\" .\n\n:validatedBy a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    rdfs:label \"validated by\" ;\n    rdfs:comment \"Indicates the validation constraints applied to an invoice message.\" .\n\n:hasInvoiceLineItemRole a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :InvoiceLineItemRole ;\n    rdfs:label \"has invoice line item role\" ;\n    rdfs:comment \"Links an invoice line to its item role assignment.\" .\n\n#################################################################\n# Section: Data Properties\n#################################################################\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number assigned to the invoice message.\" ;\n    owl:FunctionalProperty .\n\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of an item or invoice line.\" ;\n    owl:FunctionalProperty .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of items on an invoice line.\" .\n\n:hasTaxAmount a owl:DatatypeProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"The tax amount applied to a section or invoice.\" ;\n    owl:FunctionalProperty .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total invoice amount in the summary section.\" ;\n    owl:FunctionalProperty .\n\n:hasDate a owl:DatatypeProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"A date value in the header section (custom datatype for date representation).\" .\n\n:hasReferenceValue a owl:DatatypeProperty ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference value\" ;\n    rdfs:comment \"The value of the reference number.\" ;\n    owl:FunctionalProperty .\n\n:hasAddressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has address line\" ;\n    rdfs:comment \"A line of the postal address.\" .\n\n:hasPostalCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has postal code\" ;\n    rdfs:comment \"Postal code for the address.\" .\n\n:hasCity a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"City for the address.\" .\n\n:hasCountryCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has country code\" ;\n    rdfs:comment \"Country code for the address.\" .\n\n#################################################################\n# Section: Disjointness and Unions\n#################################################################\n\n:Organization owl:disjointWith :AgentRole , :Address .\n:Segment owl:disjointWith :Organization .\n:DetailSection owl:disjointWith :HeaderSection .\n:SummarySection owl:disjointWith :HeaderSection .\n:InvoiceLine owl:disjointWith :Item .\n:Price owl:disjointWith :Tax .\n\n:SectionUnion owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\n\n#################################################################\n# Section: Restrictions & Axioms\n#################################################################\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasSection ;\n    owl:allValuesFrom :SectionUnion\n] .\n\n:OrganizationRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :assignedOrganization ;\n    owl:someValuesFrom :Organization\n] , [\n    a owl:Restriction ;\n    owl:onProperty :assignedRole ;\n    owl:someValuesFrom :AgentRole\n] .\n\n:InvoiceLine rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :describesItem ;\n    owl:someValuesFrom :Item\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasPrice ;\n    owl:someValuesFrom :Price\n] .\n\n:Organization rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasAddress ;\n    owl:allValuesFrom :Address\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasGlobalLocationNumber ;\n    owl:allValuesFrom :GlobalLocationNumber\n] .\n\n#################################################################\n# Section: Annotations for Alignment and Compliance\n#################################################################\n\n:InvoiceMessage rdfs:seeAlso :EN16931Compliance , :P2P_O_Alignment .\n\n:EdifactInterchange rdfs:comment \"Delimiters and message references as per EDIFACT syntax rules.\" .\n\n#################################################################\n# Section: Individuals (Example)\n#################################################################\n\n:plusDelimiter a :EDIFACTDelimiter ;\n    rdfs:label \"Plus Delimiter\" ;\n    rdfs:comment \"The plus sign ('+') used as a segment delimiter in EDIFACT.\" .\n\n:colonDelimiter a :EDIFACTDelimiter ;\n    rdfs:label \"Colon Delimiter\" ;\n    rdfs:comment \"The colon (':') used as a composite element delimiter in EDIFACT.\" .\n\n:apostropheDelimiter a :EDIFACTDelimiter ;\n    rdfs:label \"Apostrophe Delimiter\" ;\n    rdfs:comment \"The apostrophe (''') used as a message delimiter in EDIFACT.\" .\n"
}
