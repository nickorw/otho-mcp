ce number value.\\\" ; rdfs:domain :ReferenceNumber ; rdfs:range xsd:string ; owl:FunctionalProperty true .\\n:documentDateValue rdf:type owl:DatatypeProperty ; rdfs:label \\\"document date value\\\" ; rdfs:comment \\\"Document date value.\\\" ; rdfs:domain :DocumentDate ; rdfs:range xsd:string ; owl:FunctionalProperty true .\\n\\n# Restrictions (example GCAs and equivalence)\\n:BuyerRole owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :assignsRole ; owl:allValuesFrom :BuyerRole ] .\\n:LineItem owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ] .\\n:InvoiceMessage owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :HeaderSection ] .\\n\\n# Annotations for SHACL/validation\\n:ValidationConstraint rdfs:seeAlso \\\"SHACL constraints for sum validation and mandatory identifiers.\\\" .\"}",
