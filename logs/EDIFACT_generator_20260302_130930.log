ssigned.\\\" .\\n:ValidationConstraint rdf:type owl:Class ; rdfs:label \\\"Validation Constraint\\\" ; rdfs:comment \\\"Constraint for validating the file format and business rules.\\\" .\\n:ReferenceNumber rdf:type owl:Class ; rdfs:label \\\"Reference Number\\\" ; rdfs:comment \\\"Reference number in the header section.\\\" .\\n:DocumentDate rdf:type owl:Class ; rdfs:label \\\"Document Date\\\" ; rdfs:comment \\\"Date of the invoice document.\\\" .\\n:TaxAmount rdf:type owl:Class ; rdfs:label \\\"Tax Amount\\\" ; rdfs:comment \\\"Total tax amount in the invoice.\\\" .\\n:LineItem rdf:type owl:Class ; rdfs:label \\\"Line Item\\\" ; rdfs:comment \\\"Individual line item in the invoice.\\\" ; rdfs:subClassOf :Item .\\n:Pivot_OrganizationRoleAssignment rdf:type owl:Class ; rdfs:label \\\"Organization Role Assignment\\\" ; rdfs:comment \\\"Reified relation assigning a role to an organization within an invoice context.\\\" .\\n\\n# Disjointness & DisjointUnion\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n:HeaderSection owl:disjointWith :DetailSection .\\n:HeaderSection owl:disjointWith :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:AgentRole owl:disjointUnionOf (:BuyerRole :DeliveryPartyRole) .\\n\\n# Object Properties\\n:containsMessage rdf:type owl:ObjectProperty ; rdfs:label \\\"contains message\\\" ; rdfs:comment \\\"Interchange envelope contains messages.\\\" ; rdfs:domain :InterchangeEnvelope ; rdfs:range :Message ; owl:TransitiveProperty true .\\n:hasSegment rdf:type owl:ObjectProperty ; rdfs:label \\\"has segment\\\" ; rdfs:comment \\\"Message has segments.\\\" ; rdfs:domain :Message ; rdfs:range :Segment ; owl:FunctionalProperty true .\\n:hasCompositeElement rdf:type owl:ObjectProperty ; rdfs:label \\\"has composite element\\\" ; rdfs:comment \\\"Segment has composite data elements.\\\" ; rdfs:domain :Segment ; rdfs:range :CompositeDataElement .\\n:hasSimpleElement rdf:type owl:ObjectProperty ; rdfs:label \\\"has simple element\\\" ; rdfs:comment \\\"Composite data element has simple data elements.\\\" ; rdfs:domain :CompositeDataElement ; rdfs:range :SimpleDataElement .\\n:hasSection rdf:type owl:ObjectProperty ; rdfs:label \\\"has section\\\" ; rdfs:comment \\\"Invoice message has header, detail, or summary section.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :HeaderSection, :DetailSection, :SummarySection .\\n:hasOrganizationRoleAssignment rdf:type owl:ObjectProperty ; rdfs:label \\\"has organization role assignment\\\" ; rdfs:comment \\\"Invoice message assigns organization roles via pivot class.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :Pivot_OrganizationRoleAssignment .\\n:assignsRole rdf:type owl:ObjectProperty ; rdfs:label \\\"assigns role\\\" ; rdfs:comment \\\"Role assignment assigns a role to an organization.\\\" ; rdfs:domain :Pivot_OrganizationRoleAssignment ; rdfs:range :AgentRole ; owl:FunctionalProperty true .\\n:assignsOrganization rdf:type owl:ObjectProperty ; rdfs:label \\\"assigns organization\\\" ; rdfs:comment \\\"Role assignment assigns an organization.\\\" ; rdfs:domain :Pivot_OrganizationRoleAssignment ; rdfs:range :Organization ; owl:FunctionalProperty true .\\n:hasAddress rdf:type owl:ObjectProperty ; rdfs:label \\\"has address\\\" ; rdfs:comment \\\"Organization has an address.\\\" ; rdfs:domain :Organization ; rdfs:range :Address ; owl:FunctionalProperty true .\\n:hasGlobalLocationNumber rdf:type owl:ObjectProperty ; rdfs:label \\\"has global location number\\\" ; rdfs:comment \\\"Organization has a GLN identifier.\\\" ; rdfs:domain :Organization ; rdfs:range :GlobalLocationNumber ; owl:FunctionalProperty true .\\n:hasLineItem rdf:type owl:ObjectProperty ; rdfs:label \\\"has line item\\\" ; rdfs:comment \\\"Detail section has line items.\\\" ; rdfs:domain :DetailSection ; rdfs:range :LineItem .\\n:hasPrice rdf:type owl:ObjectProperty ; rdfs:label \\\"has price\\\" ; rdfs:comment \\\"Line item has a net price.\\\" ; rdfs:domain :LineItem ; rdfs:range :Price ; owl:FunctionalProperty true .\\n:hasQuantity rdf:type owl:ObjectProperty ; rdfs:label \\\"has quantity\\\" ; rdfs:comment \\\"Line item has a quantity.\\\" ; rdfs:domain :LineItem ; rdfs:range :Quantity ; owl:FunctionalProperty true .\\n:hasInvoiceAmount rdf:type owl:ObjectProperty ; rdfs:label \\\"has invoice amount\\\" ; rdfs:comment \\\"Summary section has invoice amount.\\\" ; rdfs:domain :SummarySection ; rdfs:range :InvoiceAmount ; owl:FunctionalProperty true .\\n:hasTaxAmount rdf:type owl:ObjectProperty ; rdfs:label \\\"has tax amount\\\" ; rdfs:comment \\\"Summary section has tax amount.\\\" ; rdfs:domain :SummarySection ; rdfs:range :TaxAmount ; owl:FunctionalProperty true .\\n:hasReferenceNumber rdf:type owl:ObjectProperty ; rdfs:label \\\"has reference number\\\" ; rdfs:comment \\\"Header section has reference number.\\\" ; rdfs:domain :HeaderSection ; rdfs:range :ReferenceNumber ; owl:FunctionalProperty true .\\n:hasDocumentDate rdf:type owl:ObjectProperty ; rdfs:label \\\"has document date\\\" ; rdfs:comment \\\"Header section has document date.\\\" ; rdfs:domain :HeaderSection ; rdfs:range :DocumentDate ; owl:FunctionalProperty true .\\n:assignedToBusinessProcess rdf:type owl:ObjectProperty ; rdfs:label \\\"assigned to business process\\\" ; rdfs:comment \\\"Invoice message is assigned to a business process.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :BusinessProcess .\\n:validatedBy rdf:type owl:ObjectProperty ; rdfs:label \\\"validated by\\\" ; rdfs:comment \\\"Invoice message is validated by constraint.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :ValidationConstraint .\\n\\n# Data Properties\\n:addressLine rdf:type owl:DatatypeProperty ; rdfs:label \\\"address line\\\" ; rdfs:comment \\\"Address line of organization address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:postalCode rdf:type owl:DatatypeProperty ; rdfs:label \\\"postal code\\\" ; rdfs:comment \\\"Postal code of address.\\\" ; rdfs:domain :Address ; rdfs:range 