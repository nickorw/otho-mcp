2026-03-02 13:18:20 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoic-d96a>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT D96A INVOIC Ontology\" ;\n    rdfs:comment \"A profoundly structured ontology for the UN/EDIFACT D96A INVOIC message, supporting deep segment, composite, and business role modeling, aligned with EANCOM and EN 16931-1.\" .\n\n#################################################################\n# Classes: Segments, Composites, Core\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The UN/EDIFACT interchange envelope containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic UN/EDIFACT message container.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"INVOIC Message\" ;\n    rdfs:comment \"A D96A INVOIC message for global trade invoices.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A generic EDIFACT segment, the basic structural unit of a message.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message (BGM) segment identifying document type and number.\" .\n\n:NAD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment, identifying parties and their roles.\" .\n\n:MOA_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment, used for invoice totals and line amounts.\" .\n\n:DTM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment for document and transaction dates.\" .\n\n:LIN_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line Item segment, identifying invoice line and item codes.\" .\n\n:PIA_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PIA Segment\" ;\n    rdfs:comment \"Additional Product ID segment for alternative item identification.\" .\n\n:QTY_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment specifying item or document quantities.\" .\n\n:PRI_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PRI Segment\" ;\n    rdfs:comment \"Price segment for line item pricing details.\" .\n\n:TAX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax information segment for VAT and other taxes.\" .\n\n:RFF_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment for additional document references.\" .\n\n:ALC_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"ALC Segment\" ;\n    rdfs:comment \"Allowance/Charge segment for discounts, surcharges, etc.\" .\n\n:PAC_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PAC Segment\" ;\n    rdfs:comment \"Packaging segment for package details.\" .\n\n:UNS_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"UNS Segment\" ;\n    rdfs:comment \"Section control segment separating header, detail, and summary sections.\" .\n\n:CUX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"CUX Segment\" ;\n    rdfs:comment \"Currency segment for specifying invoice currency.\" .\n\n:TOD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TOD Segment\" ;\n    rdfs:comment \"Terms of Delivery segment for Incoterms and delivery conditions.\" .\n\n#################################################################\n# Composite Data Elements (D96A/EANCOM)\n#################################################################\n:C516_MonetaryAmount a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C516 Monetary Amount\" ;\n    rdfs:comment \"Composite for monetary amount details (qualifier, amount, currency).\" .\n\n:C507_DateTimePeriod a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C507 Date/Time/Period\" ;\n    rdfs:comment \"Composite for date/time period details (qualifier, value, format).\" .\n\n:C002_DocumentMessageName a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C002 Document/Message Name\" ;\n    rdfs:comment \"Composite for document/message type (code, code list, agency).\" .\n\n:C080PartyName a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C080 Party Name\" ;\n    rdfs:comment \"Composite for organization or party names.\" .\n\n:C082PartyIdentification a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C082 Party Identification\" ;\n    rdfs:comment \"Composite for party identification codes (GLN, etc.).\" .\n\n:C186QuantityDetails a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C186 Quantity Details\" ;\n    rdfs:comment \"Composite for quantity details (qualifier, value, unit).\" .\n\n:C212ItemNumberIdentification a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C212 Item Number Identification\" ;\n    rdfs:comment \"Composite for item identification (GTIN, supplier code, etc.).\" .\n\n:C243ChargeIdentification a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C243 Charge Identification\" ;\n    rdfs:comment \"Composite for charge identification details.\" .\n\n:C509TaxRateDetails a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C509 Tax Rate Details\" ;\n    rdfs:comment \"Composite for tax rate and category details.\" .\n\n:C504CurrencyDetails a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"C504 Currency Details\" ;\n    rdfs:comment \"Composite for currency code and qualifier details.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"An EDIFACT composite data element.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple atomic data element in EDIFACT.\" .\n\n#################################################################\n# Document Structure: Header, Detail, Summary, Line\n#################################################################\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice message, containing general document data.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice message, containing line items.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice message, containing totals and tax information.\" .\n\n:LineItem a owl:Class ;\n    rdfs:subClassOf :Item ;\n    rdfs:label \"Invoice Line Item\" ;\n    rdfs:comment \"A single line item in the invoice, referencing an item and its details.\" .\n\n#################################################################\n# Business Entities: Organizations, Roles, Addresses\n#################################################################\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A company, buyer, supplier, or other party involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A specific role (e.g., Buyer, Supplier, Delivery Party) played by an organization in a transaction.\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A pivot class for reifying the relation between an organization, its role, and the invoice context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier (e.g., GLN, VAT number) for organizations or items.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:subClassOf :Identifier ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A GS1 Global Location Number for unique party identification.\" .\n\n#################################################################\n# Item, Price, Process, Validation\n#################################################################\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A tradable good or service referenced in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value associated with an item or line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process (e.g., Purchase-to-Pay) to which the invoice is assigned.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validating business rules (e.g., SHACL shapes).\" .\n\n#################################################################\n# Object Properties (with inverses)\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to the contained Message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage; relates a Message to its InterchangeEnvelope.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its constituent Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment; relates a Segment to its Message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its CompositeDataElements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement; relates a CompositeDataElement to its Segment.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a CompositeDataElement to its SimpleDataElements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement; relates a SimpleDataElement to its CompositeDataElement.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its header section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n    rdfs:label \"is header of\" ;\n    rdfs:comment \"Inverse of hasHeader; relates an InvoiceHeader to its InvoiceMessage.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :InvoiceMessage .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its detail section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n    rdfs:label \"is detail of\" ;\n    rdfs:comment \"Inverse of hasDetail; relates an InvoiceDetail to its InvoiceMessage.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceMessage .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its summary section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n    rdfs:label \"is summary of\" ;\n    rdfs:comment \"Inverse of hasSummary; relates an InvoiceSummary to its InvoiceMessage.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :InvoiceMessage .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Relates an InvoiceMessage to an Organization involved in the transaction.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Inverse of involvesOrganization; relates an Organization to its InvoiceMessage.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage .\n\n:playsRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"plays role assignment\" ;\n    rdfs:comment \"Relates an Organization to a RoleAssignment (pivot class).\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is role assignment of\" ;\n    rdfs:comment \"Inverse of playsRole; relates a RoleAssignment to its Organization.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization .\n\n:forInvoice a owl:ObjectProperty ;\n    rdfs:label \"for invoice\" ;\n    rdfs:comment \"Relates a RoleAssignment to the InvoiceMessage context.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasRoleAssignment .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Inverse of forInvoice; relates an InvoiceMessage to its RoleAssignments.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Relates a RoleAssignment to the AgentRole played.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:label \"is role of assignment\" ;\n    rdfs:comment \"Inverse of hasRole; relates an AgentRole to its RoleAssignment.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an Organization to an Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress; relates an Address to its Organization.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization .\n\n:hasIdentifier a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Relates an Organization to an Identifier (GLN, VAT, etc.).\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier; relates an Identifier to its Organization.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates an InvoiceDetail section to its LineItems.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem; relates a LineItem to its InvoiceDetail.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail .\n\n:itemOf a owl:ObjectProperty ;\n    rdfs:label \"item of\" ;\n    rdfs:comment \"Relates a LineItem to the Item being referenced.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:inverseOf :hasLineItemRef .\n\n:hasLineItemRef a owl:ObjectProperty ;\n    rdfs:label \"has line item reference\" ;\n    rdfs:comment \"Inverse of itemOf; relates an Item to its LineItems.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Relates a LineItem to its Price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isNetPriceOf .\n\n:isNetPriceOf a owl:ObjectProperty ;\n    rdfs:label \"is net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice; relates a Price to its LineItem.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem .\n\n:assignedToProcess a owl:ObjectProperty ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Relates an InvoiceMessage to a BusinessProcess context.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isProcessAssignmentOf .\n\n:isProcessAssignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is process assignment of\" ;\n    rdfs:comment \"Inverse of assignedToProcess; relates a BusinessProcess to its InvoiceMessage.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage .\n\n:hasValidationConstraint a owl:ObjectProperty ;\n    rdfs:label \"has validation constraint\" ;\n    rdfs:comment \"Relates an InvoiceMessage to a ValidationConstraint (e.g., SHACL shape).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    owl:inverseOf :isValidationConstraintOf .\n\n:isValidationConstraintOf a owl:ObjectProperty ;\n    rdfs:label \"is validation constraint of\" ;\n    rdfs:comment \"Inverse of hasValidationConstraint; relates a ValidationConstraint to its InvoiceMessage.\" ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage .\n\n:hasMonetaryAmount a owl:ObjectProperty ;\n    rdfs:label \"has monetary amount segment\" ;\n    rdfs:comment \"Relates an InvoiceHeader to a MOA_Segment for monetary values.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :MOA_Segment ;\n    owl:inverseOf :isMonetaryAmountOf .\n\n:isMonetaryAmountOf a owl:ObjectProperty ;\n    rdfs:label \"is monetary amount of\" ;\n    rdfs:comment \"Inverse of hasMonetaryAmount; relates a MOA_Segment to its InvoiceHeader.\" ;\n    rdfs:domain :MOA_Segment ;\n    rdfs:range :InvoiceHeader .\n\n:hasDateTime a owl:ObjectProperty ;\n    rdfs:label \"has date/time segment\" ;\n    rdfs:comment \"Relates an InvoiceHeader to a DTM_Segment for document dates.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :DTM_Segment ;\n    owl:inverseOf :isDateTimeOf .\n\n:isDateTimeOf a owl:ObjectProperty ;\n    rdfs:label \"is date/time of\" ;\n    rdfs:comment \"Inverse of hasDateTime; relates a DTM_Segment to its InvoiceHeader.\" ;\n    rdfs:domain :DTM_Segment ;\n    rdfs:range :InvoiceHeader 