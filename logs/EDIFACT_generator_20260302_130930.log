      "id": "call_gEPRC3tjzuS1gakNBgUY9mTj",
      "function": {
        "arguments": "{\"key\":\"current_owl\",\"value\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/edifact-invoic-ontology> a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A deep and profoundly structured OWL ontology for UN/EDIFACT INVOIC messages, covering D96A, EANCOM, EN16931-1, and P2P-O alignment.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A general EDIFACT message contained within an Interchange Envelope.\\\" .\\n\\n:INVOICMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"INVOIC Message\\\" ;\\n    rdfs:comment \\\"An invoice message (INVOIC) in the EDIFACT standard.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment in an EDIFACT message, such as BGM or NAD.\\\" .\\n\\n:BGMSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n\\n:NADSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:Section a owl:Class ;\\n    rdfs:label \\\"Section\\\" ;\\n    rdfs:comment \\\"A section of the message, either header, detail, or summary.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Section ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The header section of an INVOIC message, containing dates and references.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Section ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The detail section of an INVOIC message, listing line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Section ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary section of an INVOIC message, providing totals and taxes.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice, such as buyer or supplier.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in a business process (e.g., Buyer, Supplier).\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address associated with an organization.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization location, such as a GLN.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"An itemized line in the invoice detailing a product or service.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in a line item.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price associated with a line item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax element in the summary section of the invoice.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n    rdfs:label \\\"Invoice Amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number for the invoice document.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:EN16931Compliance a owl:Class ;\\n    rdfs:label \\\"EN 16931 Compliance\\\" ;\\n    rdfs:comment \\\"Compliance with the European Standard EN 16931-1.\\\" .\\n\\n:P2POntologyAlignment a owl:Class ;\\n    rdfs:label \\\"Purchase-to-Pay Ontology Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for automated validation of invoice data.\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"A pivot class reifying the assignment of an AgentRole to an Organization in a specific INVOIC message context.\\\" .\\n\\n#################################################################\\n# Disjoint Unions and Disjoint Classes\\n#################################################################\\n\\n:Section owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\\n\\n:Organization owl:disjointWith :Address, :LineItem, :Section .\\n:Segment owl:disjointWith :Section .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an Interchange Envelope to contained Messages.\\\" .\\n:containsMessage rdf:type owl:FunctionalProperty .\\n:isContainedIn a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is contained in Interchange Envelope\\\" ;\\n    rdfs:comment \\\"Indicates in which InterchangeEnvelope a Message is contained (inverse of containsMessage).\\\" ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a Message to its Segments.\\\" .\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of Message\\\" ;\\n    rdfs:comment \\\"Indicates the Message of which this Segment is a part (inverse of hasSegment).\\\" ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasSection a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Section ;\\n    rdfs:label \\\"has section\\\" ;\\n    rdfs:comment \\\"Links a Message to its Sections (header, detail, summary).\\\" .\\n:isSectionOf a owl:ObjectProperty ;\\n    rdfs:domain :Section ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is section of Message\\\" ;\\n    rdfs:comment \\\"Indicates the Message to which this Section belongs (inverse of hasSection).\\\" ;\\n    owl:inverseOf :hasSection .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Links a Message to its Header Section.\\\" .\\n:hasHeader rdf:type owl:FunctionalProperty .\\n:isHeaderOf a owl:ObjectProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is header of Message\\\" ;\\n    rdfs:comment \\\"Indicates the Message for which this is the Header Section (inverse of hasHeader).\\\" ;\\n    owl:inverseOf :hasHeader .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Links a Message to its Detail Section.\\\" .\\n:hasDetail rdf:type owl:FunctionalProperty .\\n:isDetailOf a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is detail of Message\\\" ;\\n    rdfs:comment \\\"Indicates the Message for which this is the Detail Section (inverse of hasDetail).\\\" ;\\n    owl:inverseOf :hasDetail .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Links a Message to its Summary Section.\\\" .\\n:hasSummary rdf:type owl:FunctionalProperty .\\n:isSummaryOf a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is summary of Message\\\" ;\\n    rdfs:comment \\\"Indicates the Message for which this is the Summary Section (inverse of hasSummary).\\\" ;\\n    owl:inverseOf :hasSummary .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links a Detail Section to its Line Items.\\\" .\\n:isLineItemOf a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"is line item of Detail Section\\\" ;\\n    rdfs:comment \\\"Indicates the Detail Section to which this Line Item belongs (inverse of hasLineItem).\\\" ;\\n    owl:inverseOf :hasLineItem .\\n\\n:describesItem a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Links a Line Item to the Item it describes.\\\" .\\n:describesItem rdf:type owl:FunctionalProperty .\\n:isDescribedByLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is described by Line Item\\\" ;\\n    rdfs:comment \\\"Indicates the Line Item that describes this Item (inverse of describesItem).\\\" ;\\n    owl:inverseOf :describesItem .\\n\\n:hasPrice a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links a Line Item to its Price.\\\" .\\n:hasPrice rdf:type owl:FunctionalProperty .\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is price of Line Item\\\" ;\\n    rdfs:comment \\\"Indicates the Line Item for which this is the Price (inverse of hasPrice).\\\" ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasOrganization a owl:ObjectProperty ;\\n    rdfs:domain :NADSegment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Links a NAD Segment to an Organization participant.\\\" .\\n:isOrganizationOf a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :NADSegment ;\\n    rdfs:label \\\"is organization of NAD Segment\\\" ;\\n    rdfs:comment \\\"Indicates the NAD Segment to which this Organization belongs (inverse of hasOrganization).\\\" ;\\n    owl:inverseOf :hasOrganization .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Links an Organization to its RoleAssignment(s) in the invoice context.\\\" .\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is role assignment of Organization\\\" ;\\n    rdfs:comment \\\"Indicates the Organization for which this is a RoleAssignment (inverse of hasRoleAssignment).\\\" ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"plays role\\\" ;\\n    rdfs:comment \\\"Indicates the AgentRole played in a RoleAssignment.\\\" .\\n:playsRole rdf:type owl:FunctionalProperty .\\n:isRolePlayedInAssignment a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"is role played in Role Assignment\\\" ;\\n    rdfs:comment \\\"Indicates the RoleAssignment in which this AgentRole is played (inverse of playsRole).\\\" ;\\n    owl:inverseOf :playsRole .\\n\\n:inContextOf a owl:ObjectProperty ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :INVOICMessage ;\\n    rdfs:label \\\"in context of\\\" ;\\n    rdfs:comment \\\"Specifies the INVOIC message context for a RoleAssignment.\\\" .\\n:inContextOf rdf:type owl:FunctionalProperty .\\n:isContextForAssignment a owl:ObjectProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :RoleAssignment ;\\n    rdfs:label \\\"is context for Role Assignment\\\" ;\\n    rdfs:comment \\\"Indicates the RoleAssignment for which this INVOICMessage is the context (inverse of inContextOf).\\\" ;\\n    owl:inverseOf :inContextOf .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Address.\\\" .\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is address of Organization\\\" ;\\n    rdfs:comment \\\"Indicates the Organization to which this Address belongs (inverse of hasAddress).\\\" ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasInvoiceAmount a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :InvoiceAmount ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Links a Summary Section to the Invoice Amount.\\\" .\\n:hasInvoiceAmount rdf:type owl:FunctionalProperty .\\n:isInvoiceAmountOf a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceAmount ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is invoice amount of Summary Section\\\" ;\\n    rdfs:comment \\\"Indicates the Summary Section for which this is the Invoice Amount (inverse of hasInvoiceAmount).\\\" ;\\n    owl:inverseOf :hasInvoiceAmount .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links a Summary Section to Tax elements.\\\" .\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is tax of Summary Section\\\" ;\\n    rdfs:comment \\\"Indicates the Summary Section to which this Tax applies (inverse of hasTax).\\\" ;\\n    owl:inverseOf :hasTax .\\n\\n:hasValidationConstraint a owl:ObjectProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    rdfs:label \\\"has validation constraint\\\" ;\\n    rdfs:comment \\\"Links an INVOIC message to its SHACL or other validation constraints.\\\" .\\n:isValidationConstraintOf a owl:ObjectProperty ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :INVOICMessage ;\\n    rdfs:label \\\"is validation constraint of INVOIC Message\\\" ;\\n    rdfs:comment \\\"Indicates the INVOICMessage for which this is a ValidationConstraint (inverse of hasValidationConstraint).\\\" ;\\n    owl:inverseOf :hasValidationConstraint .\\n\\n:alignsWithEN16931 a owl:ObjectProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :EN16931Compliance ;\\n    rdfs:label \\\"aligns with EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates EN 16931 compliance for an INVOIC message.\\\" .\\n:alignsWithEN16931 rdf:type owl:FunctionalProperty .\\n:isEN16931ComplianceOf a owl:ObjectProperty ;\\n    rdfs:domain :EN16931Compliance ;\\n    rdfs:range :INVOICMessage ;\\n    rdfs:label \\\"is EN 16931 compliance of INVOIC Message\\\" ;\\n    rdfs:comment \\\"Indicates the INVOICMessage for which this is the EN16931Compliance (inverse of alignsWithEN16931).\\\" ;\\n    owl:inverseOf :alignsWithEN16931 .\\n\\n:alignsWithP2P a owl:ObjectProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :P2POntologyAlignment ;\\n    rdfs:label \\\"aligns with P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates P2P-O alignment for an INVOIC message.\\\" .\\n:alignsWithP2P rdf:type owl:FunctionalProperty .\\n:isP2PAlignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :P2POntologyAlignment ;\\n    rdfs:range :INVOICMessage ;\\n    rdfs:label \\\"is P2P alignment of INVOIC Message\\\" ;\\n    rdfs:comment \\\"Indicates the INVOICMessage for which this is the P2POntologyAlignment (inverse of alignsWithP2P).\\\" ;\\n    owl:inverseOf :alignsWithP2P .\\n\\n:assignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"assigned to business process\\\" ;\\n    rdfs:comment \\\"Links an INVOIC message to a business process context.\\\" .\\n:assignedToBusinessProcess rdf:type owl:FunctionalProperty .\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :INVOICMessage ;\\n    rdfs:label \\\"is business process of INVOIC Message\\\" ;\\n    rdfs:comment \\\"Indicates the INVOICMessage for which this is the BusinessProcess (inverse of assignedToBusinessProcess).\\\" ;\\n    owl:inverseOf :assignedToBusinessProcess .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a Segment to its Composite Data Elements.\\\" .\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"is composite element of Segment\\\" ;\\n    rdfs:comment \\\"Indicates the Segment to which this CompositeDataElement belongs (inverse of hasCompositeElement).\\\" ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a Composite Data Element to its Simple Data Elements.\\\" .\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple element of Composite Data Element\\\" ;\\n    rdfs:comment \\\"Indicates the CompositeDataElement to which this SimpleDataElement belongs (inverse of hasSimpleElement).\\\" ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has global location number\\\" ;\\n    rdfs:comment \\\"The Global Location Number (GLN) for an organization.\\\" .\\n:hasGlobalLocationNumber rdf:type owl:FunctionalProperty .\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"The reference number of the invoice document.\\\" .\\n:hasReferenceNumber rdf:type owl:FunctionalProperty .\\n\\n:hasDocumentDate a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The date of the invoice document as a string (use ISO 8601).\\\" .\\n:hasDocumentDate rdf:type owl:FunctionalProperty .\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of the item in a line item.\\\" .\\n\\n:elementValue a owl:DatatypeProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"element value\\\" ;\\n    rdfs:comment \\\"The value of a simple data element as a string.\\\" .\\n:elementValue rdf:type owl:FunctionalProperty .\\n\\n#################################################################\\n# Restrictions and GCAs\\n#################################################################\\n\\n:BuyerRole a owl:Class ;\\n    rdfs:subClassOf :AgentRole ;\\n    rdfs:label \\\"Buyer Role\\\" ;\\n    rdfs:comment \\\"The role of buyer in an invoice context.\\\" .\\n\\n:SupplierRole a owl:Class ;\\n    rdfs:subClassOf :AgentRole ;\\n    rdfs:label \\\"Supplier Role\\\" ;\\n    rdfs:comment \\\"The role of supplier in an invoice context.\\\" .\\n\\n:DeliveryPartyRole a owl:Class ;\\n    rdfs:subClassOf :AgentRole ;\\n    rdfs:label \\\"Delivery Party Role\\\" ;\\n    rdfs:comment \\\"The role of delivery party in an invoice context.\\\" .\\n\\n:RoleAssignmentForBuyer a owl:Class ;\\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :playsRole ; owl:hasValue :BuyerRole ] ;\\n    rdfs:subClassOf :RoleAssignment ;\\n    rdfs:label \\\"Role Assignment for Buyer\\\" ;\\n    rdfs:comment \\\"A RoleAssignment where the AgentRole is Buyer.\\\" .\\n\\n:RoleAssignmentForSupplier a owl:Class ;\\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :playsRole ; owl:hasValue :SupplierRole ] ;\\n    rdfs:subClassOf :RoleAssignment ;\\n    rdfs:label \\\"Role Assignment for Supplier\\\" ;\\n    rdfs:comment \\\"A RoleAssignment where the AgentRole is Supplier.\\\" .\\n\\n:RoleAssignmentForDeliveryParty a owl:Class ;\\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :playsRole ; owl:hasValue :DeliveryPartyRole ] ;\\n    rdfs:subClassOf :RoleAssignment ;\\n    rdfs:label \\\"Role Assignment for Delivery Party\\\" ;\\n    rdfs:comment \\\"A RoleAssignment where the AgentRole is Delivery Party.\\\" .\\n\\n#################################################################\\n# Additional Connections for Unconnected Classes\\n#################################################################\\n\\n:hasReferenceNumberClass a owl:ObjectProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :ReferenceNumber ;\\n    rdfs:label \\\"has reference number class\\\" ;\\n    rdfs:comment \\\"Links HeaderSection to ReferenceNumber class for completeness.\\\" .\\n:hasReferenceNumberClass rdf:type owl:FunctionalProperty .\\n:isReferenceNumberOf a owl:ObjectProperty ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"is reference number of Header Section\\\" ;\\n    rdfs:comment \\\"Indicates the HeaderSection to which this ReferenceNumber belongs (inverse of hasReferenceNumberClass).\\\" ;\\n    owl:inverseOf :hasReferenceNumberClass .\\n\\n:hasGlobalLocationNumberClass a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :GlobalLocationNumber ;\\n    rdfs:label \\\"has global location number class\\\" ;\\n    rdfs:comment \\\"Links Organization to GlobalLocationNumber class for completeness.\\\" .\\n:hasGlobalLocationNumberClass rdf:type owl:FunctionalProperty .\\n:isGlobalLocationNumberOf a owl:ObjectProperty ;\\n    rdfs:domain :GlobalLocationNumber ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is global location number of Organization\\\" ;\\n    rdfs:comment \\\"Indicates the Organization to which this GlobalLocationNumber belongs (inverse of hasGlobalLocationNumberClass).\\\" ;\\n    owl:inverseOf :hasGlobalLocationNumberClass .\\n\"}",
