        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#EDIFACT_INVOIC_Story1>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A profound ontology for UN/EDIFACT INVOIC messages, segments, and business semantics as described in the provided story.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The top-level envelope containing messages in UN/EDIFACT.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:INVOICMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"INVOIC Message\\\" ;\\n    rdfs:comment \\\"An EDIFACT message of type INVOIC for invoices.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGMSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n\\n:NADSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"Header section containing document dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"Detail section listing individual line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"Summary section providing totals and tax amounts.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite element.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:subClassOf :INVOICMessage ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"An invoice described by an INVOIC message.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice process.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role (e.g., Buyer, Supplier, Delivery Party) played by an organization in a transaction.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal address for an organization.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization's location.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A line item sold in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price associated with an item.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity associated with an item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax component in the invoice.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice may be assigned.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number for the invoice.\\\" .\\n\\n:EN16931Alignment a owl:Class ;\\n    rdfs:label \\\"EN 16931 Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the European Standard EN 16931-1.\\\" .\\n\\n:P2POAlignment a owl:Class ;\\n    rdfs:label \\\"P2P-O Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n:SHACLConstraint a owl:Class ;\\n    rdfs:label \\\"SHACL Constraint\\\" ;\\n    rdfs:comment \\\"A SHACL constraint for validating the knowledge graph.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the detail section of the invoice.\\\" .\\n\\n:DocumentDate a owl:Class ;\\n    rdfs:label \\\"Document Date\\\" ;\\n    rdfs:comment \\\"The date of the invoice document.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n    rdfs:label \\\"Invoice Amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:InvoiceNumber a owl:Class ;\\n    rdfs:label \\\"Invoice Number\\\" ;\\n    rdfs:comment \\\"The unique number identifying the invoice.\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A pivot class for assigning a role to an organization in the context of an invoice.\\\" .\\n\\n#################################################################\\n# Disjointness and DisjointUnion\\n#################################################################\\n\\n:BGMSegment owl:disjointWith :NADSegment .\\n:HeaderSection owl:disjointWith :DetailSection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :Address .\\n:Item owl:disjointWith :Price .\\n\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :HeaderSection :DetailSection :SummarySection) .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an interchange envelope to the message it contains.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its constituent segments.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a composite element to its simple data elements.\\\" .\\n\\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Relates an INVOIC message to its header section.\\\" .\\n\\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Relates an INVOIC message to its detail section.\\\" .\\n\\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Relates an INVOIC message to its summary section.\\\" .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Relates the detail section to its line items.\\\" .\\n\\n:describesInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :Invoice ;\\n    rdfs:label \\\"describes invoice\\\" ;\\n    rdfs:comment \\\"Links an INVOIC message to the invoice it describes.\\\" .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Relates an invoice to an involved organization.\\\" .\\n\\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"Assigns a specific role to an organization in a transaction.\\\" .\\n\\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"assigned organization\\\" ;\\n    rdfs:comment \\\"Assigns an organization to a role assignment.\\\" .\\n\\n:assignedInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Invoice ;\\n    rdfs:label \\\"assigned invoice\\\" ;\\n    rdfs:comment \\\"Assigns an invoice to a role assignment.\\\" .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Relates an organization to its address.\\\" .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its items.\\\" .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its tax component.\\\" .\\n\\n:assignedBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"assigned business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process.\\\" .\\n\\n:alignedWithEN16931 a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :EN16931Alignment ;\\n    rdfs:label \\\"aligned with EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates alignment with EN 16931-1.\\\" .\\n\\n:alignedWithP2PO a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :P2POAlignment ;\\n    rdfs:label \\\"aligned with P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates alignment with the Purchase-to-Pay Ontology.\\\" .\\n\\n:validatedBySHACL a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :SHACLConstraint ;\\n    rdfs:label \\\"validated by SHACL\\\" ;\\n    rdfs:comment \\\"Indicates validation by SHACL constraints.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Specifies the Global Location Number for an organization.\\\" .\\n\\n:hasRoleIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"role identifier\\\" ;\\n    rdfs:comment \\\"Identifier for a specific agent role.\\\" .\\n\\n:itemNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"item net price\\\" ;\\n    rdfs:comment \\\"Net price of an item.\\\" .\\n\\n:itemQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"item quantity\\\" ;\\n    rdfs:comment \\\"Quantity of an item.\\\" .\\n\\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"invoice amount\\\" ;\\n    rdfs:comment \\\"Total amount of the invoice.\\\" .\\n\\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"Unique invoice number.\\\" .\\n\\n:documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"Date of the invoice document.\\\" .\\n\\n:referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"reference number\\\" ;\\n    rdfs:comment \\\"Reference number for the invoice.\\\" .\\n\\n#################################################################\\n# Pivot Class Reification\\n#################################################################\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A pivot class for assigning a role to an organization in the context of an invoice.\\\" .\\n\\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"Assigns a specific role to an organization in a transaction.\\\" .\\n\\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"assigned organization\\\" ;\\n    rdfs:comment \\\"Assigns an organization to a role assignment.\\\" .\\n\\n:assignedInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Invoice ;\\n    rdfs:label \\\"assigned invoice\\\" ;\\n    rdfs:comment \\\"Assigns an invoice to a role assignment.\\\" .\\n\\n#################################################################\\n# Restrictions and Equivalence Axioms\\n#################################################################\\n# (Sample for illustration \u2013 more can be added as needed)\\n\\n:BuyerRole a owl:Class ;\\n    owl:equivalentClass [\\n        a owl:Restriction ;\\n        owl:onProperty :hasRoleIdentifier ;\\n        owl:hasValue \\\"Buyer\\\"\\n    ] ;\\n    rdfs:subClassOf :AgentRole ;\\n    rdfs:label \\\"Buyer Role\\\" ;\\n    rdfs:comment \\\"The role of Buyer in a transaction.\\\" .\\n\\n:InvoiceWithTotalAmount a owl:Class ;\\n    owl:equivalentClass [\\n        a owl:Restriction ;\\n        owl:onProperty :invoiceAmount ;\\n        owl:someValuesFrom xsd:decimal\\n    ] ;\\n    rdfs:subClassOf :Invoice ;\\n    rdfs:label \\\"Invoice with Total Amount\\\" ;\\n    rdfs:comment \\\"An invoice that specifies a total amount.\\\" .\\n\\n#################################################################\\n# Annotations\\n#################################################################\\n# (All classes and properties above have rdfs:label and rdfs:comment)\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
    {
      "id": "call_K09rJRWFYYP19BlXRIl67ZpQ",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#EDIFACT_INVOIC_Story1>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A profound ontology for UN/EDIFACT INVOIC messages, segments, and business semantics as described in the provided story.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The top-level envelope containing messages in UN/EDIFACT.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:INVOICMessage a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"INVOIC Message\\\" ;\\n    rdfs:comment \\\"An EDIFACT message of type INVOIC for invoices.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message.\\\" .\\n\\n:BGMSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n\\n:NADSegment a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"Header section containing document dates and reference numbers.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"Detail section listing individual line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"Summary section providing totals and tax amounts.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite element.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:subClassOf :INVOICMessage ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"An invoice described by an INVOIC message.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice process.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role (e.g., Buyer, Supplier, Delivery Party) played by an organization in a transaction.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal address for an organization.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization's location.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A line item sold in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price associated with an item.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A quantity associated with an item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax component in the invoice.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice may be assigned.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference number for the invoice.\\\" .\\n\\n:EN16931Alignment a owl:Class ;\\n    rdfs:label \\\"EN 16931 Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the European Standard EN 16931-1.\\\" .\\n\\n:P2POAlignment a owl:Class ;\\n    rdfs:label \\\"P2P-O Alignment\\\" ;\\n    rdfs:comment \\\"Alignment with the Purchase-to-Pay Ontology (P2P-O).\\\" .\\n\\n:SHACLConstraint a owl:Class ;\\n    rdfs:label \\\"SHACL Constraint\\\" ;\\n    rdfs:comment \\\"A SHACL constraint for validating the knowledge graph.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:subClassOf :CompositeDataElement ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the detail section of the invoice.\\\" .\\n\\n:DocumentDate a owl:Class ;\\n    rdfs:label \\\"Document Date\\\" ;\\n    rdfs:comment \\\"The date of the invoice document.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n    rdfs:label \\\"Invoice Amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:InvoiceNumber a owl:Class ;\\n    rdfs:label \\\"Invoice Number\\\" ;\\n    rdfs:comment \\\"The unique number identifying the invoice.\\\" .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"A pivot class for assigning a role to an organization in the context of an invoice.\\\" .\\n\\n#################################################################\\n# Disjointness and DisjointUnion\\n#################################################################\\n\\n:BGMSegment owl:disjointWith :NADSegment .\\n:HeaderSection owl:disjointWith :DetailSection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:Organization owl:disjointWith :Address .\\n:Item owl:disjointWith :Price .\\n\\n:Segment owl:disjointUnionOf (:BGMSegment :NADSegment :HeaderSection :DetailSection :SummarySection) .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an interchange envelope to the message it contains.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates a message to its constituent segments.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a composite element to its simple data elements.\\\" .\\n\\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Relates an INVOIC message to its header section.\\\" .\\n\\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Relates an INVOIC message to its detail section.\\\" .\\n\\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Relates an INVOIC message to its summary section.\\\" .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Relates the detail section to its line items.\\\" .\\n\\n:describesInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :INVOICMessage ;\\n    rdfs:range :Invoice ;\\n    rdfs:label \\\"describes invoice\\\" ;\\n    rdfs:comment \\\"Links an INVOIC message to the invoice it describes.\\\" .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Relates an invoice to an involved organization.\\\" .\\n\\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"assigned role\\\" ;\\n    rdfs:comment \\\"Assigns a specific role to an organization in a transaction.\\\" .\\n\\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"assigned organization\\\" ;\\n    rdfs:comment \\\"Assigns an organization to a role assignment.\\\" .\\n\\n:assignedInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Invoice ;\\n    rdfs:label \\\"assigned invoice\\\" ;\\n    rdfs:comment \\\"Assigns an invoice to a role assignment.\\\" .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Relates an organization to its address.\\\" .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its items.\\\" .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Relates an invoice to its tax component.\\\" .\\n\\n:assignedBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"assigned business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process.\\\" .\\n\\n:alignedWithEN16931 a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :EN16931Alignment ;\\n    rdfs:label \\\"aligned with EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates alignment with EN 16931-1.\\\" .\\n\\n:alignedWithP2PO a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :P2POAlignment ;\\n    rdfs:label \\\"aligned with P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates alignment with the Purchase-to-Pay Ontology.\\\" .\\n\\n:validatedBySHACL a owl:ObjectProperty ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :SHACLConstraint ;\\n    rdfs:label \\\"validated by SHACL\\\" ;\\n    rdfs:comment \\\"Indicates validation by SHACL constraints.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Specifies the Global Location Number for an organization.\\\" .\\n\\n:hasRoleIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"role identifier\\\" ;\\n    rdfs:comment \\\"Identifier for a specific agent role.\\\" .\\n\\n:itemNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"item net price\\\" ;\\n    rdfs:comment \\\"Net