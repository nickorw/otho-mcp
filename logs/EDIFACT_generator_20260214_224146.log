:DetailSection owl:disjointWith :SummarySection .\\n\\n:Section owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\\n\\n### Properties\\n\\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an InterchangeEnvelope to its contained Message.\\\" .\\n:containedInEnvelope a owl:ObjectProperty ;\\n    owl:inverseOf :containsMessage ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"contained in envelope\\\" ;\\n    rdfs:comment \\\"Inverse of containsMessage.\\\" .\\n\\n:hasSection a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Section ;\\n    rdfs:label \\\"has section\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its sections (header, detail, summary).\\\" .\\n:sectionOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasSection ;\\n    rdfs:domain :Section ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"section of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSection.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a Message to its Segments.\\\" .\\n:segmentOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasSegment ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"segment of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a Segment to its Composite Data Elements.\\\" .\\n:compositeElementOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasCompositeElement ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"composite element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasCompositeElement.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a Composite Data Element to its Simple Data Elements.\\\" .\\n:simpleElementOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasSimpleElement ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"simple element of\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleElement.\\\" .\\n\\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"has organization role assignment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to an OrganizationRoleAssignment (pivot for reification of Org, Role, and context).\\\" .\\n:organizationRoleAssignmentOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasOrganizationRoleAssignment ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"organization role assignment of\\\" ;\\n    rdfs:comment \\\"OrganizationRoleAssignment that is part of an InvoiceMessage.\\\" .\\n\\n:hasOrganization a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Links an OrganizationRoleAssignment to an Organization.\\\" .\\n:organizationOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasOrganization ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"organization of\\\" ;\\n    rdfs:comment \\\"Inverse of hasOrganization.\\\" .\\n\\n:hasRole a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Role ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Links an OrganizationRoleAssignment to a Role.\\\" .\\n:roleOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasRole ;\\n    rdfs:domain :Role ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"role of\\\" ;\\n    rdfs:comment \\\"Inverse of hasRole.\\\" .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an OrganizationRoleAssignment to an Address.\\\" .\\n:addressOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasAddress ;\\n    rdfs:domain :Address ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"address of\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress.\\\" .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Identifier ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an OrganizationRoleAssignment to an Identifier (e.g., GLN).\\\" .\\n:identifierOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasIdentifier ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    rdfs:label \\\"identifier of\\\" ;\\n    rdfs:comment \\\"Inverse of hasIdentifier.\\\" .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links a DetailSection to its LineItems.\\\" .\\n:lineItemOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasLineItem ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"line item of\\\" ;\\n    rdfs:comment \\\"Inverse of hasLineItem.\\\" .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links a LineItem to an Item.\\\" .\\n:itemOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasItem ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"item of\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem.\\\" .\\n\\n:hasPrice a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its Price.\\\" .\\n:priceOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasPrice ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"price of\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice.\\\" .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number as a string.\\\" .\\n\\n:hasDate a owl:DatatypeProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has date\\\" ;\\n    rdfs:comment \\\"The date of the invoice (string format for OWL 2 DL compliance).\\\" .\\n\\n:hasNetPrice a owl:DatatypeProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Net price of a line item.\\\" .\\n\\n:hasQuantity a owl:DatatypeProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Quantity of a line item.\\\" .\\n\\n:hasTotalTaxAmount a owl:DatatypeProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has total tax amount\\\" ;\\n    rdfs:comment \\\"Total tax amount for the invoice, referenced via SummarySection.\\\" .\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Total amount for the invoice.\\\" .\\n\\n:hasOrganizationName a owl:DatatypeProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has organization name\\\" ;\\n    rdfs:comment \\\"Name of the organization.\\\" .\\n\\n:hasAddressLine a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has address line\\\" ;\\n    rdfs:comment \\\"Address line (street, etc.).\\\" .\\n\\n:hasPostalCode a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has postal code\\\" ;\\n    rdfs:comment \\\"Postal code of the address.\\\" .\\n\\n:hasCity a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has city\\\" ;\\n    rdfs:comment \\\"City of the address.\\\" .\\n\\n:hasCountryCode a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has country code\\\" ;\\n    rdfs:comment \\\"Country code of the address.\\\" .\\n\\n:hasGLN a owl:DatatypeProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"Global Location Number identifier.\\\" .\\n\\n:hasEDIFACTCode a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :EDIFACTCodeMapping ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has EDIFACT code\\\" ;\\n    rdfs:comment \\\"EDIFACT code mapping.\\\" .\\n\\n:usesStandard a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Standard ;\\n    rdfs:label \\\"uses standard\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a Standard (e.g., EN 16931-1).\\\" .\\n:standardUsedBy a owl:ObjectProperty ;\\n    owl:inverseOf :usesStandard ;\\n    rdfs:domain :Standard ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"standard used by\\\" ;\\n    rdfs:comment \\\"Inverse of usesStandard.\\\" .\\n\\n:validatedBy a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    rdfs:label \\\"validated by\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a ValidationConstraint (e.g., SHACL constraint).\\\" .\\n:validates a owl:ObjectProperty ;\\n    owl:inverseOf :validatedBy ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"validates\\\" ;\\n    rdfs:comment \\\"Inverse of validatedBy.\\\" .\\n\\n:hasDelimiter a owl:ObjectProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :EDIFACTDelimiter ;\\n    rdfs:label \\\"has delimiter\\\" ;\\n    rdfs:comment \\\"Links an InterchangeEnvelope to its delimiters.\\\" .\\n:delimiterOf a owl:ObjectProperty ;\\n    owl:inverseOf :hasDelimiter ;\\n    rdfs:domain :EDIFACTDelimiter ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"delimiter of\\\" ;\\n    rdfs:comment \\\"Inverse of hasDelimiter.\\\" .\\n\\n:assignedProcess a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"assigned process\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a BusinessProcess.\\\" .\\n:processOf a owl:ObjectProperty ;\\n    owl:inverseOf :assignedProcess ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"process of\\\" ;\\n    rdfs:comment \\\"Inverse of assignedProcess.\\\" .\\n\\n### Complex Axioms & Restrictions\\n\\n:OrganizationRoleAssignment owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ]\\n        [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Role ]\\n    )\\n] .\\n\\n:Section owl:equivalentClass [\\n    a owl:Class ;\\n    owl:oneOf ( :HeaderSection :DetailSection :SummarySection )\\n] .\\n\\n### Annotations for EDIFACT technical vocabulary\\n\\n:BGM a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n\\n:NAD a owl:Class ;\\n    rdfs:subClassOf :Segment ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n\\n### Example EDIFACT delimiters\\n\\n:PlusSign a :EDIFACTDelimiter ;\\n    rdfs:label \\\"Plus Sign\\\" ;\\n    rdfs:comment \\\"EDIFACT segment delimiter: +\\\" .\\n\\n:Colon a :EDIFACTDelimiter ;\\n    rdfs:label \\\"Colon\\\" ;\\n    rdfs:comment \\\"EDIFACT composite element delimiter: :\\\" .\\n\\n:Apostrophe a :EDIFACTDelimiter ;\\n    rdfs:label \\\"Apostrophe\\\" ;\\n    rdfs:comment \\\"EDIFACT segment terminator: '\\\" .\\n\\n### Example Standard and ValidationConstraint\\n\\n:EN16931-1 a :Standard ;\\n    rdfs:label \\\"EN 16931-1\\\" ;\\n    rdfs:comment \\\"European Standard for electronic invoicing.\\\" .\\n\\n:SumCheckConstraint a :SHACLConstraint ;\\n    rdfs:label \\\"Sum Check Constraint\\\" ;\\n    rdfs:comment \\\"Constraint ensuring sum of item prices matches reported total.\\\" .\\n\"}",
