      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology for modeling music production, band membership, recordings, performances, and related entities.\" .\n\n### Classes\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual, such as a musician or critic.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A group of musicians performing together.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A function or position held by a person in a band (e.g., vocalist, guitarist).\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A published collection of tracks.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A single audio track on an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition which may be recorded as a track.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews albums or performances.\" ;\n    rdfs:subClassOf :Person .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live event where music is performed.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances may take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A geographical region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A pivot class representing a person's membership in a band, with role and time period.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A pivot class representing the recording of an album, including start and end dates.\" .\n\n:TrackSongRelation a owl:Class ;\n    rdfs:label \"Track-Song Relation\" ;\n    rdfs:comment \"A pivot class linking a track to the song it is a recording of.\" .\n\n:PerformanceSongRelation a owl:Class ;\n    rdfs:label \"Performance-Song Relation\" ;\n    rdfs:comment \"A pivot class linking a performance to the songs performed.\" .\n\n### Object Properties (with inverses)\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Links a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:inverseOf :isPlayedBy .\n:isPlayedBy a owl:ObjectProperty ;\n    rdfs:label \"is played by\" ;\n    rdfs:comment \"Inverse of playsInstrument: links an instrument to the person who plays it.\" ;\n    rdfs:domain :Instrument ;\n    rdfs:range :Person ;\n    owl:inverseOf :playsInstrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Links a band to a band membership event.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :isMembershipOf .\n:isMembershipOf a owl:ObjectProperty ;\n    rdfs:label \"is membership of\" ;\n    rdfs:comment \"Inverse of hasMember: links a band membership to a band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:inverseOf :hasMember .\n\n:isMemberOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is member of\" ;\n    rdfs:comment \"Links a band membership event to a band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:inverseOf :hasMembership .\n:hasMembership a owl:ObjectProperty ;\n    rdfs:label \"has membership\" ;\n    rdfs:comment \"Inverse of isMemberOf: links a band to its memberships.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :isMemberOf .\n\n:hasPerson a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has person\" ;\n    rdfs:comment \"Links a band membership event to a person.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person ;\n    owl:inverseOf :isPersonInMembership .\n:isPersonInMembership a owl:ObjectProperty ;\n    rdfs:label \"is person in membership\" ;\n    rdfs:comment \"Inverse of hasPerson: links a person to their band memberships.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :hasPerson .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a band membership event to a role.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role ;\n    owl:inverseOf :isRoleInMembership .\n:isRoleInMembership a owl:ObjectProperty ;\n    rdfs:label \"is role in membership\" ;\n    rdfs:comment \"Inverse of hasRole: links a role to band memberships.\" ;\n    rdfs:domain :Role ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :hasRole .\n\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"Links an album recording event to an album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album ;\n    owl:inverseOf :isAlbumRecordedBy .\n:isAlbumRecordedBy a owl:ObjectProperty ;\n    rdfs:label \"is album recorded by\" ;\n    rdfs:comment \"Inverse of recordedAlbum: links an album to its recordings.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :recordedAlbum .\n\n:hasTrack a owl:ObjectProperty ;\n    rdfs:label \"has track\" ;\n    rdfs:comment \"Links an album to its tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track ;\n    owl:inverseOf :isTrackOf .\n:isTrackOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is track of\" ;\n    rdfs:comment \"Links a track to the album it belongs to.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album ;\n    owl:inverseOf :hasTrack .\n\n:hasTrackSongRelation a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has track-song relation\" ;\n    rdfs:comment \"Links a track to a track-song relation instance.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :TrackSongRelation ;\n    owl:inverseOf :isTrackSongRelationOf .\n:isTrackSongRelationOf a owl:ObjectProperty ;\n    rdfs:label \"is track-song relation of\" ;\n    rdfs:comment \"Inverse of hasTrackSongRelation: links a track-song relation to the track.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Track ;\n    owl:inverseOf :hasTrackSongRelation .\n\n:isRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is recording of\" ;\n    rdfs:comment \"Links a track-song relation to the song it records.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Song ;\n    owl:inverseOf :hasRecording .\n:hasRecording a owl:ObjectProperty ;\n    rdfs:label \"has recording\" ;\n    rdfs:comment \"Inverse of isRecordingOf: links a song to its track-song relations.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :TrackSongRelation ;\n    owl:inverseOf :isRecordingOf .\n\n:reviewedBy a owl:ObjectProperty ;\n    rdfs:label \"reviewed by\" ;\n    rdfs:comment \"Links an album to a critic who reviewed it.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critic ;\n    owl:inverseOf :reviewedAlbum .\n:reviewedAlbum a owl:ObjectProperty ;\n    rdfs:label \"reviewed album\" ;\n    rdfs:comment \"Inverse of reviewedBy: links a critic to the albums they reviewed.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :Album ;\n    owl:inverseOf :reviewedBy .\n\n:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance location\" ;\n    rdfs:comment \"The city where a performance took place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City ;\n    owl:inverseOf :locationOfPerformance .\n:locationOfPerformance a owl:ObjectProperty ;\n    rdfs:label \"location of performance\" ;\n    rdfs:comment \"Inverse of performanceLocation: links a city to performances held there.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Performance ;\n    owl:inverseOf :performanceLocation .\n\n:hasPerformanceSongRelation a owl:ObjectProperty ;\n    rdfs:label \"has performance-song relation\" ;\n    rdfs:comment \"Links a performance to a performance-song relation instance.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :PerformanceSongRelation ;\n    owl:inverseOf :isPerformanceSongRelationOf .\n:isPerformanceSongRelationOf a owl:ObjectProperty ;\n    rdfs:label \"is performance-song relation of\" ;\n    rdfs:comment \"Inverse of hasPerformanceSongRelation: links a performance-song relation to the performance.\" ;\n    rdfs:domain :PerformanceSongRelation ;\n    rdfs:range :Performance ;\n    owl:inverseOf :hasPerformanceSongRelation .\n\n:isSongPerformed a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is song performed\" ;\n    rdfs:comment \"Links a performance-song relation to the song performed.\" ;\n    rdfs:domain :PerformanceSongRelation ;\n    rdfs:range :Song ;\n    owl:inverseOf :performedIn .\n:performedIn a owl:ObjectProperty ;\n    rdfs:label \"performed in\" ;\n    rdfs:comment \"Inverse of isSongPerformed: links a song to its performance-song relations.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :PerformanceSongRelation ;\n    owl:inverseOf :isSongPerformed .\n\n:locatedInRegion a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"located in region\" ;\n    rdfs:comment \"Links a city to the region it is in.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region ;\n    owl:inverseOf :hasCity .\n:hasCity a owl:ObjectProperty ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"Inverse of locatedInRegion: links a region to its cities.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :City ;\n    owl:inverseOf :locatedInRegion .\n\n:regionInCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"region in country\" ;\n    rdfs:comment \"Links a region to the country it is in.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country ;\n    owl:inverseOf :hasRegion .\n:hasRegion a owl:ObjectProperty ;\n    rdfs:label \"has region\" ;\n    rdfs:comment \"Inverse of regionInCountry: links a country to its regions.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :Region ;\n    owl:inverseOf :regionInCountry .\n\n### Data Properties\n:albumReleaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"album release date\" ;\n    rdfs:comment \"The release date of an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:date .\n\n:trackCount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"track count\" ;\n    rdfs:comment \"The number of tracks on an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:integer .\n\n:hasStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has start date\" ;\n    rdfs:comment \"The start date of a band membership or album recording.\" ;\n    rdfs:domain [owl:unionOf (:BandMembership :AlbumRecording)] ;\n    rdfs:range xsd:date .\n\n:hasEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has end date\" ;\n    rdfs:comment \"The end date of a band membership or album recording.\" ;\n    rdfs:domain [owl:unionOf (:BandMembership :AlbumRecording)] ;\n    rdfs:range xsd:date .\n\n:composedDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"composed date\" ;\n    rdfs:comment \"The date a song was composed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:date .\n\n:reviewComment a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"review comment\" ;\n    rdfs:comment \"The review text given by a critic to an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:string .\n\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"The date a performance took place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:date .\n\n### Disjointness\n:Person owl:disjointWith :Band, :Instrument .\n:Band owl:disjointWith :Instrument .\n:Album owl:disjointWith :Track, :Song .\n:Track owl:disjointWith :Song .\n:Critic owl:disjointWith :Instrument, :Band .\n\n### General Class Axioms & Restrictions\n# Album must have at least one track\n[ a owl:Restriction ;\n  owl:onProperty :hasTrack ;\n  owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n  owl:onClass :Track ;\n  rdfs:subClassOf :Album\n] .\n",
      "label": "final_validated"
}
