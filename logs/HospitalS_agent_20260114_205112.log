 rdfs:label \"studied for\" ;\n    rdfs:comment \"Links a person to a degree they studied for.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Degree ;\n    owl:inverseOf :studiedBy .\n:studiedBy a owl:ObjectProperty ;\n    rdfs:label \"studied by\" ;\n    rdfs:comment \"Inverse of studiedFor; links a degree to a person who studied for it.\" ;\n    rdfs:domain :Degree ;\n    rdfs:range :Person .\n\n:employedAt a owl:ObjectProperty ;\n    rdfs:label \"employed at\" ;\n    rdfs:comment \"Links an employment period to a hospital.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :hasEmployment .\n:hasEmployment a owl:ObjectProperty ;\n    rdfs:label \"has employment\" ;\n    rdfs:comment \"Inverse of employedAt; links a hospital to the employments at that hospital.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :Employment .\n\n:locatedIn a owl:ObjectProperty ;\n    rdfs:label \"located in\" ;\n    rdfs:comment \"Links a hospital to its city.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :City ;\n    owl:inverseOf :hasHospital .\n:hasHospital a owl:ObjectProperty ;\n    rdfs:label \"has hospital\" ;\n    rdfs:comment \"Inverse of locatedIn; links a city to hospitals in that city.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Hospital .\n\n:cityInCountry a owl:ObjectProperty ;\n    rdfs:label \"city in country\" ;\n    rdfs:comment \"Links a city to its country.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Country ;\n    owl:inverseOf :hasCity .\n:hasCity a owl:ObjectProperty ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"Inverse of cityInCountry; links a country to its cities.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :City .\n\n:hasUnionMembership a owl:ObjectProperty ;\n    rdfs:label \"has union membership\" ;\n    rdfs:comment \"Links a person to their union membership.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :UnionMembership ;\n    owl:inverseOf :membershipOf .\n:membershipOf a owl:ObjectProperty ;\n    rdfs:label \"membership of\" ;\n    rdfs:comment \"Inverse of hasUnionMembership; links a union membership to its person.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :Person .\n\n:unionOfMembership a owl:ObjectProperty ;\n    rdfs:label \"union of membership\" ;\n    rdfs:comment \"Links a union membership to the union.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :Union ;\n    owl:inverseOf :hasMembership .\n:hasMembership a owl:ObjectProperty ;\n    rdfs:label \"has membership\" ;\n    rdfs:comment \"Inverse of unionOfMembership; links a union to its memberships.\" ;\n    rdfs:domain :Union ;\n    rdfs:range :UnionMembership .\n\n:hasUnionRole a owl:ObjectProperty ;\n    rdfs:label \"has union role\" ;\n    rdfs:comment \"Links a union membership to a union role.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :UnionRole ;\n    owl:inverseOf :roleOfMembership .\n:roleOfMembership a owl:ObjectProperty ;\n    rdfs:label \"role of membership\" ;\n    rdfs:comment \"Inverse of hasUnionRole; links a union role to its membership.\" ;\n    rdfs:domain :UnionRole ;\n    rdfs:range :UnionMembership .\n\n:evaluatedBy a owl:ObjectProperty ;\n    rdfs:label \"evaluated by\" ;\n    rdfs:comment \"Links an evaluation to the doctor who wrote it.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range :Doctor ;\n    owl:inverseOf :evaluates .\n:evaluates a owl:ObjectProperty ;\n    rdfs:label \"evaluates\" ;\n    rdfs:comment \"Links a doctor to an evaluation they wrote.\" ;\n    rdfs:domain :Doctor ;\n    rdfs:range :Evaluation .\n\n:evaluatedEmployee a owl:ObjectProperty ;\n    rdfs:label \"evaluated employee\" ;\n    rdfs:comment \"Links an evaluation to the employee being evaluated.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range :Person ;\n    owl:inverseOf :employeeEvaluation .\n:employeeEvaluation a owl:ObjectProperty ;\n    rdfs:label \"employee evaluation\" ;\n    rdfs:comment \"Inverse of evaluatedEmployee; links a person to their evaluations.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Evaluation .\n\n:hasArticle a owl:ObjectProperty ;\n    rdfs:label \"has article\" ;\n    rdfs:comment \"Links an article collection to its articles.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range :Article ;\n    owl:inverseOf :isArticleOf .\n:isArticleOf a owl:ObjectProperty ;\n    rdfs:label \"is article of\" ;\n    rdfs:comment \"Inverse of hasArticle; links an article to its collection.\" ;\n    rdfs:domain :Article ;\n    rdfs:range :ArticleCollection .\n\n:presentedAt a owl:ObjectProperty ;\n    rdfs:label \"presented at\" ;\n    rdfs:comment \"Links an article to the seminar where it was presented.\" ;\n    rdfs:domain :Article ;\n    rdfs:range :Seminar ;\n    owl:inverseOf :hasPresentation .\n:hasPresentation a owl:ObjectProperty ;\n    rdfs:label \"has presentation\" ;\n    rdfs:comment \"Inverse of presentedAt; links a seminar to articles presented there.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range :Article .\n\n:seminarLocation a owl:ObjectProperty ;\n    rdfs:label \"seminar location\" ;\n    rdfs:comment \"Links a seminar to the hospital where it takes place.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :locationOfSeminar .\n:locationOfSeminar a owl:ObjectProperty ;\n    rdfs:label \"location of seminar\" ;\n    rdfs:comment \"Inverse of seminarLocation; links a hospital to seminars held there.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :Seminar .\n\n#################################################################\n# Data Properties\n#################################################################\n:studyPeriod a owl:DatatypeProperty ;\n    rdfs:label \"study period\" ;\n    rdfs:comment \"The period during which a person studied for a degree (as string).\" ;\n    rdfs:domain :Employment ;\n    rdfs:range xsd:string .\n\n:employmentStartDate a owl:DatatypeProperty ;\n    rdfs:label \"employment start date\" ;\n    rdfs:comment \"The date when employment started.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range xsd:dateTime .\n\n:membershipStartDate a owl:DatatypeProperty ;\n    rdfs:label \"membership start date\" ;\n    rdfs:comment \"The start date of a union membership.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range xsd:dateTime .\n\n:roleStartDate a owl:DatatypeProperty ;\n    rdfs:label \"role start date\" ;\n    rdfs:comment \"The start date of a union role.\" ;\n    rdfs:domain :UnionRole ;\n    rdfs:range xsd:dateTime .\n\n:roleLabel a owl:DatatypeProperty ;\n    rdfs:label \"role label\" ;\n    rdfs:comment \"The label of a union role.\" ;\n    rdfs:domain :UnionRole ;\n    rdfs:range xsd:string .\n\n:evaluationStatement a owl:DatatypeProperty ;\n    rdfs:label \"evaluation statement\" ;\n    rdfs:comment \"The written statement in an evaluation.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range xsd:string .\n\n:pages a owl:DatatypeProperty ;\n    rdfs:label \"pages\" ;\n    rdfs:comment \"The number of pages in a book.\" ;\n    rdfs:domain :Book ;\n    rdfs:range xsd:integer .\n\n:publishedOn a owl:DatatypeProperty ;\n    rdfs:label \"published on\" ;\n    rdfs:comment \"The publication date of a book or CD.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range xsd:dateTime .\n\n:seminarDate a owl:DatatypeProperty ;\n    rdfs:label \"seminar date\" ;\n    rdfs:comment \"The date when a seminar took place.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range xsd:dateTime .\n\n#################################################################\n# Axioms and Restrictions\n#################################################################\n# At least one article is always presented at each seminar\n:Seminar rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasPresentation ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ; owl:onClass :Article ] .\n"
