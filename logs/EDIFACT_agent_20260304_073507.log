      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Story Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, organizational roles, and procurement scenarios in line with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n#   Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Top-level envelope containing one or more messages in an EDIFACT document.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business message within an Interchange Envelope, such as an invoice.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A message representing an invoice, composed of header, detail, and summary sections.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite element within a segment, grouping multiple simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A single data value within a composite or segment.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Section of an invoice message containing document metadata and reference numbers.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Section listing individual line items of the invoice.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Section providing totals and summary values for the invoice.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"Legal entity involved in a transaction, such as buyer or seller.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice (e.g., Buyer, Seller, Delivery Party).\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Reified relationship linking an organization, its role, and the invoice context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Physical or mailing address of an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"Product or service listed in the invoice detail section.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Price information for an item in the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process, such as Purchase-to-Pay, that an invoice may be aligned with.\" .\n\n#################################################################\n#   Object Properties\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to the contained Message(s).\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its header, detail, and summary sections.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range [ a owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its CompositeDataElements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a CompositeDataElement to its SimpleDataElements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:playsRole a owl:ObjectProperty ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Relates an Organization to a reified OrganizationRoleAssignment.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:hasAgentRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links an OrganizationRoleAssignment to the AgentRole played.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n\n:inInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"in invoice\" ;\n    rdfs:comment \"Links an OrganizationRoleAssignment to the InvoiceMessage context.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates a DetailSection to its listed Items.\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :Item .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Relates an Item to its Price.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :Price .\n\n:isAlignedWithStandard a owl:ObjectProperty ;\n    rdfs:label \"is aligned with standard\" ;\n    rdfs:comment \"Indicates alignment of the invoice message with a business process or standard.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n#################################################################\n#   Data Properties\n#################################################################\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Net price of an item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:decimal .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Quantity of the item listed in the invoice.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Unique number identifying the invoice.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Date the invoice document was issued.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime .\n\n:hasGLN a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Global Location Number identifying the organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasMandatoryIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"has mandatory identifier\" ;\n    rdfs:comment \"A mandatory identifier required by the D96A directory for file validity.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n:hasRole a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"The role name (e.g., Buyer, Seller) of an agent role.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string .\n\n#################################################################\n#   Disjoint Classes\n#################################################################\n:InvoiceMessage owl:disjointWith :Segment, :Organization, :AgentRole, :Address, :Item, :Price, :BusinessProcess .\n\n#################################################################\n#   Complex Axioms & Restrictions\n#################################################################\n:OrganizationRoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:someValuesFrom :AgentRole ]\n        [ a owl:Restriction ; owl:onProperty :inInvoice ; owl:someValuesFrom :InvoiceMessage ]\n    )\n] .\n\n:InvoiceMessage owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom [ a owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ]\n        [ a owl:Restriction ; owl:onProperty :hasMandatoryIdentifier ; owl:someValuesFrom xsd:string ]\n    )\n] .\n"
}
