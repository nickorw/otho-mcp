bel \"has price\" ;\n  rdfs:comment \"Relates a line item to its price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  owl:inverseOf :isPriceOf .\n\n:isPriceOf a owl:ObjectProperty ;\n  rdfs:label \"is price of\" ;\n  rdfs:comment \"Inverse of hasPrice: relates a price to the line item it is for.\" ;\n  rdfs:domain :Price ;\n  rdfs:range :LineItem .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Relates an invoice message to its tax information.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Tax ;\n  owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n  rdfs:label \"is tax of\" ;\n  rdfs:comment \"Inverse of hasTax: relates a tax to the invoice message.\" ;\n  rdfs:domain :Tax ;\n  rdfs:range :InvoiceMessage .\n\n:assignedToBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"assigned to business process\" ;\n  rdfs:comment \"Relates an invoice message to a business process.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  owl:inverseOf :isBusinessProcessAssignmentOf .\n\n:isBusinessProcessAssignmentOf a owl:ObjectProperty ;\n  rdfs:label \"is business process assignment of\" ;\n  rdfs:comment \"Inverse of assignedToBusinessProcess: relates a business process to invoice messages assigned to it.\" ;\n  rdfs:domain :BusinessProcess ;\n  rdfs:range :InvoiceMessage .\n\n#################################################################\n# Data Properties\n#################################################################\n:hasInvoiceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"The invoice number.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"The total amount of the invoice.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:decimal .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n  rdfs:label \"has do