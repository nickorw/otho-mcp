2026-03-01 22:53:39 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoiceOntology> a owl:Ontology ;\n  rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n  rdfs:comment \"Ontology for modeling UN/EDIFACT invoice messages, organizations, roles, and document structure as per EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A generic message within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"A message representing an invoice (e.g., INVOIC).\" ;\n  rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:HeaderSection a owl:Class ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"The header section of an invoice, containing dates and reference numbers.\" ;\n  rdfs:subClassOf :Segment .\n\n:DetailSection a owl:Class ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"The detail section of an invoice, containing line items.\" ;\n  rdfs:subClassOf :Segment .\n\n:SummarySection a owl:Class ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"The summary section of an invoice, containing totals and taxes.\" ;\n  rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment.\" ;\n  rdfs:subClassOf :Segment .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element within a composite data element.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the invoice, such as buyer or seller.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Seller, Delivery Party).\" .\n\n:RoleAssignment a owl:Class ;\n  rdfs:label \"Role Assignment\" ;\n  rdfs:comment \"A reified relation connecting an organization, its role, and the invoice context.\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"An address associated with an organization.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"An identifier such as a Global Location Number (GLN).\" .\n\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in an invoice, describing an item, quantity, and price.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"An item being sold in the invoice.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A price associated with a line item.\" .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"A tax amount associated with the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n#################################################################\n# Object Properties (with inverses)\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Relates an interchange envelope to the message(s) it contains.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n  rdfs:label \"is contained in envelope\" ;\n  rdfs:comment \"Inverse of containsMessage: relates a message to its interchange envelope.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :InterchangeEnvelope .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Relates a message to its segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment ;\n  owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"is segment of\" ;\n  rdfs:comment \"Inverse of hasSegment: relates a segment to its message.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :Message .\n\n:hasCompositeDataElement a owl:ObjectProperty ;\n  rdfs:label \"has composite data element\" ;\n  rdfs:comment \"Relates a segment to its composite data elements.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement ;\n  owl:inverseOf :isCompositeDataElementOf .\n\n:isCompositeDataElementOf a owl:ObjectProperty ;\n  rdfs:label \"is composite data element of\" ;\n  rdfs:comment \"Inverse of hasCompositeDataElement: relates a composite data element to its segment.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :Segment .\n\n:hasSimpleDataElement a owl:ObjectProperty ;\n  rdfs:label \"has simple data element\" ;\n  rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement ;\n  owl:inverseOf :isSimpleDataElementOf .\n\n:isSimpleDataElementOf a owl:ObjectProperty ;\n  rdfs:label \"is simple data element of\" ;\n  rdfs:comment \"Inverse of hasSimpleDataElement: relates a simple data element to its composite data element.\" ;\n  rdfs:domain :SimpleDataElement ;\n  rdfs:range :CompositeDataElement .\n\n:involvesOrganization a owl:ObjectProperty ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Relates an invoice message to organizations involved.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Organization ;\n  owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n  rdfs:label \"is organization involved in\" ;\n  rdfs:comment \"Inverse of involvesOrganization: relates an organization to invoice messages it is involved in.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :InvoiceMessage .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Relates an invoice message to a role assignment (pivot class for reification).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :RoleAssignment ;\n  owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n  rdfs:label \"is role assignment of\" ;\n  rdfs:comment \"Inverse of hasRoleAssignment: relates a role assignment to its invoice message.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :InvoiceMessage .\n\n:assignedRole a owl:ObjectProperty ;\n  rdfs:label \"assigned role\" ;\n  rdfs:comment \"Relates a role assignment to the agent role.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole ;\n  owl:inverseOf :isRoleAssignedTo .\n\n:isRoleAssignedTo a owl:ObjectProperty ;\n  rdfs:label \"is role assigned to\" ;\n  rdfs:comment \"Inverse of assignedRole: relates an agent role to role assignments.\" ;\n  rdfs:domain :AgentRole ;\n  rdfs:range :RoleAssignment .\n\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"assigned organization\" ;\n  rdfs:comment \"Relates a role assignment to the organization assigned that role.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization ;\n  owl:inverseOf :isOrganizationAssignedTo .\n\n:isOrganizationAssignedTo a owl:ObjectProperty ;\n  rdfs:label \"is organization assigned to\" ;\n  rdfs:comment \"Inverse of assignedOrganization: relates an organization to its role assignments.\" ;\n  rdfs:domain :