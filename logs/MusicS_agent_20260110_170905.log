      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n  a owl:Ontology ;\n  rdfs:label \"Music Production Ontology\" ;\n  rdfs:comment \"An ontology for modeling music production, bands, albums, performances, and related entities based on the Red Hot Chili Peppers story.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:Person a owl:Class ;\n  rdfs:label \"Person\" ;\n  rdfs:comment \"A human individual involved in music production, performance, or critique.\" .\n\n:Band a owl:Class ;\n  rdfs:label \"Band\" ;\n  rdfs:comment \"A group of musicians performing together.\" .\n\n:Instrument a owl:Class ;\n  rdfs:label \"Instrument\" ;\n  rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n  rdfs:label \"Role\" ;\n  rdfs:comment \"A musical or band role performed by a person (e.g., vocals, guitar).\" .\n\n:Album a owl:Class ;\n  rdfs:label \"Album\" ;\n  rdfs:comment \"A published collection of tracks recorded by a band.\" .\n\n:Track a owl:Class ;\n  rdfs:label \"Track\" ;\n  rdfs:comment \"A single audio track on an album.\" .\n\n:Song a owl:Class ;\n  rdfs:label \"Song\" ;\n  rdfs:comment \"A musical composition that can be recorded as a track.\" .\n\n:Critic a owl:Class ;\n  rdfs:label \"Critic\" ;\n  rdfs:comment \"A person who reviews or critiques albums.\" .\n\n:Performance a owl:Class ;\n  rdfs:label \"Performance\" ;\n  rdfs:comment \"A live musical event by a band.\" .\n\n:City a owl:Class ;\n  rdfs:label \"City\" ;\n  rdfs:comment \"A city where performances can occur or bands are based.\" .\n\n:Region a owl:Class ;\n  rdfs:label \"Region\" ;\n  rdfs:comment \"A geographic region containing cities.\" .\n\n:Country a owl:Class ;\n  rdfs:label \"Country\" ;\n  rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes (for reification)\n:BandMembership a owl:Class ;\n  rdfs:label \"Band Membership\" ;\n  rdfs:comment \"A reified relation linking a person, band, role, and membership period.\" .\n\n:AlbumRecording a owl:Class ;\n  rdfs:label \"Album Recording\" ;\n  rdfs:comment \"A reified event of a band recording an album with start and end dates.\" .\n\n:TrackListing a owl:Class ;\n  rdfs:label \"Track Listing\" ;\n  rdfs:comment \"A reified relation linking a track, its album, and its position/title.\" .\n\n:SongComposition a owl:Class ;\n  rdfs:label \"Song Composition\" ;\n  rdfs:comment \"A reified event of a song being composed on a specific date.\" .\n\n:AlbumCritique a owl:Class ;\n  rdfs:label \"Album Critique\" ;\n  rdfs:comment \"A reified critique by a critic about an album including the critique text.\" .\n\n:PerformanceSong a owl:Class ;\n  rdfs:label \"Performance Song\" ;\n  rdfs:comment \"A reified relation linking a performance and a song played at it.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :Person ;\n  rdfs:range :Instrument ;\n  rdfs:label \"plays instrument\" ;\n  rdfs:comment \"Relates a person to an instrument they play.\" .\n\n:isMemberOf a owl:ObjectProperty ;\n  rdfs:domain :BandMembership ;\n  rdfs:range :Band ;\n  rdfs:label \"is member of\" ;\n  rdfs:comment \"Relates a band membership to a band.\" .\n\n:hasMember a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n  rdfs:domain :Band ;\n  rdfs:range :BandMembership ;\n  rdfs:label \"has member\" ;\n  rdfs:comment \"Relates a band to its band memberships.\" .\n\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :BandMembership ;\n  rdfs:range :Person ;\n  rdfs:label \"member person\" ;\n  rdfs:comment \"The person in a band membership relation.\" .\n\n:membershipRole a owl:ObjectProperty ;\n  rdfs:domain :BandMembership ;\n  rdfs:range :Role ;\n  rdfs:label \"membership role\" ;\n  rdfs:comment \"The role a person has in the band membership.\" .\n\n:recordsAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumRecording ;\n  rdfs:range :Album ;\n  rdfs:label \"records album\" ;\n  rdfs:comment \"Relates an album recording event to the album.\" .\n\n:recordingBand a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumRecording ;\n  rdfs:range :Band ;\n  rdfs:label \"recording band\" ;\n  rdfs:comment \"Relates an album recording event to the band.\" .\n\n:hasTrack a owl:ObjectProperty ;\n  rdfs:domain :Album ;\n  rdfs:range :TrackListing ;\n  rdfs:label \"has track\" ;\n  rdfs:comment \"Relates an album to its track listings.\" .\n\n:trackOfAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :TrackListing ;\n  rdfs:range :Album ;\n  rdfs:label \"track of album\" ;\n  rdfs:comment \"Relates a track listing to its album.\" .\n\n:trackSong a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :TrackListing ;\n  rdfs:range :Song ;\n  rdfs:label \"track song\" ;\n  rdfs:comment \"Relates a track listing to the song it records.\" .\n\n:composedSong a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :SongComposition ;\n  rdfs:range :Song ;\n  rdfs:label \"composed song\" ;\n  rdfs:comment \"Relates a song composition event to the song.\" .\n\n:critiquedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumCritique ;\n  rdfs:range :Album ;\n  rdfs:label \"critiqued album\" ;\n  rdfs:comment \"Relates an album critique to the album.\" .\n\n:critic a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumCritique ;\n  rdfs:range :Critic ;\n  rdfs:label \"critic\" ;\n  rdfs:comment \"Relates an album critique to the critic.\" .\n\n:performanceSong a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :PerformanceSong ;\n  rdfs:range :Song ;\n  rdfs:label \"performance song\" ;\n  rdfs:comment \"Relates a performance-song event to the song performed.\" .\n\n:performanceInstance a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :PerformanceSong ;\n  rdfs:range :Performance ;\n  rdfs:label \"performance instance\" ;\n  rdfs:comment \"Relates a performance-song event to the performance.\" .\n\n:performanceCity a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :Performance ;\n  rdfs:range :City ;\n  rdfs:label \"performance city\" ;\n  rdfs:comment \"Relates a performance to the city where it took place.\" .\n\n:cityInRegion a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :City ;\n  rdfs:range :Region ;\n  rdfs:label \"city in region\" ;\n  rdfs:comment \"Relates a city to the region it is in.\" .\n\n:regionInCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :Region ;\n  rdfs:range :Country ;\n  rdfs:label \"region in country\" ;\n  rdfs:comment \"Relates a region to its country.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:membershipStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :BandMembership ;\n  rdfs:range xsd:date ;\n  rdfs:label \"membership start\" ;\n  rdfs:comment \"The start date of a band membership.\" .\n\n:membershipEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :BandMembership ;\n  rdfs:range xsd:date ;\n  rdfs:label \"membership end\" ;\n  rdfs:comment \"The end date of a band membership (if applicable).\" .\n\n:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumRecording ;\n  rdfs:range xsd:date ;\n  rdfs:label \"recording start\" ;\n  rdfs:comment \"The start date of an album recording.\" .\n\n:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumRecording ;\n  rdfs:range xsd:date ;\n  rdfs:label \"recording end\" ;\n  rdfs:comment \"The end date of an album recording.\" .\n\n:trackNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :TrackListing ;\n  rdfs:range xsd:integer ;\n  rdfs:label \"track number\" ;\n  rdfs:comment \"The track number in the album.\" .\n\n:trackTitle a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :TrackListing ;\n  rdfs:range xsd:string ;\n  rdfs:label \"track title\" ;\n  rdfs:comment \"The title of the track as listed on the album.\" .\n\n:albumReleaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :Album ;\n  rdfs:range xsd:date ;\n  rdfs:label \"album release date\" ;\n  rdfs:comment \"The release date of the album.\" .\n\n:compositionDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :SongComposition ;\n  rdfs:range xsd:date ;\n  rdfs:label \"composition date\" ;\n  rdfs:comment \"The date the song was composed.\" .\n\n:critiqueText a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :AlbumCritique ;\n  rdfs:range xsd:string ;\n  rdfs:label \"critique text\" ;\n  rdfs:comment \"The text of a critique about an album.\" .\n\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :Performance ;\n  rdfs:range xsd:date ;\n  rdfs:label \"performance date\" ;\n  rdfs:comment \"The date a performance took place.\" .\n\n#################################################################\n# Axioms & Restrictions\n#################################################################\n\n# Album must have at least one track (CQ15)\n:Album rdfs:subClassOf [ a owl:Restriction ;\n    owl:onProperty :hasTrack ;\n    owl:someValuesFrom :TrackListing\n  ] .\n\n# Disjointness axioms\n:Person owl:disjointWith :Band, :Instrument .\n:Band owl:disjointWith :Instrument .\n:Album owl:disjointWith :Track .\n:Song owl:disjointWith :Track .\n:Critic owl:disjointWith :Person .\n:Performance owl:disjointWith :Album .\n"
}
