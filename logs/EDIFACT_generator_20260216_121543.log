      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-ontology>\n  a owl:Ontology ;\n  rdfs:label \"EDIFACT Invoice Ontology\" ;\n  rdfs:comment \"A deep and richly structured OWL ontology for UN/EDIFACT invoice messages, segment hierarchies, business roles, and validation constraints.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:EdifactInterchange a owl:Class ;\n  rdfs:label \"EDIFACT Interchange\" ;\n  rdfs:comment \"The root envelope for an EDIFACT transmission, containing messages.\" .\n\n:EdifactMessage a owl:Class ;\n  rdfs:label \"EDIFACT Message\" ;\n  rdfs:comment \"A message within an interchange, e.g., INVOIC.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:subClassOf :EdifactMessage ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An EDIFACT INVOIC message.\" .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment in an EDIFACT message, e.g., BGM, NAD.\" .\n\n:HeaderSection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Header section of the invoice message, containing meta-information.\" .\n\n:DetailSection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Detail section listing line items.\" .\n\n:SummarySection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Summary section with totals and taxes.\" .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:subClassOf :CompositeDataElement ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element within a composite element.\" .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the transaction.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization (e.g., Buyer, Seller, Delivery Party).\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n  rdfs:label \"Organization Role Assignment\" ;\n  rdfs:comment \"A reified assignment of a role to an organization in a message context.\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal or location address.\" .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"An identifier such as a GLN or VAT number.\" .\n\n:InvoiceLineItem a owl:Class ;\n  rdfs:label \"Invoice Line Item\" ;\n  rdfs:comment \"A reified line item within the invoice, referencing an item, quantity, and price.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service being invoiced.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A price value for an item.\" .\n\n:Quantity a owl:Class ;\n  rdfs:label \"Quantity\" ;\n  rdfs:comment \"A quantity value for an item.\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process context, e.g., procurement, payment.\" .\n\n:ValidationConstraint a owl:Class ;\n  rdfs:label \"Validation Constraint\" ;\n  rdfs:comment \"A constraint for automated validation (e.g., SHACL rule).\" .\n\n:StandardCompliance a owl:Class ;\n  rdfs:label \"Standard Compliance\" ;\n  rdfs:comment \"A standard or specification the message complies with (e.g., EN 16931-1).\" .\n\n#################################################################\n# Object Properties and Inverses\n#################################################################\n\n:hasMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has message\" ;\n  rdfs:comment \"Links an interchange to its messages.\" ;\n  rdfs:domain :EdifactInterchange ;\n  rdfs:range :EdifactMessage ;\n  owl:inverseOf :isMessageOf .\n\n:isMessageOf a owl:ObjectProperty ;\n  rdfs:label \"is message of\" ;\n  rdfs:comment \"Inverse of hasMessage; links a message to its interchange.\" ;\n  rdfs:domain :EdifactMessage ;\n  rdfs:range :EdifactInterchange .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Links a message to its segments.\" ;\n  rdfs:domain :EdifactMessage ;\n  rdfs:range :Segment ;\n  owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n  rdfs:label \"is segment of\" ;\n  rdfs:comment \"Inverse of hasSegment; links a segment to its message.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :EdifactMessage .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Links a message to its header, detail, or summary sections.\" ;\n  rdfs:domain :EdifactMessage ;\n  rdfs:range :Segment ;\n  owl:inverseOf :isSectionOf .\n\n:isSectionOf a owl:ObjectProperty ;\n  rdfs:label \"is section of\" ;\n  rdfs:comment \"Inverse of hasSection; links a section to its message.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :EdifactMessage .\n\n:hasCompositeElement a owl:ObjectProperty ;\n  rdfs:label \"has composite element\" ;\n  rdfs:comment \"Links a segment to its composite data elements.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement ;\n  owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n  rdfs:label \"is composite element of\" ;\n  rdfs:comment \"Inverse of hasCompositeElement; links a composite element to its segment.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :Segment .\n\n:hasSimpleElement a owl:ObjectProperty ;\n  rdfs:label \"has simple element\" ;\n  rdfs:comment \"Links a composite element to its simple data elements.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement ;\n  owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n  rdfs:label \"is simple element of\" ;\n  rdfs:comment \"Inverse of hasSimpleElement; links a simple element to its composite element.\" ;\n  rdfs:domain :SimpleDataElement ;\n  rdfs:range :CompositeDataElement .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"has organization role assignment\" ;\n  rdfs:comment \"Links an invoice message to its organization-role assignments.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :OrganizationRoleAssignment ;\n  owl:inverseOf :isOrganizationRoleAssignmentOf .\n\n:isOrganizationRoleAssignmentOf a owl:ObjectProperty ;\n  rdfs:label \"is organization role assignment of\" ;\n  rdfs:comment \"Inverse of hasOrganizationRoleAssignment; links a role assignment to its invoice message.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :InvoiceMessage .\n\n:involvesOrganization a owl:ObjectProperty ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Links an organization role assignment to the organization.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization ;\n  owl:inverseOf :isInvolvedInOrganizationRoleAssignment .\n\n:isInvolvedInOrganizationRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"is involved in organization role assignment\" ;\n  rdfs:comment \"Inverse of involvesOrganization; links an organization to its role assignments.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleAssignment .\n\n:hasRole a owl:ObjectProperty ;\n  rdfs:label \"has role\" ;\n  rdfs:comment \"Links an organization role assignment to the role.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole ;\n  owl:inverseOf :isRoleOfOrganizationRoleAssignment .\n\n:isRoleOfOrganizationRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"is role of organization role assignment\" ;\n  rdfs:comment \"Inverse of hasRole; links a role to its organization role assignments.\" ;\n  rdfs:domain :AgentRole ;\n  rdfs:range :OrganizationRoleAssignment .\n\n:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization to an address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address ;\n  owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n  rdfs:label \"is address of\" ;\n  rdfs:comment \"Inverse of hasAddress; links an address to its organization.\" ;\n  rdfs:domain :Address ;\n  rdfs:range :Organization .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to an identifier (e.g., GLN).\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier ;\n  owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n  rdfs:label \"is identifier of\" ;\n  rdfs:comment \"Inverse of hasIdentifier; links an identifier to its organization.\" ;\n  rdfs:domain :Identifier ;\n  rdfs:range :Organization .\n\n:hasInvoiceLineItem a owl:ObjectProperty ;\n  rdfs:label \"has invoice line item\" ;\n  rdfs:comment \"Links an invoice message to its line items.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :InvoiceLineItem ;\n  owl:inverseOf :isInvoiceLineItemOf .\n\n:isInvoiceLineItemOf a owl:ObjectProperty ;\n  rdfs:label \"is invoice line item of\" ;\n  rdfs:comment \"Inverse of hasInvoiceLineItem; links a line item to its invoice message.\" ;\n  rdfs:domain :InvoiceLineItem ;\n  rdfs:range :InvoiceMessage .\n\n:refersToItem a owl:ObjectProperty ;\n  rdfs:label \"refers to item\" ;\n  rdfs:comment \"Links a line item to the item it describes.\" ;\n  rdfs:domain :InvoiceLineItem ;\n  rdfs:range :Item ;\n  owl:inverseOf :isItemOf .\n\n:isItemOf a owl:ObjectProperty ;\n  rdfs:label \"is item of\" ;\n  rdfs:comment \"Inverse of refersToItem; links an item to the line item referencing it.\" ;\n  rdfs:domain :Item ;\n  rdfs:range :InvoiceLineItem .\n\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Links a line item to its price.\" ;\n  rdfs:domain :InvoiceLineItem ;\n  rdfs:range :Price ;\n  owl:inverseOf :isPriceOf .\n\n:isPriceOf a owl:ObjectProperty ;\n  rdfs:label \"is price of\" ;\n  rdfs:comment \"Inverse of hasPrice; links a price to the line item it is for.\" ;\n  rdfs:domain :Price ;\n  rdfs:range :InvoiceLineItem .\n\n:hasQuantity a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Links a line item to its quantity.\" ;\n  rdfs:domain :InvoiceLineItem ;\n  rdfs:range :Quantity ;\n  owl:inverseOf :isQuantityOf .\n\n:isQuantityOf a owl:ObjectProperty ;\n  rdfs:label \"is quantity of\" ;\n  rdfs:comment \"Inverse of hasQuantity; links a quantity to the line item it is for.\" ;\n  rdfs:domain :Quantity ;\n  rdfs:range :InvoiceLineItem .\n\n:playsRoleInInvoice a owl:ObjectProperty ;\n  rdfs:label \"plays role in invoice\" ;\n  rdfs:comment \"Links an organization to its role assignments in invoices.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleAssignment ;\n  owl:inverseOf :isRolePlayedByOrganization .\n\n:isRolePlayedByOrganization a owl:ObjectProperty ;\n  rdfs:label \"is role played by organization\" ;\n  rdfs:comment \"Inverse of playsRoleInInvoice; links a role assignment to its organization.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n  rdfs:label \"has business process\" ;\n  rdfs:comment \"Links an invoice message to its business process context.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n  rdfs:label \"is business process of\" ;\n  rdfs:comment \"Inverse of hasBusinessProcess; links a business process to its invoice message.\" ;\n  rdfs:domain :BusinessProcess ;\n  rdfs:range :InvoiceMessage .\n\n:isCompliantWith a owl:ObjectProperty ;\n  rdfs:label \"is compliant with\" ;\n  rdfs:comment \"Links an invoice message to a compliance standard.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :StandardCompliance ;\n  owl:inverseOf :isComplianceFor .\n\n:isComplianceFor a owl:ObjectProperty ;\n  rdfs:label \"is compliance for\" ;\n  rdfs:comment \"Inverse of isCompliantWith; links a standard to the invoice message it validates.\" ;\n  rdfs:domain :StandardCompliance ;\n  rdfs:range :InvoiceMessage .\n\n:validatedBy a owl:ObjectProperty ;\n  rdfs:label \"validated by\" ;\n  rdfs:comment \"Links an invoice message to a validation constraint.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :ValidationConstraint ;\n  owl:inverseOf :isValidationFor .\n\n:isValidationFor a owl:ObjectProperty ;\n  rdfs:label \"is validation for\" ;\n  rdfs:comment \"Inverse of validatedBy; links a validation constraint to the invoice message.\" ;\n  rdfs:domain :ValidationConstraint ;\n  rdfs:range :InvoiceMessage .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:hasInvoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"The total invoice amount.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"The invoice number.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string .\n\n:hasDate a owl:DatatypeProperty ;\n  rdfs:label \"has date\" ;\n  rdfs:comment \"A date in the header section (as string, for OWL 2 DL compliance).\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"A reference number in the header section.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasTaxAmount a owl:DatatypeProperty ;\n  rdfs:label \"has tax amount\" ;\n  rdfs:comment \"The tax amount in the summary section.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasTotalAmount a owl:DatatypeProperty ;\n  rdfs:label \"has total amount\" ;\n  rdfs:comment \"The total amount in the summary section.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal .\n\n:itemNetPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:label \"item net price\" ;\n  rdfs:comment \"The net price of an item in a line item.\" ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal .\n\n:itemQuantityValue a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:label \"item quantity value\" ;\n  rdfs:comment \"The quantity value of an item in a line item.\" ;\n  rdfs:domain :Quantity ;\n  rdfs:range xsd:decimal .\n\n#################################################################\n# Disjointness and Disjoint Unions\n#################################################################\n\n:Organization owl:disjointWith :Item .\n:InvoiceLineItem owl:disjointWith :OrganizationRoleAssignment .\n:Address owl:disjointWith :Identifier .\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n\n:Segment owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\n\n#################################################################\n# Example Agent Roles\n#################################################################\n\n:Buyer a :AgentRole ;\n  rdfs:label \"Buyer\" ;\n  rdfs:comment \"The organization acting as the buyer in the transaction.\" .\n\n:Seller a :AgentRole ;\n  rdfs:label \"Seller\" ;\n  rdfs:comment \"The organization acting as the seller in the transaction.\" .\n\n:DeliveryParty a :AgentRole ;\n  rdfs:label \"Delivery Party\" ;\n  rdfs:comment \"The organization acting as the delivery party in the transaction.\" .\n\n#################################################################\n# Example Standard Compliance\n#################################################################\n\n:EN16931-1 a :StandardCompliance ;\n  rdfs:label \"EN 16931-1\" ;\n  rdfs:comment \"European Standard for electronic invoicing.\" .\n\n:P2PO a :StandardCompliance ;\n  rdfs:label \"P2P-O\" ;\n  rdfs:comment \"Purchase-to-Pay Ontology compliance.\" .\n\n#################################################################\n# Example Validation Constraints\n#################################################################\n\n:SumOfLineItemsEqualsTotal a :ValidationConstraint ;\n  rdfs:label \"Sum of Line Items Equals Total\" ;\n  rdfs:comment \"Constraint: The sum of itemized prices must equal the invoice total.\" .\n\n:MandatoryIdentifiersPresent a :ValidationConstraint ;\n  rdfs:label \"Mandatory Identifiers Present\" ;\n  rdfs:comment \"Constraint: All mandatory identifiers required by the D96A directory must be present.\" .\n",
      "label": "final_validated"
}
