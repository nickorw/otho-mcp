s context.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess .\\n\\n:isCompliantWith a owl:ObjectProperty ;\\n  rdfs:label \\\"is compliant with\\\" ;\\n  rdfs:comment \\\"Links an invoice message to a compliance standard.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :StandardCompliance .\\n\\n:validatedBy a owl:ObjectProperty ;\\n  rdfs:label \\\"validated by\\\" ;\\n  rdfs:comment \\\"Links an invoice message to a validation constraint.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n  rdfs:label \\\"has invoice amount\\\" ;\\n  rdfs:comment \\\"The total invoice amount.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range xsd:decimal ;\\n  owl:FunctionalProperty .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n  rdfs:label \\\"has invoice number\\\" ;\\n  rdfs:comment \\\"The invoice number.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range xsd:string ;\\n  owl:FunctionalProperty .\\n\\n:hasDate a owl:DatatypeProperty ;\\n  rdfs:label \\\"has date\\\" ;\\n  rdfs:comment \\\"A date in the header section (as string, for OWL 2 DL compliance).\\\" ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string .\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n  rdfs:label \\\"has reference number\\\" ;\\n  rdfs:comment \\\"A reference number in the header section.\\\" ;\\n  rdfs:domain :HeaderSection ;\\n  rdfs:range xsd:string .\\n\\n:hasTaxAmount a owl:DatatypeProperty ;\\n  rdfs:label \\\"has tax amount\\\" ;\\n  rdfs:comment \\\"The tax amount in the summary section.\\\" ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range xsd:decimal .\\n\\n:hasTotalAmount a owl:DatatypeProperty ;\\n  rdfs:label \\\"has total amount\\\" ;\\n  rdfs:comment \\\"The total amount in the summary section.\\\" ;\\n  rdfs:domain :SummarySection ;\\n  rdfs:range xsd:decimal .\\n\\n:itemNetPrice a owl:DatatypeProperty ;\\n  rdfs:label \\\"item net price\\\" ;\\n  rdfs:comment \\\"The net price of an item in a line item.\\\" ;\\n  rdfs:domain :Price ;\\n  rdfs:range xsd:decimal ;\\n  owl:FunctionalProperty .\\n\\n:itemQuantityValue a owl:DatatypeProperty ;\\n  rdfs:label \\\"item quantity value\\\" ;\\n  rdfs:comment \\\"The quantity value of an item in a line item.\\\" ;\\n  rdfs:domain :Quantity ;\\n  rdfs:range xsd:decimal ;\\n  owl:FunctionalProperty .\\n\\n#################################################################\\n# Disjointness and Disjoint Unions\\n#################################################################\\n\\n:Organization owl:disjointWith :Item .\\n:InvoiceLineItem owl:disjointWith :OrganizationRoleAssignment .\\n:Address owl:disjointWith :Identifier .\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n\\n:Segment owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\\n\\n#################################################################\\n# Example Agent Roles\\n#################################################################\\n\\n:Buyer a :AgentRole ;\\n  rdfs:label \\\"Buyer\\\" ;\\n  rdfs:comment \\\"The organization acting as the buyer in the transaction.\\\" .\\n\\n:Seller a :AgentRole ;\\n  rdfs:label \\\"Seller\\\" ;\\n  rdfs:comment \\\"The organization acting as the seller in the transaction.\\\" .\\n\\n:DeliveryParty a :AgentRole ;\\n  rdfs:label \\\"Delivery Party\\\" ;\\n  rdfs:comment \\\"The organization acting as the delivery party in the transaction.\\\" .\\n\\n#################################################################\\n# Example Standard Compliance\\n#################################################################\\n\\n:EN16931-1 a :StandardCompliance ;\\n  rdfs:label \\\"EN 16931-1\\\" ;\\n  rdfs:comment \\\"European Standard for electronic invoicing.\\\" .\\n\\n:P2PO a :StandardCompliance ;\\n  rdfs:label \\\"P2P-O\\\" ;\\n  rdfs:comment \\\"Purchase-to-Pay Ontology compliance.\\\" .\\n\\n#################################################################\\n# Example Validation Constraints\\n#################################################################\\n\\n:SumOfLineItemsEqualsTotal a :ValidationConstraint ;\\n  rdfs:label \\\"Sum of Line Items Equals Total\\\" ;\\n  rdfs:comment \\\"Constraint: The sum of itemized prices must equal the invoice total.\\\" .\\n\\n:MandatoryIdentifiersPresent a :ValidationConstraint ;\\n  rdfs:label \\\"Mandatory Identifiers Present\\\" ;\\n  rdfs:comment \\\"Constraint: All mandatory identifiers required by the D96A directory must be present.\\\" .\\n\"}",
