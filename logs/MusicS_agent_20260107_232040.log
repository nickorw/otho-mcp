2026-01-07 23:25:40 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production-story>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"Ontology describing music production, band membership, album recording, and related entities as per the Red Hot Chili Peppers story.\" .\n\n### Classes\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual involved in music production.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A musical band or group.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A role or function a person can have in a band (e.g. vocalist, guitarist).\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A music album released by a band.\" ;\n    owl:equivalentClass [\n        a owl:Restriction ;\n        owl:onProperty :containsTrack ;\n        owl:someValuesFrom :Track\n    ] .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A track contained in an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews or critiques music albums.\" .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live music performance event.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances can take place.\" ;\n    rdfs:subClassOf :Place .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A region containing cities.\" ;\n    rdfs:subClassOf :Place .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" ;\n    rdfs:subClassOf :Place .\n\n:Place a owl:Class ;\n    rdfs:label \"Place\" ;\n    rdfs:comment \"A general location class for places such as City, Region, Country.\" ;\n    owl:disjointUnionOf ( :City :Region :Country ) .\n\n### Pivot Classes (Reification)\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A membership of a person in a band, with role and time information.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"The recording of an album with start and end dates.\" .\n\n:TrackSongRelation a owl:Class ;\n    rdfs:label \"Track Song Relation\" ;\n    rdfs:comment \"Reifies the relation between a track and the song it is a recording of.\" .\n\n:AlbumCritique a owl:Class ;\n    rdfs:label \"Album Critique\" ;\n    rdfs:comment \"A critique by a critic about an album, including the statement.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"Reifies the relation between a performance and a song played.\" .\n\n:PerformanceLocation a owl:Class ;\n    rdfs:label \"Performance Location\" ;\n    rdfs:comment \"Reifies the relation between a performance and its city location.\" .\n\n### Disjointness\n:Person owl:disjointWith :Instrument, :Band, :Critic .\n:Band owl:disjointWith :Instrument, :Critic .\n:Instrument owl:disjointWith :Role .\n:Role owl:disjointWith :Instrument .\n:Album owl:disjointWith :Track, :Song, :Performance .\n:Track owl:disjointWith :Album, :Song .\n:Song owl:disjointWith :Track, :Album .\n:Performance owl:disjointWith :Album .\n:City owl:disjointWith :Region, :Country .\n:Region owl:disjointWith :Country .\n\n### Object Properties and Inverses\n:playsInstrument a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a person to the instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:inverseOf :playedBy .\n:playedBy a owl:ObjectProperty ;\n    rdfs:label \"played by\" ;\n    rdfs:comment \"Inverse of playsInstrument: relates instrument to the person who plays it.\" ;\n    rdfs:domain :Instrument ;\n    rdfs:range :Person ;\n    owl:inverseOf :playsInstrument .\n\n:hasMembership a owl:ObjectProperty, owl:IrreflexiveProperty ;\n    rdfs:label \"has membership\" ;\n    rdfs:comment \"Links a person to their band membership (BandMembership pivot).\" ;\n    rdfs:domain :Person ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :membershipOf .\n:membershipOf a owl:ObjectProperty ;\n    rdfs:label \"membership of\" ;\n    rdfs:comment \"Inverse of hasMembership: links BandMembership to the Person.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person ;\n    owl:inverseOf :hasMembership .\n\n:membershipInBand a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"membership in band\" ;\n    rdfs:comment \"Links a BandMembership to the Band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:inverseOf :hasMember .\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Inverse of membershipInBand: links Band to BandMembership.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :membershipInBand .\n\n:hasRole a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a BandMembership to a Role.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role ;\n    owl:inverseOf :roleOf .\n:roleOf a owl:ObjectProperty ;\n    rdfs:label \"role of\" ;\n    rdfs:comment \"Inverse of hasRole: links Role to BandMembership.\" ;\n    rdfs:domain :Role ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :hasRole .\n\n:recordsAlbum a owl:ObjectProperty, owl:IrreflexiveProperty ;\n    rdfs:label \"records album\" ;\n    rdfs:comment \"Links a Band to the AlbumRecording.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :recordedBy .\n:recordedBy a owl:ObjectProperty ;\n    rdfs:label \"recorded by\" ;\n    rdfs:comment \"Inverse of recordsAlbum: links AlbumRecording to Band.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Band ;\n    owl:inverseOf :recordsAlbum .\n\n:recordedAlbum a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"Links AlbumRecording to the Album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album ;\n    owl:inverseOf :albumRecording .\n:albumRecording a owl:ObjectProperty ;\n    rdfs:label \"album recording\" ;\n    rdfs:comment \"Inverse of recordedAlbum: links Album to AlbumRecording.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :recordedAlbum .\n\n:containsTrack a owl:ObjectProperty, owl:IrreflexiveProperty ;\n    rdfs:label \"contains track\" ;\n    rdfs:comment \"Links Album to Track.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track ;\n    owl:inverseOf :trackOf .\n:trackOf a owl:ObjectProperty ;\n    rdfs:label \"track of\" ;\n    rdfs:comment \"Inverse of containsTrack: links Track to Album.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album ;\n    owl:inverseOf :containsTrack .\n\n:isRecordingOf a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"is recording of\" ;\n    rdfs:comment \"Links TrackSongRelation to the Song.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Song ;\n    owl:inverseOf :hasRecording .\n:hasRecording a owl:ObjectProperty ;\n    rdfs:label \"has recording\" ;\n    rdfs:comment \"Inverse of isRecordingOf: links Song to TrackSongRelation.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :TrackSongRelation ;\n    owl:inverseOf :isRecordingOf .\n\n:track a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"track\" ;\n    rdfs:comment \"Links TrackSongRelation to the Track.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Track ;\n    owl:inverseOf :isTrackRelationOf .\n:isTrackRelationOf a owl:ObjectProperty ;\n    rdfs:label \"is track relation of\" ;\n    rdfs:comment \"Inverse of track: links Track to TrackSongRelation.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :TrackSongRelation ;\n    owl:inverseOf :track .\n\n:criticizesAlbum a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"criticizes album\" ;\n    rdfs:comment \"Links AlbumCritique to the Album.\" ;\n    rdfs:domain :AlbumCritique ;\n    rdfs:range :Album ;\n    owl:inverseOf :hasCritique .\n:hasCritique a owl:ObjectProperty ;\n    rdfs:label \"has critique\" ;\n    rdfs:comment \"Inverse of criticizesAlbum: links Album to AlbumCritique.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :AlbumCritique ;\n    owl:inverseOf :criticizesAlbum .\n\n:byCritic a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"by critic\" ;\n    rdfs:comment \"Links AlbumCritique to the Critic.\" ;\n    rdfs:domain :AlbumCritique ;\n    rdfs:range :Critic ;\n    owl:inverseOf :hasCritiqueBy .\n:hasCritiqueBy a owl:ObjectProperty ;\n    rdfs:label \"has critique by\" ;\n    rdfs:comment \"Inverse of byCritic: links Critic to AlbumCritique.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :AlbumCritique ;\n    owl:inverseOf :byCritic .\n\n:performanceSong a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"performance song\" ;\n    rdfs:comment \"Links PerformanceSong to the Song.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song ;\n    owl:inverseOf :isPerformanceSongOf .\n:isPerformanceSongOf a owl:ObjectProperty ;\n    rdfs:label \"is performance song of\" ;\n    rdfs:comment \"Inverse of performanceSong: links Song to PerformanceSong.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performanceSong .\n\n:performance a owl:ObjectProperty