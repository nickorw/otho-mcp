      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology for modeling music production, band membership, recordings, performances, and related concepts.\" .\n\n### Classes\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual involved in music production.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A musical group or band.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A musical role played by a person in a band (e.g., vocals, drums).\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A published collection of musical tracks.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A specific track or recording on an album.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition that may be recorded as a track.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who critiques albums.\" .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live musical performance event.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances may take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot/Reified Classes\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A reification of a person's membership in a band, their role, and the time period.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A reification of the recording of an album and its time period.\" .\n\n:TrackInAlbum a owl:Class ;\n    rdfs:label \"Track In Album\" ;\n    rdfs:comment \"A reification of a track's inclusion in an album.\" .\n\n:SongComposition a owl:Class ;\n    rdfs:label \"Song Composition\" ;\n    rdfs:comment \"A reification of a song's composition date.\" .\n\n:Critique a owl:Class ;\n    rdfs:label \"Critique\" ;\n    rdfs:comment \"A reification of a critic's comment about an album.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reification of a song performed at a performance.\" .\n\n### Object Properties\n:playsInstrument a owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Indicates a person plays a particular instrument.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Indicates a band has a member (person).\" ;\n    rdfs:domain :Band ;\n    rdfs:range :Person .\n\n:memberPerson a owl:ObjectProperty ;\n    rdfs:label \"member person\" ;\n    rdfs:comment \"The person in a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person .\n\n:memberBand a owl:ObjectProperty ;\n    rdfs:label \"member band\" ;\n    rdfs:comment \"The band in a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"The role held by a person in a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role .\n\n:recordedAlbum a owl:ObjectProperty ;\n    rdfs:label \"recorded album\" ;\n    rdfs:comment \"The album recorded in an album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album .\n\n:containsTrack a owl:ObjectProperty ;\n    rdfs:label \"contains track\" ;\n    rdfs:comment \"Indicates an album contains a track-in-album (reified).\" ;\n    rdfs:domain :Album ;\n    rdfs:range :TrackInAlbum .\n\n:track a owl:ObjectProperty ;\n    rdfs:label \"track\" ;\n    rdfs:comment \"The track in a track-in-album relation.\" ;\n    rdfs:domain :TrackInAlbum ;\n    rdfs:range :Track .\n\n:isRecordingOf a owl:ObjectProperty ;\n    rdfs:label \"is recording of\" ;\n    rdfs:comment \"Indicates a track is a recording of a song.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Song .\n\n:composedSong a owl:ObjectProperty ;\n    rdfs:label \"composed song\" ;\n    rdfs:comment \"The song composed in a song composition event.\" ;\n    rdfs:domain :SongComposition ;\n    rdfs:range :Song .\n\n:hasCritique a owl:ObjectProperty ;\n    rdfs:label \"has critique\" ;\n    rdfs:comment \"Indicates an album has a critique.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critique .\n\n:critic a owl:ObjectProperty ;\n    rdfs:label \"critic\" ;\n    rdfs:comment \"The critic in a critique.\" ;\n    rdfs:domain :Critique ;\n    rdfs:range :Critic .\n\n:performanceLocation a owl:ObjectProperty ;\n    rdfs:label \"performance location\" ;\n    rdfs:comment \"The city in which a performance takes place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City .\n\n:inRegion a owl:ObjectProperty ;\n    rdfs:label \"in region\" ;\n    rdfs:comment \"The region in which a city is located.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region .\n\n:inCountry a owl:ObjectProperty ;\n    rdfs:label \"in country\" ;\n    rdfs:comment \"The country in which a region is located.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country .\n\n:performedSong a owl:ObjectProperty ;\n    rdfs:label \"performed song\" ;\n    rdfs:comment \"The song performed in a performance-song event.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song .\n\n:performance a owl:ObjectProperty ;\n    rdfs:label \"performance\" ;\n    rdfs:comment \"The performance in a performance-song event.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance .\n\n### Data Properties\n:membershipStart a owl:DatatypeProperty ;\n    rdfs:label \"membership start\" ;\n    rdfs:comment \"The start date/time of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:dateTime .\n\n:membershipEnd a owl:DatatypeProperty ;\n    rdfs:label \"membership end\" ;\n    rdfs:comment \"The end date/time of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:dateTime .\n\n:recordingStart a owl:DatatypeProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"The start date/time of an album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:recordingEnd a owl:DatatypeProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"The end date/time of an album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:composedOn a owl:DatatypeProperty ;\n    rdfs:label \"composed on\" ;\n    rdfs:comment \"The date/time a song was composed.\" ;\n    rdfs:domain :SongComposition ;\n    rdfs:range xsd:dateTime .\n\n:critiqueText a owl:DatatypeProperty ;\n    rdfs:label \"critique text\" ;\n    rdfs:comment \"The text of a critic's comment.\" ;\n    rdfs:domain :Critique ;\n    rdfs:range xsd:string .\n\n:performanceDate a owl:DatatypeProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"The date/time of a performance.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:dateTime .\n\n:albumReleaseDate a owl:DatatypeProperty ;\n    rdfs:label \"album release date\" ;\n    rdfs:comment \"The release date of an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:dateTime .\n\n:trackCount a owl:DatatypeProperty ;\n    rdfs:label \"track count\" ;\n    rdfs:comment \"The number of tracks in an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:integer ;\n    a owl:FunctionalProperty .\n\n### Disjointness\n:Person owl:disjointWith :Band, :Critic .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Track, :Song, :Performance .\n:Track owl:disjointWith :Song .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n\n### Restrictions and Axioms\n# Album must have at least one track\n:Album rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :containsTrack ;\n    owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :TrackInAlbum\n] .\n\n# TrackInAlbum links to exactly one Track\n:TrackInAlbum rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :track ;\n    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :Track\n] .\n"
}
