 rdfs:label \\\"album recording\\\" ;\\n    rdfs:comment \\\"Inverse of recordedAlbum: Album's AlbumRecording.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :AlbumRecording ;\\n    owl:inverseOf :recordedAlbum .\\n\\n:containsTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"contains track\\\" ;\\n    rdfs:comment \\\"Indicates an album contains a track-in-album (reified).\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :TrackInAlbum ;\\n    owl:inverseOf :isContainedInAlbum .\\n\\n:isContainedInAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"is contained in album\\\" ;\\n    rdfs:comment \\\"Inverse of containsTrack: TrackInAlbum is contained in Album.\\\" ;\\n    rdfs:domain :TrackInAlbum ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :containsTrack .\\n\\n:track a owl:ObjectProperty ;\\n    rdfs:label \\\"track\\\" ;\\n    rdfs:comment \\\"The track in a track-in-album relation.\\\" ;\\n    rdfs:domain :TrackInAlbum ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackInAlbum .\\n\\n:trackInAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"track in album\\\" ;\\n    rdfs:comment \\\"Inverse of track: Track is included in TrackInAlbum.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :TrackInAlbum ;\\n    owl:inverseOf :track .\\n\\n:isRecordingOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is recording of\\\" ;\\n    rdfs:comment \\\"Indicates a track is a recording of a song.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :hasRecording .\\n\\n:hasRecording a owl:ObjectProperty ;\\n    rdfs:label \\\"has recording\\\" ;\\n    rdfs:comment \\\"Inverse of isRecordingOf: Song has recording Track.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :isRecordingOf .\\n\\n:composedSong a owl:ObjectProperty ;\\n    rdfs:label \\\"composed song\\\" ;\\n    rdfs:comment \\\"The song composed in a song composition event.\\\" ;\\n    rdfs:domain :SongComposition ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songComposition .\\n\\n:songComposition a owl:ObjectProperty ;\\n    rdfs:label \\\"song composition\\\" ;\\n    rdfs:comment \\\"Inverse of composedSong: Song's SongComposition event.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :SongComposition ;\\n    owl:inverseOf :composedSong .\\n\\n:hasCritique a owl:ObjectProperty ;\\n    rdfs:label \\\"has critique\\\" ;\\n    rdfs:comment \\\"Indicates an album has a critique.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critique ;\\n    owl:inverseOf :critiqueOf .\\n\\n:critiqueOf a owl:ObjectProperty ;\\n    rdfs:label \\\"critique of\\\" ;\\n    rdfs:comment \\\"Inverse of hasCritique: Critique of Album.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :hasCritique .\\n\\n:critic a owl:ObjectProperty ;\\n    rdfs:label \\\"critic\\\" ;\\n    rdfs:comment \\\"The critic in a critique.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :critiqueBy .\\n\\n:critiqueBy a owl:ObjectProperty ;\\n    rdfs:label \\\"critique by\\\" ;\\n    rdfs:comment \\\"Inverse of critic: Critic authored Critique.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Critique ;\\n    owl:inverseOf :critic .\\n\\n:performanceLocation a owl:ObjectProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"The city in which a performance takes place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityPerformance .\\n\\n:cityPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"city performance\\\" ;\\n    rdfs:comment \\\"Inverse of performanceLocation: City hosts Performance.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceLocation .\\n\\n:inRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"in region\\\" ;\\n    rdfs:comment \\\"The region in which a city is located.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :hasCity .\\n\\n