2026-02-14 22:23:11 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoice>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"A comprehensive ontology for UN/EDIFACT invoice messages, organizational roles, items, technical EDIFACT structure, and validation constraints, aligned with EN 16931-1 and P2P-O.\" .\n\n### CLASSES\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope in a UN/EDIFACT transmission, containing one or more messages.\" .\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A digital business document conforming to the UN/EDIFACT standard, contained within an Interchange Envelope.\" ;\n    rdfs:subClassOf :InterchangeEnvelope .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A specific type of EDIFACT message representing an invoice (e.g., INVOIC).\" ;\n    rdfs:subClassOf :EDIFACTMessage .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A structural component of an EDIFACT message, such as BGM or NAD.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"The Beginning of Message segment in an EDIFACT invoice, providing document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"The Name and Address segment in an EDIFACT invoice, specifying participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite element within a Segment, containing multiple Simple Data Elements.\" ;\n    rdfs:subClassOf :Segment .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a Composite Data Element.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:InvoiceHeaderSection a owl:Class ;\n    rdfs:label \"Invoice Header Section\" ;\n    rdfs:comment \"The header section of an invoice, containing document dates and reference numbers.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:InvoiceDetailSection a owl:Class ;\n    rdfs:label \"Invoice Detail Section\" ;\n    rdfs:comment \"The detail section of an invoice, listing individual line items.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:InvoiceSummarySection a owl:Class ;\n    rdfs:label \"Invoice Summary Section\" ;\n    rdfs:comment \"The summary section of an invoice, providing totals and tax information.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An entity involved in the business process, such as Buyer or Delivery Party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice, e.g., Buyer, Delivery Party.\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"The role of buyer in an invoice transaction.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"The role of delivery party in an invoice transaction.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A reification pivot class linking an organization to a specific role in the context of an invoice.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A general identifier for an organization, such as a registration or tax number.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A specific identifier for an organization, as defined by GS1.\" ;\n    rdfs:subClassOf :Identifier .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in an invoice.\" .\n\n:InvoiceLine a owl:Class ;\n    rdfs:label \"Invoice Line\" ;\n    rdfs:comment \"A line in the invoice detail section, referencing an item and its details.\" ;\n    rdfs:subClassOf :InvoiceDetailSection .\n\n:InvoiceLineItemDetail a owl:Class ;\n    rdfs:label \"Invoice Line Item Detail\" ;\n    rdfs:comment \"A reification pivot class linking an invoice line to an item, price, and quantity.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value associated with an item in an invoice.\" ;\n    rdfs:subClassOf :InvoiceLine .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax value applied in the summary section of an invoice.\" ;\n    rdfs:subClassOf :InvoiceSummarySection .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A process such as Purchase-to-Pay to which an invoice can be assigned.\" .\n\n:Standard a owl:Class ;\n    rdfs:label \"Standard\" ;\n    rdfs:comment \"A standard to which an invoice message conforms, e.g., EN 16931-1, D96A.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint for validating invoice data, e.g., SHACL shapes.\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"A SHACL shape or rule used for validation.\" .\n\n:EDIFACTDelimiter a owl:Class ;\n    rdfs:label \"EDIFACT Delimiter\" ;\n    rdfs:comment \"A delimiter symbol used in EDIFACT messages, such as plus or colon.\" .\n\n### OBJECT PROPERTIES\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an Interchange Envelope to the EDIFACT message(s) it contains.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :EDIFACTMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates an EDIFACT message to its segments.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Relates an Invoice Message to its sections (header, detail, summary).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeaderSection, :InvoiceDetailSection, :InvoiceSummarySection .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Relates an invoice message to an organization role assignment (reification).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the Organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the AgentRole.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Relates an organization to its identifier.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n\n:hasGLN a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Relates an organization to its Global Location Number.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates an invoice detail section to its invoice lines.\" ;\n    rdfs:domain :InvoiceDetailSection ;\n    rdfs:range :InvoiceLine .\n\n:detailsLineItem a owl:ObjectProperty ;\n    rdfs:label \"details line item\" ;\n    rdfs:comment \"Relates an invoice line to its item detail (reification).\" ;\n    rdfs:domain :InvoiceLine ;\n    rdfs:range :InvoiceLineItemDetail .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates an invoice line item detail to the item.\" ;\n    rdfs:domain :InvoiceLineItemDetail ;\n    rdfs:range :Item .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Relates an invoice line item detail to the price.\" ;\n    rdfs:domain :InvoiceLineItemDetail ;\n    rdfs:range :Price .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Relates an invoice summary section to the tax.\" ;\n    rdfs:domain :InvoiceSummarySection ;\n    rdfs:range :Tax .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Relates an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n:conformsToStandard a owl:ObjectProperty ;\n    rdfs:label \"conforms to standard\" ;\n    rdfs:comment \"Relates an invoice message to the standard it conforms to.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Standard .\n\n:validatedBy a owl:ObjectProperty ;\n    rdfs:label \"validated by\" ;\n    rdfs:comment \"Relates an invoice message to its validation constraint(s).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint .\n\n:usesSHACLConstraint a owl:ObjectProperty ;\n    rdfs:label \"uses SHACL constraint\" ;\n    rdfs:comment \"Relates a validation constraint to a SHACL constraint.\" ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :SHACLConstraint .\n\n:usesDelimiter a owl:ObjectProperty ;\n    rdfs:label \"uses delimiter\" ;\n    rdfs:comment \"Relates an EDIFACT message to a delimiter symbol.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTDelimiter .\n\n### DATA PROPERTIES\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Specifies the quantity of an item in an invoice line item detail.\" ;\n    rdfs:domain :InvoiceLineItemDetail ;\n    rdfs:range xsd:decimal .\n\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Specifies the net price of an item in an invoice.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Specifies the total invoice amount in the summary section.\" ;\n    rdfs:domain :InvoiceSummarySection ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Specifies the invoice number in the header section.\" ;\n    rdfs:domain :InvoiceHeaderSection ;\n    rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Specifies the document date in the header section.\" ;\n    rdfs:domain :InvoiceHeaderSection ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Specifies the reference number in the header section.\" ;\n    rdfs:domain :InvoiceHeaderSection ;\n    rdfs:range xsd:string .\n\n:delimiterSymbol a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"delimiter symbol\" ;\n    rdfs:comment \"The symbol string for an EDIFACT delimiter (e.g., '+', ':').\" ;\n    rdfs:domain :EDIFACTDelimiter ;\n    rdfs:range xsd:string .\n\n### AXIOMS AND RESTRICTIONS\n\n:BuyerRole owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      :AgentRole\n      [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :BuyerRole ]\n    )\n] .\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :InvoiceHeaderSection\n] , [\n    a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :InvoiceDetailSection\n] , [\n    a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :InvoiceSummarySection\n] .\n\n:OrganizationRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Organization\n] , [\n    a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole\n] .\n\n### DISJOINTNESS\n\n:InterchangeEnvelope owl:disjointWith :Organization .\n:InvoiceMessage owl:disjointWith :Organization .\n:AgentRole owl:disjointWith :Item .\n:Address owl:disjointWith :BusinessProcess .\n\n### ANNOTATIONS\n\n# (Annotations for all classes and properties are included above with rdfs:label and rdfs:comment.)\n"
}
