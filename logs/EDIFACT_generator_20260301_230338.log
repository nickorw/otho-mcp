nvoice message.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the transaction.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction, e.g., Buyer, Seller, Delivery Party.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for assigning roles to organizations within an invoice message.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address for an organization.\" .\n\n:InvoiceLineItem a owl:Class ;\n    rdfs:label \"Invoice Line Item\" ;\n    rdfs:comment \"Pivot class for line items in an invoice, linking to items and prices.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an invoice line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice may be assigned.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an interchange envelope to its contained messages.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a message to its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Relates an invoice message to its sections (header, detail, summary).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range [ a owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Relates an invoice message to an organization role assignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:assignedOrganization a owl:ObjectProperty ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"Relates an organization role assignment to an organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    owl:FunctionalProperty .\n\n:assignedRole a owl:ObjectProperty ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"Relates an organization role assignment to an agent role.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates an invoice message to its line items.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceLineItem .\n\n:itemOf a owl:ObjectProperty ;\n    rdfs:label \"item of\" ;\n    rdfs:comment \"Relates an invoice line item to its item.\" ;\n    rdfs:domain :InvoiceLineItem ;\n    rdfs:range :Item ;\n    owl:FunctionalProperty .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Relates an invoice line item to its price.\" ;\n    rdfs:domain :InvoiceLineItem ;\n    rdfs:range :Price ;\n    owl:FunctionalProperty .\n\n:partOfProcess a owl:ObjectProperty ;\n    rdfs:label \"part of process\" ;\n    rdfs:comment \"Relates an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:invoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The number identifying the invoice.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n:invoiceDate a owl:DatatypeProperty ;\n    rdfs:label \"invoice date\" ;\n    rdfs:comment \"The date of the invoice as string (use ISO 8601 format).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n:totalAmount a owl:DatatypeProperty ;\n    rdfs:label \"total amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:decimal .\n\n:taxAmount a owl:DatatypeProperty ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"Total tax amount of the invoice.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:decimal .\n\n:quantity a owl:DatatypeProperty ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"Quantity of items in an invoice line item.\" ;\n    rdfs:domain :InvoiceLineItem ;\n    rdfs:range xsd:decimal .\n\n:netPrice a owl:DatatypeProperty ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"Net price of an item in the invoice.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The address line of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:roleType a owl:DatatypeProperty ;\n    rdfs:label \"role type\" ;\n    rdfs:comment \"Type of agent role (e.g., Buyer, Seller).\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"Description of the item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:itemIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"item identifier\" ;\n    rdfs:comment \"Identifier of the item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:hasIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"An identifier (such as GLN) for the organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n#################################################################\n# Class Disjointness\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :AgentRole .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n\n#################################################################\n# Restrictions & GCAs (Examples)\n#################################################################\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasSection ;\n    owl:someValuesFrom :HeaderSection\n], [\n    a owl:Restriction ;\n    owl:onProperty :hasSection ;\n    owl:someValuesFrom :DetailSection\n], [\n    a owl:Restriction ;\n    owl:onProperty :hasSection ;\n    owl:someValuesFrom :SummarySection\n] .\n\n:OrganizationRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :assignedOrganization ;\n    owl:allValuesFrom :Organization\n], [\n    a owl:Restriction ;\n    owl:onProperty :assignedRole ;\n    owl:allValuesFrom :AgentRole\n] .\n\n:InvoiceLineItem rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :itemOf ;\n    owl:allValuesFrom :Item\n], [\n    a owl:Restriction ;\n    owl:onProperty :hasPrice ;\n    owl:allValuesFrom :Price\n] ."
}
