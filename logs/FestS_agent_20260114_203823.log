  "tool_calls": [
    {
      "id": "call_6216EQKH1GJU8pTHvsJm7Mjq",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/story_TheatreProductions> a owl:Ontology ;\\n  rdfs:label \\\"Theatre Productions Ontology\\\" ;\\n  rdfs:comment \\\"An ontology to represent theatre festivals, productions, plays, ensembles, people, and their participations and reviews based on the provided story and competency questions.\\\" .\\n\\n### Classes\\n:Person a owl:Class ;\\n  rdfs:label \\\"Person\\\" ;\\n  rdfs:comment \\\"A human individual involved in theatre productions.\\\" ;\\n  owl:disjointWith :Theatre, :Ensemble, :City, :Country .\\n:Actor a owl:Class ;\\n  rdfs:label \\\"Actor\\\" ;\\n  rdfs:comment \\\"A person who performs in plays.\\\" ;\\n  rdfs:subClassOf :Person ;\\n  owl:disjointWith :Author .\\n:Author a owl:Class ;\\n  rdfs:label \\\"Author\\\" ;\\n  rdfs:comment \\\"A person who writes plays.\\\" ;\\n  rdfs:subClassOf :Person ;\\n  owl:disjointWith :Actor .\\n:Theatre a owl:Class ;\\n  rdfs:label \\\"Theatre\\\" ;\\n  rdfs:comment \\\"A venue for theatrical performances.\\\" ;\\n  owl:disjointWith :Ensemble .\\n:Ensemble a owl:Class ;\\n  rdfs:label \\\"Ensemble\\\" ;\\n  rdfs:comment \\\"A group of people performing together in a production.\\\" ;\\n  owl:disjointWith :Theatre .\\n:TheatreFestival a owl:Class ;\\n  rdfs:label \\\"Theatre Festival\\\" ;\\n  rdfs:comment \\\"An event featuring theatre productions, often held annually.\\\" ;\\n  owl:disjointWith :Production .\\n:City a owl:Class ;\\n  rdfs:label \\\"City\\\" ;\\n  rdfs:comment \\\"A city where theatres and festivals are located.\\\" ;\\n  owl:disjointWith :Country .\\n:Country a owl:Class ;\\n  rdfs:label \\\"Country\\\" ;\\n  rdfs:comment \\\"A country in which cities are located.\\\" ;\\n  owl:disjointWith :City .\\n:Play a owl:Class ;\\n  rdfs:label \\\"Play\\\" ;\\n  rdfs:comment \\\"A dramatic work performed in a theatre.\\\" .\\n:Production a owl:Class ;\\n  rdfs:label \\\"Production\\\" ;\\n  rdfs:comment \\\"A specific staging of a play.\\\" ;\\n  owl:disjointWith :TheatreFestival .\\n:Role a owl:Class ;\\n  rdfs:label \\\"Role\\\" ;\\n  rdfs:comment \\\"A character or part played by an actor in a production.\\\" .\\n:Review a owl:Class ;\\n  rdfs:label \\\"Review\\\" ;\\n  rdfs:comment \\\"A critical assessment of a production.\\\" .\\n:Newspaper a owl:Class ;\\n  rdfs:label \\\"Newspaper\\\" ;\\n  rdfs:comment \\\"A newspaper that publishes reviews.\\\" .\\n:Act a owl:Class ;\\n  rdfs:label \\\"Act\\\" ;\\n  rdfs:comment \\\"A major division of a play.\\\" .\\n:StarRating a owl:Class ;\\n  rdfs:label \\\"Star Rating\\\" ;\\n  rdfs:comment \\\"A rating given to a production in a review.\\\" .\\n\\n### Pivot Classes (Reification)\\n:Membership a owl:Class ;\\n  rdfs:label \\\"Membership\\\" ;\\n  rdfs:comment \\\"A reified relation representing a person's membership in an ensemble at a point in time.\\\" .\\n:Employment a owl:Class ;\\n  rdfs:label \\\"Employment\\\" ;\\n  rdfs:comment \\\"A reified relation representing a person's employment at a theatre, including start date.\\\" .\\n:Participation a owl:Class ;\\n  rdfs:label \\\"Participation\\\" ;\\n  rdfs:comment \\\"A reified relation representing a person's participation in a production, including role and time.\\\" .\\n:Performance a owl:Class ;\\n  rdfs:label \\\"Performance\\\" ;\\n  rdfs:comment \\\"A reified event representing a performance, such as a premier, with a date.\\\" .\\n\\n### Object Properties\\n:hasFestivalLocation a owl:ObjectProperty ;\\n  rdfs:label \\\"has festival location\\\" ;\\n  rdfs:comment \\\"Links a theatre festival to the city it takes place in.\\\" ;\\n  rdfs:domain :TheatreFestival ;\\n  rdfs:range :City ;\\n  owl:inverseOf :isFestivalLocationOf .\\n:isFestivalLocationOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is festival location of\\\" ;\\n  rdfs:comment \\\"Inverse of hasFestivalLocation.\\\" ;\\n  rdfs:domain :City ;\\n  rdfs:range :TheatreFestival .\\n:featuresPlay a owl:ObjectProperty ;\\n  rdfs:label \\\"features play\\\" ;\\n  rdfs:comment \\\"Links a theatre festival to a play featured in it.\\\" ;\\n  rdfs:domain :TheatreFestival ;\\n  rdfs:range :Play ;\\n  owl:inverseOf :isFeaturedInFestival .\\n:isFeaturedInFestival a owl:ObjectProperty ;\\n  rdfs:label \\\"is featured in festival\\\" ;\\n  rdfs:comment \\\"Inverse of featuresPlay.\\\" ;\\n  rdfs:domain :Play ;\\n  rdfs:range :TheatreFestival .\\n:locatedIn a owl:ObjectProperty ;\\n  rdfs:label \\\"located in\\\" ;\\n  rdfs:comment \\\"Links a theatre to the city it is located in.\\\" ;\\n  rdfs:domain :Theatre ;\\n  rdfs:range :City ;\\n  owl:inverseOf :hasTheatre .\\n:hasTheatre a owl:ObjectProperty ;\\n  rdfs:label \\\"has theatre\\\" ;\\n  rdfs:comment \\\"Inverse of locatedIn.\\\" ;\\n  rdfs:domain :City ;\\n  rdfs:range :Theatre .\\n:cityInCountry a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"city in country\\\" ;\\n  rdfs:comment \\\"Links a city to the country it is in.\\\" ;\\n  rdfs:domain :City ;\\n  rdfs:range :Country ;\\n  owl:inverseOf :hasCity .\\n:hasCity a owl:ObjectProperty ;\\n  rdfs:label \\\"has city\\\" ;\\n  rdfs:comment \\\"Inverse of cityInCountry.\\\" ;\\n  rdfs:domain :Country ;\\n  rdfs:range :City .\\n:productionOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"production of\\\" ;\\n  rdfs:comment \\\"Links a production to the play it stages.\\\" ;\\n  rdfs:domain :Production ;\\n  rdfs:range :Play ;\\n  owl:inverseOf :hasProduction .\\n:hasProduction a owl:ObjectProperty ;\\n  rdfs:label \\\"has production\\\" ;\\n  rdfs:comment \\\"Inverse of productionOf.\\\" ;\\n  rdfs:domain :Play ;\\n  rdfs:range :Production .\\n:hasEnsemble a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"has ensemble\\\" ;\\n  rdfs:comment \\\"Links a production to its ensemble.\\\" ;\\n  rdfs:domain :Production ;\\n  rdfs:range :Ensemble ;\\n  owl:inverseOf :isEnsembleOf .\\n:isEnsembleOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is ensemble of\\\" ;\\n  rdfs:comment \\\"Inverse of hasEnsemble.\\\" ;\\n  rdfs:domain :Ensemble ;\\n  rdfs:range :Production .\\n:hasMember a owl:ObjectProperty ;\\n  rdfs:label \\\"has member\\\" ;\\n  rdfs:comment \\\"Links an ensemble to its members.\\\" ;\\n  rdfs:domain :Ensemble ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :isMemberOf .\\n:isMemberOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is member of\\\" ;\\n  rdfs:comment \\\"Inverse of hasMember.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :Ensemble .\\n:wrote a owl:ObjectProperty ;\\n  rdfs:label \\\"wrote\\\" ;\\n  rdfs:comment \\\"Links an author to plays they wrote.\\\" ;\\n  rdfs:domain :Author ;\\n  rdfs:range :Play ;\\n  owl:inverseOf :wasWrittenBy .\\n:wasWrittenBy a owl:ObjectProperty ;\\n  rdfs:label \\\"was written by\\\" ;\\n  rdfs:comment \\\"Inverse of wrote.\\\" ;\\n  rdfs:domain :Play ;\\n  rdfs:range :Author .\\n:hasAct a owl:ObjectProperty ;\\n  rdfs:label \\\"has act\\\" ;\\n  rdfs:comment \\\"Links a play to its acts.\\\" ;\\n  rdfs:domain :Play ;\\n  rdfs:range :Act ;\\n  owl:inverseOf :isActOf .\\n:isActOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is act of\\\" ;\\n  rdfs:comment \\\"Inverse of hasAct.\\\" ;\\n  rdfs:domain :Act ;\\n  rdfs:range :Play .\\n:hasPremier a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"has premier\\\" ;\\n  rdfs:comment \\\"Links a production to its premier performance (functional: only one premier).\\\" ;\\n  rdfs:domain :Production ;\\n  rdfs:range :Performance ;\\n  owl:inverseOf :isPremierOf .\\n:isPremierOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is premier of\\\" ;\\n  rdfs:comment \\\"Inverse of hasPremier.\\\" ;\\n  rdfs:domain :Performance ;\\n  rdfs:range :Production .\\n:reviewedBy a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"reviewed by\\\" ;\\n  rdfs:comment \\\"Links a review to the newspaper that published it.\\\" ;\\n  rdfs:domain :Review ;\\n  rdfs:range :Newspaper ;\\n  owl:inverseOf :reviews .\\n:reviews a owl:ObjectProperty ;\\n  rdfs:label \\\"reviews\\\" ;\\n  rdfs:comment \\\"Inverse of reviewedBy.\\\" ;\\n  rdfs:domain :Newspaper ;\\n  rdfs:range :Review .\\n:reviewOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"review of\\\" ;\\n  rdfs:comment \\\"Links a review to the production it assesses.\\\" ;\\n  rdfs:domain :Review ;\\n  rdfs:range :Production ;\\n  owl:inverseOf :hasReview .\\n:hasReview a owl:ObjectProperty ;\\n  rdfs:label \\\"has review\\\" ;\\n  rdfs:comment \\\"Inverse of reviewOf.\\\" ;\\n  rdfs:domain :Production ;\\n  rdfs:range :Review .\\n:hasStarRating a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"has star rating\\\" ;\\n  rdfs:comment \\\"Links a review to its star rating.\\\" ;\\n  rdfs:domain :Review ;\\n  rdfs:range :StarRating ;\\n  owl:inverseOf :isStarRatingOf .\\n:isStarRatingOf a owl:ObjectProperty ;\\n  rdfs:label \\\"is star rating of\\\" ;\\n  rdfs:comment \\\"Inverse of hasStarRating.\\\" ;\\n  rdfs:domain :StarRating ;\\n  rdfs:range :Review .\\n:employedAt a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"employed at\\\" ;\\n  rdfs:comment \\\"Links an employment relation to the theatre.\\\" ;\\n  rdfs:domain :Employment ;\\n  rdfs:range :Theatre ;\\n  owl:inverseOf :hasEmployeeRelation .\\n:hasEmployeeRelation a owl:ObjectProperty ;\\n  rdfs:label \\\"has employee relation\\\" ;\\n  rdfs:comment \\\"Inverse of employedAt.\\\" ;\\n  rdfs:domain :Theatre ;\\n  rdfs:range :Employment .\\n:employee a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"employee\\\" ;\\n  rdfs:comment \\\"Links an employment relation to the person employed.\\\" ;\\n  rdfs:domain :Employment ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :employmentRelationOf .\\n:employmentRelationOf a owl:ObjectProperty ;\\n  rdfs:label \\\"employment relation of\\\" ;\\n  rdfs:comment \\\"Inverse of employee.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :Employment .\\n:memberOfEnsemble a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"member of ensemble\\\" ;\\n  rdfs:comment \\\"Links a membership relation to the ensemble.\\\" ;\\n  rdfs:domain :Membership ;\\n  rdfs:range :Ensemble ;\\n  owl:inverseOf :hasMembership .\\n:hasMembership a owl:ObjectProperty ;\\n  rdfs:label \\\"has membership\\\" ;\\n  rdfs:comment \\\"Inverse of memberOfEnsemble.\\\" ;\\n  rdfs:domain :Ensemble ;\\n  rdfs:range :Membership .\\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"member person\\\" ;\\n  rdfs:comment \\\"Links a membership relation to the person.\\\" ;\\n  rdfs:domain :Membership ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :membershipRelationOf .\\n:membershipRelationOf a owl:ObjectProperty ;\\n  rdfs:label \\\"membership relation of\\\" ;\\n  rdfs:comment \\\"Inverse of memberPerson.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :Membership .\\n:participationInProduction a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"participation in production\\\" ;\\n  rdfs:comment \\\"Links a participation relation to the production.\\\" ;\\n  rdfs:domain :Participation ;\\n  rdfs:range :Production ;\\n  owl:inverseOf :hasParticipation .\\n:hasParticipation a owl:ObjectProperty ;\\n  rdfs:label \\\"has participation\\\" ;\\n  rdfs:comment \\\"Inverse of participationInProduction.\\\" ;\\n  rdfs:domain :Production ;\\n  rdfs:range :Participation .\\n:participant a owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"participant\\\" ;\\n  rdfs:comment \\\"Links a participation relation to the person involved.\\\" ;\\n  rdfs:domain :Participation ;\\n  rdfs:range :Person ;\\n  owl:inverseOf :participationRelationOf .\\n:participationRelationOf a owl:ObjectProperty ;\\n  rdfs:label \\\"participation relation of\\\" ;\\n  rdfs:comment \\\"Inverse of participant.\\\" ;\\n  rdfs:domain :Person ;\\n  rdfs:range :Participation .\\n:playedRole a owl:ObjectProperty ;\\n  rdfs:label \\\"played role\\\" ;\\n  rdfs:comment \\\"Links a participation relation to the role played.\\\" ;\\n  rdfs:domain :Participation ;\\n  rdfs:range :Role ;\\n  owl:inverseOf :wasPlayedByParticipation .\\n:wasPlayedByParticipation a owl:ObjectProperty ;\\n  rdfs:label \\\"was played by participation\\\" ;\\n  rdfs:comment \\\"Inverse of playedRole.\\\" ;\\n  rdfs:domain :Role ;\\n  rdfs:range :Participation .\\n\\n### Data Properties\\n:hasFestivalDate a owl:DatatypeProperty ;\\n  rdfs:label \\\"has festival date\\\" ;\\n  rdfs:comment \\\"Links a theatre festival to its date.\\\" ;\\n  rdfs:domain :TheatreFestival ;\\n  rdfs:range xsd:dateTime .\\n:performanceDate a owl:DatatypeProperty ;\\n  rdfs:label \\\"performance date\\\" ;\\n  rdfs:comment \\\"The date of a performance (such as a premier).\\\" ;\\n  rdfs:domain :Performance ;\\n  rdfs:range xsd:dateTime .\\n:employmentStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"employment start\\\" ;\\n  rdfs:comment \\\"The start date for an employment relation.\\\" ;\\n  rdfs:domain :Employment ;\\n  rdfs:range xsd:dateTime .\\n:membershipStart a owl:DatatypeProperty ;\\n  rdfs:label \\\"membership start\\\" ;\\n  rdfs:comment \\\"The start date for a membership relation in an ensemble.\\\" ;\\n  rdfs:domain :Membership ;\\n  rdfs:range xsd:dateTime .\\n:participationTime a owl:DatatypeProperty ;\\n  rdfs:label \\\"participation time\\\" ;\\n  rdfs:comment \\\"The time (date) when a participation occurs.\\\" ;\\n  rdfs:domain :Participation ;\\n  rdfs:range xsd:dateTime .\\n:actNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"act number\\\" ;\\n  rdfs:comment \\\"The number of an act within a play.\\\" ;\\n  rdfs:domain :Act ;\\n  rdfs:range xsd:integer .\\n:starRatingValue a owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"star rating value\\\" ;\\n  rdfs:comment \\\"The integer value of a star rating (e.g., 1-5).\\\" ;\\n  rdfs:domain :StarRating ;\\n  rdfs:range xsd:integer .\\n\\n### Property Characteristics\\n:cityInCountry a owl:FunctionalProperty .\\n:productionOf a owl:FunctionalProperty .\\n:hasEnsemble a owl:FunctionalProperty .\\n:hasPremier a owl:FunctionalProperty .\\n:reviewedBy a owl:FunctionalProperty .\\n:reviewOf a owl:FunctionalProperty .\\n:hasStarRating a owl:FunctionalProperty .\\n:employedAt a owl:FunctionalProperty .\\n:employee a owl:FunctionalProperty .\\n:memberOfEnsemble a owl:FunctionalProperty .\\n:memberPerson a owl:FunctionalProperty .\\n:participationInProduction a owl:FunctionalProperty .\\n:participant a owl:FunctionalProperty .\\n:actNumber a owl:FunctionalProperty .\\n:starRatingValue a owl:FunctionalProperty .\\n\\n### Restrictions & GCAs\\n# Production must have exactly one premier\\n:Production rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasPremier ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ] .\\n# Participation links a person, a production, a role, and a time\\n:Participation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :participant ; owl:someValuesFrom :Person ] ,\\n  [ a owl:Restriction ; owl:onProperty :participationInProduction ; owl:someValuesFrom :Production ] ,\\n  [ a owl:Restriction ; owl:onProperty :playedRole ; owl:someValuesFrom :Role ] .\\n# Membership links a person, an ensemble, and a time\\n:Membership rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :memberPerson ; owl:someValuesFrom :Person ] ,\\n  [ a owl:Restriction ; owl:onProperty :memberOfEnsemble ; owl:someValuesFrom :Ensemble ] .\\n# Employment links a person, a theatre, and a start date\\n:Employment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :employee ; owl:someValuesFrom :Person ] ,\\n  [ a owl:Restriction ; owl:onProperty :employedAt ; owl:someValuesFrom :Theatre ] .\\n# Play has acts\\n:Play rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAct ; owl:someValuesFrom :Act ] .\\n# Review must be of a production and by a newspaper\\n:Review rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :reviewOf ; owl:someValuesFrom :Production ] ,\\n  [ a owl:Restriction ; owl:onProperty :reviewedBy ; owl:someValuesFrom :Newspaper ] .\\n\"}",
