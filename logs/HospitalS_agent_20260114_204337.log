        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/hospital-story>\\n    a owl:Ontology ;\\n    rdfs:label \\\"Hospital Story Ontology\\\" ;\\n    rdfs:comment \\\"An ontology modeling hospital staff, unions, employment, publications, and seminars as described in the provided story.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual involved in the hospital context.\\\" .\\n\\n:Doctor a owl:Class ;\\n    rdfs:label \\\"Doctor\\\" ;\\n    rdfs:comment \\\"A person who is a doctor.\\\" ;\\n    rdfs:subClassOf :Person .\\n\\n:Nurse a owl:Class ;\\n    rdfs:label \\\"Nurse\\\" ;\\n    rdfs:comment \\\"A person who is a certified nurse.\\\" ;\\n    rdfs:subClassOf :Person .\\n\\n:NursingAssistant a owl:Class ;\\n    rdfs:label \\\"Nursing Assistant\\\" ;\\n    rdfs:comment \\\"A person who is a nursing assistant.\\\" ;\\n    rdfs:subClassOf :Person .\\n\\n:Staff a owl:Class ;\\n    rdfs:label \\\"Staff\\\" ;\\n    rdfs:comment \\\"A person who is a member of the hospital staff.\\\" ;\\n    rdfs:subClassOf :Person .\\n\\n:Degree a owl:Class ;\\n    rdfs:label \\\"Degree\\\" ;\\n    rdfs:comment \\\"A medical or nursing degree.\\\" .\\n\\n:Employment a owl:Class ;\\n    rdfs:label \\\"Employment\\\" ;\\n    rdfs:comment \\\"A reified relationship representing a person's employment at a hospital.\\\" .\\n\\n:Hospital a owl:Class ;\\n    rdfs:label \\\"Hospital\\\" ;\\n    rdfs:comment \\\"A hospital institution.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\