rty ;\\n    rdfs:label \\\"evaluated by\\\" ;\\n    rdfs:comment \\\"Relates an evaluation to the doctor who performed it.\\\" ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range :Doctor ;\\n    owl:inverseOf :performedEvaluation .\\n\\n:performedEvaluation a owl:ObjectProperty ;\\n    rdfs:label \\\"performed evaluation\\\" ;\\n    rdfs:comment \\\"Inverse of evaluatedBy: Relates a doctor to an evaluation they performed.\\\" ;\\n    rdfs:domain :Doctor ;\\n    rdfs:range :Evaluation ;\\n    owl:inverseOf :evaluatedBy .\\n\\n:evaluatesEmployee a owl:ObjectProperty ;\\n    rdfs:label \\\"evaluates employee\\\" ;\\n    rdfs:comment \\\"Relates an evaluation to the staff member being evaluated.\\\" ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range :Staff ;\\n    owl:inverseOf :isEvaluationOf .\\n\\n:isEvaluationOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is evaluation of\\\" ;\\n    rdfs:comment \\\"Inverse of evaluatesEmployee: Relates a staff member to an evaluation.\\\" ;\\n    rdfs:domain :Staff ;\\n    rdfs:range :Evaluation ;\\n    owl:inverseOf :evaluatesEmployee .\\n\\n:containsArticle a owl:ObjectProperty ;\\n    rdfs:label \\\"contains article\\\" ;\\n    rdfs:comment \\\"Relates an article collection to an article it contains.\\\" ;\\n    rdfs:domain :ArticleCollection ;\\n    rdfs:range :Article ;\\n    owl:inverseOf :isContainedIn .\\n\\n:isContainedIn a owl:ObjectProperty ;\\n    rdfs:label \\\"is contained in\\\" ;\\n    rdfs:comment \\\"Inverse of containsArticle: Relates an article to the collection it is contained in.\\\" ;\\n    rdfs:domain :Article ;\\n    rdfs:range :ArticleCollection ;\\n    owl:inverseOf :containsArticle .\\n\\n:publishedAsBook a owl:ObjectProperty ;\\n    rdfs:label \\\"published as book\\\" ;\\n    rdfs:comment \\\"Relates an article collection to its book form.\\\" ;\\n    rdfs:domain :ArticleCollection ;\\n    rdfs:range :Book ;\\n    owl:inverseOf :isBookPublicationOf .\\n\\n:isBookPublicationOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is book publication of\\\" ;\\n    rdfs:comment \\\"Inverse of publishedAsBook: Relates a book to the article collection it publishes.\\\" ;\\n    rdfs:domain :Book ;\\n    rdfs:range :ArticleCollection ;\\n    owl:inverseOf :publishedAsBook .\\n\\n:publishedAsCD a owl:ObjectProperty ;\\n    rdfs:label \\\"published as CD\\\" ;\\n    rdfs:comment \\\"Relates an article collection to its CD form.\\\" ;\\n    rdfs:domain :ArticleCollection ;\\n    rdfs:range :CD ;\\n    owl:inverseOf :isCDPublicationOf .\\n\\n:isCDPublicationOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is CD publication of\\\" ;\\n    rdfs:comment \\\"Inverse of publishedAsCD: Relates a CD to the article collection it publishes.\\\" ;\\n    rdfs:domain :CD ;\\n    rdfs:range :ArticleCollection ;\\n    owl:inverseOf :publishedAsCD .\\n\\n:presentedAtSeminar a owl:ObjectProperty ;\\n    rdfs:label \\\"presented at seminar\\\" ;\\n    rdfs:comment \\\"Relates an article to the seminar where it was presented.\\\" ;\\n    rdfs:domain :Article ;\\n    rdfs:range :Seminar ;\\n    owl:inverseOf :hasPresentedArticle .\\n\\n:hasPresentedArticle a owl:ObjectProperty ;\\n    rdfs:label \\\"has presented article\\\" ;\\n    rdfs:comment \\\"Inverse of presentedAtSeminar: Relates a seminar to an article presented at it.\\\" ;\\n    rdfs:domain :Seminar ;\\n    rdfs:range :Article ;\\n    owl:inverseOf :presentedAtSeminar .\\n\\n:seminarLocation a owl:ObjectProperty ;\\n    rdfs:label \\\"seminar location\\\" ;\\n    rdfs:comment \\\"Relates a seminar to the hospital where it was held.\\\" ;\\n    rdfs:domain :Seminar ;\\n    rdfs:range :Hospital ;\\n    owl:inverseOf :locationOfSeminar .\\n\\n:locationOfSeminar a owl:ObjectProperty ;\\n    rdfs:label \\\"location of seminar\\\" ;\\n    rdfs:comment \\\"Inverse of seminarLocation: Relates a hospital to a seminar held there.\\\" ;\\n    rdfs:domain :Hospital ;\\n    rdfs:range :Seminar ;\\n    owl:inverseOf :seminarLocation .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:studyStartDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"study start date\\\" ;\\n    rdfs:comment \\\"The start date of a person's studies for a degree.\\\" ;\\n    rdfs:domain :Employment ;\\n    rdfs:range xsd:dateTime .\\n\\n:studyEndDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"study end date\\\" ;\\n    rdfs:comment \\\"The end date of a person's studies for a degree.\\\" ;\\n    rdfs:domain :Employment ;\\n    rdfs:range xsd:dateTime .\\n\\n:employmentStartDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"employment start date\\\" ;\\n    rdfs:comment \\\"The date when employment started.\\\" ;\\n    rdfs:domain :Employment ;\\n    rdfs:range xsd:dateTime .\\n\\n:unionMembershipStartDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"union membership start date\\\" ;\\n    rdfs:comment \\\"The date when a union membership started.\\\" ;\\n    rdfs:domain :UnionMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:evaluationStatement a owl:DatatypeProperty ;\\n    rdfs:label \\\"evaluation statement\\\" ;\\n    rdfs:comment \\\"The written statement of an evaluation.\\\" ;\\n    rdfs:domain :Evaluation ;\\n    rdfs:range xsd:string .\\n\\n:bookPageCount a owl:DatatypeProperty ;\\n    rdfs:label \\\"book page count\\\" ;\\n    rdfs:comment \\\"The number of pages in a book.\\\" ;\\n    rdfs:domain :Book ;\\n    rdfs:range xsd:integer .\\n\\n:publicationDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"publication date\\\" ;\\n    rdfs:comment \\\"The publication date of a book.\\\" ;\\n    rdfs:domain :Book ;\\n    rdfs:range xsd:dateTime .\\n\\n:publicationDateCD a owl:DatatypeProperty ;\\n    rdfs:label \\\"CD publication date\\\" ;\\n    rdfs:comment \\\"The publication date of a CD.\\\" ;\\n    rdfs:domain :CD ;\\n    rdfs:range xsd:dateTime .\\n\\n:seminarDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"seminar date\\\" ;\\n    rdfs:comment \\\"The date of a seminar.\\\" ;\\n    rdfs:domain :Seminar ;\\n    rdfs:range xsd:dateTime .\\n\\n#################################################################\\n# General Class Axioms & Restrictions\\n#################################################################\\n\\n# Seminar must have at least one presented article\\n:Seminar rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :hasPresentedArticle ;\\n    owl:minQualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ;\\n    owl:onClass :Article\\n] .\\n\"}",
