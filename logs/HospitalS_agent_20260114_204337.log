      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/hospital-story>\n    a owl:Ontology ;\n    rdfs:label \"Hospital Story Ontology\" ;\n    rdfs:comment \"An ontology modeling hospital staff, unions, employment, publications, and seminars as described in the provided story.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual involved in the hospital context.\" .\n\n:Doctor a owl:Class ;\n    rdfs:label \"Doctor\" ;\n    rdfs:comment \"A person who is a doctor.\" ;\n    rdfs:subClassOf :Person .\n\n:Nurse a owl:Class ;\n    rdfs:label \"Nurse\" ;\n    rdfs:comment \"A person who is a certified nurse.\" ;\n    rdfs:subClassOf :Person .\n\n:NursingAssistant a owl:Class ;\n    rdfs:label \"Nursing Assistant\" ;\n    rdfs:comment \"A person who is a nursing assistant.\" ;\n    rdfs:subClassOf :Person .\n\n:Staff a owl:Class ;\n    rdfs:label \"Staff\" ;\n    rdfs:comment \"A person who is a member of the hospital staff.\" ;\n    rdfs:subClassOf :Person .\n\n:Degree a owl:Class ;\n    rdfs:label \"Degree\" ;\n    rdfs:comment \"A medical or nursing degree.\" .\n\n:Employment a owl:Class ;\n    rdfs:label \"Employment\" ;\n    rdfs:comment \"A reified relationship representing a person's employment at a hospital.\" .\n\n:Hospital a owl:Class ;\n    rdfs:label \"Hospital\" ;\n    rdfs:comment \"A hospital institution.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where hospitals are located.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country in which a city is located.\" .\n\n:Union a owl:Class ;\n    rdfs:label \"Union\" ;\n    rdfs:comment \"A union organizing hospital staff.\" .\n\n:UnionMembership a owl:Class ;\n    rdfs:label \"Union Membership\" ;\n    rdfs:comment \"A reified relationship representing a person's membership in a union.\" .\n\n:UnionRole a owl:Class ;\n    rdfs:label \"Union Role\" ;\n    rdfs:comment \"A role held by a person within a union.\" .\n\n:Evaluation a owl:Class ;\n    rdfs:label \"Evaluation\" ;\n    rdfs:comment \"A written evaluation statement given by a doctor for a staff member.\" .\n\n:Article a owl:Class ;\n    rdfs:label \"Article\" ;\n    rdfs:comment \"A research article.\" .\n\n:ArticleCollection a owl:Class ;\n    rdfs:label \"Article Collection\" ;\n    rdfs:comment \"A collection of research articles, published as a book or CD.\" .\n\n:Book a owl:Class ;\n    rdfs:label \"Book\" ;\n    rdfs:comment \"A book containing research articles.\" ;\n    rdfs:subClassOf :ArticleCollection .\n\n:CD a owl:Class ;\n    rdfs:label \"CD\" ;\n    rdfs:comment \"A CD containing research articles.\" ;\n    rdfs:subClassOf :ArticleCollection .\n\n:Seminar a owl:Class ;\n    rdfs:label \"Seminar\" ;\n    rdfs:comment \"A seminar where articles are presented.\" .\n\n#################################################################\n# Disjointness & Disjoint Unions\n#################################################################\n\n:Doctor owl:disjointWith :Nurse, :NursingAssistant, :Staff .\n:Nurse owl:disjointWith :NursingAssistant, :Staff .\n:NursingAssistant owl:disjointWith :Staff .\n:Book owl:disjointWith :CD .\n\n:Person owl:disjointUnionOf (:Doctor :Nurse :NursingAssistant :Staff) .\n:ArticleCollection owl:disjointUnionOf (:Book :CD) .\n\n#################################################################\n# Object Properties and Inverses\n#################################################################\n\n:hasDegree a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has degree\" ;\n    rdfs:comment \"Relates a person to a degree they have obtained.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Degree ;\n    owl:inverseOf :isDegreeOf .\n\n:isDegreeOf a owl:ObjectProperty ;\n    rdfs:label \"is degree of\" ;\n    rdfs:comment \"Inverse of hasDegree: Relates a degree to a person who has it.\" ;\n    rdfs:domain :Degree ;\n    rdfs:range :Person ;\n    owl:inverseOf :hasDegree .\n\n:studiedForDegree a owl:ObjectProperty ;\n    rdfs:label \"studied for degree\" ;\n    rdfs:comment \"Relates a person to a degree they studied for.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Degree ;\n    owl:inverseOf :wasStudiedBy .\n\n:wasStudiedBy a owl:ObjectProperty ;\n    rdfs:label \"was studied by\" ;\n    rdfs:comment \"Inverse of studiedForDegree: Relates a degree to a person who studied for it.\" ;\n    rdfs:domain :Degree ;\n    rdfs:range :Person ;\n    owl:inverseOf :studiedForDegree .\n\n:employedAt a owl:ObjectProperty ;\n    rdfs:label \"employed at\" ;\n    rdfs:comment \"Relates an employment relationship to a hospital.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :hasEmployment .\n\n:hasEmployment a owl:ObjectProperty ;\n    rdfs:label \"has employment\" ;\n    rdfs:comment \"Inverse of employedAt: Relates a hospital to an employment relationship.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :Employment ;\n    owl:inverseOf :employedAt .\n\n:locatedInCity a owl:ObjectProperty ;\n    rdfs:label \"located in city\" ;\n    rdfs:comment \"Relates a hospital to the city it is located in.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :City ;\n    owl:inverseOf :hasHospital .\n\n:hasHospital a owl:ObjectProperty ;\n    rdfs:label \"has hospital\" ;\n    rdfs:comment \"Inverse of locatedInCity: Relates a city to a hospital located in it.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :locatedInCity .\n\n:locatedInCountry a owl:ObjectProperty ;\n    rdfs:label \"located in country\" ;\n    rdfs:comment \"Relates a city to the country it is located in.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Country ;\n    owl:inverseOf :hasCity .\n\n:hasCity a owl:ObjectProperty ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"Inverse of locatedInCountry: Relates a country to a city located in it.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :City ;\n    owl:inverseOf :locatedInCountry .\n\n:memberOfUnion a owl:ObjectProperty ;\n    rdfs:label \"member of union\" ;\n    rdfs:comment \"Relates a union membership to a union.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :Union ;\n    owl:inverseOf :hasMember .\n\n:hasMember a owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Inverse of memberOfUnion: Relates a union to a membership.\" ;\n    rdfs:domain :Union ;\n    rdfs:range :UnionMembership ;\n    owl:inverseOf :memberOfUnion .\n\n:unionRole a owl:ObjectProperty ;\n    rdfs:label \"union role\" ;\n    rdfs:comment \"Relates a union membership to a union role.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :UnionRole ;\n    owl:inverseOf :isRoleOfMembership .\n\n:isRoleOfMembership a owl:ObjectProperty ;\n    rdfs:label \"is role of membership\" ;\n    rdfs:comment \"Inverse of unionRole: Relates a union role to a union membership.\" ;\n    rdfs:domain :UnionRole ;\n    rdfs:range :UnionMembership ;\n    owl:inverseOf :unionRole .\n\n:evaluatedBy a owl:ObjectProperty ;\n    rdfs:label \"evaluated by\" ;\n    rdfs:comment \"Relates an evaluation to the doctor who performed it.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range :Doctor ;\n    owl:inverseOf :performedEvaluation .\n\n:performedEvaluation a owl:ObjectProperty ;\n    rdfs:label \"performed evaluation\" ;\n    rdfs:comment \"Inverse of evaluatedBy: Relates a doctor to an evaluation they performed.\" ;\n    rdfs:domain :Doctor ;\n    rdfs:range :Evaluation ;\n    owl:inverseOf :evaluatedBy .\n\n:evaluatesEmployee a owl:ObjectProperty ;\n    rdfs:label \"evaluates employee\" ;\n    rdfs:comment \"Relates an evaluation to the staff member being evaluated.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range :Staff ;\n    owl:inverseOf :isEvaluationOf .\n\n:isEvaluationOf a owl:ObjectProperty ;\n    rdfs:label \"is evaluation of\" ;\n    rdfs:comment \"Inverse of evaluatesEmployee: Relates a staff member to an evaluation.\" ;\n    rdfs:domain :Staff ;\n    rdfs:range :Evaluation ;\n    owl:inverseOf :evaluatesEmployee .\n\n:containsArticle a owl:ObjectProperty ;\n    rdfs:label \"contains article\" ;\n    rdfs:comment \"Relates an article collection to an article it contains.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range :Article ;\n    owl:inverseOf :isContainedIn .\n\n:isContainedIn a owl:ObjectProperty ;\n    rdfs:label \"is contained in\" ;\n    rdfs:comment \"Inverse of containsArticle: Relates an article to the collection it is contained in.\" ;\n    rdfs:domain :Article ;\n    rdfs:range :ArticleCollection ;\n    owl:inverseOf :containsArticle .\n\n:publishedAsBook a owl:ObjectProperty ;\n    rdfs:label \"published as book\" ;\n    rdfs:comment \"Relates an article collection to its book form.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range :Book ;\n    owl:inverseOf :isBookPublicationOf .\n\n:isBookPublicationOf a owl:ObjectProperty ;\n    rdfs:label \"is book publication of\" ;\n    rdfs:comment \"Inverse of publishedAsBook: Relates a book to the article collection it publishes.\" ;\n    rdfs:domain :Book ;\n    rdfs:range :ArticleCollection ;\n    owl:inverseOf :publishedAsBook .\n\n:publishedAsCD a owl:ObjectProperty ;\n    rdfs:label \"published as CD\" ;\n    rdfs:comment \"Relates an article collection to its CD form.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range :CD ;\n    owl:inverseOf :isCDPublicationOf .\n\n:isCDPublicationOf a owl:ObjectProperty ;\n    rdfs:label \"is CD publication of\" ;\n    rdfs:comment \"Inverse of publishedAsCD: Relates a CD to the article collection it publishes.\" ;\n    rdfs:domain :CD ;\n    rdfs:range :ArticleCollection ;\n    owl:inverseOf :publishedAsCD .\n\n:presentedAtSeminar a owl:ObjectProperty ;\n    rdfs:label \"presented at seminar\" ;\n    rdfs:comment \"Relates an article to the seminar where it was presented.\" ;\n    rdfs:domain :Article ;\n    rdfs:range :Seminar ;\n    owl:inverseOf :hasPresentedArticle .\n\n:hasPresentedArticle a owl:ObjectProperty ;\n    rdfs:label \"has presented article\" ;\n    rdfs:comment \"Inverse of presentedAtSeminar: Relates a seminar to an article presented at it.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range :Article ;\n    owl:inverseOf :presentedAtSeminar .\n\n:seminarLocation a owl:ObjectProperty ;\n    rdfs:label \"seminar location\" ;\n    rdfs:comment \"Relates a seminar to the hospital where it was held.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :locationOfSeminar .\n\n:locationOfSeminar a owl:ObjectProperty ;\n    rdfs:label \"location of seminar\" ;\n    rdfs:comment \"Inverse of seminarLocation: Relates a hospital to a seminar held there.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :Seminar ;\n    owl:inverseOf :seminarLocation .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:studyStartDate a owl:DatatypeProperty ;\n    rdfs:label \"study start date\" ;\n    rdfs:comment \"The start date of a person's studies for a degree.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range xsd:dateTime .\n\n:studyEndDate a owl:DatatypeProperty ;\n    rdfs:label \"study end date\" ;\n    rdfs:comment \"The end date of a person's studies for a degree.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range xsd:dateTime .\n\n:employmentStartDate a owl:DatatypeProperty ;\n    rdfs:label \"employment start date\" ;\n    rdfs:comment \"The date when employment started.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range xsd:dateTime .\n\n:unionMembershipStartDate a owl:DatatypeProperty ;\n    rdfs:label \"union membership start date\" ;\n    rdfs:comment \"The date when a union membership started.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range xsd:dateTime .\n\n:evaluationStatement a owl:DatatypeProperty ;\n    rdfs:label \"evaluation statement\" ;\n    rdfs:comment \"The written statement of an evaluation.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range xsd:string .\n\n:bookPageCount a owl:DatatypeProperty ;\n    rdfs:label \"book page count\" ;\n    rdfs:comment \"The number of pages in a book.\" ;\n    rdfs:domain :Book ;\n    rdfs:range xsd:integer .\n\n:publicationDate a owl:DatatypeProperty ;\n    rdfs:label \"publication date\" ;\n    rdfs:comment \"The publication date of a book.\" ;\n    rdfs:domain :Book ;\n    rdfs:range xsd:dateTime .\n\n:publicationDateCD a owl:DatatypeProperty ;\n    rdfs:label \"CD publication date\" ;\n    rdfs:comment \"The publication date of a CD.\" ;\n    rdfs:domain :CD ;\n    rdfs:range xsd:dateTime .\n\n:seminarDate a owl:DatatypeProperty ;\n    rdfs:label \"seminar date\" ;\n    rdfs:comment \"The date of a seminar.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range xsd:dateTime .\n\n#################################################################\n# General Class Axioms & Restrictions\n#################################################################\n\n# Seminar must have at least one presented article\n:Seminar rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasPresentedArticle ;\n    owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n    owl:onClass :Article\n] .\n"
}
