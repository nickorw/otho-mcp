cleCollection owl:disjointUnionOf (:Book :CD) .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n\\n:hasDegree a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has degree\\\" ;\\n    rdfs:comment \\\"Relates a person to a degree they have obtained.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Degree ;\\n    owl:inverseOf :isDegreeOf .\\n\\n:isDegreeOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is degree of\\\" ;\\n    rdfs:comment \\\"Inverse of hasDegree: Relates a degree to a person who has it.\\\" ;\\n    rdfs:domain :Degree ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :hasDegree .\\n\\n:studiedForDegree a owl:ObjectProperty ;\\n    rdfs:label \\\"studied for degree\\\" ;\\n    rdfs:comment \\\"Relates a person to a degree they studied for.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Degree ;\\n    owl:inverseOf :wasStudiedBy .\\n\\n:wasStudiedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"was studied by\\\" ;\\n    rdfs:comment \\\"Inverse of studiedForDegree: Relates a degree to a person who studied for it.\\\" ;\\n    rdfs:domain :Degree ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :studiedForDegree .\\n\\n:employedAt a owl:ObjectProperty ;\\n    rdfs:label \\\"employed at\\\" ;\\n    rdfs:comment \\\"Relates an employment relationship to a hospital.\\\" ;\\n    rdfs:domain :Employment ;\\n    rdfs:range :Hospital ;\\n    owl:inverseOf :hasEmployment .\\n\\n:hasEmployment a owl:ObjectProperty ;\\n    rdfs:label \\\"has employment\\\" ;\\n    rdfs:comment \\\"Inverse of employedAt: Relates a hospital to an employment relationship.\\\" ;\\n    rdfs:domain :Hospital ;\\n    rdfs:range :Employment ;\\n    owl:inverseOf :employedAt .\\n\\n:locatedInCity a owl:ObjectProperty ;\\n    rdfs:label \\\"located in city\\\" ;\\n    rdfs:comment \\\"Relates a hospital to the city it is located in.\\\" ;\\n 