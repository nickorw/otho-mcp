      "function": {
        "arguments": "{\"key\":\"current_owl_draft\",\"value\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#edifact_invoice_story>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\"@en ;\\n    rdfs:comment \\\"A deep and richly structured ontology modeling the UN/EDIFACT invoice message structure, organization roles, and semantic interoperability requirements.\\\"@en .\\n\\n#################################################################\\n# CLASSES\\n#################################################################\\n\\n:EdifactInterchange a owl:Class ;\\n    rdfs:label \\\"EDIFACT Interchange\\\"@en ;\\n    rdfs:comment \\\"An envelope that contains one or more EDIFACT messages as part of a digital business document exchange.\\\"@en .\\n\\n:EdifactMessage a owl:Class ;\\n    rdfs:label \\\"EDIFACT Message\\\"@en ;\\n    rdfs:comment \\\"A message contained within an EDIFACT Interchange, such as INVOIC.\\\"@en .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message (INVOIC)\\\"@en ;\\n    rdfs:comment \\\"An EDIFACT message representing an invoice, composed of segments and sections.\\\"@en ;\\n    rdfs:subClassOf :EdifactMessage .\\n\\n:EdifactSegment a owl:Class ;\\n    rdfs:label \\\"EDIFACT Segment\\\"@en ;\\n    rdfs:comment \\\"A segment within an EDIFACT message, such as BGM or NAD.\\\"@en .\\n\\n:BgmSegment a owl:Class ;\\n    rdfs:label \\\"BGM Segment\\\"@en ;\\n    rdfs:comment \\\"Beginning of Message segment for document identification in EDIFACT.\\\"@en ;\\n    rdfs:subClassOf :EdifactSegment .\\n\\n:NadSegment a owl:Class ;\\n    rdfs:label \\\"NAD Segment\\\"@en ;\\n    rdfs:comment \\\"Name and Address segment for participant details in EDIFACT.\\\"@en ;\\n    rdfs:subClassOf :EdifactSegment .\\n\\n:EdifactCompositeElement a owl:Class ;\\n    rdfs:label \\\"EDIFACT Composite Element\\\"@en ;\\n    rdfs:comment \\\"A composite data element in an EDIFACT segment.\\\"@en .\\n\\n:EdifactSimpleElement a owl:Class ;\\n    rdfs:label \\\"EDIFACT Simple Element\\\"@en ;\\n    rdfs:comment \\\"A simple data element in an EDIFACT composite element.\\\"@en .\\n\\n:EdifactDelimiter a owl:Class ;\\n    rdfs:label \\\"EDIFACT Delimiter\\\"@en ;\\n    rdfs:comment \\\"A symbol used to separate segments and elements in EDIFACT messages.\\\"@en .\\n\\n:InvoiceSection a owl:Class ;\\n    rdfs:label \\\"Invoice Section\\\"@en ;\\n    rdfs:comment \\\"A logical section of an invoice message (header, detail, summary).\\\"@en .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:label \\\"Header Section\\\"@en ;\\n    rdfs:comment \\\"The header section of an invoice, containing document dates and reference numbers.\\\"@en ;\\n    rdfs:subClassOf :InvoiceSection .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:label \\\"Detail Section\\\"@en ;\\n    rdfs:comment \\\"The detail section of an invoice, listing line items.\\\"@en ;\\n    rdfs:subClassOf :InvoiceSection .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:label \\\"Summary Section\\\"@en ;\\n    rdfs:comment \\\"The summary section of an invoice, providing totals and taxes.\\\"@en ;\\n    rdfs:subClassOf :InvoiceSection .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\"@en ;\\n    rdfs:comment \\\"A legal entity such as a buyer or delivery party involved in a transaction.\\\"@en .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\"@en ;\\n    rdfs:comment \\\"A role played by an organization in the context of an invoice.\\\"@en .\\n\\n:BuyerRole a owl:Class ;\\n    rdfs:label \\\"Buyer Role\\\"@en ;\\n    rdfs:comment \\\"The role of buyer in an invoice transaction.\\\"@en ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:DeliveryPartyRole a owl:Class ;\\n    rdfs:label \\\"Delivery Party Role\\\"@en ;\\n    rdfs:comment \\\"The role of delivery party in an invoice transaction.\\\"@en ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\"@en ;\\n    rdfs:comment \\\"A reified relationship associating an Organization with a specific AgentRole within an invoice context.\\\"@en .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\"@en ;\\n    rdfs:comment \\\"A postal address associated with an organization.\\\"@en .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\"@en ;\\n    rdfs:comment \\\"A generic identifier for organizations or documents.\\\"@en .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\"@en ;\\n    rdfs:comment \\\"A global identifier for locations, as defined by GS1.\\\"@en ;\\n    rdfs:subClassOf :Identifier .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\"@en ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\"@en .\\n\\n:InvoiceLine a owl:Class ;\\n    rdfs:label \\\"Invoice Line\\\"@en ;\\n    rdfs:comment \\\"A line item in the invoice, referencing an item, quantity, and price.\\\"@en .\\n\\n:InvoiceLineItemAssignment a owl:Class ;\\n    rdfs:label \\\"Invoice Line Item Assignment\\\"@en ;\\n    rdfs:comment \\\"A pivot class reifying the assignment of an item to an invoice line.\\\"@en .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\"@en ;\\n    rdfs:comment \\\"The price of an item or line in the invoice.\\\"@en .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\"@en ;\\n    rdfs:comment \\\"A tax amount associated with an invoice or line item.\\\"@en .\\n\\n:Amount a owl:Class ;\\n    rdfs:label \\\"Amount\\\"@en ;\\n    rdfs:comment \\\"A monetary amount in the invoice context.\\\"@en .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\"@en ;\\n    rdfs:comment \\\"A reference number, such as an invoice number.\\\"@en .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\"@en ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\"@en .\\n\\n:Standard a owl:Class ;\\n    rdfs:label \\\"Standard (EN16931-1)\\\"@en ;\\n    rdfs:comment \\\"A standard such as EN16931-1 for invoice data interoperability.\\\"@en .\\n\\n:OntologyAlignmentPivot a owl:Class ;\\n    rdfs:label \\\"Ontology Alignment Pivot\\\"@en ;\\n    rdfs:comment \\\"A pivot class for aligning with external ontologies such as P2P-O.\\\"@en .\\n\\n:SHACLConstraint a owl:Class ;\\n    rdfs:label \\\"SHACL Constraint\\\"@en ;\\n    rdfs:comment \\\"A SHACL constraint for validating invoice data consistency.\\\"@en .\\n\\n#################################################################\\n# OBJECT PROPERTIES (with inverses)\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"contains message\\\"@en ;\\n    rdfs:comment \\\"Links an EDIFACT Interchange to its contained EDIFACT Message(s).\\\"@en ;\\n    rdfs:domain :EdifactInterchange ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :isContainedInInterchange .\\n\\n:isContainedInInterchange a owl:ObjectProperty ;\\n    rdfs:label \\\"is contained in EDIFACT Interchange\\\"@en ;\\n    rdfs:comment \\\"Indicates the EDIFACT Interchange in which this message is contained.\\\"@en ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :EdifactInterchange ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\"@en ;\\n    rdfs:comment \\\"Associates an EDIFACT Message with its segments.\\\"@en ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :EdifactSegment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is segment of EDIFACT Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the EDIFACT Message of which this segment is a part.\\\"@en ;\\n    rdfs:domain :EdifactSegment ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasSection a owl:ObjectProperty ;\\n    rdfs:label \\\"has section\\\"@en ;\\n    rdfs:comment \\\"Associates an invoice message with its sections (header, detail, summary).\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSection ;\\n    owl:inverseOf :isSectionOf .\\n\\n:isSectionOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is section of Invoice Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the Invoice Message of which this section is a part.\\\"@en ;\\n    rdfs:domain :InvoiceSection ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasSection .\\n\\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has header\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to its header section.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :HeaderSection ;\\n    owl:inverseOf :isHeaderOf .\\n\\n:isHeaderOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is header of Invoice Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the Invoice Message for which this section is the header.\\\"@en ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasHeader .\\n\\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has detail\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to its detail section.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    owl:inverseOf :isDetailOf .\\n\\n:isDetailOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is detail of Invoice Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the Invoice Message for which this section is the detail.\\\"@en ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasDetail .\\n\\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has summary\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to its summary section.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SummarySection ;\\n    owl:inverseOf :isSummaryOf .\\n\\n:isSummaryOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is summary of Invoice Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the Invoice Message for which this section is the summary.\\\"@en ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasSummary .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\"@en ;\\n    rdfs:comment \\\"Associates an EDIFACT segment with its composite elements.\\\"@en ;\\n    rdfs:domain :EdifactSegment ;\\n    rdfs:range :EdifactCompositeElement ;\\n    owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is composite element of EDIFACT Segment\\\"@en ;\\n    rdfs:comment \\\"Indicates the EDIFACT Segment of which this composite element is a part.\\\"@en ;\\n    rdfs:domain :EdifactCompositeElement ;\\n    rdfs:range :EdifactSegment ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\"@en ;\\n    rdfs:comment \\\"Associates a composite element with its simple elements.\\\"@en ;\\n    rdfs:domain :EdifactCompositeElement ;\\n    rdfs:range :EdifactSimpleElement ;\\n    owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is simple element of EDIFACT Composite Element\\\"@en ;\\n    rdfs:comment \\\"Indicates the EDIFACT Composite Element to which this simple element belongs.\\\"@en ;\\n    rdfs:domain :EdifactSimpleElement ;\\n    rdfs:range :EdifactCompositeElement ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n:hasDelimiter a owl:ObjectProperty ;\\n    rdfs:label \\\"has delimiter\\\"@en ;\\n    rdfs:comment \\\"Associates an EDIFACT message with its delimiters.\\\"@en ;\\n    rdfs:domain :EdifactMessage ;\\n    rdfs:range :EdifactDelimiter ;\\n    owl:inverseOf :isDelimiterOf .\\n\\n:isDelimiterOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is delimiter of EDIFACT Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the EDIFACT Message to which this delimiter applies.\\\"@en ;\\n    rdfs:domain :EdifactDelimiter ;\\n    rdfs:range :EdifactMessage ;\\n    owl:inverseOf :hasDelimiter .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\"@en ;\\n    rdfs:comment \\\"Links an organization to its role assignment(s) in a transaction.\\\"@en ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :isRoleAssignmentOf .\\n\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is role assignment of Organization\\\"@en ;\\n    rdfs:comment \\\"Indicates the Organization to which this role assignment applies.\\\"@en ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned role\\\"@en ;\\n    rdfs:comment \\\"Indicates the agent role assigned in a role assignment.\\\"@en ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:inverseOf :isAssignedRoleOf .\\n\\n:isAssignedRoleOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned role of OrganizationRoleAssignment\\\"@en ;\\n    rdfs:comment \\\"Indicates the OrganizationRoleAssignment that assigned this AgentRole.\\\"@en ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :assignedRole .\\n\\n:assignedToInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned to invoice\\\"@en ;\\n    rdfs:comment \\\"Links a role assignment to the relevant invoice message.\\\"@en ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasRoleAssignmentForInvoice .\\n\\n:hasRoleAssignmentForInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment for Invoice Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the OrganizationRoleAssignment associated with this Invoice Message.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :assignedToInvoice .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has address\\\"@en ;\\n    rdfs:comment \\\"Links an organization to its address.\\\"@en ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is address of Organization\\\"@en ;\\n    rdfs:comment \\\"Indicates the Organization to which this address belongs.\\\"@en ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has identifier\\\"@en ;\\n    rdfs:comment \\\"Links an organization to its identifier.\\\"@en ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    owl:inverseOf :isIdentifierOf .\\n\\n:isIdentifierOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is identifier of Organization\\\"@en ;\\n    rdfs:comment \\\"Indicates the Organization to which this identifier applies.\\\"@en ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasIdentifier .\\n\\n:hasInvoiceLineAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice line assignment\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to its invoice line item assignments.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceLineItemAssignment ;\\n    owl:inverseOf :isInvoiceLineAssignmentOf .\\n\\n:isInvoiceLineAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is invoice line assignment of Invoice Message\\\"@en ;\\n    rdfs:comment \\\"Indicates the Invoice Message to which this InvoiceLineItemAssignment applies.\\\"@en ;\\n    rdfs:domain :InvoiceLineItemAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasInvoiceLineAssignment .\\n\\n:assignedItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned item\\\"@en ;\\n    rdfs:comment \\\"Links an invoice line item assignment to the item.\\\"@en ;\\n    rdfs:domain :InvoiceLineItemAssignment ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isItemAssignmentOf .\\n\\n:isItemAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is item assignment of InvoiceLineItemAssignment\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceLineItemAssignment that assigned this Item.\\\"@en ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceLineItemAssignment ;\\n    owl:inverseOf :assignedItem .\\n\\n:assignedInvoiceLine a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned invoice line\\\"@en ;\\n    rdfs:comment \\\"Links an invoice line item assignment to the invoice line.\\\"@en ;\\n    rdfs:domain :InvoiceLineItemAssignment ;\\n    rdfs:range :InvoiceLine ;\\n    owl:inverseOf :isInvoiceLineAssignmentFor .\\n\\n:isInvoiceLineAssignmentFor a owl:ObjectProperty ;\\n    rdfs:label \\\"is invoice line assignment for InvoiceLine\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceLine to which this InvoiceLineItemAssignment applies.\\\"@en ;\\n    rdfs:domain :InvoiceLine ;\\n    rdfs:range :InvoiceLineItemAssignment ;\\n    owl:inverseOf :assignedInvoiceLine .\\n\\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has price\\\"@en ;\\n    rdfs:comment \\\"Links an invoice line to its price.\\\"@en ;\\n    rdfs:domain :InvoiceLine ;\\n    rdfs:range :Price ;\\n    owl:inverseOf :isPriceOf .\\n\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is price of InvoiceLine\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceLine to which this price applies.\\\"@en ;\\n    rdfs:domain :Price ;\\n    rdfs:range :InvoiceLine ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasTax a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has tax\\\"@en ;\\n    rdfs:comment \\\"Links an invoice line to its tax.\\\"@en ;\\n    rdfs:domain :InvoiceLine ;\\n    rdfs:range :Tax ;\\n    owl:inverseOf :isTaxOf .\\n\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is tax of InvoiceLine\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceLine to which this tax applies.\\\"@en ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :InvoiceLine ;\\n    owl:inverseOf :hasTax .\\n\\n:hasAmount a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has amount\\\"@en ;\\n    rdfs:comment \\\"Links an invoice line to its amount.\\\"@en ;\\n    rdfs:domain :InvoiceLine ;\\n    rdfs:range :Amount ;\\n    owl:inverseOf :isAmountOf .\\n\\n:isAmountOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is amount of InvoiceLine\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceLine to which this amount applies.\\\"@en ;\\n    rdfs:domain :Amount ;\\n    rdfs:range :InvoiceLine ;\\n    owl:inverseOf :hasAmount .\\n\\n:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has reference number\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to its reference number.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ReferenceNumber ;\\n    owl:inverseOf :isReferenceNumberOf .\\n\\n:isReferenceNumberOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is reference number of InvoiceMessage\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceMessage to which this reference number applies.\\\"@en ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasReferenceNumber .\\n\\n:assignedToBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned to business process\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to a business process.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    owl:inverseOf :hasInvoiceForBusinessProcess .\\n\\n:hasInvoiceForBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice for Business Process\\\"@en ;\\n    rdfs:comment \\\"Indicates the BusinessProcess for which this InvoiceMessage is assigned.\\\"@en ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :assignedToBusinessProcess .\\n\\n:alignedWithStandard a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"aligned with standard\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to the standard it conforms to (e.g., EN16931-1).\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Standard ;\\n    owl:inverseOf :isStandardFor .\\n\\n:isStandardFor a owl:ObjectProperty ;\\n    rdfs:label \\\"is standard for InvoiceMessage\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceMessage for which this standard applies.\\\"@en ;\\n    rdfs:domain :Standard ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :alignedWithStandard .\\n\\n:alignsWithP2PO a owl:ObjectProperty ;\\n    rdfs:label \\\"aligns with P2P-O\\\"@en ;\\n    rdfs:comment \\\"Aligns ontology elements with the Purchase-to-Pay Ontology (P2P-O).\\\"@en ;\\n    rdfs:domain :OntologyAlignmentPivot ;\\n    rdfs:range owl:Thing ;\\n    owl:inverseOf :isAlignedWithByP2PO .\\n\\n:isAlignedWithByP2PO a owl:ObjectProperty ;\\n    rdfs:label \\\"is aligned with by P2P-O\\\"@en ;\\n    rdfs:comment \\\"Indicates the OntologyAlignmentPivot with which this element is aligned by P2P-O.\\\"@en ;\\n    rdfs:domain owl:Thing ;\\n    rdfs:range :OntologyAlignmentPivot ;\\n    owl:inverseOf :alignsWithP2PO .\\n\\n:hasSHACLConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has SHACL constraint\\\"@en ;\\n    rdfs:comment \\\"Links an invoice message to its SHACL constraints for validation.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SHACLConstraint ;\\n    owl:inverseOf :isSHACLConstraintOf .\\n\\n:isSHACLConstraintOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is SHACL constraint of InvoiceMessage\\\"@en ;\\n    rdfs:comment \\\"Indicates the InvoiceMessage to which this SHACL constraint applies.\\\"@en ;\\n    rdfs:domain :SHACLConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasSHACLConstraint .\\n\\n#################################################################\\n# DATA PROPERTIES\\n#################################################################\\n\\n:segmentCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"segment code\\\"@en ;\\n    rdfs:comment \\\"The segment code (e.g., 'BGM', 'NAD') for EDIFACT segments.\\\"@en ;\\n    rdfs:domain :EdifactSegment ;\\n    rdfs:range xsd:string .\\n\\n:elementValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"element value\\\"@en ;\\n    rdfs:comment \\\"The value of a simple element in an EDIFACT composite.\\\"@en ;\\n    rdfs:domain :EdifactSimpleElement ;\\n    rdfs:range xsd:string .\\n\\n:delimiterSymbol a owl:DatatypeProperty ;\\n    rdfs:label \\\"delimiter symbol\\\"@en ;\\n    rdfs:comment \\\"The delimiter symbol for EDIFACT messages (e.g., '+', ':').\\\"@en ;\\n    rdfs:domain :EdifactDelimiter ;\\n    rdfs:range xsd:string .\\n\\n:addressLine a owl:DatatypeProperty ;\\n    rdfs:label \\\"address line\\\"@en ;\\n    rdfs:comment \\\"A line of a postal address.\\\"@en ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:postalCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"postal code\\\"@en ;\\n    rdfs:comment \\\"The postal code of an address.\\\"@en ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:city a owl:DatatypeProperty ;\\n    rdfs:label \\\"city\\\"@en ;\\n    rdfs:comment \\\"The city of an address.\\\"@en ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:country a owl:DatatypeProperty ;\\n    rdfs:label \\\"country\\\"@en ;\\n    rdfs:comment \\\"The country of an address.\\\"@en ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:identifierValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"identifier value\\\"@en ;\\n    rdfs:comment \\\"The string value of an identifier.\\\"@en ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n:itemDescription a owl:DatatypeProperty ;\\n    rdfs:label \\\"item description\\\"@en ;\\n    rdfs:comment \\\"A description of an item in the invoice.\\\"@en ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:string .\\n\\n:quantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"quantity\\\"@en ;\\n    rdfs:comment \\\"The quantity of an item in an invoice line.\\\"@en ;\\n    rdfs:domain :InvoiceLine ;\\n    rdfs:range xsd:decimal .\\n\\n:netPrice a owl:DatatypeProperty ;\\n    rdfs:label \\\"net price\\\"@en ;\\n    rdfs:comment \\\"The net price for an item or invoice line.\\\"@en ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal .\\n\\n:taxAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"tax amount\\\"@en ;\\n    rdfs:comment \\\"The tax amount for an invoice or line item.\\\"@en ;\\n    rdfs:domain :Tax ;\\n    rdfs:range xsd:decimal .\\n\\n:totalAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"total amount\\\"@en ;\\n    rdfs:comment \\\"The total monetary amount for an invoice.\\\"@en ;\\n    rdfs:domain :Amount ;\\n    rdfs:range xsd:decimal .\\n\\n:referenceNumberValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"reference number value\\\"@en ;\\n    rdfs:comment \\\"The value of a reference number such as an invoice number.\\\"@en ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range xsd:string .\\n\\n:invoiceDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"invoice date\\\"@en ;\\n    rdfs:comment \\\"The invoice date as a string (use ISO 8601 format).\\\"@en ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n:mandatoryIdentifier a owl:DatatypeProperty ;\\n    rdfs:label \\\"mandatory identifier\\\"@en ;\\n    rdfs:comment \\\"A mandatory identifier required by the D96A directory.\\\"@en ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# ANNOTATION AXIOMS\\n#################################################################\\n# All classes and properties are annotated with rdfs:label and rdfs:comment.\\n\\n#################################################################\\n# HIERARCHY AXIOMS\\n#################################################################\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n:Organization owl:disjointWith :Item, :InvoiceLine, :EdifactMessage, :Address .\\n:InvoiceSection owl:disjointWith :Organization, :EdifactSegment .\\n:Amount owl:disjointWith :Price, :Tax .\\n:Identifier owl:disjointWith :Address .\\n:Standard owl:disjointWith :BusinessProcess .\\n\\n#################################################################\\n# EQUIVALENCE AND GCAs (EXAMPLES)\\n#################################################################\\n:InvoiceMessage owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasSection ; owl:allValuesFrom :InvoiceSection ] .\\n\\n#################################################################\\n# GENERAL CLASS AXIOMS (GCAs)\\n#################################################################\\n[ a owl:Restriction ; owl:onProperty :hasInvoiceLineAssignment ; owl:someValuesFrom :InvoiceLineItemAssignment ; rdfs:subClassOf :InvoiceMessage ] .\\n[ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ; rdfs:subClassOf :OrganizationRoleAssignment ] .\\n\\n#################################################################\\n# PROPERTY CHARACTERISTICS\\n#################################################################\\n:containsMessage a owl:FunctionalProperty .\\n:hasHeader a owl:FunctionalProperty .\\n:hasDetail a owl:FunctionalProperty .\\n:hasSummary a owl:FunctionalProperty .\\n:assignedRole a owl:FunctionalProperty .\\n:assignedToInvoice a owl:FunctionalProperty .\\n:hasAddress a owl:FunctionalProperty .\\n:hasIdentifier a owl:FunctionalProperty .\\n:assignedItem a owl:FunctionalProperty .\\n:assignedInvoiceLine a owl:FunctionalProperty .\\n:hasPrice a owl:FunctionalProperty .\\n:hasTax a owl:FunctionalProperty .\\n:hasAmount a owl:FunctionalProperty .\\n:hasReferenceNumber a owl:FunctionalProperty .\\n:assignedToBusinessProcess a owl:FunctionalProperty .\\n:alignedWithStandard a owl:FunctionalProperty .\\n\\n#################################################################\\n# END OF ONTOLOGY\\n#################################################################\\n\"}",
