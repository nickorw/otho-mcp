      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoiceStory>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for modeling UN/EDIFACT-compliant invoices, messages, participants, and business processes, supporting EN 16931 and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outer envelope containing one or more messages in the UN/EDIFACT standard.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business document or message within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An invoice message conforming to UN/EDIFACT and EN 16931.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header section of an invoice, containing dates and references.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The detail section of an invoice, listing line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The summary section of an invoice, providing totals and taxes.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element, the smallest unit of data.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice process.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization, such as Buyer or Seller.\" .\n\n:Address a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"An address associated with an organization or role.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in the invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:subClassOf :DetailSection ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the invoice, representing a sold item.\" .\n\n:Price a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item or line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information for the invoice.\" .\n\n:TotalAmount a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Total Amount\" ;\n    rdfs:comment \"Total amount for the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A unique identifier, such as a Global Location Number.\" .\n\n# Pivot Classes for Reification\n\n:InvoiceParticipantRole a owl:Class ;\n    rdfs:label \"Invoice Participant Role\" ;\n    rdfs:comment \"Reifies the participation of an organization with a role and address in a specific invoice.\" .\n\n:LineItemDetail a owl:Class ;\n    rdfs:label \"Line Item Detail\" ;\n    rdfs:comment \"Reifies the relation between an invoice, line item, price, and quantity.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to its contained Message.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its Segments.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a Segment to its Composite Data Elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a Composite Data Element to its Simple Data Elements.\" .\n\n:hasInvoiceParticipantRole a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceParticipantRole ;\n    rdfs:label \"has invoice participant role\" ;\n    rdfs:comment \"Links an InvoiceMessage to a reified InvoiceParticipantRole instance.\" .\n\n:participantOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceParticipantRole ;\n    rdfs:range :Organization ;\n    rdfs:label \"participant organization\" ;\n    rdfs:comment \"Links InvoiceParticipantRole to the participating Organization.\" .\n\n:participantRole a owl:ObjectProperty ;\n    rdfs:domain :InvoiceParticipantRole ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"participant role\" ;\n    rdfs:comment \"Links InvoiceParticipantRole to the AgentRole (e.g., Buyer, Seller).\" .\n\n:participantAddress a owl:ObjectProperty ;\n    rdfs:domain :InvoiceParticipantRole ;\n    rdfs:range :Address ;\n    rdfs:label \"participant address\" ;\n    rdfs:comment \"Links InvoiceParticipantRole to the relevant Address.\" .\n\n:hasIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an Organization to its Identifier(s).\" .\n\n:hasLineItemDetail a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :LineItemDetail ;\n    rdfs:label \"has line item detail\" ;\n    rdfs:comment \"Links an InvoiceMessage to a reified LineItemDetail instance.\" .\n\n:lineItem a owl:ObjectProperty ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :LineItem ;\n    rdfs:label \"line item\" ;\n    rdfs:comment \"Links LineItemDetail to the LineItem.\" .\n\n:item a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"item\" ;\n    rdfs:comment \"Links a LineItem to an Item.\" .\n\n:linePrice a owl:ObjectProperty ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :Price ;\n    rdfs:label \"line price\" ;\n    rdfs:comment \"Links LineItemDetail to the Price.\" .\n\n:hasHeaderSection a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :HeaderSection ;\n    rdfs:label \"has header section\" ;\n    rdfs:comment \"Links an InvoiceMessage to its HeaderSection.\" .\n\n:hasSummarySection a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"has summary section\" ;\n    rdfs:comment \"Links an InvoiceMessage to its SummarySection.\" .\n\n:hasDetailSection a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"has detail section\" ;\n    rdfs:comment \"Links an InvoiceMessage to its DetailSection.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links SummarySection to Tax.\" .\n\n:hasTotalAmount a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :TotalAmount ;\n    rdfs:label \"has total amount\" ;\n    rdfs:comment \"Links SummarySection to TotalAmount.\" .\n\n:assignedBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned business process\" ;\n    rdfs:comment \"Links an InvoiceMessage to the relevant BusinessProcess.\" .\n\n:mandatoryIdentifier a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Identifier ;\n    rdfs:label \"mandatory identifier\" ;\n    rdfs:comment \"Links InvoiceMessage to required Identifiers for D96A/EN16931 compliance.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:lineQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"line quantity\" ;\n    rdfs:comment \"The quantity of items in the line.\" .\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The invoice number.\" .\n\n:invoiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice date\" ;\n    rdfs:comment \"The invoice date, ISO 8601 format.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :Item, :Address .\n\n#################################################################\n# Restrictions and GCAs\n#################################################################\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasInvoiceParticipantRole ;\n    owl:someValuesFrom :InvoiceParticipantRole\n] .\n\n:InvoiceParticipantRole rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :participantOrganization ;\n    owl:someValuesFrom :Organization\n] , [\n    a owl:Restriction ;\n    owl:onProperty :participantRole ;\n    owl:someValuesFrom :AgentRole\n] .\n\n:LineItemDetail rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :lineItem ;\n    owl:someValuesFrom :LineItem\n] , [\n    a owl:Restriction ;\n    owl:onProperty :linePrice ;\n    owl:someValuesFrom :Price\n] , [\n    a owl:Restriction ;\n    owl:onProperty :lineQuantity ;\n    owl:someValuesFrom xsd:decimal\n] .\n\n:LineItem rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :item ;\n    owl:someValuesFrom :Item\n] .\n"
}
