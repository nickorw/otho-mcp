 ;\\n    rdfs:comment \\\"Reifies the location of a performance in a city.\\\" .\\n\\n#################################################################\\n# Object Properties (reviewed inverses)\\n#################################################################\\n:playsInstrument rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Indicates the instrument played by a person.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :isPlayedBy .\\n\\n:isPlayedBy rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is played by\\\" ;\\n    rdfs:comment \\\"Inverse property: the instrument is played by a person.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n# Only true logical inverses are defined below\\n:hasMember rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Indicates the membership relation from a band to a UserBandMembership.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :UserBandMembership ;\\n    owl:inverseOf :isMembershipOfBand .\\n\\n:isMembershipOfBand rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is membership of band\\\" ;\\n    rdfs:comment \\\"Inverse property: the membership is of a band.\\\" ;\\n    rdfs:domain :UserBandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMember .\\n\\n:containsTrack rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"contains track\\\" ;\\n    rdfs:comment \\\"Indicates the tracks contained in an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :isTrackOfAlbum .\\n\\n:isTrackOfAlbum rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is track of album\\\" ;\\n    rdfs:comment \\\"Inverse property: the track is contained in an album.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :containsTrack .\\n\\n:isRecordingOf rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"is recording of\\\" ;\\n    rdfs:comment \\\"Indicates the track that is a recording of a song.\\\" ;\\n    rdfs:domain :TrackRecording ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :hasRecording .\\n\\n:hasRecording rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has recording\\\" ;\\n    rdfs:comment \\\"Inverse property: the track has a recording event.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :TrackRecording ;\\n    owl:inverseOf :isRecordingOf .\\n\\n:isTrackOfSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"is track of song\\\" ;\\n    rdfs:comment \\\"Indicates the song that is recorded in a track.\\\" ;\\n    rdfs:domain :TrackRecording ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :hasTrackRecording .\\n\\n:hasTrackRecording rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has track recording\\\" ;\\n    rdfs:comment \\\"Inverse property: the song has a track recording event.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :TrackRecording ;\\n    owl:inverseOf :isTrackOfSong .\\n\\n:criticReview rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"critic review\\\" ;\\n    rdfs:comment \\\"Indicates the album reviewed by a critic.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :isReviewedBy .\\n\\n:isReviewedBy rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is reviewed by\\\" ;\\n    rdfs:comment \\\"Inverse property: the album is reviewed by a critic.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :criticReview .\\n\\n:performanceBand rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance band\\\" ;\\n    rdfs:comment \\\"Indicates the band performing at a live event.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :isPerformedIn .\\n\\n:isPerformedIn rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is performed in\\\" ;\\n    rdfs:comment \\\"Inverse property: the band is performed in a performance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceBand .\\n\\n:performanceSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance song\\\" ;\\n    rdfs:comment \\\"Indicates the performance event for a song.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :hasPerformanceSong .\\n\\n:hasPerformanceSong rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has performance song\\\" ;\\n    rdfs:comment \\\"Inverse property: the performance has a performance song event.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceSong .\\n\\n:performedSong rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performed song\\\" ;\\n    rdfs:comment \\\"Indicates the song performed in a performance event.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :isPerformedSongIn .\\n\\n:isPerformedSongIn rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is performed song in\\\" ;\\n    rdfs:comment \\\"Inverse property: the song is performed in a performance song event.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performedSong .\\n\\n:performanceLocation rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"Indicates the location event for a performance.\\\" ;\\n    rdfs:domain :PerformanceLocation ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :hasPerformanceLocation .\\n\\n:hasPerformanceLocation rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has performance location\\\" ;\\n    rdfs:comment \\\"Inverse property: the performance has a performance location event.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceLocation ;\\n    owl:inverseOf :performanceLocation .\\n\\n:locationCity rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"location city\\\" ;\\n    rdfs:comment \\\"Indicates the city where a performance takes place.\\\" ;\\n    rdfs:domain :PerformanceLocation ;\\n    rdfs:range :City ;\\n    owl:inverseOf :isLocationOf .\\n\\n:isLocationOf rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"is location of\\\" ;\\n    rdfs:comment \\\"Inverse property: the city is the location of a performance location event.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :PerformanceLocation ;\\n    owl:inverseOf :locationCity .\\n\\n:cityInRegion rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"city in region\\\" ;\\n    rdfs:comment \\\"Indicates the region containing a city.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :hasCity .\\n\\n:hasCity rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has city\\\" ;\\n    rdfs:comment \\\"Inverse property: the region has a city.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityInRegion .\\n\\n:regionInCountry rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"region in country\\\" ;\\n    rdfs:comment \\\"Indicates the country containing a region.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country ;\\n    owl:inverseOf :hasRegion .\\n\\n:hasRegion rdf:type owl:ObjectProperty ;\\n    rdfs:label \\\"has region\\\" ;\\n    rdfs:comment \\\"Inverse property: the country has a region.\\\" ;\\n    rdfs:domain :Country ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionInCountry .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:membershipTime rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"membership time\\\" ;\\n    rdfs:comment \\\"The time period of a person's membership in a band.\\\" ;\\n    rdfs:domain :UserBandMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingPeriodStart rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"recording period start\\\" ;\\n    rdfs:comment \\\"Start of the album recording period.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingPeriodEnd rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"recording period end\\\" ;\\n    rdfs:comment \\\"End of the album recording period.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range xsd:dateTime .\\n\\n:compositionDate rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"composition date\\\" ;\\n    rdfs:comment \\\"Date of song composition.\\\" ;\\n    rdfs:domain :SongComposition ;\\n    rdfs:range xsd:dateTime .\\n\\n:releaseDate rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"release date\\\" ;\\n    rdfs:comment \\\"Release date of an album.\\\" ;\\n    rdfs:domain :AlbumRelease ;\\n    rdfs:range xsd:dateTime .\\n\\n:reviewText rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"review text\\\" ;\\n    rdfs:comment \\\"Text of a critic's review.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range xsd:string .\\n\\n:performanceDate rdf:type owl:DatatypeProperty ;\\n    rdfs:label \\\"performance date\\\" ;\\n    rdfs:comment \\\"Date of a performance event.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:dateTime .\\n\\n#################################################################\\n# Complex Axioms & Restrictions\\n#################################################################\\n:Band owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasMember ; owl:someValuesFrom :UserBandMembership ] .\\n\\n:Album owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] ;\\n    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :containsTrack ; owl:minCardinality 1 ; owl:someValuesFrom :Track ] .\\n\\n:Track owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :isTrackOfSong ; owl:someValuesFrom :Song ] .\\n\\n:Performance owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :performanceBand ; owl:someValuesFrom :Band ] .\\n\"}",
