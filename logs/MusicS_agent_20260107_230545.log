      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    rdf:type owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"Ontology for music production, band membership, albums, tracks, performances, and related entities.\" .\n\n#################################################################\n# Classes\n#################################################################\n:Person rdf:type owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual involved in music production.\" .\n\n:Band rdf:type owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A music group or ensemble.\" ;\n    owl:disjointWith :Person .\n\n:Instrument rdf:type owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" ;\n    owl:disjointWith :Role .\n\n:Role rdf:type owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A specific role held by a person within a band.\" ;\n    owl:disjointWith :Instrument .\n\n:Album rdf:type owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A collection of music tracks released together.\" ;\n    owl:disjointWith :Track, :Song, :Performance .\n\n:Track rdf:type owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A single music track included in an album.\" ;\n    owl:disjointWith :Album .\n\n:Song rdf:type owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition.\" ;\n    owl:disjointWith :Album .\n\n:Critic rdf:type owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews music albums.\" ;\n    rdfs:subClassOf :Person .\n\n:Performance rdf:type owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live event where music is performed.\" ;\n    owl:disjointWith :Album .\n\n:City rdf:type owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances can take place.\" ;\n    owl:disjointWith :Region .\n\n:Region rdf:type owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A geographic region containing cities.\" ;\n    owl:disjointWith :Country .\n\n:Country rdf:type owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n# Pivot Classes for Reification\n:UserBandMembership rdf:type owl:Class ;\n    rdfs:label \"User Band Membership\" ;\n    rdfs:comment \"Reifies a person's membership in a band at a specific time and with a specific role.\" .\n\n:TrackRecording rdf:type owl:Class ;\n    rdfs:label \"Track Recording\" ;\n    rdfs:comment \"Reifies the relationship between a track and the song it records.\" .\n\n:SongComposition rdf:type owl:Class ;\n    rdfs:label \"Song Composition\" ;\n    rdfs:comment \"Reifies the composition of a song by a person at a specific date.\" .\n\n:AlbumRecording rdf:type owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"Reifies the recording period of an album by a band.\" .\n\n:AlbumRelease rdf:type owl:Class ;\n    rdfs:label \"Album Release\" ;\n    rdfs:comment \"Reifies the release of an album on a specific date.\" .\n\n:PerformanceSong rdf:type owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"Reifies the performance of a song during a live event.\" .\n\n:PerformanceLocation rdf:type owl:Class ;\n    rdfs:label \"Performance Location\" ;\n    rdfs:comment \"Reifies the location of a performance in a city.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n:playsInstrument rdf:type owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Indicates the instrument played by a person.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:FunctionalProperty .\n\n:hasRole rdf:type owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Indicates the role held by a person in a band membership.\" ;\n    rdfs:domain :UserBandMembership ;\n    rdfs:range :Role ;\n    owl:FunctionalProperty .\n\n:hasMember rdf:type owl:ObjectProperty ;\n    rdfs:label \"has member\" ;\n    rdfs:comment \"Indicates the membership relation from a band to a UserBandMembership.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :UserBandMembership ;\n    owl:FunctionalProperty .\n\n:hasPerson rdf:type owl:ObjectProperty ;\n    rdfs:label \"has person\" ;\n    rdfs:comment \"Indicates the person involved in a band membership.\" ;\n    rdfs:domain :UserBandMembership ;\n    rdfs:range :Person ;\n    owl:FunctionalProperty .\n\n:hasBand rdf:type owl:ObjectProperty ;\n    rdfs:label \"has band\" ;\n    rdfs:comment \"Indicates the band involved in a band membership.\" ;\n    rdfs:domain :UserBandMembership ;\n    rdfs:range :Band ;\n    owl:FunctionalProperty .\n\n:recordsAlbum rdf:type owl:ObjectProperty ;\n    rdfs:label \"records album\" ;\n    rdfs:comment \"Indicates the band that records an album during a recording period.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Band ;\n    owl:FunctionalProperty .\n\n:containsTrack rdf:type owl:ObjectProperty ;\n    rdfs:label \"contains track\" ;\n    rdfs:comment \"Indicates the tracks contained in an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track ;\n    owl:FunctionalProperty .\n\n:isRecordingOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"is recording of\" ;\n    rdfs:comment \"Indicates the track that is a recording of a song.\" ;\n    rdfs:domain :TrackRecording ;\n    rdfs:range :Track ;\n    owl:FunctionalProperty .\n\n:isTrackOfSong rdf:type owl:ObjectProperty ;\n    rdfs:label \"is track of song\" ;\n    rdfs:comment \"Indicates the song that is recorded in a track.\" ;\n    rdfs:domain :TrackRecording ;\n    rdfs:range :Song ;\n    owl:FunctionalProperty .\n\n:composedSong rdf:type owl:ObjectProperty ;\n    rdfs:label \"composed song\" ;\n    rdfs:comment \"Indicates the song composed in a composition event.\" ;\n    rdfs:domain :SongComposition ;\n    rdfs:range :Song ;\n    owl:FunctionalProperty .\n\n:composedBy rdf:type owl:ObjectProperty ;\n    rdfs:label \"composed by\" ;\n    rdfs:comment \"Indicates the person who composed a song.\" ;\n    rdfs:domain :SongComposition ;\n    rdfs:range :Person ;\n    owl:FunctionalProperty .\n\n:releasedAlbum rdf:type owl:ObjectProperty ;\n    rdfs:label \"released album\" ;\n    rdfs:comment \"Indicates the album released in a release event.\" ;\n    rdfs:domain :AlbumRelease ;\n    rdfs:range :Album ;\n    owl:FunctionalProperty .\n\n:criticReview rdf:type owl:ObjectProperty ;\n    rdfs:label \"critic review\" ;\n    rdfs:comment \"Indicates the album reviewed by a critic.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :Album ;\n    owl:FunctionalProperty .\n\n:performanceBand rdf:type owl:ObjectProperty ;\n    rdfs:label \"performance band\" ;\n    rdfs:comment \"Indicates the band performing at a live event.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :Band ;\n    owl:FunctionalProperty .\n\n:performanceSong rdf:type owl:ObjectProperty ;\n    rdfs:label \"performance song\" ;\n    rdfs:comment \"Indicates the performance event for a song.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance ;\n    owl:FunctionalProperty .\n\n:performedSong rdf:type owl:ObjectProperty ;\n    rdfs:label \"performed song\" ;\n    rdfs:comment \"Indicates the song performed in a performance event.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song ;\n    owl:FunctionalProperty .\n\n:performanceLocation rdf:type owl:ObjectProperty ;\n    rdfs:label \"performance location\" ;\n    rdfs:comment \"Indicates the location event for a performance.\" ;\n    rdfs:domain :PerformanceLocation ;\n    rdfs:range :Performance ;\n    owl:FunctionalProperty .\n\n:locationCity rdf:type owl:ObjectProperty ;\n    rdfs:label \"location city\" ;\n    rdfs:comment \"Indicates the city where a performance takes place.\" ;\n    rdfs:domain :PerformanceLocation ;\n    rdfs:range :City ;\n    owl:FunctionalProperty .\n\n:cityInRegion rdf:type owl:ObjectProperty ;\n    rdfs:label \"city in region\" ;\n    rdfs:comment \"Indicates the region containing a city.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region ;\n    owl:FunctionalProperty .\n\n:regionInCountry rdf:type owl:ObjectProperty ;\n    rdfs:label \"region in country\" ;\n    rdfs:comment \"Indicates the country containing a region.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country ;\n    owl:FunctionalProperty .\n\n#################################################################\n# Data Properties\n#################################################################\n:membershipTime rdf:type owl:DatatypeProperty ;\n    rdfs:label \"membership time\" ;\n    rdfs:comment \"The time period of a person's membership in a band.\" ;\n    rdfs:domain :UserBandMembership ;\n    rdfs:range xsd:dateTime .\n\n:recordingPeriodStart rdf:type owl:DatatypeProperty ;\n    rdfs:label \"recording period start\" ;\n    rdfs:comment \"Start of the album recording period.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:recordingPeriodEnd rdf:type owl:DatatypeProperty ;\n    rdfs:label \"recording period end\" ;\n    rdfs:comment \"End of the album recording period.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:compositionDate rdf:type owl:DatatypeProperty ;\n    rdfs:label \"composition date\" ;\n    rdfs:comment \"Date of song composition.\" ;\n    rdfs:domain :SongComposition ;\n    rdfs:range xsd:dateTime .\n\n:releaseDate rdf:type owl:DatatypeProperty ;\n    rdfs:label \"release date\" ;\n    rdfs:comment \"Release date of an album.\" ;\n    rdfs:domain :AlbumRelease ;\n    rdfs:range xsd:dateTime .\n\n:reviewText rdf:type owl:DatatypeProperty ;\n    rdfs:label \"review text\" ;\n    rdfs:comment \"Text of a critic's review.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range xsd:string .\n\n:performanceDate rdf:type owl:DatatypeProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"Date of a performance event.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:dateTime .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n:Band owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasMember ; owl:someValuesFrom :UserBandMembership ] .\n\n:Album owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] ;\n    owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :containsTrack ; owl:minCardinality 1 ; owl:someValuesFrom :Track ] .\n\n:Track owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :isTrackOfSong ; owl:someValuesFrom :Song ] .\n\n:Performance owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :performanceBand ; owl:someValuesFrom :Band ] .\n"
}
