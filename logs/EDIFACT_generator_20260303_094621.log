2026-03-03 09:51:25 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/D96A-INVOIC-Ontology> a owl:Ontology ;\n    rdfs:label \"D96A INVOIC Profound Ontology\" ;\n    rdfs:comment \"A deeply structured OWL2 ontology for the UN/EDIFACT D96A INVOIC message, with full segment, role, and compliance representation as required by EN 16931-1 and P2P-O.\" .\n\n### CLASSES\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope of an EDIFACT transmission, containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An INVOIC message for global trade transactions, as per D96A.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A generic EDIFACT segment.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NADSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" .\n\n:DTMSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment for document and line dates.\" .\n\n:MOASegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment for invoice and line totals.\" .\n\n:QTYSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment for item and line quantities.\" .\n\n:LINSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line Item segment for itemized details.\" .\n\n:PIASegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PIA Segment\" ;\n    rdfs:comment \"Additional Product ID segment for product identification.\" .\n\n:TAXSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax segment for tax breakdowns.\" .\n\n:ALCSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"ALC Segment\" ;\n    rdfs:comment \"Allowances/Charges segment.\" .\n\n:UNSSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"UNS Segment\" ;\n    rdfs:comment \"Section control segment for message section delimitation.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:MessageHeader a owl:Class ;\n    rdfs:label \"Message Header\" ;\n    rdfs:comment \"The header section of an invoice message.\" .\n\n:MessageDetail a owl:Class ;\n    rdfs:label \"Message Detail\" ;\n    rdfs:comment \"The detail section listing line items.\" .\n\n:MessageSummary a owl:Class ;\n    rdfs:label \"Message Summary\" ;\n    rdfs:comment \"The summary section with totals and taxes.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A business party involved in the invoice, such as buyer or supplier.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the message context.\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"The role of buyer in the invoice.\" .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"The role of delivery party in the invoice.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Postal or physical address of an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"The price of an item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax details for the invoice or item.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"Reference number for invoice or document.\" .\n\n:InvoiceAmount a owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:InvoiceNumber a owl:Class ;\n    rdfs:label \"Invoice Number\" ;\n    rdfs:comment \"Number identifying the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"The business process to which the invoice is assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier for organizations or items.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"GLN identifier for organizations.\" .\n\n:EN16931Conformance a owl:Class ;\n    rdfs:label \"EN 16931 Conformance\" ;\n    rdfs:comment \"Indicates conformance to the European Standard EN 16931-1.\" .\n\n:P2POAlignment a owl:Class ;\n    rdfs:label \"P2P-O Alignment\" ;\n    rdfs:comment \"Indicates alignment with the Purchase-to-Pay Ontology.\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"A SHACL constraint for automated validation.\" .\n\n:Pivot_OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"A pivot class to reify the assignment of a role to an organization in a message context.\" .\n\n### OBJECT PROPERTIES\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to a message.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :MessageHeader ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an invoice message to its header section.\" .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :MessageDetail ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links an invoice message to its detail section.\" .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :MessageSummary ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links an invoice message to its summary section.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to simple data elements.\" .\n\n:playedBy a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :Organization ;\n    rdfs:label \"played by\" ;\n    rdfs:comment \"Links an agent role to the organization playing it.\" .\n\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Pivot_OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"Assigns a specific role to an organization in a message context.\" .\n\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Pivot_OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"Assigns a specific organization to a role in a message context.\" .\n\n:inMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Pivot_OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"in message\" ;\n    rdfs:comment \"Contextualizes the organization-role assignment within a message.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifiers.\" .\n\n:hasGlobalLocationNumber a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"Links an organization to its GLN.\" .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:domain :MessageDetail ;\n    rdfs:range :Item ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links message detail to items.\" .\n\n:hasLineSegment a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LINSegment ;\n    rdfs:label \"has line segment\" ;\n    rdfs:comment \"Links an item to its LIN segment.\" .\n\n:hasPIASegment a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :PIASegment ;\n    rdfs:label \"has PIA segment\" ;\n    rdfs:comment \"Links an item to its PIA segment for product identification.\" .\n\n:hasQTYSegment a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :QTYSegment ;\n    rdfs:label \"has QTY segment\" ;\n    rdfs:comment \"Links an item to its QTY segment for quantities.\" .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links an item to its price.\" .\n\n:hasMOASegment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :MOASegment ;\n    rdfs:label \"has MOA segment\" ;\n    rdfs:comment \"Links invoice message to monetary amount segments.\" .\n\n:hasDTMSegment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :DTMSegment ;\n    rdfs:label \"has DTM segment\" ;\n    rdfs:comment \"Links invoice message to DTM segments for dates.\" .\n\n:hasTaxSegment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :TAXSegment ;\n    rdfs:label \"has TAX segment\" ;\n    rdfs:comment \"Links invoice message to tax segments.\" .\n\n:hasALCSegment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ALCSegment ;\n    rdfs:label \"has ALC segment\" ;\n    rdfs:comment \"Links invoice message to allowance/charge segments.\" .\n\n:hasUNSSegment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :UNSSegment ;\n    rdfs:label \"has UNS segment\" ;\n    rdfs:comment \"Links invoice message to section control segments.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links an invoice message to its tax information.\" .\n\n:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ReferenceNumber ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Links an invoice message to its reference number.\" .\n\n:hasInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceAmount ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Links an invoice message to its invoice amount.\" .\n\n:hasInvoiceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceNumber ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Links an invoice message to its invoice number.\" .\n\n:conformsToEN16931 a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :EN16931Conformance ;\n    rdfs:label \"conforms to EN 16931-1\" ;\n    rdfs:comment \"Indicates if the invoice message conforms to EN 16931-1.\" .\n\n:alignsWithP2PO a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :P2POAlignment ;\n    rdfs:label \"aligns with P2P-O\" ;\n    rdfs:comment \"Indicates alignment with the Purchase-to-Pay Ontology.\" .\n\n:validatedBySHACL a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SHACLConstraint ;\n    rdfs:label \"validated by SHACL\" ;\n    rdfs:comment \"Indicates validation by SHACL constraints.\" .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice message to a business process.\" .\n\n### DATA PROPERTIES\n\n:elementValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range xsd:string ;\n    rdfs:label \"element value\" ;\n    rdfs:comment \"The value of a simple data element.\" .\n\n:postalCode a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of an address.\" .\n\n:city a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of an address.\" .\n\n:street a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"street\" ;\n    rdfs:comment \"Street of an address.\" .\n\n:countryCode a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of an address.\" .\n\n:identifierValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of an identifier.\" .\n\n:glnValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :GlobalLocationNumber ;\n    rdfs:range xsd:string ;\n    rdfs:label \"GLN value\" ;\n    rdfs:comment \"The value of a global location number.\" .\n\n:itemDescription a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"Description of an item.\" .\n\n:itemQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"item quantity\" ;\n    rdfs:comment \"Quantity of an item.\" .\n\n:netPriceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"net price amount\" ;\n    rdfs:comment \"Net price amount of an item.\" .\n\n:taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"Tax amount for the invoice.\" .\n\n:referenceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range xsd:string ;\n    rdfs:label \"reference number value\" ;\n    rdfs:comment \"Reference number value.\" .\n\n:invoiceAmountValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"invoice amount value\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:invoiceNumberValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceNumber ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number value\" ;\n    rdfs:comment \"Invoice number value.\" .\n\n### CLASS AXIOMS & RESTRICTIONS\n\n:BuyerRole owl:equivalentClass [ a owl:Restriction ; owl:onProperty :playedBy ; owl:someValuesFrom :Organization ] .\n\n:Pivot_OrganizationRoleAssignment owl:equivalentClass [ a owl:Restriction ; owl:onProperty :assignedRole ; owl:someValuesFrom :AgentRole ] ,\n    [ a owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Organization ] ,\n    [ a owl:Restriction ; owl:onProperty :inMessage ; owl:someValuesFrom :InvoiceMessage ] .\n\n:InvoiceMessage owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :MessageHeader ] ,\n    [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :MessageDetail ] ,\n    [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :MessageSummary ] .\n\n:Item owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasLineSegment ; owl:someValuesFrom :LINSegment ] ,\n    [ a owl:Restriction ; owl:onProperty :hasPIASegment ; owl:someValuesFrom :PIASegment ] ,\n    [ a owl:Restriction ; owl:onProperty :hasQTYSegment ; owl:someValuesFrom :QTYSegment ] .\n\n### DISJOINTNESS\n\n:MessageHeader owl:disjointWith :MessageDetail , :MessageSummary .\n:MessageDetail owl:disjointWith :MessageSummary .\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\n:BGMSegment owl:disjointWith :NADSegment , :DTMSegment , :MOASegment , :QTYSegment , :LINSegment , :PIASegment , :TAXSegment , :ALCSegment , :UNSSegment .\n\n### ANNOTATIONS\n# (Annotations are included above for all classes and properties)\n"
}
