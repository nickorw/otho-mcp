erty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Links an Interchange Envelope to its contained EDIFACT message.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a message to its segments.\\\" .\\n\\n:hasSection a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Section ;\\n    rdfs:label \\\"has section\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its sections (header, detail, summary).\\\" .\\n\\n:hasHeaderSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :HeaderSection ;\\n    rdfs:label \\\"has header section\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its header section.\\\" .\\n\\n:hasDetailSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail section\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its detail section.\\\" .\\n\\n:hasSummarySection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"has summary section\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its summary section.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite element to its simple data elements.\\\" .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:do