ain :HeaderSection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is header section of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasHeaderSection.\\\" ;\\n    owl:inverseOf :hasHeaderSection .\\n\\n:hasDetailSection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"has detail section\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its detail section.\\\" ;\\n    owl:inverseOf :isDetailSectionOf .\\n\\n:isDetailSectionOf a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is detail section of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasDetailSection.\\\" ;\\n    owl:inverseOf :hasDetailSection .\\n\\n:hasSummarySection a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"has summary section\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its summary section.\\\" ;\\n    owl:inverseOf :isSummarySectionOf .\\n\\n:isSummarySectionOf a owl:ObjectProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is summary section of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasSummarySection.\\\" ;\\n    owl:inverseOf :hasSummarySection .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" ;\\n    owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"is composite element of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasCompositeElement.\\\" ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite element to its simple data elements.\\\" ;\\n    owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple element of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasSimpleElement.\\\" ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :AgentRoleAssignment ;\\n    rdfs:label \\\"plays role\\\" ;\\n    rdfs:comment \\\"Links an organization to its role assignment.\\\" ;\\n    owl:inverseOf :isRolePlayedBy .\\n\\n:isRolePlayedBy a owl:ObjectProperty ;\\n    rdfs:domain :AgentRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is role played by\\\" ;\\n    rdfs:comment \\\"Inverse property for playsRole.\\\" ;\\n    owl:inverseOf :playsRole .\\n\\n:involvesRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :AgentRoleAssignment ;\\n    rdfs:range :OrganizationRole ;\\n    rdfs:label \\\"involves role\\\" ;\\n    rdfs:comment \\\"Links a role assignment to the organization role involved.\\\" ;\\n    owl:inverseOf :isRoleInvolvedIn .\\n\\n:isRoleInvolvedIn a owl:ObjectProperty ;\\n    rdfs:domain :OrganizationRole ;\\n    rdfs:range :AgentRoleAssignment ;\\n    rdfs:label \\\"is role involved in\\\" ;\\n    rdfs:comment \\\"Inverse property for involvesRole.\\\" ;\\n    owl:inverseOf :involvesRole .\\n\\n:inContextOfInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :AgentRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"in context of invoice\\\" ;\\n    rdfs:comment \\\"Links a role assignment to the invoice in which it applies.\\\" ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :AgentRoleAssignment ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Inverse property for inContextOfInvoice.\\\" ;\\n    owl:inverseOf :inContextOfInvoice .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization to its address.\\\" ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is address of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasAddress.\\\" ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasWarehouseAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :WarehouseAddress ;\\n    rdfs:label \\\"has warehouse address\\\" ;\\n    rdfs:comment \\\"Links an organization to its warehouse address.\\\" ;\\n    owl:inverseOf :isWarehouseAddressOf .\\n\\n:isWarehouseAddressOf a owl:ObjectProperty ;\\n    rdfs:domain :WarehouseAddress ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is warehouse address of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasWarehouseAddress.\\\" ;\\n    owl:inverseOf :hasWarehouseAddress .\\n\\n:hasHeadquartersAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :HeadquartersAddress ;\\n    rdfs:label \\\"has headquarters address\\\" ;\\n    rdfs:comment \\\"Links an organization to its headquarters address.\\\" ;\\n    owl:inverseOf :isHeadquartersAddressOf .\\n\\n:isHeadquartersAddressOf a owl:ObjectProperty ;\\n    rdfs:domain :HeadquartersAddress ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is headquarters address of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasHeadquartersAddress.\\\" ;\\n    owl:inverseOf :hasHeadquartersAddress .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links the detail section to its line items.\\\" ;\\n    owl:inverseOf :isLineItemOf .\\n\\n:isLineItemOf a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"is line item of\\\" ;\\n    rdfs:comment \\\"Inverse property for hasLineItem.\\\" ;\\n    owl:inverseOf :hasLineItem .\\n\\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Links a line item to the item it describes.\\\" ;\\n    owl:inverseOf :isDescribedByLineItem .\\n\\n:isDescribedByLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is described by line item\\\" ;\\n    rdfs:comment \\\"Inverse property for describesItem.\\\" ;\\n    owl:inverseOf :describesItem .\\n\\n:hasTax a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links the summary section to tax information.\\\" ;\\n    owl:inverseOf :isTaxOfSummarySection .\\n\\n:isTaxOfSummarySection a owl:ObjectProperty ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :SummarySection ;\\n    rdfs:label \\\"is tax of summary section\\\" ;\\n    rdfs:comment \\\"Inverse property for hasTax.\\\" ;\\n    owl:inverseOf :hasTax .\\n\\n:alignsToEN16931 a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :EN16931Alignment ;\\n    rdfs:label \\\"aligns to EN 16931\\\" ;\\n    rdfs:comment \\\"Indicates alignment of the invoice to EN 16931-1.\\\" ;\\n    owl:inverseOf :isEN16931AlignmentOf .\\n\\n:isEN16931AlignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :EN16931Alignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is EN16931 alignment of\\\" ;\\n    rdfs:comment \\\"Inverse property for alignsToEN16931.\\\" ;\\n    owl:inverseOf :alignsToEN16931 .\\n\\n:alignsToP2PO a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :P2POAlignment ;\\n    rdfs:label \\\"aligns to P2P-O\\\" ;\\n    rdfs:comment \\\"Indicates alignment of the invoice to the P2P-O ontology.\\\" ;\\n    owl:inverseOf :isP2POAlignmentOf .\\n\\n:isP2POAlignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :P2POAlignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is P2PO alignment of\\\" ;\\n    rdfs:comment \\\"Inverse property for alignsToP2PO.\\\" ;\\n    owl:inverseOf :alignsToP2PO .\\n\\n:validatesWithConstraint a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    rdfs:label \\\"validates with constraint\\\" ;\\n    rdfs:comment \\\"Links an invoice message to its validation constraints (e.g. SHACL).\\\" ;\\n    owl:inverseOf :isConstraintForInvoice .\\n\\n:isConstraintForInvoice a owl:ObjectProperty ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is constraint for invoice\\\" ;\\n    rdfs:comment \\\"Inverse property for validatesWithConstraint.\\\" ;\\n    owl:inverseOf :validatesWithConstraint .\\n\\n:assignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"assigned to business process\\\" ;\\n    rdfs:comment \\\"Assigns the invoice message to a business process.\\\" ;\\n    owl:inverseOf :isBusinessProcessOfInvoice .\\n\\n:isBusinessProcessOfInvoice a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"is business process of invoice\\\" ;\\n    rdfs:comment \\\"Inverse property for assignedToBusinessProcess.\\\" ;\\n    owl:inverseOf :assignedToBusinessProcess .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:hasGLN a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"The Global Location Number identifier for an organization.\\\" ;\\n    rdfs:seeAlso :GlobalLocationNumber .\\n\\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"The net price for a line item.\\\" ;\\n    rdfs:seeAlso :Price .\\n\\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"The quantity of the item sold in a line item.\\\" .\\n\\n:hasTotalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal ;\\n    rdfs:label \\\"has total amount\\\" ;\\n    rdfs:comment \\\"The total invoice amount in the summary section.\\\" ;\\n    rdfs:seeAlso :Price .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number in the header section.\\\" ;\\n    rdfs:seeAlso :ReferenceNumber .\\n\\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"A reference number in the header section.\\\" ;\\n    rdfs:seeAlso :ReferenceNumber .\\n\\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The document date in the header section.\\\" .\\n\\n#################################################################\\n# Disjointness & Equivalence\\n#################################################################\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n:BuyerRole owl:equivalentClass [ a owl:Restriction ; owl:onProperty :involvesRole ; owl:someValuesFrom :Organization ] .\\n:AgentRoleAssignment owl:equivalentClass [ a owl:Restriction ; owl:onProperty :inContextOfInvoice ; owl:someValuesFrom :InvoiceMessage ] .\\n\\n#################################################################\\n# General Class Axioms\\n#################################################################\\n[ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRoleAssignment ; rdfs:subClassOf :Organization ] .\\n[ a owl:Restriction ; owl:onProperty :hasLineItem ; owl:allValuesFrom :LineItem ; rdfs:subClassOf :DetailSection ] .\\n\"}",
