      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/hospital-story>\n    a owl:Ontology ;\n    rdfs:label \"Hospital Story Ontology\" ;\n    rdfs:comment \"An ontology representing hospital staff, unions, education, publications, and seminars.\" .\n\n### Classes\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human being involved in the hospital context.\" .\n:Nurse a owl:Class ;\n    rdfs:label \"Nurse\" ;\n    rdfs:comment \"A healthcare professional who is a nurse.\" ;\n    rdfs:subClassOf :Person .\n:Doctor a owl:Class ;\n    rdfs:label \"Doctor\" ;\n    rdfs:comment \"A healthcare professional who is a doctor.\" ;\n    rdfs:subClassOf :Person .\n:NursingAssistant a owl:Class ;\n    rdfs:label \"Nursing Assistant\" ;\n    rdfs:comment \"A person trained as a nursing assistant.\" ;\n    rdfs:subClassOf :Nurse .\n:CertifiedNurse a owl:Class ;\n    rdfs:label \"Certified Nurse\" ;\n    rdfs:comment \"A nurse with a certification or degree.\" ;\n    rdfs:subClassOf :Nurse .\n:Employee a owl:Class ;\n    rdfs:label \"Employee\" ;\n    rdfs:comment \"A person employed at a hospital.\" ;\n    rdfs:subClassOf :Person .\n:PatientCareEmployee a owl:Class ;\n    rdfs:label \"Patient Care Employee\" ;\n    rdfs:comment \"An employee involved in patient care.\" ;\n    rdfs:subClassOf :Employee .\n:Degree a owl:Class ;\n    rdfs:label \"Degree\" ;\n    rdfs:comment \"An academic or professional degree.\" .\n:DegreeAcquisition a owl:Class ;\n    rdfs:label \"Degree Acquisition\" ;\n    rdfs:comment \"A reified event where a person acquires a degree over a time period.\" .\n:Employment a owl:Class ;\n    rdfs:label \"Employment\" ;\n    rdfs:comment \"A reified employment event linking a person to a hospital over time.\" .\n:Hospital a owl:Class ;\n    rdfs:label \"Hospital\" ;\n    rdfs:comment \"A hospital institution.\" .\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where hospitals are located.\" .\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing cities.\" .\n:Union a owl:Class ;\n    rdfs:label \"Union\" ;\n    rdfs:comment \"A staff union at a hospital.\" .\n:UnionMembership a owl:Class ;\n    rdfs:label \"Union Membership\" ;\n    rdfs:comment \"A reified event linking a person to a union, potentially with a role and time period.\" .\n:UnionRole a owl:Class ;\n    rdfs:label \"Union Role\" ;\n    rdfs:comment \"A role held by a person within a union (e.g., representative).\" .\n:Evaluation a owl:Class ;\n    rdfs:label \"Evaluation\" ;\n    rdfs:comment \"A written evaluation of an employee by a doctor.\" .\n:ResearchArticle a owl:Class ;\n    rdfs:label \"Research Article\" ;\n    rdfs:comment \"A research article relevant to hospital staff and practice.\" .\n:ArticleCollection a owl:Class ;\n    rdfs:label \"Article Collection\" ;\n    rdfs:comment \"A collection of research articles, as a book or CD.\" .\n:Book a owl:Class ;\n    rdfs:label \"Book\" ;\n    rdfs:comment \"A book containing research articles.\" ;\n    rdfs:subClassOf :ArticleCollection .\n:CD a owl:Class ;\n    rdfs:label \"CD\" ;\n    rdfs:comment \"A CD containing research articles.\" ;\n    rdfs:subClassOf :ArticleCollection .\n:Seminar a owl:Class ;\n    rdfs:label \"Seminar\" ;\n    rdfs:comment \"A seminar where articles are presented and discussed.\" .\n:ArticlePresentation a owl:Class ;\n    rdfs:label \"Article Presentation\" ;\n    rdfs:comment \"A reified event of a research article being presented at a seminar.\" .\n\n### Disjointness & DisjointUnion\n:Nurse owl:disjointWith :Doctor .\n:Book owl:disjointWith :CD .\n:ArticleCollection owl:disjointUnionOf (:Book :CD) .\n\n### Object Properties (with inverses)\n:hasDegree a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has degree\" ;\n    rdfs:comment \"Links a person to a degree acquisition event.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :DegreeAcquisition ;\n    owl:inverseOf :degreeOf .\n:degreeOf a owl:ObjectProperty ;\n    rdfs:label \"degree of\" ;\n    rdfs:comment \"Inverse of hasDegree; links a degree acquisition to a person.\" ;\n    rdfs:domain :DegreeAcquisition ;\n    rdfs:range :Person ;\n    owl:inverseOf :hasDegree .\n:acquiredDegree a owl:ObjectProperty ;\n    rdfs:label \"acquired degree\" ;\n    rdfs:comment \"Links a degree acquisition event to a degree.\" ;\n    rdfs:domain :DegreeAcquisition ;\n    rdfs:range :Degree ;\n    owl:inverseOf :degreeAcquisitionOf .\n:degreeAcquisitionOf a owl:ObjectProperty ;\n    rdfs:label \"degree acquisition of\" ;\n    rdfs:comment \"Inverse of acquiredDegree; links a degree to a degree acquisition.\" ;\n    rdfs:domain :Degree ;\n    rdfs:range :DegreeAcquisition ;\n    owl:inverseOf :acquiredDegree .\n:employedAt a owl:ObjectProperty ;\n    rdfs:label \"employed at\" ;\n    rdfs:comment \"Links an employment event to a hospital.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :hasEmployment .\n:hasEmployment a owl:ObjectProperty ;\n    rdfs:label \"has employment\" ;\n    rdfs:comment \"Inverse of employedAt; links a hospital to an employment event.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :Employment ;\n    owl:inverseOf :employedAt .\n:employmentPerson a owl:ObjectProperty ;\n    rdfs:label \"employment person\" ;\n    rdfs:comment \"Links an employment event to a person.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range :Person ;\n    owl:inverseOf :personEmployment .\n:personEmployment a owl:ObjectProperty ;\n    rdfs:label \"person employment\" ;\n    rdfs:comment \"Inverse of employmentPerson; links a person to an employment event.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Employment ;\n    owl:inverseOf :employmentPerson .\n:hospitalLocatedIn a owl:ObjectProperty ;\n    rdfs:label \"hospital located in\" ;\n    rdfs:comment \"Links a hospital to a city.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range :City ;\n    owl:inverseOf :cityHasHospital .\n:cityHasHospital a owl:ObjectProperty ;\n    rdfs:label \"city has hospital\" ;\n    rdfs:comment \"Inverse of hospitalLocatedIn; links a city to a hospital.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Hospital ;\n    owl:inverseOf :hospitalLocatedIn .\n:cityInCountry a owl:ObjectProperty ;\n    rdfs:label \"city in country\" ;\n    rdfs:comment \"Links a city to a country.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Country ;\n    owl:inverseOf :countryHasCity .\n:countryHasCity a owl:ObjectProperty ;\n    rdfs:label \"country has city\" ;\n    rdfs:comment \"Inverse of cityInCountry; links a country to a city.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :City ;\n    owl:inverseOf :cityInCountry .\n:hasUnionMembership a owl:ObjectProperty ;\n    rdfs:label \"has union membership\" ;\n    rdfs:comment \"Links a person to a union membership event.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :UnionMembership ;\n    owl:inverseOf :unionMembershipOf .\n:unionMembershipOf a owl:ObjectProperty ;\n    rdfs:label \"union membership of\" ;\n    rdfs:comment \"Inverse of hasUnionMembership; links a union membership to a person.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :Person ;\n    owl:inverseOf :hasUnionMembership .\n:unionOfMembership a owl:ObjectProperty ;\n    rdfs:label \"union of membership\" ;\n    rdfs:comment \"Links a union membership event to a union.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :Union ;\n    owl:inverseOf :hasUnionMembershipEvent .\n:hasUnionMembershipEvent a owl:ObjectProperty ;\n    rdfs:label \"has union membership event\" ;\n    rdfs:comment \"Inverse of unionOfMembership; links a union to a union membership event.\" ;\n    rdfs:domain :Union ;\n    rdfs:range :UnionMembership ;\n    owl:inverseOf :unionOfMembership .\n:unionMembershipRole a owl:ObjectProperty ;\n    rdfs:label \"union membership role\" ;\n    rdfs:comment \"Role held during union membership.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range :UnionRole ;\n    owl:inverseOf :roleOfUnionMembership .\n:roleOfUnionMembership a owl:ObjectProperty ;\n    rdfs:label \"role of union membership\" ;\n    rdfs:comment \"Inverse of unionMembershipRole; links a union role to a union membership event.\" ;\n    rdfs:domain :UnionRole ;\n    rdfs:range :UnionMembership ;\n    owl:inverseOf :unionMembershipRole .\n:evaluatedBy a owl:ObjectProperty ;\n    rdfs:label \"evaluated by\" ;\n    rdfs:comment \"Links an evaluation to the doctor who performed it.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range :Doctor ;\n    owl:inverseOf :performsEvaluation .\n:performsEvaluation a owl:ObjectProperty ;\n    rdfs:label \"performs evaluation\" ;\n    rdfs:comment \"Inverse of evaluatedBy; links a doctor to an evaluation.\" ;\n    rdfs:domain :Doctor ;\n    rdfs:range :Evaluation ;\n    owl:inverseOf :evaluatedBy .\n:evaluatesEmployee a owl:ObjectProperty ;\n    rdfs:label \"evaluates employee\" ;\n    rdfs:comment \"Links an evaluation to the employee evaluated.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range :Employee ;\n    owl:inverseOf :employeeEvaluation .\n:employeeEvaluation a owl:ObjectProperty ;\n    rdfs:label \"employee evaluation\" ;\n    rdfs:comment \"Inverse of evaluatesEmployee; links an employee to an evaluation.\" ;\n    rdfs:domain :Employee ;\n    rdfs:range :Evaluation ;\n    owl:inverseOf :evaluatesEmployee .\n:hasArticle a owl:ObjectProperty ;\n    rdfs:label \"has article\" ;\n    rdfs:comment \"Links an article collection to a research article.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range :ResearchArticle ;\n    owl:inverseOf :isArticleOfCollection .\n:isArticleOfCollection a owl:ObjectProperty ;\n    rdfs:label \"is article of collection\" ;\n    rdfs:comment \"Inverse of hasArticle; links a research article to an article collection.\" ;\n    rdfs:domain :ResearchArticle ;\n    rdfs:range :ArticleCollection ;\n    owl:inverseOf :hasArticle .\n:hasArticlePresentation a owl:ObjectProperty ;\n    rdfs:label \"has article presentation\" ;\n    rdfs:comment \"Links a seminar to an article presentation event.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range :ArticlePresentation ;\n    owl:inverseOf :articlePresentationOf .\n:articlePresentationOf a owl:ObjectProperty ;\n    rdfs:label \"article presentation of\" ;\n    rdfs:comment \"Inverse of hasArticlePresentation; links an article presentation to a seminar.\" ;\n    rdfs:domain :ArticlePresentation ;\n    rdfs:range :Seminar ;\n    owl:inverseOf :hasArticlePresentation .\n:presentedArticle a owl:ObjectProperty ;\n    rdfs:label \"presented article\" ;\n    rdfs:comment \"Links an article presentation to the research article presented.\" ;\n    rdfs:domain :ArticlePresentation ;\n    rdfs:range :ResearchArticle ;\n    owl:inverseOf :isPresentedIn .\n:isPresentedIn a owl:ObjectProperty ;\n    rdfs:label \"is presented in\" ;\n    rdfs:comment \"Inverse of presentedArticle; links a research article to an article presentation event.\" ;\n    rdfs:domain :ResearchArticle ;\n    rdfs:range :ArticlePresentation ;\n    owl:inverseOf :presentedArticle .\n\n### Data Properties\n:degreeStartDate a owl:DatatypeProperty ;\n    rdfs:label \"degree start date\" ;\n    rdfs:comment \"The start date of a degree.\" ;\n    rdfs:domain :DegreeAcquisition ;\n    rdfs:range xsd:dateTime .\n:degreeEndDate a owl:DatatypeProperty ;\n    rdfs:label \"degree end date\" ;\n    rdfs:comment \"The end date of a degree.\" ;\n    rdfs:domain :DegreeAcquisition ;\n    rdfs:range xsd:dateTime .\n:employmentStartDate a owl:DatatypeProperty ;\n    rdfs:label \"employment start date\" ;\n    rdfs:comment \"Start date of an employment.\" ;\n    rdfs:domain :Employment ;\n    rdfs:range xsd:dateTime .\n:unionMembershipStartDate a owl:DatatypeProperty ;\n    rdfs:label \"union membership start date\" ;\n    rdfs:comment \"Start date of a union membership.\" ;\n    rdfs:domain :UnionMembership ;\n    rdfs:range xsd:dateTime .\n:evaluationStatement a owl:DatatypeProperty ;\n    rdfs:label \"evaluation statement\" ;\n    rdfs:comment \"The written statement of an evaluation.\" ;\n    rdfs:domain :Evaluation ;\n    rdfs:range xsd:string .\n:pages a owl:DatatypeProperty ;\n    rdfs:label \"pages\" ;\n    rdfs:comment \"Number of pages in a book.\" ;\n    rdfs:domain :Book ;\n    rdfs:range xsd:integer .\n:publicationDate a owl:DatatypeProperty ;\n    rdfs:label \"publication date\" ;\n    rdfs:comment \"Publication date of a book.\" ;\n    rdfs:domain :Book ;\n    rdfs:range xsd:dateTime .\n:publicationDateCD a owl:DatatypeProperty ;\n    rdfs:label \"publication date CD\" ;\n    rdfs:comment \"Publication date of a CD.\" ;\n    rdfs:domain :CD ;\n    rdfs:range xsd:dateTime .\n:seminarDate a owl:DatatypeProperty ;\n    rdfs:label \"seminar date\" ;\n    rdfs:comment \"Date of a seminar.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range xsd:dateTime .\n:personName a owl:DatatypeProperty ;\n    rdfs:label \"person name\" ;\n    rdfs:comment \"Name of a person.\" ;\n    rdfs:domain :Person ;\n    rdfs:range xsd:string .\n:degreeTitle a owl:DatatypeProperty ;\n    rdfs:label \"degree title\" ;\n    rdfs:comment \"Title of a degree.\" ;\n    rdfs:domain :Degree ;\n    rdfs:range xsd:string .\n:unionName a owl:DatatypeProperty ;\n    rdfs:label \"union name\" ;\n    rdfs:comment \"Name of a union.\" ;\n    rdfs:domain :Union ;\n    rdfs:range xsd:string .\n:unionRoleLabel a owl:DatatypeProperty ;\n    rdfs:label \"union role label\" ;\n    rdfs:comment \"Label for a union role.\" ;\n    rdfs:domain :UnionRole ;\n    rdfs:range xsd:string .\n:hospitalName a owl:DatatypeProperty ;\n    rdfs:label \"hospital name\" ;\n    rdfs:comment \"Name of a hospital.\" ;\n    rdfs:domain :Hospital ;\n    rdfs:range xsd:string .\n:cityName a owl:DatatypeProperty ;\n    rdfs:label \"city name\" ;\n    rdfs:comment \"Name of a city.\" ;\n    rdfs:domain :City ;\n    rdfs:range xsd:string .\n:countryName a owl:DatatypeProperty ;\n    rdfs:label \"country name\" ;\n    rdfs:comment \"Name of a country.\" ;\n    rdfs:domain :Country ;\n    rdfs:range xsd:string .\n:articleTitle a owl:DatatypeProperty ;\n    rdfs:label \"article title\" ;\n    rdfs:comment \"Title of a research article.\" ;\n    rdfs:domain :ResearchArticle ;\n    rdfs:range xsd:string .\n:articleCollectionTitle a owl:DatatypeProperty ;\n    rdfs:label \"article collection title\" ;\n    rdfs:comment \"Title of an article collection.\" ;\n    rdfs:domain :ArticleCollection ;\n    rdfs:range xsd:string .\n:seminarTitle a owl:DatatypeProperty ;\n    rdfs:label \"seminar title\" ;\n    rdfs:comment \"Title of a seminar.\" ;\n    rdfs:domain :Seminar ;\n    rdfs:range xsd:string .\n\n### Restrictions and GCAs\n:Seminar rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasArticlePresentation ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ; owl:onClass :ArticlePresentation ] .\n\n"
}
