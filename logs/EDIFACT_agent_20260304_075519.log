      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/UNEDIFACTInvoiceStory> a owl:Ontology ;\n  rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n  rdfs:comment \"Ontology for representing UN/EDIFACT digital business documents, including invoices, messages, segments, organizations, and roles in global procurement.\" .\n\n# Classes\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"Top-level envelope in UN/EDIFACT containing messages.\" .\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A business message within an interchange envelope.\" .\n:InvoiceMessage a owl:Class ;\n  rdfs:subClassOf :Message ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"A message representing an invoice in EDIFACT.\" .\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment of a message, such as BGM or NAD.\" .\n:InvoiceHeader a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Invoice Header\" ;\n  rdfs:comment \"Header segment containing invoice metadata.\" .\n:InvoiceDetail a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Invoice Detail\" ;\n  rdfs:comment \"Detail segment listing line items.\" .\n:InvoiceSummary a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Invoice Summary\" ;\n  rdfs:comment \"Summary segment providing totals.\" .\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment.\" .\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element within a composite.\" .\n:LineItem a owl:Class ;\n  rdfs:subClassOf :CompositeDataElement ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in the invoice detail section.\" .\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the invoice.\" .\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in the invoice (e.g., Buyer, Seller).\" .\n:RoleAssignment a owl:Class ;\n  rdfs:label \"Role Assignment\" ;\n  rdfs:comment \"Reified relation assigning a role to an organization within a message.\" .\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"An address associated with an organization.\" .\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"An identifier such as a Global Location Number (GLN).\" .\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service sold in the invoice.\" .\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"The price of an item in a line item.\" .\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n# Disjointness\n:Organization owl:disjointWith :Item, :Address .\n:Address owl:disjointWith :Item .\n:Message owl:disjointWith :Segment .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n\n# DisjointUnion for Invoice Segments\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n\n# Object Properties and Inverses\n:hasMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  rdfs:label \"has message\" ;\n  rdfs:comment \"Links an interchange envelope to its contained message.\" ;\n  owl:inverseOf :isMessageOf .\n:isMessageOf a owl:ObjectProperty ;\n  rdfs:domain :Message ;\n  rdfs:range :InterchangeEnvelope ;\n  rdfs:label \"is message of\" ;\n  rdfs:comment \"Inverse property linking a message back to its envelope.\" ;\n  owl:inverseOf :hasMessage .\n:hasSegment a owl:ObjectProperty ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Links a message to its segments.\" ;\n  owl:inverseOf :isSegmentOf .\n:isSegmentOf a owl:ObjectProperty ;\n  rdfs:domain :Segment ;\n  rdfs:range :Message ;\n  rdfs:label \"is segment of\" ;\n  rdfs:comment \"Inverse property linking a segment back to its message.\" ;\n  owl:inverseOf :hasSegment .\n:hasCompositeDataElement a owl:ObjectProperty ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement ;\n  rdfs:label \"has composite data element\" ;\n  rdfs:comment \"Links a segment to its composite data elements.\" ;\n  owl:inverseOf :isCompositeDataElementOf .\n:isCompositeDataElementOf a owl:ObjectProperty ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :Segment ;\n  rdfs:label \"is composite data element of\" ;\n  rdfs:comment \"Inverse property linking a composite data element back to its segment.\" ;\n  owl:inverseOf :hasCompositeDataElement .\n:hasSimpleDataElement a owl:ObjectProperty ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement ;\n  rdfs:label \"has simple data element\" ;\n  rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n  owl:inverseOf :isSimpleDataElementOf .\n:isSimpleDataElementOf a owl:ObjectProperty ;\n  rdfs:domain :SimpleDataElement ;\n  rdfs:range :CompositeDataElement ;\n  rdfs:label \"is simple data element of\" ;\n  rdfs:comment \"Inverse property linking a simple data element back to its composite data element.\" ;\n  owl:inverseOf :hasSimpleDataElement .\n:hasOrganization a owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Organization ;\n  rdfs:label \"has organization\" ;\n  rdfs:comment \"Links an invoice message to an involved organization.\" ;\n  owl:inverseOf :isOrganizationOf .\n:isOrganizationOf a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is organization of\" ;\n  rdfs:comment \"Inverse property linking an organization to its invoice message.\" ;\n  owl:inverseOf :hasOrganization .\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :RoleAssignment ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Links an invoice message to a role assignment for organization participation.\" ;\n  owl:inverseOf :isRoleAssignmentOf .\n:isRoleAssignmentOf a owl:ObjectProperty ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is role assignment of\" ;\n  rdfs:comment \"Inverse property linking a role assignment to its invoice message.\" ;\n  owl:inverseOf :hasRoleAssignment .\n:hasAgentRole a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole ;\n  rdfs:label \"has agent role\" ;\n  rdfs:comment \"Links a role assignment to the agent role played.\" ;\n  owl:inverseOf :isAgentRoleOf .\n:isAgentRoleOf a owl:ObjectProperty ;\n  rdfs:domain :AgentRole ;\n  rdfs:range :RoleAssignment ;\n  rdfs:label \"is agent role of\" ;\n  rdfs:comment \"Inverse property linking an agent role to its role assignment.\" ;\n  owl:inverseOf :hasAgentRole .\n:hasParticipant a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization ;\n  rdfs:label \"has participant\" ;\n  rdfs:comment \"Links a role assignment to the participating organization.\" ;\n  owl:inverseOf :isParticipantOf .\n:isParticipantOf a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :RoleAssignment ;\n  rdfs:label \"is participant of\" ;\n  rdfs:comment \"Inverse property linking an organization to its role assignment.\" ;\n  owl:inverseOf :hasParticipant .\n:hasAddress a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization to its address.\" ;\n  owl:inverseOf :isAddressOf .\n:isAddressOf a owl:ObjectProperty ;\n  rdfs:domain :Address ;\n  rdfs:range :Organization ;\n  rdfs:label \"is address of\" ;\n  rdfs:comment \"Inverse property linking an address to its organization.\" ;\n  owl:inverseOf :hasAddress .\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to an identifier.\" ;\n  owl:inverseOf :isIdentifierOf .\n:isIdentifierOf a owl:ObjectProperty ;\n  rdfs:domain :Identifier ;\n  rdfs:range :Organization ;\n  rdfs:label \"is identifier of\" ;\n  rdfs:comment \"Inverse property linking an identifier to its organization.\" ;\n  owl:inverseOf :hasIdentifier .\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:domain :InvoiceDetail ;\n  rdfs:range :LineItem ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links the invoice detail section to its line items.\" ;\n  owl:inverseOf :isLineItemOf .\n:isLineItemOf a owl:ObjectProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :InvoiceDetail ;\n  rdfs:label \"is line item of\" ;\n  rdfs:comment \"Inverse property linking a line item to its invoice detail.\" ;\n  owl:inverseOf :hasLineItem .\n:hasItem a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Links a line item to the item being sold.\" ;\n  owl:inverseOf :isItemOf .\n:isItemOf a owl:ObjectProperty ;\n  rdfs:domain :Item ;\n  rdfs:range :LineItem ;\n  rdfs:label \"is item of\" ;\n  rdfs:comment \"Inverse property linking an item to its line item.\" ;\n  owl:inverseOf :hasItem .\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Links a line item to its price.\" ;\n  owl:inverseOf :isPriceOf .\n:isPriceOf a owl:ObjectProperty ;\n  rdfs:domain :Price ;\n  rdfs:range :LineItem ;\n  rdfs:label \"is price of\" ;\n  rdfs:comment \"Inverse property linking a price to its line item.\" ;\n  owl:inverseOf :hasPrice .\n:hasBusinessProcess a owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  rdfs:label \"has business process\" ;\n  rdfs:comment \"Assigns an invoice to a business process.\" ;\n  owl:inverseOf :isBusinessProcessOf .\n:isBusinessProcessOf a owl:ObjectProperty ;\n  rdfs:domain :BusinessProcess ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is business process of\" ;\n  rdfs:comment \"Inverse property linking a business process to its invoice message.\" ;\n  owl:inverseOf :hasBusinessProcess .\n\n# Data Properties\n:hasInvoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :InvoiceSummary ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"The invoice total amount.\" .\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :InvoiceHeader ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"The invoice number.\" .\n:hasDate a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :InvoiceHeader ;\n  rdfs:range xsd:dateTime ;\n  rdfs:label \"has date\" ;\n  rdfs:comment \"The invoice date.\" .\n:hasNetPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Net price of an item.\" .\n:hasQuantity a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Quantity of items sold.\" .\n:hasTaxAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :InvoiceSummary ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has tax amount\" ;\n  rdfs:comment \"Total tax amount in the invoice.\" .\n:hasName a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has name\" ;\n  rdfs:comment \"Name of the organization.\" .\n:hasGLN a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Identifier ;\n  rdfs:range :xsd:string ;\n  rdfs:label \"has GLN\" ;\n  rdfs:comment \"The Global Location Number identifier.\" .\n:hasAddressLine a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has address line\" ;\n  rdfs:comment \"Address line of the address.\" .\n:hasPostalCode a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has postal code\" ;\n  rdfs:comment \"Postal code of the address.\" .\n:hasCity a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has city\" ;\n  rdfs:comment \"City of the address.\" .\n:hasCountryCode a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has country code\" ;\n  rdfs:comment \"Country code of the address.\" .\n:hasDescription a owl:DatatypeProperty, owl:FunctionalProperty ;\n  rdfs:domain :Item ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has description\" ;\n  rdfs:comment \"Description of the item.\" .\n\n# Restrictions and GCAs (examples)\n:Buyer a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Buyer Role\" ;\n  rdfs:comment \"Role of buyer in an invoice.\" .\n:Seller a owl:Class ;\n  rdfs:subClassOf :AgentRole ;\n  rdfs:label \"Seller Role\" ;\n  rdfs:comment \"Role of seller in an invoice.\" .\n\n# Example GCA: Any organization with a RoleAssignment as Buyer is a BuyerOrganization\n:BuyerOrganization a owl:Class ;\n  owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      :Organization\n      [ a owl:Restriction ;\n        owl:onProperty :hasRoleAssignment ;\n        owl:someValuesFrom [ a owl:Restriction ;\n          owl:onProperty :hasAgentRole ;\n          owl:hasValue :Buyer ]\n      ]\n    )\n  ] ;\n  rdfs:label \"Buyer Organization\" ;\n  rdfs:comment \"Organization that plays the Buyer role in an invoice.\" .\n\n# Annotation on SHACL/validation requirements\n:shaclRequirements a owl:AnnotationProperty ;\n  rdfs:label \"SHACL Requirements\" ;\n  rdfs:comment \"Annotation for SHACL validation requirements such as sum of item prices, mandatory identifiers, etc.\" .\n:InvoiceMessage :shaclRequirements \"SHACL constraints must ensure itemized prices sum to totals and all mandatory identifiers from D96A are present.\" .\n",
      "label": "final_validated"
}
