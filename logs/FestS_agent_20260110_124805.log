roduction ; rdfs:range :ProductionReview .\\n:reviewedBy a owl:ObjectProperty ; rdfs:label \\\"reviewed by\\\" ; rdfs:comment \\\"Links a production review to the newspaper that published it.\\\" ; rdfs:domain :ProductionReview ; rdfs:range :Newspaper .\\n:employedAt a owl:ObjectProperty ; rdfs:label \\\"employed at\\\" ; rdfs:comment \\\"Links an actor employment to the theatre.\\\" ; rdfs:domain :ActorEmployment ; rdfs:range :Theatre .\\n:hasEnsemble a owl:ObjectProperty ; rdfs:label \\\"has ensemble\\\" ; rdfs:comment \\\"Links a production to its performing ensemble.\\\" ; rdfs:domain :Production ; rdfs:range :Ensemble .\\n:hasMember a owl:ObjectProperty ; rdfs:label \\\"has member\\\" ; rdfs:comment \\\"Links an ensemble to its members (actors).\\\" ; rdfs:domain :Ensemble ; rdfs:range :Actor .\\n:hasRoleAssignment a owl:ObjectProperty ; rdfs:label \\\"has role assignment\\\" ; rdfs:comment \\\"Links a production to its role assignments.\\\" ; rdfs:domain :Production ; rdfs:range :RoleAssignment .\\n:assignedRole a owl:ObjectProperty ; rdfs:label \\\"assigned role\\\" ; rdfs:comment \\\"Links a role assignment to the role.\\\" ; rdfs:domain :RoleAssignment ; rdfs:range :Role .\\n:assignedActor a owl:ObjectProperty ; rdfs:label \\\"assigned actor\\\" ; rdfs:comment \\\"Links a role assignment to the actor.\\\" ; rdfs:domain :RoleAssignment ; rdfs:range :Actor .\\n:festivalHasPlay a owl:ObjectProperty ; rdfs:label \\\"festival has play\\\" ; rdfs:comment \\\"Links a festival to the plays performed.\\\" ; rdfs:domain :TheatreFestival ; rdfs:range :Play .\\n:participatedInFestival a owl:ObjectProperty ; rdfs:label \\\"participated in festival\\\" ; rdfs:comment \\\"Links a production to the festival it participated in.\\\" ; rdfs:domain :Production ; rdfs:range :TheatreFestival .\\n:hasParticipation a owl:ObjectProperty ; rdfs:label \\\"has participation\\\" ; rdfs:comment \\\"Links a production to its participation records.\\\" ; rdfs:domain :Production ; rdfs:ran