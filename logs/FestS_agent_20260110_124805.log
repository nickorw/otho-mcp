      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/theatre-productions> a owl:Ontology ;\n    rdfs:label \"Theatre Productions Ontology\" ;\n    rdfs:comment \"Ontology for modelling theatre productions, festivals, plays, actors, and related events in Italy.\" .\n\n### Classes\n:Actor a owl:Class ; rdfs:label \"Actor\" ; rdfs:comment \"A person performing roles in theatre productions.\" .\n:Author a owl:Class ; rdfs:label \"Author\" ; rdfs:comment \"A person who writes plays.\" .\n:City a owl:Class ; rdfs:label \"City\" ; rdfs:comment \"A city where festivals or theatres are located.\" .\n:Country a owl:Class ; rdfs:label \"Country\" ; rdfs:comment \"A country in which a city is located.\" .\n:Ensemble a owl:Class ; rdfs:label \"Ensemble\" ; rdfs:comment \"A group of actors performing together in a production.\" .\n:Play a owl:Class ; rdfs:label \"Play\" ; rdfs:comment \"A written dramatic work performed in a production.\" .\n:Production a owl:Class ; rdfs:label \"Production\" ; rdfs:comment \"A specific staging of a play at a theatre.\" .\n:Newspaper a owl:Class ; rdfs:label \"Newspaper\" ; rdfs:comment \"A publisher of reviews.\" .\n:Theatre a owl:Class ; rdfs:label \"Theatre\" ; rdfs:comment \"A venue for theatre productions.\" .\n:TheatreFestival a owl:Class ; rdfs:label \"Theatre Festival\" ; rdfs:comment \"An event hosting multiple theatre productions.\" .\n:Act a owl:Class ; rdfs:label \"Act\" ; rdfs:comment \"A major division of a play.\" .\n:ProductionPremiere a owl:Class ; rdfs:label \"Production Premiere\" ; rdfs:comment \"The first performance of a production.\" .\n:ProductionParticipation a owl:Class ; rdfs:label \"Production Participation\" ; rdfs:comment \"Reifies the participation of a theatre in a production, with date.\" .\n:RoleAssignment a owl:Class ; rdfs:label \"Role Assignment\" ; rdfs:comment \"Reifies the assignment of a role to an actor in a production at a specific time.\" .\n:EnsembleMembership a owl:Class ; rdfs:label \"Ensemble Membership\" ; rdfs:comment \"Reifies the membership of an actor in an ensemble, with time interval.\" .\n:FestivalPlayParticipation a owl:Class ; rdfs:label \"Festival Play Participation\" ; rdfs:comment \"Reifies the participation of a play in a festival.\" .\n:ProductionReview a owl:Class ; rdfs:label \"Production Review\" ; rdfs:comment \"Reifies the review of a production by a newspaper, with star rating.\" .\n:ActorEmployment a owl:Class ; rdfs:label \"Actor Employment\" ; rdfs:comment \"Reifies the employment of an actor at a theatre, with start date.\" .\n:Role a owl:Class ; rdfs:label \"Role\" ; rdfs:comment \"A role played by an actor in a production.\" .\n\n### Disjointness and Union\n:City owl:disjointWith :Country .\n:Actor owl:disjointWith :Ensemble .\n:TheatreFestival owl:disjointWith :Production .\n:Play owl:disjointWith :Production .\n:Role owl:disjointWith :Actor .\n:ProductionParticipation owl:disjointWith :RoleAssignment, :EnsembleMembership, :FestivalPlayParticipation .\n:RoleAssignment owl:disjointWith :EnsembleMembership, :FestivalPlayParticipation .\n:EnsembleMembership owl:disjointWith :FestivalPlayParticipation .\n\n### Object Properties\n:hasFestival a owl:ObjectProperty ; rdfs:label \"has festival\" ; rdfs:comment \"Links a production to the festival it participates in.\" ; rdfs:domain :Production ; rdfs:range :TheatreFestival ; owl:inverseOf :festivalHasProduction .\n:festivalHasProduction a owl:ObjectProperty ; rdfs:label \"festival has production\" ; rdfs:comment \"Links a festival to the productions it hosts.\" ; rdfs:domain :TheatreFestival ; rdfs:range :Production ; owl:inverseOf :hasFestival .\n:takesPlaceIn a owl:ObjectProperty ; rdfs:label \"takes place in\" ; rdfs:comment \"Links a festival to the city where it takes place.\" ; rdfs:domain :TheatreFestival ; rdfs:range :City ; owl:inverseOf :hostsFestival .\n:hostsFestival a owl:ObjectProperty ; rdfs:label \"hosts festival\" ; rdfs:comment \"Links a city to the festivals it hosts.\" ; rdfs:domain :City ; rdfs:range :TheatreFestival ; owl:inverseOf :takesPlaceIn .\n:locatedIn a owl:ObjectProperty ; rdfs:label \"located in\" ; rdfs:comment \"Links a theatre to the city it is located in.\" ; rdfs:domain :Theatre ; rdfs:range :City ; owl:inverseOf :hasTheatre .\n:hasTheatre a owl:ObjectProperty ; rdfs:label \"has theatre\" ; rdfs:comment \"Links a city to its theatres.\" ; rdfs:domain :City ; rdfs:range :Theatre ; owl:inverseOf :locatedIn .\n:inCountry a owl:ObjectProperty ; rdfs:label \"in country\" ; rdfs:comment \"Links a city to its country.\" ; rdfs:domain :City ; rdfs:range :Country ; owl:inverseOf :hasCity .\n:hasCity a owl:ObjectProperty ; rdfs:label \"has city\" ; rdfs:comment \"Links a country to its cities.\" ; rdfs:domain :Country ; rdfs:range :City ; owl:inverseOf :inCountry .\n:hasPlay a owl:ObjectProperty ; rdfs:label \"has play\" ; rdfs:comment \"Links a production to the play it is based on.\" ; rdfs:domain :Production ; rdfs:range :Play ; owl:inverseOf :playOfProduction .\n:playOfProduction a owl:ObjectProperty ; rdfs:label \"play of production\" ; rdfs:comment \"Links a play to the productions based on it.\" ; rdfs:domain :Play ; rdfs:range :Production ; owl:inverseOf :hasPlay .\n:writtenBy a owl:ObjectProperty ; rdfs:label \"written by\" ; rdfs:comment \"Links a play to its author.\" ; rdfs:domain :Play ; rdfs:range :Author ; owl:inverseOf :authorOfPlay .\n:authorOfPlay a owl:ObjectProperty ; rdfs:label \"author of play\" ; rdfs:comment \"Links an author to the plays they wrote.\" ; rdfs:domain :Author ; rdfs:range :Play ; owl:inverseOf :writtenBy .\n:hasAct a owl:ObjectProperty ; rdfs:label \"has act\" ; rdfs:comment \"Links a play to its acts.\" ; rdfs:domain :Play ; rdfs:range :Act ; owl:inverseOf :actOfPlay .\n:actOfPlay a owl:ObjectProperty ; rdfs:label \"act of play\" ; rdfs:comment \"Links an act to the play it is part of.\" ; rdfs:domain :Act ; rdfs:range :Play ; owl:inverseOf :hasAct .\n:hasPremier a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label \"has premier\" ; rdfs:comment \"Links a production to its premiere event.\" ; rdfs:domain :Production ; rdfs:range :ProductionPremiere ; owl:inverseOf :premierOfProduction .\n:premierOfProduction a owl:ObjectProperty ; rdfs:label \"premier of production\" ; rdfs:comment \"Links a premiere event to the production it is for.\" ; rdfs:domain :ProductionPremiere ; rdfs:range :Production ; owl:inverseOf :hasPremier .\n:hasReview a owl:ObjectProperty ; rdfs:label \"has review\" ; rdfs:comment \"Links a production to its review.\" ; rdfs:domain :Production ; rdfs:range :ProductionReview ; owl:inverseOf :reviewOfProduction .\n:reviewOfProduction a owl:ObjectProperty ; rdfs:label \"review of production\" ; rdfs:comment \"Links a review to the production it reviews.\" ; rdfs:domain :ProductionReview ; rdfs:range :Production ; owl:inverseOf :hasReview .\n:reviewedBy a owl:ObjectProperty ; rdfs:label \"reviewed by\" ; rdfs:comment \"Links a production review to the newspaper that published it.\" ; rdfs:domain :ProductionReview ; rdfs:range :Newspaper ; owl:inverseOf :hasReviewed .\n:hasReviewed a owl:ObjectProperty ; rdfs:label \"has reviewed\" ; rdfs:comment \"Links a newspaper to the reviews it published.\" ; rdfs:domain :Newspaper ; rdfs:range :ProductionReview ; owl:inverseOf :reviewedBy .\n:employedAt a owl:ObjectProperty ; rdfs:label \"employed at\" ; rdfs:comment \"Links an actor employment to the theatre.\" ; rdfs:domain :ActorEmployment ; rdfs:range :Theatre ; owl:inverseOf :hasEmployment .\n:hasEmployment a owl:ObjectProperty ; rdfs:label \"has employment\" ; rdfs:comment \"Links a theatre to its actor employments.\" ; rdfs:domain :Theatre ; rdfs:range :ActorEmployment ; owl:inverseOf :employedAt .\n:hasEnsemble a owl:ObjectProperty ; rdfs:label \"has ensemble\" ; rdfs:comment \"Links a production to its performing ensemble.\" ; rdfs:domain :Production ; rdfs:range :Ensemble ; owl:inverseOf :ensembleOfProduction .\n:ensembleOfProduction a owl:ObjectProperty ; rdfs:label \"ensemble of production\" ; rdfs:comment \"Links an ensemble to the production it performs in.\" ; rdfs:domain :Ensemble ; rdfs:range :Production ; owl:inverseOf :hasEnsemble .\n:hasMember a owl:ObjectProperty ; rdfs:label \"has member\" ; rdfs:comment \"Links an ensemble to its members (actors).\" ; rdfs:domain :Ensemble ; rdfs:range :Actor ; owl:inverseOf :memberOfEnsemble .\n:memberOfEnsemble a owl:ObjectProperty ; rdfs:label \"member of ensemble\" ; rdfs:comment \"Links an actor to the ensembles they are part of.\" ; rdfs:domain :Actor ; rdfs:range :Ensemble ; owl:inverseOf :hasMember .\n:hasRoleAssignment a owl:ObjectProperty ; rdfs:label \"has role assignment\" ; rdfs:comment \"Links a production to its role assignments.\" ; rdfs:domain :Production ; rdfs:range :RoleAssignment ; owl:inverseOf :roleAssignmentOfProduction .\n:roleAssignmentOfProduction a owl:ObjectProperty ; rdfs:label \"role assignment of production\" ; rdfs:comment \"Links a role assignment to the production it is for.\" ; rdfs:domain :RoleAssignment ; rdfs:range :Production ; owl:inverseOf :hasRoleAssignment .\n:assignedRole a owl:ObjectProperty ; rdfs:label \"assigned role\" ; rdfs:comment \"Links a role assignment to the role.\" ; rdfs:domain :RoleAssignment ; rdfs:range :Role ; owl:inverseOf :roleOfAssignment .\n:roleOfAssignment a owl:ObjectProperty ; rdfs:label \"role of assignment\" ; rdfs:comment \"Links a role to the role assignments it is involved in.\" ; rdfs:domain :Role ; rdfs:range :RoleAssignment ; owl:inverseOf :assignedRole .\n:assignedActor a owl:ObjectProperty ; rdfs:label \"assigned actor\" ; rdfs:comment \"Links a role assignment to the actor.\" ; rdfs:domain :RoleAssignment ; rdfs:range :Actor ; owl:inverseOf :actorOfAssignment .\n:actorOfAssignment a owl:ObjectProperty ; rdfs:label \"actor of assignment\" ; rdfs:comment \"Links an actor to their role assignments.\" ; rdfs:domain :Actor ; rdfs:range :RoleAssignment ; owl:inverseOf :assignedActor .\n:festivalHasPlay a owl:ObjectProperty ; rdfs:label \"festival has play\" ; rdfs:comment \"Links a festival to the plays performed.\" ; rdfs:domain :TheatreFestival ; rdfs:range :Play ; owl:inverseOf :playOfFestival .\n:playOfFestival a owl:ObjectProperty ; rdfs:label \"play of festival\" ; rdfs:comment \"Links a play to the festivals it is performed at.\" ; rdfs:domain :Play ; rdfs:range :TheatreFestival ; owl:inverseOf :festivalHasPlay .\n:participatedInFestival a owl:ObjectProperty ; rdfs:label \"participated in festival\" ; rdfs:comment \"Links a production to the festival it participated in.\" ; rdfs:domain :Production ; rdfs:range :TheatreFestival ; owl:inverseOf :festivalParticipation .\n:festivalParticipation a owl:ObjectProperty ; rdfs:label \"festival participation\" ; rdfs:comment \"Links a festival to the productions that participated.\" ; rdfs:domain :TheatreFestival ; rdfs:range :Production ; owl:inverseOf :participatedInFestival .\n:hasParticipation a owl:ObjectProperty ; rdfs:label \"has participation\" ; rdfs:comment \"Links a production to its participation records.\" ; rdfs:domain :Production ; rdfs:range :ProductionParticipation ; owl:inverseOf :participationOfProduction .\n:participationOfProduction a owl:ObjectProperty ; rdfs:label \"participation of production\" ; rdfs:comment \"Links a production participation to the production.\" ; rdfs:domain :ProductionParticipation ; rdfs:range :Production ; owl:inverseOf :hasParticipation .\n:participatingTheatre a owl:ObjectProperty ; rdfs:label \"participating theatre\" ; rdfs:comment \"Links a production participation to the theatre.\" ; rdfs:domain :ProductionParticipation ; rdfs:range :Theatre ; owl:inverseOf :theatreParticipation .\n:theatreParticipation a owl:ObjectProperty ; rdfs:label \"theatre participation\" ; rdfs:comment \"Links a theatre to its production participations.\" ; rdfs:domain :Theatre ; rdfs:range :ProductionParticipation ; owl:inverseOf :participatingTheatre .\n\n### Data Properties\n:writtenDuring a owl:DatatypeProperty ; rdfs:label \"written during\" ; rdfs:comment \"The time interval when a play was written.\" ; rdfs:domain :Play ; rdfs:range xsd:string .\n:premierDate a owl:DatatypeProperty ; rdfs:label \"premier date\" ; rdfs:comment \"The date of a production's premiere.\" ; rdfs:domain :ProductionPremiere ; rdfs:range xsd:date .\n:starRating a owl:DatatypeProperty ; rdfs:label \"star rating\" ; rdfs:comment \"The star rating given to a production review.\" ; rdfs:domain :ProductionReview ; rdfs:range xsd:integer .\n:employmentStartDate a owl:DatatypeProperty ; rdfs:label \"employment start date\" ; rdfs:comment \"The date an actor started working at a theatre.\" ; rdfs:domain :ActorEmployment ; rdfs:range xsd:date .\n:memberFrom a owl:DatatypeProperty ; rdfs:label \"member from\" ; rdfs:comment \"Start date of ensemble membership.\" ; rdfs:domain :EnsembleMembership ; rdfs:range xsd:date .\n:memberTo a owl:DatatypeProperty ; rdfs:label \"member to\" ; rdfs:comment \"End date of ensemble membership.\" ; rdfs:domain :EnsembleMembership ; rdfs:range xsd:date .\n:roleAssignmentDate a owl:DatatypeProperty ; rdfs:label \"role assignment date\" ; rdfs:comment \"Date when a role was assigned.\" ; rdfs:domain :RoleAssignment ; rdfs:range xsd:date .\n:participationDate a owl:DatatypeProperty ; rdfs:label \"participation date\" ; rdfs:comment \"Date of production participation in a festival.\" ; rdfs:domain :ProductionParticipation ; rdfs:range xsd:date .\n\n### Restrictions & GCAs\n:Production owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasPlay ; owl:someValuesFrom :Play ] .\n:ProductionPremiere owl:equivalentClass [ rdf:type owl:Restriction ; 