duction a owl:ObjectProperty ; rdfs:label \"play of production\" ; rdfs:comment \"Links a play to the productions based on it.\" ; rdfs:domain :Play ; rdfs:range :Production ; owl:inverseOf :hasPlay .\n:writtenBy a owl:ObjectProperty ; rdfs:label \"written by\" ; rdfs:comment \"Links a play to its author.\" ; rdfs:domain :Play ; rdfs:range :Author ; owl:inverseOf :authorOfPlay .\n:authorOfPlay a owl:ObjectProperty ; rdfs:label \"author of play\" ; rdfs:comment \"Links an author to the plays they wrote.\" ; rdfs:domain :Author ; rdfs:range :Play ; owl:inverseOf :writtenBy .\n:hasAct a owl:ObjectProperty ; rdfs:label \"has act\" ; rdfs:comment \"Links a play to its acts.\" ; rdfs:domain :Play ; rdfs:range :Act ; owl:inverseOf :actOfPlay .\n:actOfPlay a owl:ObjectProperty ; rdfs:label \"act of play\" ; rdfs:comment \"Links an act to the play it is part of.\" ; rdfs:domain :Act ; rdfs:range :Play ; owl:inverseOf :hasAct .\n:hasPremier a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label \"has premier\" ; rdfs:comment \"Links a production to its premiere event.\" ; rdfs:domain :Production ; rdfs:range :ProductionPremiere ; owl:inverseOf :premierOfProduction .\n:premierOfProduction a owl:ObjectProperty ; rdfs:label \"premier of production\" ; rdfs:comment \"Links a premiere event to the production it is for.\" ; rdfs:domain :ProductionPremiere ; rdfs:range :Production ; owl:inverseOf :hasPremier .\n:hasReview a owl:ObjectProperty ; rdfs:label \"has review\" ; rdfs:comment \"Links a production to its review.\" ; rdfs:domain :Production ; rdfs:range :ProductionReview ; owl:inverseOf :reviewOfProduction .\n:reviewOfProduction a owl:ObjectProperty ; rdfs:label \"review of production\" ; rdfs:comment \"Links a review to the production it reviews.\" ; rdfs:domain :ProductionReview ; rdfs:range :Production ; owl:inverseOf :hasReview .\n:reviewedBy a owl:ObjectProperty ; rdfs:label \"reviewed by\" ; rdfs:comment \"Links a production review to the newspaper that published it.