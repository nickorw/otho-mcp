ineItem .\\n:isDescribedInLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:label \\\"is described in line item\\\" ;\\n  rdfs:comment \\\"Links an item to the line item that describes it.\\\" ;\\n  rdfs:domain :Item ;\\n  rdfs:range :LineItem ;\\n  owl:inverseOf :describesItem .\\n:hasPrice rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:label \\\"has price\\\" ;\\n  rdfs:comment \\\"Links a line item to its price.\\\" ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Price ;\\n  owl:inverseOf :isPriceOfLineItem .\\n:isPriceOfLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:label \\\"is price of line item\\\" ;\\n  rdfs:comment \\\"Links a price to its line item.\\\" ;\\n  rdfs:domain :Price ;\\n  rdfs:range :LineItem ;\\n  owl:inverseOf :hasPrice .\\n:partOfBusinessProcess rdf:type owl:ObjectProperty ;\\n  rdfs:label \\\"part of business process\\\" ;\\n  rdfs:comment \\\"Links an invoice message to a business process.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  owl:inverseOf :hasInvoiceMessage .\\n:hasInvoiceMessage rdf:type owl:ObjectProperty ;\\n  rdfs:label \\\"has invoice message\\\" ;\\n  rdfs:comment \\\"Links a business process to its invoice message.\\\" ;\\n  rdfs:domain :BusinessProcess ;\\n  rdfs:range :InvoiceMessage ;\\n  owl:inverseOf :partOfBusinessProcess .\\n:validatedBy rdf:type owl:ObjectProperty ;\\n  rdfs:label \\\"validated by\\\" ;\\n  rdfs:comment \\\"Links an invoice message to a SHACL constraint.\\\" ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :SHACLConstraint ;\\n  owl:inverseOf :validates .\\n:validates rdf:type owl:ObjectProperty ;\\n  rdfs:label \\\"validates\\\" ;\\n  rdfs:comment \\\"Links a SHACL constraint to the invoice message it validates.\\\" ;\\n  rdfs:domain :SHACLConstraint ;\\n  rdfs:range :InvoiceMessage ;\\n  owl:inverseOf :validatedBy .\\n\\n# Data Properties\\n:invoiceNumber rdf:type owl:DatatypeProperty ; rdfs:label \\\"invoice number\\\" ; rdfs:comment \\\"The invoice number in the header section.\\\" ; rdfs:domain :InvoiceHeaderSection ; rdfs:range xsd:string .\\n:invoiceDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"invoice date\\\" ; rdfs:comment \\\"The invoice date in the header section.\\\" ; rdfs:domain :InvoiceHeaderSection ; rdfs:range xsd:dateTime .\\n:referenceNumber rdf:type owl:DatatypeProperty ; rdfs:label \\\"reference number\\\" ; rdfs:comment \\\"Reference number in the header section.\\\" ; rdfs:domain :InvoiceHeaderSection ; rdfs:range xsd:string .\\n:netPrice rdf:type owl:DatatypeProperty ; rdfs:label \\\"net price\\\" ; rdfs:comment \\\"Net price of the item.\\\" ; rdfs:domain :Price ; rdfs:range xsd:decimal .\\n:quantity rdf:type owl:DatatypeProperty ; rdfs:label \\\"quantity\\\" ; rdfs:comment \\\"Quantity of the item in the line.\\\" ; rdfs:domain :LineItem ; rdfs:range xsd:decimal .\\n:totalAmount rdf:type owl:DatatypeProperty ; rdfs:label \\\"total amount\\\" ; rdfs:comment \\\"Total invoice amount in the summary section.\\\" ; rdfs:domain :InvoiceSummarySection ; rdfs:range xsd:decimal .\\n:taxAmount rdf:type owl:DatatypeProperty ; rdfs:label \\\"tax amount\\\" ; rdfs:comment \\\"Total tax amount in the summary section.\\\" ; rdfs:domain :InvoiceSummarySection ; rdfs:range xsd:decimal .\\n:addressLine rdf:type owl:DatatypeProperty ; rdfs:label \\\"address line\\\" ; rdfs:comment \\\"Address line for the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:postalCode rdf:type owl:DatatypeProperty ; rdfs:label \\\"postal code\\\" ; rdfs:comment \\\"Postal code for the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:city rdf:type owl:DatatypeProperty ; rdfs:label \\\"city\\\" ; rdfs:comment \\\"City for the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:countryCode rdf:type owl:DatatypeProperty ; rdfs:label \\\"country code\\\" ; rdfs:comment \\\"Country code for the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:identifierValue rdf:type owl:DatatypeProperty ; rdfs:label \\\"identifier value\\\" ; rdfs:comment \\\"The identifier value, e.g., GLN.\\\" ; rdfs:domain :Identifier ; rdfs:range xsd:string .\\n:identifierScheme rdf:type owl:DatatypeProperty ; rdfs:label \\\"identifier scheme\\\" ; rdfs:comment \\\"The scheme for the identifier.\\\" ; rdfs:domain :Identifier ; rdfs:range xsd:string .\\n\\n# Restrictions & Complex Axioms\\n:Buyer rdf:type :AgentRole ; rdfs:label \\\"Buyer\\\" ; rdfs:comment \\\"Agent role for buyer in the invoice.\\\" .\\n:DeliveryParty rdf:type :AgentRole ; rdfs:label \\\"Delivery Party\\\" ; rdfs:comment \\\"Agent role for delivery party in the invoice.\\\" .\\n\\n# General Class Axiom for Buyer\\n:BuyerContext rdf:type owl:Class ; rdfs:label \\\"Buyer Context\\\" ; rdfs:comment \\\"Organization role context where the agent role is Buyer.\\\" ; owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasRole ; owl:allValuesFrom :Buyer ] .\\n\\n# Example Restriction: InvoiceMessage must have at least one OrganizationRoleContext\\n:InvoiceMessage rdf:type owl:Class ; rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasRoleContext ; owl:someValuesFrom :OrganizationRoleContext ] .\\n\\n# Example Restriction: LineItem must describe an Item\\n:LineItem rdf:type owl:Class ; rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ] .\\n\\n# Example Restriction: LineItem must have a Price\\n:LineItem rdf:type owl:Class ; rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ] .\\n\\n# Example Restriction: InvoiceSummarySection must have totalAmount and taxAmount\\n:InvoiceSummarySection rdf:type owl:Class ; rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :totalAmount ; owl:someValuesFrom xsd:decimal ] , [ rdf:type owl:Restriction ; owl:onProperty :taxAmount ; owl:someValuesFrom xsd:decimal ] .\\n\\n# Example SHACL Constraint annotation\\n:MandatoryIdentifierC