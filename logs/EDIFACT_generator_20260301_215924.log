n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links a line item to the item being sold.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item .\\n    :isItemOf a owl:ObjectProperty ;\\n        owl:inverseOf :hasItem ;\\n        rdfs:label \\\"is item of\\\" ;\\n        rdfs:comment \\\"Inverse property for hasItem.\\\" ;\\n        rdfs:domain :Item ;\\n        rdfs:range :LineItem .\\n\\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links a line item to its price.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price .\\n    :isPriceOf a owl:ObjectProperty ;\\n        owl:inverseOf :hasPrice ;\\n        rdfs:label \\\"is price of\\\" ;\\n        rdfs:comment \\\"Inverse property for hasPrice.\\\" ;\\n        rdfs:domain :Price ;\\n        rdfs:range :LineItem .\\n\\n:partOfHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"part of header\\\" ;\\n    rdfs:comment \\\"Links the invoice header to its invoice message.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :InvoiceMessage .\\n    :hasHeaderPart a owl:ObjectProperty ;\\n        owl:inverseOf :partOfHeader ;\\n        rdfs:label \\\"has header part\\\" ;\\n        rdfs:comment \\\"Inverse property for partOfHeader.\\\" ;\\n        rdfs:domain :InvoiceMessage ;\\n        rdfs:range :InvoiceHeader .\\n\\n:partOfDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"part of detail\\\" ;\\n    rdfs:comment \\\"Links the invoice detail to its invoice message.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :InvoiceMessage .\\n    :hasDetailPart a owl:ObjectProperty ;\\n        owl:inverseOf :partOfDetail ;\\n        rdfs:label \\\"has detail part\\\" ;\\n        rdfs:comment \\\"Inverse property for partOfDetail.\\\" ;\\n        rdfs:domain :InvoiceMessage ;\\n        rdfs:range :InvoiceDetail .\\n\\n:partOfSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"part of summary\\\" ;\\n    rdfs:comment \\\"Links the invoice summary to its invoice message.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :InvoiceMessage .\\n    :hasSummaryPart a owl:ObjectProperty ;\\n        owl:inverseOf :partOfSummary ;\\n        rdfs:label \\\"has summary part\\\" ;\\n        rdfs:comment \\\"Inverse property for partOfSummary.\\\" ;\\n        rdfs:domain :InvoiceMessage ;\\n        rdfs:range :InvoiceSummary .\\n\\n:hasBusinessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Links an invoice message to a business process.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n    :isBusinessProcessOf a owl:ObjectProperty ;\\n        owl:inverseOf :hasBusinessProcess ;\\n        rdfs:label \\\"is business process of\\\" ;\\n        rdfs:comment \\\"Inverse property for hasBusinessProcess.\\\" ;\\n        rdfs:domain :BusinessProcess ;\\n        rdfs:range :InvoiceMessage .\\n\\n### DATA PROPERTIES\\n:hasNetPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Specifies the net price of an item in a line item.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal .\\n\\n:hasQuantity a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Specifies the quantity of an item in a line item.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Specifies the total invoice amount in the summary section.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"Specifies the invoice number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:hasDocumentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"Specifies the document date in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:hasReferenceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Specifies a reference number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:hasTaxTotal a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has tax total\\\" ;\\n    rdfs:comment \\\"Specifies the total tax in the summary section.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:hasMandatoryIdentifier a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has mandatory identifier\\\" ;\\n    rdfs:comment \\\"Indicates whether all mandatory identifiers required by the D96A directory are present (true/false).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range xsd:boolean .\\n\\n### DISJOINT CLASSES\\n:Organization owl:disjointWith :Item .\\n:Segment owl:disjointWith :Message .\\n:Address owl:disjointWith :Organization .\\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\\n\\n### COMPLEX AXIOMS\\n# Every RoleAssignment must involve exactly one Organization and one AgentRole\\n:RoleAssignment owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ]\\n        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger ]\\n    )\\n] .\\n\"}",
