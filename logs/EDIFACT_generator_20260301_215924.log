      "key": "current_owl_draft",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTStory>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Story Ontology\" ;\n    rdfs:comment \"An ontology representing the structure and roles of UN/EDIFACT digital business documents, with alignment to EN 16931-1 and P2P-O, supporting procurement, roles, and validation.\" .\n\n### CLASSES\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope in a UN/EDIFACT document structure, containing messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A business message within an interchange envelope, such as an invoice or order.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"A message representing an invoice transaction.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message, such as BGM or NAD, grouping related data elements.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment, grouping simple data elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple, atomic data element within a composite data element.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the business process, e.g., buyer, seller, delivery party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction, such as Buyer or DeliveryParty.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or good listed in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item, e.g., net price.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice, containing dates and reference numbers.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice, listing line items.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice, providing totals such as tax and amount.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the detail section, representing a sold item with quantity and price.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier associated with an organization, such as a GLN.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A global location number for uniquely identifying an organization location.\" ;\n    rdfs:subClassOf :Identifier .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A pivot class representing the assignment of a role to an organization within an invoice context.\" .\n\n### OBJECT PROPERTIES\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to the messages it contains.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n:isContainedInMessage a owl:ObjectProperty ;\n    owl:inverseOf :containsMessage ;\n    rdfs:label \"is contained in interchange envelope\" ;\n    rdfs:comment \"Inverse property for containsMessage.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n:isSegmentOf a owl:ObjectProperty ;\n    owl:inverseOf :hasSegment ;\n    rdfs:label \"is segment of message\" ;\n    rdfs:comment \"Inverse property for hasSegment.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n:isCompositeElementOf a owl:ObjectProperty ;\n    owl:inverseOf :hasCompositeElement ;\n    rdfs:label \"is composite element of segment\" ;\n    rdfs:comment \"Inverse property for hasCompositeElement.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n:isSimpleElementOf a owl:ObjectProperty ;\n    owl:inverseOf :hasSimpleElement ;\n    rdfs:label \"is simple element of composite data element\" ;\n    rdfs:comment \"Inverse property for hasSimpleElement.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to a role assignment pivot class.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment .\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    owl:inverseOf :hasRoleAssignment ;\n    rdfs:label \"is role assignment of invoice message\" ;\n    rdfs:comment \"Inverse property for hasRoleAssignment.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :InvoiceMessage .\n\n:involvesOrganization a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links a role assignment to the involved organization.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization .\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    owl:inverseOf :involvesOrganization ;\n    rdfs:label \"is organization involved in role assignment\" ;\n    rdfs:comment \"Inverse property for involvesOrganization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment .\n\n:hasAgentRole a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a role assignment to the agent role.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole .\n:isAgentRoleOf a owl:ObjectProperty ;\n    owl:inverseOf :hasAgentRole ;\n    rdfs:label \"is agent role of role assignment\" ;\n    rdfs:comment \"Inverse property for hasAgentRole.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment .\n\n:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to an address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n:isAddressOf a owl:ObjectProperty ;\n    owl:inverseOf :hasAddress ;\n    rdfs:label \"is address of organization\" ;\n    rdfs:comment \"Inverse property for hasAddress.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to an identifier such as a GLN.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n:isIdentifierOf a owl:ObjectProperty ;\n    owl:inverseOf :hasIdentifier ;\n    rdfs:label \"is identifier of organization\" ;\n    rdfs:comment \"Inverse property for hasIdentifier.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization .\n\n:buyerRoleAssignment a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"buyer role assignment\" ;\n    rdfs:comment \"Links an invoice message to the buyer's role assignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment .\n:isBuyerRoleAssignmentOf a owl:ObjectProperty ;\n    owl:inverseOf :buyerRoleAssignment ;\n    rdfs:label \"is buyer role assignment of invoice message\" ;\n    rdfs:comment \"Inverse property for buyerRoleAssignment.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :InvoiceMessage .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links the invoice detail section to its line items.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem .\n:isLineItemOf a owl:ObjectProperty ;\n    owl:inverseOf :hasLineItem ;\n    rdfs:label \"is line item of invoice detail\" ;\n    rdfs:comment \"Inverse property for hasLineItem.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail .\n\n:hasItem a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a line item to the item being sold.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item .\n:isItemOf a owl:ObjectProperty ;\n    owl:inverseOf :hasItem ;\n    rdfs:label \"is item of line item\" ;\n    rdfs:comment \"Inverse property for hasItem.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem .\n\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a line item to its price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n:isPriceOf a owl:ObjectProperty ;\n    owl:inverseOf :hasPrice ;\n    rdfs:label \"is price of line item\" ;\n    rdfs:comment \"Inverse property for hasPrice.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem .\n\n:partOfHeader a owl:ObjectProperty ;\n    rdfs:label \"part of header\" ;\n    rdfs:comment \"Links the invoice header to its invoice message.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :InvoiceMessage .\n:hasHeaderPart a owl:ObjectProperty ;\n    owl:inverseOf :partOfHeader ;\n    rdfs:label \"has header part\" ;\n    rdfs:comment \"Inverse property for partOfHeader.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader .\n\n:partOfDetail a owl:ObjectProperty ;\n    rdfs:label \"part of detail\" ;\n    rdfs:comment \"Links the invoice detail to its invoice message.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceMessage .\n:hasDetailPart a owl:ObjectProperty ;\n    owl:inverseOf :partOfDetail ;\n    rdfs:label \"has detail part\" ;\n    rdfs:comment \"Inverse property for partOfDetail.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail .\n\n:partOfSummary a owl:ObjectProperty ;\n    rdfs:label \"part of summary\" ;\n    rdfs:comment \"Links the invoice summary to its invoice message.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :InvoiceMessage .\n:hasSummaryPart a owl:ObjectProperty ;\n    owl:inverseOf :partOfSummary ;\n    rdfs:label \"has summary part\" ;\n    rdfs:comment \"Inverse property for partOfSummary.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummary .\n\n:hasBusinessProcess a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n:isBusinessProcessOf a owl:ObjectProperty ;\n    owl:inverseOf :hasBusinessProcess ;\n    rdfs:label \"is business process of invoice message\" ;\n    rdfs:comment \"Inverse property for hasBusinessProcess.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage .\n\n### DATA PROPERTIES\n:hasNetPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Specifies the net price of an item in a line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:hasQuantity a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Specifies the quantity of an item in a line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Specifies the total invoice amount in the summary section.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:hasInvoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Specifies the invoice number in the header section.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"Specifies the document date in the header section.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Specifies a reference number in the header section.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:hasTaxTotal a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has tax total\" ;\n    rdfs:comment \"Specifies the total tax in the summary section.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:hasMandatoryIdentifier a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"has mandatory identifier\" ;\n    rdfs:comment \"Indicates whether all mandatory identifiers required by the D96A directory are present (true/false).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:boolean .\n\n### DISJOINT CLASSES\n:Organization owl:disjointWith :Item .\n:Segment owl:disjointWith :Message .\n:Address owl:disjointWith :Organization .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n\n### COMPLEX AXIOMS\n# Every RoleAssignment must involve exactly one Organization and one AgentRole\n:RoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:cardinality \"1\"^^xsd:nonNegativeInteger ]\n        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:cardinality \"1\"^^xsd:nonNegativeInteger ]\n    )\n] .\n"
}
