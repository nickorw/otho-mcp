      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid-un-edifact-invoice> a owl:Ontology ;\n  rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n  rdfs:comment \"An ontology for representing UN/EDIFACT invoice messages, aligned with EN 16931-1 and the Purchase-to-Pay Ontology (P2P-O).\" .\n\n#################################################################\n# CLASSES\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The top-level envelope containing one or more messages in the UN/EDIFACT standard.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A generic business message within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:subClassOf :Message ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"A specific message representing an invoice in the UN/EDIFACT standard.\" .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A structural unit within a message, such as BGM or NAD segments.\" .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment, grouping related simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple, atomic data value within a segment or composite element.\" .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the invoice process, may play multiple roles.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in a business process (e.g., Buyer, Seller, Delivery Party).\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal or physical address associated with an organization role assignment.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or service listed in the invoice.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"Net price or unit price associated with a line item.\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:InvoiceDetailSection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Invoice Detail Section\" ;\n  rdfs:comment \"Section of the invoice listing individual line items.\" .\n\n:InvoiceHeaderSection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Invoice Header Section\" ;\n  rdfs:comment \"Header section with document dates and reference numbers.\" .\n\n:InvoiceSummarySection a owl:Class ;\n  rdfs:subClassOf :Segment ;\n  rdfs:label \"Invoice Summary Section\" ;\n  rdfs:comment \"Summary section providing total tax and invoice amounts.\" .\n\n:LineItem a owl:Class ;\n  rdfs:subClassOf :CompositeDataElement ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in the invoice detail section.\" .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"A generic identifier such as a reference number or code.\" .\n\n:GlobalLocationNumber a owl:Class ;\n  rdfs:subClassOf :Identifier ;\n  rdfs:label \"Global Location Number\" ;\n  rdfs:comment \"A global location number (GLN) for uniquely identifying organizations or locations.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n  rdfs:label \"Organization Role Assignment\" ;\n  rdfs:comment \"A pivot class representing the assignment of a role (e.g., Buyer, Seller) to an organization, possibly with address and identifier.\" .\n\n#################################################################\n# OBJECT PROPERTIES & INVERSES\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Links an interchange envelope to the messages it contains.\" ;\n  owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n  rdfs:domain :Message ;\n  rdfs:range :InterchangeEnvelope ;\n  rdfs:label \"is contained in envelope\" ;\n  rdfs:comment \"Inverse property: relates a message to its containing interchange envelope.\" .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Associates a message with its segments.\" ;\n  owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n  rdfs:domain :Segment ;\n  rdfs:range :Message ;\n  rdfs:label \"is segment of\" ;\n  rdfs:comment \"Inverse property: relates a segment to the message it is part of.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement ;\n  rdfs:label \"has composite element\" ;\n  rdfs:comment \"Associates a segment with its composite data elements.\" ;\n  owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :Segment ;\n  rdfs:label \"is composite element of\" ;\n  rdfs:comment \"Inverse property: relates a composite data element to its segment.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement ;\n  rdfs:label \"has simple element\" ;\n  rdfs:comment \"Associates a composite data element with its simple data elements.\" ;\n  owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n  rdfs:domain :SimpleDataElement ;\n  rdfs:range :CompositeDataElement ;\n  rdfs:label \"is simple element of\" ;\n  rdfs:comment \"Inverse property: relates a simple data element to its composite data element.\" .\n\n:playsRole a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleAssignment ;\n  rdfs:label \"plays role\" ;\n  rdfs:comment \"Relates an organization to its role assignments in a transaction.\" ;\n  owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization ;\n  rdfs:label \"is role assignment of\" ;\n  rdfs:comment \"Inverse property: relates a role assignment to its organization.\" .\n\n:involvesOrganization a owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Organization ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Indicates which organizations are involved in an invoice message.\" ;\n  owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is organization involved in\" ;\n  rdfs:comment \"Inverse property: relates an organization to the invoice messages it is involved in.\" .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole ;\n  rdfs:label \"has role\" ;\n  rdfs:comment \"Specifies the agent role in an organization role assignment.\" ;\n  owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n  rdfs:domain :AgentRole ;\n  rdfs:range :OrganizationRoleAssignment ;\n  rdfs:label \"is role of assignment\" ;\n  rdfs:comment \"Inverse property: relates an agent role to the organization role assignments it is part of.\" .\n\n:assignedTo a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization ;\n  rdfs:label \"assigned to\" ;\n  rdfs:comment \"Specifies the organization to which a role assignment applies.\" ;\n  owl:inverseOf :hasRoleAssignment .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleAssignment ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Inverse property: relates an organization to its role assignments.\" .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Address ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization role assignment to a specific address.\" ;\n  owl:inverseOf :isAddressOfAssignment .\n\n:isAddressOfAssignment a owl:ObjectProperty ;\n  rdfs:domain :Address ;\n  rdfs:range :OrganizationRoleAssignment ;\n  rdfs:label \"is address of assignment\" ;\n  rdfs:comment \"Inverse property: relates an address to the organization role assignments it is associated with.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Associates an organization with its identifiers (e.g., GLN).\" ;\n  owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n  rdfs:domain :Identifier ;\n  rdfs:range :Organization ;\n  rdfs:label \"is identifier of\" ;\n  rdfs:comment \"Inverse property: relates an identifier to the organization it identifies.\" .\n\n:hasItem a owl:ObjectProperty ;\n  rdfs:domain :InvoiceDetailSection ;\n  rdfs:range :LineItem ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Indicates the line items in the invoice detail section.\" ;\n  owl:inverseOf :isItemOfDetailSection .\n\n:isItemOfDetailSection a owl:ObjectProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :InvoiceDetailSection ;\n  rdfs:label \"is item of detail section\" ;\n  rdfs:comment \"Inverse property: relates a line item to the detail section it belongs to.\" .\n\n:describesItem a owl:ObjectProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item ;\n  rdfs:label \"describes item\" ;\n  rdfs:comment \"Links a line item to the item being sold.\" ;\n  owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem a owl:ObjectProperty ;\n  rdfs:domain :Item ;\n  rdfs:range :LineItem ;\n  rdfs:label \"is described by line item\" ;\n  rdfs:comment \"Inverse property: relates an item to the line item that describes it.\" .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Associates a line item with its price.\" ;\n  owl:inverseOf :isPriceOfLineItem .\n\n:isPriceOfLineItem a owl:ObjectProperty ;\n  rdfs:domain :Price ;\n  rdfs:range :LineItem ;\n  rdfs:label \"is price of line item\" ;\n  rdfs:comment \"Inverse property: relates a price to the line item it is associated with.\" .\n\n:participatesIn a owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  rdfs:label \"participates in\" ;\n  rdfs:comment \"Indicates the business process to which the invoice is assigned.\" ;\n  owl:inverseOf :hasParticipantInvoice .\n\n:hasParticipantInvoice a owl:ObjectProperty ;\n  rdfs:domain :BusinessProcess ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"has participant invoice\" ;\n  rdfs:comment \"Inverse property: relates a business process to the invoice messages it includes.\" .\n\n:hasHeader a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :InvoiceHeaderSection ;\n  rdfs:label \"has header\" ;\n  rdfs:comment \"Links an invoice message to its header section.\" ;\n  owl:inverseOf :isHeaderOfInvoice .\n\n:isHeaderOfInvoice a owl:ObjectProperty ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is header of invoice\" ;\n  rdfs:comment \"Inverse property: relates a header section to the invoice message it belongs to.\" .\n\n:hasDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :InvoiceDetailSection ;\n  rdfs:label \"has detail\" ;\n  rdfs:comment \"Links an invoice message to its detail section.\" ;\n  owl:inverseOf :isDetailOfInvoice .\n\n:isDetailOfInvoice a owl:ObjectProperty ;\n  rdfs:domain :InvoiceDetailSection ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is detail of invoice\" ;\n  rdfs:comment \"Inverse property: relates a detail section to the invoice message it belongs to.\" .\n\n:hasSummary a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :InvoiceSummarySection ;\n  rdfs:label \"has summary\" ;\n  rdfs:comment \"Links an invoice message to its summary section.\" ;\n  owl:inverseOf :isSummaryOfInvoice .\n\n:isSummaryOfInvoice a owl:ObjectProperty ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range :InvoiceMessage ;\n  rdfs:label \"is summary of invoice\" ;\n  rdfs:comment \"Inverse property: relates a summary section to the invoice message it belongs to.\" .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"The unique invoice number in the header section.\" .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"The total invoice amount in the summary section.\" .\n\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Net or unit price for a line item.\" .\n\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:integer ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Quantity of the item sold in the line item.\" .\n\n:hasDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has date\" ;\n  rdfs:comment \"Date associated with the invoice document (string-encoded for OWL 2 compliance).\" .\n\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Reference number in the invoice header.\" .\n\n:hasMandatoryIdentifier a owl:DatatypeProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string ;\n  rdfs:label \"has mandatory identifier\" ;\n  rdfs:comment \"A mandatory identifier required by the D96A directory for file format validity.\" .\n\n#################################################################\n# DISJOINTNESS\n#################################################################\n:Organization owl:disjointWith :Address .\n:Message owl:disjointWith :Segment .\n:SimpleDataElement owl:disjointWith :CompositeDataElement .\n"
}
