      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACTOntology rdf:type owl:Ontology ;\n    rdfs:label \"EDIFACT Ontology for Digital Business Documents\" ;\n    rdfs:comment \"A deep, richly structured OWL ontology for EDIFACT, supporting invoices, organizations, roles, segments, data elements, and alignment with EN16931 and P2P-O standards.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n:EDIFACTInterchange rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Interchange Envelope\" ;\n    rdfs:comment \"The outermost envelope in the EDIFACT hierarchy, containing messages.\" .\n\n:EDIFACTMessage rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A business document within an EDIFACT interchange, such as an INVOIC message.\" .\n\n:EDIFACTSegment rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Segment\" ;\n    rdfs:comment \"A structural component of an EDIFACT message, such as BGM or NAD.\" .\n\n:EDIFACTCompositeDataElement rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Composite Data Element\" ;\n    rdfs:comment \"A composite element within a segment, composed of simple data elements.\" .\n\n:EDIFACTSimpleDataElement rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite element.\" .\n\n:EDIFACTDelimiter rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Delimiter\" ;\n    rdfs:comment \"A character used to separate EDIFACT elements, such as plus or colon.\" .\n\n:Invoice rdf:type owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"An invoice document represented in an EDIFACT message.\" .\n\n:InvoiceHeader rdf:type owl:Class ;\n    rdfs:label \"Invoice Header Section\" ;\n    rdfs:comment \"The header section of an invoice, containing dates and reference numbers.\" ;\n    rdfs:subClassOf :EDIFACTMessageSection .\n\n:InvoiceDetail rdf:type owl:Class ;\n    rdfs:label \"Invoice Detail Section\" ;\n    rdfs:comment \"The detail section of an invoice, listing line items.\" ;\n    rdfs:subClassOf :EDIFACTMessageSection .\n\n:InvoiceSummary rdf:type owl:Class ;\n    rdfs:label \"Invoice Summary Section\" ;\n    rdfs:comment \"The summary section of an invoice, with totals and tax amounts.\" ;\n    rdfs:subClassOf :EDIFACTMessageSection .\n\n:EDIFACTMessageSection rdf:type owl:Class ;\n    rdfs:label \"EDIFACT Message Section\" ;\n    rdfs:comment \"A section within an EDIFACT message, such as header, detail, or summary.\" .\n\n:InvoiceLineItem rdf:type owl:Class ;\n    rdfs:label \"Invoice Line Item\" ;\n    rdfs:comment \"A line item in the invoice detail section, describing a sold item.\" .\n\n:Organization rdf:type owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An entity involved in the invoice, such as buyer or delivery party.\" .\n\n:AgentRole rdf:type owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice.\" .\n\n:RoleAssignment rdf:type owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A pivot class for reification, connecting organizations to roles in a specific context.\" .\n\n:Address rdf:type owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization.\" .\n\n:GlobalLocationNumber rdf:type owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A unique identifier for an organization location.\" .\n\n:DocumentDate rdf:type owl:Class ;\n    rdfs:label \"Document Date\" ;\n    rdfs:comment \"A date related to the invoice document.\" .\n\n:ReferenceNumber rdf:type owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for the invoice document.\" .\n\n:Item rdf:type owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item sold in the invoice.\" .\n\n:NetPrice rdf:type owl:Class ;\n    rdfs:label \"Net Price\" ;\n    rdfs:comment \"The net price of an item in the invoice.\" .\n\n:Quantity rdf:type owl:Class ;\n    rdfs:label \"Quantity\" ;\n    rdfs:comment \"The quantity of an item in the invoice.\" .\n\n:TaxAmount rdf:type owl:Class ;\n    rdfs:label \"Tax Amount\" ;\n    rdfs:comment \"The total tax amount in the invoice summary.\" .\n\n:TotalAmount rdf:type owl:Class ;\n    rdfs:label \"Total Amount\" ;\n    rdfs:comment \"The total invoice amount in the summary section.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:EN16931ValidationResult rdf:type owl:Class ;\n    rdfs:label \"EN 16931 Validation Result\" ;\n    rdfs:comment \"Result of validating the invoice against EN 16931.\" .\n\n:P2POAlignment rdf:type owl:Class ;\n    rdfs:label \"Purchase-to-Pay Ontology Alignment\" ;\n    rdfs:comment \"Alignment with the Purchase-to-Pay Ontology (P2P-O).\" .\n\n:SHACLConstraintResult rdf:type owl:Class ;\n    rdfs:label \"SHACL Constraint Result\" ;\n    rdfs:comment \"Result of SHACL validation for the invoice.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n:containsMessage rdf:type owl:ObjectProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an EDIFACT interchange to its contained messages.\" ;\n    rdfs:domain :EDIFACTInterchange ;\n    rdfs:range :EDIFACTMessage ;\n    rdf:type owl:FunctionalProperty .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTSegment .\n\n:hasCompositeDataElement rdf:type owl:ObjectProperty ;\n    rdfs:label \"has composite data element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :EDIFACTCompositeDataElement .\n\n:hasSimpleDataElement rdf:type owl:ObjectProperty ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    rdfs:domain :EDIFACTCompositeDataElement ;\n    rdfs:range :EDIFACTSimpleDataElement .\n\n:hasSection rdf:type owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links a message to its sections (header, detail, summary).\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTMessageSection .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links a detail section to its invoice line items.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceLineItem .\n\n:hasOrganizationRoleAssignment rdf:type owl:ObjectProperty ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Links an invoice to a role assignment pivot class.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :RoleAssignment .\n\n:involvesOrganization rdf:type owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links a role assignment to an involved organization.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    rdf:type owl:FunctionalProperty .\n\n:hasAgentRole rdf:type owl:ObjectProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a role assignment to an agent role.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdf:type owl:FunctionalProperty .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasGlobalLocationNumber rdf:type owl:ObjectProperty ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"Links an organization to its GLN identifier.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :GlobalLocationNumber ;\n    rdf:type owl:FunctionalProperty .\n\n:hasBuyer rdf:type owl:ObjectProperty ;\n    rdfs:label \"has buyer\" ;\n    rdfs:comment \"Links an invoice to its buyer organization.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdf:type owl:FunctionalProperty .\n\n:hasDeliveryParty rdf:type owl:ObjectProperty ;\n    rdfs:label \"has delivery party\" ;\n    rdfs:comment \"Links an invoice to its delivery party organization.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization ;\n    rdf:type owl:FunctionalProperty .\n\n:hasItem rdf:type owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a line item to its item.\" ;\n    rdfs:domain :InvoiceLineItem ;\n    rdfs:range :Item .\n\n:hasNetPrice rdf:type owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links a line item to its net price.\" ;\n    rdfs:domain :InvoiceLineItem ;\n    rdfs:range :NetPrice ;\n    rdf:type owl:FunctionalProperty .\n\n:hasQuantity rdf:type owl:ObjectProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Links a line item to its quantity.\" ;\n    rdfs:domain :InvoiceLineItem ;\n    rdfs:range :Quantity ;\n    rdf:type owl:FunctionalProperty .\n\n:hasTaxAmount rdf:type owl:ObjectProperty ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"Links a summary section to its tax amount.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :TaxAmount ;\n    rdf:type owl:FunctionalProperty .\n\n:hasTotalAmount rdf:type owl:ObjectProperty ;\n    rdfs:label \"has total amount\" ;\n    rdfs:comment \"Links a summary section to its total amount.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :TotalAmount ;\n    rdf:type owl:FunctionalProperty .\n\n:isAlignedWithP2PO rdf:type owl:ObjectProperty ;\n    rdfs:label \"is aligned with P2P-O\" ;\n    rdfs:comment \"Links an invoice to its alignment with the Purchase-to-Pay Ontology.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :P2POAlignment .\n\n:hasValidationResult rdf:type owl:ObjectProperty ;\n    rdfs:label \"has validation result\" ;\n    rdfs:comment \"Links an invoice to its EN 16931 validation result.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :EN16931ValidationResult .\n\n:hasSHACLConstraintResult rdf:type owl:ObjectProperty ;\n    rdfs:label \"has SHACL constraint result\" ;\n    rdfs:comment \"Links an invoice to its SHACL constraint validation result.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :SHACLConstraintResult .\n\n:isAssignedToBusinessProcess rdf:type owl:ObjectProperty ;\n    rdfs:label \"is assigned to business process\" ;\n    rdfs:comment \"Links an invoice to its related business process.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess .\n\n:referencesDocumentDate rdf:type owl:ObjectProperty ;\n    rdfs:label \"references document date\" ;\n    rdfs:comment \"Links an invoice header to its document date.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :DocumentDate ;\n    rdf:type owl:FunctionalProperty .\n\n:referencesReferenceNumber rdf:type owl:ObjectProperty ;\n    rdfs:label \"references reference number\" ;\n    rdfs:comment \"Links an invoice header to its reference number.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :ReferenceNumber ;\n    rdf:type owl:FunctionalProperty .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n:segmentTag rdf:type owl:DatatypeProperty ;\n    rdfs:label \"segment tag\" ;\n    rdfs:comment \"EDIFACT segment identifier, e.g., BGM, NAD.\" ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:compositeElementCode rdf:type owl:DatatypeProperty ;\n    rdfs:label \"composite element code\" ;\n    rdfs:comment \"EDIFACT composite element code.\" ;\n    rdfs:domain :EDIFACTCompositeDataElement ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:simpleElementCode rdf:type owl:DatatypeProperty ;\n    rdfs:label \"simple element code\" ;\n    rdfs:comment \"EDIFACT simple data element code.\" ;\n    rdfs:domain :EDIFACTSimpleDataElement ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:addressLine rdf:type owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"Street or address line.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city rdf:type owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode rdf:type owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:countryCode rdf:type owl:DatatypeProperty ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:globalLocationNumberValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"global location number value\" ;\n    rdfs:comment \"The value of the Global Location Number.\" ;\n    rdfs:domain :GlobalLocationNumber ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:roleCode rdf:type owl:DatatypeProperty ;\n    rdfs:label \"role code\" ;\n    rdfs:comment \"Code representing the agent role.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:itemDescription rdf:type owl:DatatypeProperty ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"Description of the item in the invoice.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:netPriceValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"net price value\" ;\n    rdfs:comment \"The net price value of an item.\" ;\n    rdfs:domain :NetPrice ;\n    rdfs:range xsd:decimal ;\n    rdf:type owl:FunctionalProperty .\n\n:quantityValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"quantity value\" ;\n    rdfs:comment \"The quantity value of an item.\" ;\n    rdfs:domain :Quantity ;\n    rdfs:range xsd:decimal ;\n    rdf:type owl:FunctionalProperty .\n\n:taxAmountValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"tax amount value\" ;\n    rdfs:comment \"The value of the tax amount.\" ;\n    rdfs:domain :TaxAmount ;\n    rdfs:range xsd:decimal ;\n    rdf:type owl:FunctionalProperty .\n\n:totalAmountValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"total amount value\" ;\n    rdfs:comment \"The value of the total invoice amount.\" ;\n    rdfs:domain :TotalAmount ;\n    rdfs:range xsd:decimal ;\n    rdf:type owl:FunctionalProperty .\n\n:documentDateValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"document date value\" ;\n    rdfs:comment \"The value of the document date.\" ;\n    rdfs:domain :DocumentDate ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:referenceNumberValue rdf:type owl:DatatypeProperty ;\n    rdfs:label \"reference number value\" ;\n    rdfs:comment \"The value of the reference number.\" ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:validationStatus rdf:type owl:DatatypeProperty ;\n    rdfs:label \"validation status\" ;\n    rdfs:comment \"Status of EN 16931 validation.\" ;\n    rdfs:domain :EN16931ValidationResult ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n:shaclStatus rdf:type owl:DatatypeProperty ;\n    rdfs:label \"SHACL status\" ;\n    rdfs:comment \"Status of SHACL constraint validation.\" ;\n    rdfs:domain :SHACLConstraintResult ;\n    rdfs:range xsd:string ;\n    rdf:type owl:FunctionalProperty .\n\n#################################################################\n# COMPLEX AXIOMS & RESTRICTIONS\n#################################################################\n# General Class Axiom: Invoice must have a buyer organization\n[] rdf:type owl:Restriction ;\n    owl:onProperty :hasBuyer ;\n    owl:someValuesFrom :Organization ;\n    rdfs:subClassOf :Invoice .\n\n# Equivalence: Invoice must have only InvoiceLineItems\n:Invoice owl:equivalentClass [ rdf:type owl:Restriction ;\n    owl:onProperty :hasLineItem ;\n    owl:allValuesFrom :InvoiceLineItem ] .\n\n#################################################################\n# DISJOINTNESS & DISJOINT UNION\n#################################################################\n:EDIFACTInterchange owl:disjointWith :EDIFACTMessage .\n:EDIFACTMessage owl:disjointWith :EDIFACTSegment .\n:EDIFACTSegment owl:disjointWith :EDIFACTCompositeDataElement .\n:EDIFACTCompositeDataElement owl:disjointWith :EDIFACTSimpleDataElement .\n:InvoiceHeader owl:disjointWith :InvoiceDetail .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n:InvoiceHeader owl:disjointWith :InvoiceSummary .\n:Organization owl:disjointWith :Address .\n:AgentRole owl:disjointWith :Organization .\n:InvoiceLineItem owl:disjointWith :Organization .\n:InvoiceLineItem owl:disjointWith :Address .\n:EDIFACTMessageSection owl:disjointUnionOf (:InvoiceHeader :InvoiceDetail :InvoiceSummary) ."
}
