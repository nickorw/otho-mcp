      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#storyid> a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing EDIFACT invoice messages, organizations, roles, and business processes, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The outer envelope for EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT invoice message.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section of an invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section of an invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section of an invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite data element.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the context of an invoice (e.g., Buyer, Delivery Party).\" .\n\n:InvoiceParticipantRoleAssignment a owl:Class ;\n    rdfs:label \"Invoice Participant Role Assignment\" ;\n    rdfs:comment \"A reification class linking an organization, its role, address, and the invoice.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier such as a Global Location Number (GLN).\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item being sold in the invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the detail section.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with a line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice may belong.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n:hasMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"has message\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a Segment to its Composite Data Elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a Composite Data Element to its Simple Data Elements.\" .\n\n:playsRole a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceParticipantRoleAssignment ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Links an Organization to its role assignment in an invoice.\" .\n\n:hasRole a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a role assignment to its AgentRole.\" .\n\n:inInvoice a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"in invoice\" ;\n    rdfs:comment \"Links a role assignment to the InvoiceMessage.\" .\n\n:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links a role assignment to its Address.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an Organization to its Identifier.\" .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links a DetailSection to its LineItems.\" .\n\n:describesItem a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a LineItem to an Item.\" .\n\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a LineItem to its Price.\" .\n\n:partOfBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"part of business process\" ;\n    rdfs:comment \"Links an InvoiceMessage to a BusinessProcess.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n:invoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The number uniquely identifying the invoice.\" .\n\n:documentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"document date\" ;\n    rdfs:comment \"The date the document was created.\" .\n\n:referenceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"reference number\" ;\n    rdfs:comment \"Reference number in the document header.\" .\n\n:organizationName a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"Name of the organization.\" .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line of the address.\" .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" .\n\n:city a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of the address.\" .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" .\n\n:identifierValue a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"Value of the identifier.\" .\n\n:identifierScheme a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier scheme\" ;\n    rdfs:comment \"Scheme of the identifier (e.g., GLN).\" .\n\n:itemName a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item name\" ;\n    rdfs:comment \"Name of the item.\" .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"Description of the item.\" .\n\n:quantity a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"Quantity of the item in the line.\" .\n\n:netPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"Net price of the item.\" .\n\n:taxAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"Total tax amount in the summary.\" .\n\n:invoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"Total invoice amount in the summary.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n:Organization owl:disjointWith :Item, :Address .\n:Item owl:disjointWith :Address .\n:Price owl:disjointWith :Organization .\n\n#################################################################\n# Advanced Axioms & Restrictions\n#################################################################\n# Example: All InvoiceParticipantRoleAssignment must refer to exactly one InvoiceMessage, AgentRole, and Address\n:InvoiceParticipantRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :inInvoice ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasRole ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasAddress ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n:LineItem rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :describesItem ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasPrice ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasSegment ;\n    owl:someValuesFrom :HeaderSection\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasSegment ;\n    owl:someValuesFrom :DetailSection\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasSegment ;\n    owl:someValuesFrom :SummarySection\n] .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
