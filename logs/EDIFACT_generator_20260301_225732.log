rganization to its role assignment in an invoice.\\\" ;\\n    owl:inverseOf :isRoleAssignmentOf .\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is role assignment of\\\" ;\\n    rdfs:comment \\\"Inverse: Role assignment is for Organization.\\\" .\\n\\n:hasRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Links a role assignment to its AgentRole.\\\" ;\\n    owl:inverseOf :isRoleOfAssignment .\\n:isRoleOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :InvoiceParticipantRoleAssignment ;\\n    rdfs:label \\\"is role of assignment\\\" ;\\n    rdfs:comment \\\"Inverse: AgentRole is assigned in RoleAssignment.\\\" .\\n\\n:inInvoice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"in invoice\\\" ;\\n    rdfs:comment \\\"Links a role assignment to the InvoiceMessage.\\\" ;\\n    owl:inverseOf :hasParticipantRoleAssignment .\\n:hasParticipantRoleAssignment a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceParticipantRoleAssignment ;\\n    rdfs:label \\\"has participant role assignment\\\" ;\\n    rdfs:comment \\\"Inverse: InvoiceMessage has participant role assignments.\\\" .\\n\\n:hasAddress a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceParticipantRoleAssignment ;\\n    rdfs:range :Address ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links a role assignment to its Address.\\\" ;\\n    owl:inverseOf :isAddressOfAssignment .\\n:isAddressOfAssignment a owl:ObjectProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range :InvoiceParticipantRoleAssignment ;\\n    rdfs:label \\\"is address of assignment\\\" ;\\n    rdfs:comment \\\"Inverse: Address is for RoleAssignment.\\\" .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Identifier.\\\" ;\\n    owl:inverseOf :isIdentifierOf .\\n:isIdentifierOf a owl:ObjectProperty ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range :Organization ;\\n    rdfs:label \\\"is identifier of\\\" ;\\n    rdfs:comment \\\"Inverse: Identifier is for Organization.\\\" .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:domain :DetailSection ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Links a DetailSection to its LineItems.\\\" ;\\n    owl:inverseOf :isLineItemOf .\\n:isLineItemOf a owl:ObjectProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :DetailSection ;\\n    rdfs:label \\\"is line item of\\\" ;\\n    rdfs:comment \\\"Inverse: LineItem is part of DetailSection.\\\" .\\n\\n:describesItem a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item ;\\n    rdfs:label \\\"describes item\\\" ;\\n    rdfs:comment \\\"Links a LineItem to an Item.\\\" ;\\n    owl:inverseOf :isDescribedByLineItem .\\n:isDescribedByLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Item ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is described by line item\\\" ;\\n    rdfs:comment \\\"Inverse: Item is described by LineItem.\\\" .\\n\\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Links a LineItem to its Price.\\\" ;\\n    owl:inverseOf :isPriceOfLineItem .\\n:isPriceOfLineItem a owl:ObjectProperty ;\\n    rdfs:domain :Price ;\\n    rdfs:range :LineItem ;\\n    rdfs:label \\\"is price of line item\\\" ;\\n    rdfs:comment \\\"Inverse: Price is for LineItem.\\\" .\\n\\n:partOfBusinessProcess a owl:ObjectProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    rdfs:label \\\"part of business process\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a BusinessProcess.\\\" ;\\n    owl:inverseOf :hasInvoiceMessage .\\n:hasInvoiceMessage a owl:ObjectProperty ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    rdfs:label \\\"has invoice message\\\" ;\\n    rdfs:comment \\\"Inverse: BusinessProcess has InvoiceMessage.\\\" .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:invoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"The number uniquely identifying the invoice.\\\" .\\n\\n:documentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:dateTime ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"The date the document was created.\\\" .\\n\\n:referenceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"reference number\\\" ;\\n    rdfs:comment \\\"Reference number in the document header.\\\" .\\n\\n:organizationName a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"organization name\\\" ;\\n    rdfs:comment \\\"Name of the organization.\\\" .\\n\\n:addressLine a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"address line\\\" ;\\n    rdfs:comment \\\"A line of the address.\\\" .\\n\\n:postalCode a owl:DatatypeProperty ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string ;\\n    rdfs:label \\\"postal code\\\" ;\\n    rdfs:comment \\\"Postal code o