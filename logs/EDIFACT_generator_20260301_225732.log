nalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a LineItem to its Price.\" .\n\n:partOfBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"part of business process\" ;\n    rdfs:comment \"Links an InvoiceMessage to a BusinessProcess.\" .\n\n#################################################################\n# Data Properties\n#################################################################\n:invoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The number uniquely identifying the invoice.\" .\n\n:documentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"document date\" ;\n    rdfs:comment \"The date the document was created.\" .\n\n:referenceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"reference number\" ;\n    rdfs:comment \"Reference number in the document header.\" .\n\n:organizationName a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"Name of the organization.\" .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line of the address.\" .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" .\n\n:city a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of the address.\" .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" .\n\n:identifierValue a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"Value of the identifier.\" .\n\n:identifierScheme a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier scheme\" ;\n    rdfs:comment \"Scheme of the identifier (e.g., GLN).\" .\n\n:itemName a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item name\" ;\n    rdfs:comment \"Name of the item.\" .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"Description of the item.\" .\n\n:quantity a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"Quantity of the item in the line.\" .\n\n:netPrice a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"Net price of the item.\" .\n\n:taxAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"Total tax amount in the summary.\" .\n\n:invoiceAmount a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"Total invoice amount in the summary.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n:Organization owl:disjointWith :Item, :Address .\n:Item owl:disjointWith :Address .\n:Price owl:disjointWith :Organization .\n\n#################################################################\n# Advanced Axioms & Restrictions\n#################################################################\n# Example: All InvoiceParticipantRoleAssignment must refer to exactly one InvoiceMessage, AgentRole, and Address\n:InvoiceParticipantRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :inInvoice ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasRole ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasAddress ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n:LineItem rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :describesItem ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasPrice ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasSegment ;\n    owl:someValuesFrom :HeaderSection\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasSegment ;\n    owl:someValuesFrom :DetailSection\n] , [\n    a owl:Restriction ;\n    owl:onProperty :hasSegment ;\n    owl:someValuesFrom :SummarySection\n] .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
