\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the context of an invoice (e.g., Buyer, Delivery Party).\\\" .\\n\\n:InvoiceParticipantRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Invoice Participant Role Assignment\\\" ;\\n    rdfs:comment \\\"A reification class linking an organization, its role, address, and the invoice.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal address.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"An identifier such as a Global Location Number (GLN).\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"An item being sold in the invoice.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"A line item in the detail section.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A price associated with a line item.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice may belong.\\\" .\\n\\n#################################################################\\n# Object Properties and Inverses\\n#################################################################\\n:hasMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Links an InterchangeEnvelope to its contained Message.\\\" ;\\n    owl:inverseOf :isMessageOf .\\n:isMessageOf a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    rdfs:label \\\"is message of\\\" ;\\n    rdfs:comment \\\"Inverse: Message is contained in InterchangeEnvelope.\\\" .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a Message to its Segments.\\\" ;\\n    owl:inverseOf :isSegmentOf .\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse: Segment is part of a Message.\\\" .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a Segment to its Composite Data Elements.\\\" ;\\n    owl:inverseOf :isCompositeElementOf .\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    rdfs:label \\\"is composite element of\\\" ;\\n    rdfs:comment \\\"Inverse: CompositeDataElement is part of a Segment.\\\" .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a Composite Data Element to its Simple Data Elements.\\\" ;\\n    owl:inverseOf :isSimpleElementOf .\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    rdfs:label \\\"is simple element of\\\" ;\\n    rdfs:comment \\\"Inverse: SimpleDataElement is part of a CompositeDataElement.\\\" .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :InvoiceParticipantRoleAssignment ;\\n    rdfs:label \\\"plays role\\\" ;\\n    rdfs:comment \\\"Links an 