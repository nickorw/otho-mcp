      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/story1>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"An ontology for representing UN/EDIFACT invoice messages, their structure, participants, and business semantics, with alignment to EN 16931-1 and P2P-O.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The top-level envelope for EDIFACT messages.\\\" .\\n\\n:EDIFACTMessage a owl:Class ;\\n    rdfs:label \\\"EDIFACT Message\\\" ;\\n    rdfs:comment \\\"A message contained within an interchange envelope.\\\" ;\\n    rdfs:subClassOf :InterchangeEnvelope .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"An EDIFACT message representing an invoice.\\\" ;\\n    rdfs:subClassOf :EDIFACTMessage .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A segment within an EDIFACT message, such as BGM or NAD.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple (atomic) data element within a composite.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:Delimiter a owl:Class ;\\n    rdfs:label \\\"Delimiter\\\" ;\\n    rdfs:comment \\\"A character used to separate elements in EDIFACT messages.\\\" .\\n\\n:InvoiceHeader a owl:Class ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"The header section of an invoice message.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"The detail section of an invoice message, typically listing line items.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"The summary section of an invoice message, providing totals.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in a business process or invoice.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role that an organization plays in the context of an invoice (e.g., Buyer, DeliveryParty).\\\" .\\n\\n:RoleAssignment a owl:Class ;\\n    rdfs:label \\\"Role Assignment\\\" ;\\n    rdfs:comment \\\"A reification class linking an organization, its role, and the invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address for an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A unique identifier for an organization or address (e.g., GLN).\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:LineItem a owl:Class ;\\n    rdfs:label \\\"Line Item\\\" ;\\n    rdfs:comment \\\"An itemized entry in an invoice detail section.\\\" ;\\n    rdfs:subClassOf :InvoiceDetail .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"The price of an item in a line item.\\\" ;\\n    rdfs:subClassOf :LineItem .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint for validating invoice content (referenced for SHACL, not modeled in OWL).\\\" .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Relates an interchange envelope to its contained EDIFACT message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :EDIFACTMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its segments.\\\" ;\\n    rdfs:domain :EDIFACTMessage ;\\n    rdfs:range :Segment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Relates a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Relates a composite data element to its simple elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:hasDelimiter a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has delimiter\\\" ;\\n    rdfs:comment \\\"Relates an EDIFACT message to its delimiter character(s).\\\" ;\\n    rdfs:domain :EDIFACTMessage ;\\n    rdfs:range :Delimiter .\\n\\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its header section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader .\\n\\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its detail section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceDetail .\\n\\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its summary section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSummary .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involves organization\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to an involved organization.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Organization .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to a role assignment (reification of organization, role, and context).\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :RoleAssignment .\\n\\n:hasAgentRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has agent role\\\" ;\\n    rdfs:comment \\\"Relates a role assignment to its agent role.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :AgentRole .\\n\\n:hasParticipant a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has participant\\\" ;\\n    rdfs:comment \\\"Relates a role assignment to the participating organization.\\\" ;\\n    rdfs:domain :RoleAssignment ;\\n    rdfs:range :Organization .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Relates an organization to its address(es).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Relates an organization to its identifier(s).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier .\\n\\n:hasLineItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has line item\\\" ;\\n    rdfs:comment \\\"Relates an invoice detail section to its line items.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :LineItem .\\n\\n:soldItem a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"sold item\\\" ;\\n    rdfs:comment \\\"Relates a line item to the item sold.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Item .\\n\\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Relates a line item to its price.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range :Price .\\n\\n:assignedToProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"assigned to process\\\" ;\\n    rdfs:comment \\\"Assigns an invoice message to a business process.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:segmentCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"segment code\\\" ;\\n    rdfs:comment \\\"The code of a segment (e.g., BGM, NAD).\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range xsd:string .\\n\\n:dataValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"data value\\\" ;\\n    rdfs:comment \\\"The value of a simple data element.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range xsd:string .\\n\\n:delimiterValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"delimiter value\\\" ;\\n    rdfs:comment \\\"The character value of a delimiter.\\\" ;\\n    rdfs:domain :Delimiter ;\\n    rdfs:range xsd:string .\\n\\n:invoiceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"The unique identifier of an invoice.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:invoiceDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"invoice date\\\" ;\\n    rdfs:comment \\\"The date the invoice was issued.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:dateTime .\\n\\n:netPrice a owl:DatatypeProperty ;\\n    rdfs:label \\\"net price\\\" ;\\n    rdfs:comment \\\"The net price of an item in the invoice.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal .\\n\\n:quantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"quantity\\\" ;\\n    rdfs:comment \\\"The quantity of items in a line item.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:totalTaxAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"total tax amount\\\" ;\\n    rdfs:comment \\\"The total tax amount in the invoice summary.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:invoiceAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"invoice amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:organizationName a owl:DatatypeProperty ;\\n    rdfs:label \\\"organization name\\\" ;\\n    rdfs:comment \\\"The name of the organization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n\\n:roleCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"role code\\\" ;\\n    rdfs:comment \\\"The code representing the agent role (e.g., Buyer, DeliveryParty).\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range xsd:string .\\n\\n:addressLine a owl:DatatypeProperty ;\\n    rdfs:label \\\"address line\\\" ;\\n    rdfs:comment \\\"A line of an address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:identifierValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"identifier value\\\" ;\\n    rdfs:comment \\\"The value of an identifier (e.g., GLN).\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n:itemName a owl:DatatypeProperty ;\\n    rdfs:label \\\"item name\\\" ;\\n    rdfs:comment \\\"The name or description of an item.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Restrictions & Axioms\\n#################################################################\\n\\n# InvoiceMessage must have at least one involvesOrganization\\n:InvoiceMessage rdfs:subClassOf [\\n    a owl:Restriction ;\\n    owl:onProperty :involvesOrganization ;\\n    owl:someValuesFrom :Organization\\n] .\\n\\n# RoleAssignment definition\\n:RoleAssignment owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:someValuesFrom :AgentRole ]\\n        [ a owl:Restriction ; owl:onProperty :hasParticipant ; owl:someValuesFrom :Organization ]\\n    )\\n] .\\n\\n# LineItem must have one soldItem and one hasPrice\\n:LineItem rdfs:subClassOf [\\n    a owl:Restriction ; owl:onProperty :soldItem ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] , [\\n    a owl:Restriction ; owl:onProperty :hasPrice ; owl:cardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] .\\n\\n# Organization must have at least one identifier\\n:Organization rdfs:subClassOf [\\n    a owl:Restriction ; owl:onProperty :hasIdentifier ; owl:someValuesFrom :Identifier\\n] .\\n\\n# InvoiceSummary must have invoiceAmount\\n:InvoiceSummary rdfs:subClassOf [\\n    a owl:Restriction ; owl:onProperty :invoiceAmount ; owl:someValuesFrom xsd:decimal\\n] .\\n\\n#################################################################\\n# Disjointness\\n#################################################################\\n\\n:Organization owl:disjointWith :Item, :Address .\\n:Segment owl:disjointWith :Address .\\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n\"}",
