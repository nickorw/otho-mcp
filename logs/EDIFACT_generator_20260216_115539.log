 rdfs:label \\\"Header Section\\\"@en ;\\n  rdfs:comment \\\"The header section of an invoice message, containing document dates and references.\\\"@en .\\n\\n:DetailSection a owl:Class ;\\n  rdfs:label \\\"Detail Section\\\"@en ;\\n  rdfs:comment \\\"The detail section listing line items in the invoice.\\\"@en .\\n\\n:SummarySection a owl:Class ;\\n  rdfs:label \\\"Summary Section\\\"@en ;\\n  rdfs:comment \\\"The summary section providing totals and tax information.\\\"@en .\\n\\n:Organization a owl:Class ;\\n  rdfs:label \\\"Organization\\\"@en ;\\n  rdfs:comment \\\"An organization involved in the invoice, such as buyer or supplier.\\\"@en .\\n\\n:AgentRole a owl:Class ;\\n  rdfs:label \\\"Agent Role\\\"@en ;\\n  rdfs:comment \\\"A role played by an organization in the context of an invoice (e.g., Buyer, Delivery Party).\\\"@en .\\n\\n:Address a owl:Class ;\\n  rdfs:label \\\"Address\\\"@en ;\\n  rdfs:comment \\\"A postal address associated with an organization.\\\"@en .\\n\\n:Identifier a owl:Class ;\\n  rdfs:label \\\"Identifier\\\"@en ;\\n  rdfs:comment \\\"A generic identifier for organizations, segments, or elements.\\\"@en .\\n\\n:GlobalLocationNumber a owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\"@en ;\\n  rdfs:comment \\\"A global location number (GLN) for uniquely identifying organizations.\\\"@en ;\\n  rdfs:subClassOf :Identifier .\\n\\n:Item a owl:Class ;\\n  rdfs:label \\\"Item\\\"@en ;\\n  rdfs:comment \\\"A product or service listed in the invoice.\\\"@en .\\n\\n:Price a owl:Class ;\\n  rdfs:label \\\"Price\\\"@en ;\\n  rdfs:comment \\\"A price value, associated with items or totals.\\\"@en .\\n\\n:Quantity a owl:Class ;\\n  rdfs:label \\\"Quantity\\\"@en ;\\n  rdfs:comment \\\"A quantity value for items in the invoice.\\\"@en .\\n\\n:Tax a owl:Class ;\\n  rdfs:label \\\"Tax\\\"@en ;\\n  rdfs:comment \\\"A tax value in the summary section.\\\"@en .\\n\\n:ReferenceNumber a owl:Class ;\\n  rdfs:label \\\"Reference Number\\\"@en ;\\n  rdfs