2026-02-16 12:05:44 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-story> a owl:Ontology ;\n  rdfs:label \"EDIFACT Story Ontology\"@en ;\n  rdfs:comment \"A deep and profoundly structured ontology for EDIFACT messages, invoices, and related procurement scenarios, aligned with EN 16931-1 and P2P-O.\"@en .\n\n#################################################################\n# CLASSES\n#################################################################\n:EdifactInterchange a owl:Class ;\n  rdfs:label \"EDIFACT Interchange\"@en ;\n  rdfs:comment \"The top-level envelope containing EDIFACT messages.\"@en .\n\n:EdifactMessage a owl:Class ;\n  rdfs:label \"EDIFACT Message\"@en ;\n  rdfs:comment \"A message within an EDIFACT interchange, such as INVOIC.\"@en .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:label \"Invoice Message\"@en ;\n  rdfs:comment \"A specific EDIFACT message representing an invoice.\"@en ;\n  rdfs:subClassOf :EdifactMessage .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\"@en ;\n  rdfs:comment \"A segment within an EDIFACT message, such as BGM or NAD.\"@en .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\"@en ;\n  rdfs:comment \"A composite data element, grouping simple data elements.\"@en .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\"@en ;\n  rdfs:comment \"A simple data element, the atomic unit of information in EDIFACT.\"@en .\n\n:Delimiter a owl:Class ;\n  rdfs:label \"Delimiter\"@en ;\n  rdfs:comment \"A character used to separate elements in EDIFACT (e.g., +, :).\"@en .\n\n:HeaderSection a owl:Class ;\n  rdfs:label \"Header Section\"@en ;\n  rdfs:comment \"The header section of an invoice message, containing document dates and references.\"@en .\n\n:DetailSection a owl:Class ;\n  rdfs:label \"Detail Section\"@en ;\n  rdfs:comment \"The detail section listing line items in the invoice.\"@en .\n\n:SummarySection a owl:Class ;\n  rdfs:label \"Summary Section\"@en ;\n  rdfs:comment \"The summary section providing totals and tax information.\"@en .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\"@en ;\n  rdfs:comment \"An organization involved in the invoice, such as buyer or supplier.\"@en .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\"@en ;\n  rdfs:comment \"A role played by an organization in the context of an invoice (e.g., Buyer, Delivery Party).\"@en .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\"@en ;\n  rdfs:comment \"A postal address associated with an organization.\"@en .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\"@en ;\n  rdfs:comment \"A generic identifier for organizations, segments, or elements.\"@en .\n\n:GlobalLocationNumber a owl:Class ;\n  rdfs:label \"Global Location Number\"@en ;\n  rdfs:comment \"A global location number (GLN) for uniquely identifying organizations.\"@en ;\n  rdfs:subClassOf :Identifier .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\"@en ;\n  rdfs:comment \"A product or service listed in the invoice.\"@en .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\"@en ;\n  rdfs:comment \"A price value, associated with items or totals.\"@en .\n\n:Quantity a owl:Class ;\n  rdfs:label \"Quantity\"@en ;\n  rdfs:comment \"A quantity value for items in the invoice.\"@en .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\"@en ;\n  rdfs:comment \"A tax value in the summary section.\"@en .\n\n:ReferenceNumber a owl:Class ;\n  rdfs:label \"Reference Number\"@en ;\n  rdfs:comment \"A reference number for the invoice or related documents.\"@en .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\"@en ;\n  rdfs:comment \"A business process to which the invoice is assigned.\"@en .\n\n:ValidationConstraint a owl:Class ;\n  rdfs:label \"Validation Constraint\"@en ;\n  rdfs:comment \"A constraint for validating invoice data, e.g., SHACL shapes.\"@en .\n\n:ShaclConstraint a owl:Class ;\n  rdfs:label \"SHACL Constraint\"@en ;\n  rdfs:comment \"A SHACL constraint for automated validation.\"@en ;\n  rdfs:subClassOf :ValidationConstraint .\n\n:Standard a owl:Class ;\n  rdfs:label \"Standard\"@en ;\n  rdfs:comment \"A standard relevant to the invoice (e.g., EDIFACT directory, EN 16931-1, P2P-O).\"@en .\n\n:EdifactDirectory a owl:Class ;\n  rdfs:label \"EDIFACT Directory\"@en ;\n  rdfs:comment \"The EDIFACT D96A directory of segments and elements.\"@en ;\n  rdfs:subClassOf :Standard .\n\n:EN16931_1 a owl:Class ;\n  rdfs:label \"EN 16931-1\"@en ;\n  rdfs:comment \"The European Standard EN 16931-1 for electronic invoicing.\"@en ;\n  rdfs:subClassOf :Standard .\n\n:P2POntology a owl:Class ;\n  rdfs:label \"Purchase-to-Pay Ontology (P2P-O)\"@en ;\n  rdfs:comment \"The Purchase-to-Pay Ontology, defining core procurement concepts.\"@en ;\n  rdfs:subClassOf :Standard .\n\n:RoleAssignment a owl:Class ;\n  rdfs:label \"Role Assignment\"@en ;\n  rdfs:comment \"A reified n-ary relation linking an organization, its role, and the invoice context.\"@en .\n\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\"@en ;\n  rdfs:comment \"A reified class representing an item, its price, and quantity in a detail section.\"@en .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n:hasMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has message\"@en ;\n  rdfs:comment \"Relates an EDIFACT interchange to its contained messages.\"@en ;\n  rdfs:domain :EdifactInterchange ;\n  rdfs:range :EdifactMessage .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\"@en ;\n  rdfs:comment \"Associates a message with its segments.\"@en ;\n  rdfs:domain :EdifactMessage ;\n  rdfs:range :Segment .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"has section\"@en ;\n  rdfs:comment \"Associates an invoice message with its sections (header, detail, summary).\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range owl:Thing .\n\n:hasHeaderSection a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has header section\"@en ;\n  rdfs:comment \"Associates an invoice with its header section.\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection .\n\n:hasDetailSection a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has detail section\"@en ;\n  rdfs:comment \"Associates an invoice with its detail section.\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :DetailSection .\n\n:hasSummarySection a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has summary section\"@en ;\n  rdfs:comment \"Associates an invoice with its summary section.\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SummarySection .\n\n:hasCompositeElement a owl:ObjectProperty ;\n  rdfs:label \"has composite element\"@en ;\n  rdfs:comment \"Associates a segment with its composite data elements.\"@en ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n  rdfs:label \"has simple element\"@en ;\n  rdfs:comment \"Associates a composite data element with its simple data elements.\"@en ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement .\n\n:hasDelimiter a owl:ObjectProperty ;\n  rdfs:label \"has delimiter\"@en ;\n  rdfs:comment \"Associates an interchange with its delimiters.\"@en ;\n  rdfs:domain :EdifactInterchange ;\n  rdfs:range :Delimiter .\n\n:playsRole a owl:ObjectProperty ;\n  rdfs:label \"plays role\"@en ;\n  rdfs:comment \"Associates an organization with a role assignment in an invoice.\"@en ;\n  rdfs:domain :Organization ;\n  rdfs:range :RoleAssignment .\n\n:involvesOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"involves organization\"@en ;\n  rdfs:comment \"Indicates which organization is involved in a role assignment.\"@en ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization .\n\n:hasRoleType a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has role type\"@en ;\n  rdfs:comment \"Specifies the role type in a role assignment (e.g., Buyer, Delivery Party).\"@en ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"has address\"@en ;\n  rdfs:comment \"Associates an organization with its address.\"@en ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has identifier\"@en ;\n  rdfs:comment \"Associates an organization with an identifier.\"@en ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier .\n\n:hasGlobalLocationNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has GLN\"@en ;\n  rdfs:comment \"Associates an organization with its GLN (Global Location Number).\"@en ;\n  rdfs:domain :Organization ;\n  rdfs:range :GlobalLocationNumber .\n\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"has line item\"@en ;\n  rdfs:comment \"Associates a detail section with its line items.\"@en ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n\n:describesItem a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"describes item\"@en ;\n  rdfs:comment \"Specifies the item described by a line item.\"@en ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n\n:hasNetPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has net price\"@en ;\n  rdfs:comment \"Associates a line item with its net price.\"@en ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price .\n\n:hasQuantity a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has quantity\"@en ;\n  rdfs:comment \"Associates a line item with its quantity.\"@en ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Quantity .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\"@en ;\n  rdfs:comment \"Associates a summary section with its tax objects.\"@en ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax .\n\n:hasTotalAmount a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has total amount\"@en ;\n  rdfs:comment \"Associates a summary section with the total invoice amount.\"@en ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Price .\n\n:hasReferenceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"has reference number\"@en ;\n  rdfs:comment \"Associates a header section with its reference number.\"@en ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range :ReferenceNumber .\n\n:hasValidationConstraint a owl:ObjectProperty ;\n  rdfs:label \"has validation constraint\"@en ;\n  rdfs:comment \"Associates an invoice with a validation constraint (e.g., SHACL).\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :ValidationConstraint .\n\n:alignedWithStandard a owl:ObjectProperty ;\n  rdfs:label \"aligned with standard\"@en ;\n  rdfs:comment \"Indicates alignment of an invoice with a particular standard.\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Standard .\n\n:assignedToProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n  rdfs:label \"assigned to process\"@en ;\n  rdfs:comment \"Assigns an invoice to a business process.\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n:hasDocumentDate a owl:DatatypeProperty ;\n  rdfs:label \"has document date\"@en ;\n  rdfs:comment \"The document date in the header section (as string for OWL 2 DL compliance).\"@en ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:label \"has invoice number\"@en ;\n  rdfs:comment \"The invoice number for the invoice message.\"@en ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string .\n\n:hasName a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:label \"has name\"@en ;\n  rdfs:comment \"The name of an organization.\"@en ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string .\n\n:hasStreet a owl:DatatypeProperty ;\n  rdfs:label \"has street\"@en ;\n  rdfs:comment \"The street address of an organization.\"@en ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasCity a owl:DatatypeProperty ;\n  rdfs:label \"has city\"@en ;\n  rdfs:comment \"The city of an address.\"@en ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasPostalCode a owl:DatatypeProperty ;\n  rdfs:label \"has postal code\"@en ;\n  rdfs:comment \"The postal code of an address.\"@en ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasCountry a owl:DatatypeProperty ;\n  rdfs:label \"has country\"@en ;\n  rdfs:comment \"The country of an address.\"@en ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasUnitPrice a owl:DatatypeProperty ;\n  rdfs:label \"has unit price\"@en ;\n  rdfs:comment \"The price per unit for an item.\"@en ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal .\n\n:hasCurrency a owl:DatatypeProperty ;\n  rdfs:label \"has currency\"@en ;\n  rdfs:comment \"The currency code for a price (e.g., EUR, USD).\"@en ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:string .\n\n:hasQuantityValue a owl:DatatypeProperty ;\n  rdfs:label \"has quantity value\"@en ;\n  rdfs:comment \"The numeric value of a quantity.\"@en ;\n  rdfs:domain :Quantity ;\n  rdfs:range xsd:decimal .\n\n:hasTaxAmount a owl:DatatypeProperty ;\n  rdfs:label \"has tax amount\"@en ;\n  rdfs:comment \"The tax amount.\"@en ;\n  rdfs:domain :Tax ;\n  rdfs:range xsd:decimal .\n\n:hasTaxType a owl:DatatypeProperty ;\n  rdfs:label \"has tax type\"@en ;\n  rdfs:comment \"The type of tax (e.g., VAT).\"@en ;\n  rdfs:domain :Tax ;\n  rdfs:range xsd:string .\n\n######################################################