2026-02-14 21:44:27 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#edifact-invoice> a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for modeling UN/EDIFACT invoice messages, segments, items, organizations, roles, and validation constraints, supporting EN 16931-1 and P2P-O alignment.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level UN/EDIFACT envelope containing messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A message within an interchange envelope, e.g., INVOIC.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message representing an invoice.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"EDIFACT Segment\" ;\n    rdfs:comment \"A segment in an EDIFACT message, e.g., BGM or NAD.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"The Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NAD_Segment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"The Name and Address segment for organization and address details.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element in a segment, containing multiple simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element in a segment or composite element.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A party involved in the invoice process (buyer, seller, delivery party, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A functional or business role played by an organization in a transaction (e.g., buyer, seller).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address for an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier such as a Global Location Number (GLN) or D96A code.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or good referenced in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A monetary price for an item or invoice.\" .\n\n:Quantity a owl:Class ;\n    rdfs:label \"Quantity\" ;\n    rdfs:comment \"A measured amount of an item (e.g., number of units).\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line in the invoice's detail section, referencing item, price, and quantity.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header of an invoice message, containing reference numbers, dates, etc.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The detail section of an invoice, containing line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The summary section of an invoice, containing totals and taxes.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A process to which the invoice can be assigned (e.g., procurement, order-to-cash).\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint or rule (e.g., SHACL shape) for validating invoice data.\" .\n\n:EDIFACTDelimiter a owl:Class ;\n    rdfs:label \"EDIFACT Delimiter\" ;\n    rdfs:comment \"A character or symbol used to separate data elements or segments in EDIFACT.\" .\n\n# Pivot Classes for Reification\n:InvoiceParticipation a owl:Class ;\n    rdfs:label \"Invoice Participation\" ;\n    rdfs:comment \"A reified relation linking an Organization, its Role, and a specific Invoice.\" .\n\n:LineItemDetail a owl:Class ;\n    rdfs:label \"Line Item Detail\" ;\n    rdfs:comment \"A reified relation linking a LineItem, Item, Price, and Quantity.\" .\n\n:SegmentElementAssignment a owl:Class ;\n    rdfs:label \"Segment Element Assignment\" ;\n    rdfs:comment \"A reified relation linking a Segment to its Composite or Simple Data Elements.\" .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message(s).\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:containsSection a owl:ObjectProperty ;\n    rdfs:label \"contains section\" ;\n    rdfs:comment \"Links an InvoiceMessage to one of its sections (header, detail, summary).\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range owl:Thing .\n\n:hasDataElement a owl:ObjectProperty ;\n    rdfs:label \"has data element\" ;\n    rdfs:comment \"Links a Segment to its CompositeDataElements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a CompositeDataElement to its SimpleDataElements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links an Organization to the AgentRole(s) it plays.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :AgentRole .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to its Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:identifiedBy a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;\n    rdfs:label \"identified by\" ;\n    rdfs:comment \"Links an Organization to its Identifier(s).\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n\n:participatesIn a owl:ObjectProperty ;\n    rdfs:label \"participates in\" ;\n    rdfs:comment \"Links an Organization to an InvoiceParticipation instance.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceParticipation .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links an InvoiceMessage to its LineItems.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :LineItem .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a LineItem to its LineItemDetail (reified details).\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :LineItemDetail .\n\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a LineItemDetail to an Item.\" ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :Item .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a LineItemDetail to its Price.\" ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :Price .\n\n:hasQuantity a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Links a LineItemDetail to its Quantity.\" ;\n    rdfs:domain :LineItemDetail ;\n    rdfs:range :Quantity .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an InvoiceMessage to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n:usesDelimiter a owl:ObjectProperty ;\n    rdfs:label \"uses delimiter\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to the EDIFACTDelimiter(s) it uses.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :EDIFACTDelimiter .\n\n:appliesConstraint a owl:ObjectProperty ;\n    rdfs:label \"applies constraint\" ;\n    rdfs:comment \"Links a ValidationConstraint to the InvoiceMessage(s) it validates.\" ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n:elementValue a owl:DatatypeProperty ;\n    rdfs:label \"element value\" ;\n    rdfs:comment \"The value of a SimpleDataElement.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range xsd:string .\n\n:segmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"segment code\" ;\n    rdfs:comment \"The EDIFACT code for a segment (e.g., 'BGM', 'NAD').\" ;\n    rdfs:domain :Segment ;\n    rdfs:range xsd:string .\n\n:roleCode a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"role code\" ;\n    rdfs:comment \"The code for an AgentRole (e.g., 'BY' for buyer).\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city in an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"The postal code in an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"The country code in an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:identifierValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The value of an identifier for an organization.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"A textual description of an item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:netPrice a owl:DatatypeProperty ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"The net price of an item or invoice.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:quantityValue a owl:DatatypeProperty ;\n    rdfs:label \"quantity value\" ;\n    rdfs:comment \"The quantity of an item.\" ;\n    rdfs:domain :Quantity ;\n    rdfs:range xsd:decimal .\n\n:invoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"The total amount of an invoice.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:decimal .\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The unique number identifying an invoice.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n:sectionType a owl:DatatypeProperty ;\n    rdfs:label \"section type\" ;\n    rdfs:comment \"The type of section: header, detail, or summary.\" ;\n    rdfs:domain owl:Thing ;\n    rdfs:range xsd:string .\n\n:delimiterSymbol a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"delimiter symbol\" ;\n    rdfs:comment \"The character or symbol of an EDIFACT delimiter (e.g., '+', ':').\" ;\n    rdfs:domain :EDIFACTDelimiter ;\n    rdfs:range xsd:string .\n\n#################################################################\n# CLASS AXIOMS & RESTRICTIONS (EXAMPLES)\n#################################################################\n# Organization must have at least one Identifier\n:Organization rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :identifiedBy ; owl:someValuesFrom :Identifier ] .\n\n# InvoiceMessage must have at least one LineItem\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasLineItem ; owl:someValuesFrom :LineItem ] .\n\n# LineItemDetail must have exactly one Item, Price, and Quantity\n:LineItemDetail rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItem ; owl:cardinality \"1\"^^xsd:nonNegativeInteger ] ,\n    [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:cardinality \"1\"^^xsd:nonNegativeInteger ] ,\n    [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:cardinality \"1\"^^xsd:nonNegativeInteger ] .\n\n# Segment must have at least one DataElement\n:Segment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasDataElement ; owl:someValuesFrom :CompositeDataElement ] .\n\n# InvoiceParticipation must connect an Organization, AgentRole, and InvoiceMessage\n:InvoiceParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ] ,\n    [ a owl:Restriction ; owl:onProperty :participatesIn ; owl:someValuesFrom :InvoiceMessage ] .\n\n#################################################################\n# DISJOINTNESS AXIOMS\n#################################################################\n:Organization owl:disjointWith :Item .\n:Segment owl:disjointWith :LineItem .\n:HeaderSection owl:disjointWith :DetailSection , :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n"
}
