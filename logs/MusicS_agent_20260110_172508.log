        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/music-production> a owl:Ontology ;\\n    rdfs:label \\\"Music Production Ontology\\\" ;\\n    rdfs:comment \\\"An ontology for modeling music production, bands, albums, performances, and related entities as described in the Red Hot Chili Peppers story.\\\" .\\n\\n### CLASSES ###\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual, such as a musician, critic, or composer.\\\" .\\n\\n:Band a owl:Class ;\\n    rdfs:label \\\"Band\\\" ;\\n    rdfs:comment \\\"A group of musicians performing together.\\\" .\\n\\n:Instrument a owl:Class ;\\n    rdfs:label \\\"Instrument\\\" ;\\n    rdfs:comment \\\"A musical instrument played by a person.\\\" .\\n\\n:Role a owl:Class ;\\n    rdfs:label \\\"Role\\\" ;\\n    rdfs:comment \\\"A function or part played by a person in a band (e.g., vocalist, drummer).\\\" .\\n\\n:Album a owl:Class ;\\n    rdfs:label \\\"Album\\\" ;\\n    rdfs:comment \\\"A musical album released by a band.\\\" .\\n\\n:Track a owl:Class ;\\n    rdfs:label \\\"Track\\\" ;\\n    rdfs:comment \\\"A track on an album; a specific recording of a song.\\\" ;\\n    rdfs:subClassOf :Song .\\n\\n:Song a owl:Class ;\\n    rdfs:label \\\"Song\\\" ;\\n    rdfs:comment \\\"A musical composition, which may be recorded as a track.\\\" .\\n\\n:Critic a owl:Class ;\\n    rdfs:label \\\"Critic\\\" ;\\n    rdfs:comment \\\"A person who critiques albums.\\\" ;\\n    owl:disjointWith :Person .\\n\\n:Performance a owl:Class ;\\n    rdfs:label \\\"Performance\\\" ;\\n    rdfs:comment \\\"A live musical performance by a band.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where performances may take place.\\\" .\\n\\n:Region a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A region containing cities.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n### PIVOT/REIFICATION CLASSES ###\\n:Membership a owl:Class ;\\n    rdfs:label \\\"Membership\\\" ;\\n    rdfs:comment \\\"A reification class representing a person's membership in a band with role and time period.\\\" .\\n\\n:RecordingSession a owl:Class ;\\n    rdfs:label \\\"Recording Session\\\" ;\\n    rdfs:comment \\\"A reification class representing a band recording an album over a time period.\\\" .\\n\\n:Critique a owl:Class ;\\n    rdfs:label \\\"Critique\\\" ;\\n    rdfs:comment \\\"A reification class representing a critic's commentary on an album.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"A reification class representing a song performed during a performance.\\\" .\\n\\n### OBJECT PROPERTIES (with inverses) ###\\n:playsInstrument a owl:ObjectProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Links a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :playedBy .\\n\\n:playedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"played by\\\" ;\\n    rdfs:comment \\\"Links an instrument to the person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Links a band to a membership instance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Membership ;\\n    owl:inverseOf :memberOfBand .\\n\\n:memberOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"member of band\\\" ;\\n    rdfs:comment \\\"Links a membership to the band.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMember .\\n\\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"member person\\\" ;\\n    rdfs:comment \\\"Links a membership to the person who is a member.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :hasMembership .\\n\\n:hasMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"has membership\\\" ;\\n    rdfs:comment \\\"Links a person to their membership(s) in bands.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Membership ;\\n    owl:inverseOf :memberPerson .\\n\\n:memberRole a owl:ObjectProperty ;\\n    rdfs:label \\\"member role\\\" ;\\n    rdfs:comment \\\"Links a membership to the role held.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleOfMembership .\\n\\n:roleOfMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role of membership\\\" ;\\n    rdfs:comment \\\"Links a role to the membership(s) in which it is held.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :Membership ;\\n    owl:inverseOf :memberRole .\\n\\n:records a owl:ObjectProperty ;\\n    rdfs:label \\\"records\\\" ;\\n    rdfs:comment \\\"Links a band to a recording session.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :RecordingSession ;\\n    owl:inverseOf :recordedBy .\\n\\n:recordedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded by\\\" ;\\n    rdfs:comment \\\"Links a recording session to the band that performed it.\\\" ;\\n    rdfs:domain :RecordingSession ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :records .\\n\\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recorded album\\\" ;\\n    rdfs:comment \\\"Links a recording session to the album recorded.\\\" ;\\n    rdfs:domain :RecordingSession ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumRecordedIn .\\n\\n:albumRecordedIn a owl:ObjectProperty ;\\n    rdfs:label \\\"album recorded in\\\" ;\\n    rdfs:comment \\\"Links an album to the recording session.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :RecordingSession ;\\n    owl:inverseOf :recordedAlbum .\\n\\n:containsTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"contains track\\\" ;\\n    rdfs:comment \\\"Links an album to its tracks.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOfAlbum .\\n\\n:trackOfAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"track of album\\\" ;\\n    rdfs:comment \\\"Links a track to the album it is part of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :containsTrack .\\n\\n:isRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"is recording of\\\" ;\\n    rdfs:comment \\\"Links a track to the song it is a recording of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :hasRecording .\\n\\n:hasRecording a owl:ObjectProperty ;\\n    rdfs:label \\\"has recording\\\" ;\\n    rdfs:comment \\\"Links a song to its track recordings.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :isRecordingOf .\\n\\n:critiquedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"critiqued by\\\" ;\\n    rdfs:comment \\\"Links an album to a critique.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critique ;\\n    owl:inverseOf :critiques .\\n\\n:critiques a owl:ObjectProperty ;\\n    rdfs:label \\\"critiques\\\" ;\\n    rdfs:comment \\\"Links a critique to the album it critiques.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :critiquedBy .\\n\\n:critic a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"critic\\\" ;\\n    rdfs:comment \\\"Links a critique to the critic who made it.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :hasCritique .\\n\\n:hasCritique a owl:ObjectProperty ;\\n    rdfs:label \\\"has critique\\\" ;\\n    rdfs:comment \\\"Links a critic to the critiques they have made.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Critique ;\\n    owl:inverseOf :critic .\\n\\n:hasPerformanceSong a owl:ObjectProperty ;\\n    rdfs:label \\\"has performance song\\\" ;\\n    rdfs:comment \\\"Links a performance to a performance song instance.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceOf .\\n\\n:performanceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"performance of\\\" ;\\n    rdfs:comment \\\"Links a performance song to the performance in which it occurred.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :hasPerformanceSong .\\n\\n:performanceSong a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance song\\\" ;\\n    rdfs:comment \\\"Links a performance song to the song performed.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :performedAtPerformanceSong .\\n\\n:performedAtPerformanceSong a owl:ObjectProperty ;\\n    rdfs:label \\\"performed at performance song\\\" ;\\n    rdfs:comment \\\"Links a song to the performance song instance.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceSong .\\n\\n:performedIn a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performed in\\\" ;\\n    rdfs:comment \\\"Links a performance to the city where it occurred.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityOfPerformance .\\n\\n:cityOfPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"city of performance\\\" ;\\n    rdfs:comment \\\"Links a city to performances that occurred there.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performedIn .\\n\\n:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"in region\\\" ;\\n    rdfs:comment \\\"Links a city to the region it is in.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionHasCity .\\n\\n:regionHasCity a owl:ObjectProperty ;\\n    rdfs:label \\\"region has city\\\" ;\\n    rdfs:comment \\\"Links a region to the cities it contains.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :City ;\\n    owl:inverseOf :inRegion .\\n\\n:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"in country\\\" ;\\n    rdfs:comment \\\"Links a region to the country it is in.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country ;\\n    owl:inverseOf :countryHasRegion .\\n\\n:countryHasRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"country has region\\\" ;\\n    rdfs:comment \\\"Links a country to the regions it contains.\\\" ;\\n    rdfs:domain :Country ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :inCountry .\\n\\n### DATA PROPERTIES ###\\n:membershipStart a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"membership start\\\" ;\\n    rdfs:comment \\\"The start date of a person's membership in a band.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range xsd:dateTime .\\n\\n:membershipEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"membership end\\\" ;\\n    rdfs:comment \\\"The end date of a person's membership in a band.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recording start\\\" ;\\n    rdfs:comment \\\"The start date of a recording session.\\\" ;\\n    rdfs:domain :RecordingSession ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recording end\\\" ;\\n    rdfs:comment \\\"The end date of a recording session.\\\" ;\\n    rdfs:domain :RecordingSession ;\\n    rdfs:range xsd:dateTime .\\n\\n:trackNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"track number\\\" ;\\n    rdfs:comment \\\"The number of a track in an album.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range xsd:integer .\\n\\n:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"composed on\\\" ;\\n    rdfs:comment \\\"The date a song was composed.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range xsd:dateTime .\\n\\n:releasedOn a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"released on\\\" ;\\n    rdfs:comment \\\"The release date of an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:dateTime .\\n\\n:critiqueText a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"critique text\\\" ;\\n    rdfs:comment \\\"The text content of a critique.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range xsd:string .\\n\\n:performedAt a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performed at\\\" ;\\n    rdfs:comment \\\"The date and time a performance took place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:dateTime .\\n\\n### AXIOMS & RESTRICTIONS ###\\n# Album must contain at least one track (CQ15)\\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] .\\n\\n# Disjointness axioms\\n:Person owl:disjointWith :Band , :Critic .\\n:Instrument owl:disjointWith :Role .\\n:Album owl:disjointWith :Song .\\n:Performance owl:disjointWith :RecordingSession .\\n:City owl:disjointWith :Region .\\n:Region owl:disjointWith :Country .\\n\"}",
        "name": "check_pitfalls_tool"
      },
      "type": "function"
    }
