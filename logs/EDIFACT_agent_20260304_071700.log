      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/UNEDIFACT-Invoice-Ontology>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing digital business documents according to UN/EDIFACT and EN16931-1 standards, supporting procurement and global trade scenarios.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Top-level envelope for EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A message within an interchange envelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An invoice message (e.g., INVOIC) within an EDIFACT interchange.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within a message, e.g., BGM or NAD.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice message.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"Composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"Simple data element within a composite data element.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in a transaction.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in an invoice, e.g., buyer or delivery party.\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class representing an organization in a specific agent role, possibly with a specific address.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address associated with an organization role assignment.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service sold in the invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the invoice, referring to an item and its price.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with a line item.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier such as a GLN or reference number.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n:hasMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has message\" ;\n    rdfs:comment \"Links an interchange envelope to its message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite data element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Links a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to an organization role assignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:hasOrganization a owl:ObjectProperty ;\n    rdfs:label \"has organization\" ;\n    rdfs:comment \"Links a role assignment to an organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a role assignment to an agent role.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links a role assignment to an address.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Address .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links an invoice detail to its line items.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a line item to its price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links an invoice to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number of the invoice.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:hasDocumentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The date of the invoice document.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:dateTime .\n\n:hasReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"The reference number in the invoice.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:hasOrganizationName a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has organization name\" ;\n    rdfs:comment \"The name of the organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"An identifier for the organization, such as a GLN.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string .\n\n:hasStreet a owl:DatatypeProperty ;\n    rdfs:label \"has street\" ;\n    rdfs:comment \"The street of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:hasCity a owl:DatatypeProperty ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"The city of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:hasPostalCode a owl:DatatypeProperty ;\n    rdfs:label \"has postal code\" ;\n    rdfs:comment \"The postal code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:hasCountry a owl:DatatypeProperty ;\n    rdfs:label \"has country\" ;\n    rdfs:comment \"The country of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:hasItemName a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has item name\" ;\n    rdfs:comment \"The name of the item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n:hasQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of the item in the line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of the item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:hasTotalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has total amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:hasTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"The total tax amount of the invoice.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n#################################################################\n# Disjointness and Unions\n#################################################################\n:Organization owl:disjointWith :AgentRole, :Item, :Address .\n:Item owl:disjointWith :Price .\n:Segment owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\n\n#################################################################\n# Example Restrictions (GCAs & Equivalencies)\n#################################################################\n:Buyer a owl:Class ;\n    rdfs:label \"Buyer\" ;\n    rdfs:comment \"Agent role of buyer in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryParty a owl:Class ;\n    rdfs:label \"Delivery Party\" ;\n    rdfs:comment \"Agent role of delivery party in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n# GCA: Every OrganizationRoleAssignment with hasRole some Buyer is a BuyerAssignment\n:BuyerAssignment a owl:Class ;\n    rdfs:label \"Buyer Assignment\" ;\n    rdfs:comment \"An organization role assignment where the role is Buyer.\" ;\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Buyer ] .\n"
}
