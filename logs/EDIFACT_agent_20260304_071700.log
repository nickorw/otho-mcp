tity\\\" ;\\n    rdfs:comment \\\"The quantity of the item in the line item.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:hasNetPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"The net price of the item.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal .\\n\\n:hasTotalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has total amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:hasTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has tax amount\\\" ;\\n    rdfs:comment \\\"The total tax amount of the invoice.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n#################################################################\\n# Disjointness and Unions\\n#################################################################\\n:Organization owl:disjointWith :AgentRole, :Item, :Address .\\n:Item owl:disjointWith :Price .\\n:Segment owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\\n\\n#################################################################\\n# Example Restrictions (GCAs & Equivalencies)\\n#################################################################\\n:Buyer a owl:Class ;\\n    rdfs:label \\\"Buyer\\\" ;\\n    rdfs:comment \\\"Agent role of buyer in the invoice.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:DeliveryParty a owl:Class ;\\n    rdfs:label \\\"Delivery Party\\\" ;\\n    rdfs:comment \\\"Agent role of delivery party in the invoice.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n# GCA: Every OrganizationRoleAssignment with hasRole some Buyer is a BuyerAssignment\\n:BuyerAssignment a owl:Class ;\\n    rdfs:label \\\"Buyer Assignment\\\" ;\\n    rdfs:comment \\\"An organization role assignment where the role is Buyer.\\\" ;\\n    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :Buyer ] .\\n\",\"label\":\"final_validated\"}",
