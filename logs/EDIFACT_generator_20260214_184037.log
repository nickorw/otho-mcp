2026-02-14 18:41:59 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/EDIFACTScenario> a owl:Ontology ;\n    rdfs:label \"EDIFACT Scenario Ontology\" ;\n    rdfs:comment \"An ontology modeling EDIFACT messages, invoices, organizations, and related business concepts.\" .\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A message formatted according to the EDIFACT standard, which may list one or more invoices.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"A commercial document issued by a seller to a buyer, relating to a sale transaction and indicating the products, quantities, and agreed prices.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A company or entity involved in the invoice, such as buyer or seller.\" .\n\n:OrganizationRole a owl:Class ;\n    rdfs:label \"Organization Role\" ;\n    rdfs:comment \"A role that an organization can play in an invoice, such as buyer or seller.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"The address associated with an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in an invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Details associated with an invoice, such as payment terms or delivery information.\" .\n\n:ItemDetail a owl:Class ;\n    rdfs:label \"Item Detail\" ;\n    rdfs:comment \"Additional information about an item, such as description or specification.\" .\n\n:InvoiceOrganizationRole a owl:Class ;\n    rdfs:label \"Invoice Organization Role\" ;\n    rdfs:comment \"A pivot class representing the role of an organization in a specific invoice, enabling reification of the relationship between invoices, organizations, and their roles.\" .\n\n# Object Properties\n:listsInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"lists invoice\" ;\n    rdfs:comment \"Relates an EDIFACT message to the invoices it lists.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Invoice .\n\n:involvesOrganizationRole a owl:ObjectProperty ;\n    rdfs:label \"involves organization role\" ;\n    rdfs:comment \"Relates an invoice to a role played by an organization in that invoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceOrganizationRole .\n\n:hasOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has organization\" ;\n    rdfs:comment \"Relates an InvoiceOrganizationRole to the involved organization.\" ;\n    rdfs:domain :InvoiceOrganizationRole ;\n    rdfs:range :Organization .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Relates an InvoiceOrganizationRole to the role played by the organization.\" ;\n    rdfs:domain :InvoiceOrganizationRole ;\n    rdfs:range :OrganizationRole .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasBuyer a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has buyer\" ;\n    rdfs:comment \"Relates an invoice to its buyer organization.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Organization .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates an invoice to the items it includes.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Item .\n\n:hasItemDetail a owl:ObjectProperty ;\n    rdfs:label \"has item detail\" ;\n    rdfs:comment \"Relates an item to its detailed information.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :ItemDetail .\n\n:hasInvoiceDetail a owl:ObjectProperty ;\n    rdfs:label \"has invoice detail\" ;\n    rdfs:comment \"Relates an invoice to its detailed information.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail .\n\n:isInBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"is in business process\" ;\n    rdfs:comment \"Relates an invoice to the business process it is assigned to.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess .\n\n# Data Properties\n:hasInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The unique identifier for an invoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string .\n\n:hasInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:decimal .\n\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of an item in the invoice.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:decimal .\n\n# Disjointness axioms\n:EDIFACTMessage owl:disjointWith :Organization, :Invoice, :BusinessProcess .\n:Invoice owl:disjointWith :Organization, :Item, :BusinessProcess .\n:Organization owl:disjointWith :Item, :BusinessProcess .\n:Item owl:disjointWith :BusinessProcess .\n:InvoiceDetail owl:disjointWith :ItemDetail .\n:OrganizationRole owl:disjointWith :Item .\n\n# Example restrictions and equivalence axioms\n:Invoice owl:equivalentClass [\n    a owl:Class ;\n    owl:Restriction [ owl:onProperty :hasInvoiceNumber ; owl:allValuesFrom xsd:string ] ;\n    owl:Restriction [ owl:onProperty :hasInvoiceAmount ; owl:allValuesFrom xsd:decimal ]\n] .\n\n:Item owl:equivalentClass [\n    a owl:Class ;\n    owl:Restriction [ owl:onProperty :hasNetPrice ; owl:allValuesFrom xsd:decimal ]\n] ."
}
