2026-02-14 22:28:22 | DEBUG    |     Args: {
      "key": "current_owl_draft",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-invoice-ontology>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT digital business documents, invoice messages, organizational roles, and technical validation structures.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The root envelope of an EDIFACT interchange, containing one or more messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A generic message within an EDIFACT interchange.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT message of type INVOIC representing a business invoice.\" .\n\n:EDIFACTSegment a owl:Class ;\n    rdfs:label \"EDIFACT Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message, such as BGM or NAD.\" .\n\n:BGM a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment, identifies the document type and number.\" .\n\n:NAD a owl:Class ;\n    rdfs:subClassOf :EDIFACTSegment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment, provides party identification details.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment, grouping several simple elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite or segment.\" .\n\n:Delimiter a owl:Class ;\n    rdfs:label \"Delimiter\" ;\n    rdfs:comment \"A character used to separate segments, composites, and elements in EDIFACT syntax.\" .\n\n:MessageSection a owl:Class ;\n    rdfs:label \"Message Section\" ;\n    rdfs:comment \"A logical section of a message (header, detail, summary).\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:subClassOf :MessageSection ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"The header section of an invoice message, containing meta-information such as dates and references.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:subClassOf :MessageSection ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"The detail section of an invoice message, listing line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:subClassOf :MessageSection ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"The summary section of an invoice message, providing totals and tax information.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A legal entity involved in a transaction, such as buyer or delivery party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Delivery Party).\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"The role of buyer in a transaction.\" .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:subClassOf :AgentRole ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"The role of delivery party in a transaction.\" .\n\n:OrganizationRoleParticipation a owl:Class ;\n    rdfs:label \"Organization Role Participation\" ;\n    rdfs:comment \"Reification class for linking an organization, its role, and associated data in a transaction.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A physical or legal address for an organization.\" .\n\n:HeadquartersAddress a owl:Class ;\n    rdfs:subClassOf :Address ;\n    rdfs:label \"Headquarters Address\" ;\n    rdfs:comment \"The headquarters address of an organization.\" .\n\n:WarehouseAddress a owl:Class ;\n    rdfs:subClassOf :Address ;\n    rdfs:label \"Warehouse Address\" ;\n    rdfs:comment \"A warehouse address of an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A unique identifier for an organization or document, such as a GLN or invoice number.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:subClassOf :Identifier ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A global location number (GLN) used for identifying organizations and locations.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in an invoice.\" .\n\n:ItemLine a owl:Class ;\n    rdfs:label \"Item Line\" ;\n    rdfs:comment \"Reification class linking an item, its quantity, and price as a line in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value, such as net price or invoice total.\" .\n\n:Quantity a owl:Class ;\n    rdfs:label \"Quantity\" ;\n    rdfs:comment \"A quantity of items in an invoice line.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Reification class for invoice-level details such as number, date, and total amount.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process, such as procurement, to which an invoice can be assigned.\" .\n\n:Standard a owl:Class ;\n    rdfs:label \"Standard\" ;\n    rdfs:comment \"A standard (e.g., EN 16931-1) to which a document conforms.\" .\n\n:ValidationConstraint a owl:Class ;\n    rdfs:label \"Validation Constraint\" ;\n    rdfs:comment \"A constraint, such as a SHACL shape, used for automated validation.\" .\n\n:KnowledgeGraph a owl:Class ;\n    rdfs:label \"Knowledge Graph\" ;\n    rdfs:comment \"A knowledge graph representing the extracted and validated business information.\" .\n\n#################################################################\n# Object Properties (with inverses and revised annotations)\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to its contained message(s).\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Relates a message to the envelope that contains it.\" ;\n    owl:inverseOf :containsMessage .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :MessageSection ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links a message to its logical sections (header, detail, summary).\" ;\n    owl:inverseOf :isSectionOf .\n\n:isSectionOf a owl:ObjectProperty ;\n    rdfs:domain :MessageSection ;\n    rdfs:range :Message ;\n    rdfs:label \"is section of\" ;\n    rdfs:comment \"Relates a message section to the message it is part of.\" ;\n    owl:inverseOf :hasSection .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :MessageSection ;\n    rdfs:range :EDIFACTSegment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message section to its EDIFACT segments.\" ;\n    owl:inverseOf :isSegmentOfSection .\n\n:isSegmentOfSection a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :MessageSection ;\n    rdfs:label \"is segment of section\" ;\n    rdfs:comment \"Relates a segment to the message section it belongs to.\" ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :EDIFACTSegment ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Relates a composite data element to the segment it is part of.\" ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple elements.\" ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Relates a simple data element to its parent composite data element.\" ;\n    owl:inverseOf :hasSimpleElement .\n\n:usesDelimiter a owl:ObjectProperty ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range :Delimiter ;\n    rdfs:label \"uses delimiter\" ;\n    rdfs:comment \"Indicates the delimiter used in a segment.\" ;\n    owl:inverseOf :isDelimiterForSegment .\n\n:isDelimiterForSegment a owl:ObjectProperty ;\n    rdfs:domain :Delimiter ;\n    rdfs:range :EDIFACTSegment ;\n    rdfs:label \"is delimiter for segment\" ;\n    rdfs:comment \"Relates a delimiter to the segment it separates.\" ;\n    owl:inverseOf :usesDelimiter .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an invoice message to organizations involved in the transaction.\" ;\n    owl:inverseOf :isOrganizationInvolvedIn .\n\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is organization involved in\" ;\n    rdfs:comment \"Relates an organization to the invoice message it is involved in.\" ;\n    owl:inverseOf :involvesOrganization .\n\n:hasRoleParticipation a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleParticipation ;\n    rdfs:label \"has role participation\" ;\n    rdfs:comment \"Links an invoice message to a reified participation of an organization in a specific role.\" ;\n    owl:inverseOf :isParticipationOfInvoice .\n\n:isParticipationOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleParticipation ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is participation of invoice\" ;\n    rdfs:comment \"Relates a role participation to the invoice message it is part of.\" ;\n    owl:inverseOf :hasRoleParticipation .\n\n:playsRole a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleParticipation ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Indicates the role played by an organization in a participation context.\" ;\n    owl:inverseOf :isRolePlayedBy .\n\n:isRolePlayedBy a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleParticipation ;\n    rdfs:label \"is role played by\" ;\n    rdfs:comment \"Relates an agent role to the participation where it is played.\" ;\n    owl:inverseOf :playsRole .\n\n:hasParticipant a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n    rdfs:domain :OrganizationRoleParticipation ;\n    rdfs:range :Organization ;\n    rdfs:label \"has participant\" ;\n    rdfs:comment \"Indicates the organization participating in a role.\" ;\n    owl:inverseOf :isParticipantIn .\n\n:isParticipantIn a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleParticipation ;\n    rdfs:label \"is participant in\" ;\n    rdfs:comment \"Relates an organization to the role participation it is involved in.\" ;\n    owl:inverseOf :hasParticipant .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleParticipation ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links a role participation to an address (e.g., headquarters, warehouse).\" ;\n    owl:inverseOf :isAddressOfParticipation .\n\n:isAddressOfParticipation a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :OrganizationRoleParticipation ;\n    rdfs:label \"is address of participation\" ;\n    rdfs:comment \"Relates an address to the role participation it is linked to.\" ;\n    owl:inverseOf :hasAddress .\n\n:hasIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleParticipation ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links a role participation to an identifier such as GLN.\" ;\n    owl:inverseOf :isIdentifierOfParticipation .\n\n:isIdentifierOfParticipation a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :OrganizationRoleParticipation ;\n    rdfs:label \"is identifier of participation\" ;\n    rdfs:comment \"Relates an identifier to the role participation it is assigned to.\" ;\n    owl:inverseOf :hasIdentifier .\n\n:hasItemLine a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ItemLine ;\n    rdfs:label \"has item line\" ;\n    rdfs:comment \"Links an invoice message to an item line.\" ;\n    owl:inverseOf :isItemLineOfInvoice .\n\n:isItemLineOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is item line of invoice\" ;\n    rdfs:comment \"Relates an item line to the invoice message it is part of.\" ;\n    owl:inverseOf :hasItemLine .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links an item line to the item it describes.\" ;\n    owl:inverseOf :isItemDescribedByLine .\n\n:isItemDescribedByLine a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :ItemLine ;\n    rdfs:label \"is item described by line\" ;\n    rdfs:comment \"Relates an item to the item line that describes it.\" ;\n    owl:inverseOf :describesItem .\n\n:hasQuantity a owl:ObjectProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range :Quantity ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Links an item line to the quantity of the item.\" ;\n    owl:inverseOf :isQuantityOfLine .\n\n:isQuantityOfLine a owl:ObjectProperty ;\n    rdfs:domain :Quantity ;\n    rdfs:range :ItemLine ;\n    rdfs:label \"is quantity of line\" ;\n    rdfs:comment \"Relates a quantity to the item line it is part of.\" ;\n    owl:inverseOf :hasQuantity .\n\n:hasNetPrice a owl:ObjectProperty ;\n    rdfs:domain :ItemLine ;\n    rdfs:range :Price ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links an item line to the net price.\" ;\n    owl:inverseOf :isNetPriceOfLine .\n\n:isNetPriceOfLine a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :ItemLine ;\n    rdfs:label \"is net price of line\" ;\n    rdfs:comment \"Relates a price to the item line it is the net price for.\" ;\n    owl:inverseOf :hasNetPrice .\n\n:hasInvoiceDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"has invoice detail\" ;\n    rdfs:comment \"Links an invoice message to its invoice-level details.\" ;\n    owl:inverseOf :isInvoiceDetailOf .\n\n:isInvoiceDetailOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is invoice detail of\" ;\n    rdfs:comment \"Relates invoice details to the invoice message they belong to.\" ;\n    owl:inverseOf :hasInvoiceDetail .\n\n:hasInvoiceAmount a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :Price ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Links invoice details to the total invoice amount.\" ;\n    owl:inverseOf :isInvoiceAmountOf .\n\n:isInvoiceAmountOf a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"is invoice amount of\" ;\n    rdfs:comment \"Relates a price to the invoice detail it is the total for.\" ;\n    owl:inverseOf :hasInvoiceAmount .\n\n:hasInvoiceNumber a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Links invoice details to the invoice number.\" ;\n    owl:inverseOf :isInvoiceNumberOf .\n\n:isInvoiceNumberOf a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"is invoice number of\" ;\n    rdfs:comment \"Relates an identifier (e.g., invoice number) to the invoice detail it is assigned to.\" ;\n    owl:inverseOf :hasInvoiceNumber .\n\n:conformsToStandard a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Standard ;\n    rdfs:label \"conforms to standard\" ;\n    rdfs:comment \"Indicates the standard to which an invoice message conforms.\" ;\n    owl:inverseOf :isStandardForInvoice .\n\n:isStandardForInvoice a owl:ObjectProperty ;\n    rdfs:domain :Standard ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is standard for invoice\" ;\n    rdfs:comment \"Relates a standard to the invoice message it is applied to.\" ;\n    owl:inverseOf :conformsToStandard .\n\n:validatedBy a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :ValidationConstraint ;\n    rdfs:label \"validated by\" ;\n    rdfs:comment \"Indicates a validation constraint used to validate the invoice message.\" ;\n    owl:inverseOf :validatesInvoice .\n\n:validatesInvoice a owl:ObjectProperty ;\n    rdfs:domain :ValidationConstraint ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"validates invoice\" ;\n    rdfs:comment \"Relates a validation constraint to the invoice message it validates.\" ;\n    owl:inverseOf :validatedBy .\n\n:partOfProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"part of process\" ;\n    rdfs:comment \"Indicates the business process to which the invoice message belongs.\" ;\n    owl:inverseOf :hasInvoiceInProcess .\n\n:hasInvoiceInProcess a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"has invoice in process\" ;\n    rdfs:comment \"Relates a business process to the invoice messages it contains.\" ;\n    owl:inverseOf :partOfProcess .\n\n# Connect KnowledgeGraph to InvoiceMessage\n:representsKnowledgeGraph a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :KnowledgeGraph ;\n    rdfs:label \"represents knowledge graph\" ;\n    rdfs:comment \"Links an invoice message to the knowledge graph it generates.\" ;\n    owl:inverseOf :isKnowledgeGraphOf .\n\n:isKnowledgeGraphOf a owl:ObjectProperty ;\n    rdfs:domain :KnowledgeGraph ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is knowledge graph of\" ;\n    rdfs:comment \"Relates a knowledge graph to the invoice message it represents.\" ;\n    owl:inverseOf :representsKnowledgeGraph .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:elementValue a owl:DatatypeProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range xsd:string ;\n    rdfs:label \"element value\" ;\n    rdfs:comment \"The string value of a simple data element.\" .\n\n:segmentTag a owl:DatatypeProperty ;\n    rdfs:domain :EDIFACTSegment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"segment tag\" ;\n    rdfs:comment \"The tag (e.g., 'BGM', 'NAD') of an EDIFACT segment.\" .\n\n:compositeCode a owl:DatatypeProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range xsd:string ;\n    rdfs:label \"composite code\" ;\n    rdfs:comment \"The code identifying a composite data element.\" .\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"The string value of an identifier (e.g., GLN, invoice number).\" .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"A line of an address.\" .\n\n:priceValue a owl:DatatypeProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"price value\" ;\n    rdfs:comment \"The decimal value of a price.\" .\n\n:quantityValue a owl:DatatypeProperty ;\n    rdfs:domain :Quantity ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"quantity value\" ;\n    rdfs:comment \"The decimal value of a quantity.\" .\n\n:dateValue a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range xsd:string ;\n    rdfs:label \"date value\" ;\n    rdfs:comment \"A string representation of a date (custom format, e.g., 'YYYYMMDD').\" .\n\n:sectionType a owl:DatatypeProperty ;\n    rdfs:domain :MessageSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"section type\" ;\n    rdfs:comment \"The type of message section (header, detail, summary).\" .\n\n#################################################################\n# Disjointness and DisjointUnion\n#################################################################\n\n:Organization owl:disjointWith :Item, :Address .\n:EDIFACTSegment owl:disjointWith :CompositeDataElement .\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n\n:MessageSection owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\n:AgentRole owl:disjointUnionOf ( :BuyerRole :DeliveryPartyRole ) .\n\n#################################################################\n# Property Characteristics\n#################################################################\n\n:containsMessage a owl:FunctionalProperty .\n:hasParticipant a owl:InverseFunctionalProperty .\n:hasAddress a owl:FunctionalProperty .\n:hasIdentifier a owl:FunctionalProperty .\n:hasItemLine a owl:FunctionalProperty .\n:hasInvoiceDetail a owl:FunctionalProperty .\n:hasInvoiceAmount a owl:FunctionalProperty .\n:hasInvoiceNumber a owl:FunctionalProperty .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasRoleParticipation ; owl:someValuesFrom :OrganizationRoleParticipation ] .\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasItemLine ; owl:someValuesFrom :ItemLine ] .\n:InvoiceMessage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:someValuesFrom :InvoiceDetail ] .\n:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ] .\n:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasParticipant ; owl:someValuesFrom :Organization ] .\n:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:allValuesFrom :Address ] .\n:OrganizationRoleParticipation rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasIdentifier ; owl:allValuesFrom :Identifier ] .\n:ItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ] .\n:ItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:allValuesFrom :Quantity ] .\n:ItemLine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:allValuesFrom :Price ] .\n\n#################################################################\n# Annotations for EDIFACT-specific technical vocabulary\n#################################################################\n:BGM rdfs:label \"BGM Segment\" ; rdfs:comment \"Beginning of Message segment for document identification.\" .\n:NAD rdfs:label \"NAD Segment\" ; rdfs:comment \"Name and Address segment for participant details.\" .\n:GlobalLocationNumber rdfs:label \"Global Location Number (GLN)\" ; rdfs:comment \"GLN for identifying organizations and locations.\" .\n\n#################################################################\n# Alignment with Standards and Validation\n#################################################################\n:InvoiceMessage rdfs:seeAlso <https://www.en16931.eu/> , <https://w3id.org/p2p-o/> .\n:ValidationConstraint rdfs:comment \"SHACL constraints for validation, e.g., itemized prices summing to totals, mandatory identifiers present.\" .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
