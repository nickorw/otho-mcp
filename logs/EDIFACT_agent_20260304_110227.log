      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/UNEDIFACT-Story>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology modeling the structure of UN/EDIFACT invoice messages, roles, items, and compliance with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope that contains one or more EDIFACT messages.\" .\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A message as defined by the EDIFACT standard, e.g., INVOIC.\" ;\n    rdfs:subClassOf :InterchangeEnvelope .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT message of type INVOIC, representing an invoice.\" ;\n    rdfs:subClassOf :EDIFACTMessage .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message, e.g., BGM, NAD.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"Composite element within a segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"Atomic data element within a composite element.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice, e.g., buyer, seller, delivery party.\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"Pivot class for assigning a role to an organization in a specific context (reification).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in an invoice, e.g., Buyer, Seller, Delivery Party.\" ;\n    rdfs:subClassOf :RoleAssignment .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address associated with an organization.\" ;\n    rdfs:subClassOf :Organization .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier such as a Global Location Number assigned to an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A line item in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item.\" ;\n    rdfs:subClassOf :Item .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of the invoice, containing document dates and reference numbers.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section listing line items of the invoice.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section providing totals for the invoice.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n#################################################################\n# Object Properties (with Inverses)\n#################################################################\n\n:containsMessage a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an Interchange Envelope to an EDIFACT message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :EDIFACTMessage ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse: links an EDIFACT message to its containing envelope.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links an EDIFACT message to its segments.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse: links a segment to its parent EDIFACT message.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :EDIFACTMessage ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse: links a composite element to its parent segment.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite element to its simple elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse: links a simple data element to its parent composite element.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :hasSimpleElement .\n\n:playsRole a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n    rdfs:label \"plays role assignment\" ;\n    rdfs:comment \"Links an organization to a role assignment pivot class.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is role assignment of\" ;\n    rdfs:comment \"Inverse: links a role assignment to the organization.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :playsRole .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a role assignment to a specific agent role.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isRoleOfAssignment .\n\n:isRoleOfAssignment a owl:ObjectProperty ;\n    rdfs:label \"is role of assignment\" ;\n    rdfs:comment \"Inverse: links an agent role to the role assignment.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :hasRole .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to an address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse: links an address to the organization.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasIdentifier a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to an identifier such as a GLN.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse: links an identifier to the organization.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasIdentifier .\n\n:hasItem a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links invoice detail to an item.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :Item ;\n    owl:inverseOf :isItemOfDetail .\n\n:isItemOfDetail a owl:ObjectProperty ;\n    rdfs:label \"is item of detail\" ;\n    rdfs:comment \"Inverse: links an item to its invoice detail.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :hasItem .\n\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links an item to its price.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :Price ;\n    owl:inverseOf :isPriceOfItem .\n\n:isPriceOfItem a owl:ObjectProperty ;\n    rdfs:label \"is price of item\" ;\n    rdfs:comment \"Inverse: links a price to its item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :Item ;\n    owl:inverseOf :hasPrice .\n\n:assignedBusinessProcess a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"assigned business process\" ;\n    rdfs:comment \"Links an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Inverse: links a business process to an invoice message.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :assignedBusinessProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"The total invoice amount in the summary.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The invoice number in the header.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:invoiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"invoice date\" ;\n    rdfs:comment \"The invoice date in the header.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:dateTime .\n\n:netPrice a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"The net price of an item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:quantity a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"The quantity of an item in the invoice.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:integer .\n\n:referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"reference number\" ;\n    rdfs:comment \"Reference number in the invoice header.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:totalTax a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"total tax\" ;\n    rdfs:comment \"Total tax amount in the invoice summary.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n#################################################################\n# Disjointness\n#################################################################\n\n:Organization owl:disjointWith :Item .\n:AgentRole owl:disjointWith :Organization .\n:Address owl:disjointWith :Item .\n:Segment owl:disjointWith :Organization .\n:BusinessProcess owl:disjointWith :InvoiceMessage .\n\n#################################################################\n# Restriction Examples (Advanced Axioms)\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        :EDIFACTMessage\n        [ a owl:Restriction ; owl:onProperty :hasSegment ; owl:someValuesFrom :Segment ]\n    )\n] .\n\n:RoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ]\n        [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :Organization ]\n    )\n] .\n"
}
