 of the invoice document, as a string (ISO format recommended).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has global location number\\\" ;\\n    rdfs:comment \\\"The GLN of an organization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n\\n:hasIdentifier a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"A string identifier for documents or organizations.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Disjointness and DisjointUnion\\n#################################################################\\n\\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n\\n[ owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) ] .\\n\"}",
