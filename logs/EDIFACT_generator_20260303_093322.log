        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/edifact-invoic>\\n    a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A deeply structured ontology for UN/EDIFACT D96A INVOIC messages, supporting business document interoperability and validation.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"An INVOIC message as defined in EDIFACT D96A.\\\" ;\\n    rdfs:subClassOf :Message ,\\n        [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:someValuesFrom :InvoiceHeader ] ,\\n        [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:someValuesFrom :InvoiceDetail ] ,\\n        [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:someValuesFrom :InvoiceSummary ] .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT segment, such as BGM or NAD.\\\" .\\n\\n:BGM_Segment a owl:Class ;\\n    rdfs:label \\\"BGM Segment\\\" ;\\n    rdfs:comment \\\"Beginning of Message segment, identifies document type and number.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:NADSegment a owl:Class ;\\n    rdfs:label \\\"NAD Segment\\\" ;\\n    rdfs:comment \\\"Name and Address segment, details of parties involved.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"A simple data element within a segment or composite.\\\" ;\\n    rdfs:subClassOf :CompositeDataElement .\\n\\n:InvoiceHeader a owl:Class ;\\n    rdfs:label \\\"Invoice Header\\\" ;\\n    rdfs:comment \\\"Header section of the invoice message, including dates and references.\\\" .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:label \\\"Invoice Detail\\\" ;\\n    rdfs:comment \\\"Detail section listing line items.\\\" .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:label \\\"Invoice Summary\\\" ;\\n    rdfs:comment \\\"Summary section containing totals and taxes.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A legal entity involved in the transaction.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A generic role played by an organization in the transaction.\\\" .\\n\\n:BuyerRole a owl:Class ;\\n    rdfs:label \\\"Buyer Role\\\" ;\\n    rdfs:comment \\\"The organization acting as the buyer.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:DeliveryPartyRole a owl:Class ;\\n    rdfs:label \\\"Delivery Party Role\\\" ;\\n    rdfs:comment \\\"The organization acting as the delivery party.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:OrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"Organization Role Assignment\\\" ;\\n    rdfs:comment \\\"Pivot class for reifying the assignment of a role to an organization within a message context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address.\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"The price of an item.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"The quantity of an item.\\\" .\\n\\n:ReferenceNumber a owl:Class ;\\n    rdfs:label \\\"Reference Number\\\" ;\\n    rdfs:comment \\\"A reference or document number in the invoice.\\\" .\\n\\n:TaxAmount a owl:Class ;\\n    rdfs:label \\\"Tax Amount\\\" ;\\n    rdfs:comment \\\"The total tax amount in the invoice.\\\" .\\n\\n:InvoiceAmount a owl:Class ;\\n    rdfs:label \\\"Invoice Amount\\\" ;\\n    rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"Global Location Number\\\" ;\\n    rdfs:comment \\\"A globally recognized location identifier (GLN).\\\" ;\\n    rdfs:subClassOf :Identifier .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint or rule used for automated validation (e.g., SHACL).\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"An identifier for organizations or documents.\\\" .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"contains message\\\" ;\\n    rdfs:comment \\\"Connects an Interchange Envelope to its contained message(s).\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :isContainedInEnvelope .\\n\\n:isContainedInEnvelope a owl:ObjectProperty ;\\n    rdfs:label \\\"is contained in envelope\\\" ;\\n    rdfs:comment \\\"Inverse property: Message is contained in an Interchange Envelope.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Connects a message to its segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is segment of\\\" ;\\n    rdfs:comment \\\"Inverse property: Segment is part of a message.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Connects an invoice message to its header section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader ;\\n    owl:inverseOf :isHeaderOf .\\n\\n:isHeaderOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is header of\\\" ;\\n    rdfs:comment \\\"Inverse property: InvoiceHeader is header of InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasHeader .\\n\\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Connects an invoice message to its detail section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:inverseOf :isDetailOf .\\n\\n:isDetailOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is detail of\\\" ;\\n    rdfs:comment \\\"Inverse property: InvoiceDetail is detail of InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasDetail .\\n\\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Connects an invoice message to its summary section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:inverseOf :isSummaryOf .\\n\\n:isSummaryOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is summary of\\\" ;\\n    rdfs:comment \\\"Inverse property: InvoiceSummary is summary of InvoiceMessage.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasSummary .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment\\\" ;\\n    rdfs:comment \\\"Connects an invoice message to an organization-role assignment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :isRoleAssignmentOf .\\n\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is role assignment of\\\" ;\\n    rdfs:comment \\\"Inverse property: OrganizationRoleAssignment is role assignment of InvoiceMessage.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:assignsRole a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"assigns role\\\" ;\\n    rdfs:comment \\\"Connects a role assignment to an agent role.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:inverseOf :isAssignedRoleOf .\\n\\n:isAssignedRoleOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned role of\\\" ;\\n    rdfs:comment \\\"Inverse property: AgentRole is assigned by OrganizationRoleAssignment.\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :assignsRole .\\n\\n:assignedTo a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"assigned to\\\" ;\\n    rdfs:comment \\\"Connects a role assignment to an organization.\\\" ;\\n    rdfs:domain :OrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasRoleAssignmentFor .\\n\\n:hasRoleAssignmentFor a owl:ObjectProperty ;\\n    rdfs:label \\\"has role assignment for\\\" ;\\n    rdfs:comment \\\"Inverse property: Organization has role assignment for OrganizationRoleAssignment.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :OrganizationRoleAssignment ;\\n    owl:inverseOf :assignedTo .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Connects an organization to its address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is address of\\\" ;\\n    rdfs:comment \\\"Inverse property: Address is for an Organization.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:playsRole a owl:ObjectProperty ;\\n    rdfs:label \\\"plays role\\\" ;\\n    rdfs:comment \\\"Connects an organization to a role it plays.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :AgentRole ;\\n    owl:inverseOf :isPlayedBy .\\n\\n:isPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"is played by\\\" ;\\n    rdfs:comment \\\"Inverse property: AgentRole is played by Organization.\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :playsRole .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Connects an invoice detail section to its items.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isItemOf .\\n\\n:isItemOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is item of\\\" ;\\n    rdfs:comment \\\"Inverse property: Item is part of InvoiceDetail.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:inverseOf :hasItem .\\n\\n:hasPrice a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has price\\\" ;\\n    rdfs:comment \\\"Connects an item to its price.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Price ;\\n    owl:inverseOf :isPriceOf .\\n\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is price of\\\" ;\\n    rdfs:comment \\\"Inverse property: Price is for an Item.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasQuantity a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Connects an item to its quantity.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Quantity ;\\n    owl:inverseOf :isQuantityOf .\\n\\n:isQuantityOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is quantity of\\\" ;\\n    rdfs:comment \\\"Inverse property: Quantity is for an Item.\\\" ;\\n    rdfs:domain :Quantity ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :hasQuantity .\\n\\n:hasReferenceNumber a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"Connects an invoice header to its reference number.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :ReferenceNumber ;\\n    owl:inverseOf :isReferenceNumberOf .\\n\\n:isReferenceNumberOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is reference number of\\\" ;\\n    rdfs:comment \\\"Inverse property: ReferenceNumber is for InvoiceHeader.\\\" ;\\n    rdfs:domain :ReferenceNumber ;\\n    rdfs:range :InvoiceHeader ;\\n    owl:inverseOf :hasReferenceNumber .\\n\\n:hasInvoiceAmount a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"Connects an invoice summary to its invoice amount.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :InvoiceAmount ;\\n    owl:inverseOf :isInvoiceAmountOf .\\n\\n:isInvoiceAmountOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is invoice amount of\\\" ;\\n    rdfs:comment \\\"Inverse property: InvoiceAmount is for InvoiceSummary.\\\" ;\\n    rdfs:domain :InvoiceAmount ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:inverseOf :hasInvoiceAmount .\\n\\n:hasTaxAmount a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has tax amount\\\" ;\\n    rdfs:comment \\\"Connects an invoice summary to its tax amount.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :TaxAmount ;\\n    owl:inverseOf :isTaxAmountOf .\\n\\n:isTaxAmountOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is tax amount of\\\" ;\\n    rdfs:comment \\\"Inverse property: TaxAmount is for InvoiceSummary.\\\" ;\\n    rdfs:domain :TaxAmount ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:inverseOf :hasTaxAmount .\\n\\n:isAssignedToProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned to process\\\" ;\\n    rdfs:comment \\\"Assigns an invoice message to a business process.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    owl:inverseOf :hasInvoiceMessage .\\n\\n:hasInvoiceMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice message\\\" ;\\n    rdfs:comment \\\"Inverse property: BusinessProcess has assigned InvoiceMessage.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :isAssignedToProcess .\\n\\n:isValidatedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"is validated by\\\" ;\\n    rdfs:comment \\\"Connects an invoice message to a validation constraint.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    owl:inverseOf :validates .\\n\\n:validates a owl:ObjectProperty ;\\n    rdfs:label \\\"validates\\\" ;\\n    rdfs:comment \\\"Inverse property: ValidationConstraint validates InvoiceMessage.\\\" ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :isValidatedBy .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasDocumentDate a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The date of the invoice document, as a string (ISO format recommended).\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has global location number\\\" ;\\n    rdfs:comment \\\"The GLN of an organization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n\\n:hasIdentifier a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"A string identifier for documents or organizations.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Disjointness and DisjointUnion\\n#################################################################\\n\\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n:BuyerRole owl:disjointWith :DeliveryPartyRole .\\n\\n[ owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) ] .\\n\"}",
