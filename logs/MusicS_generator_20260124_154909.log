f a person's membership in a band at a given time, possibly with a role.\" .\n\n:AlbumRecording a owl:Class ;\n    rdfs:label \"Album Recording\" ;\n    rdfs:comment \"A reification of an album's recording period.\" .\n\n:TrackSongRelation a owl:Class ;\n    rdfs:label \"Track-Song Relation\" ;\n    rdfs:comment \"A reification linking a track to the song it is a recording of.\" .\n\n:PerformanceSong a owl:Class ;\n    rdfs:label \"Performance Song\" ;\n    rdfs:comment \"A reification linking a performance to a song performed.\" .\n\n### Object Properties (with inverses)\n:playsInstrument a owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Links a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:inverseOf :isPlayedBy .\n\n:isPlayedBy a owl:ObjectProperty ;\n    rdfs:label \"is played by\" ;\n    rdfs:comment \"Links an instrument to the person who plays it.\" ;\n    rdfs:domain :Instrument ;\n    rdfs:range :Person ;\n    owl:inverseOf :playsInstrument .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Links a band membership to a role.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Role ;\n    owl:inverseOf :isRoleOf .\n\n:isRoleOf a owl:ObjectProperty ;\n    rdfs:label \"is role of\" ;\n    rdfs:comment \"Links a role to the band membership it is associated with.\" ;\n    rdfs:domain :Role ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :hasRole .\n\n:member a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"member\" ;\n    rdfs:comment \"Links a band membership to the person who is a member.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Person ;\n    owl:inverseOf :isMemberOfMembership .\n\n:isMemberOfMembership a owl:ObjectProperty ;\n    rdfs:label \"is member of membership\" ;\n    rdfs:comment \"Links a person to their band membership.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :member .\n\n:inBand a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"in band\" ;\n    rdfs:comment \"Links a band membership to the band.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range :Band ;\n    owl:inverseOf :hasMembership .\n\n:hasMembership a owl:ObjectProperty ;\n    rdfs:label \"has membership\" ;\n    rdfs:comment \"Links a band to a band membership.\" ;\n    rdfs:domain :Band ;\n    rdfs:range :BandMembership ;\n    owl:inverseOf :inBand .\n\n:recordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"recording of\" ;\n    rdfs:comment \"Links an album recording event to an album.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range :Album ;\n    owl:inverseOf :hasRecording .\n\n:hasRecording a owl:ObjectProperty ;\n    rdfs:label \"has recording\" ;\n    rdfs:comment \"Links an album to its recording event.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :AlbumRecording ;\n    owl:inverseOf :recordingOf .\n\n:containsTrack a owl:ObjectProperty ;\n    rdfs:label \"contains track\" ;\n    rdfs:comment \"Links an album to its tracks.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Track ;\n    owl:inverseOf :isTrackOf .\n\n:isTrackOf a owl:ObjectProperty ;\n    rdfs:label \"is track of\" ;\n    rdfs:comment \"Links a track to the album it is contained in.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :Album ;\n    owl:inverseOf :containsTrack .\n\n:track a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"track\" ;\n    rdfs:comment \"Links a track-song relation to a track.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Track ;\n    owl:inverseOf :isTrackInRelation .\n\n:isTrackInRelation a owl:ObjectProperty ;\n    rdfs:label \"is track in relation\" ;\n    rdfs:comment \"Links a track to its track-song relation.\" ;\n    rdfs:domain :Track ;\n    rdfs:range :TrackSongRelation ;\n    owl:inverseOf :track .\n\n:isRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"is recording of\" ;\n    rdfs:comment \"Links a track-song relation to a song.\" ;\n    rdfs:domain :TrackSongRelation ;\n    rdfs:range :Song ;\n    owl:inverseOf :hasRecordingRelation .\n\n:hasRecordingRelation a owl:ObjectProperty ;\n    rdfs:label \"has recording relation\" ;\n    rdfs:comment \"Links a song to its track-song relation.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :TrackSongRelation ;\n    owl:inverseOf :isRecordingOf .\n\n:performanceOf a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance of\" ;\n    rdfs:comment \"Links a performance-song relation to a performance.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Performance ;\n    owl:inverseOf :hasPerformanceSong .\n\n:hasPerformanceSong a owl:ObjectProperty ;\n    rdfs:label \"has performance song\" ;\n    rdfs:comment \"Links a performance to its performance-song relation.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performanceOf .\n\n:performedSong a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performed song\" ;\n    rdfs:comment \"Links a performance-song relation to a song.\" ;\n    rdfs:domain :PerformanceSong ;\n    rdfs:range :Song ;\n    owl:inverseOf :isPerformedIn .\n\n:isPerformedIn a owl:ObjectProperty ;\n    rdfs:label \"is performed in\" ;\n    rdfs:comment \"Links a song to its performance-song relation.\" ;\n    rdfs:domain :Song ;\n    rdfs:range :PerformanceSong ;\n    owl:inverseOf :performedSong .\n\n:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance location\" ;\n    rdfs:comment \"Links a performance to the city where it takes place.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range :City ;\n    owl:inverseOf :isLocationOfPerformance .\n\n:isLocationOfPerformance a owl:ObjectProperty ;\n    rdfs:label \"is location of performance\" ;\n    rdfs:comment \"Links a city to the performances located there.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Performance ;\n    owl:inverseOf :performanceLocation .\n\n:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"in region\" ;\n    rdfs:comment \"Links a city to the region it is in.\" ;\n    rdfs:domain :City ;\n    rdfs:range :Region ;\n    owl:inverseOf :hasCity .\n\n:hasCity a owl:ObjectProperty ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"Links a region to its cities.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :City ;\n    owl:inverseOf :inRegion .\n\n:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"in country\" ;\n    rdfs:comment \"Links a region to the country it is in.\" ;\n    rdfs:domain :Region ;\n    rdfs:range :Country ;\n    owl:inverseOf :hasRegion .\n\n:hasRegion a owl:ObjectProperty ;\n    rdfs:label \"has region\" ;\n    rdfs:comment \"Links a country to its regions.\" ;\n    rdfs:domain :Country ;\n    rdfs:range :Region ;\n    owl:inverseOf :inCountry .\n\n:reviewedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"reviewed album\" ;\n    rdfs:comment \"Links a critic to the album they reviewed.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :Album ;\n    owl:inverseOf :isReviewedBy .\n\n:isReviewedBy a owl:ObjectProperty ;\n    rdfs:label \"is reviewed by\" ;\n    rdfs:comment \"Links an album to the critic who reviewed it.\" ;\n    rdfs:domain :Album ;\n    rdfs:range :Critic ;\n    owl:inverseOf :reviewedAlbum .\n\n:critic a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:label \"critic\" ;\n    rdfs:comment \"Links a critic instance to the person who is the critic.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range :Person ;\n    owl:inverseOf :isCriticOf .\n\n:isCriticOf a owl:ObjectProperty ;\n    rdfs:label \"is critic of\" ;\n    rdfs:comment \"Links a person to the critic instance.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Critic ;\n    owl:inverseOf :critic .\n\n### Data Properties\n:membershipStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"membership start\" ;\n    rdfs:comment \"Start date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:dateTime .\n\n:membershipEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"membership end\" ;\n    rdfs:comment \"End date of a band membership.\" ;\n    rdfs:domain :BandMembership ;\n    rdfs:range xsd:dateTime .\n\n:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"recording start\" ;\n    rdfs:comment \"Start date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"recording end\" ;\n    rdfs:comment \"End date of album recording.\" ;\n    rdfs:domain :AlbumRecording ;\n    rdfs:range xsd:dateTime .\n\n:trackNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"track number\" ;\n    rdfs:comment \"The number of a track within an album.\" ;\n    rdfs:domain :Track ;\n    rdfs:range xsd:integer .\n\n:releaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"release date\" ;\n    rdfs:comment \"Release date of an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:dateTime .\n\n:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"composed on\" ;\n    rdfs:comment \"Date when a song was composed.\" ;\n    rdfs:domain :Song ;\n    rdfs:range xsd:dateTime .\n\n:reviewText a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"review text\" ;\n    rdfs:comment \"Text of a critic's review.\" ;\n    rdfs:domain :Critic ;\n    rdfs:range xsd:string .\n\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:label \"performance date\" ;\n    rdfs:comment \"Date of a performance.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:dateTime .\n\n### Disjointness Axioms\n:Person owl:disjointWith :Band , :Critic .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Performance .\n:Song owl:disjointWith :Track .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n\n### End of Ontology"
}
