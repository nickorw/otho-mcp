fs:label \"has segment\" ;\n  rdfs:comment \"Links a message to its segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasSection rdf:type owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Links an invoice message to its sections.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :Segment .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links an invoice detail section to its line items.\" ;\n  rdfs:domain :InvoiceDetailSection ;\n  rdfs:range :LineItem .\n\n:hasCompositeElement rdf:type owl:ObjectProperty ;\n  rdfs:label \"has composite element\" ;\n  rdfs:comment \"Links a segment to its composite elements.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement .\n\n:hasSimpleElement rdf:type owl:ObjectProperty ;\n  rdfs:label \"has simple element\" ;\n  rdfs:comment \"Links a composite element to its simple elements.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement .\n\n:hasOrganizationRoleAssignment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has organization role assignment\" ;\n  rdfs:comment \"Links an invoice message to organization role assignments.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :OrganizationRoleAssignment .\n\n:involvesOrganization rdf:type owl:ObjectProperty ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Links an organization role assignment to the organization.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization ;\n  owl:FunctionalProperty .\n\n:withRole rdf:type owl:ObjectProperty ;\n  rdfs:label \"with role\" ;\n  rdfs:comment \"Links an organization role assignment to the agent role.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole ;\n  owl:FunctionalProperty .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization role assignment to an address.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Address .\n\n:hasIdentifier rdf:type owl:ObjectProperty ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to its identifiers.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier .\n\n:refersToItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"refers to item\" ;\n  rdfs:comment \"Links a line item to the item sold.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item .\n\n:hasPrice rdf:type owl:ObjectProperty ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Links a line item to its price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price .\n\n:partOfBusinessProcess rdf:type owl:ObjectProperty ;\n  rdfs:label \"part of business process\" ;\n  rdfs:comment \"Links an invoice message to a business process.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess .\n\n# Data Properties\n:hasInvoiceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"Invoice number in the header section.\" ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string .\n\n:hasInvoiceDate rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice date\" ;\n  rdfs:comment \"Date of the invoice.\" ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:dateTime .\n\n:hasNetPrice rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Net price of an item.\" ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal .\n\n:hasQuantity rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Quantity of items in a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:hasTotalAmount rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has total amount\" ;\n  rdfs:comment \"Total invoice amount in the summary section.\" ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasTaxAmount rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has tax amount\" ;\n  rdfs:comment \"Total tax amount in the summary section.\" ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range xsd:decimal .\n\n:hasName rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has name\" ;\n  rdfs:comment \"Name of the organization.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string .\n\n:hasAddressLine rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has address line\" ;\n  rdfs:comment \"Address line of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasPostalCode rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has postal code\" ;\n  rdfs:comment \"Postal code of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasCity rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has city\" ;\n  rdfs:comment \"City of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasCountryCode rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has country code\" ;\n  rdfs:comment \"Country code of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:hasIdentifierValue rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has identifier value\" ;\n  rdfs:comment \"Value of an identifier.\" ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string .\n\n# Property Characteristics\n:involvesOrganization rdf:type owl:FunctionalProperty .\n:withRole rdf:type owl:FunctionalProperty .\n\n# Example Restriction: Buyer must be an OrganizationRoleAssignment with AgentRole Buyer\n:BuyerAssignment rdf:type owl:Class ;\n  rdfs:label \"Buyer Assignment\" ;\n  rdfs:comment \"OrganizationRoleAssignment where AgentRole is Buyer.\" ;\n  owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :withRole ; owl:hasValue :Buyer ] .\n\n:Buyer rdf:type :AgentRole ;\n  rdfs:label \"Buyer\" ;\n  rdfs:comment \"Agent role of buyer in a transaction.\" .\n\n# General Class Axiom: All OrganizationRoleAssignments must involve an Organization\n[] rdf:type owl:Restriction ;\n   owl:onProperty :involvesOrganization ;\n   owl:someValuesFrom :Organization ;\n   rdfs:subClassOf :OrganizationRoleAssignment .\n"
