; rdfs:label \\\"contains message\\\" ; rdfs:comment \\\"Links an interchange envelope to messages it contains.\\\" ; rdfs:domain :InterchangeEnvelope ; rdfs:range :Message .\\n:containedInEnvelope rdf:type owl:ObjectProperty ; rdfs:label \\\"contained in envelope\\\" ; rdfs:comment \\\"Inverse of containsMessage; links a message to its envelope.\\\" ; rdfs:domain :Message ; rdfs:range :InterchangeEnvelope ; owl:inverseOf :containsMessage .\\n:hasSection rdf:type owl:ObjectProperty ; rdfs:label \\\"has section\\\" ; rdfs:comment \\\"Links an invoice message to its sections.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :Section .\\n:isSectionOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is section of\\\" ; rdfs:comment \\\"Inverse of hasSection; links a section to its invoice message.\\\" ; rdfs:domain :Section ; rdfs:range :InvoiceMessage ; owl:inverseOf :hasSection .\\n:hasSegment rdf:type owl:ObjectProperty ; rdfs:label \\\"has segment\\\" ; rdfs:comment \\\"Links a message to its segments.\\\" ; rdfs:domain :Message ; rdfs:range :Segment .\\n:isSegmentOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is segment of\\\" ; rdfs:comment \\\"Inverse of hasSegment; links a segment to its message.\\\" ; rdfs:domain :Segment ; rdfs:range :Message ; owl:inverseOf :hasSegment .\\n:hasCompositeElement rdf:type owl:ObjectProperty ; rdfs:label \\\"has composite element\\\" ; rdfs:comment \\\"Links a segment to its composite data elements.\\\" ; rdfs:domain :Segment ; rdfs:range :CompositeDataElement .\\n:isCompositeElementOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is composite element of\\\" ; rdfs:comment \\\"Inverse of hasCompositeElement; links a composite element to its segment.\\\" ; rdfs:domain :CompositeDataElement ; rdfs:range :Segment ; owl:inverseOf :hasCompositeElement .\\n:hasSimpleElement rdf:type owl:ObjectProperty ; rdfs:label \\\"has simple element\\\" ; rdfs:comment \\\"Links a composite data element to its simple data elements.\\\" ; rdfs:domain :CompositeDataElement ; rdfs:range :SimpleDataElement .\\n:isSimpleElementOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is simple element of\\\" ; rdfs:comment \\\"Inverse of hasSimpleElement; links a simple data element to its composite.\\\" ; rdfs:domain :SimpleDataElement ; rdfs:range :CompositeDataElement ; owl:inverseOf :hasSimpleElement .\\n:involvesOrganization rdf:type owl:ObjectProperty ; rdfs:label \\\"involves organization\\\" ; rdfs:comment \\\"Links an invoice message to organizations involved.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :Organization .\\n:isInvolvedInInvoice rdf:type owl:ObjectProperty ; rdfs:label \\\"is involved in invoice\\\" ; rdfs:comment \\\"Inverse of involvesOrganization; links an organization to invoices.\\\" ; rdfs:domain :Organization ; rdfs:range :InvoiceMessage ; owl:inverseOf :involvesOrganization .\\n:hasLineItem rdf:type owl:ObjectProperty ; rdfs:label \\\"has line item\\\" ; rdfs:comment \\\"Links a detail section to its line items.\\\" ; rdfs:domain :DetailSection ; rdfs:range :LineItem .\\n:isLineItemOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is line item of\\\" ; rdfs:comment \\\"Inverse of hasLineItem; links a line item to its detail section.\\\" ; rdfs:domain :LineItem ; rdfs:range :DetailSection ; owl:inverseOf :hasLineItem .\\n:soldItem rdf:type owl:ObjectProperty ; rdfs:label \\\"sold item\\\" ; rdfs:comment \\\"Links a line item to the item being sold.\\\" ; rdfs:domain :LineItem ; rdfs:range :Item .\\n:isSoldItemOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is sold item of\\\" ; rdfs:comment \\\"Inverse of soldItem; links an item to the line item where it's sold.\\\" ; rdfs:domain :Item ; rdfs:range :LineItem ; owl:inverseOf :soldItem .\\n:hasPrice rdf:type owl:ObjectProperty ; rdfs:label \\\"has price\\\" ; rdfs:comment \\\"Links a line item to its price.\\\" ; rdfs:domain :LineItem ; rdfs:range :Price .\\n:isPriceOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is price of\\\" ; rdfs:comment \\\"Inverse of hasPrice; links a price to its line item.\\\" ; rdfs:domain :Price ; rdfs:range :LineItem ; owl:inverseOf :hasPrice .\\n:hasRoleAssignment rdf:type owl:ObjectProperty ; rdfs:label \\\"has role assignment\\\" ; rdfs:comment \\\"Links an invoice message to an OrganizationRoleAssignment pivot class.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :OrganizationRoleAssignment .\\n:isRoleAssignmentOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is role assignment of\\\" ; rdfs:comment \\\"Inverse of hasRoleAssignment; links a role assignment to its invoice message.\\\" ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :InvoiceMessage ; owl:inverseOf :hasRoleAssignment .\\n:roleOfOrganization rdf:type owl:ObjectProperty ; rdfs:label \\\"role of organization\\\" ; rdfs:comment \\\"Links a role assignment to the organization.\\\" ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :Organization .\\n:hasOrganizationRoleAssignment rdf:type owl:ObjectProperty ; rdfs:label \\\"has organization role assignment\\\" ; rdfs:comment \\\"Inverse of roleOfOrganization; links an organization to its role assignments.\\\" ; rdfs:domain :Organization ; rdfs:range :OrganizationRoleAssignment ; owl:inverseOf :roleOfOrganization .\\n:assignedRole rdf:type owl:ObjectProperty ; rdfs:label \\\"assigned role\\\" ; rdfs:comment \\\"Links a role assignment to the role.\\\" ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :AgentRole .\\n:isAssignedRoleOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is assigned role of\\\" ; rdfs:comment \\\"Inverse of assignedRole; links a role to its assignments.\\\" ; rdfs:domain :AgentRole ; rdfs:range :OrganizationRoleAssignment ; owl:inverseOf :assignedRole .\\n:roleAddress rdf:type owl:ObjectProperty ; rdfs:label \\\"role address\\\" ; rdfs:comment \\\"Links a role assignment to the address used in that role.\\\" ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :Address .\\n:isRoleAddressOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is role address of\\\" ; rdfs:comment \\\"Inverse of roleAddress; links an address to its role assignments.\\\" ; rdfs:domain :Address ; rdfs:range :OrganizationRoleAssignment ; owl:inverseOf :roleAddress .\\n:hasIdentifier rdf:type owl:ObjectProperty ; rdfs:label \\\"has identifier\\\" ; rdfs:comment \\\"Links an organization to its identifier.\\\" ; rdfs:domain :Organization ; rdfs:range :Identifier .\\n:isIdentifierOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is identifier of\\\" ; rdfs:comment \\\"Inverse of hasIdentifier; links an identifier to its organization.\\\" ; rdfs:domain :Identifier ; rdfs:range :Organization ; owl:inverseOf :hasIdentifier .\\n:assignedToProcess rdf:type owl:ObjectProperty ; rdfs:label \\\"assigned to process\\\" ; rdfs:comment \\\"Links an invoice message to a business process.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :BusinessProcess .\\n:isProcessAssignmentOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is process assignment of\\\" ; rdfs:comment \\\"Inverse of assignedToProcess; links a business process to invoice messages.\\\" ; rdfs:domain :BusinessProcess ; rdfs:range :InvoiceMessage ; owl:inverseOf :assignedToProcess .\\n:hasValidationConstraint rdf:type owl:ObjectProperty ; rdfs:label \\\"has validation constraint\\\" ; rdfs:comment \\\"Links an invoice message to a validation constraint.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :ValidationConstraint .\\n:isValidationConstraintOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is validation constraint of\\\" ; rdfs:comment \\\"Inverse of hasValidationConstraint; links a validation constraint to invoice messages.\\\" ; rdfs:domain :ValidationConstraint ; rdfs:range :InvoiceMessage ; owl:inverseOf :hasValidationConstraint .\\n\\n### Data Properties\\n:documentDate rdf:type owl:DatatypeProperty ; rdfs:label \\\"document date\\\" ; rdfs:comment \\\"The date of the document.\\\" ; rdfs:domain :HeaderSection ; rdfs:range xsd:dateTime .\\n:referenceNumber rdf:type owl:DatatypeProperty ; rdfs:label \\\"reference number\\\" ; rdfs:comment \\\"The reference number of the document.\\\" ; rdfs:domain :HeaderSection ; rdfs:range xsd:string .\\n:organizationName rdf:type owl:DatatypeProperty ; rdfs:label \\\"organization name\\\" ; rdfs:comment \\\"Name of the organization.\\\" ; rdfs:domain :Organization ; rdfs:range xsd:string .\\n:addressLine rdf:type owl:DatatypeProperty ; rdfs:label \\\"address line\\\" ; rdfs:comment \\\"Text of the address line.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:postalCode rdf:type owl:DatatypeProperty ; rdfs:label \\\"postal code\\\" ; rdfs:comment \\\"Postal code for the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:city rdf:type owl:DatatypeProperty ; rdfs:label \\\"city\\\" ; rdfs:comment \\\"City of the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:countryCode rdf:type owl:DatatypeProperty ; rdfs:label \\\"country code\\\" ; rdfs:comment \\\"Country code of the address.\\\" ; rdfs:domain :Address ; rdfs:range xsd:string .\\n:itemName rdf:type owl:DatatypeProperty ; rdfs:label \\\"item name\\\" ; rdfs:comment \\\"Name of the item.\\\" ; rdfs:domain :Item ; rdfs:range xsd:string .\\n:netPrice rdf:type owl:DatatypeProperty ; rdfs:label \\\"net price\\\" ; rdfs:comment \\\"Net price of the item.\\\" ; rdfs:domain :Price ; rdfs:range xsd:decimal .\\n:quantity rdf:type owl:DatatypeProperty ; rdfs:label \\\"quantity\\\" ; rdfs:comment \\\"Quantity of the item in the line item.\\\" ; rdfs:domain :LineItem ; rdfs:range xsd:decimal .\\n:invoiceAmount rdf:type owl:DatatypeProperty ; rdfs:label \\\"invoice amount\\\" ; rdfs:comment \\\"Total invoice amount.\\\" ; rdfs:domain :SummarySection ; rdfs:range xsd:decimal .\\n:invoiceNumber rdf:type owl:DatatypeProperty ; rdfs:label \\\"invoice number\\\" ; rdfs:comment \\\"Invoice number.\\\" ; rdfs:domain :HeaderSection ; rdfs:range xsd:string .\\n:taxTotal rdf:type owl:DatatypeProperty ; rdfs:label \\\"tax total\\\" ; rdfs:comment \\\"Total tax amount.\\\" ; rdfs:domain :SummarySection ; rdfs:range xsd:decimal .\\n:identifierValue rdf:type owl:DatatypeProperty ; rdfs:label \\\"identifier value\\\" ; rdfs:comment \\\"The value of the identifier.\\\" ; rdfs:domain :Identifier ; rdfs:range xsd:string .\\n:identifierType rdf:type owl:DatatypeProperty ; rdfs:label \\\"identifier type\\\" ; rdfs:comment \\\"The type of identifier, e.g., GLN.\\\" ; rdfs:domain :Identifier ; rdfs:range xsd:string .\\n\\n### Property Characteristics\\n:containsMessage rdf:type owl:FunctionalProperty .\\n:hasSection rdf:type owl:FunctionalProperty .\\n:hasPrice rdf:type owl:FunctionalProperty .\\n:roleOfOrganization rdf:type owl:FunctionalProperty .\\n:assignedRole rdf:type owl:FunctionalProperty .\\n:roleAddress rdf:type owl:FunctionalProperty .\\n:documentDate rdf:type owl:FunctionalProperty .\\n:referenceNumber rdf:type owl:FunctionalProperty .\\n:organizationName rdf:type owl:FunctionalProperty .\\n:itemName rdf:type owl:FunctionalProperty .\\n:netPrice rdf:type owl:FunctionalProperty .\\n:quantity rdf:type owl:FunctionalProperty .\\n:invoiceAmount rdf:type owl:FunctionalProperty .\\n:invoiceNumber rdf:type owl:FunctionalProperty .\\n:identifierValue rdf:type owl:FunctionalProperty .\\n:identifierType rdf:type owl:FunctionalProperty .\\n\\n### Restrictions and GCAs\\n:BuyerRole rdf:type :AgentRole ; rdfs:label \\\"Buyer Role\\\" ; rdfs:comment \\\"Role of buyer in an invoice.\\\" .\\n_:orgRoleAssignmentBuyer rdf:type owl:Restriction ; owl:onProperty :assignedRole ; owl:hasValue :BuyerRole ; rdfs:subClassOf :OrganizationRoleAssignment .\\n_:orgRoleAssignmentOrg rdf:type owl:Restriction ; owl:onProperty :roleOfOrganization ; owl:someValuesFrom :Organization ; rdfs:subClassOf :OrganizationRoleAssignment .\\n\\n### Validation Constraint Example\\n:MandatoryGLNIdentifier rdf:type :ValidationConstraint ; rdfs:label \\\"Mandatory GLN Identifier\\\" ; rdfs:comment \\\"Constraint that every organization must have a GLN identifier (for SHACL).\\\" .\\n:InvoiceMessage :hasValidationConstraint :MandatoryGLNIdentifier .\\n\"}",
