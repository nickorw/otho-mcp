        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#edifact-invoice-story>\\n    rdf:type owl:Ontology ;\\n    rdfs:label \\\"EDIFACT Invoice Ontology\\\" ;\\n    rdfs:comment \\\"Ontology for representing UN/EDIFACT invoice structures, roles, and validation constraints.\\\" .\\n\\n### Classes\\n:InterchangeEnvelope rdf:type owl:Class ; rdfs:label \\\"Interchange Envelope\\\" ; rdfs:comment \\\"The envelope containing EDIFACT messages.\\\" .\\n:Message rdf:type owl:Class ; rdfs:label \\\"Message\\\" ; rdfs:comment \\\"A generic message in the EDIFACT structure.\\\" .\\n:InvoiceMessage rdf:type owl:Class ; rdfs:label \\\"Invoice Message\\\" ; rdfs:comment \\\"An invoice message (INVOIC) in EDIFACT.\\\" ; rdfs:subClassOf :Message .\\n:Segment rdf:type owl:Class ; rdfs:label \\\"Segment\\\" ; rdfs:comment \\\"A segment in a message, such as BGM or NAD.\\\" .\\n:CompositeDataElement rdf:type owl:Class ; rdfs:label \\\"Composite Data Element\\\" ; rdfs:comment \\\"A composite data element in a segment.\\\" .\\n:SimpleDataElement rdf:type owl:Class ; rdfs:label \\\"Simple Data Element\\\" ; rdfs:comment \\\"A simple data element within a composite.\\\" .\\n:Section rdf:type owl:Class ; rdfs:label \\\"Section\\\" ; rdfs:comment \\\"A section of an invoice message (header, detail, summary).\\\" .\\n:HeaderSection rdf:type owl:Class ; rdfs:label \\\"Header Section\\\" ; rdfs:comment \\\"Header section containing document dates and references.\\\" ; rdfs:subClassOf :Section .\\n:DetailSection rdf:type owl:Class ; rdfs:label \\\"Detail Section\\\" ; rdfs:comment \\\"Detail section containing line items.\\\" ; rdfs:subClassOf :Section .\\n:SummarySection rdf:type owl:Class ; rdfs:label \\\"Summary Section\\\" ; rdfs:comment \\\"Summary section with totals and tax.\\\" ; rdfs:subClassOf :Section .\\n:LineItem rdf:type owl:Class ; rdfs:label \\\"Line Item\\\" ; rdfs:comment \\\"A line item in the detail section.\\\" .\\n:Item rdf:type owl:Class ; rdfs:label \\\"Item\\\" ; rdfs:comment \\\"An item sold in the invoice.\\\" .\\n:Price rdf:type owl:Class ; rdfs:label \\\"Price\\\" ; rdfs:comment \\\"The price of an item.\\\" .\\n:Organization rdf:type owl:Class ; rdfs:label \\\"Organization\\\" ; rdfs:comment \\\"An organization involved in the invoice.\\\" .\\n:AgentRole rdf:type owl:Class ; rdfs:label \\\"Agent Role\\\" ; rdfs:comment \\\"A role played by an organization (buyer, seller, delivery party, etc.).\\\" .\\n:OrganizationRoleAssignment rdf:type owl:Class ; rdfs:label \\\"Organization Role Assignment\\\" ; rdfs:comment \\\"Pivot class for assigning roles to organizations within an invoice.\\\" .\\n:Address rdf:type owl:Class ; rdfs:label \\\"Address\\\" ; rdfs:comment \\\"An address associated with an organization role.\\\" .\\n:Identifier rdf:type owl:Class ; rdfs:label \\\"Identifier\\\" ; rdfs:comment \\\"An identifier for an organization, such as a GLN.\\\" .\\n:BusinessProcess rdf:type owl:Class ; rdfs:label \\\"Business Process\\\" ; rdfs:comment \\\"A business process to which an invoice can be assigned.\\\" .\\n:ValidationConstraint rdf:type owl:Class ; rdfs:label \\\"Validation Constraint\\\" ; rdfs:comment \\\"A constraint for validation, e.g., SHACL rules for totals and identifiers.\\\" .\\n\\n### Disjoint/DisjointUnion\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:InvoiceMessage owl:disjointWith :BusinessProcess .\\n:Organization owl:disjointWith :Item .\\n:AgentRole owl:disjointWith :Organization .\\n:Section owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) .\\n\\n### Object Properties\\n:containsMessage rdf:type owl:ObjectProperty ; rdfs:label \\\"contains message\\\" ; rdfs:comment \\\"Links an interchange envelope to messages it contains.\\\" ; rdfs:domain :InterchangeEnvelope ; rdfs:range :Message .\\n:containedInEnvelope rdf:type owl:ObjectProperty ; rdfs:label \\\"contained in envelope\\\" ; rdfs:comment \\\"Inverse of containsMessage; links a message to its envelope.\\\" ; rdfs:domain :Message ; rdfs:range :InterchangeEnvelope ; owl:inverseOf :containsMessage .\\n:hasSection rdf:type owl:ObjectProperty ; rdfs:label \\\"has section\\\" ; rdfs:comment \\\"Links an invoice message to its sections.\\\" ; rdfs:domain :InvoiceMessage ; rdfs:range :Section .\\n:isSectionOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is section of\\\" ; rdfs:comment \\\"Inverse of hasSection; links a section to its invoice message.\\\" ; rdfs:domain :Section ; rdfs:range :InvoiceMessage ; owl:inverseOf :hasSection .\\n:hasSegment rdf:type owl:ObjectProperty ; rdfs:label \\\"has segment\\\" ; rdfs:comment \\\"Links a message to its segments.\\\" ; rdfs:domain :Message ; rdfs:range :Segment .\\n:isSegmentOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is segment of\\\" ; rdfs:comment \\\"Inverse of hasSegment; links a segment to its message.\\\" ; rdfs:domain :Segment ; rdfs:range :Message ; owl:inverseOf :hasSegment .\\n:hasCompositeElement rdf:type owl:ObjectProperty ; rdfs:label \\\"has composite element\\\" ; rdfs:comment \\\"Links a segment to its composite data elements.\\\" ; rdfs:domain :Segment ; rdfs:range :CompositeDataElement .\\n:isCompositeElementOf rdf:type owl:ObjectProperty ; rdfs:label \\\"is composite element of\\\" ; rdfs:comment \\\"Inverse of hasCompositeElement; links a composite element to its segment.\\\" ; rdfs:domain :CompositeDataElement ; rdfs:range :Segment ; owl:inverseOf :hasCompositeElement .\\n:hasSimpleElement rdf:type owl:ObjectProperty ; rdfs:label \\\"has simple element\\\" ; rdfs:comment \\\"Links a composite data element to its simple data elements.\\\" ; rdfs:domain :Comp