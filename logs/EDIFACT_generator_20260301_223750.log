###################\n# Object Properties with Inverses\n#################################################################\n:containsMessage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Relates an InterchangeEnvelope to the Message it contains.\" ;\n    owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope rdf:type owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage: relates a Message to its InterchangeEnvelope.\" ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates a Message to its Segments.\" ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment: relates a Segment to the Message it is part of.\" ;\n    owl:inverseOf :hasSegment .\n\n:hasCompositeDataElement rdf:type owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite data element\" ;\n    rdfs:comment \"Relates a Segment to its Composite Data Elements.\" ;\n    owl:inverseOf :isCompositeDataElementOf .\n\n:isCompositeDataElementOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite data element of\" ;\n    rdfs:comment \"Inverse of hasCompositeDataElement.\" ;\n    owl:inverseOf :hasCompositeDataElement .\n\n:hasSimpleDataElement rdf:type owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple data element\" ;\n    rdfs:comment \"Relates a Composite Data Element to its Simple Data Elements.\" ;\n    owl:inverseOf :isSimpleDataElementOf .\n\n:isSimpleDataElementOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple data element of\" ;\n    rdfs:comment \"Inverse of hasSimpleDataElement.\" ;\n    owl:inverseOf :hasSimpleDataElement .\n\n:hasSection rdf:type owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Section ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Relates an InvoiceMessage to its Sections.\" ;\n    owl:inverseOf :isSectionOf .\n\n:isSectionOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :Section ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is section of\" ;\n    rdfs:comment \"Inverse of hasSection: relates a Section to the InvoiceMessage it is part of.\" ;\n    owl:inverseOf :hasSection .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates a DetailSection to its LineItems.\" ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem: relates a LineItem to its DetailSection.\" ;\n    owl:inverseOf :hasLineItem .\n\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Relates a LineItem to the Item it describes.\" ;\n    owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem rdf:type owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is described by line item\" ;\n    rdfs:comment \"Inverse of describesItem.\" ;\n    owl:inverseOf :describesItem .\n\n:hasPrice rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Relates a LineItem to its Price.\" ;\n    owl:inverseOf :isPriceOf .\n\n:isPriceOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is price of\" ;\n    rdfs:comment \"Inverse of hasPrice.\" ;\n    owl:inverseOf :hasPrice .\n\n:hasOrganizationRoleAssignment rdf:type owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Relates an InvoiceMessage to an OrganizationRoleAssignment pivot class.\" ;\n    owl:inverseOf :isOrganizationRoleAssignmentOf .\n\n:isOrganizationRoleAssignmentOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is organization role assignment of\" ;\n    rdfs:comment \"Inverse of hasOrganizationRoleAssignment.\" ;\n    owl:inverseOf :hasOrganizationRoleAssignment .\n\n:roleOfOrganization rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"role of organization\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the Organization playing a role.\" ;\n    owl:inverseOf :hasOrganizationRole .\n\n:hasOrganizationRole rdf:type owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has organization role\" ;\n    rdfs:comment \"Inverse of roleOfOrganization.\" ;\n    owl:inverseOf :roleOfOrganization .\n\n:hasAgentRole rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the AgentRole being played.\" ;\n    owl:inverseOf :isAgentRoleOf .\n\n:isAgentRoleOf rdf:type owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is agent role of\" ;\n    rdfs:comment \"Inverse of hasAgentRole.\" ;\n    owl:inverseOf :hasAgentRole .\n\n:hasAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an OrganizationRoleAssignment to the Address relevant for the role.\" ;\n    owl:inverseOf :isAddressOfRoleAssignment .\n\n:isAddressOfRoleAssignment rdf:type owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"is address of role assignment\" ;\n    rdfs:comment \"Inverse of hasAddress.\" ;\n    owl:inverseOf :hasAddress .\n\n:assignedToBusinessProcess rdf:type owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to business process\" ;\n    rdfs:comment \"Relates an InvoiceMessage to a BusinessProcess.\" ;\n    owl:inverseOf :hasAssignedInvoiceMessage .\n\n:hasAssignedInvoiceMessage rdf:type owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"has assigned invoice message\" ;\n    rdfs:comment \"Inverse of assignedToBusinessProcess.\" ;\n    owl:inverseOf :assignedToBusinessProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n:hasInvoiceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number of an InvoiceMessage.\" .\n\n:hasInvoiceAmount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total invoice amount in the SummarySection.\" .\n\n:hasTaxAmount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"The total tax amount in the SummarySection.\" .\n\n:hasDocumentDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:dateTime ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The date the invoice document was issued.\" .\n\n:hasReferenceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Reference number in the HeaderSection.\" .\n\n:hasNetPrice rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Net price of the item in the Price class.\" .\n\n:hasQuantity rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"Quantity of items in a LineItem.\" .\n\n:hasGlobalLocationNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has global location number\" ;\n    rdfs:comment \"The Global Location Number for an Organization.\" .\n\n:hasName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has name\" ;\n    rdfs:comment \"The name of the Organization.\" .\n\n:hasStreet rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has street\" ;\n    rdfs:comment \"Street address information.\" .\n\n:hasPostalCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has postal code\" ;\n    rdfs:comment \"Postal code of the address.\" .\n\n:hasCity rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has city\" ;\n    rdfs:comment \"City of the address.\" .\n\n:hasCountryCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has country code\" ;\n    rdfs:comment \"Country code for the address.\" .\n\n:hasRoleIdentifier rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has role identifier\" ;\n    rdfs:comment \"Identifier for a specific agent role.\" .\n\n:hasDescription rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has description\" ;\n    rdfs:comment \"Description of an Item.\" .\n\n#################################################################\n# Additional Axioms\n#################################################################\n# (GCAs, restrictions and equivalence axioms to be added in next iteration if needed.)\n"
