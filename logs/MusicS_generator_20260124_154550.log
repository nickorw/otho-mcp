        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/music-production> a owl:Ontology ;\\n    rdfs:label \\\"Music Production Ontology\\\" ;\\n    rdfs:comment \\\"An ontology capturing music production, band membership, albums, performances, and critiques as described in the Red Hot Chili Peppers scenario.\\\" .\\n\\n# Classes\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual, such as a band member or critic.\\\" .\\n\\n:Band a owl:Class ;\\n    rdfs:label \\\"Band\\\" ;\\n    rdfs:comment \\\"A musical group, such as the Red Hot Chili Peppers.\\\" .\\n\\n:Instrument a owl:Class ;\\n    rdfs:label \\\"Instrument\\\" ;\\n    rdfs:comment \\\"A musical instrument played by a person.\\\" .\\n\\n:Role a owl:Class ;\\n    rdfs:label \\\"Role\\\" ;\\n    rdfs:comment \\\"A function or position held by a person in a band (e.g., vocals, drums).\\\" .\\n\\n:Membership a owl:Class ;\\n    rdfs:label \\\"Membership\\\" ;\\n    rdfs:comment \\\"A reified relationship capturing a person's role in a band during a time period.\\\" .\\n\\n:Album a owl:Class ;\\n    rdfs:label \\\"Album\\\" ;\\n    rdfs:comment \\\"A collection of tracks released by a band.\\\" .\\n\\n:Track a owl:Class ;\\n    rdfs:label \\\"Track\\\" ;\\n    rdfs:comment \\\"A distinct recording on an album, possibly a song.\\\" .\\n\\n:Song a owl:Class ;\\n    rdfs:label \\\"Song\\\" ;\\n    rdfs:comment \\\"A musical composition, possibly recorded as a track.\\\" .\\n\\n:Critic a owl:Class ;\\n    rdfs:subClassOf :Person ;\\n    rdfs:label \\\"Critic\\\" ;\\n    rdfs:comment \\\"A person who makes critiques of albums.\\\" .\\n\\n:Critique a owl:Class ;\\n    rdfs:label \\\"Critique\\\" ;\\n    rdfs:comment \\\"A reified critique by a critic about an album.\\\" .\\n\\n:Performance a owl:Class ;\\n    rdfs:label \\\"Performance\\\" ;\\n    rdfs:comment \\\"A live music event by a band.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where performances can take place.\\\" .\\n\\n:Region a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A region containing cities.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n# Disjointness axioms\\n:Person owl:disjointWith :Band .\\n:Instrument owl:disjointWith :Role .\\n:Album owl:disjointWith :Song .\\n:Track owl:disjointWith :Song .\\n:Critic owl:disjointWith :Band .\\n:City owl:disjointWith :Region .\\n:Region owl:disjointWith :Country .\\n\\n# Properties\\n:playsInstrument a owl:ObjectProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Relates a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument .\\n\\n:hasMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"has membership\\\" ;\\n    rdfs:comment \\\"Relates a band to a membership instance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Membership .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Relates a membership to the person who is a member.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range :Person .\\n\\n:hasRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Relates a membership to the role held by the member.\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range :Role .\\n\\n:membershipStart a owl:DatatypeProperty ;\\n    rdfs:label \\\"membership start\\\" ;\\n    rdfs:comment \\\"The start date of a person's membership in a band (as string).\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range xsd:string .\\n\\n:membershipEnd a owl:DatatypeProperty ;\\n    rdfs:label \\\"membership end\\\" ;\\n    rdfs:comment \\\"The end date of a person's membership in a band (as string).\\\" ;\\n    rdfs:domain :Membership ;\\n    rdfs:range xsd:string .\\n\\n:recordedAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded album\\\" ;\\n    rdfs:comment \\\"Relates a band to an album it recorded.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Album .\\n\\n:recordingStart a owl:DatatypeProperty ;\\n    rdfs:label \\\"recording start\\\" ;\\n    rdfs:comment \\\"The start date for an album's recording (as string).\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:string .\\n\\n:recordingEnd a owl:DatatypeProperty ;\\n    rdfs:label \\\"recording end\\\" ;\\n    rdfs:comment \\\"The end date for an album's recording (as string).\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:string .\\n\\n:containsTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"contains track\\\" ;\\n    rdfs:comment \\\"Relates an album to a track it contains.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track .\\n\\n:trackCount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"track count\\\" ;\\n    rdfs:comment \\\"The number of tracks in an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:nonNegativeInteger .\\n\\n:releaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"release date\\\" ;\\n    rdfs:comment \\\"The release date of an album (as string).\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:string .\\n\\n:trackOfSong a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"track of song\\\" ;\\n    rdfs:comment \\\"Relates a track to the song it records.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Song .\\n\\n:compositionDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"composition date\\\" ;\\n    rdfs:comment \\\"The date a song was composed (as string).\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range xsd:string .\\n\\n:hasCritique a owl:ObjectProperty ;\\n    rdfs:label \\\"has critique\\\" ;\\n    rdfs:comment \\\"Relates an album to a critique.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critique .\\n\\n:critic a owl:ObjectProperty ;\\n    rdfs:label \\\"critic\\\" ;\\n    rdfs:comment \\\"Relates a critique to the critic who made it.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range :Critic .\\n\\n:critiqueStatement a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"critique statement\\\" ;\\n    rdfs:comment \\\"The statement made by a critic about an album.\\\" ;\\n    rdfs:domain :Critique ;\\n    rdfs:range xsd:string .\\n\\n:performanceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"performance of\\\" ;\\n    rdfs:comment \\\"Relates a performance to the band performing.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Band .\\n\\n:performedSong a owl:ObjectProperty ;\\n    rdfs:label \\\"performed song\\\" ;\\n    rdfs:comment \\\"Relates a performance to a song performed.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Song .\\n\\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance date\\\" ;\\n    rdfs:comment \\\"The date of a performance (as string).\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:string .\\n\\n:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"The city where a performance took place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City .\\n\\n:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"in region\\\" ;\\n    rdfs:comment \\\"Relates a city to the region it is in.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region .\\n\\n:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"in country\\\" ;\\n    rdfs:comment \\\"Relates a region to the country it is in.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country .\\n\\n# Restrictions and General Class Axioms\\n:Person owl:disjointWith :Band .\\n:Band owl:disjointWith :Instrument .\\n:Album owl:disjointWith :Song .\\n:Track owl:disjointWith :Song .\\n:Critic owl:disjointWith :Band .\\n:City owl:disjointWith :Region .\\n:Region owl:disjointWith :Country .\\n\\n# Album must contain at least one track\\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :containsTrack ; owl:someValuesFrom :Track ] .\\n\"}",
