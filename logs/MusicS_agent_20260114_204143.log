        "arguments": "{\"key\":\"current_owl\",\"value\":\"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/music-production>\\n    a owl:Ontology ;\\n    rdfs:label \\\"Music Production Ontology\\\" ;\\n    rdfs:comment \\\"Ontology describing music production, band membership, albums, performances, and related entities as per the Red Hot Chili Peppers story.\\\" .\\n\\n### Classes\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual involved in music production, performance, or criticism.\\\" .\\n\\n:Band a owl:Class ;\\n    rdfs:label \\\"Band\\\" ;\\n    rdfs:comment \\\"A musical group consisting of multiple persons.\\\" .\\n\\n:Instrument a owl:Class ;\\n    rdfs:label \\\"Instrument\\\" ;\\n    rdfs:comment \\\"A musical instrument played by persons in performances or recordings.\\\" .\\n\\n:Role a owl:Class ;\\n    rdfs:label \\\"Role\\\" ;\\n    rdfs:comment \\\"A function or part played by a person in a band (e.g., vocalist, drummer).\\\" .\\n\\n:Album a owl:Class ;\\n    rdfs:label \\\"Album\\\" ;\\n    rdfs:comment \\\"A published collection of tracks recorded by a band.\\\" .\\n\\n:Track a owl:Class ;\\n    rdfs:label \\\"Track\\\" ;\\n    rdfs:comment \\\"An individual track that is part of an album and is a recording of a song.\\\" ;\\n    rdfs:subClassOf :Song .\\n\\n:Song a owl:Class ;\\n    rdfs:label \\\"Song\\\" ;\\n    rdfs:comment \\\"A musical composition, which may be recorded as a track.\\\" .\\n\\n:Critic a owl:Class ;\\n    rdfs:label \\\"Critic\\\" ;\\n    rdfs:comment \\\"A person who reviews or comments on albums.\\\" .\\n\\n:Performance a owl:Class ;\\n    rdfs:label \\\"Performance\\\" ;\\n    rdfs:comment \\\"A live event where a band performs songs at a specific location and time.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where performances take place.\\\" .\\n\\n:Region a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A geographic region containing cities.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A reification class representing a person's membership in a band, with role and time interval.\\\" .\\n\\n:AlbumRecording a owl:Class ;\\n    rdfs:label \\\"Album Recording\\\" ;\\n    rdfs:comment \\\"A reification class representing the recording of an album over a time interval.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"A reification class representing the performance of a song during a specific performance event.\\\" .\\n\\n### Object Properties\\n:playsInstrument a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Links a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :instrumentPlayedBy .\\n\\n:instrumentPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"instrument played by\\\" ;\\n    rdfs:comment \\\"Inverse property linking an instrument to the person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMember a owl:ObjectProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Relates a band to its band membership instances.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :membershipOfBand .\\n\\n:membershipOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"membership of band\\\" ;\\n    rdfs:comment \\\"Inverse property linking a band membership to the band.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMember .\\n\\n:memberPerson a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"member person\\\" ;\\n    rdfs:comment \\\"Links a band membership to the person who is a member.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :personMembership .\\n\\n:personMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"person membership\\\" ;\\n    rdfs:comment \\\"Inverse property linking a person to their band membership.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberPerson .\\n\\n:memberRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"member role\\\" ;\\n    rdfs:comment \\\"Links a band membership to the role played by the person.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleOfMembership .\\n\\n:roleOfMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role of membership\\\" ;\\n    rdfs:comment \\\"Inverse property linking a role to the band membership where it is played.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberRole .\\n\\n:recordsAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"records album\\\" ;\\n    rdfs:comment \\\"Relates a band to its album recording events.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :AlbumRecording ;\\n    owl:inverseOf :albumRecordedBy .\\n\\n:albumRecordedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"album recorded by\\\" ;\\n    rdfs:comment \\\"Inverse property linking an album recording to the band that recorded it.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :recordsAlbum .\\n\\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recorded album\\\" ;\\n    rdfs:comment \\\"Links an album recording event to the album.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumRecording .\\n\\n:albumRecording a owl:ObjectProperty ;\\n    rdfs:label \\\"album recording\\\" ;\\n    rdfs:comment \\\"Inverse property linking an album to its recording events.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :AlbumRecording ;\\n    owl:inverseOf :recordedAlbum .\\n\\n:performanceOfBand a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance of band\\\" ;\\n    rdfs:comment \\\"Links a performance event to the band performing.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :bandPerformance .\\n\\n:bandPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"band performance\\\" ;\\n    rdfs:comment \\\"Inverse property linking a band to its performances.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceOfBand .\\n\\n:performanceLocation a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"Links a performance to the city where it took place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :locationOfPerformance .\\n\\n:locationOfPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"location of performance\\\" ;\\n    rdfs:comment \\\"Inverse property linking a city to performances held there.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceLocation .\\n\\n:performanceSong a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance song\\\" ;\\n    rdfs:comment \\\"Links a performance song instance to the song performed.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songPerformance .\\n\\n:songPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"song performance\\\" ;\\n    rdfs:comment \\\"Inverse property linking a song to its performance song events.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceSong .\\n\\n:performanceEvent a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance event\\\" ;\\n    rdfs:comment \\\"Links a performance song instance to the performance event.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :eventPerformanceSong .\\n\\n:eventPerformanceSong a owl:ObjectProperty ;\\n    rdfs:label \\\"event performance song\\\" ;\\n    rdfs:comment \\\"Inverse property linking a performance to its performance song instances.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceEvent .\\n\\n:trackOfAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"track of album\\\" ;\\n    rdfs:comment \\\"Links a track to the album it is part of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumHasTrack .\\n\\n:albumHasTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"album has track\\\" ;\\n    rdfs:comment \\\"Links an album to its tracks.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOfAlbum .\\n\\n:trackIsRecordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"track is recording of\\\" ;\\n    rdfs:comment \\\"Links a track to the song it is a recording of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :recordedAsTrack .\\n\\n:recordedAsTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded as track\\\" ;\\n    rdfs:comment \\\"Inverse property linking a song to its track recordings.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackIsRecordingOf .\\n\\n:criticSaysAbout a owl:ObjectProperty ;\\n    rdfs:label \\\"critic says about\\\" ;\\n    rdfs:comment \\\"Links a critic to the album