tail\" ;\n    rdfs:comment \"Detailed information about the invoice (e.g., terms, payment information).\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:InvoiceOrganizationInvolvement a owl:Class ;\n    rdfs:label \"Invoice Organization Involvement\" ;\n    rdfs:comment \"A pivot class representing the involvement of an organization in an invoice with a specific role.\" .\n\n:InvoiceItem a owl:Class ;\n    rdfs:label \"Invoice Item\" ;\n    rdfs:comment \"A pivot class representing the sale of an item in an invoice with its net price.\" .\n\n#################################################################\n# Disjointness and DisjointUnion\n#################################################################\n:Organization owl:disjointWith :Item .\n:Role owl:disjointWith :Address .\n:Invoice owl:disjointWith :BusinessProcess .\n:BuyerRole owl:disjointWith :SellerRole .\n:Role owl:disjointUnionOf ( :BuyerRole :SellerRole ) .\n\n#################################################################\n# Object Properties (with inverses)\n#################################################################\n:hasInvoice a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Invoice ;\n    rdfs:label \"has invoice\" ;\n    rdfs:comment \"Relates an EDIFACT message to an invoice it contains.\" ;\n    owl:inverseOf :isInvoiceOf .\n\n:isInvoiceOf a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :EDIFACTMessage ;\n    rdfs:label \"is invoice of\" ;\n    rdfs:comment \"Inverse: relates an invoice to the EDIFACT message containing it.\" ;\n    owl:inverseOf :hasInvoice .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceOrganizationInvolvement ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Relates an invoice to an involvement of an organization (with a specific role).\" ;\n    owl:inverseOf :isInvolvementOfInvoice .\n\n:isInvolvementOfInvoice a owl:ObjectProperty ;\n    rdfs:domain :InvoiceOrganizationInvolvement ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is involvement of invoice\" ;\n    rdfs:comment \"Inverse: relates an InvoiceOrganizationInvolvement to its invoice.\" ;\n    owl:inverseOf :involvesOrganization .\n\n:organization a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceOrganizationInvolvement ;\n    rdfs:range :Organization ;\n    rdfs:label \"organization\" ;\n    rdfs:comment \"Relates an InvoiceOrganizationInvolvement to the involved organization.\" ;\n    owl:inverseOf :isOrganizationInvolvementOf .\n\n:isOrganizationInvolvementOf a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceOrganizationInvolvement ;\n    rdfs:label \"is organization involvement of\" ;\n    rdfs:comment \"Inverse: relates an organization to its InvoiceOrganizationInvolvement.\" ;\n    owl:inverseOf :organization .\n\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceOrganizationInvolvement ;\n    rdfs:range :Role ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Relates an InvoiceOrganizationInvolvement to the role played by the organization.\" ;\n    owl:inverseOf :isRoleInvolvementOf .\n\n:isRoleInvolvementOf a owl:ObjectProperty ;\n    rdfs:domain :Role ;\n    rdfs:range :InvoiceOrganizationInvolvement ;\n    rdfs:label \"is role involvement of\" ;\n    rdfs:comment \"Inverse: relates a Role to its InvoiceOrganizationInvolvement.\" ;\n    owl:inverseOf :hasRole .\n\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse: relates an address to its organization.\" ;\n    owl:inverseOf :hasAddress .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceItem ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Relates an invoice to an item entry (with price, quantity, etc.).\" ;\n    owl:inverseOf :isItemOf .\n\n:isItemOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceItem ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is item of\" ;\n    rdfs:comment \"Inverse: relates an InvoiceItem to its invoice.\" ;\n    owl:inverseOf :hasItem .\n\n:item a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceItem ;\n    rdfs:range :Item ;\n    rdfs:label \"item\" ;\n    rdfs:comment \"Relates an InvoiceItem to the item being sold.\" ;\n    owl:inverseOf :isInvoiceEntryOf .\n\n:isInvoiceEntryOf a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :InvoiceItem ;\n    rdfs:label \"is invoice entry of\" ;\n    rdfs:comment \"Inverse: relates an Item to its InvoiceItem entry.\" ;\n    owl:inverseOf :item .\n\n:hasInvoiceDetail a owl:ObjectProperty , owl:FunctionalProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail ;\n    rdfs:label \"has invoice detail\" ;\n    rdfs:comment \"Relates an invoice to its detail information.\" ;\n    owl:inverseOf :isInvoiceDetailOf .\n\n:isInvoiceDetailOf a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :Invoice ;\n    rdfs:label \"is invoice detail of\" ;\n    rdfs:comment \"Inverse: relates InvoiceDetail to its invoice.\" ;\n    owl:inverseOf :hasInvoiceDetail .\n\n:assignedToBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to business process\" ;\n    rdfs:comment \"Assigns an invoice to a business process.\" ;\n    owl:inverseOf :hasAssignedInvoice .\n\n:hasAssignedInvoice a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :Invoice ;\n    rdfs:label \"has assigned invoice\" ;\n    rdfs:comment \"Inverse: relates a business process to its assigned invoice.\" ;\n    owl:inverseOf :assignedToBusinessProcess .\n\n#################################################################\n# Data Properties\n#################################################################\n:netPrice a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"The net price of an item in an invoice.\" .\n\n:invoiceAmount a owl:DatatypeProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" .\n\n:invoiceNumber a owl:DatatypeProperty ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The unique number identifying the invoice.\" .\n\n:organizationName a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"The name of the organization.\" .\n\n:addressLine a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The address line of an organization.\" .\n\n:itemDescription a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"The description of an item.\" .\n\n:detailDescription a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range xsd:string ;\n    rdfs:label \"detail description\" ;\n    rdfs:comment \"The description of invoice details (terms, payment, etc.).\" .\n\n#################################################################\n# General Class Axioms & Restrictions\n#################################################################\n[ rdf:type owl:Restriction ;\n  owl:onProperty :hasRole ;\n  owl:someValuesFrom :BuyerRole ;\n  rdfs:subClassOf :InvoiceOrganizationInvolvement\n] .\n",
