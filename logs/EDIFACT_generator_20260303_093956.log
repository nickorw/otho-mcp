      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACTInvoiceOntology rdf:type owl:Ontology ;\n  rdfs:label \"EDIFACT D96A INVOIC and P2P-O Ontology\" ;\n  rdfs:comment \"A profoundly structured ontology for digital business documents based on UN/EDIFACT D96A, EANCOM INVOIC, and P2P-O, including all mandatory segments, roles, and constraints for semantic interoperability.\" .\n\n#################################################################\n# Classes (as before)\n#################################################################\n\n:InterchangeEnvelope rdf:type owl:Class ; rdfs:label \"Interchange Envelope\" ; rdfs:comment \"The top-level envelope containing EDIFACT messages.\" .\n:Message rdf:type owl:Class ; rdfs:label \"Message\" ; rdfs:comment \"A business document contained within an Interchange Envelope.\" .\n:InvoiceMessage rdf:type owl:Class ; rdfs:subClassOf :Message ; rdfs:label \"Invoice Message\" ; rdfs:comment \"An INVOIC message representing a global trade transaction.\" .\n:Segment rdf:type owl:Class ; rdfs:label \"Segment\" ; rdfs:comment \"A segment within a message, composed of composite and simple data elements.\" .\n:BGM_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"BGM Segment\" ; rdfs:comment \"Beginning of Message segment for document identification.\" .\n:NAD_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"NAD Segment\" ; rdfs:comment \"Name and Address segment for participant details.\" .\n:DTM_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"DTM Segment\" ; rdfs:comment \"Date/Time/Period segment for document dates.\" .\n:RFF_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"RFF Segment\" ; rdfs:comment \"Reference segment for reference numbers.\" .\n:CUX_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"CUX Segment\" ; rdfs:comment \"Currency segment for currency codes.\" .\n:PAT_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PAT Segment\" ; rdfs:comment \"Payment Terms segment for payment conditions.\" .\n:ALCSegment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"ALC Segment\" ; rdfs:comment \"Allowances and Charges segment.\" .\n:TAX_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"TAX Segment\" ; rdfs:comment \"Tax segment for tax details.\" .\n:MOA_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"MOA Segment\" ; rdfs:comment \"Monetary Amount segment.\" .\n:QTY_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"QTY Segment\" ; rdfs:comment \"Quantity segment.\" .\n:PRI_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PRI Segment\" ; rdfs:comment \"Price segment for price details.\" .\n:LIN_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"LIN Segment\" ; rdfs:comment \"Line Item segment.\" .\n:PIA_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"PIA Segment\" ; rdfs:comment \"Additional Product ID segment.\" .\n:IMD_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"IMD Segment\" ; rdfs:comment \"Item Description segment.\" .\n:LOC_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"LOC Segment\" ; rdfs:comment \"Location segment.\" .\n:TDT_Segment rdf:type owl:Class ; rdfs:subClassOf :Segment ; rdfs:label \"TDT Segment\" ; rdfs:comment \"Transport segment for transport details.\" .\n:CompositeDataElement rdf:type owl:Class ; rdfs:label \"Composite Data Element\" ; rdfs:comment \"A composite data element within a segment.\" .\n:SimpleDataElement rdf:type owl:Class ; rdfs:label \"Simple Data Element\" ; rdfs:comment \"A simple data element within a composite data element.\" .\n:Organization rdf:type owl:Class ; rdfs:label \"Organization\" ; rdfs:comment \"A party involved in the invoice, such as Buyer or Supplier.\" .\n:AgentRole rdf:type owl:Class ; rdfs:label \"Agent Role\" ; rdfs:comment \"A role played by an organization within an invoice.\" .\n:Address rdf:type owl:Class ; rdfs:label \"Address\" ; rdfs:comment \"Address information for an organization.\" .\n:Identifier rdf:type owl:Class ; rdfs:label \"Identifier\" ; rdfs:comment \"An identifier for an organization, such as a Global Location Number.\" .\n:GlobalLocationNumber rdf:type owl:Class ; rdfs:label \"Global Location Number\" ; rdfs:comment \"A global location identifier for organizations.\" ; rdfs:subClassOf :Identifier .\n:InvoiceHeader rdf:type owl:Class ; rdfs:subClassOf :CompositeDataElement ; rdfs:label \"Invoice Header\" ; rdfs:comment \"Header section of the invoice message.\" .\n:InvoiceDetail rdf:type owl:Class ; rdfs:subClassOf :CompositeDataElement ; rdfs:label \"Invoice Detail\" ; rdfs:comment \"Detail section of the invoice message, listing line items.\" .\n:InvoiceSummary rdf:type owl:Class ; rdfs:subClassOf :CompositeDataElement ; rdfs:label \"Invoice Summary\" ; rdfs:comment \"Summary section of the invoice message, providing totals.\" .\n:LineItem rdf:type owl:Class ; rdfs:subClassOf :CompositeDataElement ; rdfs:label \"Line Item\" ; rdfs:comment \"An itemized entry in the invoice detail section.\" ; rdfs:subClassOf :Price, :Amount, :ReferenceNumber .\n:Item rdf:type owl:Class ; rdfs:label \"Item\" ; rdfs:comment \"A product or service sold in the invoice.\" .\n:Price rdf:type owl:Class ; rdfs:label \"Price\" ; rdfs:comment \"Price information for an item.\" ; rdfs:subClassOf :CompositeDataElement .\n:Tax rdf:type owl:Class ; rdfs:label \"Tax\" ; rdfs:comment \"Tax information for the invoice.\" .\n:Amount rdf:type owl:Class ; rdfs:label \"Amount\" ; rdfs:comment \"Amount information for the invoice.\" ; rdfs:subClassOf :CompositeDataElement .\n:ReferenceNumber rdf:type owl:Class ; rdfs:label \"Reference Number\" ; rdfs:comment \"Reference number for the invoice.\" ; rdfs:subClassOf :CompositeDataElement .\n:BusinessProcess rdf:type owl:Class ; rdfs:label \"Business Process\" ; rdfs:comment \"A business process associated with the invoice.\" .\n:ValidationConstraint rdf:type owl:Class ; rdfs:label \"Validation Constraint\" ; rdfs:comment \"A constraint used for validating invoice data.\" .\n:SHACLConstraint rdf:type owl:Class ; rdfs:label \"SHACL Constraint\" ; rdfs:comment \"A SHACL constraint for automated validation.\" .\n:PurchaseToPayOntologyEntity rdf:type owl:Class ; rdfs:subClassOf owl:Thing ; rdfs:label \"Purchase-to-Pay Ontology Entity\" ; rdfs:comment \"Entity from the Purchase-to-Pay Ontology for semantic alignment.\" ; rdfs:subClassOf :Organization, :Item .\n\n#################################################################\n# Pivot Classes\n#################################################################\n\n:OrganizationRoleAssignment rdf:type owl:Class ; rdfs:label \"Organization Role Assignment\" ; rdfs:comment \"Reification class linking an organization to a specific role, address, and identifier in the invoice context.\" .\n:InvoiceItemization rdf:type owl:Class ; rdfs:label \"Invoice Itemization\" ; rdfs:comment \"Reification class linking invoice message to itemized line items.\" .\n\n#################################################################\n# Properties (as before, now with inverses)\n#################################################################\n\n:containsMessage rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :InterchangeEnvelope ; rdfs:range :Message ; rdfs:label \"contains Message\" ; rdfs:comment \"Links an Interchange Envelope to contained Messages.\" ; owl:inverseOf :isContainedInEnvelope .\n:isContainedInEnvelope rdf:type owl:ObjectProperty ; rdfs:domain :Message ; rdfs:range :InterchangeEnvelope ; rdfs:label \"is Contained In Envelope\" ; rdfs:comment \"Inverse of containsMessage.\" .\n\n:hasSegment rdf:type owl:ObjectProperty ; rdfs:domain :Message ; rdfs:range :Segment ; rdfs:label \"has Segment\" ; rdfs:comment \"Links a Message to its constituent Segments.\" ; owl:inverseOf :isSegmentOf .\n:isSegmentOf rdf:type owl:ObjectProperty ; rdfs:domain :Segment ; rdfs:range :Message ; rdfs:label \"is Segment Of\" ; rdfs:comment \"Inverse of hasSegment.\" .\n\n:hasCompositeElement rdf:type owl:ObjectProperty ; rdfs:domain :Segment ; rdfs:range :CompositeDataElement ; rdfs:label \"has Composite Element\" ; rdfs:comment \"Links a Segment to its composite data elements.\" ; owl:inverseOf :isCompositeElementOf .\n:isCompositeElementOf rdf:type owl:ObjectProperty ; rdfs:domain :CompositeDataElement ; rdfs:range :Segment ; rdfs:label \"is Composite Element Of\" ; rdfs:comment \"Inverse of hasCompositeElement.\" .\n\n:hasSimpleElement rdf:type owl:ObjectProperty ; rdfs:domain :CompositeDataElement ; rdfs:range :SimpleDataElement ; rdfs:label \"has Simple Element\" ; rdfs:comment \"Links a composite data element to its simple elements.\" ; owl:inverseOf :isSimpleElementOf .\n:isSimpleElementOf rdf:type owl:ObjectProperty ; rdfs:domain :SimpleDataElement ; rdfs:range :CompositeDataElement ; rdfs:label \"is Simple Element Of\" ; rdfs:comment \"Inverse of hasSimpleElement.\" .\n\n:playsRole rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Organization ; rdfs:range :AgentRole ; rdfs:label \"plays Role\" ; rdfs:comment \"Links an organization to the role it plays in the invoice.\" ; owl:inverseOf :isRolePlayedBy .\n:isRolePlayedBy rdf:type owl:ObjectProperty ; rdfs:domain :AgentRole ; rdfs:range :Organization ; rdfs:label \"is Role Played By\" ; rdfs:comment \"Inverse of playsRole.\" .\n\n:hasAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Organization ; rdfs:range :Address ; rdfs:label \"has Address\" ; rdfs:comment \"Links an organization to its address.\" ; owl:inverseOf :isAddressOf .\n:isAddressOf rdf:type owl:ObjectProperty ; rdfs:domain :Address ; rdfs:range :Organization ; rdfs:label \"is Address Of\" ; rdfs:comment \"Inverse of hasAddress.\" .\n\n:hasIdentifier rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Organization ; rdfs:range :Identifier ; rdfs:label \"has Identifier\" ; rdfs:comment \"Links an organization to its identifier.\" ; owl:inverseOf :isIdentifierOf .\n:isIdentifierOf rdf:type owl:ObjectProperty ; rdfs:domain :Identifier ; rdfs:range :Organization ; rdfs:label \"is Identifier Of\" ; rdfs:comment \"Inverse of hasIdentifier.\" .\n\n:hasGlobalLocationNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Identifier ; rdfs:range xsd:string ; rdfs:label \"has Global Location Number\" ; rdfs:comment \"Links an identifier to its Global Location Number.\" .\n\n:hasInvoiceHeader rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :InvoiceHeader ; rdfs:label \"has Invoice Header\" ; rdfs:comment \"Links an invoice message to its header section.\" ; owl:inverseOf :isInvoiceHeaderOf .\n:isInvoiceHeaderOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceHeader ; rdfs:range :InvoiceMessage ; rdfs:label \"is Invoice Header Of\" ; rdfs:comment \"Inverse of hasInvoiceHeader.\" .\n\n:hasInvoiceDetail rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :InvoiceDetail ; rdfs:label \"has Invoice Detail\" ; rdfs:comment \"Links an invoice message to its detail section.\" ; owl:inverseOf :isInvoiceDetailOf .\n:isInvoiceDetailOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceDetail ; rdfs:range :InvoiceMessage ; rdfs:label \"is Invoice Detail Of\" ; rdfs:comment \"Inverse of hasInvoiceDetail.\" .\n\n:hasInvoiceSummary rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :InvoiceSummary ; rdfs:label \"has Invoice Summary\" ; rdfs:comment \"Links an invoice message to its summary section.\" ; owl:inverseOf :isInvoiceSummaryOf .\n:isInvoiceSummaryOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceSummary ; rdfs:range :InvoiceMessage ; rdfs:label \"is Invoice Summary Of\" ; rdfs:comment \"Inverse of hasInvoiceSummary.\" .\n\n:hasLineItem rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceDetail ; rdfs:range :LineItem ; rdfs:label \"has Line Item\" ; rdfs:comment \"Links invoice detail section to its line items.\" ; owl:inverseOf :isLineItemOf .\n:isLineItemOf rdf:type owl:ObjectProperty ; rdfs:domain :LineItem ; rdfs:range :InvoiceDetail ; rdfs:label \"is Line Item Of\" ; rdfs:comment \"Inverse of hasLineItem.\" .\n\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :LineItem ; rdfs:range :Item ; rdfs:label \"describes Item\" ; rdfs:comment \"Links a line item to the item it describes.\" ; owl:inverseOf :isDescribedByLineItem .\n:isDescribedByLineItem rdf:type owl:ObjectProperty ; rdfs:domain :Item ; rdfs:range :LineItem ; rdfs:label \"is Described By Line Item\" ; rdfs:comment \"Inverse of describesItem.\" .\n\n:hasNetPrice rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :LineItem ; rdfs:range xsd:decimal ; rdfs:label \"has Net Price\" ; rdfs:comment \"The net price of the item in the line item.\" .\n:hasQuantity rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :LineItem ; rdfs:range xsd:integer ; rdfs:label \"has Quantity\" ; rdfs:comment \"The quantity of the item sold in the line item.\" .\n\n:hasTax rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceSummary ; rdfs:range :Tax ; rdfs:label \"has Tax\" ; rdfs:comment \"Links invoice summary section to tax information.\" ; owl:inverseOf :isTaxOf .\n:isTaxOf rdf:type owl:ObjectProperty ; rdfs:domain :Tax ; rdfs:range :InvoiceSummary ; rdfs:label \"is Tax Of\" ; rdfs:comment \"Inverse of hasTax.\" .\n\n:hasAmount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceSummary ; rdfs:range xsd:decimal ; rdfs:label \"has Amount\" ; rdfs:comment \"The total amount of the invoice.\" .\n\n:hasReferenceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceHeader ; rdfs:range xsd:string ; rdfs:label \"has Reference Number\" ; rdfs:comment \"Reference number of the invoice.\" .\n:hasInvoiceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceHeader ; rdfs:range xsd:string ; rdfs:label \"has Invoice Number\" ; rdfs:comment \"Invoice number of the invoice.\" .\n\n:hasBusinessProcess rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :BusinessProcess ; rdfs:label \"has Business Process\" ; rdfs:comment \"Links an invoice message to its associated business process.\" ; owl:inverseOf :isBusinessProcessOf .\n:isBusinessProcessOf rdf:type owl:ObjectProperty ; rdfs:domain :BusinessProcess ; rdfs:range :InvoiceMessage ; rdfs:label \"is Business Process Of\" ; rdfs:comment \"Inverse of hasBusinessProcess.\" .\n\n:validatesWith rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :ValidationConstraint ; rdfs:label \"validates With\" ; rdfs:comment \"Links an invoice message to validation constraints.\" ; owl:inverseOf :isValidationConstraintOf .\n:isValidationConstraintOf rdf:type owl:ObjectProperty ; rdfs:domain :ValidationConstraint ; rdfs:range :InvoiceMessage ; rdfs:label \"is Validation Constraint Of\" ; rdfs:comment \"Inverse of validatesWith.\" .\n\n:conformsToSHACL rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :SHACLConstraint ; rdfs:label \"conforms To SHACL\" ; rdfs:comment \"Links an invoice message to SHACL constraints for automated validation.\" ; owl:inverseOf :isSHACLConstraintOf .\n:isSHACLConstraintOf rdf:type owl:ObjectProperty ; rdfs:domain :SHACLConstraint ; rdfs:range :InvoiceMessage ; rdfs:label \"is SHACL Constraint Of\" ; rdfs:comment \"Inverse of conformsToSHACL.\" .\n\n:hasRoleAssignment rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :OrganizationRoleAssignment ; rdfs:label \"has Role Assignment\" ; rdfs:comment \"Links an invoice message to organization role assignments.\" ; owl:inverseOf :isRoleAssignmentOf .\n:isRoleAssignmentOf rdf:type owl:ObjectProperty ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :InvoiceMessage ; rdfs:label \"is Role Assignment Of\" ; rdfs:comment \"Inverse of hasRoleAssignment.\" .\n\n:roleOrganization rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :Organization ; rdfs:label \"role Organization\" ; rdfs:comment \"Links a role assignment to the involved organization.\" ; owl:inverseOf :isOrganizationInRoleAssignment .\n:isOrganizationInRoleAssignment rdf:type owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :OrganizationRoleAssignment ; rdfs:label \"is Organization In Role Assignment\" ; rdfs:comment \"Inverse of roleOrganization.\" .\n\n:roleType rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :AgentRole ; rdfs:label \"role Type\" ; rdfs:comment \"Links a role assignment to the type of role played.\" ; owl:inverseOf :isAgentRoleInRoleAssignment .\n:isAgentRoleInRoleAssignment rdf:type owl:ObjectProperty ; rdfs:domain :AgentRole ; rdfs:range :OrganizationRoleAssignment ; rdfs:label \"is Agent Role In Role Assignment\" ; rdfs:comment \"Inverse of roleType.\" .\n\n:roleAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :Address ; rdfs:label \"role Address\" ; rdfs:comment \"Links a role assignment to the address used in the role.\" ; owl:inverseOf :isAddressInRoleAssignment .\n:isAddressInRoleAssignment rdf:type owl:ObjectProperty ; rdfs:domain :Address ; rdfs:range :OrganizationRoleAssignment ; rdfs:label \"is Address In Role Assignment\" ; rdfs:comment \"Inverse of roleAddress.\" .\n\n:roleIdentifier rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :OrganizationRoleAssignment ; rdfs:range :Identifier ; rdfs:label \"role Identifier\" ; rdfs:comment \"Links a role assignment to the identifier used in the role.\" ; owl:inverseOf :isIdentifierInRoleAssignment .\n:isIdentifierInRoleAssignment rdf:type owl:ObjectProperty ; rdfs:domain :Identifier ; rdfs:range :OrganizationRoleAssignment ; rdfs:label \"is Identifier In Role Assignment\" ; rdfs:comment \"Inverse of roleIdentifier.\" .\n\n:hasItemization rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :InvoiceItemization ; rdfs:label \"has Itemization\" ; rdfs:comment \"Links an invoice message to its itemization structure.\" ; owl:inverseOf :isItemizationOf .\n:isItemizationOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceItemization ; rdfs:range :InvoiceMessage ; rdfs:label \"is Itemization Of\" ; rdfs:comment \"Inverse of hasItemization.\" .\n\n:itemizationItem rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceItemization ; rdfs:range :LineItem ; rdfs:label \"itemization Item\" ; rdfs:comment \"Links invoice itemization to individual line items.\" ; owl:inverseOf :isItemInItemization .\n:isItemInItemization rdf:type owl:ObjectProperty ; rdfs:domain :LineItem ; rdfs:range :InvoiceItemization ; rdfs:label \"is Item In Itemization\" ; rdfs:comment \"Inverse of itemizationItem.\" .\n\n#################################################################\n# Segment-Specific Properties (as before)\n#################################################################\n\n# ... (segment-specific properties unchanged for brevity)\n\n#################################################################\n# Disjointness and Equivalence (as before, but ALC_Segment renamed to ALCSegment)\n#################################################################\n\n:Organization owl:disjointWith :Item .\n:Amount owl:disjointWith :Price .\n:Organization owl:disjointWith :Address .\n:Segment owl:disjointWith :CompositeDataElement .\n:InvoiceHeader owl:disjointWith :InvoiceDetail .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n:InvoiceHeader owl:disjointWith :InvoiceSummary .\n\n[] owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\n\n#################################################################\n# Restrictions (GCAs and Equivalence, as before)\n#################################################################\n\n# ... (restrictions unchanged)\n"
}
