 :InvoiceMessage ; rdfs:range :InvoiceDetail ; rdfs:label \\\"has Invoice Detail\\\" ; rdfs:comment \\\"Links an invoice message to its detail section.\\\" ; owl:inverseOf :isInvoiceDetailOf .\\n:isInvoiceDetailOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceDetail ; rdfs:range :InvoiceMessage ; rdfs:label \\\"is Invoice Detail Of\\\" ; rdfs:comment \\\"Inverse of hasInvoiceDetail.\\\" .\\n\\n:hasInvoiceSummary rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :InvoiceMessage ; rdfs:range :InvoiceSummary ; rdfs:label \\\"has Invoice Summary\\\" ; rdfs:comment \\\"Links an invoice message to its summary section.\\\" ; owl:inverseOf :isInvoiceSummaryOf .\\n:isInvoiceSummaryOf rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceSummary ; rdfs:range :InvoiceMessage ; rdfs:label \\\"is Invoice Summary Of\\\" ; rdfs:comment \\\"Inverse of hasInvoiceSummary.\\\" .\\n\\n:hasLineItem rdf:type owl:ObjectProperty ; rdfs:domain :InvoiceDetail ; rdfs:range :LineItem ; rdfs:label \\\"has Line Item\\\" ; rdfs:comment \\\"Links invoice detail section to its line items.\\\" ; owl:inverseOf :isLineItemOf .\\n:isLineItemOf rdf:type owl:ObjectProperty ; rdfs:domain :LineItem ; rdfs:range :InvoiceDetail ; rdfs:label \\\"is Line Item Of\\\" ; rdfs:comment \\\"Inverse of hasLineItem.\\\" .\\n\\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :LineItem ; rdfs:range :Item ; rdfs:label \\\"describes Item\\\" ; rdfs:comment \\\"Links a line item to the item it describes.\\\" ; owl:inverseOf :isDescribedByLineItem .\\n:isDescribedByLineItem rdf:type owl:ObjectProperty ; rdfs:domain :Item ; rdfs:range :LineItem ; rdfs:label \\\"is Described By Line Item\\\" ; rdfs:comment \\\"Inverse of describesItem.\\\" .\\n\\n:hasNetPrice rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :LineItem ; rdfs:range xsd:decimal ; rdfs:label \\\"has Net Price\\\" ; rdfs:comment \\\"The net price of the item in the line item.\\\" .\\n:hasQuanti