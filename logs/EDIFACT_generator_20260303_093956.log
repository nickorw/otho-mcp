      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n:EDIFACTInvoiceOntology rdf:type owl:Ontology ;\\n  rdfs:label \\\"EDIFACT D96A INVOIC and P2P-O Ontology\\\" ;\\n  rdfs:comment \\\"A profoundly structured ontology for digital business documents based on UN/EDIFACT D96A, EANCOM INVOIC, and P2P-O, including all mandatory segments, roles, and constraints for semantic interoperability.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope rdf:type owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"The top-level envelope containing EDIFACT messages.\\\" .\\n\\n:Message rdf:type owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A business document contained within an Interchange Envelope.\\\" .\\n\\n:InvoiceMessage rdf:type owl:Class ;\\n  rdfs:subClassOf :Message ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An INVOIC message representing a global trade transaction.\\\" .\\n\\n:Segment rdf:type owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within a message, composed of composite and simple data elements.\\\" .\\n\\n:BGM_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n\\n:NAD_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n\\n:DTM_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"DTM Segment\\\" ;\\n  rdfs:comment \\\"Date/Time/Period segment for document dates.\\\" .\\n\\n:RFF_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"RFF Segment\\\" ;\\n  rdfs:comment \\\"Reference segment for reference numbers.\\\" .\\n\\n:CUX_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"CUX Segment\\\" ;\\n  rdfs:comment \\\"Currency segment for currency codes.\\\" .\\n\\n:PAT_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PAT Segment\\\" ;\\n  rdfs:comment \\\"Payment Terms segment for payment conditions.\\\" .\\n\\n:ALC_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"ALC Segment\\\" ;\\n  rdfs:comment \\\"Allowances and Charges segment.\\\" .\\n\\n:TAX_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"TAX Segment\\\" ;\\n  rdfs:comment \\\"Tax segment for tax details.\\\" .\\n\\n:MOA_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"MOA Segment\\\" ;\\n  rdfs:comment \\\"Monetary Amount segment.\\\" .\\n\\n:QTY_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"QTY Segment\\\" ;\\n  rdfs:comment \\\"Quantity segment.\\\" .\\n\\n:PRI_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PRI Segment\\\" ;\\n  rdfs:comment \\\"Price segment for price details.\\\" .\\n\\n:LIN_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"LIN Segment\\\" ;\\n  rdfs:comment \\\"Line Item segment.\\\" .\\n\\n:PIA_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PIA Segment\\\" ;\\n  rdfs:comment \\\"Additional Product ID segment.\\\" .\\n\\n:IMD_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"IMD Segment\\\" ;\\n  rdfs:comment \\\"Item Description segment.\\\" .\\n\\n:LOC_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"LOC Segment\\\" ;\\n  rdfs:comment \\\"Location segment.\\\" .\\n\\n:TDT_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"TDT Segment\\\" ;\\n  rdfs:comment \\\"Transport segment for transport details.\\\" .\\n\\n:CompositeDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:Organization rdf:type owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"A party involved in the invoice, such as Buyer or Supplier.\\\" .\\n\\n:AgentRole rdf:type owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization within an invoice.\\\" .\\n\\n:Address rdf:type owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"Address information for an organization.\\\" .\\n\\n:Identifier rdf:type owl:Class ;\\n  rdfs:label \\\"Identifier\\\" ;\\n  rdfs:comment \\\"An identifier for an organization, such as a Global Location Number.\\\" .\\n\\n:GlobalLocationNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A global location identifier for organizations.\\\" .\\n\\n:InvoiceHeader rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Invoice Header\\\" ;\\n  rdfs:comment \\\"Header section of the invoice message.\\\" .\\n\\n:InvoiceDetail rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Invoice Detail\\\" ;\\n  rdfs:comment \\\"Detail section of the invoice message, listing line items.\\\" .\\n\\n:InvoiceSummary rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Invoice Summary\\\" ;\\n  rdfs:comment \\\"Summary section of the invoice message, providing totals.\\\" .\\n\\n:LineItem rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Line Item\\\" ;\\n  rdfs:comment \\\"An itemized entry in the invoice detail section.\\\" .\\n\\n:Item rdf:type owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"A product or service sold in the invoice.\\\" .\\n\\n:Price rdf:type owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"Price information for an item.\\\" .\\n\\n:Tax rdf:type owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"Tax information for the invoice.\\\" .\\n\\n:Amount rdf:type owl:Class ;\\n  rdfs:label \\\"Amount\\\" ;\\n  rdfs:comment \\\"Amount information for the invoice.\\\" .\\n\\n:ReferenceNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number for the invoice.\\\" .\\n\\n:BusinessProcess rdf:type owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"A business process associated with the invoice.\\\" .\\n\\n:ValidationConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"A constraint used for validating invoice data.\\\" .\\n\\n:SHACLConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"SHACL Constraint\\\" ;\\n  rdfs:comment \\\"A SHACL constraint for automated validation.\\\" .\\n\\n:PurchaseToPayOntologyEntity rdf:type owl:Class ;\\n  rdfs:subClassOf owl:Thing ;\\n  rdfs:label \\\"Purchase-to-Pay Ontology Entity\\\" ;\\n  rdfs:comment \\\"Entity from the Purchase-to-Pay Ontology for semantic alignment.\\\" .\\n\\n#################################################################\\n# Pivot Classes\\n#################################################################\\n\\n:OrganizationRoleAssignment rdf:type owl:Class ;\\n  rdfs:label \\\"Organization Role Assignment\\\" ;\\n  rdfs:comment \\\"Reification class linking an organization to a specific role, address, and identifier in the invoice context.\\\" .\\n\\n:InvoiceItemization rdf:type owl:Class ;\\n  rdfs:label \\\"Invoice Itemization\\\" ;\\n  rdfs:comment \\\"Reification class linking invoice message to itemized line items.\\\" .\\n\\n#################################################################\\n# Properties\\n#################################################################\\n\\n:containsMessage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains Message\\\" ;\\n  rdfs:comment \\\"Links an Interchange Envelope to contained Messages.\\\" .\\n\\n:hasSegment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has Segment\\\" ;\\n  rdfs:comment \\\"Links a Message to its constituent Segments.\\\" .\\n\\n:hasCompositeElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has Composite Element\\\" ;\\n  rdfs:comment \\\"Links a Segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has Simple Element\\\" ;\\n  rdfs:comment \\\"Links a composite data element to its simple elements.\\\" .\\n\\n:playsRole rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"plays Role\\\" ;\\n  rdfs:comment \\\"Links an organization to the role it plays in the invoice.\\\" .\\n\\n:hasAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has Address\\\" ;\\n  rdfs:comment \\\"Links an organization to its address.\\\" .\\n\\n:hasIdentifier rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"has Identifier\\\" ;\\n  rdfs:comment \\\"Links an organization to its identifier.\\\" .\\n\\n:hasGlobalLocationNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Global Location Number\\\" ;\\n  rdfs:comment \\\"Links an identifier to its Global Location Number.\\\" .\\n\\n:hasInvoiceHeader rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceHeader ;\\n  rdfs:label \\\"has Invoice Header\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its header section.\\\" .\\n\\n:hasInvoiceDetail rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceDetail ;\\n  rdfs:label \\\"has Invoice Detail\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its detail section.\\\" .\\n\\n:hasInvoiceSummary rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceSummary ;\\n  rdfs:label \\\"has Invoice Summary\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its summary section.\\\" .\\n\\n:hasLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceDetail ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"has Line Item\\\" ;\\n  rdfs:comment \\\"Links invoice detail section to its line items.\\\" .\\n\\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"describes Item\\\" ;\\n  rdfs:comment \\\"Links a line item to the item it describes.\\\" .\\n\\n:hasNetPrice rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"has Net Price\\\" ;\\n  rdfs:comment \\\"The net price of the item in the line item.\\\" .\\n\\n:hasQuantity rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range xsd:integer ;\\n  rdfs:label \\\"has Quantity\\\" ;\\n  rdfs:comment \\\"The quantity of the item sold in the line item.\\\" .\\n\\n:hasTax rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceSummary ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"has Tax\\\" ;\\n  rdfs:comment \\\"Links invoice summary section to tax information.\\\" .\\n\\n:hasAmount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceSummary ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"has Amount\\\" ;\\n  rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:hasReferenceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceHeader ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number of the invoice.\\\" .\\n\\n:hasInvoiceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceHeader ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Invoice Number\\\" ;\\n  rdfs:comment \\\"Invoice number of the invoice.\\\" .\\n\\n:hasBusinessProcess rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"has Business Process\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its associated business process.\\\" .\\n\\n:validatesWith rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint ;\\n  rdfs:label \\\"validates With\\\" ;\\n  rdfs:comment \\\"Links an invoice message to validation constraints.\\\" .\\n\\n:conformsToSHACL rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :SHACLConstraint ;\\n  rdfs:label \\\"conforms To SHACL\\\" ;\\n  rdfs:comment \\\"Links an invoice message to SHACL constraints for automated validation.\\\" .\\n\\n#################################################################\\n# Pivot Class Properties\\n#################################################################\\n\\n:hasRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :OrganizationRoleAssignment ;\\n  rdfs:label \\\"has Role Assignment\\\" ;\\n  rdfs:comment \\\"Links an invoice message to organization role assignments.\\\" .\\n\\n:roleOrganization rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"role Organization\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the involved organization.\\\" .\\n\\n:roleType rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"role Type\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the type of role played.\\\" .\\n\\n:roleAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"role Address\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the address used in the role.\\\" .\\n\\n:roleIdentifier rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"role Identifier\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the identifier used in the role.\\\" .\\n\\n:hasItemization rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceItemization ;\\n  rdfs:label \\\"has Itemization\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its itemization structure.\\\" .\\n\\n:itemizationItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceItemization ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"itemization Item\\\" ;\\n  rdfs:comment \\\"Links invoice itemization to individual line items.\\\" .\\n\\n#################################################################\\n# Segment-Specific Properties\\n#################################################################\\n\\n:dtmDateType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :DTM_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"DTM Date Type\\\" ;\\n  rdfs:comment \\\"The type of date in the DTM segment (e.g., invoice date, delivery date).\\\" .\\n\\n:dtmDateValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :DTM_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"DTM Date Value\\\" ;\\n  rdfs:comment \\\"The value of the date in the DTM segment.\\\" .\\n\\n:rffReferenceType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RFF_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"RFF Reference Type\\\" ;\\n  rdfs:comment \\\"The type of reference in the RFF segment.\\\" .\\n\\n:rffReferenceValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RFF_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"RFF Reference Value\\\" ;\\n  rdfs:comment \\\"The value of the reference in the RFF segment.\\\" .\\n\\n:cuxCurrencyCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :CUX_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"CUX Currency Code\\\" ;\\n  rdfs:comment \\\"The currency code in the CUX segment.\\\" .\\n\\n:patPaymentTerms rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PAT_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"PAT Payment Terms\\\" ;\\n  rdfs:comment \\\"Payment terms in the PAT segment.\\\" .\\n\\n:alcAllowanceType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :ALC_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"ALC Allowance Type\\\" ;\\n  rdfs:comment \\\"Allowance type in the ALC segment.\\\" .\\n\\n:taxTaxType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :TAX_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"TAX Tax Type\\\" ;\\n  rdfs:comment \\\"Tax type in the TAX segment.\\\" .\\n\\n:moaAmountType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :MOA_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"MOA Amount Type\\\" ;\\n  rdfs:comment \\\"Amount type in the MOA segment.\\\" .\\n\\n:moaAmountValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :MOA_Segment ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"MOA Amount Value\\\" ;\\n  rdfs:comment \\\"Amount value in the MOA segment.\\\" .\\n\\n:qtyQuantityType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :QTY_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"QTY Quantity Type\\\" ;\\n  rdfs:comment \\\"Quantity type in the QTY segment.\\\" .\\n\\n:qtyQuantityValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :QTY_Segment ;\\n  rdfs:range xsd:integer ;\\n  rdfs:label \\\"QTY Quantity Value\\\" ;\\n  rdfs:comment \\\"Quantity value in the QTY segment.\\\" .\\n\\n:priPriceType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PRI_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"PRI Price Type\\\" ;\\n  rdfs:comment \\\"Price type in the PRI segment.\\\" .\\n\\n:priPriceValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PRI_Segment ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"PRI Price Value\\\" ;\\n  rdfs:comment \\\"Price value in the PRI segment.\\\" .\\n\\n:linLineItemNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LIN_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"LIN Line Item Number\\\" ;\\n  rdfs:comment \\\"Line item number in the LIN segment.\\\" .\\n\\n:piaAdditionalProductId rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PIA_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"PIA Additional Product ID\\\" ;\\n  rdfs:comment \\\"Additional product ID in the PIA segment.\\\" .\\n\\n:imdItemDescription rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :IMD_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"IMD Item Description\\\" ;\\n  rdfs:comment \\\"Item description in the IMD segment.\\\" .\\n\\n:locLocationType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LOC_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"LOC Location Type\\\" ;\\n  rdfs:comment \\\"Location type in the LOC segment.\\\" .\\n\\n:tdtTransportType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :TDT_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"TDT Transport Type\\\" ;\\n  rdfs:comment \\\"Transport type in the TDT segment.\\\" .\\n\\n#################################################################\\n# Disjointness and Equivalence\\n#################################################################\\n\\n:Organization owl:disjointWith :Item .\\n:Amount owl:disjointWith :Price .\\n:Organization owl:disjointWith :Address .\\n:Segment owl:disjointWith :CompositeDataElement .\\n:InvoiceHeader owl:disjointWith :InvoiceDetail .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n:InvoiceHeader owl:disjointWith :InvoiceSummary .\\n\\n[] owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\\n\\n#################################################################\\n# Restrictions (GCAs and Equivalence)\\n#################################################################\\n\\n:InvoiceMessage owl:equivalentClass [\\n  rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :hasInvoiceHeader ; owl:allValuesFrom :InvoiceHeader ] ;\\n  owl:Restriction [ owl:onProperty :hasInvoiceDetail ; owl:allValuesFrom :InvoiceDetail ] ;\\n  owl:Restriction [ owl:onProperty :hasInvoiceSummary ; owl:allValuesFrom :InvoiceSummary ]\\n] .\\n\\n:OrganizationRoleAssignment owl:equivalentClass [\\n  rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :roleOrganization ; owl:allValuesFrom :Organization ] ;\\n  owl:Restriction [ owl:onProperty :roleType ; owl:allValuesFrom :AgentRole ]\\n] .\\n\\n:InvoiceItemization owl:equivalentClass [\\n  rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :itemizationItem ; owl:allValuesFrom :LineItem ]\\n] .\\n\\n#################################################################\\n# Annotations (all classes and properties have labels and comments above)\\n#################################################################\\n\"}",
        "name": "validate_syntax_tool"
      },
      "type": "function"
    },
    {
      "id": "call_tJ9VtCUR1Vp9Qr8KgzlwocoM",
      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n:EDIFACTInvoiceOntology rdf:type owl:Ontology ;\\n  rdfs:label \\\"EDIFACT D96A INVOIC and P2P-O Ontology\\\" ;\\n  rdfs:comment \\\"A profoundly structured ontology for digital business documents based on UN/EDIFACT D96A, EANCOM INVOIC, and P2P-O, including all mandatory segments, roles, and constraints for semantic interoperability.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope rdf:type owl:Class ;\\n  rdfs:label \\\"Interchange Envelope\\\" ;\\n  rdfs:comment \\\"The top-level envelope containing EDIFACT messages.\\\" .\\n\\n:Message rdf:type owl:Class ;\\n  rdfs:label \\\"Message\\\" ;\\n  rdfs:comment \\\"A business document contained within an Interchange Envelope.\\\" .\\n\\n:InvoiceMessage rdf:type owl:Class ;\\n  rdfs:subClassOf :Message ;\\n  rdfs:label \\\"Invoice Message\\\" ;\\n  rdfs:comment \\\"An INVOIC message representing a global trade transaction.\\\" .\\n\\n:Segment rdf:type owl:Class ;\\n  rdfs:label \\\"Segment\\\" ;\\n  rdfs:comment \\\"A segment within a message, composed of composite and simple data elements.\\\" .\\n\\n:BGM_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"BGM Segment\\\" ;\\n  rdfs:comment \\\"Beginning of Message segment for document identification.\\\" .\\n\\n:NAD_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"NAD Segment\\\" ;\\n  rdfs:comment \\\"Name and Address segment for participant details.\\\" .\\n\\n:DTM_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"DTM Segment\\\" ;\\n  rdfs:comment \\\"Date/Time/Period segment for document dates.\\\" .\\n\\n:RFF_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"RFF Segment\\\" ;\\n  rdfs:comment \\\"Reference segment for reference numbers.\\\" .\\n\\n:CUX_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"CUX Segment\\\" ;\\n  rdfs:comment \\\"Currency segment for currency codes.\\\" .\\n\\n:PAT_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PAT Segment\\\" ;\\n  rdfs:comment \\\"Payment Terms segment for payment conditions.\\\" .\\n\\n:ALC_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"ALC Segment\\\" ;\\n  rdfs:comment \\\"Allowances and Charges segment.\\\" .\\n\\n:TAX_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"TAX Segment\\\" ;\\n  rdfs:comment \\\"Tax segment for tax details.\\\" .\\n\\n:MOA_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"MOA Segment\\\" ;\\n  rdfs:comment \\\"Monetary Amount segment.\\\" .\\n\\n:QTY_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"QTY Segment\\\" ;\\n  rdfs:comment \\\"Quantity segment.\\\" .\\n\\n:PRI_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PRI Segment\\\" ;\\n  rdfs:comment \\\"Price segment for price details.\\\" .\\n\\n:LIN_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"LIN Segment\\\" ;\\n  rdfs:comment \\\"Line Item segment.\\\" .\\n\\n:PIA_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"PIA Segment\\\" ;\\n  rdfs:comment \\\"Additional Product ID segment.\\\" .\\n\\n:IMD_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"IMD Segment\\\" ;\\n  rdfs:comment \\\"Item Description segment.\\\" .\\n\\n:LOC_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"LOC Segment\\\" ;\\n  rdfs:comment \\\"Location segment.\\\" .\\n\\n:TDT_Segment rdf:type owl:Class ;\\n  rdfs:subClassOf :Segment ;\\n  rdfs:label \\\"TDT Segment\\\" ;\\n  rdfs:comment \\\"Transport segment for transport details.\\\" .\\n\\n:CompositeDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Composite Data Element\\\" ;\\n  rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement rdf:type owl:Class ;\\n  rdfs:label \\\"Simple Data Element\\\" ;\\n  rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:Organization rdf:type owl:Class ;\\n  rdfs:label \\\"Organization\\\" ;\\n  rdfs:comment \\\"A party involved in the invoice, such as Buyer or Supplier.\\\" .\\n\\n:AgentRole rdf:type owl:Class ;\\n  rdfs:label \\\"Agent Role\\\" ;\\n  rdfs:comment \\\"A role played by an organization within an invoice.\\\" .\\n\\n:Address rdf:type owl:Class ;\\n  rdfs:label \\\"Address\\\" ;\\n  rdfs:comment \\\"Address information for an organization.\\\" .\\n\\n:Identifier rdf:type owl:Class ;\\n  rdfs:label \\\"Identifier\\\" ;\\n  rdfs:comment \\\"An identifier for an organization, such as a Global Location Number.\\\" .\\n\\n:GlobalLocationNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Global Location Number\\\" ;\\n  rdfs:comment \\\"A global location identifier for organizations.\\\" .\\n\\n:InvoiceHeader rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Invoice Header\\\" ;\\n  rdfs:comment \\\"Header section of the invoice message.\\\" .\\n\\n:InvoiceDetail rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Invoice Detail\\\" ;\\n  rdfs:comment \\\"Detail section of the invoice message, listing line items.\\\" .\\n\\n:InvoiceSummary rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Invoice Summary\\\" ;\\n  rdfs:comment \\\"Summary section of the invoice message, providing totals.\\\" .\\n\\n:LineItem rdf:type owl:Class ;\\n  rdfs:subClassOf :CompositeDataElement ;\\n  rdfs:label \\\"Line Item\\\" ;\\n  rdfs:comment \\\"An itemized entry in the invoice detail section.\\\" .\\n\\n:Item rdf:type owl:Class ;\\n  rdfs:label \\\"Item\\\" ;\\n  rdfs:comment \\\"A product or service sold in the invoice.\\\" .\\n\\n:Price rdf:type owl:Class ;\\n  rdfs:label \\\"Price\\\" ;\\n  rdfs:comment \\\"Price information for an item.\\\" .\\n\\n:Tax rdf:type owl:Class ;\\n  rdfs:label \\\"Tax\\\" ;\\n  rdfs:comment \\\"Tax information for the invoice.\\\" .\\n\\n:Amount rdf:type owl:Class ;\\n  rdfs:label \\\"Amount\\\" ;\\n  rdfs:comment \\\"Amount information for the invoice.\\\" .\\n\\n:ReferenceNumber rdf:type owl:Class ;\\n  rdfs:label \\\"Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number for the invoice.\\\" .\\n\\n:BusinessProcess rdf:type owl:Class ;\\n  rdfs:label \\\"Business Process\\\" ;\\n  rdfs:comment \\\"A business process associated with the invoice.\\\" .\\n\\n:ValidationConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"Validation Constraint\\\" ;\\n  rdfs:comment \\\"A constraint used for validating invoice data.\\\" .\\n\\n:SHACLConstraint rdf:type owl:Class ;\\n  rdfs:label \\\"SHACL Constraint\\\" ;\\n  rdfs:comment \\\"A SHACL constraint for automated validation.\\\" .\\n\\n:PurchaseToPayOntologyEntity rdf:type owl:Class ;\\n  rdfs:subClassOf owl:Thing ;\\n  rdfs:label \\\"Purchase-to-Pay Ontology Entity\\\" ;\\n  rdfs:comment \\\"Entity from the Purchase-to-Pay Ontology for semantic alignment.\\\" .\\n\\n#################################################################\\n# Pivot Classes\\n#################################################################\\n\\n:OrganizationRoleAssignment rdf:type owl:Class ;\\n  rdfs:label \\\"Organization Role Assignment\\\" ;\\n  rdfs:comment \\\"Reification class linking an organization to a specific role, address, and identifier in the invoice context.\\\" .\\n\\n:InvoiceItemization rdf:type owl:Class ;\\n  rdfs:label \\\"Invoice Itemization\\\" ;\\n  rdfs:comment \\\"Reification class linking invoice message to itemized line items.\\\" .\\n\\n#################################################################\\n# Properties\\n#################################################################\\n\\n:containsMessage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InterchangeEnvelope ;\\n  rdfs:range :Message ;\\n  rdfs:label \\\"contains Message\\\" ;\\n  rdfs:comment \\\"Links an Interchange Envelope to contained Messages.\\\" .\\n\\n:hasSegment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Message ;\\n  rdfs:range :Segment ;\\n  rdfs:label \\\"has Segment\\\" ;\\n  rdfs:comment \\\"Links a Message to its constituent Segments.\\\" .\\n\\n:hasCompositeElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :Segment ;\\n  rdfs:range :CompositeDataElement ;\\n  rdfs:label \\\"has Composite Element\\\" ;\\n  rdfs:comment \\\"Links a Segment to its composite data elements.\\\" .\\n\\n:hasSimpleElement rdf:type owl:ObjectProperty ;\\n  rdfs:domain :CompositeDataElement ;\\n  rdfs:range :SimpleDataElement ;\\n  rdfs:label \\\"has Simple Element\\\" ;\\n  rdfs:comment \\\"Links a composite data element to its simple elements.\\\" .\\n\\n:playsRole rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"plays Role\\\" ;\\n  rdfs:comment \\\"Links an organization to the role it plays in the invoice.\\\" .\\n\\n:hasAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"has Address\\\" ;\\n  rdfs:comment \\\"Links an organization to its address.\\\" .\\n\\n:hasIdentifier rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Organization ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"has Identifier\\\" ;\\n  rdfs:comment \\\"Links an organization to its identifier.\\\" .\\n\\n:hasGlobalLocationNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :Identifier ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Global Location Number\\\" ;\\n  rdfs:comment \\\"Links an identifier to its Global Location Number.\\\" .\\n\\n:hasInvoiceHeader rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceHeader ;\\n  rdfs:label \\\"has Invoice Header\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its header section.\\\" .\\n\\n:hasInvoiceDetail rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceDetail ;\\n  rdfs:label \\\"has Invoice Detail\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its detail section.\\\" .\\n\\n:hasInvoiceSummary rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceSummary ;\\n  rdfs:label \\\"has Invoice Summary\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its summary section.\\\" .\\n\\n:hasLineItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceDetail ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"has Line Item\\\" ;\\n  rdfs:comment \\\"Links invoice detail section to its line items.\\\" .\\n\\n:describesItem rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range :Item ;\\n  rdfs:label \\\"describes Item\\\" ;\\n  rdfs:comment \\\"Links a line item to the item it describes.\\\" .\\n\\n:hasNetPrice rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"has Net Price\\\" ;\\n  rdfs:comment \\\"The net price of the item in the line item.\\\" .\\n\\n:hasQuantity rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LineItem ;\\n  rdfs:range xsd:integer ;\\n  rdfs:label \\\"has Quantity\\\" ;\\n  rdfs:comment \\\"The quantity of the item sold in the line item.\\\" .\\n\\n:hasTax rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceSummary ;\\n  rdfs:range :Tax ;\\n  rdfs:label \\\"has Tax\\\" ;\\n  rdfs:comment \\\"Links invoice summary section to tax information.\\\" .\\n\\n:hasAmount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceSummary ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"has Amount\\\" ;\\n  rdfs:comment \\\"The total amount of the invoice.\\\" .\\n\\n:hasReferenceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceHeader ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Reference Number\\\" ;\\n  rdfs:comment \\\"Reference number of the invoice.\\\" .\\n\\n:hasInvoiceNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceHeader ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"has Invoice Number\\\" ;\\n  rdfs:comment \\\"Invoice number of the invoice.\\\" .\\n\\n:hasBusinessProcess rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :BusinessProcess ;\\n  rdfs:label \\\"has Business Process\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its associated business process.\\\" .\\n\\n:validatesWith rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :ValidationConstraint ;\\n  rdfs:label \\\"validates With\\\" ;\\n  rdfs:comment \\\"Links an invoice message to validation constraints.\\\" .\\n\\n:conformsToSHACL rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :SHACLConstraint ;\\n  rdfs:label \\\"conforms To SHACL\\\" ;\\n  rdfs:comment \\\"Links an invoice message to SHACL constraints for automated validation.\\\" .\\n\\n#################################################################\\n# Pivot Class Properties\\n#################################################################\\n\\n:hasRoleAssignment rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :OrganizationRoleAssignment ;\\n  rdfs:label \\\"has Role Assignment\\\" ;\\n  rdfs:comment \\\"Links an invoice message to organization role assignments.\\\" .\\n\\n:roleOrganization rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Organization ;\\n  rdfs:label \\\"role Organization\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the involved organization.\\\" .\\n\\n:roleType rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :AgentRole ;\\n  rdfs:label \\\"role Type\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the type of role played.\\\" .\\n\\n:roleAddress rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Address ;\\n  rdfs:label \\\"role Address\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the address used in the role.\\\" .\\n\\n:roleIdentifier rdf:type owl:ObjectProperty , owl:FunctionalProperty ;\\n  rdfs:domain :OrganizationRoleAssignment ;\\n  rdfs:range :Identifier ;\\n  rdfs:label \\\"role Identifier\\\" ;\\n  rdfs:comment \\\"Links a role assignment to the identifier used in the role.\\\" .\\n\\n:hasItemization rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceMessage ;\\n  rdfs:range :InvoiceItemization ;\\n  rdfs:label \\\"has Itemization\\\" ;\\n  rdfs:comment \\\"Links an invoice message to its itemization structure.\\\" .\\n\\n:itemizationItem rdf:type owl:ObjectProperty ;\\n  rdfs:domain :InvoiceItemization ;\\n  rdfs:range :LineItem ;\\n  rdfs:label \\\"itemization Item\\\" ;\\n  rdfs:comment \\\"Links invoice itemization to individual line items.\\\" .\\n\\n#################################################################\\n# Segment-Specific Properties\\n#################################################################\\n\\n:dtmDateType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :DTM_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"DTM Date Type\\\" ;\\n  rdfs:comment \\\"The type of date in the DTM segment (e.g., invoice date, delivery date).\\\" .\\n\\n:dtmDateValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :DTM_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"DTM Date Value\\\" ;\\n  rdfs:comment \\\"The value of the date in the DTM segment.\\\" .\\n\\n:rffReferenceType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RFF_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"RFF Reference Type\\\" ;\\n  rdfs:comment \\\"The type of reference in the RFF segment.\\\" .\\n\\n:rffReferenceValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :RFF_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"RFF Reference Value\\\" ;\\n  rdfs:comment \\\"The value of the reference in the RFF segment.\\\" .\\n\\n:cuxCurrencyCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :CUX_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"CUX Currency Code\\\" ;\\n  rdfs:comment \\\"The currency code in the CUX segment.\\\" .\\n\\n:patPaymentTerms rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PAT_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"PAT Payment Terms\\\" ;\\n  rdfs:comment \\\"Payment terms in the PAT segment.\\\" .\\n\\n:alcAllowanceType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :ALC_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"ALC Allowance Type\\\" ;\\n  rdfs:comment \\\"Allowance type in the ALC segment.\\\" .\\n\\n:taxTaxType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :TAX_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"TAX Tax Type\\\" ;\\n  rdfs:comment \\\"Tax type in the TAX segment.\\\" .\\n\\n:moaAmountType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :MOA_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"MOA Amount Type\\\" ;\\n  rdfs:comment \\\"Amount type in the MOA segment.\\\" .\\n\\n:moaAmountValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :MOA_Segment ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"MOA Amount Value\\\" ;\\n  rdfs:comment \\\"Amount value in the MOA segment.\\\" .\\n\\n:qtyQuantityType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :QTY_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"QTY Quantity Type\\\" ;\\n  rdfs:comment \\\"Quantity type in the QTY segment.\\\" .\\n\\n:qtyQuantityValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :QTY_Segment ;\\n  rdfs:range xsd:integer ;\\n  rdfs:label \\\"QTY Quantity Value\\\" ;\\n  rdfs:comment \\\"Quantity value in the QTY segment.\\\" .\\n\\n:priPriceType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PRI_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"PRI Price Type\\\" ;\\n  rdfs:comment \\\"Price type in the PRI segment.\\\" .\\n\\n:priPriceValue rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PRI_Segment ;\\n  rdfs:range xsd:decimal ;\\n  rdfs:label \\\"PRI Price Value\\\" ;\\n  rdfs:comment \\\"Price value in the PRI segment.\\\" .\\n\\n:linLineItemNumber rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LIN_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"LIN Line Item Number\\\" ;\\n  rdfs:comment \\\"Line item number in the LIN segment.\\\" .\\n\\n:piaAdditionalProductId rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :PIA_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"PIA Additional Product ID\\\" ;\\n  rdfs:comment \\\"Additional product ID in the PIA segment.\\\" .\\n\\n:imdItemDescription rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :IMD_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"IMD Item Description\\\" ;\\n  rdfs:comment \\\"Item description in the IMD segment.\\\" .\\n\\n:locLocationType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :LOC_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"LOC Location Type\\\" ;\\n  rdfs:comment \\\"Location type in the LOC segment.\\\" .\\n\\n:tdtTransportType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;\\n  rdfs:domain :TDT_Segment ;\\n  rdfs:range xsd:string ;\\n  rdfs:label \\\"TDT Transport Type\\\" ;\\n  rdfs:comment \\\"Transport type in the TDT segment.\\\" .\\n\\n#################################################################\\n# Disjointness and Equivalence\\n#################################################################\\n\\n:Organization owl:disjointWith :Item .\\n:Amount owl:disjointWith :Price .\\n:Organization owl:disjointWith :Address .\\n:Segment owl:disjointWith :CompositeDataElement .\\n:InvoiceHeader owl:disjointWith :InvoiceDetail .\\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\\n:InvoiceHeader owl:disjointWith :InvoiceSummary .\\n\\n[] owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\\n\\n#################################################################\\n# Restrictions (GCAs and Equivalence)\\n#################################################################\\n\\n:InvoiceMessage owl:equivalentClass [\\n  rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :hasInvoiceHeader ; owl:allValuesFrom :InvoiceHeader ] ;\\n  owl:Restriction [ owl:onProperty :hasInvoiceDetail ; owl:allValuesFrom :InvoiceDetail ] ;\\n  owl:Restriction [ owl:onProperty :hasInvoiceSummary ; owl:allValuesFrom :InvoiceSummary ]\\n] .\\n\\n:OrganizationRoleAssignment owl:equivalentClass [\\n  rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :roleOrganization ; owl:allValuesFrom :Organization ] ;\\n  owl:Restriction [ owl:onProperty :roleType ; owl:allValuesFrom :AgentRole ]\\n] .\\n\\n:InvoiceItemization owl:equivalentClass [\\n  rdf:type owl:Class ;\\n  owl:Restriction [ owl:onProperty :itemizationItem ; owl:allValuesFrom :LineItem ]\\n] .\\n\\n#################################################################\\n# Annotations (all classes and properties have labels and comments above)\\n#################################################################\\n\"}",
