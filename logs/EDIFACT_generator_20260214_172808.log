2026-02-14 17:31:30 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/edifact-scenario>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Scenario Ontology\" ;\n    rdfs:comment \"Ontology for representing EDIFACT invoice messaging scenarios.\" .\n\n#################################################################\n#    Classes\n#################################################################\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"An EDIFACT message containing one or more invoices.\" .\n\n:Invoice a owl:Class ;\n    rdfs:label \"Invoice\" ;\n    rdfs:comment \"A commercial document issued by a seller to a buyer.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An entity involved in the invoice, such as buyer or seller.\" .\n\n:OrganizationRole a owl:Class ;\n    rdfs:label \"Organization Role\" ;\n    rdfs:comment \"A role that an organization can play in an invoice, e.g., Buyer, Seller.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal address for an organization.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service listed in an invoice.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detailed information about an invoice, e.g., terms, dates.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n:EDIFACTFileFormat a owl:Class ;\n    rdfs:label \"EDIFACT File Format\" ;\n    rdfs:comment \"A file format specification for EDIFACT messages.\" .\n\n:InvoiceParticipation a owl:Class ;\n    rdfs:label \"Invoice Participation\" ;\n    rdfs:comment \"A reified relation linking an organization with its role in an invoice.\" .\n\n#################################################################\n#    Object Properties\n#################################################################\n\n:listsInvoice a owl:ObjectProperty ;\n    rdfs:label \"lists invoice\" ;\n    rdfs:comment \"Relates an EDIFACT message to the invoices it contains.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Invoice ;\n    owl:FunctionalProperty .\n\n:involvesParticipation a owl:ObjectProperty ;\n    rdfs:label \"involves participation\" ;\n    rdfs:comment \"Relates an invoice to a participation instance (organization-role pair).\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceParticipation .\n\n:hasRole a owl:ObjectProperty ;\n    rdfs:label \"has role\" ;\n    rdfs:comment \"Relates an invoice participation to the role played.\" ;\n    rdfs:domain :InvoiceParticipation ;\n    rdfs:range :OrganizationRole ;\n    owl:FunctionalProperty .\n\n:playedBy a owl:ObjectProperty ;\n    rdfs:label \"played by\" ;\n    rdfs:comment \"Relates an invoice participation to the participating organization.\" ;\n    rdfs:domain :InvoiceParticipation ;\n    rdfs:range :Organization ;\n    owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:FunctionalProperty .\n\n:sellsItem a owl:ObjectProperty ;\n    rdfs:label \"sells item\" ;\n    rdfs:comment \"Relates an invoice to the items sold.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :Item .\n\n:hasInvoiceDetail a owl:ObjectProperty ;\n    rdfs:label \"has invoice detail\" ;\n    rdfs:comment \"Relates an invoice to its detail information.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :InvoiceDetail ;\n    owl:FunctionalProperty .\n\n:hasFileFormat a owl:ObjectProperty ;\n    rdfs:label \"has file format\" ;\n    rdfs:comment \"Relates an EDIFACT message to its file format specification.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :EDIFACTFileFormat ;\n    owl:FunctionalProperty .\n\n:assignedToProcess a owl:ObjectProperty ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Relates an invoice to the business process it is assigned to.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range :BusinessProcess ;\n    owl:FunctionalProperty .\n\n#################################################################\n#    Data Properties\n#################################################################\n\n:itemNetPrice a owl:DatatypeProperty ;\n    rdfs:label \"item net price\" ;\n    rdfs:comment \"The net price of an item sold in the invoice.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:decimal .\n\n:invoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"invoice amount\" ;\n    rdfs:comment \"The total amount of the invoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:decimal .\n\n:invoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The unique identifier for the invoice.\" ;\n    rdfs:domain :Invoice ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:organizationName a owl:DatatypeProperty ;\n    rdfs:label \"organization name\" ;\n    rdfs:comment \"The name of an organization involved in the invoice.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"The street address or PO box.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"The city of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"The postal code of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:country a owl:DatatypeProperty ;\n    rdfs:label \"country\" ;\n    rdfs:comment \"The country of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:itemDescription a owl:DatatypeProperty ;\n    rdfs:label \"item description\" ;\n    rdfs:comment \"A description of the item sold in the invoice.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string .\n\n#################################################################\n#    Restrictions and Axioms\n#################################################################\n\n:Invoice\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :involvesParticipation ; owl:someValuesFrom :InvoiceParticipation ] ,\n                    [ a owl:Restriction ; owl:onProperty :sellsItem ; owl:someValuesFrom :Item ] ,\n                    [ a owl:Restriction ; owl:onProperty :hasInvoiceDetail ; owl:someValuesFrom :InvoiceDetail ] ,\n                    [ a owl:Restriction ; owl:onProperty :assignedToProcess ; owl:allValuesFrom :BusinessProcess ] .\n\n:EDIFACTMessage\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :listsInvoice ; owl:someValuesFrom :Invoice ] ,\n                    [ a owl:Restriction ; owl:onProperty :hasFileFormat ; owl:allValuesFrom :EDIFACTFileFormat ] .\n\n#################################################################\n#    Disjointness\n#################################################################\n\n:Organization owl:disjointWith :Invoice , :Item , :EDIFACTMessage , :Address .\n:Invoice owl:disjointWith :Item , :EDIFACTMessage , :Address .\n:Item owl:disjointWith :EDIFACTMessage , :Address .\n:EDIFACTMessage owl:disjointWith :Address .\n"
}
