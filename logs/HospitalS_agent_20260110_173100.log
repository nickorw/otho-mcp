ent \"A staff union at the hospital.\" .\n:UnionMembership rdf:type owl:Class ; rdfs:label \"Union Membership\" ; rdfs:comment \"A membership of a person in a union.\" .\n:UnionRole rdf:type owl:Class ; rdfs:label \"Union Role\" ; rdfs:comment \"A role held within a union.\" .\n:Evaluation rdf:type owl:Class ; rdfs:label \"Evaluation\" ; rdfs:comment \"A written evaluation of an employee by a doctor.\" .\n:Employee rdf:type owl:Class ; rdfs:label \"Employee\" ; rdfs:comment \"A person employed at the hospital.\" ; rdfs:subClassOf :Person .\n:Article rdf:type owl:Class ; rdfs:label \"Article\" ; rdfs:comment \"A research article in a collection.\" .\n:ArticleCollection rdf:type owl:Class ; rdfs:label \"Article Collection\" ; rdfs:comment \"A collection of research articles.\" .\n:Book rdf:type owl:Class ; rdfs:label \"Book\" ; rdfs:comment \"A book containing articles.\" ; rdfs:subClassOf :ArticleCollection .\n:CD rdf:type owl:Class ; rdfs:label \"CD\" ; rdfs:comment \"A CD containing articles.\" ; rdfs:subClassOf :ArticleCollection .\n:Seminar rdf:type owl:Class ; rdfs:label \"Seminar\" ; rdfs:comment \"A seminar where articles are presented.\" .\n\n### Disjointness & DisjointUnion\n:Nurse owl:disjointWith :Doctor .\n:Book owl:disjointWith :CD .\n:ArticleCollection owl:disjointUnionOf ( :Book :CD ) .\n\n### Object Properties\n:hasDegree rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label \"has degree\" ; rdfs:comment \"Links a person to their medical degree.\" ; rdfs:domain :Person ; rdfs:range :MedicalDegree .\n:studiedDuring rdf:type owl:ObjectProperty ; rdfs:label \"studied during\" ; rdfs:comment \"Links a person to a period of study.\" ; rdfs:domain :Person ; rdfs:range :StudyPeriod .\n:studyForDegree rdf:type owl:ObjectProperty ; rdfs:label \"study for degree\" ; rdfs:comment \"Links a study period to the degree studied for.\" ; rdfs:domain :StudyPeriod ; rdfs:range :MedicalDegree .\n:employedAt rdf:type owl:ObjectProperty ; rdfs:label \"employed at\" ; rdfs:comment \"Links an employment period to a hospital.\" ; rdfs:domain :Employment ; rdfs:range :Hospital .\n:employmentOf rdf:type owl:ObjectProperty ; rdfs:label \"employment of\" ; rdfs:comment \"Links a person to their employment.\" ; rdfs:domain :Person ; rdfs:range :Employment .\n:hospitalInCity rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label \"hospital in city\" ; rdfs:comment \"Links a hospital to its city.\" ; rdfs:domain :Hospital ; rdfs:range :City .\n:cityInCountry rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label \"city in country\" ; rdfs:comment \"Links a city to its country.\" ; rdfs:domain :City ; rdfs:range :Country .\n:memberOfUnion rdf:type owl:ObjectProperty ; rdfs:label \"member of union\" ; rdfs:comment \"Links a union membership to a union.\" ; rdfs:domain :UnionMembership ; rdfs:range :Union .\n:membershipOf rdf:type owl:ObjectProperty ; rdfs:label \"membership of\" ; rdfs:comment \"Links a person to their union membership.\" ; rdfs:domain :Person ; rdfs:range :UnionMembership .\n:hasUnionRole rdf:type owl:ObjectProperty ; rdfs:label \"has union role\" ; rdfs:comment \"Links a union membership to the role held.\" ; rdfs:domain :UnionMembership ; rdfs:range :UnionRole .\n:evaluatedBy rdf:type owl:ObjectProperty ; rdfs:label \"evaluated by\" ; rdfs:comment \"Links an evaluation to the doctor who performed it.\" ; rdfs:domain :Evaluation ; rdfs:range :Doctor .\n:evaluationOf rdf:type owl:ObjectProperty ; rdfs:label \"evaluation of\" ; rdfs:comment \"Links an evaluation to the employee evaluated.\" ; rdfs:domain :Evaluation ; rdfs:range :Employee .\n:hasEvaluation rdf:type owl:ObjectProperty ; rdfs:label \"has evaluation\" ; rdfs:comment \"Links an employee to their evaluation.\" ; rdfs:domain :Employee ; rdfs:range :Evaluation .\n:containsArticle rdf:type owl:ObjectProperty ; rdfs:label \"contains article\" ; rdfs:comment \"Links an article collection to its articles.\" ; rdfs:domain :ArticleCollection ; rdfs:range :Article .\n:presentedInSeminar rdf:type owl:ObjectProperty ; rdfs:label \"presented in seminar\" ; rdfs:comment \"Links an article to the seminar in which it was presented.\" ; rdfs:domain :Article ; rdfs:range :Seminar .\n:seminarAtHospital rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label \"seminar at hospital\" ; rdfs:comment \"Links a seminar to the hospital where it took place.\" ; rdfs:domain :Seminar ; rdfs:range :Hospital .\n\n### Data Properties\n:degreeDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"degree date\" ; rdfs:comment \"The date a medical degree was awarded.\" ; rdfs:domain :MedicalDegree ; rdfs:range xsd:dateTime .\n:studyStart rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"study start\" ; rdfs:comment \"The start date of a study period.\" ; rdfs:domain :StudyPeriod ; rdfs:range xsd:dateTime .\n:studyEnd rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"study end\" ; rdfs:comment \"The end date of a study period.\" ; rdfs:domain :StudyPeriod ; rdfs:range xsd:dateTime .\n:employmentStart rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"employment start\" ; rdfs:comment \"The start date of employment.\" ; rdfs:domain :Employment ; rdfs:range xsd:dateTime .\n:employmentEnd rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"employment end\" ; rdfs:comment \"The end date of employment.\" ; rdfs:domain :Employment ; rdfs:range xsd:dateTime .\n:unionRoleStart rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"union role start\" ; rdfs:comment \"The start date of a union role.\" ; rdfs:domain :UnionMembership ; rdfs:range xsd:dateTime .\n:unionRoleEnd rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"union role end\" ; rdfs:comment \"The end date of a union role.\" ; rdfs:domain :UnionMembership ; rdfs:range xsd:dateTime .\n:evaluationText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"evaluation text\" ; rdfs:comment \"The written evaluation text.\" ; rdfs:domain :Evaluation ; rdfs:range xsd:string .\n:bookPages rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"book pages\" ; rdfs:comment \"The number of pages in a book.\" ; rdfs:domain :Book ; rdfs:range xsd:integer .\n:publicationDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"publication date\" ; rdfs:comment \"The publication date of an article collection.\" ; rdfs:domain :ArticleCollection ; rdfs:range xsd:dateTime .\n:seminarDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label \"seminar date\" ; rdfs:comment \"The date a seminar took place.\" ; rdfs:domain :Seminar ; rdfs:range xsd:dateTime .\n\n### Advanced Axioms\n# At least one article is presented at each seminar\n:Seminar rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :presentedInSeminar ; owl:someValuesFrom :Article ] .\n\n# Book and CD are both ArticleCollections (disjointUnion above)\n# Employee is a Person employed at a hospital\n:Employee owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( :Person [ rdf:type owl:Restriction ; owl:onProperty :employmentOf ; owl:someValuesFrom :Employment ] ) ] .\n\n# UnionMembership links Person, Union, UnionRole, and Time\n:UnionMembership owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( [ rdf:type owl:Restriction ; owl:onProperty :membershipOf ; owl:someValuesFrom :Person ] [ rdf:type owl:Restriction ; owl:onProperty :memberOfUnion ; owl:someValuesFrom :Union ] [ rdf:type owl:Restriction ; owl:onProperty :hasUnionRole ; owl:someValuesFrom :UnionRole ] ) ] .\n"
}
