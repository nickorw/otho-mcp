n ; rdfs:range :Article .\n:presentedInSeminar rdf:type owl:ObjectProperty ; rdfs:label \"presented in seminar\" ; rdfs:comment \"Links an article to the seminar in which it was presented.\" ; rdfs:domain :Article ; rdfs:range :Seminar .\n:seminarAtHospital rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label \"seminar at hospital\" ; rdfs:comment \"Links a seminar to the hospital where it took place.\" ; rdfs:domain :Seminar ; rdfs:range :Hospital .\n\n### Inverse Object Properties\n:degreeOf rdf:type owl:ObjectProperty ; rdfs:label \"degree of\" ; rdfs:comment \"Inverse of hasDegree, links a medical degree to a person.\" ; owl:inverseOf :hasDegree .\n:studyPeriodOf rdf:type owl:ObjectProperty ; rdfs:label \"study period of\" ; rdfs:comment \"Inverse of studiedDuring, links a study period to a person.\" ; owl:inverseOf :studiedDuring .\n:degreeStudiedDuring rdf:type owl:ObjectProperty ; rdfs:label \"degree studied during\" ; rdfs:comment \"Inverse of studyForDegree, links a medical degree to a study period.\" ; owl:inverseOf :studyForDegree .\n:employmentAtPerson rdf:type owl:ObjectProperty ; rdfs:label \"employment at person\" ; rdfs:comment \"Inverse of employmentOf, links an employment to a person.\" ; owl:inverseOf :employmentOf .\n:employerOfEmployment rdf:type owl:ObjectProperty ; rdfs:label \"employer of employment\" ; rdfs:comment \"Inverse of employedAt, links a hospital to an employment.\" ; owl:inverseOf :employedAt .\n:cityHasHospital rdf:type owl:ObjectProperty ; rdfs:label \"city has hospital\" ; rdfs:comment \"Inverse of hospitalInCity, links a city to a hospital.\" ; owl:inverseOf :hospitalInCity .\n:countryHasCity rdf:type owl:ObjectProperty ; rdfs:label \"country has city\" ; rdfs:comment \"Inverse of cityInCountry, links a country to a city.\" ; owl:inverseOf :cityInCountry .\n:unionHasMember rdf:type owl:ObjectProperty ; rdfs:label \"union has member\" ; rdfs:comment \"Inverse of memberOfUnion, links a union to a union membership.\"