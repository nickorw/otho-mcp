      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#edifact-invoic-ontology>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Ontology\" ;\n    rdfs:comment \"A deeply structured ontology for the UN/EDIFACT D96A INVOIC message, supporting EANCOM, EN 16931-1, and P2P-O alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An INVOIC message representing a business invoice transaction.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A generic EDIFACT segment.\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NAD_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" .\n\n:DTM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"DTM Segment\" ;\n    rdfs:comment \"Date/Time/Period segment with qualifiers.\" .\n\n:MOA_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"MOA Segment\" ;\n    rdfs:comment \"Monetary Amount segment with qualifiers.\" .\n\n:QTY_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"QTY Segment\" ;\n    rdfs:comment \"Quantity segment with context.\" .\n\n:RFF_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"RFF Segment\" ;\n    rdfs:comment \"Reference segment with qualifiers.\" .\n\n:ALC_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"ALC Segment\" ;\n    rdfs:comment \"Allowance/Charge segment.\" .\n\n:TAX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"TAX Segment\" ;\n    rdfs:comment \"Tax detail segment with qualifiers and tax breakdown.\" .\n\n:UNH_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"UNH Segment\" ;\n    rdfs:comment \"Message Header segment.\" .\n\n:UNT_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"UNT Segment\" ;\n    rdfs:comment \"Message Trailer segment.\" .\n\n:CUX_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"CUX Segment\" ;\n    rdfs:comment \"Currencies segment.\" .\n\n:PRI_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"PRI Segment\" ;\n    rdfs:comment \"Price details segment.\" .\n\n:LIN_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"LIN Segment\" ;\n    rdfs:comment \"Line item identification segment.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite.\" .\n\n:InvoiceHeaderGroup a owl:Class ;\n    rdfs:label \"Invoice Header Group\" ;\n    rdfs:comment \"Header group of the invoice message, containing header segments.\" .\n\n:InvoiceLineItemGroup a owl:Class ;\n    rdfs:label \"Invoice Line Item Group\" ;\n    rdfs:comment \"Line item group of the invoice message, containing line item segments.\" .\n\n:InvoiceSummaryGroup a owl:Class ;\n    rdfs:label \"Invoice Summary Group\" ;\n    rdfs:comment \"Summary group of the invoice message, containing summary segments.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header information for an invoice.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail information for an invoice, including line items.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:subClassOf :CompositeDataElement ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary information for an invoice.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A single line item in the invoice detail section.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A business organization involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A specific role played by an organization (e.g., Buyer, Supplier, Delivery Party).\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class for reifying the assignment of a role to an organization within a specific invoice context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier for an organization or item.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A unique global location identifier (GLN).\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"A product or service being invoiced.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price value for an item or service.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"A tax value or breakdown.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A process to which the invoice can be assigned (e.g., Purchase-to-Pay).\" .\n\n:ValidationRule a owl:Class ;\n    rdfs:label \"Validation Rule\" ;\n    rdfs:comment \"A rule for validating the invoice structure or content.\" .\n\n:SHACLConstraint a owl:Class ;\n    rdfs:label \"SHACL Constraint\" ;\n    rdfs:comment \"A SHACL constraint for automated validation.\" .\n\n#################################################################\n# Object and Data Properties\n#################################################################\n\n:hasMessage a owl:ObjectProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has message\" ;\n    rdfs:comment \"Links an interchange envelope to its contained message.\" .\n\n:hasHeaderGroup a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeaderGroup ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has header group\" ;\n    rdfs:comment \"Links an invoice message to its header group.\" .\n\n:hasLineItemGroup a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceLineItemGroup ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has line item group\" ;\n    rdfs:comment \"Links an invoice message to its line item group.\" .\n\n:hasSummaryGroup a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummaryGroup ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has summary group\" ;\n    rdfs:comment \"Links an invoice message to its summary group.\" .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a message to its segments.\" .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a segment to its composite data elements.\" .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a composite data element to its simple elements.\" .\n\n:hasHeader a owl:ObjectProperty ;\n    rdfs:domain :InvoiceHeaderGroup ;\n    rdfs:range :InvoiceHeader ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Links an invoice header group to its header details.\" .\n\n:hasDetail a owl:ObjectProperty ;\n    rdfs:domain :InvoiceLineItemGroup ;\n    rdfs:range :InvoiceDetail ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Links a line item group to its detail section.\" .\n\n:hasSummary a owl:ObjectProperty ;\n    rdfs:domain :InvoiceSummaryGroup ;\n    rdfs:range :InvoiceSummary ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Links a summary group to its summary section.\" .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links an invoice detail section to its line items.\" .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links an invoice message to organizations involved.\" .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an invoice message to its organization-role assignments.\" .\n\n:hasAgentRole a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a role assignment to the agent role (e.g., Buyer, Supplier).\" .\n\n:assignedOrganization a owl:ObjectProperty ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"Links a role assignment to the assigned organization.\" .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifier(s).\" .\n\n:hasGLN a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :GlobalLocationNumber ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Links an identifier to a Global Location Number.\" .\n\n:hasItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"has item\" ;\n    rdfs:comment \"Links a line item to the invoiced item.\" .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a line item to its price.\" .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links a summary to its tax details.\" .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total invoice amount.\" .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number.\" .\n\n:hasDate a owl:DatatypeProperty ;\n    rdfs:domain :DTM_Segment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"A date value with qualifier.\" .\n\n:hasMonetaryAmount a owl:DatatypeProperty ;\n    rdfs:domain :MOA_Segment ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has monetary amount\" ;\n    rdfs:comment \"A monetary amount with qualifier.\" .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :QTY_Segment ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"A quantity value with qualifier.\" .\n\n:hasReference a owl:DatatypeProperty ;\n    rdfs:domain :RFF_Segment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference\" ;\n    rdfs:comment \"A reference value with qualifier.\" .\n\n:hasAllowanceCharge a owl:DatatypeProperty ;\n    rdfs:domain :ALC_Segment ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has allowance/charge\" ;\n    rdfs:comment \"Allowance or charge amount with qualifier.\" .\n\n:hasTaxDetail a owl:ObjectProperty ;\n    rdfs:domain :TAX_Segment ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax detail\" ;\n    rdfs:comment \"Links a TAX segment to a tax breakdown.\" .\n\n:hasCurrency a owl:DatatypeProperty ;\n    rdfs:domain :CUX_Segment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has currency\" ;\n    rdfs:comment \"Currency code with qualifier.\" .\n\n:hasPriceDetail a owl:ObjectProperty ;\n    rdfs:domain :PRI_Segment ;\n    rdfs:range :Price ;\n    rdfs:label \"has price detail\" ;\n    rdfs:comment \"Links a PRI segment to a price value.\" .\n\n:hasLineIdentifier a owl:DatatypeProperty ;\n    rdfs:domain :LIN_Segment ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has line identifier\" ;\n    rdfs:comment \"Line item identification value.\" .\n\n:validatesWith a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :SHACLConstraint ;\n    rdfs:label \"validates with\" ;\n    rdfs:comment \"Links an invoice message to its SHACL validation constraints.\" .\n\n:assignedToBusinessProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to business process\" ;\n    rdfs:comment \"Links an invoice message to the business process it belongs to.\" .\n\n#################################################################\n# Disjointness and Union\n#################################################################\n\n:InvoiceHeaderGroup owl:disjointWith :InvoiceLineItemGroup, :InvoiceSummaryGroup .\n:InvoiceLineItemGroup owl:disjointWith :InvoiceSummaryGroup .\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n:Organization owl:disjointWith :Item, :AgentRole .\n:Address owl:disjointWith :Item .\n:InvoiceHeaderGroup owl:disjointUnionOf ( :InvoiceHeaderGroup :InvoiceLineItemGroup :InvoiceSummaryGroup ) .\n\n#################################################################\n# General Class Axioms and Restrictions\n#################################################################\n\n:InvoiceMessage owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasHeaderGroup ; owl:someValuesFrom :InvoiceHeaderGroup ]\n        [ a owl:Restriction ; owl:onProperty :hasLineItemGroup ; owl:someValuesFrom :InvoiceLineItemGroup ]\n        [ a owl:Restriction ; owl:onProperty :hasSummaryGroup ; owl:someValuesFrom :InvoiceSummaryGroup ]\n    )\n] .\n\n:OrganizationRoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:someValuesFrom :AgentRole ]\n        [ a owl:Restriction ; owl:onProperty :assignedOrganization ; owl:someValuesFrom :Organization ]\n    )\n] .\n"
