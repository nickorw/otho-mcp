2026-03-03 07:12:55 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACT_INVOIC_Ontology rdf:type owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT INVOIC messages, segments, and business roles, aligned with EN 16931-1 and P2P-O standards.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope rdf:type owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope that contains EDIFACT messages, including INVOIC.\" .\n\n:Message rdf:type owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"Generic EDIFACT message structure.\" .\n\n:InvoiceMessage rdf:type owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"INVOIC message for global trade transactions.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment rdf:type owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGMSegment rdf:type owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment rdf:type owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement rdf:type owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"Composite element within a segment, containing simple elements.\" .\n\n:SimpleDataElement rdf:type owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"Atomic data element within a composite.\" .\n\n:HeaderSection rdf:type owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Section containing document dates and reference numbers.\" .\n\n:DetailSection rdf:type owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Section listing individual line items.\" .\n\n:SummarySection rdf:type owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Section providing total tax and invoice amounts.\" .\n\n:Organization rdf:type owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"Entity involved in the invoice, may play multiple roles.\" .\n\n:AgentRole rdf:type owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"Role played by an organization (e.g., Buyer, Delivery Party).\" .\n\n:Address rdf:type owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Address associated with an organization.\" .\n\n:Item rdf:type owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"Goods or services sold in the invoice.\" .\n\n:Price rdf:type owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Net price of items in the invoice.\" .\n\n:InvoiceAmount rdf:type owl:Class ;\n    rdfs:label \"Invoice Amount\" ;\n    rdfs:comment \"Total amount of the invoice.\" .\n\n:InvoiceNumber rdf:type owl:Class ;\n    rdfs:label \"Invoice Number\" ;\n    rdfs:comment \"Unique identifier for the invoice.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"Process to which the invoice is assigned (e.g., procurement).\" .\n\n:Identifier rdf:type owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"Generic identifier for organizations or items.\" .\n\n:GLNIdentifier rdf:type owl:Class ;\n    rdfs:label \"Global Location Number Identifier\" ;\n    rdfs:comment \"Global Location Number assigned to organizations.\" ;\n    rdfs:subClassOf :Identifier .\n\n:RoleAssignment rdf:type owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"Reification class linking organizations to agent roles and addresses.\" .\n\n:LineItem rdf:type owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"Individual item entry in the invoice detail section.\" .\n\n#################################################################\n# Disjointness and DisjointUnion\n#################################################################\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :Item .\n:InvoiceAmount owl:disjointWith :InvoiceNumber .\n\n#################################################################\n# Properties\n#################################################################\n:containsMessage rdf:type owl:ObjectProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links InterchangeEnvelope to contained Message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message .\n:containsMessage rdf:type owl:FunctionalProperty .\n:containedInEnvelope rdf:type owl:ObjectProperty ;\n    rdfs:label \"contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    owl:inverseOf :containsMessage .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links Message to its segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n:segmentOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    owl:inverseOf :hasSegment .\n\n:hasSection rdf:type owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links InvoiceMessage to header, detail, and summary sections.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Section .\n:sectionOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"section of\" ;\n    rdfs:comment \"Inverse of hasSection.\" ;\n    rdfs:domain :Section ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasSection .\n\n:Section rdf:type owl:Class ;\n    owl:equivalentClass [ rdf:type owl:Class ; owl:unionOf ( :HeaderSection :DetailSection :SummarySection ) ] ;\n    rdfs:label \"Section\" ;\n    rdfs:comment \"Union class of header, detail, and summary sections.\" .\n\n:hasCompositeElement rdf:type owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links Segment to composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n:compositeElementOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement rdf:type owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links CompositeDataElement to simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n:simpleElementOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :hasSimpleElement .\n\n:playsRole rdf:type owl:ObjectProperty ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Links Organization to RoleAssignment pivot class.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment .\n:rolePlayedBy rdf:type owl:ObjectProperty ;\n    rdfs:label \"role played by\" ;\n    rdfs:comment \"Inverse of playsRole.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :playsRole .\n\n:hasAgentRole rdf:type owl:ObjectProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links RoleAssignment to AgentRole.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole .\n:hasAgentRole rdf:type owl:FunctionalProperty .\n:agentRoleOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"agent role of\" ;\n    rdfs:comment \"Inverse of hasAgentRole.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    owl:inverseOf :hasAgentRole .\n\n:involvesOrganization rdf:type owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links InvoiceMessage to involved organizations.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization .\n:involvedInInvoice rdf:type owl:ObjectProperty ;\n    rdfs:label \"involved in invoice\" ;\n    rdfs:comment \"Inverse of involvesOrganization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :involvesOrganization .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links Organization to Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n:addressOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"address of\" ;\n    rdfs:comment \"Inverse of hasAddress.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasAddress .\n\n:hasIdentifier rdf:type owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links Organization to generic identifiers.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier .\n:identifierOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasIdentifier .\n\n:hasGLN rdf:type owl:ObjectProperty ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"Links Organization to its GLN identifier.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :GLNIdentifier .\n:hasGLN rdf:type owl:FunctionalProperty, owl:InverseFunctionalProperty .\n:glnOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"GLN of\" ;\n    rdfs:comment \"Inverse of hasGLN.\" ;\n    rdfs:domain :GLNIdentifier ;\n    rdfs:range :Organization ;\n    owl:inverseOf :hasGLN .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links DetailSection to individual line items.\" ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem .\n:lineItemOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    owl:inverseOf :hasLineItem .\n\n:describesItem rdf:type owl:ObjectProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links LineItem to Item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item .\n:itemDescribedBy rdf:type owl:ObjectProperty ;\n    rdfs:label \"item described by\" ;\n    rdfs:comment \"Inverse of describesItem.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :describesItem .\n\n:hasNetPrice rdf:type owl:ObjectProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"Links LineItem to price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price .\n:hasNetPrice rdf:type owl:FunctionalProperty .\n:netPriceOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"net price of\" ;\n    rdfs:comment \"Inverse of hasNetPrice.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :hasNetPrice .\n\n:hasInvoiceAmount rdf:type owl:ObjectProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"Links SummarySection to invoice amount.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :InvoiceAmount .\n:hasInvoiceAmount rdf:type owl:FunctionalProperty .\n:invoiceAmountOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"invoice amount of\" ;\n    rdfs:comment \"Inverse of hasInvoiceAmount.\" ;\n    rdfs:domain :InvoiceAmount ;\n    rdfs:range :SummarySection ;\n    owl:inverseOf :hasInvoiceAmount .\n\n:hasInvoiceNumber rdf:type owl:ObjectProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"Links HeaderSection to invoice number.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range :InvoiceNumber .\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\n:invoiceNumberOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"invoice number of\" ;\n    rdfs:comment \"Inverse of hasInvoiceNumber.\" ;\n    rdfs:domain :InvoiceNumber ;\n    rdfs:range :HeaderSection ;\n    owl:inverseOf :hasInvoiceNumber .\n\n:hasBusinessProcess rdf:type owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Links InvoiceMessage to business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess .\n:businessProcessOf rdf:type owl:ObjectProperty ;\n    rdfs:label \"business process of\" ;\n    rdfs:comment \"Inverse of hasBusinessProcess.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    owl:inverseOf :hasBusinessProcess .\n\n:hasDate rdf:type owl:DatatypeProperty ;\n    rdfs:label \"has date\" ;\n    rdfs:comment \"Date associated with header section.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasReferenceNumber rdf:type owl:DatatypeProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"Reference number in header section.\" ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string .\n\n:hasTaxAmount rdf:type owl:DatatypeProperty ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"Tax amount in summary section.\" ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal .\n:hasTaxAmount rdf:type owl:FunctionalProperty .\n\n:hasMandatoryIdentifier rdf:type owl:DatatypeProperty ;\n    rdfs:label \"has mandatory identifier\" ;\n    rdfs:comment \"Mandatory identifier required by D96A directory.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n#################################################################\n# Complex Axioms & Restrictions\n####################################################