2026-03-03 07:21:40 | DEBUG    |     Args: {
      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/storyid> a owl:Ontology ;\n    rdfs:label \"EDIFACT INVOIC Message Ontology\" ;\n    rdfs:comment \"A deep and profoundly structured ontology for UN/EDIFACT INVOIC messages, roles, identifiers, and business process alignment.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message, container for segments.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:subClassOf :Message ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An EDIFACT INVOIC message representing an invoice document.\" .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment in an EDIFACT message (e.g., BGM, NAD).\" .\n\n:BGM_Segment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" .\n\n:NADSegment a owl:Class ;\n    rdfs:subClassOf :Segment ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element grouping simple data elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element in a segment or composite.\" .\n\n:HeaderSection a owl:Class ;\n    rdfs:label \"Header Section\" ;\n    rdfs:comment \"Header section of an invoice message, containing metadata and references.\" .\n\n:DetailSection a owl:Class ;\n    rdfs:label \"Detail Section\" ;\n    rdfs:comment \"Detail section listing individual line items.\" .\n\n:SummarySection a owl:Class ;\n    rdfs:label \"Summary Section\" ;\n    rdfs:comment \"Summary section providing totals, tax, and invoice amount.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the invoice, representing a sold item.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice (buyer, seller, etc.).\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the transaction (e.g., Buyer, Seller, Delivery Party).\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"Pivot class associating an organization with a role in a specific context.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"An address associated with an organization (headquarters, warehouse, etc.).\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A generic identifier for organizations, roles, or documents.\" .\n\n:GlobalLocationNumber a owl:Class ;\n    rdfs:label \"Global Location Number\" ;\n    rdfs:comment \"A global location identifier for organizations or addresses.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"Price information for an item or invoice.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information for the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n#################################################################\n# Disjoint Classes\n#################################################################\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\n:DetailSection owl:disjointWith :SummarySection .\n:Organization owl:disjointWith :Address, :Item .\n:Item owl:disjointWith :Price, :Tax .\n\n#################################################################\n# Object Properties\n#################################################################\n:containsMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an interchange envelope to its contained message.\" .\n.\n:containsMessage owl:inverseOf :isContainedInEnvelope .\n\n:isContainedInEnvelope a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :InterchangeEnvelope ;\n    rdfs:label \"is contained in envelope\" ;\n    rdfs:comment \"Inverse of containsMessage.\" .\n.\n:isContainedInEnvelope owl:inverseOf :containsMessage .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Associates a message with its segments.\" .\n.\n:hasSegment owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :Message ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Inverse of hasSegment.\" .\n.\n:isSegmentOf owl:inverseOf :hasSegment .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Section ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Associates an invoice message with its sections.\" .\n.\n:hasSection owl:inverseOf :isSectionOf .\n\n:isSectionOf a owl:ObjectProperty ;\n    rdfs:domain :Section ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is section of\" ;\n    rdfs:comment \"Inverse of hasSection.\" .\n.\n:isSectionOf owl:inverseOf :hasSection .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:domain :DetailSection ;\n    rdfs:range :LineItem ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Associates a detail section with its line items.\" .\n.\n:hasLineItem owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :DetailSection ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Inverse of hasLineItem.\" .\n.\n:isLineItemOf owl:inverseOf :hasLineItem .\n\n:hasOrganization a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :Organization ;\n    rdfs:label \"has organization\" ;\n    rdfs:comment \"Links an invoice message to the involved organizations.\" .\n.\n:hasOrganization owl:inverseOf :isOrganizationOf .\n\n:isOrganizationOf a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"is organization of\" ;\n    rdfs:comment \"Inverse of hasOrganization.\" .\n.\n:isOrganizationOf owl:inverseOf :hasOrganization .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an organization to its role assignments.\" .\n.\n:hasRoleAssignment owl:inverseOf :isRoleAssignmentOf .\n\n:isRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization ;\n    rdfs:label \"is role assignment of\" ;\n    rdfs:comment \"Inverse of hasRoleAssignment.\" .\n.\n:isRoleAssignmentOf owl:inverseOf :hasRoleAssignment .\n\n:playsRole a owl:ObjectProperty ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    rdfs:label \"plays role\" ;\n    rdfs:comment \"Associates a role assignment with a specific agent role (e.g., Buyer, Seller).\" .\n.\n:playsRole owl:inverseOf :isRolePlayedBy .\n\n:isRolePlayedBy a owl:ObjectProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :RoleAssignment ;\n    rdfs:label \"is role played by\" ;\n    rdfs:comment \"Inverse of playsRole.\" .\n.\n:isRolePlayedBy owl:inverseOf :playsRole .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an organization to its address.\" .\n.\n:hasAddress owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Inverse of hasAddress.\" .\n.\n:isAddressOf owl:inverseOf :hasAddress .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an organization to its identifier(s).\" .\n.\n:hasIdentifier owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Inverse of hasIdentifier.\" .\n.\n:isIdentifierOf owl:inverseOf :hasIdentifier .\n\n:hasGlobalLocationNumber a owl:ObjectProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range :GlobalLocationNumber ;\n    rdfs:label \"has Global Location Number\" ;\n    rdfs:comment \"Links an identifier to a Global Location Number.\" .\n.\n:hasGlobalLocationNumber owl:inverseOf :isGlobalLocationNumberOf .\n\n:isGlobalLocationNumberOf a owl:ObjectProperty ;\n    rdfs:domain :GlobalLocationNumber ;\n    rdfs:range :Identifier ;\n    rdfs:label \"is Global Location Number of\" ;\n    rdfs:comment \"Inverse of hasGlobalLocationNumber.\" .\n.\n:isGlobalLocationNumberOf owl:inverseOf :hasGlobalLocationNumber .\n\n:soldItem a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    rdfs:label \"sold item\" ;\n    rdfs:comment \"Links a line item to the item sold.\" .\n.\n:soldItem owl:inverseOf :isItemSoldIn .\n\n:isItemSoldIn a owl:ObjectProperty ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is item sold in\" ;\n    rdfs:comment \"Inverse of soldItem.\" .\n.\n:isItemSoldIn owl:inverseOf :soldItem .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Associates a line item with its price.\" .\n.\n:hasPrice owl:inverseOf :isPriceOf .\n\n:isPriceOf a owl:ObjectProperty ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem ;\n    rdfs:label \"is price of\" ;\n    rdfs:comment \"Inverse of hasPrice.\" .\n.\n:isPriceOf owl:inverseOf :hasPrice .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range :Tax ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links a summary section to tax information.\" .\n.\n:hasTax owl:inverseOf :isTaxOf .\n\n:isTaxOf a owl:ObjectProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range :SummarySection ;\n    rdfs:label \"is tax of\" ;\n    rdfs:comment \"Inverse of hasTax.\" .\n.\n:isTaxOf owl:inverseOf :hasTax .\n\n:assignedToProcess a owl:ObjectProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    rdfs:label \"assigned to process\" ;\n    rdfs:comment \"Assigns an invoice message to a business process.\" .\n.\n:assignedToProcess owl:inverseOf :hasAssignedInvoice .\n\n:hasAssignedInvoice a owl:ObjectProperty ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage ;\n    rdfs:label \"has assigned invoice\" ;\n    rdfs:comment \"Inverse of assignedToProcess.\" .\n.\n:hasAssignedInvoice owl:inverseOf :assignedToProcess .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Connects a segment to its composite data elements.\" .\n.\n:hasCompositeElement owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" .\n.\n:isCompositeElementOf owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Connects a composite data element to its simple data elements.\" .\n.\n:hasSimpleElement owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement.\" .\n.\n:isSimpleElementOf owl:inverseOf :hasSimpleElement .\n\n#################################################################\n# Data Properties\n#################################################################\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The invoice number.\" .\n\n:hasInvoiceDate a owl:DatatypeProperty ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has invoice date\" ;\n    rdfs:comment \"The date of the invoice.\" .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:domain :HeaderSection ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"A reference number in the header section.\" .\n\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of an item.\" .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of the item sold.\" .\n\n:hasTotalAmount a owl:DatatypeProperty ;\n    rdfs:domain :SummarySection ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has total amount\" ;\n    rdfs:comment \"The total invoice amount.\" .\n\n:hasTaxAmount a owl:DatatypeProperty ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"The amount of tax in the summary section.\" .\n\n:hasAddressLine a owl:DatatypeProperty ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has address line\" ;\n    rdfs:comment \"A line of address text.\" .\n\n:hasOrganizationName a owl:DatatypeProperty ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has organization name\" ;\n    rdfs:comment \"The name of the organization.\" .\n\n:hasRoleCode a owl:DatatypeProperty ;\n    rdfs:domain :AgentRole ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has role code\" ;\n    rdfs:comment \"The code representing the agent role (e.g., 'BY' for Buyer).\" .\n\n:hasIdentifierValue a owl:DatatypeProperty ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    rdfs:label \"has identifier value\" ;\n    rdfs:comment \"The value of an identifier (e.g., GLN, VAT number).\" .\n\n#################################################################\n# Complex Axioms & Restrictions\n#################################################################\n# Section as superclass for HeaderSection, DetailSection, SummarySection\n:Section a owl:Class ;\n    rdfs:label \"Section\" ;\n    rdfs:comment \"Superclass for HeaderSection, DetailSection, SummarySection.\" .\n:HeaderSection rdfs:subClassOf :Section .\n:DetailSection rdfs:subClassOf :Section .\n:SummarySection rdfs:subClassOf :Section .\n\n:InvoiceMessage owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      :Message\n      [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :HeaderSection ]\n      [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :DetailSection ]\n      [ a owl:Restriction ; owl:onProperty :hasSection ; owl:someValuesFrom :SummarySection ]\n    )\n] .\n\n:RoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      [ a owl:Restriction ; owl:onProperty :playsRole ; owl:someValuesFrom :AgentRole ]\n      [ a owl:Restriction ; owl:onProperty :hasAddress ; owl:allValuesFrom :Address ]\n    )\n] .\n\n:LineItem owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      [ a owl:Restriction ; owl:onProperty :soldItem ; owl:someValuesFrom :Item ]\n      [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ]\n      [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom xsd:decimal ]\n    )\n] .\n\n#################################################################\n# Connect CompositeDataElement and SimpleDataElement to Segment\n#################################################################\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Connects a segment to its composite data elements.\" .\n.\n:hasCompositeElement owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Inverse of hasCompositeElement.\" .\n.\n:isCompositeElementOf owl:inverseOf :hasCompositeElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Connects a composite data element to its simple data elements.\" .\n.\n:hasSimpleElement owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Inverse of hasSimpleElement.\" .\n.\n:isSimpleElementOf owl:inverseOf :hasSimpleElement .\n\n#################################################################\n# Annotations for Classes and Properties are included as rdfs:label and rdfs:comment above\n#################################################################\n"
