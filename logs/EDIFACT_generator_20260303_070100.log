      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#edifact_invoice_story>\n    a owl:Ontology ;\n    rdfs:label \"EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"A deep OWL ontology for UN/EDIFACT invoice messages, segments, and business roles, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"The top-level envelope containing one or more EDIFACT messages.\" .\n\n:Message a owl:Class ;\n    rdfs:label \"Message\" ;\n    rdfs:comment \"A generic EDIFACT message contained in an InterchangeEnvelope.\" .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An invoice message (INVOIC) as defined by EDIFACT.\" ;\n    rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment is a structural unit within an EDIFACT message, such as BGM or NAD.\" .\n\n:BGMSegment a owl:Class ;\n    rdfs:label \"BGM Segment\" ;\n    rdfs:comment \"Beginning of Message segment for document identification.\" ;\n    rdfs:subClassOf :Segment .\n\n:NADSegment a owl:Class ;\n    rdfs:label \"NAD Segment\" ;\n    rdfs:comment \"Name and Address segment for participant details.\" ;\n    rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment, containing multiple simple data elements.\" .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A single data value within a composite data element.\" .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"The header section of an invoice, containing document dates and reference numbers.\" .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"The detail section, listing line items of the invoice.\" .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"The summary section, containing totals and tax information.\" .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"A party involved in the invoice, such as Buyer, Supplier, Delivery Party.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Supplier).\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"A postal or physical address for an organization.\" .\n\n:WarehouseAddress a owl:Class ;\n    rdfs:label \"Warehouse Address\" ;\n    rdfs:comment \"A warehouse address associated with an organization.\" ;\n    rdfs:subClassOf :Address .\n\n:HeadquartersAddress a owl:Class ;\n    rdfs:label \"Headquarters Address\" ;\n    rdfs:comment \"A headquarters address associated with an organization.\" ;\n    rdfs:subClassOf :Address .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with an item or invoice.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information in the invoice summary.\" .\n\n:ReferenceNumber a owl:Class ;\n    rdfs:label \"Reference Number\" ;\n    rdfs:comment \"A reference number for the invoice or document.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which the invoice is assigned.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"A global or local identifier, such as a GLN.\" .\n\n:RoleAssignment a owl:Class ;\n    rdfs:label \"Role Assignment\" ;\n    rdfs:comment \"A pivot class linking an Organization to an AgentRole within an InvoiceMessage.\" .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A pivot class representing an individual item entry in the invoice detail section.\" .\n\n#################################################################\n# Object Properties\n#################################################################\n:containsMessage a owl:ObjectProperty ;\n    rdfs:label \"contains message\" ;\n    rdfs:comment \"Links an InterchangeEnvelope to its contained Message(s).\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :Message ;\n    owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Links a Message to its Segments.\" ;\n    rdfs:domain :Message ;\n    rdfs:range :Segment .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Links a Segment to its CompositeDataElements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Links a CompositeDataElement to its SimpleDataElements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement .\n\n:hasSection a owl:ObjectProperty ;\n    rdfs:label \"has section\" ;\n    rdfs:comment \"Links an InvoiceMessage to its header, detail, and summary sections.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader, :InvoiceDetail, :InvoiceSummary .\n\n:hasRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has role assignment\" ;\n    rdfs:comment \"Links an InvoiceMessage to a RoleAssignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :RoleAssignment .\n\n:involvesOrganization a owl:ObjectProperty ;\n    rdfs:label \"involves organization\" ;\n    rdfs:comment \"Links a RoleAssignment to an Organization.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :Organization .\n\n:hasAgentRole a owl:ObjectProperty ;\n    rdfs:label \"has agent role\" ;\n    rdfs:comment \"Links a RoleAssignment to an AgentRole.\" ;\n    rdfs:domain :RoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Links an Organization to an Address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address .\n\n:hasWarehouseAddress a owl:ObjectProperty ;\n    rdfs:label \"has warehouse address\" ;\n    rdfs:comment \"Links an Organization to its WarehouseAddress.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :WarehouseAddress ;\n    owl:FunctionalProperty .\n\n:hasHeadquartersAddress a owl:ObjectProperty ;\n    rdfs:label \"has headquarters address\" ;\n    rdfs:comment \"Links an Organization to its HeadquartersAddress.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :HeadquartersAddress ;\n    owl:FunctionalProperty .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Links an Organization to an Identifier such as a GLN.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    owl:FunctionalProperty .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Links an InvoiceDetail section to its LineItems.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Links a LineItem to the Item it describes.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:FunctionalProperty .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Links a LineItem to its Price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:FunctionalProperty .\n\n:hasTax a owl:ObjectProperty ;\n    rdfs:label \"has tax\" ;\n    rdfs:comment \"Links an InvoiceSummary to its Tax.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :Tax ;\n    owl:FunctionalProperty .\n\n:referencesBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"references business process\" ;\n    rdfs:comment \"Links an InvoiceMessage to a BusinessProcess.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:FunctionalProperty .\n\n#################################################################\n# Data Properties\n#################################################################\n:hasDocumentDate a owl:DatatypeProperty ;\n    rdfs:label \"has document date\" ;\n    rdfs:comment \"The document date of the invoice.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:dateTime ;\n    owl:FunctionalProperty .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has reference number\" ;\n    rdfs:comment \"A reference number for the document.\" ;\n    rdfs:domain :ReferenceNumber ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n    rdfs:label \"has invoice number\" ;\n    rdfs:comment \"The unique invoice number.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:hasOrganizationName a owl:DatatypeProperty ;\n    rdfs:label \"has organization name\" ;\n    rdfs:comment \"The name of an organization.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:hasAddressLine a owl:DatatypeProperty ;\n    rdfs:label \"has address line\" ;\n    rdfs:comment \"A line of an address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:hasGLN a owl:DatatypeProperty ;\n    rdfs:label \"has GLN\" ;\n    rdfs:comment \"The Global Location Number identifier.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:hasNetPrice a owl:DatatypeProperty ;\n    rdfs:label \"has net price\" ;\n    rdfs:comment \"The net price of an item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal ;\n    owl:FunctionalProperty .\n\n:hasQuantity a owl:DatatypeProperty ;\n    rdfs:label \"has quantity\" ;\n    rdfs:comment \"The quantity of an item in a line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:integer ;\n    owl:FunctionalProperty .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n    rdfs:label \"has invoice amount\" ;\n    rdfs:comment \"The total amount for the invoice.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal ;\n    owl:FunctionalProperty .\n\n:hasTaxAmount a owl:DatatypeProperty ;\n    rdfs:label \"has tax amount\" ;\n    rdfs:comment \"The total tax amount for the invoice.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal ;\n    owl:FunctionalProperty .\n\n:hasItemDescription a owl:DatatypeProperty ;\n    rdfs:label \"has item description\" ;\n    rdfs:comment \"A description of an item.\" ;\n    rdfs:domain :Item ;\n    rdfs:range xsd:string ;\n    owl:FunctionalProperty .\n\n:hasMandatoryIdentifier a owl:DatatypeProperty ;\n    rdfs:label \"has mandatory identifier\" ;\n    rdfs:comment \"A mandatory identifier required by D96A for invoice validity.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range xsd:string .\n\n#################################################################\n# Class Hierarchies and Disjointness\n#################################################################\n:WarehouseAddress owl:disjointWith :HeadquartersAddress .\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n\n#################################################################\n# Disjoint Union\n#################################################################\n:InvoiceMessage owl:disjointUnionOf ( :InvoiceHeader :InvoiceDetail :InvoiceSummary ) .\n\n#################################################################\n# General Class Axioms and Restrictions\n#################################################################\n# (Examples for deep structure, not exhaustive)\n\n:RoleAssignment owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :involvesOrganization ; owl:someValuesFrom :Organization ]\n        [ a owl:Restriction ; owl:onProperty :hasAgentRole ; owl:someValuesFrom :AgentRole ]\n    )\n] .\n\n:LineItem owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n        [ a owl:Restriction ; owl:onProperty :describesItem ; owl:someValuesFrom :Item ]\n        [ a owl:Restriction ; owl:onProperty :hasPrice ; owl:someValuesFrom :Price ]\n    )\n] .\n\n:InvoiceMessage rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasRoleAssignment ;\n    owl:allValuesFrom :RoleAssignment\n] .\n\n:InvoiceDetail rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasLineItem ;\n    owl:allValuesFrom :LineItem\n] .\n\n:InvoiceSummary rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :hasTax ;\n    owl:someValuesFrom :Tax\n] .\n\n#################################################################\n# Annotation Properties\n#################################################################\n# (All rdfs:label and rdfs:comment are provided above)\n"
}
