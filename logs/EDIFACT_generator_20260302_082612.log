      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:EDIFACTOntology rdf:type owl:Ontology ;\n  rdfs:label \"EDIFACT D96A INVOIC Ontology\" ;\n  rdfs:comment \"Ontology for modeling UN/EDIFACT D96A invoice messages, roles, segments, and compliance requirements.\" .\n\n### Classes\n:InterchangeEnvelope rdf:type owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"Top-level envelope containing EDIFACT messages.\" .\n\n:Message rdf:type owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage rdf:type owl:Class ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An INVOIC message representing a business invoice.\" ;\n  rdfs:subClassOf :Message .\n\n:Segment rdf:type owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment within an EDIFACT message.\" .\n\n:BGMSegment rdf:type owl:Class ;\n  rdfs:label \"BGM Segment\" ;\n  rdfs:comment \"Beginning of Message segment for document identification.\" ;\n  rdfs:subClassOf :Segment .\n\n:NADSegment rdf:type owl:Class ;\n  rdfs:label \"NAD Segment\" ;\n  rdfs:comment \"Name and Address segment for participant details.\" ;\n  rdfs:subClassOf :Segment .\n\n:CompositeDataElement rdf:type owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"Composite element within a segment.\" .\n\n:SimpleDataElement rdf:type owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"Simple element within a composite or segment.\" .\n\n:HeaderSection rdf:type owl:Class ;\n  rdfs:label \"Header Section\" ;\n  rdfs:comment \"Header section of an invoice message, containing dates and reference numbers.\" ;\n  rdfs:subClassOf :Segment .\n\n:DetailSection rdf:type owl:Class ;\n  rdfs:label \"Detail Section\" ;\n  rdfs:comment \"Detail section listing line items.\" ;\n  rdfs:subClassOf :Segment .\n\n:SummarySection rdf:type owl:Class ;\n  rdfs:label \"Summary Section\" ;\n  rdfs:comment \"Summary section containing totals and tax.\" ;\n  rdfs:subClassOf :Segment .\n\n:Organization rdf:type owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the invoice (buyer, supplier, delivery party, etc.).\" ;\n  rdfs:subClassOf :P2POEntity .\n\n:AgentRole rdf:type owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"Role played by an organization in a transaction (Buyer, Supplier, Delivery Party, etc.).\" .\n\n:RoleAssignment rdf:type owl:Class ;\n  rdfs:label \"Role Assignment\" ;\n  rdfs:comment \"Pivot class linking organizations to roles in a specific invoice context.\" .\n\n:Address rdf:type owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"Address of an organization (headquarters, warehouse, etc.).\" ;\n  rdfs:subClassOf :P2POEntity .\n\n:Item rdf:type owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"An item sold in the invoice.\" ;\n  rdfs:subClassOf :P2POEntity .\n\n:LineItem rdf:type owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in the invoice, linking item, price, and quantity.\" .\n\n:Price rdf:type owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"Price of an item.\" ;\n  rdfs:subClassOf :P2POEntity .\n\n:Tax rdf:type owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"Tax information in the summary section.\" ;\n  rdfs:subClassOf :P2POEntity .\n\n:ReferenceNumber rdf:type owl:Class ;\n  rdfs:label \"Reference Number\" ;\n  rdfs:comment \"Reference number for document identification.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"Business process to which the invoice is assigned.\" .\n\n:Identifier rdf:type owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"Generic identifier class.\" .\n\n:GLNIdentifier rdf:type owl:Class ;\n  rdfs:label \"GLN Identifier\" ;\n  rdfs:comment \"Global Location Number identifier for organizations.\" ;\n  rdfs:subClassOf :Identifier .\n\n:EN16931Compliance rdf:type owl:Class ;\n  rdfs:label \"EN 16931 Compliance\" ;\n  rdfs:comment \"Compliance class for European Standard EN 16931-1.\" .\n\n:P2POEntity rdf:type owl:Class ;\n  rdfs:label \"P2P-O Entity\" ;\n  rdfs:comment \"Entity defined in the Purchase-to-Pay Ontology.\" .\n\n:SHACLConstraint rdf:type owl:Class ;\n  rdfs:label \"SHACL Constraint\" ;\n  rdfs:comment \"Constraint used for automated validation of invoice data.\" .\n\n### Disjointness\n:Organization owl:disjointWith :Item .\n:Price owl:disjointWith :Tax .\n:Address owl:disjointWith :Item .\n:Message owl:disjointWith :Segment .\n:CompositeDataElement owl:disjointWith :SimpleDataElement .\n\n### Properties\n:containsMessage rdf:type owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Links InterchangeEnvelope to contained Messages.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  owl:FunctionalProperty .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Links Message to its Segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:hasHeaderSection rdf:type owl:ObjectProperty ;\n  rdfs:label \"has header section\" ;\n  rdfs:comment \"Links InvoiceMessage to its HeaderSection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :HeaderSection ;\n  owl:FunctionalProperty .\n\n:hasDetailSection rdf:type owl:ObjectProperty ;\n  rdfs:label \"has detail section\" ;\n  rdfs:comment \"Links InvoiceMessage to its DetailSection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :DetailSection ;\n  owl:FunctionalProperty .\n\n:hasSummarySection rdf:type owl:ObjectProperty ;\n  rdfs:label \"has summary section\" ;\n  rdfs:comment \"Links InvoiceMessage to its SummarySection.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SummarySection ;\n  owl:FunctionalProperty .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links DetailSection to its LineItems.\" ;\n  rdfs:domain :DetailSection ;\n  rdfs:range :LineItem .\n\n:hasRoleAssignment rdf:type owl:ObjectProperty ;\n  rdfs:label \"has role assignment\" ;\n  rdfs:comment \"Links InvoiceMessage to RoleAssignment pivot class.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :RoleAssignment .\n\n:assignsRole rdf:type owl:ObjectProperty ;\n  rdfs:label \"assigns role\" ;\n  rdfs:comment \"Links RoleAssignment to AgentRole.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :AgentRole ;\n  owl:FunctionalProperty .\n\n:assignedTo rdf:type owl:ObjectProperty ;\n  rdfs:label \"assigned to\" ;\n  rdfs:comment \"Links RoleAssignment to Organization.\" ;\n  rdfs:domain :RoleAssignment ;\n  rdfs:range :Organization ;\n  owl:FunctionalProperty .\n\n:hasAddress rdf:type owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links Organization to its Address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasGLNIdentifier rdf:type owl:ObjectProperty ;\n  rdfs:label \"has GLN identifier\" ;\n  rdfs:comment \"Links Organization to its GLNIdentifier.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :GLNIdentifier ;\n  owl:FunctionalProperty .\n\n:hasReferenceNumber rdf:type owl:ObjectProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"Links InvoiceMessage to ReferenceNumber.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :ReferenceNumber ;\n  owl:FunctionalProperty .\n\n:hasTax rdf:type owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Links SummarySection to Tax.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range :Tax .\n\n:hasInvoiceAmount rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"Links SummarySection to the invoice amount.\" ;\n  rdfs:domain :SummarySection ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:hasInvoiceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"Links InvoiceMessage to its invoice number.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasDate rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has date\" ;\n  rdfs:comment \"Links HeaderSection to relevant dates.\" ;\n  rdfs:domain :HeaderSection ;\n  rdfs:range xsd:string .\n\n:hasNetPrice rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"Links LineItem to net price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:hasQuantity rdf:type owl:DatatypeProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"Links LineItem to item quantity.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:compliesWithEN16931 rdf:type owl:ObjectProperty ;\n  rdfs:label \"complies with EN 16931\" ;\n  rdfs:comment \"Links InvoiceMessage to EN16931Compliance.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :EN16931Compliance ;\n  owl:FunctionalProperty .\n\n:validatedBySHACL rdf:type owl:ObjectProperty ;\n  rdfs:label \"validated by SHACL\" ;\n  rdfs:comment \"Links InvoiceMessage to SHACLConstraint for validation.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :SHACLConstraint .\n\n:assignedToBusinessProcess rdf:type owl:ObjectProperty ;\n  rdfs:label \"assigned to business process\" ;\n  rdfs:comment \"Links InvoiceMessage to BusinessProcess.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  owl:FunctionalProperty .\n\n:hasItem rdf:type owl:ObjectProperty ;\n  rdfs:label \"has item\" ;\n  rdfs:comment \"Links LineItem to Item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item ;\n  owl:FunctionalProperty .\n\n### Property Characteristics\n:containsMessage rdf:type owl:FunctionalProperty .\n:hasHeaderSection rdf:type owl:FunctionalProperty .\n:hasDetailSection rdf:type owl:FunctionalProperty .\n:hasSummarySection rdf:type owl:FunctionalProperty .\n:assignsRole rdf:type owl:FunctionalProperty .\n:assignedTo rdf:type owl:FunctionalProperty .\n:hasGLNIdentifier rdf:type owl:FunctionalProperty .\n:hasReferenceNumber rdf:type owl:FunctionalProperty .\n:hasInvoiceAmount rdf:type owl:FunctionalProperty .\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\n:hasNetPrice rdf:type owl:FunctionalProperty .\n:hasItem rdf:type owl:FunctionalProperty .\n:compliesWithEN16931 rdf:type owl:FunctionalProperty .\n:assignedToBusinessProcess rdf:type owl:FunctionalProperty .\n\n### Restrictions\n:BuyerRoleAssignment rdf:type owl:Class ;\n  rdfs:label \"Buyer Role Assignment\" ;\n  rdfs:comment \"RoleAssignment where AgentRole is Buyer.\" ;\n  owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :assignsRole ; owl:allValuesFrom :AgentRole ] .\n\n:OrganizationWithGLN rdf:type owl:Class ;\n  rdfs:label \"Organization with GLN\" ;\n  rdfs:comment \"Organization with a GLN identifier.\" ;\n  owl:equivalentClass [ rdf:type owl:Restriction ; owl:onProperty :hasGLNIdentifier ; owl:someValuesFrom :GLNIdentifier ] .\n\n### General Class Axioms\n[ rdf:type owl:Restriction ; owl:onProperty :hasRoleAssignment ; owl:someValuesFrom :RoleAssignment ; rdfs:subClassOf :InvoiceMessage ] .\n[ rdf:type owl:Restriction ; owl:onProperty :hasSegment ; owl:someValuesFrom :Segment ; rdfs:subClassOf :Message ] .\n"
}
