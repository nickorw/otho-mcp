        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology#EDIFACT_INVOIC_Ontology> a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A deep and profoundly structured ontology for UN/EDIFACT INVOIC messages (D96A/EANCOM), supporting procurement, validation, and semantic interoperability.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"The outermost envelope containing one or more EDIFACT messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"EDIFACT Message\\\" ;\\n    rdfs:comment \\\"A business message within an interchange envelope, e.g., INVOIC.\\\" .\\n\\n:Invoice a owl:Class ;\\n    rdfs:subClassOf :Message ;\\n    rdfs:label \\\"Invoice\\\" ;\\n    rdfs:comment \\\"A specific EDIFACT message representing an invoice transaction.\\\" .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A unit within a message, e.g., BGM, NAD, LIN.\\\" .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"Composite Data Element\\\" ;\\n    rdfs:comment \\\"A composite grouping of simple data elements within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"Simple Data Element\\\" ;\\n    rdfs:comment \\\"An atomic value within a composite or segment.\\\" .\\n\\n:HeaderSection a owl:Class ;\\n    rdfs:subClassOf :Invoice ;\\n    rdfs:label \\\"Header Section\\\" ;\\n    rdfs:comment \\\"The header part of an invoice, containing document-level data such as dates and references.\\\" .\\n\\n:DetailSection a owl:Class ;\\n    rdfs:subClassOf :Invoice ;\\n    rdfs:label \\\"Detail Section\\\" ;\\n    rdfs:comment \\\"The detail part of an invoice, listing line items.\\\" .\\n\\n:SummarySection a owl:Class ;\\n    rdfs:subClassOf :Invoice ;\\n    rdfs:label \\\"Summary Section\\\" ;\\n    rdfs:comment \\\"The summary part of an invoice, providing totals and tax information.\\\" .\\n\\n:SectionUnion a owl:Class ;\\n    owl:disjointUnionOf ( :HeaderSection :DetailSection :SummarySection ) ;\\n    rdfs:label \\\"Invoice Section Union\\\" ;\\n    rdfs:comment \\\"A union class for header, detail, and summary sections of an invoice.\\\" .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"A business entity involved in the transaction, e.g., buyer, supplier, delivery party.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"Agent Role\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the invoice context (e.g., Buyer, Supplier, Delivery Party).\\\" .\\n\\n:Pivot_OrganizationRole a owl:Class ;\\n    rdfs:label \\\"Organization-Role Assignment\\\" ;\\n    rdfs:comment \\\"A reification class to link organizations with their roles in a specific invoice context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A postal or physical address associated with an organization.\\\" .\\n\\n:Identifier a owl:Class ;\\n    rdfs:label \\\"Identifier\\\" ;\\n    rdfs:comment \\\"A business identifier, such as a Global Location Number (GLN).\\\" .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"A product or service listed on an invoice.\\\" .\\n\\n:Pivot_ItemInvoice a owl:Class ;\\n    rdfs:label \\\"Item-Invoice Assignment\\\" ;\\n    rdfs:comment \\\"A reification class to link items, quantities, and prices in an invoice line.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"A monetary value associated with an item or invoice.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"A measured amount of an item.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"A tax component applied to the invoice.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"Business Process\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"Validation Constraint\\\" ;\\n    rdfs:comment \\\"A constraint or rule for automated validation, e.g., SHACL shapes.\\\" .\\n\\n#################################################################\\n# Object Properties\\n#################################################################\\n\\n:hasMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"has message\\\" ;\\n    rdfs:comment \\\"Links an interchange envelope to a message.\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message .\\n:hasMessage rdf:type owl:FunctionalProperty .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has segment\\\" ;\\n    rdfs:comment \\\"Links a message to its segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has composite element\\\" ;\\n    rdfs:comment \\\"Links a segment to its composite data elements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"has simple element\\\" ;\\n    rdfs:comment \\\"Links a composite data element to its simple data elements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement .\\n\\n:hasInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"has invoice\\\" ;\\n    rdfs:comment \\\"Links a message to an invoice.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Invoice .\\n\\n:hasSection a owl:ObjectProperty ;\\n    rdfs:label \\\"has section\\\" ;\\n    rdfs:comment \\\"Links an invoice to its sections (header, detail, summary).\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :SectionUnion .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Links an invoice to its header section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :HeaderSection .\\n:hasHeader rdf:type owl:FunctionalProperty .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Links an invoice to its detail section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :DetailSection .\\n:hasDetail rdf:type owl:FunctionalProperty .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Links an invoice to its summary section.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :SummarySection .\\n:hasSummary rdf:type owl:FunctionalProperty .\\n\\n:hasOrganizationRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has organization role\\\" ;\\n    rdfs:comment \\\"Links an invoice to a pivot class for organization-role assignments.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Pivot_OrganizationRole .\\n\\n:hasRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Links a pivot organization-role to a role.\\\" ;\\n    rdfs:domain :Pivot_OrganizationRole ;\\n    rdfs:range :AgentRole .\\n\\n:hasOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"has organization\\\" ;\\n    rdfs:comment \\\"Links a pivot organization-role to an organization.\\\" ;\\n    rdfs:domain :Pivot_OrganizationRole ;\\n    rdfs:range :Organization .\\n\\n:hasAddress a owl:ObjectProperty ;\\n    rdfs:label \\\"has address\\\" ;\\n    rdfs:comment \\\"Links an organization to its address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address .\\n\\n:hasIdentifier a owl:ObjectProperty ;\\n    rdfs:label \\\"has identifier\\\" ;\\n    rdfs:comment \\\"Links an organization to its identifier.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Identifier .\\n\\n:hasItemInvoice a owl:ObjectProperty ;\\n    rdfs:label \\\"has item invoice\\\" ;\\n    rdfs:comment \\\"Links an invoice to a pivot class for item-invoice assignments.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :Pivot_ItemInvoice .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"has item\\\" ;\\n    rdfs:comment \\\"Links a pivot item-invoice to an item.\\\" ;\\n    rdfs:domain :Pivot_ItemInvoice ;\\n    rdfs:range :Item .\\n\\n:hasNetPrice a owl:ObjectProperty ;\\n    rdfs:label \\\"has net price\\\" ;\\n    rdfs:comment \\\"Links a pivot item-invoice to a price.\\\" ;\\n    rdfs:domain :Pivot_ItemInvoice ;\\n    rdfs:range :Price .\\n\\n:hasQuantity a owl:ObjectProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Links a pivot item-invoice to a quantity.\\\" ;\\n    rdfs:domain :Pivot_ItemInvoice ;\\n    rdfs:range :Quantity .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links a summary section to a tax.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range :Tax .\\n\\n:hasBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"has business process\\\" ;\\n    rdfs:comment \\\"Links an invoice to a business process.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :BusinessProcess .\\n\\n:hasValidationConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"has validation constraint\\\" ;\\n    rdfs:comment \\\"Links an invoice to a validation constraint, e.g., SHACL shapes.\\\" ;\\n    rdfs:domain :Invoice ;\\n    rdfs:range :ValidationConstraint .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasInvoiceAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice amount\\\" ;\\n    rdfs:comment \\\"The total monetary amount of the invoice.\\\" ;\\n    rdfs:domain :SummarySection ;\\n    rdfs:range xsd:decimal .\\n\\n:hasInvoiceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has invoice number\\\" ;\\n    rdfs:comment \\\"The unique number assigned to the invoice.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n:hasInvoiceNumber rdf:type owl:FunctionalProperty .\\n\\n:hasDocumentDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"has document date\\\" ;\\n    rdfs:comment \\\"The date the invoice was created.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n:hasReferenceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"has reference number\\\" ;\\n    rdfs:comment \\\"A reference number in the invoice header.\\\" ;\\n    rdfs:domain :HeaderSection ;\\n    rdfs:range xsd:string .\\n\\n:hasGLN a owl:DatatypeProperty ;\\n    rdfs:label \\\"has GLN\\\" ;\\n    rdfs:comment \\\"The Global Location Number identifier for an organization.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Disjointness\\n#################################################################\\n\\n:Address owl:disjointWith :Identifier .\\n:HeaderSection owl:disjointWith :DetailSection, :SummarySection .\\n:DetailSection owl:disjointWith :SummarySection .\\n:AgentRole owl:disjointWith :Organization .\\n:Item owl:disjointWith :Organization .\\n\\n#################################################################\\n# Example Advanced Axioms\\n#################################################################\\n\\n:Buyer a :AgentRole ;\\n    rdfs:label \\\"Buyer\\\" ;\\n    rdfs:comment \\\"The organization that purchases goods or services.\\\" .\\n\\n:Supplier a :AgentRole ;\\n    rdfs:label \\\"Supplier\\\" ;\\n    rdfs:comment \\\"The organization that supplies goods or services.\\\" .\\n\\n:DeliveryParty a :AgentRole ;\\n    rdfs:label \\\"Delivery Party\\\" ;\\n    rdfs:comment \\\"The organization to which goods are delivered.\\\" .\\n\\n:Pivot_OrganizationRole owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :hasOrganization ; owl:someValuesFrom :Organization ]\\n        [ a owl:Restriction ; owl:onProperty :hasRole ; owl:someValuesFrom :AgentRole ]\\n    )\\n] .\\n\\n:Pivot_ItemInvoice owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :hasItem ; owl:someValuesFrom :Item ]\\n        [ a owl:Restriction ; owl:onProperty :hasNetPrice ; owl:someValuesFrom :Price ]\\n        [ a owl:Restriction ; owl:onProperty :hasQuantity ; owl:someValuesFrom :Quantity ]\\n    )\\n] .\\n\\n:Invoice owl:equivalentClass [\\n    a owl:Class ;\\n    owl:intersectionOf (\\n        [ a owl:Restriction ; owl:onProperty :hasHeader ; owl:allValuesFrom :HeaderSection ]\\n        [ a owl:Restriction ; owl:onProperty :hasDetail ; owl:allValuesFrom :DetailSection ]\\n        [ a owl:Restriction ; owl:onProperty :hasSummary ; owl:allValuesFrom :SummarySection ]\\n    )\\n] .\\n\\n#################################################################\\n# Property Characteristics\\n#################################################################\\n\\n# All property characteristics declared above with rdf:type owl:FunctionalProperty\\n\\n#################################################################\\n# Annotations for all classes and properties are included above\\n#################################################################\\n\"}",
