sQuantity a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has quantity\\\" ;\\n    rdfs:comment \\\"Links an Item to its Quantity.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Quantity .\\n\\n:isQuantityOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is quantity of\\\" ;\\n    rdfs:comment \\\"Inverse of hasQuantity.\\\" ;\\n    rdfs:domain :Quantity ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :hasQuantity .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"has tax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its Tax information.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :Tax .\\n\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is tax of\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:inverseOf :hasTax .\\n\\n:isAssignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"is assigned to business process\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a Business Process.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n    rdfs:label \\\"is business process of\\\" ;\\n    rdfs:comment \\\"Inverse of isAssignedToBusinessProcess.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :isAssignedToBusinessProcess .\\n\\n:validatesWithConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"validates with constraint\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a Validation Constraint.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint .\\n\\n:isConstraintFor a owl:ObjectProperty ;\\n    rdfs:label \\\"is constraint for\\\" ;\\n    rdfs:comment \\\"Inverse of validatesWithConstraint.\\\" ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :validatesWithConstraint .\\n\\n# Segment-level object properties (inverses omitted for brevity, but can be added similarly)\\n:hasDTMSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has DTM segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a DTM segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DTM_Segment .\\n\\n:hasRFFSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has RFF segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a RFF segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :RFF_Segment .\\n\\n:hasCUXSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has CUX segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a CUX segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :CUX_Segment .\\n\\n:hasMOASegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has MOA segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a MOA segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :MOA_Segment .\\n\\n:hasLINSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has LIN segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a LIN segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :LIN_Segment .\\n\\n:hasPRISegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has PRI segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a PRI segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :PRI_Segment .\\n\\n:hasQTYSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has QTY segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a QTY segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :QTY_Segment .\\n\\n:hasTAXSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has TAX segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a TAX segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :TAX_Segment .\\n\\n:hasALCSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has ALC segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to an ALC segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ALC_Segment .\\n\\n:hasPACSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has PAC segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a PAC segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :PAC_Segment .\\n\\n:hasTDTSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has TDT segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a TDT segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :TDT_Segment .\\n\\n:hasDOCSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has DOC segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a DOC segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DOC_Segment .\\n\\n:hasLOCSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has LOC segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a LOC segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :LOC_Segment .\\n\\n:hasUNSSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has UNS segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a UNS segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNS_Segment .\\n\\n:hasPIASegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has PIA segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a PIA segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :PIA_Segment .\\n\\n:hasFTXSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has FTX segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a FTX segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :FTX_Segment .\\n\\n:hasMEASegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has MEA segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a MEA segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :MEA_Segment .\\n\\n:hasGIRSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has GIR segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a GIR segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :GIR_Segment .\\n\\n:hasPATSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has PAT segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a PAT segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :PAT_Segment .\\n\\n:hasUNHSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has UNH segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a UNH segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNH_Segment .\\n\\n:hasUNTSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has UNT segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a UNT segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :UNT_Segment .\\n\\n:hasTODSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"has TOD segment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a TOD segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :TOD_Segment .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n\\n:hasGlobalLocationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has global location number\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Global Location Number (GLN).\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range xsd:string .\\n\\n:invoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"invoice amount\\\" ;\\n    rdfs:comment \\\"Represents the invoice total amount in the summary section.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"Represents the invoice number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"Represents the document date in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"reference number\\\" ;\\n    rdfs:comment \\\"Represents a reference number in the header section.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:mandatoryIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"mandatory identifier\\\" ;\\n    rdfs:comment \\\"Represents a mandatory identifier required by validation constraints.\\\" ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range xsd:string .\\n\\n#################################################################\\n# Hierarchy, DisjointUnion, DisjointWith\\n#################################################################\\n\\n:InvoiceMessage owl:disjointUnionOf (:InvoiceHeader :InvoiceDetail :InvoiceSummary) .\\n:Segment owl:disjointUnionOf (:BGM_Segment :NAD_Segment :DTM_Segment :RFF_Segment :CUX_Segment :MOA_Segment :LIN_Segment :PRI_Segment :QTY_Segment :TAX_Segment :ALC_Segment :PAC_Segment :TDT_Segment :DOC_Segment :LOC_Segment :UNS_Segment :PIA_Segment :FTX_Segment :MEA_Segment :GIR_Segment :PAT_Segment :UNH_Segment :UNT_Segment :TOD_Segment) .\\n\\n:Organization owl:disjointWith :Item , :BusinessProcess .\\n:AgentRole owl:disjointWith :Address , :GlobalLocationNumber .\\n\\n#################################################################\\n# General Class Axioms, Restrictions, Equivalences\\n#################################################################\\n\\n# Removed recursive equivalentClass for Buyer/Supplier.\\n:Buyer a owl:Class ;\\n    rdfs:label \\\"Buyer\\\" ;\\n    rdfs:comment \\\"A specialized AgentRole for the buyer organization.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n:Supplier a owl:Class ;\\n    rdfs:label \\\"Supplier\\\" ;\\n    rdfs:comment \\\"A specialized AgentRole for the supplier organization.\\\" ;\\n    rdfs:subClassOf :AgentRole .\\n\\n#################################################################\\n# Annotations\\n#################################################################\\n# All classes and properties above include rdfs:label and rdfs:comment annotations.\\n\"}",
