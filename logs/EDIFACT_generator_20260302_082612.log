      "function": {
        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n:EDIFACT_INVOIC_Ontology a owl:Ontology ;\\n    rdfs:label \\\"EDIFACT INVOIC Ontology\\\" ;\\n    rdfs:comment \\\"A deeply structured ontology for UN/EDIFACT D96A INVOIC messages, covering all mandatory and recommended segments, roles, and business processes, aligned with EN 16931-1 and P2P-O.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n\\n:InterchangeEnvelope a owl:Class ;\\n    rdfs:label \\\"Interchange Envelope\\\" ;\\n    rdfs:comment \\\"Top-level envelope for an EDIFACT interchange, containing messages.\\\" .\\n\\n:Message a owl:Class ;\\n    rdfs:label \\\"Message\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT message contained within an Interchange Envelope.\\\" .\\n\\n:InvoiceMessage a owl:Class ;\\n    rdfs:label \\\"Invoice Message\\\" ;\\n    rdfs:comment \\\"An INVOIC message representing a global trade transaction.\\\" ;\\n    rdfs:subClassOf :Message .\\n\\n:Segment a owl:Class ;\\n    rdfs:label \\\"Segment\\\" ;\\n    rdfs:comment \\\"A generic EDIFACT segment, part of a message.\\\" .\\n\\n# Segment subclasses\\n:BGM_Segment a owl:Class ;\\n    rdfs:label \\\"BeginningOfMessageSegment\\\" ;\\n    rdfs:comment \\\"Segment identifying the document type and number (BGM).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:NAD_Segment a owl:Class ;\\n    rdfs:label \\\"NameAndAddressSegment\\\" ;\\n    rdfs:comment \\\"Segment providing participant (organization) details (NAD).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:DTM_Segment a owl:Class ;\\n    rdfs:label \\\"DateTimePeriodSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying dates relevant to the invoice (DTM).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:RFF_Segment a owl:Class ;\\n    rdfs:label \\\"ReferenceSegment\\\" ;\\n    rdfs:comment \\\"Segment containing reference numbers such as purchase order or invoice reference (RFF).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:CUX_Segment a owl:Class ;\\n    rdfs:label \\\"CurrencySegment\\\" ;\\n    rdfs:comment \\\"Segment specifying currency details (CUX).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:MOA_Segment a owl:Class ;\\n    rdfs:label \\\"MonetaryAmountSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying monetary amounts (MOA).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:LIN_Segment a owl:Class ;\\n    rdfs:label \\\"LineItemSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying invoice line items (LIN).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:PRI_Segment a owl:Class ;\\n    rdfs:label \\\"PriceSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying price details (PRI).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:QTY_Segment a owl:Class ;\\n    rdfs:label \\\"QuantitySegment\\\" ;\\n    rdfs:comment \\\"Segment specifying quantity details (QTY).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:TAX_Segment a owl:Class ;\\n    rdfs:label \\\"TaxSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying tax details (TAX).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:ALC_Segment a owl:Class ;\\n    rdfs:label \\\"AllowanceOrChargeSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying allowances or charges (ALC).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:PAC_Segment a owl:Class ;\\n    rdfs:label \\\"PackageSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying packaging details (PAC).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:TDT_Segment a owl:Class ;\\n    rdfs:label \\\"TransportDetailsSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying transport details (TDT).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:DOC_Segment a owl:Class ;\\n    rdfs:label \\\"DocumentSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying additional document references (DOC).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:LOC_Segment a owl:Class ;\\n    rdfs:label \\\"LocationSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying locations (LOC).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:UNS_Segment a owl:Class ;\\n    rdfs:label \\\"SectionDelimiterSegment\\\" ;\\n    rdfs:comment \\\"Segment delimiting sections of the invoice (UNS).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:PIA_Segment a owl:Class ;\\n    rdfs:label \\\"AdditionalProductIDSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying additional product identifiers (PIA).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:FTX_Segment a owl:Class ;\\n    rdfs:label \\\"FreeTextSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying free text notes (FTX).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:MEA_Segment a owl:Class ;\\n    rdfs:label \\\"MeasurementsSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying measurements (MEA).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:GIR_Segment a owl:Class ;\\n    rdfs:label \\\"RelatedIdentificationNumbersSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying related identification numbers (GIR).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:PAT_Segment a owl:Class ;\\n    rdfs:label \\\"PaymentTermsSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying payment terms (PAT).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:UNH_Segment a owl:Class ;\\n    rdfs:label \\\"MessageHeaderSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying message header details (UNH).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:UNT_Segment a owl:Class ;\\n    rdfs:label \\\"MessageTrailerSegment\\\" ;\\n    rdfs:comment \\\"Segment specifying message trailer details (UNT).\\\" ;\\n    rdfs:subClassOf :Segment .\\n:TOD_Segment a owl:Class ;\\n    rdfs:label \\\"TermsOfDeliverySegment\\\" ;\\n    rdfs:comment \\\"Segment specifying terms of delivery (TOD).\\\" ;\\n    rdfs:subClassOf :Segment .\\n\\n:CompositeDataElement a owl:Class ;\\n    rdfs:label \\\"CompositeDataElement\\\" ;\\n    rdfs:comment \\\"A composite data element within a segment.\\\" .\\n\\n:SimpleDataElement a owl:Class ;\\n    rdfs:label \\\"SimpleDataElement\\\" ;\\n    rdfs:comment \\\"A simple data element within a composite data element.\\\" .\\n\\n:InvoiceHeader a owl:Class ;\\n    rdfs:label \\\"InvoiceHeader\\\" ;\\n    rdfs:comment \\\"Header section of an invoice message.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:InvoiceDetail a owl:Class ;\\n    rdfs:label \\\"InvoiceDetail\\\" ;\\n    rdfs:comment \\\"Detail section of an invoice message.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:InvoiceSummary a owl:Class ;\\n    rdfs:label \\\"InvoiceSummary\\\" ;\\n    rdfs:comment \\\"Summary section of an invoice message.\\\" ;\\n    rdfs:subClassOf :InvoiceMessage .\\n\\n:Organization a owl:Class ;\\n    rdfs:label \\\"Organization\\\" ;\\n    rdfs:comment \\\"An organization involved in the invoice.\\\" .\\n\\n:AgentRole a owl:Class ;\\n    rdfs:label \\\"AgentRole\\\" ;\\n    rdfs:comment \\\"A role played by an organization in the invoice context (e.g., Buyer, Supplier, Delivery Party).\\\" .\\n\\n:PivotOrganizationRoleAssignment a owl:Class ;\\n    rdfs:label \\\"PivotOrganizationRoleAssignment\\\" ;\\n    rdfs:comment \\\"A reification class linking an Organization, its Agent Role, and the InvoiceMessage context.\\\" .\\n\\n:Address a owl:Class ;\\n    rdfs:label \\\"Address\\\" ;\\n    rdfs:comment \\\"A physical address associated with an organization.\\\" .\\n\\n:GlobalLocationNumber a owl:Class ;\\n    rdfs:label \\\"GlobalLocationNumber\\\" ;\\n    rdfs:comment \\\"A unique identifier for organization locations (GLN); subclass of SimpleDataElement.\\\" ;\\n    rdfs:subClassOf :SimpleDataElement .\\n\\n:Item a owl:Class ;\\n    rdfs:label \\\"Item\\\" ;\\n    rdfs:comment \\\"An item listed in the invoice.\\\" .\\n\\n:Price a owl:Class ;\\n    rdfs:label \\\"Price\\\" ;\\n    rdfs:comment \\\"Net price of an item in the invoice.\\\" .\\n\\n:Quantity a owl:Class ;\\n    rdfs:label \\\"Quantity\\\" ;\\n    rdfs:comment \\\"Quantity of an item in the invoice.\\\" .\\n\\n:Tax a owl:Class ;\\n    rdfs:label \\\"Tax\\\" ;\\n    rdfs:comment \\\"Tax information for the invoice.\\\" .\\n\\n:BusinessProcess a owl:Class ;\\n    rdfs:label \\\"BusinessProcess\\\" ;\\n    rdfs:comment \\\"A business process to which the invoice is assigned.\\\" .\\n\\n:ValidationConstraint a owl:Class ;\\n    rdfs:label \\\"ValidationConstraint\\\" ;\\n    rdfs:comment \\\"Constraint for automated validation of the invoice (e.g., SHACL, mandatory identifiers).\\\" .\\n\\n#################################################################\\n# Object Properties (with inverses and improved annotations)\\n#################################################################\\n\\n:containsMessage a owl:ObjectProperty ;\\n    rdfs:label \\\"containsMessage\\\" ;\\n    rdfs:comment \\\"Links an InterchangeEnvelope to its contained Messages.\\\" ;\\n    rdfs:domain :InterchangeEnvelope ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :containedInEnvelope .\\n\\n:containedInEnvelope a owl:ObjectProperty ;\\n    rdfs:label \\\"containedInEnvelope\\\" ;\\n    rdfs:comment \\\"Inverse of containsMessage; links a Message to its InterchangeEnvelope.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :InterchangeEnvelope ;\\n    owl:inverseOf :containsMessage .\\n\\n:hasSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasSegment\\\" ;\\n    rdfs:comment \\\"Links a Message to its constituent Segments.\\\" ;\\n    rdfs:domain :Message ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :isSegmentOf .\\n\\n:isSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isSegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasSegment; links a Segment to its parent Message.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :Message ;\\n    owl:inverseOf :hasSegment .\\n\\n:hasCompositeElement a owl:ObjectProperty ;\\n    rdfs:label \\\"hasCompositeElement\\\" ;\\n    rdfs:comment \\\"Links a Segment to its CompositeDataElements.\\\" ;\\n    rdfs:domain :Segment ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :isCompositeElementOf .\\n\\n:isCompositeElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isCompositeElementOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasCompositeElement.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :Segment ;\\n    owl:inverseOf :hasCompositeElement .\\n\\n:hasSimpleElement a owl:ObjectProperty ;\\n    rdfs:label \\\"hasSimpleElement\\\" ;\\n    rdfs:comment \\\"Links a CompositeDataElement to its SimpleDataElements.\\\" ;\\n    rdfs:domain :CompositeDataElement ;\\n    rdfs:range :SimpleDataElement ;\\n    owl:inverseOf :isSimpleElementOf .\\n\\n:isSimpleElementOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isSimpleElementOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasSimpleElement.\\\" ;\\n    rdfs:domain :SimpleDataElement ;\\n    rdfs:range :CompositeDataElement ;\\n    owl:inverseOf :hasSimpleElement .\\n\\n:hasHeader a owl:ObjectProperty ;\\n    rdfs:label \\\"hasHeader\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its header section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader ;\\n    a owl:FunctionalProperty ;\\n    owl:inverseOf :isHeaderOf .\\n\\n:isHeaderOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isHeaderOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasHeader.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasHeader .\\n\\n:hasDetail a owl:ObjectProperty ;\\n    rdfs:label \\\"hasDetail\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its detail section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceDetail ;\\n    a owl:FunctionalProperty ;\\n    owl:inverseOf :isDetailOf .\\n\\n:isDetailOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isDetailOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasDetail.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasDetail .\\n\\n:hasSummary a owl:ObjectProperty ;\\n    rdfs:label \\\"hasSummary\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to its summary section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSummary ;\\n    a owl:FunctionalProperty ;\\n    owl:inverseOf :isSummaryOf .\\n\\n:isSummaryOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isSummaryOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasSummary.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasSummary .\\n\\n:involvesOrganization a owl:ObjectProperty ;\\n    rdfs:label \\\"involvesOrganization\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to Organizations involved.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :isOrganizationInvolvedIn .\\n\\n:isOrganizationInvolvedIn a owl:ObjectProperty ;\\n    rdfs:label \\\"isOrganizationInvolvedIn\\\" ;\\n    rdfs:comment \\\"Inverse of involvesOrganization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :involvesOrganization .\\n\\n:hasRoleAssignment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasRoleAssignment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a PivotOrganizationRoleAssignment instance.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :PivotOrganizationRoleAssignment ;\\n    owl:inverseOf :isRoleAssignmentOf .\\n\\n:isRoleAssignmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isRoleAssignmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasRoleAssignment.\\\" ;\\n    rdfs:domain :PivotOrganizationRoleAssignment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasRoleAssignment .\\n\\n:assignedRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assignedRole\\\" ;\\n    rdfs:comment \\\"Links a PivotOrganizationRoleAssignment to the AgentRole.\\\" ;\\n    rdfs:domain :PivotOrganizationRoleAssignment ;\\n    rdfs:range :AgentRole ;\\n    owl:inverseOf :isAssignedRoleOf .\\n\\n:isAssignedRoleOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isAssignedRoleOf\\\" ;\\n    rdfs:comment \\\"Inverse of assignedRole.\\\" ;\\n    rdfs:domain :AgentRole ;\\n    rdfs:range :PivotOrganizationRoleAssignment ;\\n    owl:inverseOf :assignedRole .\\n\\n:assignedOrganization a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"assignedOrganization\\\" ;\\n    rdfs:comment \\\"Links a PivotOrganizationRoleAssignment to the Organization.\\\" ;\\n    rdfs:domain :PivotOrganizationRoleAssignment ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :isAssignedOrganizationOf .\\n\\n:isAssignedOrganizationOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isAssignedOrganizationOf\\\" ;\\n    rdfs:comment \\\"Inverse of assignedOrganization.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :PivotOrganizationRoleAssignment ;\\n    owl:inverseOf :assignedOrganization .\\n\\n:hasAddress a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"hasAddress\\\" ;\\n    rdfs:comment \\\"Links an Organization to its Address.\\\" ;\\n    rdfs:domain :Organization ;\\n    rdfs:range :Address ;\\n    owl:inverseOf :isAddressOf .\\n\\n:isAddressOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isAddressOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasAddress.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range :Organization ;\\n    owl:inverseOf :hasAddress .\\n\\n:hasItem a owl:ObjectProperty ;\\n    rdfs:label \\\"hasItem\\\" ;\\n    rdfs:comment \\\"Links an InvoiceDetail to its contained Items.\\\" ;\\n    rdfs:domain :InvoiceDetail ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :isItemOf .\\n\\n:isItemOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isItemOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasItem.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :InvoiceDetail ;\\n    owl:inverseOf :hasItem .\\n\\n:hasPrice a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"hasPrice\\\" ;\\n    rdfs:comment \\\"Links an Item to its Price.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Price ;\\n    owl:inverseOf :isPriceOf .\\n\\n:isPriceOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isPriceOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasPrice.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :hasPrice .\\n\\n:hasQuantity a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"hasQuantity\\\" ;\\n    rdfs:comment \\\"Links an Item to its Quantity.\\\" ;\\n    rdfs:domain :Item ;\\n    rdfs:range :Quantity ;\\n    owl:inverseOf :isQuantityOf .\\n\\n:isQuantityOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isQuantityOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasQuantity.\\\" ;\\n    rdfs:domain :Quantity ;\\n    rdfs:range :Item ;\\n    owl:inverseOf :hasQuantity .\\n\\n:hasTax a owl:ObjectProperty ;\\n    rdfs:label \\\"hasTax\\\" ;\\n    rdfs:comment \\\"Links an InvoiceSummary to its Tax information.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range :Tax ;\\n    owl:inverseOf :isTaxOf .\\n\\n:isTaxOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isTaxOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasTax.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range :InvoiceSummary ;\\n    owl:inverseOf :hasTax .\\n\\n:isAssignedToBusinessProcess a owl:ObjectProperty ;\\n    rdfs:label \\\"isAssignedToBusinessProcess\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a BusinessProcess.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess ;\\n    owl:inverseOf :isBusinessProcessOf .\\n\\n:isBusinessProcessOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isBusinessProcessOf\\\" ;\\n    rdfs:comment \\\"Inverse of isAssignedToBusinessProcess.\\\" ;\\n    rdfs:domain :BusinessProcess ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :isAssignedToBusinessProcess .\\n\\n:validatesWithConstraint a owl:ObjectProperty ;\\n    rdfs:label \\\"validatesWithConstraint\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a ValidationConstraint.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :ValidationConstraint ;\\n    owl:inverseOf :isConstraintFor .\\n\\n:isConstraintFor a owl:ObjectProperty ;\\n    rdfs:label \\\"isConstraintFor\\\" ;\\n    rdfs:comment \\\"Inverse of validatesWithConstraint.\\\" ;\\n    rdfs:domain :ValidationConstraint ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :validatesWithConstraint .\\n\\n# Segment-level object properties (with inverses)\\n:hasDTMSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasDTMSegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a DTM_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :DTM_Segment ;\\n    owl:inverseOf :isDTMSegmentOf .\\n\\n:isDTMSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isDTMSegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasDTMSegment.\\\" ;\\n    rdfs:domain :DTM_Segment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasDTMSegment .\\n\\n:hasRFFSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasRFFSegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a RFF_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :RFF_Segment ;\\n    owl:inverseOf :isRFFSegmentOf .\\n\\n:isRFFSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isRFFSegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasRFFSegment.\\\" ;\\n    rdfs:domain :RFF_Segment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasRFFSegment .\\n\\n:hasCUXSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasCUXSegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a CUX_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :CUX_Segment ;\\n    owl:inverseOf :isCUXSegmentOf .\\n\\n:isCUXSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isCUXSegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasCUXSegment.\\\" ;\\n    rdfs:domain :CUX_Segment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasCUXSegment .\\n\\n:hasMOASegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasMOASegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a MOA_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :MOA_Segment ;\\n    owl:inverseOf :isMOASegmentOf .\\n\\n:isMOASegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isMOASegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasMOASegment.\\\" ;\\n    rdfs:domain :MOA_Segment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasMOASegment .\\n\\n:hasLINSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasLINSegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a LIN_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :LIN_Segment ;\\n    owl:inverseOf :isLINSegmentOf .\\n\\n:isLINSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isLINSegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasLINSegment.\\\" ;\\n    rdfs:domain :LIN_Segment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasLINSegment .\\n\\n:hasPRISegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasPRISegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a PRI_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :PRI_Segment ;\\n    owl:inverseOf :isPRISegmentOf .\\n\\n:isPRISegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isPRISegmentOf\\\" ;\\n    rdfs:comment \\\"Inverse of hasPRISegment.\\\" ;\\n    rdfs:domain :PRI_Segment ;\\n    rdfs:range :InvoiceMessage ;\\n    owl:inverseOf :hasPRISegment .\\n\\n:hasQTYSegment a owl:ObjectProperty ;\\n    rdfs:label \\\"hasQTYSegment\\\" ;\\n    rdfs:comment \\\"Links an InvoiceMessage to a QTY_Segment.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :QTY_Segment ;\\n    owl:inverseOf :isQTYSegmentOf .\\n\\n:isQTYSegmentOf a owl:ObjectProperty ;\\n    rdfs:label \\\"isQTYSegmentOf\\\" ;\\n  