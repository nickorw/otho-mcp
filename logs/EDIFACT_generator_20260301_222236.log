2026-03-01 22:24:42 | DEBUG    |     Args: {
      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoiceOntology> a owl:Ontology ;\n  rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n  rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, roles, and business document structure, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The top-level envelope for EDIFACT messages, containing one or more messages.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A generic EDIFACT message.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"An invoice message (e.g., INVOIC) in EDIFACT.\" ;\n  rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment within an EDIFACT message, such as BGM or NAD.\" .\n\n:InvoiceHeader a owl:Class ;\n  rdfs:label \"Invoice Header\" ;\n  rdfs:comment \"Header segment containing document dates and reference numbers.\" ;\n  rdfs:subClassOf :Segment .\n\n:InvoiceDetail a owl:Class ;\n  rdfs:label \"Invoice Detail\" ;\n  rdfs:comment \"Detail segment listing line items.\" ;\n  rdfs:subClassOf :Segment .\n\n:InvoiceSummary a owl:Class ;\n  rdfs:label \"Invoice Summary\" ;\n  rdfs:comment \"Summary segment providing totals and taxes.\" ;\n  rdfs:subClassOf :Segment .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element within a composite element.\" .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the invoice process.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in a transaction (e.g., Buyer, Seller, Delivery Party).\" .\n\n:OrganizationRoleAssignment a owl:Class ;\n  rdfs:label \"Organization Role Assignment\" ;\n  rdfs:comment \"Reification class linking an organization to its role in an invoice.\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"An address associated with an organization.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"An item being sold in the invoice.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A price related to an item or invoice.\" .\n\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in the invoice detail section.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"A mandatory identifier, such as Global Location Number.\" ;\n  rdfs:subClassOf :SimpleDataElement .\n\n:Tax a owl:Class ;\n  rdfs:label \"Tax\" ;\n  rdfs:comment \"Tax information in the invoice summary.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:TotalAmount a owl:Class ;\n  rdfs:label \"Total Amount\" ;\n  rdfs:comment \"The total amount of the invoice.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:DocumentReference a owl:Class ;\n  rdfs:label \"Document Reference\" ;\n  rdfs:comment \"A reference to a document, such as an invoice number or related document.\" ;\n  rdfs:subClassOf :CompositeDataElement .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n:Organization owl:disjointWith :Address, :Item, :BusinessProcess .\n:Item owl:disjointWith :Address .\n:Price owl:disjointWith :Address .\n:AgentRole owl:disjointWith :Organization .\n\n#################################################################\n# Object Properties\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Relates an Interchange Envelope to the messages it contains.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message .\n\n:containsSegment a owl:ObjectProperty ;\n  rdfs:label \"contains segment\" ;\n  rdfs:comment \"Relates a message to its segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment .\n\n:containsCompositeElement a owl:ObjectProperty ;\n  rdfs:label \"contains composite element\" ;\n  rdfs:comment \"Relates a segment to its composite data elements.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement .\n\n:containsSimpleElement a owl:ObjectProperty ;\n  rdfs:label \"contains simple element\" ;\n  rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n  rdfs:label \"has organization role assignment\" ;\n  rdfs:comment \"Links an invoice message to the organization-role assignments it contains.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :OrganizationRoleAssignment .\n\n:hasRole a owl:ObjectProperty ;\n  rdfs:label \"has role\" ;\n  rdfs:comment \"Links an organization role assignment to the role played.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole .\n\n:assignedOrganization a owl:ObjectProperty ;\n  rdfs:label \"assigned organization\" ;\n  rdfs:comment \"Links an organization role assignment to the assigned organization.\" ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links an organization to its address.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Address .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to its identifier(s).\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier .\n\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links an invoice detail segment to its line items.\" ;\n  rdfs:domain :InvoiceDetail ;\n  rdfs:range :LineItem .\n\n:relatesToBusinessProcess a owl:ObjectProperty ;\n  rdfs:label \"relates to business process\" ;\n  rdfs:comment \"Links an invoice message to a business process.\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess .\n\n:hasPrice a owl:ObjectProperty ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Links a line item to its price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price .\n\n:hasTax a owl:ObjectProperty ;\n  rdfs:label \"has tax\" ;\n  rdfs:comment \"Links an invoice summary to its tax information.\" ;\n  rdfs:domain :InvoiceSummary ;\n  rdfs:range :Tax .\n\n:hasTotalAmount a owl:ObjectProperty ;\n  rdfs:label \"has total amount\" ;\n  rdfs:comment \"Links an invoice summary to its total amount.\" ;\n  rdfs:domain :InvoiceSummary ;\n  rdfs:range :TotalAmount .\n\n:hasDocumentReference a owl:ObjectProperty ;\n  rdfs:label \"has document reference\" ;\n  rdfs:comment \"Links an invoice header to its document references.\" ;\n  rdfs:domain :InvoiceHeader ;\n  rdfs:range :DocumentReference .\n\n#################################################################\n# Data Properties\n#################################################################\n\n:invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:label \"invoice number\" ;\n  rdfs:comment \"The invoice number as a string.\" ;\n  rdfs:domain :InvoiceHeader ;\n  rdfs:range xsd:string .\n\n:documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:label \"document date\" ;\n  rdfs:comment \"The date of the document.\" ;\n  rdfs:domain :InvoiceHeader ;\n  rdfs:range xsd:dateTime .\n\n:netPrice a owl:DatatypeProperty ;\n  rdfs:label \"net price\" ;\n  rdfs:comment \"The net price of an item.\" ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal .\n\n:quantity a owl:DatatypeProperty ;\n  rdfs:label \"quantity\" ;\n  rdfs:comment \"The quantity of an item in a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal .\n\n:itemDescription a owl:DatatypeProperty ;\n  rdfs:label \"item description\" ;\n  rdfs:comment \"A description of the item.\" ;\n  rdfs:domain :Item ;\n  rdfs:range xsd:string .\n\n:taxAmount a owl:DatatypeProperty ;\n  rdfs:label \"tax amount\" ;\n  rdfs:comment \"The tax amount for the invoice.\" ;\n  rdfs:domain :Tax ;\n  rdfs:range xsd:decimal .\n\n:totalAmountValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:label \"total amount value\" ;\n  rdfs:comment \"The total value of the invoice.\" ;\n  rdfs:domain :TotalAmount ;\n  rdfs:range xsd:decimal .\n\n:addressLine a owl:DatatypeProperty ;\n  rdfs:label \"address line\" ;\n  rdfs:comment \"A line of the address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n  rdfs:label \"postal code\" ;\n  rdfs:comment \"Postal code for the address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n  rdfs:label \"city\" ;\n  rdfs:comment \"City for the address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:countryCode a owl:DatatypeProperty ;\n  rdfs:label \"country code\" ;\n  rdfs:comment \"Country code for the address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string .\n\n:identifierValue a owl:DatatypeProperty , owl:FunctionalProperty ;\n  rdfs:label \"identifier value\" ;\n  rdfs:comment \"The value of an identifier, such as a GLN.\" ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string .\n\n#################################################################\n# General Class Axioms and Restrictions\n#################################################################\n\n:BuyerRole a :AgentRole ;\n  rdfs:label \"Buyer Role\" ;\n  rdfs:comment \"The role of buyer in a transaction.\" .\n\n:SellerRole a :AgentRole ;\n  rdfs:label \"Seller Role\" ;\n  rdfs:comment \"The role of seller in a transaction.\" .\n\n:DeliveryPartyRole a :AgentRole ;\n  rdfs:label \"Delivery Party Role\" ;\n  rdfs:comment \"The role of delivery party in a transaction.\" .\n\n:BuyerOrganization a owl:Class ;\n  rdfs:label \"Buyer Organization\" ;\n  rdfs:comment \"An organization playing the Buyer role in an invoice.\" ;\n  owl:equivalentClass [\n    a owl:Class ;\n    owl:intersectionOf (\n      :Organization\n      [ a owl:Restriction ;\n        owl:onProperty :hasRole ;\n        owl:someValuesFrom :BuyerRole\n      ]\n    )\n  ] .\n\n:InvoiceMessage rdfs:subClassOf [\n  a owl:Restriction ;\n  owl:onProperty :containsSegment ;\n  owl:allValuesFrom :Segment\n] .\n\n:InvoiceHeader rdfs:subClassOf [\n  a owl:Restriction ;\n  owl:onProperty :hasDocumentReference ;\n  owl:allValuesFrom :DocumentReference\n] .\n"
}
