      "key": "current_owl",
      "value": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n:UNEDIFACTOntology rdf:type owl:Ontology ;\n  rdfs:label \"UN/EDIFACT Business Document Ontology\" ;\n  rdfs:comment \"Ontology representing UN/EDIFACT digital business documents, roles, and procurement scenarios.\" .\n\n# Classes\n:InterchangeEnvelope rdf:type owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"Envelope containing specific messages in an EDIFACT interchange.\" .\n\n:Message rdf:type owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A message contained within an interchange envelope.\" .\n\n:InvoiceMessage rdf:type owl:Class ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"A message representing an invoice transaction.\" ;\n  rdfs:subClassOf :Message .\n\n:Segment rdf:type owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment within a message, such as BGM or NAD.\" .\n\n:CompositeDataElement rdf:type owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite element within a segment.\" .\n\n:SimpleDataElement rdf:type owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element within a composite data element.\" .\n\n:Organization rdf:type owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization participating in a transaction.\" .\n\n:AgentRole rdf:type owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role an organization can play (e.g., Buyer, Delivery Party).\" .\n\n:Address rdf:type owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"An address associated with an organization role.\" .\n\n:Item rdf:type owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"An item listed in the invoice.\" .\n\n:Price rdf:type owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"The price associated with an item.\" .\n\n:BusinessProcess rdf:type owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A business process to which the invoice can be assigned.\" .\n\n:InvoiceHeaderSection rdf:type owl:Class ;\n  rdfs:label \"Invoice Header Section\" ;\n  rdfs:comment \"Header section of an invoice message.\" ;\n  rdfs:subClassOf :Segment .\n\n:InvoiceDetailSection rdf:type owl:Class ;\n  rdfs:label \"Invoice Detail Section\" ;\n  rdfs:comment \"Detail section of an invoice message.\" ;\n  rdfs:subClassOf :Segment .\n\n:InvoiceSummarySection rdf:type owl:Class ;\n  rdfs:label \"Invoice Summary Section\" ;\n  rdfs:comment \"Summary section of an invoice message.\" ;\n  rdfs:subClassOf :Segment .\n\n:LineItem rdf:type owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A line item in the invoice detail section.\" ;\n  rdfs:subClassOf :Item .\n\n:Identifier rdf:type owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"An identifier for organizations (e.g., GLN).\" .\n\n:OrganizationRoleAssignment rdf:type owl:Class ;\n  rdfs:label \"Organization Role Assignment\" ;\n  rdfs:comment \"A reified class linking an organization to a role and address in a specific context.\" .\n\n# Disjointness\n:Organization owl:disjointWith :Item, :Address .\n:Item owl:disjointWith :Price .\n:InvoiceHeaderSection owl:disjointWith :InvoiceDetailSection, :InvoiceSummarySection .\n:InvoiceDetailSection owl:disjointWith :InvoiceSummarySection .\n\n# DisjointUnion\n:Segment owl:disjointUnionOf ( :InvoiceHeaderSection :InvoiceDetailSection :InvoiceSummarySection ) .\n\n# Object Properties\n:containsMessage rdf:type owl:ObjectProperty ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Links an interchange envelope to the messages it contains.\" ;\n  owl:FunctionalProperty .\n\n:hasSegment rdf:type owl:ObjectProperty ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Links a message to its segments.\" .\n\n:hasCompositeElement rdf:type owl:ObjectProperty ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement ;\n  rdfs:label \"has composite element\" ;\n  rdfs:comment \"Links a segment to its composite data elements.\" .\n\n:hasSimpleElement rdf:type owl:ObjectProperty ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement ;\n  rdfs:label \"has simple element\" ;\n  rdfs:comment \"Links a composite data element to its simple data elements.\" .\n\n:involvesOrganization rdf:type owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :OrganizationRoleAssignment ;\n  rdfs:label \"involves organization\" ;\n  rdfs:comment \"Links an invoice message to an organization role assignment (reified role).\" .\n\n:assignedOrganization rdf:type owl:ObjectProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Organization ;\n  rdfs:label \"assigned organization\" ;\n  rdfs:comment \"Links a role assignment to the organization.\" ;\n  owl:FunctionalProperty .\n\n:assignedRole rdf:type owl:ObjectProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :AgentRole ;\n  rdfs:label \"assigned role\" ;\n  rdfs:comment \"Links a role assignment to the agent role.\" ;\n  owl:FunctionalProperty .\n\n:roleAddress rdf:type owl:ObjectProperty ;\n  rdfs:domain :OrganizationRoleAssignment ;\n  rdfs:range :Address ;\n  rdfs:label \"role address\" ;\n  rdfs:comment \"Links a role assignment to a specific address.\" .\n\n:hasIdentifier rdf:type owl:ObjectProperty ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to its identifier (e.g., Global Location Number).\" .\n\n:hasLineItem rdf:type owl:ObjectProperty ;\n  rdfs:domain :InvoiceDetailSection ;\n  rdfs:range :LineItem ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Links a detail section to its line items.\" .\n\n:itemOf rdf:type owl:ObjectProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item ;\n  rdfs:label \"item of\" ;\n  rdfs:comment \"Links a line item to the item being sold.\" ;\n  owl:FunctionalProperty .\n\n:itemPrice rdf:type owl:ObjectProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  rdfs:label \"item price\" ;\n  rdfs:comment \"Links a line item to its price.\" ;\n  owl:FunctionalProperty .\n\n:partOfProcess rdf:type owl:ObjectProperty ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess ;\n  rdfs:label \"part of process\" ;\n  rdfs:comment \"Links an invoice message to a business process.\" .\n\n# Data Properties\n:addressLine rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"address line\" ;\n  rdfs:comment \"Address line for an address.\" .\n\n:postalCode rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"postal code\" ;\n  rdfs:comment \"Postal code for an address.\" .\n\n:city rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"city\" ;\n  rdfs:comment \"City name for an address.\" .\n\n:countryCode rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  rdfs:label \"country code\" ;\n  rdfs:comment \"Country code for an address.\" .\n\n:identifierValue rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string ;\n  rdfs:label \"identifier value\" ;\n  rdfs:comment \"The value of an identifier.\" .\n\n:identifierType rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Identifier ;\n  rdfs:range xsd:string ;\n  rdfs:label \"identifier type\" ;\n  rdfs:comment \"The type of identifier (e.g., GLN).\" .\n\n:itemDescription rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Item ;\n  rdfs:range xsd:string ;\n  rdfs:label \"item description\" ;\n  rdfs:comment \"Description of the item.\" .\n\n:quantity rdf:type owl:DatatypeProperty ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"quantity\" ;\n  rdfs:comment \"Quantity of the item in the line item.\" .\n\n:netPrice rdf:type owl:DatatypeProperty ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"net price\" ;\n  rdfs:comment \"Net price of the item.\" .\n\n:invoiceAmount rdf:type owl:DatatypeProperty ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range xsd:decimal ;\n  rdfs:label \"invoice amount\" ;\n  rdfs:comment \"Total amount of the invoice.\" .\n\n:invoiceNumber rdf:type owl:DatatypeProperty ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string ;\n  rdfs:label \"invoice number\" ;\n  rdfs:comment \"Unique number of the invoice.\" ;\n  owl:FunctionalProperty .\n\n:invoiceDate rdf:type owl:DatatypeProperty ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:dateTime ;\n  rdfs:label \"invoice date\" ;\n  rdfs:comment \"Date of the invoice.\" .\n\n# Example Restrictions and GCAs\n:Buyer rdf:type :AgentRole ;\n  rdfs:label \"Buyer\" ;\n  rdfs:comment \"Role of buyer organization.\" .\n\n:DeliveryParty rdf:type :AgentRole ;\n  rdfs:label \"Delivery Party\" ;\n  rdfs:comment \"Role of delivery party organization.\" .\n\n:OrganizationRoleAssignment owl:equivalentClass [\n  rdf:type owl:Class ;\n  owl:onProperty :assignedOrganization ;\n  owl:allValuesFrom :Organization ;\n  owl:onProperty :assignedRole ;\n  owl:allValuesFrom :AgentRole ;\n] .\n\n:LineItem owl:equivalentClass [\n  rdf:type owl:Class ;\n  owl:onProperty :itemOf ;\n  owl:allValuesFrom :Item ;\n  owl:onProperty :itemPrice ;\n  owl:allValuesFrom :Price ;\n] ."
}
