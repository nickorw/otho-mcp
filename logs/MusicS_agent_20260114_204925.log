        "arguments": "{\"owl_content\": \"@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix : <http://www.example.org/ontology#> .\\n\\n<http://www.example.org/ontology/music-production>\\n    a owl:Ontology ;\\n    rdfs:label \\\"Music Production Ontology\\\" ;\\n    rdfs:comment \\\"An ontology describing music production, band membership, recording, and performances.\\\" .\\n\\n#################################################################\\n# Classes\\n#################################################################\\n:Person a owl:Class ;\\n    rdfs:label \\\"Person\\\" ;\\n    rdfs:comment \\\"A human individual involved in music production, band membership, or performance.\\\" .\\n\\n:Band a owl:Class ;\\n    rdfs:label \\\"Band\\\" ;\\n    rdfs:comment \\\"A music group or band.\\\" .\\n\\n:Instrument a owl:Class ;\\n    rdfs:label \\\"Instrument\\\" ;\\n    rdfs:comment \\\"A musical instrument played by a person.\\\" .\\n\\n:Role a owl:Class ;\\n    rdfs:label \\\"Role\\\" ;\\n    rdfs:comment \\\"A role a person can have in a band (e.g., vocalist, guitarist).\\\" .\\n\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A reification class linking a person, band, role, and time period for membership.\\\" .\\n\\n:Album a owl:Class ;\\n    rdfs:label \\\"Album\\\" ;\\n    rdfs:comment \\\"A collection of tracks recorded and released by a band.\\\" .\\n\\n:Track a owl:Class ;\\n    rdfs:label \\\"Track\\\" ;\\n    rdfs:comment \\\"A track on an album, which is a recording of a song.\\\" .\\n\\n:Song a owl:Class ;\\n    rdfs:label \\\"Song\\\" ;\\n    rdfs:comment \\\"A musical composition that can be recorded as a track.\\\" .\\n\\n:Critic a owl:Class ;\\n    rdfs:label \\\"Critic\\\" ;\\n    rdfs:comment \\\"A person who reviews and comments on albums.\\\" .\\n\\n:Performance a owl:Class ;\\n    rdfs:label \\\"Performance\\\" ;\\n    rdfs:comment \\\"A live performance event by a band.\\\" .\\n\\n:City a owl:Class ;\\n    rdfs:label \\\"City\\\" ;\\n    rdfs:comment \\\"A city where performances can take place.\\\" .\\n\\n:Region a owl:Class ;\\n    rdfs:label \\\"Region\\\" ;\\n    rdfs:comment \\\"A geographical region containing cities.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n#################################################################\\n# Disjointness\\n#################################################################\\n:Person owl:disjointWith :Band, :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n:Band owl:disjointWith :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n:Instrument owl:disjointWith :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n:Album owl:disjointWith :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\\n:Track owl:disjointWith :Song, :Critic, :Performance, :City, :Region, :Country .\\n:Song owl:disjointWith :Critic, :Performance, :City, :Region, :Country .\\n:Critic owl:disjointWith :Performance, :City, :Region, :Country .\\n:Performance owl:disjointWith :City, :Region, :Country .\\n:City owl:disjointWith :Region, :Country .\\n:Region owl:disjointWith :Country .\\n\\n#################################################################\\n# Object Properties (with inverses)\\n#################################################################\\n:playsInstrument a owl:ObjectProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Relates a person to an instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :isPlayedBy .\\n\\n:isPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"is played by\\\" ;\\n    rdfs:comment \\\"Relates an instrument to the person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"has membership\\\" ;\\n    rdfs:comment \\\"Relates a person to their band membership (reified).\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberPerson .\\n\\n:memberPerson a owl:ObjectProperty ;\\n    rdfs:label \\\"member person\\\" ;\\n    rdfs:comment \\\"Relates a band membership to the person involved.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :hasMembership .\\n\\n:membershipOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"membership of band\\\" ;\\n    rdfs:comment \\\"Relates a band membership to a band.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasBandMembership .\\n\\n:hasBandMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"has band membership\\\" ;\\n    rdfs:comment \\\"Relates a band to a band membership.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :membershipOfBand .\\n\\n:hasRole a owl:ObjectProperty ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Relates a band membership to a role.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleOfMembership .\\n\\n:roleOfMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role of membership\\\" ;\\n    rdfs:comment \\\"Relates a role to the band membership it is part of.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :hasRole .\\n\\n:recordedAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"recorded album\\\" ;\\n    rdfs:comment \\\"Relates a band to an album they recorded.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumRecordedBy .\\n\\n:albumRecordedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"album recorded by\\\" ;\\n    rdfs:comment \\\"Relates an album to the band that recorded it.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :recordedAlbum .\\n\\n:albumTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"album track\\\" ;\\n    rdfs:comment \\\"Relates an album to one of its tracks.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOnAlbum .\\n\\n:trackOnAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"track on album\\\" ;\\n    rdfs:comment \\\"Relates a track to the album it appears on.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :albumTrack .\\n\\n:trackOfSong a owl:ObjectProperty ;\\n    rdfs:label \\\"track of song\\\" ;\\n    rdfs:comment \\\"Relates a track to the song it is a recording of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songRecordedAsTrack .\\n\\n:songRecordedAsTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"song recorded as track\\\" ;\\n    rdfs:comment \\\"Relates a song to the track that records it.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOfSong .\\n\\n:criticReview a owl:ObjectProperty ;\\n    rdfs:label \\\"critic review\\\" ;\\n    rdfs:comment \\\"Relates a critic to an album they reviewed.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :reviewedByCritic .\\n\\n:reviewedByCritic a owl:ObjectProperty ;\\n    rdfs:label \\\"reviewed by critic\\\" ;\\n    rdfs:comment \\\"Relates an album to the critic who reviewed it.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :criticReview .\\n\\n:performanceOfBand a owl:ObjectProperty ;\\n    rdfs:label \\\"performance of band\\\" ;\\n    rdfs:comment \\\"Relates a performance to the band performing.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :bandPerformance .\\n\\n:bandPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"band performance\\\" ;\\n    rdfs:comment \\\"Relates a band to a performance.\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceOfBand .\\n\\n:performedSong a owl:ObjectProperty ;\\n    rdfs:label \\\"performed song\\\" ;\\n    rdfs:comment \\\"Relates a performance to a song played.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songPerformedAt .\\n\\n:songPerformedAt a owl:ObjectProperty ;\\n    rdfs:label \\\"song performed at\\\" ;\\n    rdfs:comment \\\"Relates a song to the performance where it was played.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performedSong .\\n\\n:performanceLocation a owl:ObjectProperty ;\\n    rdfs:label \\\"performance location\\\" ;\\n    rdfs:comment \\\"Relates a performance to the city where it took place.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityPerformance .\\n\\n:cityPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"city performance\\\" ;\\n    rdfs:comment \\\"Relates a city to a performance that took place there.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performanceLocation .\\n\\n:cityInRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"city in region\\\" ;\\n    rdfs:comment \\\"Relates a city to the region it is in.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionHasCity .\\n\\n:regionHasCity a owl:ObjectProperty ;\\n    rdfs:label \\\"region has city\\\" ;\\n    rdfs:comment \\\"Relates a region to a city it contains.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityInRegion .\\n\\n:regionInCountry a owl:ObjectProperty ;\\n    rdfs:label \\\"region in country\\\" ;\\n    rdfs:comment \\\"Relates a region to the country it is in.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country ;\\n    owl:inverseOf :countryHasRegion .\\n\\n:countryHasRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"country has region\\\" ;\\n    rdfs:comment \\\"Relates a country to a region it contains.\\\" ;\\n    rdfs:domain :Country ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionInCountry .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:membershipStart a owl:DatatypeProperty ;\\n    rdfs:label \\\"membership start\\\" ;\\n    rdfs:comment \\\"Start date/time of a band membership.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:membershipEnd a owl:DatatypeProperty ;\\n    rdfs:label \\\"membership end\\\" ;\\n    rdfs:comment \\\"End date/time of a band membership.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingStart a owl:DatatypeProperty ;\\n    rdfs:label \\\"recording start\\\" ;\\n    rdfs:comment \\\"Start date/time of album recording.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingEnd a owl:DatatypeProperty ;\\n    rdfs:label \\\"recording end\\\" ;\\n    rdfs:comment \\\"End date/time (release) of album recording.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:dateTime .\\n\\n:songComposedOn a owl:DatatypeProperty ;\\n    rdfs:label \\\"song composed on\\\" ;\\n    rdfs:comment \\\"Date/time when a song was composed.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range xsd:dateTime .\\n\\n:reviewComment a owl:DatatypeProperty ;\\n    rdfs:label \\\"review comment\\\" ;\\n    rdfs:comment \\\"The comment made by a critic about an album.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range xsd:string .\\n\\n:performanceDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"performance date\\\" ;\\n    rdfs:comment \\\"Date/time of a performance.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:dateTime .\\n\\n#################################################################\\n# Complex Axioms & Restrictions (GCI)\\n#################################################################\\n:Album rdfs:subClassOf [ a owl:Restriction ;\\n    owl:onProperty :albumTrack ;\\n    owl:minCardinality \\\"1\\\"^^xsd:nonNegativeInteger\\n] .\\n\"}",
