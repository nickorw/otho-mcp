      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology/music-production>\n    a owl:Ontology ;\n    rdfs:label \"Music Production Ontology\" ;\n    rdfs:comment \"An ontology describing music production, band membership, recording, and performances.\" .\n\n#################################################################\n# Classes\n#################################################################\n:Person a owl:Class ;\n    rdfs:label \"Person\" ;\n    rdfs:comment \"A human individual involved in music production, band membership, or performance.\" .\n\n:Band a owl:Class ;\n    rdfs:label \"Band\" ;\n    rdfs:comment \"A music group or band.\" .\n\n:Instrument a owl:Class ;\n    rdfs:label \"Instrument\" ;\n    rdfs:comment \"A musical instrument played by a person.\" .\n\n:Role a owl:Class ;\n    rdfs:label \"Role\" ;\n    rdfs:comment \"A role a person can have in a band (e.g., vocalist, guitarist).\" .\n\n:BandMembership a owl:Class ;\n    rdfs:label \"Band Membership\" ;\n    rdfs:comment \"A reification class linking a person, band, role, and time period for membership.\" .\n\n:Album a owl:Class ;\n    rdfs:label \"Album\" ;\n    rdfs:comment \"A collection of tracks recorded and released by a band.\" .\n\n:Track a owl:Class ;\n    rdfs:label \"Track\" ;\n    rdfs:comment \"A track on an album, which is a recording of a song.\" .\n\n:Song a owl:Class ;\n    rdfs:label \"Song\" ;\n    rdfs:comment \"A musical composition that can be recorded as a track.\" .\n\n:Critic a owl:Class ;\n    rdfs:label \"Critic\" ;\n    rdfs:comment \"A person who reviews and comments on albums.\" .\n\n:Performance a owl:Class ;\n    rdfs:label \"Performance\" ;\n    rdfs:comment \"A live performance event by a band.\" .\n\n:City a owl:Class ;\n    rdfs:label \"City\" ;\n    rdfs:comment \"A city where performances can take place.\" .\n\n:Region a owl:Class ;\n    rdfs:label \"Region\" ;\n    rdfs:comment \"A geographical region containing cities.\" .\n\n:Country a owl:Class ;\n    rdfs:label \"Country\" ;\n    rdfs:comment \"A country containing regions.\" .\n\n#################################################################\n# Disjointness\n#################################################################\n:Person owl:disjointWith :Band, :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\n:Band owl:disjointWith :Instrument, :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\n:Instrument owl:disjointWith :Album, :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\n:Album owl:disjointWith :Track, :Song, :Critic, :Performance, :City, :Region, :Country .\n:Track owl:disjointWith :Song, :Critic, :Performance, :City, :Region, :Country .\n:Song owl:disjointWith :Critic, :Performance, :City, :Region, :Country .\n:Critic owl:disjointWith :Performance, :City, :Region, :Country .\n:Performance owl:disjointWith :City, :Region, :Country .\n:City owl:disjointWith :Region, :Country .\n:Region owl:disjointWith :Country .\n\n#################################################################\n# Object Properties (with inverses)\n#################################################################\n:playsInstrument a owl:ObjectProperty ;\n    rdfs:label \"plays instrument\" ;\n    rdfs:comment \"Relates a person to an instrument they play.\" ;\n    rdfs:domain :Person ;\n    rdfs:range :Instrument ;\n    owl:inverseOf :isPlayedBy .\n\n:isPlayedBy a owl:ObjectProperty ;\n    rdfs:label \"is played by\" ;\n    rdfs:comment \"Relates an instrument to the person who plays it.\" ;\n    rdfs:domain :Instrument ;\n    rdfs:range :Person ;\n    owl:inverseOf :playsInstrument .\n\n:hasMembership a owl:ObjectProperty ;\n    rdfs:label \"h