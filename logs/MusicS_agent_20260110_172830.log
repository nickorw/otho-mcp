formance.\" ;\n    rdfs:domain :Performance ;\n    rdfs:range xsd:dateTime .\n\n:trackNumber a owl:DatatypeProperty ;\n    rdfs:label \"track number\" ;\n    rdfs:comment \"The number of a track on an album.\" ;\n    rdfs:domain :Track ;\n    rdfs:range xsd:integer .\n\n:albumTrackCount a owl:DatatypeProperty ;\n    rdfs:label \"album track count\" ;\n    rdfs:comment \"The total number of tracks on an album.\" ;\n    rdfs:domain :Album ;\n    rdfs:range xsd:integer .\n\n### CLASS AXIOMS & RESTRICTIONS\n\n# Disjointness\n:Person owl:disjointWith :Band .\n:Instrument owl:disjointWith :Role .\n:Album owl:disjointWith :Song .\n:Critic owl:disjointWith :Person .\n:City owl:disjointWith :Region .\n:Region owl:disjointWith :Country .\n\n# Album must have at least one track\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:minQualifiedCardinality \"1\"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .\n\n### END OF ONTOLOGY\n"
