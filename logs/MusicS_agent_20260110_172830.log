 cities.\\\" .\\n\\n:Country a owl:Class ;\\n    rdfs:label \\\"Country\\\" ;\\n    rdfs:comment \\\"A country containing regions.\\\" .\\n\\n# Pivot Classes for Reification\\n:BandMembership a owl:Class ;\\n    rdfs:label \\\"Band Membership\\\" ;\\n    rdfs:comment \\\"A reified relation linking a person, a band, a role, and a time period.\\\" .\\n\\n:AlbumRecording a owl:Class ;\\n    rdfs:label \\\"Album Recording\\\" ;\\n    rdfs:comment \\\"A reified relation linking a band, an album, and a recording period.\\\" .\\n\\n:TrackSongRelation a owl:Class ;\\n    rdfs:label \\\"Track Song Relation\\\" ;\\n    rdfs:comment \\\"Reifies the relation between a track and the song it records.\\\" .\\n\\n:PerformanceSong a owl:Class ;\\n    rdfs:label \\\"Performance Song\\\" ;\\n    rdfs:comment \\\"Reifies the relation between a performance and the songs played.\\\" .\\n\\n### OBJECT PROPERTIES (with inverses)\\n\\n:playsInstrument a owl:ObjectProperty ;\\n    rdfs:label \\\"plays instrument\\\" ;\\n    rdfs:comment \\\"Relates a person to the instrument they play.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :Instrument ;\\n    owl:inverseOf :instrumentPlayedBy .\\n\\n:instrumentPlayedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"instrument played by\\\" ;\\n    rdfs:comment \\\"Inverse of playsInstrument; relates an instrument to the person who plays it.\\\" ;\\n    rdfs:domain :Instrument ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :playsInstrument .\\n\\n:hasRole a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has role\\\" ;\\n    rdfs:comment \\\"Relates a band membership to a role.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Role ;\\n    owl:inverseOf :roleOfMembership .\\n\\n:roleOfMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"role of membership\\\" ;\\n    rdfs:comment \\\"Inverse of hasRole; relates a role to the band membership(s) it is part of.\\\" ;\\n    rdfs:domain :Role ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :hasRole .\\n\\n:hasMember a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"has member\\\" ;\\n    rdfs:comment \\\"Relates a band membership to a person.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Person ;\\n    owl:inverseOf :memberInMembership .\\n\\n:memberInMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"member in membership\\\" ;\\n    rdfs:comment \\\"Inverse of hasMember; relates a person to band membership(s) they are part of.\\\" ;\\n    rdfs:domain :Person ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :hasMember .\\n\\n:memberOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"member of\\\" ;\\n    rdfs:comment \\\"Relates a band membership to a band.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasMembership .\\n\\n:hasMembership a owl:ObjectProperty ;\\n    rdfs:label \\\"has membership\\\" ;\\n    rdfs:comment \\\"Inverse of memberOf; relates a band to its band membership(s).\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :BandMembership ;\\n    owl:inverseOf :memberOf .\\n\\n:recordingOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recording of\\\" ;\\n    rdfs:comment \\\"Relates a track-song relation to a song.\\\" ;\\n    rdfs:domain :TrackSongRelation ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :hasRecordingRelation .\\n\\n:hasRecordingRelation a owl:ObjectProperty ;\\n    rdfs:label \\\"has recording relation\\\" ;\\n    rdfs:comment \\\"Inverse of recordingOf; relates a song to track-song relations.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :TrackSongRelation ;\\n    owl:inverseOf :recordingOf .\\n\\n:trackOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"track of\\\" ;\\n    rdfs:comment \\\"Relates a track-song relation to a track.\\\" ;\\n    rdfs:domain :TrackSongRelation ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :hasTrackRelation .\\n\\n:hasTrackRelation a owl:ObjectProperty ;\\n    rdfs:label \\\"has track relation\\\" ;\\n    rdfs:comment \\\"Inverse of trackOf; relates a track to the track-song relations it is part of.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :TrackSongRelation ;\\n    owl:inverseOf :trackOf .\\n\\n:recordedBy a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recorded by\\\" ;\\n    rdfs:comment \\\"Relates an album recording to the band.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range :Band ;\\n    owl:inverseOf :hasAlbumRecording .\\n\\n:hasAlbumRecording a owl:ObjectProperty ;\\n    rdfs:label \\\"has album recording\\\" ;\\n    rdfs:comment \\\"Inverse of recordedBy; relates a band to its album recording(s).\\\" ;\\n    rdfs:domain :Band ;\\n    rdfs:range :AlbumRecording ;\\n    owl:inverseOf :recordedBy .\\n\\n:recordedAlbum a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recorded album\\\" ;\\n    rdfs:comment \\\"Relates an album recording to the album.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :hasRecording .\\n\\n:hasRecording a owl:ObjectProperty ;\\n    rdfs:label \\\"has recording\\\" ;\\n    rdfs:comment \\\"Inverse of recordedAlbum; relates an album to its album recording(s).\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :AlbumRecording ;\\n    owl:inverseOf :recordedAlbum .\\n\\n:hasTrack a owl:ObjectProperty ;\\n    rdfs:label \\\"has track\\\" ;\\n    rdfs:comment \\\"Relates an album to its tracks.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Track ;\\n    owl:inverseOf :trackOnAlbum .\\n\\n:trackOnAlbum a owl:ObjectProperty ;\\n    rdfs:label \\\"track on album\\\" ;\\n    rdfs:comment \\\"Inverse of hasTrack; relates a track to the album(s) it appears on.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :hasTrack .\\n\\n:definedBy a owl:ObjectProperty ;\\n    rdfs:label \\\"defined by\\\" ;\\n    rdfs:comment \\\"Relates a critic to an album.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range :Album ;\\n    owl:inverseOf :hasDefinitionBy .\\n\\n:hasDefinitionBy a owl:ObjectProperty ;\\n    rdfs:label \\\"has definition by\\\" ;\\n    rdfs:comment \\\"Inverse of definedBy; relates an album to the critic(s) who defined it.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range :Critic ;\\n    owl:inverseOf :definedBy .\\n\\n:performedAt a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performed at\\\" ;\\n    rdfs:comment \\\"Relates a performance to the city it took place in.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :City ;\\n    owl:inverseOf :cityOfPerformance .\\n\\n:cityOfPerformance a owl:ObjectProperty ;\\n    rdfs:label \\\"city of performance\\\" ;\\n    rdfs:comment \\\"Inverse of performedAt; relates a city to the performances held there.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :performedAt .\\n\\n:performanceOf a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance of\\\" ;\\n    rdfs:comment \\\"Relates a performance-song relation to a performance.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Performance ;\\n    owl:inverseOf :hasPerformanceSong .\\n\\n:hasPerformanceSong a owl:ObjectProperty ;\\n    rdfs:label \\\"has performance song\\\" ;\\n    rdfs:comment \\\"Inverse of performanceOf; relates a performance to performance-song relations.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performanceOf .\\n\\n:performedSong a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performed song\\\" ;\\n    rdfs:comment \\\"Relates a performance-song relation to a song.\\\" ;\\n    rdfs:domain :PerformanceSong ;\\n    rdfs:range :Song ;\\n    owl:inverseOf :songPerformedIn .\\n\\n:songPerformedIn a owl:ObjectProperty ;\\n    rdfs:label \\\"song performed in\\\" ;\\n    rdfs:comment \\\"Inverse of performedSong; relates a song to performance-song relations.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range :PerformanceSong ;\\n    owl:inverseOf :performedSong .\\n\\n:inRegion a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"in region\\\" ;\\n    rdfs:comment \\\"Relates a city to its region.\\\" ;\\n    rdfs:domain :City ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :regionHasCity .\\n\\n:regionHasCity a owl:ObjectProperty ;\\n    rdfs:label \\\"region has city\\\" ;\\n    rdfs:comment \\\"Inverse of inRegion; relates a region to its cities.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :City ;\\n    owl:inverseOf :inRegion .\\n\\n:inCountry a owl:ObjectProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"in country\\\" ;\\n    rdfs:comment \\\"Relates a region to its country.\\\" ;\\n    rdfs:domain :Region ;\\n    rdfs:range :Country ;\\n    owl:inverseOf :countryHasRegion .\\n\\n:countryHasRegion a owl:ObjectProperty ;\\n    rdfs:label \\\"country has region\\\" ;\\n    rdfs:comment \\\"Inverse of inCountry; relates a country to its regions.\\\" ;\\n    rdfs:domain :Country ;\\n    rdfs:range :Region ;\\n    owl:inverseOf :inCountry .\\n\\n### DATA PROPERTIES\\n\\n:membershipAtTime a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"membership at time\\\" ;\\n    rdfs:comment \\\"The time at which a membership is valid.\\\" ;\\n    rdfs:domain :BandMembership ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingStart a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recording start\\\" ;\\n    rdfs:comment \\\"Start date of album recording.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range xsd:dateTime .\\n\\n:recordingEnd a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"recording end\\\" ;\\n    rdfs:comment \\\"End date of album recording.\\\" ;\\n    rdfs:domain :AlbumRecording ;\\n    rdfs:range xsd:dateTime .\\n\\n:releasedOn a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"released on\\\" ;\\n    rdfs:comment \\\"The release date of an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:dateTime .\\n\\n:composedOn a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"composed on\\\" ;\\n    rdfs:comment \\\"The composition date of a song.\\\" ;\\n    rdfs:domain :Song ;\\n    rdfs:range xsd:dateTime .\\n\\n:hasDefinition a owl:DatatypeProperty ;\\n    rdfs:label \\\"has definition\\\" ;\\n    rdfs:comment \\\"The textual definition or review by a critic.\\\" ;\\n    rdfs:domain :Critic ;\\n    rdfs:range xsd:string .\\n\\n:performanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;\\n    rdfs:label \\\"performance date\\\" ;\\n    rdfs:comment \\\"The date of a performance.\\\" ;\\n    rdfs:domain :Performance ;\\n    rdfs:range xsd:dateTime .\\n\\n:trackNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"track number\\\" ;\\n    rdfs:comment \\\"The number of a track on an album.\\\" ;\\n    rdfs:domain :Track ;\\n    rdfs:range xsd:integer .\\n\\n:albumTrackCount a owl:DatatypeProperty ;\\n    rdfs:label \\\"album track count\\\" ;\\n    rdfs:comment \\\"The total number of tracks on an album.\\\" ;\\n    rdfs:domain :Album ;\\n    rdfs:range xsd:integer .\\n\\n### CLASS AXIOMS & RESTRICTIONS\\n\\n# Disjointness\\n:Person owl:disjointWith :Band .\\n:Instrument owl:disjointWith :Role .\\n:Album owl:disjointWith :Song .\\n:Critic owl:disjointWith :Person .\\n:City owl:disjointWith :Region .\\n:Region owl:disjointWith :Country .\\n\\n# Album must have at least one track\\n:Album rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTrack ; owl:minQualifiedCardinality \\\"1\\\"^^xsd:nonNegativeInteger ; owl:onClass :Track ] .\\n\\n### END OF ONTOLOGY\\n\"}",
