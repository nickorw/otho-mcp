omment \\\"Relates an invoice message to a business process.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :BusinessProcess .\\n\\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has header\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its header.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceHeader .\\n\\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has detail\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its detail section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceDetail .\\n\\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"has summary\\\" ;\\n    rdfs:comment \\\"Relates an invoice message to its summary section.\\\" ;\\n    rdfs:domain :InvoiceMessage ;\\n    rdfs:range :InvoiceSummary .\\n\\n#################################################################\\n# Data Properties\\n#################################################################\\n:documentDate a owl:DatatypeProperty ;\\n    rdfs:label \\\"document date\\\" ;\\n    rdfs:comment \\\"The date of the document in the invoice header.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:dateTime .\\n\\n:invoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\\n    rdfs:label \\\"invoice number\\\" ;\\n    rdfs:comment \\\"The invoice number.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:referenceNumber a owl:DatatypeProperty ;\\n    rdfs:label \\\"reference number\\\" ;\\n    rdfs:comment \\\"A reference number in the invoice header.\\\" ;\\n    rdfs:domain :InvoiceHeader ;\\n    rdfs:range xsd:string .\\n\\n:addressLine a owl:DatatypeProperty ;\\n    rdfs:label \\\"address line\\\" ;\\n    rdfs:comment \\\"Address line of the organization address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:postalCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"postal code\\\" ;\\n    rdfs:comment \\\"Postal code of the address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:city a owl:DatatypeProperty ;\\n    rdfs:label \\\"city\\\" ;\\n    rdfs:comment \\\"City of the address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:countryCode a owl:DatatypeProperty ;\\n    rdfs:label \\\"country code\\\" ;\\n    rdfs:comment \\\"Country code of the address.\\\" ;\\n    rdfs:domain :Address ;\\n    rdfs:range xsd:string .\\n\\n:identifierValue a owl:DatatypeProperty ;\\n    rdfs:label \\\"identifier value\\\" ;\\n    rdfs:comment \\\"Value of an identifier.\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n:identifierScheme a owl:DatatypeProperty ;\\n    rdfs:label \\\"identifier scheme\\\" ;\\n    rdfs:comment \\\"Scheme of the identifier (e.g., GLN).\\\" ;\\n    rdfs:domain :Identifier ;\\n    rdfs:range xsd:string .\\n\\n:quantity a owl:DatatypeProperty ;\\n    rdfs:label \\\"quantity\\\" ;\\n    rdfs:comment \\\"Quantity of the item in the line item.\\\" ;\\n    rdfs:domain :LineItem ;\\n    rdfs:range xsd:decimal .\\n\\n:netPrice a owl:DatatypeProperty ;\\n    rdfs:label \\\"net price\\\" ;\\n    rdfs:comment \\\"Net price of the item in the line item.\\\" ;\\n    rdfs:domain :Price ;\\n    rdfs:range xsd:decimal .\\n\\n:taxAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"tax amount\\\" ;\\n    rdfs:comment \\\"Tax amount in the invoice summary.\\\" ;\\n    rdfs:domain :Tax ;\\n    rdfs:range xsd:decimal .\\n\\n:totalAmount a owl:DatatypeProperty ;\\n    rdfs:label \\\"total amount\\\" ;\\n    rdfs:comment \\\"Total amount of the invoice in the summary section.\\\" ;\\n    rdfs:domain :InvoiceSummary ;\\n    rdfs:range xsd:decimal .\\n\\n#################################################################\\n# Advanced Modeling: Restrictions and Equivalence\\n#################################################################\\n# Example: A BuyerRole must be 