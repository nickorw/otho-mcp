      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoiceStory>\n    a owl:Ontology ;\n    rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n    rdfs:comment \"Ontology for representing UN/EDIFACT invoice messages, roles, items, and document structure, aligned with EN 16931-1 and P2P-O.\" .\n\n#################################################################\n# Classes\n#################################################################\n:InterchangeEnvelope a owl:Class ;\n    rdfs:label \"Interchange Envelope\" ;\n    rdfs:comment \"Top-level envelope for EDIFACT messages.\" .\n\n:EDIFACTMessage a owl:Class ;\n    rdfs:label \"EDIFACT Message\" ;\n    rdfs:comment \"A message contained within an Interchange Envelope.\" ;\n    rdfs:subClassOf :InterchangeEnvelope .\n\n:InvoiceMessage a owl:Class ;\n    rdfs:label \"Invoice Message\" ;\n    rdfs:comment \"An invoice message (e.g., INVOIC) in UN/EDIFACT.\" ;\n    rdfs:subClassOf :EDIFACTMessage .\n\n:Segment a owl:Class ;\n    rdfs:label \"Segment\" ;\n    rdfs:comment \"A segment within an EDIFACT message.\" ;\n    rdfs:subClassOf :EDIFACTMessage .\n\n:CompositeDataElement a owl:Class ;\n    rdfs:label \"Composite Data Element\" ;\n    rdfs:comment \"A composite data element within a segment.\" ;\n    rdfs:subClassOf :Segment .\n\n:SimpleDataElement a owl:Class ;\n    rdfs:label \"Simple Data Element\" ;\n    rdfs:comment \"A simple data element within a composite data element.\" ;\n    rdfs:subClassOf :CompositeDataElement .\n\n:InvoiceHeader a owl:Class ;\n    rdfs:label \"Invoice Header\" ;\n    rdfs:comment \"Header section of an invoice message.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:InvoiceDetail a owl:Class ;\n    rdfs:label \"Invoice Detail\" ;\n    rdfs:comment \"Detail section of an invoice message.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:InvoiceSummary a owl:Class ;\n    rdfs:label \"Invoice Summary\" ;\n    rdfs:comment \"Summary section of an invoice message.\" ;\n    rdfs:subClassOf :InvoiceMessage .\n\n:LineItem a owl:Class ;\n    rdfs:label \"Line Item\" ;\n    rdfs:comment \"A line item in the invoice detail section.\" ;\n    rdfs:subClassOf :InvoiceDetail .\n\n:Organization a owl:Class ;\n    rdfs:label \"Organization\" ;\n    rdfs:comment \"An organization involved in the invoice.\" .\n\n:AgentRole a owl:Class ;\n    rdfs:label \"Agent Role\" ;\n    rdfs:comment \"A role played by an organization in the invoice context.\" .\n\n:BuyerRole a owl:Class ;\n    rdfs:label \"Buyer Role\" ;\n    rdfs:comment \"Role of buyer in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:DeliveryPartyRole a owl:Class ;\n    rdfs:label \"Delivery Party Role\" ;\n    rdfs:comment \"Role of delivery party in the invoice.\" ;\n    rdfs:subClassOf :AgentRole .\n\n:OrganizationRoleAssignment a owl:Class ;\n    rdfs:label \"Organization Role Assignment\" ;\n    rdfs:comment \"Pivot class to reify the assignment of an organization to a role in an invoice.\" .\n\n:Address a owl:Class ;\n    rdfs:label \"Address\" ;\n    rdfs:comment \"Address of an organization.\" .\n\n:Identifier a owl:Class ;\n    rdfs:label \"Identifier\" ;\n    rdfs:comment \"An identifier associated with an organization or document.\" .\n\n:Item a owl:Class ;\n    rdfs:label \"Item\" ;\n    rdfs:comment \"An item being sold in the invoice.\" .\n\n:Price a owl:Class ;\n    rdfs:label \"Price\" ;\n    rdfs:comment \"A price associated with a line item.\" .\n\n:Tax a owl:Class ;\n    rdfs:label \"Tax\" ;\n    rdfs:comment \"Tax information for the invoice.\" .\n\n:BusinessProcess a owl:Class ;\n    rdfs:label \"Business Process\" ;\n    rdfs:comment \"A business process to which an invoice can be assigned.\" .\n\n#################################################################\n# Disjointness and DisjointUnion\n#################################################################\n:Organization owl:disjointWith :Item, :AgentRole, :Address, :Segment .\n:InvoiceHeader owl:disjointWith :InvoiceDetail, :InvoiceSummary .\n:InvoiceDetail owl:disjointWith :InvoiceSummary .\n:AgentRole owl:disjointUnionOf (:BuyerRole :DeliveryPartyRole) .\n\n#################################################################\n# Object Properties\n#################################################################\n:hasMessage a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has message\" ;\n    rdfs:comment \"Relates an Interchange Envelope to an EDIFACT message.\" ;\n    rdfs:domain :InterchangeEnvelope ;\n    rdfs:range :EDIFACTMessage ;\n    owl:inverseOf :isMessageOf .\n\n:isMessageOf a owl:ObjectProperty ;\n    rdfs:label \"is message of\" ;\n    rdfs:comment \"Relates an EDIFACT message to its containing Interchange Envelope.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :InterchangeEnvelope .\n\n:hasSegment a owl:ObjectProperty ;\n    rdfs:label \"has segment\" ;\n    rdfs:comment \"Relates an EDIFACT message to its segments.\" ;\n    rdfs:domain :EDIFACTMessage ;\n    rdfs:range :Segment ;\n    owl:inverseOf :isSegmentOf .\n\n:isSegmentOf a owl:ObjectProperty ;\n    rdfs:label \"is segment of\" ;\n    rdfs:comment \"Relates a segment to the EDIFACT message it is part of.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :EDIFACTMessage .\n\n:hasCompositeElement a owl:ObjectProperty ;\n    rdfs:label \"has composite element\" ;\n    rdfs:comment \"Relates a segment to its composite data elements.\" ;\n    rdfs:domain :Segment ;\n    rdfs:range :CompositeDataElement ;\n    owl:inverseOf :isCompositeElementOf .\n\n:isCompositeElementOf a owl:ObjectProperty ;\n    rdfs:label \"is composite element of\" ;\n    rdfs:comment \"Relates a composite data element to the segment it belongs to.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :Segment .\n\n:hasSimpleElement a owl:ObjectProperty ;\n    rdfs:label \"has simple element\" ;\n    rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n    rdfs:domain :CompositeDataElement ;\n    rdfs:range :SimpleDataElement ;\n    owl:inverseOf :isSimpleElementOf .\n\n:isSimpleElementOf a owl:ObjectProperty ;\n    rdfs:label \"is simple element of\" ;\n    rdfs:comment \"Relates a simple data element to the composite data element it belongs to.\" ;\n    rdfs:domain :SimpleDataElement ;\n    rdfs:range :CompositeDataElement .\n\n:hasOrganizationRoleAssignment a owl:ObjectProperty ;\n    rdfs:label \"has organization role assignment\" ;\n    rdfs:comment \"Relates an invoice message to an organization role assignment.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :OrganizationRoleAssignment ;\n    owl:inverseOf :isOrganizationRoleAssignmentOf .\n\n:isOrganizationRoleAssignmentOf a owl:ObjectProperty ;\n    rdfs:label \"is organization role assignment of\" ;\n    rdfs:comment \"Relates an organization role assignment to the invoice message it belongs to.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :InvoiceMessage .\n\n:assignedOrganization a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"assigned organization\" ;\n    rdfs:comment \"Relates a role assignment to the assigned organization.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :Organization ;\n    owl:inverseOf :isAssignedOrganizationOf .\n\n:isAssignedOrganizationOf a owl:ObjectProperty ;\n    rdfs:label \"is assigned organization of\" ;\n    rdfs:comment \"Relates an organization to the organization role assignments it is assigned to.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:assignedRole a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"assigned role\" ;\n    rdfs:comment \"Relates a role assignment to the role played.\" ;\n    rdfs:domain :OrganizationRoleAssignment ;\n    rdfs:range :AgentRole ;\n    owl:inverseOf :isAssignedRoleOf .\n\n:isAssignedRoleOf a owl:ObjectProperty ;\n    rdfs:label \"is assigned role of\" ;\n    rdfs:comment \"Relates an agent role to the organization role assignments it is assigned to.\" ;\n    rdfs:domain :AgentRole ;\n    rdfs:range :OrganizationRoleAssignment .\n\n:hasAddress a owl:ObjectProperty ;\n    rdfs:label \"has address\" ;\n    rdfs:comment \"Relates an organization to its address.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Address ;\n    owl:inverseOf :isAddressOf .\n\n:isAddressOf a owl:ObjectProperty ;\n    rdfs:label \"is address of\" ;\n    rdfs:comment \"Relates an address to the organization it belongs to.\" ;\n    rdfs:domain :Address ;\n    rdfs:range :Organization .\n\n:hasIdentifier a owl:ObjectProperty ;\n    rdfs:label \"has identifier\" ;\n    rdfs:comment \"Relates an organization to its identifier.\" ;\n    rdfs:domain :Organization ;\n    rdfs:range :Identifier ;\n    owl:inverseOf :isIdentifierOf .\n\n:isIdentifierOf a owl:ObjectProperty ;\n    rdfs:label \"is identifier of\" ;\n    rdfs:comment \"Relates an identifier to the organization it identifies.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range :Organization .\n\n:hasLineItem a owl:ObjectProperty ;\n    rdfs:label \"has line item\" ;\n    rdfs:comment \"Relates the invoice detail section to its line items.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :LineItem ;\n    owl:inverseOf :isLineItemOf .\n\n:isLineItemOf a owl:ObjectProperty ;\n    rdfs:label \"is line item of\" ;\n    rdfs:comment \"Relates a line item to the invoice detail section it belongs to.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :InvoiceDetail .\n\n:describesItem a owl:ObjectProperty ;\n    rdfs:label \"describes item\" ;\n    rdfs:comment \"Relates a line item to the item it describes.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Item ;\n    owl:inverseOf :isDescribedByLineItem .\n\n:isDescribedByLineItem a owl:ObjectProperty ;\n    rdfs:label \"is described by line item\" ;\n    rdfs:comment \"Relates an item to the line item that describes it.\" ;\n    rdfs:domain :Item ;\n    rdfs:range :LineItem .\n\n:hasPrice a owl:ObjectProperty ;\n    rdfs:label \"has price\" ;\n    rdfs:comment \"Relates a line item to its price.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range :Price ;\n    owl:inverseOf :isPriceOf .\n\n:isPriceOf a owl:ObjectProperty ;\n    rdfs:label \"is price of\" ;\n    rdfs:comment \"Relates a price to the line item it belongs to.\" ;\n    rdfs:domain :Price ;\n    rdfs:range :LineItem .\n\n:hasBusinessProcess a owl:ObjectProperty ;\n    rdfs:label \"has business process\" ;\n    rdfs:comment \"Relates an invoice message to a business process.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :BusinessProcess ;\n    owl:inverseOf :isBusinessProcessOf .\n\n:isBusinessProcessOf a owl:ObjectProperty ;\n    rdfs:label \"is business process of\" ;\n    rdfs:comment \"Relates a business process to the invoice message it is assigned to.\" ;\n    rdfs:domain :BusinessProcess ;\n    rdfs:range :InvoiceMessage .\n\n:hasHeader a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has header\" ;\n    rdfs:comment \"Relates an invoice message to its header.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceHeader ;\n    owl:inverseOf :isHeaderOf .\n\n:isHeaderOf a owl:ObjectProperty ;\n    rdfs:label \"is header of\" ;\n    rdfs:comment \"Relates an invoice header to the invoice message it belongs to.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range :InvoiceMessage .\n\n:hasDetail a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has detail\" ;\n    rdfs:comment \"Relates an invoice message to its detail section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceDetail ;\n    owl:inverseOf :isDetailOf .\n\n:isDetailOf a owl:ObjectProperty ;\n    rdfs:label \"is detail of\" ;\n    rdfs:comment \"Relates an invoice detail to the invoice message it belongs to.\" ;\n    rdfs:domain :InvoiceDetail ;\n    rdfs:range :InvoiceMessage .\n\n:hasSummary a owl:ObjectProperty, owl:FunctionalProperty ;\n    rdfs:label \"has summary\" ;\n    rdfs:comment \"Relates an invoice message to its summary section.\" ;\n    rdfs:domain :InvoiceMessage ;\n    rdfs:range :InvoiceSummary ;\n    owl:inverseOf :isSummaryOf .\n\n:isSummaryOf a owl:ObjectProperty ;\n    rdfs:label \"is summary of\" ;\n    rdfs:comment \"Relates an invoice summary to the invoice message it belongs to.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range :InvoiceMessage .\n\n#################################################################\n# Data Properties\n#################################################################\n:documentDate a owl:DatatypeProperty ;\n    rdfs:label \"document date\" ;\n    rdfs:comment \"The date of the document in the invoice header.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:dateTime .\n\n:invoiceNumber a owl:DatatypeProperty, owl:FunctionalProperty ;\n    rdfs:label \"invoice number\" ;\n    rdfs:comment \"The invoice number.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:referenceNumber a owl:DatatypeProperty ;\n    rdfs:label \"reference number\" ;\n    rdfs:comment \"A reference number in the invoice header.\" ;\n    rdfs:domain :InvoiceHeader ;\n    rdfs:range xsd:string .\n\n:addressLine a owl:DatatypeProperty ;\n    rdfs:label \"address line\" ;\n    rdfs:comment \"Address line of the organization address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:postalCode a owl:DatatypeProperty ;\n    rdfs:label \"postal code\" ;\n    rdfs:comment \"Postal code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:city a owl:DatatypeProperty ;\n    rdfs:label \"city\" ;\n    rdfs:comment \"City of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:countryCode a owl:DatatypeProperty ;\n    rdfs:label \"country code\" ;\n    rdfs:comment \"Country code of the address.\" ;\n    rdfs:domain :Address ;\n    rdfs:range xsd:string .\n\n:identifierValue a owl:DatatypeProperty ;\n    rdfs:label \"identifier value\" ;\n    rdfs:comment \"Value of an identifier.\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string .\n\n:identifierScheme a owl:DatatypeProperty ;\n    rdfs:label \"identifier scheme\" ;\n    rdfs:comment \"Scheme of the identifier (e.g., GLN).\" ;\n    rdfs:domain :Identifier ;\n    rdfs:range xsd:string .\n\n:quantity a owl:DatatypeProperty ;\n    rdfs:label \"quantity\" ;\n    rdfs:comment \"Quantity of the item in the line item.\" ;\n    rdfs:domain :LineItem ;\n    rdfs:range xsd:decimal .\n\n:netPrice a owl:DatatypeProperty ;\n    rdfs:label \"net price\" ;\n    rdfs:comment \"Net price of the item in the line item.\" ;\n    rdfs:domain :Price ;\n    rdfs:range xsd:decimal .\n\n:taxAmount a owl:DatatypeProperty ;\n    rdfs:label \"tax amount\" ;\n    rdfs:comment \"Tax amount in the invoice summary.\" ;\n    rdfs:domain :Tax ;\n    rdfs:range xsd:decimal .\n\n:totalAmount a owl:DatatypeProperty ;\n    rdfs:label \"total amount\" ;\n    rdfs:comment \"Total amount of the invoice in the summary section.\" ;\n    rdfs:domain :InvoiceSummary ;\n    rdfs:range xsd:decimal .\n\n#################################################################\n# Advanced Modeling: Restrictions and Equivalence\n#################################################################\n# General Class Axiom: Every OrganizationRoleAssignment must have exactly one assignedOrganization and one assignedRole\n:OrganizationRoleAssignment rdfs:subClassOf [\n    a owl:Restriction ;\n    owl:onProperty :assignedOrganization ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] , [\n    a owl:Restriction ;\n    owl:onProperty :assignedRole ;\n    owl:cardinality \"1\"^^xsd:nonNegativeInteger\n] .\n\n#################################################################\n# End of Ontology\n#################################################################\n"
}
