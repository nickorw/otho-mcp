      "owl_content": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix : <http://www.example.org/ontology#> .\n\n<http://www.example.org/ontology#UNEDIFACTInvoiceOntology>\n  a owl:Ontology ;\n  rdfs:label \"UN/EDIFACT Invoice Ontology\" ;\n  rdfs:comment \"Ontology for representing UN/EDIFACT-based invoice messages and their components, roles, and business process context.\" .\n\n#################################################################\n# CLASSES\n#################################################################\n\n:InterchangeEnvelope a owl:Class ;\n  rdfs:label \"Interchange Envelope\" ;\n  rdfs:comment \"The interchange envelope that contains one or more messages per UN/EDIFACT.\" .\n\n:Message a owl:Class ;\n  rdfs:label \"Message\" ;\n  rdfs:comment \"A business document message, such as an invoice, as defined by UN/EDIFACT.\" .\n\n:InvoiceMessage a owl:Class ;\n  rdfs:label \"Invoice Message\" ;\n  rdfs:comment \"A message of type INVOIC representing an invoice in UN/EDIFACT.\" ;\n  rdfs:subClassOf :Message .\n\n:Segment a owl:Class ;\n  rdfs:label \"Segment\" ;\n  rdfs:comment \"A segment within an EDIFACT message, e.g., BGM, NAD.\" .\n\n:CompositeDataElement a owl:Class ;\n  rdfs:label \"Composite Data Element\" ;\n  rdfs:comment \"A composite data element within a segment.\" .\n\n:SimpleDataElement a owl:Class ;\n  rdfs:label \"Simple Data Element\" ;\n  rdfs:comment \"A simple data element, the smallest unit within a message segment.\" .\n\n:Organization a owl:Class ;\n  rdfs:label \"Organization\" ;\n  rdfs:comment \"An organization involved in the invoice process.\" .\n\n:AgentRole a owl:Class ;\n  rdfs:label \"Agent Role\" ;\n  rdfs:comment \"A role played by an organization in the context of an invoice (e.g., Buyer, Seller, Delivery Party).\" .\n\n:Address a owl:Class ;\n  rdfs:label \"Address\" ;\n  rdfs:comment \"A postal address associated with an organization in a specific role context.\" .\n\n:Item a owl:Class ;\n  rdfs:label \"Item\" ;\n  rdfs:comment \"A product or good listed in the invoice.\" .\n\n:Price a owl:Class ;\n  rdfs:label \"Price\" ;\n  rdfs:comment \"A price value associated with an item in a line item.\" .\n\n:BusinessProcess a owl:Class ;\n  rdfs:label \"Business Process\" ;\n  rdfs:comment \"A process to which the invoice can be assigned (e.g., Purchase-to-Pay).\" .\n\n:InvoiceHeaderSection a owl:Class ;\n  rdfs:label \"Invoice Header Section\" ;\n  rdfs:comment \"The header section of an invoice message, containing dates, reference numbers, etc.\" .\n\n:InvoiceDetailSection a owl:Class ;\n  rdfs:label \"Invoice Detail Section\" ;\n  rdfs:comment \"The detail section of an invoice message, listing line items.\" .\n\n:InvoiceSummarySection a owl:Class ;\n  rdfs:label \"Invoice Summary Section\" ;\n  rdfs:comment \"The summary section of an invoice message, showing totals and taxes.\" .\n\n:LineItem a owl:Class ;\n  rdfs:label \"Line Item\" ;\n  rdfs:comment \"A single line item in the invoice detail section.\" .\n\n:Identifier a owl:Class ;\n  rdfs:label \"Identifier\" ;\n  rdfs:comment \"A generic identifier for organizations or entities.\" .\n\n:GLNIdentifier a owl:Class ;\n  rdfs:label \"GLN Identifier\" ;\n  rdfs:comment \"A Global Location Number identifier for organizations.\" ;\n  rdfs:subClassOf :Identifier .\n\n# Pivot Class for Reification\n:OrganizationRoleParticipation a owl:Class ;\n  rdfs:label \"Organization Role Participation\" ;\n  rdfs:comment \"Reifies the participation of an organization in a specific agent role and context (e.g., as Buyer, Seller, Delivery Party in a given invoice).\" .\n\n#################################################################\n# CLASS DISJOINTNESS & UNION\n#################################################################\n\n:Address owl:disjointWith :Organization .\n:Item owl:disjointWith :Organization .\n:Price owl:disjointWith :Item .\n:BusinessProcess owl:disjointWith :InvoiceMessage .\n\n:InvoiceHeaderSection owl:disjointWith :InvoiceDetailSection, :InvoiceSummarySection .\n:InvoiceDetailSection owl:disjointWith :InvoiceSummarySection .\n\n#################################################################\n# OBJECT PROPERTIES\n#################################################################\n\n:containsMessage a owl:ObjectProperty ;\n  rdfs:label \"contains message\" ;\n  rdfs:comment \"Relates an interchange envelope to the message(s) it contains.\" ;\n  rdfs:domain :InterchangeEnvelope ;\n  rdfs:range :Message ;\n  owl:FunctionalProperty .\n\n:hasSegment a owl:ObjectProperty ;\n  rdfs:label \"has segment\" ;\n  rdfs:comment \"Relates a message to its segments.\" ;\n  rdfs:domain :Message ;\n  rdfs:range :Segment ;\n  owl:FunctionalProperty .\n\n:hasCompositeElement a owl:ObjectProperty ;\n  rdfs:label \"has composite element\" ;\n  rdfs:comment \"Relates a segment to its composite data elements.\" ;\n  rdfs:domain :Segment ;\n  rdfs:range :CompositeDataElement .\n\n:hasSimpleElement a owl:ObjectProperty ;\n  rdfs:label \"has simple element\" ;\n  rdfs:comment \"Relates a composite data element to its simple data elements.\" ;\n  rdfs:domain :CompositeDataElement ;\n  rdfs:range :SimpleDataElement .\n\n:hasSection a owl:ObjectProperty ;\n  rdfs:label \"has section\" ;\n  rdfs:comment \"Relates an invoice message to one of its sections (header, detail, summary).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :InvoiceHeaderSection, :InvoiceDetailSection, :InvoiceSummarySection ;\n  owl:FunctionalProperty .\n\n:hasLineItem a owl:ObjectProperty ;\n  rdfs:label \"has line item\" ;\n  rdfs:comment \"Relates an invoice detail section to its line items.\" ;\n  rdfs:domain :InvoiceDetailSection ;\n  rdfs:range :LineItem .\n\n:describesItem a owl:ObjectProperty ;\n  rdfs:label \"describes item\" ;\n  rdfs:comment \"Relates a line item to the item it describes.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Item ;\n  owl:FunctionalProperty .\n\n:hasPrice a owl:ObjectProperty ;\n  rdfs:label \"has price\" ;\n  rdfs:comment \"Relates a line item to its price.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range :Price ;\n  owl:FunctionalProperty .\n\n:participatesAsRole a owl:ObjectProperty ;\n  rdfs:label \"participates as role\" ;\n  rdfs:comment \"Links an organization to its role participation(s) within an invoice context.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :OrganizationRoleParticipation .\n\n:hasAgentRole a owl:ObjectProperty ;\n  rdfs:label \"has agent role\" ;\n  rdfs:comment \"Links a role participation to a specific agent role (e.g., Buyer, Seller).\" ;\n  rdfs:domain :OrganizationRoleParticipation ;\n  rdfs:range :AgentRole ;\n  owl:FunctionalProperty .\n\n:hasAddress a owl:ObjectProperty ;\n  rdfs:label \"has address\" ;\n  rdfs:comment \"Links a role participation to an address used in that role context.\" ;\n  rdfs:domain :OrganizationRoleParticipation ;\n  rdfs:range :Address ;\n  owl:FunctionalProperty .\n\n:hasIdentifier a owl:ObjectProperty ;\n  rdfs:label \"has identifier\" ;\n  rdfs:comment \"Links an organization to its identifier(s), such as GLN.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range :Identifier .\n\n:assignedToProcess a owl:ObjectProperty ;\n  rdfs:label \"assigned to process\" ;\n  rdfs:comment \"Relates an invoice message to a business process (e.g., Purchase-to-Pay).\" ;\n  rdfs:domain :InvoiceMessage ;\n  rdfs:range :BusinessProcess .\n\n#################################################################\n# DATA PROPERTIES\n#################################################################\n\n:hasInvoiceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has invoice number\" ;\n  rdfs:comment \"The invoice number as specified in the header section.\" ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasDocumentDate a owl:DatatypeProperty ;\n  rdfs:label \"has document date\" ;\n  rdfs:comment \"The document date of the invoice.\" ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:dateTime ;\n  owl:FunctionalProperty .\n\n:hasReferenceNumber a owl:DatatypeProperty ;\n  rdfs:label \"has reference number\" ;\n  rdfs:comment \"A reference number in the invoice header section.\" ;\n  rdfs:domain :InvoiceHeaderSection ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasNetPrice a owl:DatatypeProperty ;\n  rdfs:label \"has net price\" ;\n  rdfs:comment \"The net price of an item in a line item.\" ;\n  rdfs:domain :Price ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:hasQuantity a owl:DatatypeProperty ;\n  rdfs:label \"has quantity\" ;\n  rdfs:comment \"The quantity of an item in a line item.\" ;\n  rdfs:domain :LineItem ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:hasInvoiceAmount a owl:DatatypeProperty ;\n  rdfs:label \"has invoice amount\" ;\n  rdfs:comment \"The total amount of the invoice in the summary section.\" ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:hasTaxAmount a owl:DatatypeProperty ;\n  rdfs:label \"has tax amount\" ;\n  rdfs:comment \"The total tax amount in the invoice summary section.\" ;\n  rdfs:domain :InvoiceSummarySection ;\n  rdfs:range xsd:decimal ;\n  owl:FunctionalProperty .\n\n:hasName a owl:DatatypeProperty ;\n  rdfs:label \"has name\" ;\n  rdfs:comment \"The name of an organization.\" ;\n  rdfs:domain :Organization ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasGLN a owl:DatatypeProperty ;\n  rdfs:label \"has GLN\" ;\n  rdfs:comment \"The Global Location Number (GLN) for an organization.\" ;\n  rdfs:domain :GLNIdentifier ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasStreet a owl:DatatypeProperty ;\n  rdfs:label \"has street\" ;\n  rdfs:comment \"The street of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasPostalCode a owl:DatatypeProperty ;\n  rdfs:label \"has postal code\" ;\n  rdfs:comment \"The postal code of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n\n:hasCity a owl:DatatypeProperty ;\n  rdfs:label \"has city\" ;\n  rdfs:comment \"The city of an address.\" ;\n  rdfs:domain :Address ;\n  rdfs:range xsd:string ;\n  owl:FunctionalProperty .\n"
}
